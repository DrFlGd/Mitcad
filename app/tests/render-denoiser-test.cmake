# SPDX-License-Identifier: MIT
# Exercise actual OIDN execution, independent of the path-tracing device.
if(NOT DEFINED WORKER OR NOT DEFINED MODE)
  message(FATAL_ERROR "WORKER and MODE are required")
endif()

set(environment "MITCAD_RENDER_TEST_DENOISER=cpu"
                "MITCAD_RENDER_TEST_COMPARE_DENOISER="
                "MITCAD_RENDER_TEST_DENOISER_FAILURE="
                "MITCAD_RENDER_TEST_DEVICE_FAILURE=")
set(arguments --bench 160x120 --samples 16 --device cpu)
set(failure_mode FALSE)
set(cpu_preview_mode FALSE)
set(metal_mode FALSE)
if(MODE STREQUAL "cpu_previews" OR MODE STREQUAL "failure_previews")
  set(cpu_preview_mode TRUE)
  set(arguments --bench 160x120 --samples 64 --device cpu --interactive --previews 4,16 --trace)
endif()
if(MODE STREQUAL "failure" OR MODE STREQUAL "failure_previews")
  set(failure_mode TRUE)
  list(REMOVE_ITEM environment "MITCAD_RENDER_TEST_DENOISER_FAILURE=")
  list(APPEND environment "MITCAD_RENDER_TEST_DENOISER_FAILURE=simulated denoiser failure")
elseif(MODE STREQUAL "metal" OR MODE STREQUAL "previews")
  set(metal_mode TRUE)
  list(REMOVE_ITEM environment "MITCAD_RENDER_TEST_DENOISER=cpu"
                               "MITCAD_RENDER_TEST_COMPARE_DENOISER=")
  list(APPEND environment "MITCAD_RENDER_TEST_DENOISER=metal"
                          "MITCAD_RENDER_TEST_COMPARE_DENOISER=cpu")
  set(arguments --bench 320x240 --samples 64 --device metal --compare metal --tolerance 2:24)
  if(MODE STREQUAL "previews")
    list(APPEND arguments --interactive --previews 4,16 --trace)
  endif()
elseif(NOT MODE STREQUAL "cpu" AND NOT cpu_preview_mode)
  message(FATAL_ERROR "Unknown denoiser test mode: ${MODE}")
endif()

# Rendering on Metal does not imply OIDN supports the same device (for
# example, a paravirtual GPU). Only known absent capability may skip these
# optional checks. Once advertised, actual Metal execution must succeed.
if(metal_mode)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${WORKER}" --list-devices
                  RESULT_VARIABLE listed OUTPUT_VARIABLE devices ERROR_VARIABLE list_error TIMEOUT 30)
  if(NOT listed EQUAL 0)
    message(FATAL_ERROR "Cannot query OIDN capabilities (${listed}): ${devices}${list_error}")
  endif()
  string(JSON device_count ERROR_VARIABLE json_error LENGTH "${devices}" devices)
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Invalid render-device JSON: ${json_error}: ${devices}")
  endif()
  set(metal_available FALSE)
  set(metal_oidn_available FALSE)
  if(device_count GREATER 0)
    math(EXPR last_device "${device_count} - 1")
    foreach(index RANGE 0 ${last_device})
      string(JSON device_type ERROR_VARIABLE json_error GET "${devices}" devices ${index} type)
      if(NOT json_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "A render device has no valid type: ${devices}")
      endif()
      if(device_type STREQUAL "METAL")
        set(metal_available TRUE)
        string(JSON oidn_type ERROR_VARIABLE json_error TYPE "${devices}" devices ${index} denoiser_available)
        if(NOT json_error STREQUAL "NOTFOUND" OR NOT oidn_type STREQUAL "BOOLEAN")
          message(FATAL_ERROR "A Metal device has no valid OIDN capability: ${devices}")
        endif()
        string(JSON oidn_available GET "${devices}" devices ${index} denoiser_available)
        if(oidn_available)
          set(metal_oidn_available TRUE)
        endif()
      endif()
    endforeach()
  endif()
  if(NOT metal_oidn_available)
    if(metal_available)
      set(reason "the available Metal render device does not support OIDN")
    else()
      set(reason "no Metal render device is available")
    endif()
    if(DEFINED ENV{MITCAD_RENDER_REQUIRE_GPU} AND NOT "$ENV{MITCAD_RENDER_REQUIRE_GPU}" STREQUAL "0")
      message(FATAL_ERROR "Metal OIDN is required for this validation, but ${reason}: ${devices}")
    endif()
    message(STATUS "SKIP: Metal OIDN unavailable: ${reason}")
    return()
  endif()
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${WORKER}" ${arguments}
                RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 180)
message(STATUS "${out}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Denoiser ${MODE} failed (${result}): ${out}${err}")
endif()
if(NOT out MATCHES "render-denoiser CPU [^\r\n]*executed yes")
  message(FATAL_ERROR "CPU denoising was not executed: ${out}${err}")
endif()
if(failure_mode)
  if(NOT out MATCHES "render-fallback [^\r\n]*simulated denoiser failure"
     OR NOT out MATCHES "render-device CPU ")
    message(FATAL_ERROR "Denoiser failure did not recover on the CPU: ${out}${err}")
  endif()
elseif(out MATCHES "render-fallback")
  message(FATAL_ERROR "Unexpected rendering fallback: ${out}${err}")
endif()
if(cpu_preview_mode)
  # Cycles chooses adaptive sample batches: a scheduled preview may arrive
  # after its start sample or jump over a later stage. Require an actual
  # intermediate full-resolution preview and final frame for each stable
  # view, without requiring two runs to choose matching batches.
  foreach(view 1 2)
    set(intermediate_frame FALSE)
    set(final_frame FALSE)
    string(REGEX MATCHALL "render-frame view ${view} at [^\r\n]*160 x 120, [0-9]+ samples, denoised[^\r\n]*"
           frames "${out}")
    foreach(frame IN LISTS frames)
      string(REGEX REPLACE ".*160 x 120, ([0-9]+) samples, denoised.*" "\\1" samples "${frame}")
      if(samples GREATER 1 AND samples LESS 64)
        set(intermediate_frame TRUE)
      elseif(samples EQUAL 64)
        set(final_frame TRUE)
      endif()
    endforeach()
    if(NOT intermediate_frame OR NOT final_frame)
      message(FATAL_ERROR "CPU view ${view} did not deliver an intermediate denoised preview and its final frame: ${out}${err}")
    endif()
  endforeach()
  if(NOT out MATCHES "render-bench [^\r\n]*interactive: [^\r\n]*first denoised frame"
     OR NOT out MATCHES "render-bench camera change: [^\r\n]*first denoised frame"
     OR NOT out MATCHES "render-bench navigation:"
     OR NOT out MATCHES "render-device CPU ")
    message(FATAL_ERROR "CPU interactive denoising did not complete camera changes and navigation: ${out}${err}")
  endif()
endif()
if(metal_mode)
  if(NOT out MATCHES "render-denoiser METAL [^\r\n]*executed yes"
     OR NOT out MATCHES "render-compare METAL ")
    message(FATAL_ERROR "Metal denoising was not executed and compared: ${out}${err}")
  endif()
  if(MODE STREQUAL "previews")
    # The worker compares only equal dimensions and sample counts. Adaptive
    # batches need not land on exactly 4 or 16, but at least one intermediate
    # and the final full-resolution image must be compared for each view.
    foreach(view 1 2)
      set(intermediate_frame FALSE)
      set(final_frame FALSE)
      string(REGEX MATCHALL "render-compare-denoised view-${view}-320x240-samples-[0-9]+ [^\r\n]*"
             frames "${out}")
      foreach(frame IN LISTS frames)
        string(REGEX REPLACE ".*-samples-([0-9]+) .*" "\\1" samples "${frame}")
        if(samples GREATER 1 AND samples LESS 64)
          set(intermediate_frame TRUE)
        elseif(samples EQUAL 64)
          set(final_frame TRUE)
        endif()
      endforeach()
      if(NOT intermediate_frame OR NOT final_frame)
        message(FATAL_ERROR "Metal/CPU view ${view} has no matched intermediate and final denoised images: ${out}${err}")
      endif()
    endforeach()
  endif()
endif()
message(STATUS "Denoiser ${MODE} passed")
