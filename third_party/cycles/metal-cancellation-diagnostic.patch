 }
 
 void MetalDevice::cancel()
--- a/src/device/metal/queue.mm
+++ b/src/device/metal/queue.mm
@@ -462,8 +462,12 @@
     }
 
     if (!active_pipelines_[kernel].update(metal_device_, kernel)) {
-      metal_device_->set_error(
-          string_printf("Could not activate pipeline for %s\n", device_kernel_as_string(kernel)));
+      /* A cancelled pipeline wait is expected during shutdown. Keep an existing
+       * compilation error instead of replacing it with a generic activation error. */
