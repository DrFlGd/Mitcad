+/* The native destination already contains the established display-half
+ * beauty. Keep catcher/background at full float precision until the final
+ * half store, exactly as the host's previous environment composite did. */
+ccl_device_inline void film_apply_native_environment_composite(
+    const ccl_global KernelFilmConvert *ccl_restrict kfilm_convert,
+    const ccl_global float *ccl_restrict buffer,
+    const half4 beauty_half,
+    ccl_private float *ccl_restrict catcher)
+{
+  kernel_assert(kfilm_convert->pass_background != PASS_UNUSED);
+  const float4 beauty = half4_to_float4(beauty_half);
+  const float rest = 1.0f - saturatef(beauty.w);
+  const float background_scale = film_get_scale(kfilm_convert, buffer) *
+                                 kfilm_convert->native_background_exposure;
+  const ccl_global float *background = buffer + kfilm_convert->pass_background;
+  catcher[0] = beauty.x + rest * catcher[0] * (background[0] * background_scale);
+  catcher[1] = beauty.y + rest * catcher[1] * (background[1] * background_scale);
+  catcher[2] = beauty.z + rest * catcher[2] * (background[2] * background_scale);
+  catcher[3] = 1.0f;
 }

