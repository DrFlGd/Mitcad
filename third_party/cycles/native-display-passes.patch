+bool PathTraceWorkGPU::get_render_tile_pixels_native(
+    const PassAccessor::PassAccessInfo &access,
+    const float exposure,
+    const int num_samples,
+    const OutputDriver::NativePassDestination &destination)
+{
+  BufferParams params;
+  PassAccessor::Destination pixels;
+  if (device_->info.type != DEVICE_METAL || !destination.graphics_interop ||
+      destination.graphics_interop->is_empty() ||
+      !destination.graphics_interop->has_new_handle() ||
+      destination.graphics_interop->get_type() != GraphicsInteropDevice::METAL ||
+      destination.graphics_interop->get_size() < destination.size_bytes ||
+      !native_pass_parameters(access.mode, destination, params, pixels))
+  {
+    return false;
+  }
+  if (destination.composite_over_environment && destination.graphics_interop->take_zero()) {
+    /* Clearing this input would destroy the already completed beauty. */
+    return false;
+  }
+  /* The borrowed buffer remains owned by the caller. This local adapter owns
+   * only its device residency reference, removed after queue completion. */
+  unique_ptr<DeviceGraphicsInterop> interop = queue_->graphics_interop_create();
+  if (!interop) {
+    return false;
+  }
+  interop->set_buffer(*destination.graphics_interop);
+  pixels.d_pixels_half_rgba = interop->map();
+  if (!pixels.d_pixels_half_rgba) {
+    return false;
+  }
+  const PassAccessorGPU accessor(queue_.get(), access, exposure, num_samples);
+  const bool success = accessor.get_render_tile_pixels(buffers_.get(), params, pixels);
+  const bool completed = queue_->synchronize();
+  interop->unmap();
+  const bool result = success && completed && !device_->have_error();
+  if (destination.used_graphics_interop) {
+    *destination.used_graphics_interop = result;
+  }
+  return result;
+}
