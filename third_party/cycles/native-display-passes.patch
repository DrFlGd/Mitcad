+CCL_NAMESPACE_BEGIN
+
+TEST(KernelNativeDisplay, EnvironmentKeepsFloatFactorsAndCompletedHalfBeauty)
+{
+  KernelFilmConvert convert = {};
+  convert.pass_sample_count = PASS_UNUSED;
+  convert.pass_background = 0;
+  convert.scale = 0.25f;
+  convert.native_background_exposure = 2.3f;
+  const float background[] = {1024.3f, 33.1234f, 0.000123456f};
+  const float factors[] = {1.0004f, 0.012345f, 4.12345f};
+  for (const float alpha : {-0.25f, 0.0f, 0.333f, 1.0f, 1.25f}) {
+    const half4 completed = float4_to_half4_display(make_float4(0.123456f, 1.23456f, 9.8765f, alpha));
+    const float4 light = half4_to_float4(completed);
+    const float light_values[] = {light.x, light.y, light.z};
+    float result[] = {factors[0], factors[1], factors[2], 1.0f};
+    film_apply_native_environment_composite(&convert, background, completed, result);
+    const float rest = 1.0f - std::clamp(light.w, 0.0f, 1.0f);
+    for (int channel = 0; channel < 3; ++channel) {
+      /* The legacy float pass scales background before the host composite.
+       * Do not half-round either auxiliary input before this multiplication. */
+      const float pass_background = background[channel] *
+                                    (convert.scale * convert.native_background_exposure);
+      const float expected = light_values[channel] + rest * factors[channel] * pass_background;
+      EXPECT_EQ(uint16_t(float_to_half_display(result[channel])),
+                uint16_t(float_to_half_display(expected))) << channel << ": " << alpha;
+    }
+    EXPECT_EQ(result[3], 1.0f);
+  }
+}
+
+TEST(KernelNativeDisplay, EnvironmentUsesPerPixelSampleCount)
+{
+  KernelFilmConvert convert = {};
+  convert.pass_sample_count = 3;
+  convert.pass_use_filter = true;
+  convert.pass_background = 0;
+  convert.scale = 1.0f;
+  convert.native_background_exposure = 0.5f;
+  float background[] = {12.3f, 4.5f, 6.7f, __uint_as_float(4u)};
+  const half4 beauty = float4_to_half4_display(make_float4(0.25f, 0.5f, 0.75f, 0.5f));
+  float result[] = {0.4f, 0.6f, 0.8f, 1.0f};
+  film_apply_native_environment_composite(&convert, background, beauty, result);
+  EXPECT_FLOAT_EQ(result[0], 0.25f + 0.5f * 0.4f * (12.3f * 0.125f));
+  EXPECT_FLOAT_EQ(result[1], 0.5f + 0.5f * 0.6f * (4.5f * 0.125f));
+  EXPECT_FLOAT_EQ(result[2], 0.75f + 0.5f * 0.8f * (6.7f * 0.125f));
+  EXPECT_EQ(result[3], 1.0f);
+}
+
+CCL_NAMESPACE_END
