+bool PathTraceWorkCPU::get_render_tile_pixels_native(
+    const PassAccessor::PassAccessInfo &access,
+    const float exposure,
+    const int num_samples,
+    const OutputDriver::NativePassDestination &destination)
+{
+  BufferParams params;
+  PassAccessor::Destination pixels;
+  if (!destination.pixels || !native_pass_parameters(access.mode, destination, params, pixels)) {
+    return false;
+  }
+  pixels.pixels_half_rgba = destination.pixels;
+  const PassAccessorCPU accessor(access, exposure, num_samples);
+  tbb::task_arena arena = local_tbb_arena_create(device_);
+  bool success = false;
+  arena.execute([&]() { success = accessor.get_render_tile_pixels(buffers_.get(), params, pixels); });
+  return success && !device_->have_error();
+}
