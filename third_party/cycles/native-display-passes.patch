+bool PathTraceWork::native_pass_parameters(
+    const PassMode mode,
+    const OutputDriver::NativePassDestination &destination,
+    BufferParams &params,
+    PassAccessor::Destination &pixels) const
+{
+  if (!buffers_ || destination.size.x <= 0 || destination.size.y <= 0) {
+    return false;
+  }
+  /* No native resampling yet: denoised upscaling changes the sample-count
+   * and noisy background layout, so reject it before selecting either mode. */
+  if (effective_denoised_buffer_params_.width != effective_buffer_params_.width ||
+      effective_denoised_buffer_params_.height != effective_buffer_params_.height ||
+      effective_denoised_buffer_params_.window_width != effective_buffer_params_.window_width ||
+      effective_denoised_buffer_params_.window_height != effective_buffer_params_.window_height ||
+      effective_denoised_big_tile_params_.width != effective_big_tile_params_.width ||
+      effective_denoised_big_tile_params_.height != effective_big_tile_params_.height ||
+      effective_denoised_big_tile_params_.window_width != effective_big_tile_params_.window_width ||
+      effective_denoised_big_tile_params_.window_height != effective_big_tile_params_.window_height)
+  {
+    return false;
+  }
+  const size_t width = size_t(destination.size.x);
+  const size_t height = size_t(destination.size.y);
+  if (width > std::numeric_limits<size_t>::max() / sizeof(half4) / height ||
+      destination.size_bytes < width * height * sizeof(half4) ||
+      width > size_t(std::numeric_limits<int>::max()) / height)
+  {
+    return false;
+  }
+  const BufferParams &effective = mode == PassMode::DENOISED ?
+                                      effective_denoised_buffer_params_ : effective_buffer_params_;
+  const BufferParams &big = mode == PassMode::DENOISED ?
+                                effective_denoised_big_tile_params_ : effective_big_tile_params_;
+  /* Native output is intentionally limited to one complete device window.
+   * Multi-device and offline/full-buffer output retain the original API. */
+  if (effective.window_width != destination.size.x ||
+      effective.window_height != destination.size.y ||
+      big.window_width != destination.size.x || big.window_height != destination.size.y ||
+      int64_t(effective.full_x) + effective.window_x != int64_t(big.full_x) + big.window_x ||
+      int64_t(effective.full_y) + effective.window_y != int64_t(big.full_y) + big.window_y ||
+      effective.window_x < 0 || effective.window_y < 0 || effective.stride <= 0 ||
+      effective.pass_stride <= 0 ||
+      size_t(effective.window_x) + width > size_t(effective.stride))
+  {
+    return false;
+  }
+  const size_t stride = size_t(effective.stride);
+  const size_t pass_stride = size_t(effective.pass_stride);
+  const size_t max_int = size_t(std::numeric_limits<int>::max());
+  /* Existing accessors form the source row stride and starting float offset
+   * with signed-int arithmetic. Bound those expressions, not the whole extent. */
+  if (stride > max_int / pass_stride) {
+    return false;
+  }
+  const size_t row_stride = stride * pass_stride;
+  if (size_t(effective.window_y) > max_int / row_stride ||
+      size_t(effective.window_x) >
+          (max_int - size_t(effective.window_y) * row_stride) / pass_stride)
+  {
+    return false;
+  }
+  const size_t last_y = size_t(effective.window_y) + height - 1;
+  const size_t row_end = size_t(effective.window_x) + width;
+  const size_t max_size = std::numeric_limits<size_t>::max();
+  if (last_y > (max_size - row_end) / stride) {
+    return false;
+  }
+  const size_t end = last_y * stride + row_end;
+  if (end > buffers_->buffer.size() / size_t(effective.pass_stride)) {
+    return false;
+  }
+  params = effective;
+  /* pad_pixels() visits params.width * params.height; limit that post-pass
+   * to the packed destination, while preserving source stride/window offsets. */
+  params.width = destination.size.x;
+  params.height = destination.size.y;
+  pixels.num_components = 4;
+  pixels.stride = destination.size.x;
+  return true;
+}
