+bool PathTraceTile::get_pass_pixels_native(
+    const string_view pass_name,
+    const OutputDriver::NativePassDestination &destination) const
+{
+  if (destination.used_graphics_interop) {
+    *destination.used_graphics_interop = false;
+  }
+  /* Match get_pass_pixels()'s pass resolution and noisy fallback exactly, but
+   * never download the render buffer to make this operation work. */
+  const BufferParams &params = path_trace_.get_render_tile_params();
+  const BufferPass *pass = params.find_pass(pass_name);
+  if (!pass) {
+    return false;
+  }
+  if (pass->mode == PassMode::DENOISED && !path_trace_.has_denoised_result() &&
+      !is_volume_guiding_pass(pass->type))
+  {
+    pass = params.find_pass(pass->type);
+    if (!pass) {
+      return false;
+    }
+  }
+  pass = params.get_actual_display_pass(pass);
+  if (!pass || pass->offset == PASS_UNUSED) {
+    return false;
+  }
+  if (destination.composite_over_environment &&
+      (pass->type != PASS_SHADOW_CATCHER ||
+       params.get_pass_offset(PASS_BACKGROUND) == PASS_UNUSED))
+  {
+    return false;
+  }
+  PassAccessor::PassAccessInfo access(*pass);
+  access.use_approximate_shadow_catcher = params.use_approximate_shadow_catcher;
+  access.use_approximate_shadow_catcher_background =
+      access.use_approximate_shadow_catcher && !params.use_transparent_background;
+  access.native_composite_over_environment = destination.composite_over_environment;
+  return path_trace_.get_render_tile_pixels_native(
+      access, params.exposure, path_trace_.get_num_render_tile_samples(), destination);
+}
