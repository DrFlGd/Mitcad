+// Whether edge E lies between two faces of one plane (a face split in two,
+// e.g. where two solids were fused): such an edge makes no corner.
+static bool ChFi3d_EdgeInOnePlane(const TopoDS_Edge& E, const ChFiDS_Map& EFMap)
+{
+  if (!EFMap.Contains(E))
+  {
+    return false;
+  }
+  TopoDS_Face aF1, aF2;
+  for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(E)); It.More(); It.Next())
+  {
+    const TopoDS_Face& aCur = TopoDS::Face(It.Value());
+    if (aF1.IsNull())
+    {
+      aF1 = aCur;
+    }
+    else if (aCur.IsSame(aF1))
+    {
+      continue;
+    }
+    else if (aF2.IsNull())
+    {
+      aF2 = aCur;
+    }
+    else if (!aCur.IsSame(aF2))
+    {
+      return false; // more than two faces
+    }
+  }
+  if (aF2.IsNull())
+  {
+    return false;
+  }
+  const BRepAdaptor_Surface aS1(aF1, false), aS2(aF2, false);
+  if (aS1.GetType() != GeomAbs_Plane || aS2.GetType() != GeomAbs_Plane)
+  {
+    return false;
+  }
+  const gp_Pln aP1 = aS1.Plane(), aP2 = aS2.Plane();
+  const double aTol = std::max(BRep_Tool::Tolerance(E), Precision::Confusion());
+  return aP1.Axis().IsParallel(aP2.Axis(), 1.e-6) && aP1.Distance(aP2.Location()) <= aTol;
+}
