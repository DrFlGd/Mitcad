+//=======================================================================
+// function : RunsIntoEndFace
+// purpose  : At an end of the spine, the contact on face Fon ends at CPon,
+//           on an arc no face continues tangentially: it runs into the
+//           face at the end across that arc. The other contact, extended
+//           to the end of its domain, ends on an arc across which its face
+//           continues tangentially into FBID. True when FBID is that face
+//           at the end and a plane: the blend ends on it with both
+//           contacts, and the face at the end cuts it.
+//=======================================================================
+
+static bool RunsIntoEndFace(const ChFiDS_Map&         EFMap,
+                            const ChFiDS_CommonPoint& CPon,
+                            const TopoDS_Face&        Fon,
+                            const TopoDS_Face&        FBID)
+{
+  if (!CPon.IsOnArc() || FBID.IsNull() || !EFMap.Contains(CPon.Arc())
+      || BRepAdaptor_Surface(FBID, false).GetType() != GeomAbs_Plane)
+  {
+    return false;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(CPon.Arc())); It.More(); It.Next())
+  {
+    if (!It.Value().IsSame(Fon) && It.Value().IsSame(FBID))
+    {
+      return true;
+    }
+  }
+  return false;
+}
