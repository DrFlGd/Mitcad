+//=======================================================================
+// function : RollsOnAcross
+// purpose  : Whether the blend of SurfData j rolls on an obstacle edge on
+//           side ons up to its end CP, an inner point of that edge, and
+//           the next SurfData rolls on the same edge from there (the other
+//           contact changed faces). The edge is not cut there: the blend
+//           runs along it on, and a point on it would split the edge and
+//           leave its piece beyond twice in the face across it.
+//=======================================================================
+
+static bool RollsOnAcross(const TopOpeBRepDS_DataStructure&                         DStr,
+                          const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil,
+                          const int                                                 j,
+                          const int                                                 ons,
+                          const ChFiDS_CommonPoint&                                 CP)
+{
+  if (j >= SeqFil.Length() || !CP.IsOnArc() || CP.IsVertex())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData>& Fd   = SeqFil(j);
+  const occ::handle<ChFiDS_SurfData>& Next = SeqFil(j + 1);
+  return Fd->IsOnCurve(ons) && Next->IsOnCurve(ons) && Next->IndexOfC(ons) == Fd->IndexOfC(ons)
+         && DStr.Shape(Fd->IndexOfC(ons)).IsSame(CP.Arc());
+}
