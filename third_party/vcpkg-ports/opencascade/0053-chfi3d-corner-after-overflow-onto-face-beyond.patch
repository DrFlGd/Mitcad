+//=======================================================================
+// function : ChFi3d_CapAcrossFaceBeyond
+// purpose  : OnSame end of a blend whose contact on the side away from the
+//            face at the end (IFopArc) runs on a face Fop beyond the face
+//            of the spine's edge on that side (Fprol0, the face of the
+//            prolonged edge Arcprol other than Fv): the contact overflowed
+//            onto Fop, or Fop continues Fprol0 tangentially. The face at
+//            the end is prolonged up to the cork as at any OnSame end, here
+//            along Fprol0 from Vtx to their common edge E01 (piece A) and
+//            along Fop from there to the end of the contact (piece B); E01
+//            is cut where it crosses the face at the end.
+//=======================================================================
+
+static void ChFi3d_CapAcrossFaceBeyond(TopOpeBRepDS_DataStructure&             DStr,
+                                       const ChFiDS_Map&                       EFMap,
+                                       const occ::handle<ChFiDS_SurfData>&     Fd,
+                                       const bool                              isfirst,
+                                       const int                               IFopArc,
+                                       const TopoDS_Vertex&                    Vtx,
+                                       const TopoDS_Edge&                      Arcprol,
+                                       const TopAbs_Orientation                OVtx,
+                                       const TopAbs_Orientation                OArcprolv,
+                                       const TopoDS_Face&                      Fv,
+                                       const TopoDS_Face&                      Fop,
+                                       const occ::handle<BRepAdaptor_Surface>& HBs,
+                                       const gp_Pnt2d&                         p2dbout,
+                                       const int                               icc,
+                                       const int                               IShape,
+                                       const double                            tol3d,
+                                       const double                            tol2d,
+                                       Bnd_Box&                                box)
+{
+  TopoDS_Face Fprol0;
+  for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(Arcprol)); It.More(); It.Next())
+  {
+    if (!It.Value().IsSame(Fv))
+    {
+      Fprol0 = TopoDS::Face(It.Value());
+    }
+  }
+  if (Fprol0.IsNull())
+  {
+    throw Standard_Failure("OneCorner : face of the prolonged edge not found");
+  }
+  TopoDS_Edge        E01;
+  TopAbs_Orientation OrFop = TopAbs_FORWARD;
+  for (TopExp_Explorer exE(Fprol0, TopAbs_EDGE); exE.More() && E01.IsNull(); exE.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(exE.Current());
+    if (E.IsSame(Arcprol) || BRep_Tool::Degenerated(E) || !EFMap.Contains(E))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(E)); It.More(); It.Next())
+    {
+      if (It.Value().IsSame(Fop))
+      {
+        E01   = E;
+        OrFop = It.Value().Orientation();
+      }
+    }
+  }
+  if (E01.IsNull())
+  {
+    throw Standard_Failure("OneCorner : edge between the faces beside the end not found");
+  }
+  // Where E01 crosses the face at the end, nearest to the end of the contact.
+  const ChFiDS_FaceInterference& Fiop = Fd->Interference(IFopArc);
+  const gp_Pnt                   Pend = Fd->Vertex(isfirst, IFopArc).Point();
+  occ::handle<BRepAdaptor_Curve> hE01 = new BRepAdaptor_Curve(E01);
+  IntCurveSurface_HInter         inter;
+  inter.Perform(hE01, HBs);
+  if (!inter.IsDone())
+  {
+    throw Standard_Failure("OneCorner : the edge beside the end does not cross the face at the end");
+  }
+  const double tolw = hE01->Resolution(tol3d);
+  int          iq   = 0;
+  double       dq   = RealLast();
+  for (int ip = 1; ip <= inter.NbPoints(); ip++)
+  {
+    const double w = inter.Point(ip).W();
+    if (w < hE01->FirstParameter() - tolw || w > hE01->LastParameter() + tolw)
+    {
+      continue;
+    }
+    const double d = inter.Point(ip).Pnt().Distance(Pend);
+    if (d < dq)
+    {
+      dq = d;
+      iq = ip;
+    }
+  }
+  if (iq == 0)
+  {
+    throw Standard_Failure("OneCorner : the edge beside the end does not cross the face at the end");
+  }
+  const double   wQ = inter.Point(iq).W();
+  const gp_Pnt   PQ = inter.Point(iq).Pnt();
+  const gp_Pnt2d uvQ(inter.Point(iq).U(), inter.Point(iq).V());
+
+  TopoDS_Face Fp0F = Fprol0, FopF = Fop;
+  Fp0F.Orientation(TopAbs_FORWARD);
+  FopF.Orientation(TopAbs_FORWARD);
+  double                          f, l;
+  const occ::handle<Geom2d_Curve> pcA  = BRep_Tool::CurveOnSurface(Arcprol, Fp0F, f, l);
+  const occ::handle<Geom2d_Curve> pcV  = BRep_Tool::CurveOnSurface(Arcprol, Fv, f, l);
+  const occ::handle<Geom2d_Curve> pcE0 = BRep_Tool::CurveOnSurface(E01, Fp0F, f, l);
+  const occ::handle<Geom2d_Curve> pcE1 = BRep_Tool::CurveOnSurface(E01, FopF, f, l);
+  if (pcA.IsNull() || pcV.IsNull() || pcE0.IsNull() || pcE1.IsNull() || Fiop.PCurveOnFace().IsNull())
+  {
+    throw Standard_ConstructionError("Failed to get p-curve of edge");
+  }
+  const double parVtx = BRep_Tool::Parameter(Vtx, Arcprol);
+
+  // The pieces: A on Fprol0 from Vtx to Q, B on Fop from Q to the end.
+  occ::handle<Geom_Curve>   z3d[2];
+  occ::handle<Geom2d_Curve> z2dop[2], z2dv[2];
+  double                    tolz[2] = {tol3d, tol3d};
+  for (int k = 0; k < 2; k++)
+  {
+    gp_Pnt2d pop1, pop2, pv1, pv2;
+    if (k == 0)
+    {
+      pop1 = pcA->Value(parVtx);
+      pop2 = pcE0->Value(wQ);
+      pv1  = pcV->Value(parVtx);
+      pv2  = uvQ;
+    }
+    else
+    {
+      pop1 = pcE1->Value(wQ);
+      pop2 = Fiop.PCurveOnFace()->Value(Fiop.Parameter(isfirst));
+      pv1  = uvQ;
+      pv2  = p2dbout;
+    }
+    ChFi3d_Recale(*HBs, pv1, pv2, true);
+    NCollection_Array1<double> Pardeb(1, 4), Parfin(1, 4);
+    Pardeb(1) = pop1.X();
+    Pardeb(2) = pop1.Y();
+    Pardeb(3) = pv1.X();
+    Pardeb(4) = pv1.Y();
+    Parfin(1) = pop2.X();
+    Parfin(2) = pop2.Y();
+    Parfin(3) = pv2.X();
+    Parfin(4) = pv2.Y();
+    occ::handle<BRepAdaptor_Surface> HBk = new BRepAdaptor_Surface(k == 0 ? Fp0F : FopF);
+    double                           uu1, uu2, vv1, vv2;
+    ChFi3d_Boite(pv1, pv2, uu1, uu2, vv1, vv2);
+    ChFi3d_BoundFac(*HBs, uu1, uu2, vv1, vv2);
+    ChFi3d_Boite(pop1, pop2, uu1, uu2, vv1, vv2);
+    ChFi3d_BoundFac(*HBk, uu1, uu2, vv1, vv2);
+    if (!ChFi3d_ComputeCurves(HBk, HBs, Pardeb, Parfin, z3d[k], z2dop[k], z2dv[k], tol3d, tol2d, tolz[k]))
+    {
+      throw Standard_Failure("OneCorner : failed to cut the face at the end");
+    }
+  }
+
+  // The data structure: Q, the cut of E01 at Q, the pieces on the face at
+  // the end and on Fprol0 and Fop.
+  const int IVtx = DStr.AddShape(Vtx);
+  const int iQ   = DStr.AddPoint(TopOpeBRepDS_Point(PQ, std::max(tolz[0], tolz[1])));
+  {
+    // E01 keeps its part on the side of the face at the end away from the
+    // blend (the middle of the blend's surface lies on the blend's side).
+    const int     IE01 = DStr.AddShape(E01);
+    TopoDS_Vertex V1, V2;
+    TopExp::Vertices(E01, V1, V2);
+    gp_Pnt Pm;
+    gp_Vec d1u, d1v;
+    HBs->D1(uvQ.X(), uvQ.Y(), Pm, d1u, d1v);
+    const gp_Vec                     N    = d1u.Crossed(d1v);
+    const occ::handle<Geom_Surface>& Sfil = DStr.Surface(Fd->Surf()).Surface();
+    double                           su1, su2, sv1, sv2;
+    Sfil->Bounds(su1, su2, sv1, sv2);
+    const gp_Pnt Pmid    = Sfil->Value(0.5 * (su1 + su2), 0.5 * (sv1 + sv2));
+    const bool   firstIn = N.Dot(gp_Vec(Pm, BRep_Tool::Pnt(V1))) * N.Dot(gp_Vec(Pm, Pmid)) > 0.;
+    DStr.ChangeShapeInterferences(IE01)
+      .Append(ChFi3d_FilPointInDS(firstIn ? TopAbs_FORWARD : TopAbs_REVERSED, IE01, iQ, wQ));
+  }
+  TopAbs_Orientation OArcprolop0 = TopAbs_FORWARD;
+  for (TopExp_Explorer ex(Fp0F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(Arcprol))
+    {
+      OArcprolop0 = ex.Current().Orientation();
+      break;
+    }
+  }
+  const TopAbs_Orientation EtV = TopAbs::Reverse(TopAbs::Compose(OVtx, OArcprolv));
+  const TopAbs_Orientation Et0 = TopAbs::Reverse(TopAbs::Compose(OVtx, OArcprolop0));
+  const TopAbs_Orientation Et1 = Fprol0.Orientation() == OrFop ? Et0 : TopAbs::Reverse(Et0);
+  const int                I0  = DStr.AddShape(Fprol0);
+  const int                I1  = DStr.AddShape(Fop);
+  for (int k = 0; k < 2; k++)
+  {
+    const int    IZ   = DStr.AddCurve(TopOpeBRepDS_Curve(z3d[k], tolz[k]));
+    const double Udeb = z3d[k]->FirstParameter();
+    const double Ufin = z3d[k]->LastParameter();
+    DStr.ChangeShapeInterferences(IShape).Append(ChFi3d_FilCurveInDS(IZ, IShape, z2dv[k], EtV));
+    DStr.ChangeShapeInterferences(k == 0 ? I0 : I1)
+      .Append(ChFi3d_FilCurveInDS(IZ, k == 0 ? I0 : I1, z2dop[k], k == 0 ? Et0 : Et1));
+    if (k == 0)
+    {
+      DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilVertexInDS(TopAbs_FORWARD, IZ, IVtx, Udeb));
+      DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, IZ, iQ, Ufin));
+    }
+    else
+    {
+      DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, IZ, iQ, Udeb));
+      DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, IZ, icc, Ufin));
+      box.Add(z3d[k]->Value(Ufin));
+    }
+  }
+}
