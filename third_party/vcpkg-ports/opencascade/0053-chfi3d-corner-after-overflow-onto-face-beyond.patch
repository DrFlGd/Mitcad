+//=======================================================================
+// function : ChFi3d_ObstacleVertexOnEndFace
+// purpose  : OnSame end of a SurfData rolling on an obstacle edge on side
+//            ons up to a vertex of that edge, the other side's point not
+//            on an arc. The face at the end is not the other face of the
+//            obstacle edge (the face the blend consumes, Fconsumed) but a
+//            face at that vertex holding the corner's vertex Vtx: the point
+//            is given the edge of the vertex between the face the blend
+//            touches and that face. Returns true when such an edge is set.
+//=======================================================================
+
+static bool ChFi3d_ObstacleVertexOnEndFace(const TopOpeBRepDS_DataStructure&   DStr,
+                                           const occ::handle<ChFiDS_SurfData>& Fd,
+                                           const int                           ons,
+                                           const bool                          isfirst,
+                                           const TopoDS_Vertex&                Vtx,
+                                           const ChFiDS_Map&                   VEMap,
+                                           const ChFiDS_Map&                   EFMap,
+                                           TopoDS_Face&                        Fconsumed)
+{
+  ChFiDS_CommonPoint& CV = Fd->ChangeVertex(isfirst, ons);
+  if (!Fd->IsOnCurve(ons) || !CV.IsOnArc() || !CV.IsVertex()
+      || Fd->Vertex(isfirst, 3 - ons).IsOnArc())
+  {
+    return false;
+  }
+  const TopoDS_Edge   Obst = TopoDS::Edge(DStr.Shape(Fd->IndexOfC(ons)));
+  const TopoDS_Face   Fn   = TopoDS::Face(DStr.Shape(Fd->Index(ons)));
+  const TopoDS_Vertex V    = CV.Vertex();
+  if (!CV.Arc().IsSame(Obst) || !EFMap.Contains(Obst) || !VEMap.Contains(V))
+  {
+    return false;
+  }
+  TopoDS_Face Fc;
+  for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(Obst)); It.More(); It.Next())
+  {
+    if (!It.Value().IsSame(Fn))
+    {
+      Fc = TopoDS::Face(It.Value());
+    }
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(V)); itE.More(); itE.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+    if (E.IsSame(Obst) || BRep_Tool::Degenerated(E) || !EFMap.Contains(E))
+    {
+      continue;
+    }
+    bool onFn = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More(); itF.Next())
+    {
+      onFn = onFn || itF.Value().IsSame(Fn);
+    }
+    if (!onFn)
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More(); itF.Next())
+    {
+      const TopoDS_Face& Fe = TopoDS::Face(itF.Value());
+      if (Fe.IsSame(Fn) || Fe.IsSame(Fc))
+      {
+        continue;
+      }
+      bool hasVtx = false;
+      for (TopExp_Explorer ex(Fe, TopAbs_VERTEX); ex.More() && !hasVtx; ex.Next())
+      {
+        hasVtx = ex.Current().IsSame(Vtx);
+      }
+      if (!hasVtx)
+      {
+        continue;
+      }
+      TopAbs_Orientation Tr = CV.TransitionOnArc();
+      if (ChFi3d_OrientationInFace(CV.Arc(), Fn) != ChFi3d_OrientationInFace(E, Fn))
+      {
+        Tr = TopAbs::Reverse(Tr);
+      }
+      CV.SetArc(CV.Tolerance(), E, BRep_Tool::Parameter(V, E), Tr);
+      Fconsumed = Fc;
+      return true;
+    }
+  }
+  return false;
+}
