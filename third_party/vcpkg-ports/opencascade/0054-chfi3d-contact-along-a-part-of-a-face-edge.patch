+        }
+      }
       if (E.IsNull() || !EFMap.Contains(E))
       {
         continue;
@@ -3032,6 +3113,7 @@ void ChFi3d_ContactsAlongFaceEdges(TopOpeBRepDS_DataStructure&       DStr,
       }
       const TopAbs_Orientation aTra =
