+// Whether the contact curve C on [T1, T2] runs along a part of edge E: its
+// points on E within Tol, each end at a vertex of E or at an inner point of
+// E (its parameter on E in W1, W2), at least one end at an inner point.
+static bool runsAlongEdgePart(const occ::handle<Geom_Curve>& C,
+                              const double                   T1,
+                              const double                   T2,
+                              const TopoDS_Edge&             E,
+                              const double                   Tol,
+                              bool&                          Inner1,
+                              double&                        W1,
+                              bool&                          Inner2,
+                              double&                        W2)
+{
+  TopoDS_Vertex V1, V2;
+  TopExp::Vertices(E, V1, V2);
+  if (V1.IsNull() || V2.IsNull() || V1.IsSame(V2))
+  {
+    return false;
+  }
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(E, f, l);
+  if (aCE.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt A = BRep_Tool::Pnt(V1), B = BRep_Tool::Pnt(V2);
+  const double aTolV = Tol + std::max(BRep_Tool::Tolerance(V1), BRep_Tool::Tolerance(V2));
+  // An end: at a vertex, or projected inside the edge.
+  auto anEnd = [&](const gp_Pnt& P, bool& Inner, double& W) {
+    if (P.Distance(A) <= aTolV || P.Distance(B) <= aTolV)
+    {
+      Inner = false;
+      return true;
+    }
+    GeomAPI_ProjectPointOnCurve aProj(P, aCE, f, l);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      return false;
+    }
+    W     = aProj.LowerDistanceParameter();
+    Inner = true;
+    return W > f + Precision::PConfusion() && W < l - Precision::PConfusion();
+  };
+  if (!anEnd(C->Value(T1), Inner1, W1) || !anEnd(C->Value(T2), Inner2, W2) || (!Inner1 && !Inner2))
+  {
+    return false;
+  }
+  constexpr int aNbSamples = 9;
+  for (int i = 1; i < aNbSamples; i++)
+  {
+    const gp_Pnt                aP = C->Value(T1 + (T2 - T1) * i / aNbSamples);
+    GeomAPI_ProjectPointOnCurve aProj(aP, aCE, f, l);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      return false;
+    }
+  }
+  return true;
+}
