@@ -3045,6 +3127,71 @@ void ChFi3d_ContactsAlongFaceEdges(TopOpeBRepDS_DataStructure&       DStr,
         Fd->ChangeIndexOfS2(DStr.AddShape(Fv));
         Fd->SetIndexOfC2(DStr.AddShape(E));
