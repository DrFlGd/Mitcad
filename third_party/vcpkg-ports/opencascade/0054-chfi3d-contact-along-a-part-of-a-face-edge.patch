+            bool alongToo = Fn->IsOnCurve(ons) && Fn->IndexOfC(ons) == anIE;
+            const ChFiDS_FaceInterference& FIn = Fn->Interference(ons);
+            if (!alongToo && !Fn->IsOnCurve(ons) && Fn->Index(ons) == anIndex && FIn.LineIndex() != 0
+                && !DStr.Curve(FIn.LineIndex()).Curve().IsNull())
+            {
+              const gp_Pnt aPn = DStr.Curve(FIn.LineIndex())
+                                   .Curve()
+                                   ->Value(0.5 * (FIn.FirstParameter() + FIn.LastParameter()));
+              double                        fe = 0., le = 0.;
+              const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(E, fe, le);
+              GeomAPI_ProjectPointOnCurve   aProj(aPn, aCE, fe, le);
+              alongToo = aProj.NbPoints() > 0 && aProj.LowerDistance() <= 0.1 * Tol3d;
+            }
+            if (alongToo)
+            {
+              continue;
+            }
+          }
+          CP.SetArc(Tol3d, E, aW[k], aTraE);
+          if (Fn.IsNull())
+          {
+            continue;
+          }
+          ChFiDS_CommonPoint& CPn = Fn->ChangeVertex(!isFirst, ons);
+          if (Fn->Index(ons) == anIndex && !CPn.IsOnArc()
+              && CPn.Point().Distance(CP.Point()) <= Tol3d)
+          {
+            CPn.SetArc(Tol3d, E, aW[k], aTraE);
+          }
+        }
+      }
     }
