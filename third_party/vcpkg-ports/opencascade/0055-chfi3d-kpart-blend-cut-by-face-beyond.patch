+//=======================================================================
+// function : ChFi3d_KeepCutInPiece
+// purpose  : The cut of a piece of an analytic blend by the face beyond
+//            starts (or ends) where the contact leaves its face, on the
+//            section between the piece and the one before (after). Where
+//            the face beyond is nearly square to the contact there, the
+//            cut leaves that point nearly along the section, and may run
+//            a little behind it before it turns forward (by up to the
+//            curve's approximation or by the true geometry). Its p-curve on
+//            the blend is kept between the piece's sections (the poles of
+//            a B-spline moved onto them), and the 3d tolerance covers the
+//            change. A piece's sections are isolines of the blend's
+//            parameters (the coordinate along the spine is Coord: 1 for u,
+//            2 for v) at A and B. Returns false when the p-curve is not a
+//            B-spline and leaves the piece, or when keeping it in moves the
+//            curve by more than MaxDev (the face beyond then reaches over
+//            the neighbouring pieces too).
+//=======================================================================
+
+static bool ChFi3d_KeepCutInPiece(occ::handle<Geom2d_Curve>&       Ps,
+                                  occ::handle<Geom_Curve>&         Cc,
+                                  occ::handle<Geom2d_Curve>&       Pc,
+                                  const occ::handle<Geom_Surface>& S,
+                                  const occ::handle<Geom_Surface>& SB,
+                                  const int                        Coord,
+                                  const double                     A,
+                                  const double                     B,
+                                  const double                     MaxDev,
+                                  double&                          Tol)
+{
+  const double lo = std::min(A, B), hi = std::max(A, B);
+  occ::handle<Geom2d_BSplineCurve> aBS = occ::down_cast<Geom2d_BSplineCurve>(Ps);
+  if (aBS.IsNull())
+  {
+    occ::handle<Geom2d_TrimmedCurve> aTC = occ::down_cast<Geom2d_TrimmedCurve>(Ps);
+    if (!aTC.IsNull())
+    {
+      aBS = occ::down_cast<Geom2d_BSplineCurve>(aTC->BasisCurve());
+    }
+  }
+  const double f = Ps->FirstParameter(), l = Ps->LastParameter();
+  bool         out = false;
+  for (int i = 0; i <= 50 && !out; i++)
+  {
+    const gp_Pnt2d p = Ps->Value(f + (l - f) * i / 50.);
+    const double   c = Coord == 1 ? p.X() : p.Y();
+    out              = c < lo - Precision::PConfusion() || c > hi + Precision::PConfusion();
+  }
+  if (!out)
+  {
+    return true;
+  }
+  if (aBS.IsNull())
+  {
+    return false;
+  }
+  aBS = occ::down_cast<Geom2d_BSplineCurve>(aBS->Copy());
+  // (The inner poles a little inside: the p-curve meets the sections at its
+  // ends only, and does not run along them.)
+  const double aMargin = std::max(1.e-6 * (hi - lo), Precision::PConfusion());
+  for (int i = 1; i <= aBS->NbPoles(); i++)
+  {
+    gp_Pnt2d p = aBS->Pole(i);
+    double   c = Coord == 1 ? p.X() : p.Y();
+    if (i == 1 || i == aBS->NbPoles())
+    {
+      c = std::min(std::max(c, lo), hi);
+    }
+    else
+    {
+      c = std::min(std::max(c, lo + aMargin), hi - aMargin);
+    }
+    if (Coord == 1)
+    {
+      p.SetX(c);
+    }
+    else
+    {
+      p.SetY(c);
+    }
+    aBS->SetPole(i, p);
+  }
+  // The curve is now the p-curve's on the blend; its p-curve on the face
+  // beyond is its projection there; the tolerance covers the change.
+  double aDev = 0.;
+  for (int i = 0; i <= 100; i++)
+  {
+    const double   t  = f + (l - f) * i / 100.;
+    const gp_Pnt2d uv = aBS->Value(t);
+    aDev              = std::max(aDev, S->Value(uv.X(), uv.Y()).Distance(Cc->Value(t)));
+  }
+  if (aDev > MaxDev)
+  {
+    // The cut truly runs past the sections (the face beyond reaches over
+    // the neighbouring pieces too): not a cut of this piece alone.
+    return false;
+  }
+  occ::handle<Geom2dAdaptor_Curve> aHPs = new Geom2dAdaptor_Curve(aBS, f, l);
+  occ::handle<GeomAdaptor_Surface> aHS  = new GeomAdaptor_Surface(S);
+  Adaptor3d_CurveOnSurface         aCOS(aHPs, aHS);
+  occ::handle<Geom_Curve>          aNewC;
+  double                           aMaxDev = 0., anAvDev = 0.;
+  GeomLib::BuildCurve3d(Precision::Confusion(), aCOS, f, l, aNewC, aMaxDev, anAvDev);
+  if (aNewC.IsNull() || SB.IsNull())
+  {
+    return false;
+  }
+  occ::handle<Geom2d_Curve> aNewPc = GeomProjLib::Curve2d(aNewC, f, l, SB);
+  if (aNewPc.IsNull())
+  {
+    return false;
+  }
+  Ps  = aBS;
+  Cc  = aNewC;
+  Pc  = aNewPc;
+  Tol = std::max(Tol, 1.5 * (aDev + aMaxDev));
+  return true;
+}
+
