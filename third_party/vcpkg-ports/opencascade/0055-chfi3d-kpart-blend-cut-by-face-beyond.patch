+//=======================================================================
+// function : ChFi3d_CopyKPartData
+// purpose  : A copy of an analytic blend's surface data with its own
+//            surface and curves in the data structure.
+//=======================================================================
+
+static occ::handle<ChFiDS_SurfData> ChFi3d_CopyKPartData(TopOpeBRepDS_DataStructure&         DStr,
+                                                         const occ::handle<ChFiDS_SurfData>& SD)
+{
+  occ::handle<ChFiDS_SurfData> aCopy = new ChFiDS_SurfData();
+  const TopOpeBRepDS_Surface&  tos   = DStr.Surface(SD->Surf());
+  if (tos.Surface().IsNull())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  aCopy->ChangeSurf(DStr.AddSurface(
+    TopOpeBRepDS_Surface(occ::down_cast<Geom_Surface>(tos.Surface()->Copy()), tos.Tolerance())));
+  aCopy->ChangeIndexOfS1(SD->IndexOfS1());
+  aCopy->ChangeIndexOfS2(SD->IndexOfS2());
+  aCopy->ChangeOrientation() = SD->Orientation();
+  for (int ons = 1; ons <= 2; ons++)
+  {
+    const ChFiDS_FaceInterference& FI = SD->Interference(ons);
+    ChFiDS_FaceInterference        aFI = FI;
+    if (FI.LineIndex() > 0)
+    {
+      const TopOpeBRepDS_Curve& toc = DStr.Curve(FI.LineIndex());
+      occ::handle<Geom_Curve>   aC;
+      if (!toc.Curve().IsNull())
+      {
+        aC = occ::down_cast<Geom_Curve>(toc.Curve()->Copy());
+      }
+      aFI.SetLineIndex(DStr.AddCurve(TopOpeBRepDS_Curve(aC, toc.Tolerance())));
+    }
+    if (!FI.PCurveOnFace().IsNull())
+    {
+      aFI.ChangePCurveOnFace() = occ::down_cast<Geom2d_Curve>(FI.PCurveOnFace()->Copy());
+    }
+    if (!FI.PCurveOnSurf().IsNull())
+    {
+      aFI.ChangePCurveOnSurf() = occ::down_cast<Geom2d_Curve>(FI.PCurveOnSurf()->Copy());
+    }
+    aCopy->ChangeInterference(ons) = aFI;
+    aCopy->ChangeVertex(true, ons)  = SD->Vertex(true, ons);
+    aCopy->ChangeVertex(false, ons) = SD->Vertex(false, ons);
+  }
+  aCopy->FirstSpineParam(SD->FirstSpineParam());
+  aCopy->LastSpineParam(SD->LastSpineParam());
+  return aCopy;
+}
+
+// The parameter on the line of side ons of an analytic blend at the
+// section through point P of the spine (the projection of P on it, near
+// the line's range on a periodic line).
+static bool ChFi3d_KPartLineParam(const TopOpeBRepDS_DataStructure&   DStr,
+                                  const occ::handle<ChFiDS_SurfData>& SD,
+                                  const int                           ons,
+                                  const gp_Pnt&                       P,
+                                  double&                             t)
+{
+  const ChFiDS_FaceInterference& FI = SD->Interference(ons);
+  if (FI.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& C = DStr.Curve(FI.LineIndex()).Curve();
+  if (C.IsNull())
+  {
+    return false;
+  }
+  GeomAPI_ProjectPointOnCurve aProj(P, C);
+  if (aProj.NbPoints() == 0)
+  {
+    return false;
+  }
+  t = aProj.LowerDistanceParameter();
+  if (C->IsPeriodic())
+  {
+    const double aMid = 0.5 * (FI.FirstParameter() + FI.LastParameter());
+    t                 = ElCLib::InPeriod(t, aMid - 0.5 * C->Period(), aMid + 0.5 * C->Period());
+  }
+  return true;
+}
+
+// The point where the face beyond B cuts the section of the analytic blend
+// SD at spine point P: on the blend's surface between its contacts (an
+// isoline of its parameters); its parameters on the blend and on B.
+static bool ChFi3d_KPartSectionCut(const TopOpeBRepDS_DataStructure&   DStr,
+                                   const occ::handle<ChFiDS_SurfData>& SD,
+                                   const int                           ons,
+                                   const gp_Pnt&                       P,
+                                   const TopoDS_Face&                  B,
+                                   gp_Pnt2d&                           uvS,
+                                   gp_Pnt2d&                           uvB,
+                                   gp_Pnt&                             Pcut)
+{
+  double tO = 0., tN = 0.;
+  if (!ChFi3d_KPartLineParam(DStr, SD, 3 - ons, P, tO) || !ChFi3d_KPartLineParam(DStr, SD, ons, P, tN))
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& FO = SD->Interference(3 - ons);
+  const ChFiDS_FaceInterference& FN = SD->Interference(ons);
+  if (FO.PCurveOnSurf().IsNull() || FN.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d a = FO.PCurveOnSurf()->Value(tO), b = FN.PCurveOnSurf()->Value(tN);
+  const double   L = a.Distance(b);
+  if (L <= Precision::PConfusion())
+  {
+    return false;
+  }
+  occ::handle<Geom2d_Line>          aLin = new Geom2d_Line(a, gp_Dir2d(gp_Vec2d(a, b)));
+  occ::handle<Geom2dAdaptor_Curve>  aPC  = new Geom2dAdaptor_Curve(aLin, 0., L);
+  occ::handle<GeomAdaptor_Surface>  aGS  = new GeomAdaptor_Surface(DStr.Surface(SD->Surf()).Surface());
+  occ::handle<Adaptor3d_CurveOnSurface> aCOS = new Adaptor3d_CurveOnSurface(aPC, aGS);
+  TopoDS_Face                       BF   = B;
+  BF.Orientation(TopAbs_FORWARD);
+  occ::handle<BRepAdaptor_Surface> aBS = new BRepAdaptor_Surface(BF, false);
+  IntCurveSurface_HInter           anInter;
+  anInter.Perform(aCOS, aBS);
+  if (!anInter.IsDone() || anInter.NbPoints() == 0)
+  {
+    return false;
+  }
+  // The cut nearest to the contact on the face of side ons.
+  int    iBest = 0;
+  double wBest = -1.;
+  for (int i = 1; i <= anInter.NbPoints(); i++)
+  {
+    const double w = anInter.Point(i).W();
+    if (w >= -Precision::PConfusion() && w <= L + Precision::PConfusion() && w > wBest)
+    {
+      wBest = w;
+      iBest = i;
+    }
+  }
+  if (iBest == 0)
+  {
+    return false;
+  }
+  const IntCurveSurface_IntersectionPoint& aPt = anInter.Point(iBest);
+  uvS  = aLin->Value(aPt.W());
+  uvB  = gp_Pnt2d(aPt.U(), aPt.V());
+  Pcut = aPt.Pnt();
+  return true;
+}
+
+// A piece of the analytic blend Full from spine parameter W1 to W2 whose
+// side ons is cut by the face beyond B: from Start (a point on an arc where
+// the contact leaves its face, or null: the cut of the section at W1) to
+// End (likewise at W2).
+static occ::handle<ChFiDS_SurfData> ChFi3d_KPartCutPiece(TopOpeBRepDS_DataStructure&         DStr,
+                                                         const occ::handle<ChFiDS_Spine>&    Spine,
+                                                         const occ::handle<ChFiDS_SurfData>& Full,
+                                                         const int                           ons,
+                                                         const TopoDS_Face&                  N,
+                                                         const TopoDS_Face&                  B,
+                                                         const double                        W1,
+                                                         const double                        W2,
+                                                         const occ::handle<ChFiDS_SurfData>& Prev,
+                                                         const occ::handle<ChFiDS_SurfData>& Next,
+                                                         const double                        tol3d)
+{
+  const int opp = 3 - ons;
+  if (Full.IsNull() || W2 - W1 <= Precision::PConfusion())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  TopoDS_Face BF = B;
+  BF.Orientation(TopAbs_FORWARD);
+  NCollection_Array1<double> Par[2] = {NCollection_Array1<double>(1, 4), NCollection_Array1<double>(1, 4)};
+  double                     tO[2] = {0., 0.};
+  gp_Pnt                     Pend[2];
+  // The ends shared with the piece before (Prev) and after (Next), where
+  // the contact leaves its face and comes back: their points, sections and
+  // parameters, as those pieces hold them.
+  const ChFiDS_CommonPoint* Start = Prev.IsNull() ? nullptr : &Prev->Vertex(false, ons);
+  const ChFiDS_CommonPoint* End   = Next.IsNull() ? nullptr : &Next->Vertex(true, ons);
+  for (int k = 0; k < 2; k++)
+  {
+    const double                        W   = k == 0 ? W1 : W2;
+    const ChFiDS_CommonPoint*           CP  = k == 0 ? Start : End;
+    const occ::handle<ChFiDS_SurfData>& Adj = k == 0 ? Prev : Next;
+    const gp_Pnt                        P   = Spine->Value(W);
+    if (!Adj.IsNull())
+    {
+      tO[k] = Adj->Interference(opp).Parameter(k != 0);
+    }
+    else if (!ChFi3d_KPartLineParam(DStr, Full, opp, P, tO[k]))
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    gp_Pnt2d uvS, uvB;
+    if (CP != nullptr)
+    {
+      const ChFiDS_FaceInterference& FAdj = Adj->Interference(ons);
+      if (FAdj.PCurveOnSurf().IsNull())
+      {
+        return occ::handle<ChFiDS_SurfData>();
+      }
+      double                          f = 0., l = 0.;
+      const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(TopoDS::Edge(CP->Arc()), BF, f, l);
+      if (pc.IsNull())
+      {
+        return occ::handle<ChFiDS_SurfData>();
+      }
+      uvS     = FAdj.PCurveOnSurf()->Value(FAdj.Parameter(k != 0));
+      uvB     = pc->Value(CP->ParameterOnArc());
+      Pend[k] = CP->Point();
+    }
+    else if (!ChFi3d_KPartSectionCut(DStr, Full, ons, P, B, uvS, uvB, Pend[k]))
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    Par[k](1) = uvS.X();
+    Par[k](2) = uvS.Y();
+    Par[k](3) = uvB.X();
+    Par[k](4) = uvB.Y();
+  }
+  const occ::handle<Geom_Surface>& S = DStr.Surface(Full->Surf()).Surface();
+  occ::handle<Geom_Curve>          Cc;
+  occ::handle<Geom2d_Curve>        Ps, Pc;
+  double                           tolreached = tol3d;
+  bool                             computed   = false;
+  {
+    // The band of the blend between its contacts, across the spine.
+    const occ::handle<Geom2d_Curve>& aPO = Full->Interference(opp).PCurveOnSurf();
+    const occ::handle<Geom2d_Curve>& aPN = Full->Interference(ons).PCurveOnSurf();
+    const gp_Pnt2d                   a = aPO->Value(tO[0]), b = aPO->Value(tO[1]);
+    const int      aCoord = std::abs(b.X() - a.X()) >= std::abs(b.Y() - a.Y()) ? 1 : 2;
+    const gp_Pnt2d n      = aPN->Value(Full->Interference(ons).FirstParameter());
+    const double   cO = aCoord == 1 ? a.Y() : a.X(), cN = aCoord == 1 ? n.Y() : n.X();
+    try
+    {
+      OCC_CATCH_SIGNALS
+      computed = ChFi3d_KPartCutCurve(S,
+                                      B,
+                                      Pend[0],
+                                      gp_Pnt2d(Par[0](1), Par[0](2)),
+                                      gp_Pnt2d(Par[0](3), Par[0](4)),
+                                      Pend[1],
+                                      aCoord,
+                                      std::min(cO, cN),
+                                      std::max(cO, cN),
+                                      tol3d,
+                                      Cc,
+                                      Ps,
+                                      Pc,
+                                      tolreached);
+    }
+    catch (Standard_Failure const&)
+    {
+      computed = false;
+    }
+  }
+  if (!computed || Cc.IsNull() || Ps.IsNull() || Pc.IsNull())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  {
+    // A cut that keeps to the surface of N (the contact only grazes the
+    // face beyond) is no cut: the blend is left to the walking.
+    const occ::handle<Geom_Surface> SN    = BRep_Tool::Surface(N);
+    double                          aHigh = 0.;
+    for (int i = 1; i < 10; i++)
+    {
+      GeomAPI_ProjectPointOnSurf aPr(Cc->Value(Cc->FirstParameter()
+                                               + (Cc->LastParameter() - Cc->FirstParameter()) * i / 10.),
+                                     SN);
+      if (aPr.NbPoints() > 0)
+      {
+        aHigh = std::max(aHigh, aPr.LowerDistance());
+      }
+    }
+    if (aHigh <= 10. * tol3d)
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+  }
+  {
+    // A vertex of B under the blend (an edge of B, its seam, ends on the
+    // part of its boundary the blend covers): B would have to grow along
+    // that edge up to the cut, which is not done; the blend is left to
+    // the walking.
+    double t1 = 0., t2 = 0.;
+    if (!ChFi3d_KPartLineParam(DStr, Full, ons, Spine->Value(W1), t1)
+        || !ChFi3d_KPartLineParam(DStr, Full, ons, Spine->Value(W2), t2))
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    const occ::handle<Geom_Curve>& CN = DStr.Curve(Full->Interference(ons).LineIndex()).Curve();
+    const occ::handle<Geom_Curve>& CO = DStr.Curve(Full->Interference(opp).LineIndex()).Curve();
+    for (TopExp_Explorer ex(B, TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      const gp_Pnt V = BRep_Tool::Pnt(TopoDS::Vertex(ex.Current()));
+      double       t = 0.;
+      // (Not the points where the contact leaves and comes back.)
+      if ((Start != nullptr && V.Distance(Pend[0]) <= 10. * tol3d)
+          || (End != nullptr && V.Distance(Pend[1]) <= 10. * tol3d)
+          || !ChFi3d_KPartLineParam(DStr, Full, ons, V, t)
+          || t < std::min(t1, t2) - Precision::PConfusion() || t > std::max(t1, t2) + Precision::PConfusion())
+      {
+        continue;
+      }
+      const gp_Pnt Pn = CN->Value(t);
+      double       to = 0.;
+      if (!ChFi3d_KPartLineParam(DStr, Full, opp, Pn, to))
+      {
+        continue;
+      }
+      if (gp_Vec(Pn, V).Dot(gp_Vec(Pn, CO->Value(to))) > 0.)
+      {
+        return occ::handle<ChFiDS_SurfData>();
+      }
+    }
+  }
+  {
+    // (The coordinate along the spine: the one the other contact's line
+    // runs along over the piece.)
+    const occ::handle<Geom2d_Curve>& aPO = Full->Interference(opp).PCurveOnSurf();
+    if (aPO.IsNull())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    const gp_Pnt2d a = aPO->Value(tO[0]), b = aPO->Value(tO[1]);
+    const int      aCoord = std::abs(b.X() - a.X()) >= std::abs(b.Y() - a.Y()) ? 1 : 2;
+    if (!ChFi3d_KeepCutInPiece(Ps,
+                               Cc,
+                               Pc,
+                               S,
+                               BRep_Tool::Surface(BF),
+                               aCoord,
+                               Par[0](aCoord),
+                               Par[1](aCoord),
+                               10. * tol3d,
+                               tolreached))
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+  }
+  // The transition on B: the piece keeps the side of the solid it has on
+  // N, so its transition on B is the one on N carried over by the faces'
+  // orientations.
+  const ChFiDS_FaceInterference& FN = Full->Interference(ons);
+  const ChFiDS_FaceInterference& FO = Full->Interference(opp);
+  const TopAbs_Orientation aTraB = TopAbs::Compose(FN.Transition(), TopAbs::Compose(N.Orientation(), B.Orientation()));
+
+  occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+  G->ChangeSurf(DStr.AddSurface(
+    TopOpeBRepDS_Surface(occ::down_cast<Geom_Surface>(S->Copy()), DStr.Surface(Full->Surf()).Tolerance())));
+  G->ChangeOrientation() = Full->Orientation();
+  G->ChangeIndexOfS1(Full->IndexOfS1());
+  G->ChangeIndexOfS2(Full->IndexOfS2());
+  if (ons == 1)
+  {
+    G->ChangeIndexOfS1(DStr.AddShape(B));
+  }
+  else
+  {
+    G->ChangeIndexOfS2(DStr.AddShape(B));
+  }
+  {
+    const TopOpeBRepDS_Curve& toc = DStr.Curve(FO.LineIndex());
+    ChFiDS_FaceInterference&  GO  = G->ChangeInterference(opp);
+    GO.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(toc.Curve()->Copy()),
+                                                         toc.Tolerance())),
+                       FO.Transition(),
+                       occ::down_cast<Geom2d_Curve>(FO.PCurveOnFace()->Copy()),
+                       occ::down_cast<Geom2d_Curve>(FO.PCurveOnSurf()->Copy()));
+    GO.SetFirstParameter(tO[0]);
+    GO.SetLastParameter(tO[1]);
+  }
+  {
+    ChFiDS_FaceInterference& GI = G->ChangeInterference(ons);
+    GI.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tolreached)), aTraB, Pc, Ps);
+    GI.SetFirstParameter(Cc->FirstParameter());
+    GI.SetLastParameter(Cc->LastParameter());
+  }
+  for (int k = 0; k < 2; k++)
+  {
+    const ChFiDS_CommonPoint* CP  = k == 0 ? Start : End;
+    ChFiDS_CommonPoint&       CPN = G->ChangeVertex(k == 0, ons);
+    ChFiDS_CommonPoint&       CPO = G->ChangeVertex(k == 0, opp);
+    if (CP != nullptr)
+    {
+      CPN = *CP;
+    }
+    else
+    {
+      CPN.Reset();
+      CPN.SetPoint(Pend[k]);
+    }
+    CPO.Reset();
+    const gp_Pnt PO = DStr.Curve(FO.LineIndex()).Curve()->Value(tO[k]);
+    CPO.SetPoint(PO);
+    if (CP == nullptr && Full->Index(opp) > 0)
+    {
+      // At an end of the spine's edge, the other contact ends on the edge
+      // of its face there (as the pieces of SplitKPart do).
+      const TopoDS_Face Fo = TopoDS::Face(DStr.Shape(Full->Index(opp)));
+      TopoDS_Face       FoF = Fo;
+      FoF.Orientation(TopAbs_FORWARD);
+      for (TopExp_Explorer ex(FoF, TopAbs_EDGE); ex.More(); ex.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+        if (BRep_Tool::Degenerated(E))
+        {
+          continue;
+        }
+        double                      f = 0., l = 0.;
+        const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(E, f, l);
+        if (aC.IsNull())
+        {
+          continue;
+        }
+        GeomAPI_ProjectPointOnCurve aPr(PO, aC, f, l);
+        if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tol3d)
+        {
+          continue;
+        }
+        // (Not the spine's edge: the contact lies off it.)
+        const double w = aPr.LowerDistanceParameter();
+        if (w <= f + Precision::PConfusion() || w >= l - Precision::PConfusion())
+        {
+          continue;
+        }
+        const TopAbs_Orientation aTr = k == 0 ? TopAbs::Reverse(TopAbs::Compose(FO.Transition(), E.Orientation()))
+                                              : TopAbs::Compose(FO.Transition(), E.Orientation());
+        CPO.SetArc(tol3d, E, w, aTr);
+        break;
+      }
+    }
+  }
+  G->FirstSpineParam(W1);
+  G->LastSpineParam(W2);
+  return G;
+}
