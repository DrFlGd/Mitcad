+//=======================================================================
+// function : ChFi3d_KPartCutCurve
+// purpose  : The cut of an analytic blend S by the face beyond B, from P1
+//            to P2 (each on both, at the parameters given): of the arcs of
+//            the surfaces' intersection between these points, the one
+//            across the blend, between its contacts (its parameter Coord'
+//            across the spine within [BandLo, BandHi]); the other runs on
+//            the blend's surface beyond its contacts. The curve runs from
+//            P1 to P2, its p-curves start at the parameters given.
+//=======================================================================
+
+static bool ChFi3d_KPartCutCurve(const occ::handle<Geom_Surface>& S,
+                                 const TopoDS_Face&               B,
+                                 const gp_Pnt&                    P1,
+                                 const gp_Pnt2d&                  uvS1,
+                                 const gp_Pnt2d&                  uvB1,
+                                 const gp_Pnt&                    P2,
+                                 const int                        Coord,
+                                 const double                     BandLo,
+                                 const double                     BandHi,
+                                 const double                     tol3d,
+                                 occ::handle<Geom_Curve>&         Cc,
+                                 occ::handle<Geom2d_Curve>&       Ps,
+                                 occ::handle<Geom2d_Curve>&       Pc,
+                                 double&                          tolreached)
+{
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(B);
+  if (S.IsNull() || SB.IsNull())
+  {
+    return false;
+  }
+  GeomInt_IntSS anInter;
+  anInter.Perform(S, SB, 2.e-7, true, true, true);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  const double aTolP = std::max(100. * tol3d, 1.e-4);
+  const int    across = 3 - Coord;
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    if (!anInter.HasLineOnS1(i) || !anInter.HasLineOnS2(i))
+    {
+      continue;
+    }
+    const occ::handle<Geom_Curve>   C  = anInter.Line(i);
+    const occ::handle<Geom2d_Curve> p1 = anInter.LineOnS1(i);
+    const occ::handle<Geom2d_Curve> p2 = anInter.LineOnS2(i);
+    GeomAPI_ProjectPointOnCurve     aPr1(P1, C), aPr2(P2, C);
+    if (aPr1.NbPoints() == 0 || aPr2.NbPoints() == 0 || aPr1.LowerDistance() > aTolP
+        || aPr2.LowerDistance() > aTolP)
+    {
+      continue;
+    }
+    const double t1 = aPr1.LowerDistanceParameter(), t2 = aPr2.LowerDistanceParameter();
+    if (std::abs(t2 - t1) <= Precision::PConfusion())
+    {
+      continue;
+    }
+    // The arcs from P1 to P2: the direct one, and on a closed line the one
+    // round the other way.
+    double aFrom[2] = {t1, t1}, aTo[2] = {t2, t2};
+    int    nbArcs   = 1;
+    if (C->IsPeriodic())
+    {
+      const double T = C->Period();
+      nbArcs         = 2;
+      aTo[1]         = t2 > t1 ? t2 - T : t2 + T;
+    }
+    for (int a = 0; a < nbArcs; a++)
+    {
+      // Across the blend all along (a few points between the ends).
+      bool inBand = true;
+      for (int k = 1; k <= 3 && inBand; k++)
+      {
+        const double   t  = aFrom[a] + (aTo[a] - aFrom[a]) * k / 4.;
+        const gp_Pnt2d uv = p1->Value(t);
+        // (The p-curve may lie in another period of a periodic surface.)
+        gp_Pnt2d uvn = uv;
+        GeomAPI_ProjectPointOnSurf aPS(C->Value(t), S);
+        if (aPS.NbPoints() > 0)
+        {
+          double u = 0., v = 0.;
+          aPS.LowerDistanceParameters(u, v);
+          uvn.SetCoord(u, v);
+        }
+        double c = across == 1 ? uvn.X() : uvn.Y();
+        const bool per = across == 1 ? S->IsUPeriodic() : S->IsVPeriodic();
+        if (per)
+        {
+          const double T = across == 1 ? S->UPeriod() : S->VPeriod();
+          c              = ElCLib::InPeriod(c, 0.5 * (BandLo + BandHi) - 0.5 * T, 0.5 * (BandLo + BandHi) + 0.5 * T);
+        }
+        inBand = c >= BandLo - Precision::PConfusion() && c <= BandHi + Precision::PConfusion();
+      }
+      if (!inBand)
+      {
+        continue;
+      }
+      double f = aFrom[a], l = aTo[a];
+      const bool reversed = l < f;
+      if (reversed)
+      {
+        std::swap(f, l);
+      }
+      occ::handle<Geom_Curve>   aC  = new Geom_TrimmedCurve(C, f, l);
+      occ::handle<Geom2d_Curve> aP1 = new Geom2d_TrimmedCurve(p1, f, l);
+      occ::handle<Geom2d_Curve> aP2 = new Geom2d_TrimmedCurve(p2, f, l);
+      if (reversed)
+      {
+        aC->Reverse();
+        aP1->Reverse();
+        aP2->Reverse();
+      }
+      const double uf = aC->FirstParameter(), ul = aC->LastParameter();
+      // The p-curves: the curve's projections on both surfaces, in the
+      // periods of the parameters given at its start.
+      aP1 = GeomProjLib::Curve2d(aC, uf, ul, S);
+      aP2 = GeomProjLib::Curve2d(aC, uf, ul, SB);
+      if (aP1.IsNull() || aP2.IsNull())
+      {
+        continue;
+      }
+      auto toPeriod = [&](occ::handle<Geom2d_Curve>& aP, const occ::handle<Geom_Surface>& aS, const gp_Pnt2d& uv0) {
+        const gp_Pnt2d p0 = aP->Value(uf);
+        double         du = 0., dv = 0.;
+        if (aS->IsUPeriodic())
+        {
+          du = aS->UPeriod() * std::round((uv0.X() - p0.X()) / aS->UPeriod());
+        }
+        if (aS->IsVPeriodic())
+        {
+          dv = aS->VPeriod() * std::round((uv0.Y() - p0.Y()) / aS->VPeriod());
+        }
+        if (du != 0. || dv != 0.)
+        {
+          aP->Translate(gp_Vec2d(du, dv));
+        }
+      };
+      toPeriod(aP1, S, uvS1);
+      toPeriod(aP2, SB, uvB1);
+      Cc = aC;
+      Ps = aP1;
+      Pc = aP2;
+      occ::handle<GeomAdaptor_Surface> aHS  = new GeomAdaptor_Surface(S);
+      occ::handle<GeomAdaptor_Surface> aHSB = new GeomAdaptor_Surface(SB);
+      tolreached = std::max(tol3d, ChFi3d_EvalTolReached(aHS, Ps, aHSB, Pc, Cc));
+      return true;
+    }
+  }
+  return false;
+}
