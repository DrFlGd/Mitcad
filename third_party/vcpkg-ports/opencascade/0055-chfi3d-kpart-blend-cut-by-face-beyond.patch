+//=======================================================================
+// function : ChFi3d_FillKPartGaps
+// purpose  : Pieces of an analytic blend split by the domains of its
+//            faces: where the contact on one face leaves that face across
+//            an edge to a face beyond that does not continue it tangentially
+//            and comes back into it across an edge of the same face beyond
+//            (a hole or a cut-out of the face near the edge), while the
+//            other contact stays on its face, the blend runs on over the
+//            gap, on the face's surface, and the face beyond cuts it: a
+//            piece is inserted whose side on that face is the intersection
+//            of the blend with the face beyond, from the point where the
+//            contact leaves the face to the point where it comes back.
+//=======================================================================
+
+static void ChFi3d_FillKPartGaps(TopOpeBRepDS_DataStructure&                         DStr,
+                                 const occ::handle<ChFiDS_Spine>&                    Spine,
+                                 NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& LSD,
+                                 const ChFiDS_Map&                                   EFMap,
+                                 const double                                        tol3d)
+{
+  for (int j = 1; j < LSD.Length(); j++)
+  {
+    const occ::handle<ChFiDS_SurfData> A = LSD.Value(j);
+    const occ::handle<ChFiDS_SurfData> C = LSD.Value(j + 1);
+    for (int ons = 1; ons <= 2; ons++)
+    {
+      const int                 opp = 3 - ons;
+      const ChFiDS_CommonPoint& CPa = A->Vertex(false, ons);
+      const ChFiDS_CommonPoint& CPc = C->Vertex(true, ons);
+      if (!CPa.IsOnArc() || !CPc.IsOnArc() || CPa.IsVertex() || CPc.IsVertex()
+          || A->Vertex(false, opp).IsOnArc() || C->Vertex(true, opp).IsOnArc() || A->Index(ons) <= 0
+          || A->Index(ons) != C->Index(ons) || A->Index(opp) != C->Index(opp))
+      {
+        continue;
+      }
+      const TopoDS_Face N = TopoDS::Face(DStr.Shape(A->Index(ons)));
+      // The face beyond both arcs: the same one, not tangent to N there.
+      TopoDS_Face B;
+      bool        ok = true;
+      for (int k = 0; k < 2 && ok; k++)
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(k == 0 ? CPa.Arc() : CPc.Arc());
+        if (!EFMap.Contains(E))
+        {
+          ok = false;
+          break;
+        }
+        TopoDS_Face Fk;
+        for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+        {
+          if (!it.Value().IsSame(N))
+          {
+            Fk = TopoDS::Face(it.Value());
+          }
+        }
+        if (Fk.IsNull() || (!B.IsNull() && !B.IsSame(Fk)) || ChFi3d::IsTangentFaces(E, N, Fk))
+        {
+          ok = false;
+          break;
+        }
+        B = Fk;
+      }
+      if (!ok || B.IsNull())
+      {
+        continue;
+      }
+      // (A, a piece of the same analytic blend, holds its whole lines.)
+      const occ::handle<ChFiDS_SurfData> G = ChFi3d_KPartCutPiece(DStr,
+                                                                  Spine,
+                                                                  A,
+                                                                  ons,
+                                                                  N,
+                                                                  B,
+                                                                  A->LastSpineParam(),
+                                                                  C->FirstSpineParam(),
+                                                                  A,
+                                                                  C,
+                                                                  tol3d);
+      if (!G.IsNull())
+      {
+        LSD.InsertAfter(j, G);
+        j++;
+        break;
+      }
+      // Where the cut is not found as one curve between its ends (both
+      // ends on a line of the intersection that does not cross the blend
+      // between them), two pieces, cut from each end to the middle.
+      const double Wm = 0.5 * (A->LastSpineParam() + C->FirstSpineParam());
+      const occ::handle<ChFiDS_SurfData> aNone;
+      const occ::handle<ChFiDS_SurfData> G1 =
+        ChFi3d_KPartCutPiece(DStr, Spine, A, ons, N, B, A->LastSpineParam(), Wm, A, aNone, tol3d);
+      const occ::handle<ChFiDS_SurfData> G2 =
+        G1.IsNull()
+          ? G1
+          : ChFi3d_KPartCutPiece(DStr, Spine, A, ons, N, B, Wm, C->FirstSpineParam(), aNone, C, tol3d);
+      if (G1.IsNull() || G2.IsNull())
+      {
+        continue;
+      }
+      LSD.InsertAfter(j, G2);
+      LSD.InsertAfter(j, G1);
+      j += 2;
+      break;
+    }
+  }
+}
+
+//=======================================================================
+// function : ChFi3d_FillKPartGapsAcrossEdges
+// purpose  : As ChFi3d_FillKPartGaps, where the contact passes over a hole
+//            of its face from one edge of the spine to a later one: the
+//            blend of each edge on the way runs on over the hole (whole
+//            edges with no piece in their faces) and the face beyond cuts
+//            each piece.
+//=======================================================================
+
+static void ChFi3d_FillKPartGapsAcrossEdges(
+  TopOpeBRepDS_DataStructure&                                                    DStr,
+  const occ::handle<ChFiDS_Spine>&                                               Spine,
+  NCollection_Array1<NCollection_Sequence<occ::handle<ChFiDS_SurfData>>>&        aLSD,
+  const NCollection_Array1<occ::handle<ChFiDS_SurfData>>&                        aFull,
+  const NCollection_Array1<int>&                                                 aState,
+  const ChFiDS_Map&                                                              EFMap,
+  const double                                                                   tol3d)
+{
+  const int nbed = Spine->NbEdges();
+  for (int k = 1; k < nbed; k++)
+  {
+    if (aState(k) != 2 || aLSD(k).IsEmpty() || aFull(k).IsNull())
+    {
+      continue;
+    }
+    const occ::handle<ChFiDS_SurfData> A = aLSD(k).Last();
+    for (int ons = 1; ons <= 2; ons++)
+    {
+      const int                 opp = 3 - ons;
+      const ChFiDS_CommonPoint& CPa = A->Vertex(false, ons);
+      if (!CPa.IsOnArc() || CPa.IsVertex() || A->Vertex(false, opp).IsOnArc() || A->Index(ons) <= 0
+          || A->LastSpineParam() >= Spine->LastParameter(k) - Precision::PConfusion())
+      {
+        continue;
+      }
+      const TopoDS_Face N = TopoDS::Face(DStr.Shape(A->Index(ons)));
+      if (!EFMap.Contains(CPa.Arc()))
+      {
+        continue;
+      }
+      TopoDS_Face B;
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(CPa.Arc())); it.More(); it.Next())
+      {
+        if (!it.Value().IsSame(N))
+        {
+          B = TopoDS::Face(it.Value());
+        }
+      }
+      if (B.IsNull() || ChFi3d::IsTangentFaces(TopoDS::Edge(CPa.Arc()), N, B))
+      {
+        continue;
+      }
+      // The edges after k with no piece (the contact off N all along), up
+      // to an edge whose first piece comes back into N from B.
+      int m = k + 1;
+      while (m <= nbed && aState(m) == 2 && aLSD(m).IsEmpty() && !aFull(m).IsNull()
+             && aFull(m)->Index(ons) == A->Index(ons))
+      {
+        m++;
+      }
+      if (m > nbed || aState(m) != 2 || aLSD(m).IsEmpty() || aFull(m).IsNull())
+      {
+        continue;
+      }
+      const occ::handle<ChFiDS_SurfData> C   = aLSD(m).First();
+      const ChFiDS_CommonPoint&          CPc = C->Vertex(true, ons);
+      if (!CPc.IsOnArc() || CPc.IsVertex() || C->Vertex(true, opp).IsOnArc() || C->Index(ons) != A->Index(ons)
+          || !EFMap.Contains(CPc.Arc())
+          || C->FirstSpineParam() <= Spine->FirstParameter(m) + Precision::PConfusion())
+      {
+        continue;
+      }
+      bool sameB = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(CPc.Arc())); it.More(); it.Next())
+      {
+        sameB = sameB || it.Value().IsSame(B);
+      }
+      if (!sameB)
+      {
+        continue;
+      }
+      // The pieces: the end of edge k, the edges between, the start of m.
+      NCollection_Sequence<occ::handle<ChFiDS_SurfData>> aPieces;
+      bool                                               ok = true;
+      for (int e = k; e <= m && ok; e++)
+      {
+        const double W1 = e == k ? A->LastSpineParam() : Spine->FirstParameter(e);
+        const double W2 = e == m ? C->FirstSpineParam() : Spine->LastParameter(e);
+        const occ::handle<ChFiDS_SurfData> G =
+          ChFi3d_KPartCutPiece(DStr, Spine, aFull(e), ons, N, B, W1, W2,
+                               e == k ? A : occ::handle<ChFiDS_SurfData>(),
+                               e == m ? C : occ::handle<ChFiDS_SurfData>(), tol3d);
+        ok = !G.IsNull();
+        if (ok)
+        {
+          aPieces.Append(G);
+        }
+      }
+      if (!ok)
+      {
+        continue;
+      }
+      aLSD(k).Append(aPieces.First());
+      for (int e = k + 1; e < m; e++)
+      {
+        aLSD(e).Append(aPieces.Value(e - k + 1));
+      }
+      aLSD(m).Prepend(aPieces.Last());
+      k = m - 1;
+      break;
+    }
+  }
+}
