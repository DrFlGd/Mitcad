+//=======================================================================
+// function : ChFi3d_ContinuesCurve
+// purpose  : whether the curve from theB0 to theB1 continues the one from
+//           theA0 to theA1 in the same direction (it starts where that
+//           one ends, or ends where it starts) rather than running back
+//           (they start or end at the same point), by the nearer pair of
+//           ends: the curves of consecutive surfdatas meet within their
+//           tolerances only.
+//=======================================================================
+
+static bool ChFi3d_ContinuesCurve(const gp_Pnt& theA0,
+                                  const gp_Pnt& theA1,
+                                  const gp_Pnt& theB0,
+                                  const gp_Pnt& theB1)
+{
+  return std::min(theA1.Distance(theB0), theA0.Distance(theB1))
+         <= std::min(theA0.Distance(theB0), theA1.Distance(theB1));
+}
