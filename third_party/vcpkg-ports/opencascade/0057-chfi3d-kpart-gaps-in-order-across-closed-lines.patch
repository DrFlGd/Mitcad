+// Where the cut of the analytic blend SD by the face beyond B, from P1 to
+// P2, is not one line of the surfaces' intersection but two that meet (the
+// intersection's lines are split at the surfaces' parametric seams): the
+// spine parameter Wm, between W1 and W2, of the section through the point
+// where they meet.
+static bool ChFi3d_KPartCutJunction(const TopOpeBRepDS_DataStructure&   DStr,
+                                    const occ::handle<ChFiDS_Spine>&    Spine,
+                                    const occ::handle<ChFiDS_SurfData>& SD,
+                                    const int                           ons,
+                                    const TopoDS_Face&                  B,
+                                    const gp_Pnt&                       P1,
+                                    const gp_Pnt&                       P2,
+                                    const double                        W1,
+                                    const double                        W2,
+                                    const double                        tol3d,
+                                    double&                             Wm)
+{
+  const occ::handle<Geom_Surface>& S  = DStr.Surface(SD->Surf()).Surface();
+  const occ::handle<Geom_Surface>  SB = BRep_Tool::Surface(B);
+  if (S.IsNull() || SB.IsNull())
+  {
+    return false;
+  }
+  GeomInt_IntSS anInter;
+  anInter.Perform(S, SB, 2.e-7, true, false, false);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  const double aTolP = std::max(100. * tol3d, 1.e-4);
+  const auto   onLine = [&](const occ::handle<Geom_Curve>& C, const gp_Pnt& P) {
+    GeomAPI_ProjectPointOnCurve aPr(P, C);
+    double                      d = aPr.NbPoints() > 0 ? aPr.LowerDistance() : RealLast();
+    if (!C->IsPeriodic())
+    {
+      d = std::min(d, std::min(C->Value(C->FirstParameter()).Distance(P), C->Value(C->LastParameter()).Distance(P)));
+    }
+    return d <= aTolP;
+  };
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    const occ::handle<Geom_Curve> Ci = anInter.Line(i);
+    if (Ci->IsPeriodic() || !onLine(Ci, P1))
+    {
+      continue;
+    }
+    for (int j = 1; j <= anInter.NbLines(); j++)
+    {
+      const occ::handle<Geom_Curve> Cj = anInter.Line(j);
+      if (j == i || Cj->IsPeriodic() || !onLine(Cj, P2))
+      {
+        continue;
+      }
+      for (const double ti : {Ci->FirstParameter(), Ci->LastParameter()})
+      {
+        for (const double tj : {Cj->FirstParameter(), Cj->LastParameter()})
+        {
+          const gp_Pnt E = Ci->Value(ti);
+          if (E.Distance(Cj->Value(tj)) > aTolP)
+          {
+            continue;
+          }
+          // The section through E: where the other contact's line comes
+          // nearest to E, as for the spine's points.
+          double tE = 0., t1 = 0., t2 = 0.;
+          if (!ChFi3d_KPartLineParam(DStr, SD, 3 - ons, E, tE)
+              || !ChFi3d_KPartLineParam(DStr, SD, 3 - ons, Spine->Value(W1), t1)
+              || !ChFi3d_KPartLineParam(DStr, SD, 3 - ons, Spine->Value(W2), t2)
+              || (tE - t1) * (tE - t2) > 0.)
+          {
+            continue;
+          }
+          double a = W1, b = W2;
+          for (int it = 0; it < 60; it++)
+          {
+            const double m  = 0.5 * (a + b);
+            double       tm = 0.;
+            if (!ChFi3d_KPartLineParam(DStr, SD, 3 - ons, Spine->Value(m), tm))
+            {
+              return false;
+            }
+            if ((tm - t1) * (tE - t1) >= 0. && std::abs(tm - t1) < std::abs(tE - t1))
+            {
+              a = m;
+            }
+            else
+            {
+              b = m;
+            }
+          }
+          Wm = 0.5 * (a + b);
+          return Wm > W1 && Wm < W2;
+        }
+      }
+    }
+  }
+  return false;
+}
