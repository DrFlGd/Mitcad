+//=======================================================================
+// function : ChFi3d_KPartCutToEnd
+// purpose  : Pieces of an analytic blend split by the domains of its faces,
+//            near an end of an open spine: where the contact on one face N
+//            leaves it across an edge into the face B at the spine's end
+//            (B holds the spine's end vertex V) and does not come back
+//            before that end, the blend runs on, on N's surface, up to the
+//            end, and B cuts it all along: pieces are added whose side on N
+//            is the intersection of the blend with B (as over a hole,
+//            ChFi3d_FillKPartGaps), each edge's own analytic blend on the
+//            edges with no piece. The other contact runs into B at the edge
+//            between its face and B at V; there the cut meets it and the
+//            blend ends in a point (a singular end of the stripe, which needs
+//            no corner). Returns true when the pieces are added.
+//=======================================================================
+
+static bool ChFi3d_KPartCutToEnd(
+  TopOpeBRepDS_DataStructure&                                             DStr,
+  const occ::handle<ChFiDS_Spine>&                                        Spine,
+  NCollection_Array1<NCollection_Sequence<occ::handle<ChFiDS_SurfData>>>& aLSD,
+  const NCollection_Array1<occ::handle<ChFiDS_SurfData>>&                 aFull,
+  NCollection_Array1<int>&                                                aState,
+  NCollection_Array1<bool>&                                               aIntf,
+  NCollection_Array1<bool>&                                               aIntl,
+  const ChFiDS_Map&                                                       EFMap,
+  const ChFiDS_Map&                                                       VFMap,
+  const double                                                            tol3d,
+  const bool                                                              isFirst)
+{
+  if (Spine->IsPeriodic())
+  {
+    return false;
+  }
+  const int           nbed = Spine->NbEdges();
+  const TopoDS_Vertex V    = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  const int           eEnd = isFirst ? 1 : nbed;
+  const int           step = isFirst ? 1 : -1;
+  if (V.IsNull() || !VFMap.Contains(V))
+  {
+    return false;
+  }
+  // The first edge from the end with pieces; the edges before it have none.
+  int k = eEnd;
+  for (; k >= 1 && k <= nbed; k += step)
+  {
+    if (aState(k) == 0 || aFull(k).IsNull())
+    {
+      return false;
+    }
+    if (aState(k) == 2 && !aLSD(k).IsEmpty())
+    {
+      break;
+    }
+  }
+  if (k < 1 || k > nbed)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> P = isFirst ? aLSD(k).First() : aLSD(k).Last();
+  // The side whose contact leaves its face N across an edge E into B.
+  int ons = 0;
+  for (int s = 1; s <= 2 && ons == 0; s++)
+  {
+    const ChFiDS_CommonPoint& CPs = P->Vertex(isFirst, s);
+    const ChFiDS_CommonPoint& CPo = P->Vertex(isFirst, 3 - s);
+    if (CPs.IsOnArc() && !CPs.IsVertex() && !CPo.IsOnArc() && P->Index(s) > 0 && EFMap.Contains(CPs.Arc()))
+    {
+      // (Across the arc, a face at the end.)
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(CPs.Arc())); it.More() && ons == 0; it.Next())
+      {
+        for (NCollection_List<TopoDS_Shape>::Iterator itv(VFMap(V)); itv.More() && ons == 0; itv.Next())
+        {
+          if (itv.Value().IsSame(it.Value()) && !it.Value().IsSame(DStr.Shape(P->Index(s))))
+          {
+            ons = s;
+          }
+        }
+      }
+    }
+  }
+  if (ons == 0)
+  {
+    return false;
+  }
+  const int                 opp = 3 - ons;
+  const ChFiDS_CommonPoint& CPn = P->Vertex(isFirst, ons);
+  const TopoDS_Edge         E   = TopoDS::Edge(CPn.Arc());
+  const TopoDS_Face         N   = TopoDS::Face(DStr.Shape(P->Index(ons)));
+  if (!EFMap.Contains(E))
+  {
+    return false;
+  }
+  TopoDS_Face B;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(N))
+    {
+      B = TopoDS::Face(it.Value());
+    }
+  }
+  bool atEnd = false;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(VFMap(V)); it.More() && !B.IsNull(); it.Next())
+  {
+    atEnd = atEnd || it.Value().IsSame(B);
+  }
+  if (B.IsNull() || !atEnd || ChFi3d::IsTangentFaces(E, N, B))
+  {
+    return false;
+  }
+  // The edges from the end to k: the contact on N lies off N on them (their
+  // blend's side ons is on N's face in the whole blend).
+  for (int e = eEnd; e != k; e += step)
+  {
+    if (aFull(e)->Index(ons) != P->Index(ons))
+    {
+      return false;
+    }
+  }
+  // Where the other contact of the end edge's blend meets the edge Eq
+  // between its face Fo and B at V.
+  const occ::handle<ChFiDS_SurfData>& FullEnd = aFull(eEnd);
+  if (FullEnd->Index(opp) <= 0 || FullEnd->Interference(opp).LineIndex() <= 0
+      || FullEnd->Interference(opp).PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const TopoDS_Face              Fo = TopoDS::Face(DStr.Shape(FullEnd->Index(opp)));
+  const occ::handle<Geom_Curve>& CO = DStr.Curve(FullEnd->Interference(opp).LineIndex()).Curve();
+  TopoDS_Edge                    Eq;
+  for (TopExp_Explorer ex(B, TopAbs_EDGE); ex.More() && Eq.IsNull(); ex.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(Ec) || !EFMap.Contains(Ec))
+    {
+      continue;
+    }
+    bool atV = false;
+    for (TopExp_Explorer exv(Ec, TopAbs_VERTEX); exv.More() && !atV; exv.Next())
+    {
+      atV = exv.Current().IsSame(V);
+    }
+    bool onFo = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Ec)); it.More() && atV; it.Next())
+    {
+      onFo = onFo || it.Value().IsSame(Fo);
+    }
+    if (atV && onFo)
+    {
+      Eq = Ec;
+    }
+  }
+  if (Eq.IsNull() || CO.IsNull())
+  {
+    return false;
+  }
+  double                        fq = 0., lq = 0.;
+  const occ::handle<Geom_Curve> CEq = BRep_Tool::Curve(Eq, fq, lq);
+  if (CEq.IsNull())
+  {
+    return false;
+  }
+  GeomAPI_ExtremaCurveCurve anExt(CO, CEq, CO->FirstParameter(), CO->LastParameter(), fq, lq);
+  double tQ = 0., wQ = 0.;
+  bool   found = false;
+  for (int i = 1; i <= anExt.NbExtrema() && !found; i++)
+  {
+    if (anExt.Distance(i) <= 10. * tol3d)
+    {
+      anExt.Parameters(i, tQ, wQ);
+      found = wQ > fq + Precision::PConfusion() && wQ < lq - Precision::PConfusion();
+    }
+  }
+  if (!found)
+  {
+    return false;
+  }
+  if (CO->IsPeriodic())
+  {
+    const ChFiDS_FaceInterference& FIo  = FullEnd->Interference(opp);
+    const double                   aMid = 0.5 * (FIo.FirstParameter() + FIo.LastParameter());
+    tQ = ElCLib::InPeriod(tQ, aMid - 0.5 * CO->Period(), aMid + 0.5 * CO->Period());
+  }
+  const gp_Pnt Q = CO->Value(tQ);
+  // The section through Q: where the other contact's line comes nearest to
