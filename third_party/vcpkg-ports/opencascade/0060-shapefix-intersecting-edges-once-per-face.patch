   //! FAIL1: some replacements not done because of bad type of subshape
   Standard_EXPORT virtual bool Status(const ShapeExtend_Status status) const;
 
+  //! Clears all substitutions requests
+  Standard_EXPORT void Clear() override;
+
+  //! Applies the substitution requests to a shape as Apply(theShape) does, for a
+  //! caller that applies the same shape again and again (once for each wire of a
+  //! face). When no request has been recorded or cleared since the previous call
+  //! for the same shape, and that call recorded none itself (it rebuilt nothing),
+  //! returns the result and sets the status of that call without exploring the
+  //! shape again: Apply would find the same requests in the same shape. Otherwise
+  //! it is Apply(theShape). A class derived from this one always gets Apply.
+  //! The shape and its sub-shapes must not be changed in place in between (shapes
+  //! added to or removed from them): the requests are the only changes seen.
+  Standard_EXPORT TopoDS_Shape ApplyAgain(const TopoDS_Shape& theShape);
+
   DEFINE_STANDARD_RTTIEXT(ShapeBuild_ReShape, BRepTools_ReShape)
 
+protected:
+  //! Records a request (BRepTools_ReShape::replace) and counts it for ApplyAgain.
+  Standard_EXPORT void replace(const TopoDS_Shape&    theShape,
+                               const TopoDS_Shape&    theNewShape,
+                               const TReplacementKind theKind) override;
+
 private:
   //! Recursive worker for Apply with a DFS in-flight set keyed by TShape handle.
   //! Prevents unbounded descent when a replacement is a compound that transitively
@@ -115,6 +135,18 @@ private:
   TopoDS_Shape applyImpl(const TopoDS_Shape&                          theShape,
                          const TopAbs_ShapeEnum                       theUntil,
                          NCollection_Map<occ::handle<TopoDS_TShape>>& theInFlight);
+
+  //! The number of requests recorded or cleared so far.
+  size_t myNbChanges = 0;
+
+  //! The last call of ApplyAgain that recorded no request: its shape, result and
+  //! status, the number of changes then and the mode of locations.
+  bool         myHasAgain = false;
+  TopoDS_Shape myAgainShape;
+  TopoDS_Shape myAgainResult;
+  int          myAgainStatus           = 0;
+  size_t       myAgainNbChanges        = 0;
+  bool         myAgainConsiderLocation = false;
 };
 
 #endif // _ShapeBuild_ReShape_HeaderFile
