+  // (A point given an arc below is restored unless the pieces are added.)
+  struct RestoreOnFailure
+  {
+    ChFiDS_CommonPoint* CP = nullptr;
+    ChFiDS_CommonPoint  Saved;
+    bool                Keep = false;
+
+    ~RestoreOnFailure()
+    {
+      if (CP != nullptr && !Keep)
+      {
+        *CP = Saved;
+      }
+    }
+  } aRestore;
+  for (int s = 1; s <= 2 && ons == 0; s++)
+  {
+    // A piece whose contact runs along an edge E of its face (on the
+    // boundary, as SplitKPart hatches it there) between N and a face at
+    // the end: its end is on E (its point given the arc E here).
+    ChFiDS_CommonPoint& CPs = P->ChangeVertex(isFirst, s);
+    if (CPs.IsOnArc() || P->Index(s) <= 0 || P->Index(3 - s) <= 0)
+    {
+      continue;
+    }
+    const TopoDS_Face Ns  = TopoDS::Face(DStr.Shape(P->Index(s)));
+    TopoDS_Face       NsF = Ns;
+    NsF.Orientation(TopAbs_FORWARD);
+    for (TopExp_Explorer ex(NsF, TopAbs_EDGE); ex.More() && ons == 0; ex.Next())
+    {
+      const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+      if (BRep_Tool::Degenerated(Ec) || !EFMap.Contains(Ec))
+      {
+        continue;
+      }
+      TopoDS_Face Bc;
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Ec)); it.More(); it.Next())
+      {
+        if (!it.Value().IsSame(Ns))
+        {
+          Bc = TopoDS::Face(it.Value());
+        }
+      }
+      bool atEndc = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator it(VFMap(V)); it.More() && !Bc.IsNull(); it.Next())
+      {
+        atEndc = atEndc || it.Value().IsSame(Bc);
+      }
+      if (!atEndc)
+      {
+        continue;
+      }
+      double                        fc = 0., lc = 0.;
+      const occ::handle<Geom_Curve> Cc = BRep_Tool::Curve(Ec, fc, lc);
+      if (Cc.IsNull())
+      {
+        continue;
+      }
+      GeomAPI_ProjectPointOnCurve aPr(CPs.Point(), Cc, fc, lc);
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+      {
+        continue;
+      }
+      // (The contact runs along Ec over the piece: its middle lies on Ec.)
+      const ChFiDS_FaceInterference& FIs = P->Interference(s);
+      if (FIs.LineIndex() <= 0 || DStr.Curve(FIs.LineIndex()).Curve().IsNull())
+      {
+        continue;
+      }
+      GeomAPI_ProjectPointOnCurve aPm(
+        DStr.Curve(FIs.LineIndex()).Curve()->Value(0.5 * (FIs.FirstParameter() + FIs.LastParameter())),
+        Cc,
+        fc,
+        lc);
+      if (aPm.NbPoints() == 0 || aPm.LowerDistance() > 10. * tol3d)
+      {
+        continue;
+      }
+      const double             w   = aPr.LowerDistanceParameter();
+      const TopAbs_Orientation aTr = isFirst ? TopAbs::Reverse(TopAbs::Compose(FIs.Transition(), Ec.Orientation()))
+                                             : TopAbs::Compose(FIs.Transition(), Ec.Orientation());
+      aRestore.CP    = &CPs;
+      aRestore.Saved = CPs;
+      CPs.SetArc(10. * tol3d, Ec, w, aTr);
+      for (TopExp_Explorer exv(Ec, TopAbs_VERTEX); exv.More(); exv.Next())
+      {
+        const TopoDS_Vertex& Vc = TopoDS::Vertex(exv.Current());
+        if (BRep_Tool::Pnt(Vc).Distance(CPs.Point()) <= 10. * tol3d)
+        {
+          CPs.SetVertex(Vc);
+        }
+      }
+      ons = s;
+    }
+  }
   if (ons == 0)
   {
     return false;
