+//=======================================================================
+// function : PartSection
+// purpose  : Whether SurfData j and the next share only a part of the
+//           section between them: on one side their points differ, both
+//           inner points of edges of one face Bf (an analytic blend cut
+//           over a gap by a chain of faces beyond, one of which, Bf, cuts
+//           it along that section). The section then runs to the nearer
+//           of the two points; from there to the farther one it is the
+//           edge between Bf and the SurfData whose section is the longer.
+//=======================================================================
+
+struct ChFi3d_PartSection
+{
+  int         Side      = 0;     // the side whose points differ
+  bool        NextShort = false; // whether the next SurfData's point is the nearer
+  TopoDS_Face Bf;                // the face of the rest of the section
+};
+
+static bool PartSection(const TopOpeBRepDS_DataStructure&                         DStr,
+                        const int                                                 SolidIndex,
+                        const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil,
+                        const int                                                 j,
+                        const double                                              tol3d,
+                        ChFi3d_PartSection&                                       PS)
+{
+  if (j >= SeqFil.Length())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData>& Fd = SeqFil(j);
+  const occ::handle<ChFiDS_SurfData>& Fn = SeqFil(j + 1);
+  int                                 side = 0;
+  for (int s = 1; s <= 2; s++)
+  {
+    if (Fd->Vertex(false, s).Point().Distance(Fn->Vertex(true, s).Point()) > 100. * tol3d)
+    {
+      if (side != 0)
+      {
+        return false;
+      }
+      side = s;
+    }
+  }
+  if (side == 0)
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint& CPl = Fd->Vertex(false, side);
+  const ChFiDS_CommonPoint& CPn = Fn->Vertex(true, side);
+  if (!CPl.IsOnArc() || !CPn.IsOnArc() || CPl.IsVertex() || CPn.IsVertex() || Fd->Index(side) <= 0
+      || Fn->Index(side) <= 0)
+  {
+    return false;
+  }
+  const TopoDS_Shape& Fl = DStr.Shape(Fd->Index(side));
+  const TopoDS_Shape& Fm = DStr.Shape(Fn->Index(side));
+  TopoDS_Face         Bf;
+  for (TopExp_Explorer ex(DStr.Shape(SolidIndex), TopAbs_FACE); ex.More() && Bf.IsNull(); ex.Next())
+  {
+    if (ex.Current().IsSame(Fl) || ex.Current().IsSame(Fm))
+    {
+      continue;
+    }
+    bool hasL = false, hasN = false;
+    for (TopExp_Explorer exE(ex.Current(), TopAbs_EDGE); exE.More(); exE.Next())
+    {
+      hasL = hasL || exE.Current().IsSame(CPl.Arc());
+      hasN = hasN || exE.Current().IsSame(CPn.Arc());
+    }
+    if (hasL && hasN)
+    {
+      Bf = TopoDS::Face(ex.Current());
+    }
+  }
+  if (Bf.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt Po = Fd->Vertex(false, 3 - side).Point();
+  PS.Side         = side;
+  PS.NextShort    = Po.Distance(CPn.Point()) < Po.Distance(CPl.Point());
+  PS.Bf           = Bf;
+  return true;
+}
+
+// The parameters on surface S of point P, in the periods nearest to Near.
+static gp_Pnt2d ParametersNear(const occ::handle<Geom_Surface>& S, const gp_Pnt& P, const gp_Pnt2d& Near)
+{
+  GeomAPI_ProjectPointOnSurf aPr(P, S);
+  if (aPr.NbPoints() == 0)
+  {
+    return Near;
+  }
+  double u = 0., v = 0.;
+  aPr.LowerDistanceParameters(u, v);
+  if (S->IsUPeriodic())
+  {
+    u = ElCLib::InPeriod(u, Near.X() - 0.5 * S->UPeriod(), Near.X() + 0.5 * S->UPeriod());
+  }
+  if (S->IsVPeriodic())
+  {
+    v = ElCLib::InPeriod(v, Near.Y() - 0.5 * S->VPeriod(), Near.Y() + 0.5 * S->VPeriod());
+  }
+  return gp_Pnt2d(u, v);
+}
