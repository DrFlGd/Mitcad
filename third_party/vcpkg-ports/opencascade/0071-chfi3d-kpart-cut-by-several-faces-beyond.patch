+//=======================================================================
+// function : ChFi3d_KPartEdgeCrossing
+// purpose  : Where edge E crosses the surface of the analytic blend Full
+//            between its contacts, at a section of the spine within
+//            [W1, W2] (the section through a point: where the other
+//            contact's line comes nearest to it, as for the spine's
+//            points), the first such section along the spine: the point P,
+//            its parameter wE on E, the spine parameter W of its section,
+//            its parameters uvS on the blend and the parameter tO of the
+//            section on the other contact's line.
+//=======================================================================
+
+struct ChFi3d_KPartCrossing
+{
+  TopoDS_Edge E;        // the edge crossed
+  gp_Pnt      P;        // the point
+  double      wE = 0.;  // its parameter on E
+  double      W  = 0.;  // the spine parameter of its section
+  double      tO = 0.;  // the section's parameter on the other contact's line
+  gp_Pnt2d    uvS;      // the point's parameters on the blend
+};
+
+static bool ChFi3d_KPartEdgeCrossing(const TopOpeBRepDS_DataStructure&   DStr,
+                                     const occ::handle<ChFiDS_Spine>&    Spine,
+                                     const occ::handle<ChFiDS_SurfData>& Full,
+                                     const int                           ons,
+                                     const TopoDS_Edge&                  E,
+                                     const double                        W1,
+                                     const double                        W2,
+                                     ChFi3d_KPartCrossing&               X)
+{
+  const int                        opp = 3 - ons;
+  const occ::handle<Geom_Surface>& S   = DStr.Surface(Full->Surf()).Surface();
+  const ChFiDS_FaceInterference&   FO  = Full->Interference(opp);
+  const ChFiDS_FaceInterference&   FN  = Full->Interference(ons);
+  if (S.IsNull() || BRep_Tool::Degenerated(E) || FO.PCurveOnSurf().IsNull() || FN.PCurveOnSurf().IsNull()
+      || W2 < W1)
+  {
+    return false;
+  }
+  double t1 = 0., t2 = 0.;
+  if (!ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(W1), t1)
+      || !ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(W2), t2)
+      || std::abs(t2 - t1) <= Precision::PConfusion())
+  {
+    return false;
+  }
+  const gp_Pnt2d a1 = FO.PCurveOnSurf()->Value(t1), a2 = FO.PCurveOnSurf()->Value(t2);
+  const int      along  = std::abs(a2.X() - a1.X()) >= std::abs(a2.Y() - a1.Y()) ? 1 : 2;
+  const int      across = 3 - along;
+  occ::handle<BRepAdaptor_Curve>   aC = new BRepAdaptor_Curve(E);
+  occ::handle<GeomAdaptor_Surface> aS = new GeomAdaptor_Surface(S);
+  IntCurveSurface_HInter           anInter;
+  anInter.Perform(aC, aS);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  bool found = false;
+  for (int i = 1; i <= anInter.NbPoints(); i++)
+  {
+    const IntCurveSurface_IntersectionPoint& aPt = anInter.Point(i);
+    double                                   tE  = 0.;
+    if (!ChFi3d_KPartLineParam(DStr, Full, opp, aPt.Pnt(), tE))
+    {
+      continue;
+    }
+    // (Within the range, its ends included.)
+    const double s = (tE - t1) / (t2 - t1);
+    if (s < -1.e-7 || s > 1. + 1.e-7)
+    {
+      continue;
+    }
+    double Wi = W1;
+    if (s >= 1. - 1.e-7)
+    {
+      Wi = W2;
+    }
+    else if (s > 1.e-7)
+    {
+      double a = W1, b = W2;
+      for (int it = 0; it < 60; it++)
+      {
+        const double m  = 0.5 * (a + b);
+        double       tm = 0.;
+        if (!ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(m), tm))
+        {
+          return false;
+        }
+        if ((tm - t1) / (t2 - t1) < s)
+        {
+          a = m;
+        }
+        else
+        {
+          b = m;
+        }
+      }
+      Wi = 0.5 * (a + b);
+    }
+    if (found && Wi >= X.W)
+    {
+      continue;
+    }
+    // Between the contacts on that section.
+    double tO = 0., tN = 0.;
+    if (!ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(Wi), tO)
+        || !ChFi3d_KPartLineParam(DStr, Full, ons, Spine->Value(Wi), tN))
+    {
+      continue;
+    }
+    const gp_Pnt2d uvO = FO.PCurveOnSurf()->Value(tO), uvN = FN.PCurveOnSurf()->Value(tN);
+    const double   cO = across == 1 ? uvO.X() : uvO.Y(), cN = across == 1 ? uvN.X() : uvN.Y();
+    double         c   = across == 1 ? aPt.U() : aPt.V();
+    const bool     per = across == 1 ? S->IsUPeriodic() : S->IsVPeriodic();
+    if (per)
+    {
+      const double T = across == 1 ? S->UPeriod() : S->VPeriod();
+      c              = ElCLib::InPeriod(c, 0.5 * (cO + cN) - 0.5 * T, 0.5 * (cO + cN) + 0.5 * T);
+    }
+    if (c < std::min(cO, cN) - Precision::PConfusion() || c > std::max(cO, cN) + Precision::PConfusion())
+    {
+      continue;
+    }
+    found = true;
+    X.E   = E;
+    X.P   = aPt.Pnt();
+    X.wE  = aPt.W();
+    X.W   = Wi;
+    X.tO  = tO;
+    X.uvS = across == 1 ? gp_Pnt2d(c, along == 1 ? uvO.X() : uvO.Y()) : gp_Pnt2d(along == 1 ? uvO.X() : uvO.Y(), c);
+  }
+  return found;
+}
