+//=======================================================================
+// function : ChFi3d_KPartCutChain
+// purpose  : Where the contact of an analytic blend on face N leaves N into
+//            a face beyond B0 and comes back from another, Bn (an edge of
+//            a hole or an outline made of several faces): a chain of faces
+//            from B0 to Bn, each sharing with the one before an edge the
+//            blend crosses between its contacts, at sections in order along
+//            the spine within [W0, Wn] (at most four faces). Faces holds the
+//            chain, Crossings the edges between them and where the blend
+//            crosses them.
+//=======================================================================
+
+static bool ChFi3d_KPartCutChainFrom(const TopOpeBRepDS_DataStructure&                DStr,
+                                     const occ::handle<ChFiDS_Spine>&                 Spine,
+                                     const occ::handle<ChFiDS_SurfData>&              Full,
+                                     const int                                        ons,
+                                     const TopoDS_Face&                               N,
+                                     const TopoDS_Shape&                              Fo,
+                                     const TopoDS_Face&                               Bn,
+                                     const double                                     Wfrom,
+                                     const double                                     Wn,
+                                     const ChFiDS_Map&                                EFMap,
+                                     const int                                        depth,
+                                     NCollection_Sequence<TopoDS_Face>&               Faces,
+                                     NCollection_Sequence<ChFi3d_KPartCrossing>&      Crossings)
+{
+  const TopoDS_Face Bi = Faces.Last();
+  if (Bi.IsSame(Bn))
+  {
+    return true;
+  }
+  if (depth <= 0)
+  {
+    return false;
+  }
+  TopoDS_Face BiF = Bi;
+  BiF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(BiF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& Ej = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(Ej) || !EFMap.Contains(Ej))
+    {
+      continue;
+    }
+    TopoDS_Face Bk;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Ej)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(Bi))
+      {
+        Bk = TopoDS::Face(it.Value());
+      }
+    }
+    if (Bk.IsNull() || Bk.IsSame(N) || (!Fo.IsNull() && Bk.IsSame(Fo)))
+    {
+      continue;
+    }
+    bool seen = false;
+    for (int i = 1; i <= Faces.Length() && !seen; i++)
+    {
+      seen = Faces.Value(i).IsSame(Bk);
+    }
+    ChFi3d_KPartCrossing X;
+    if (seen || !ChFi3d_KPartEdgeCrossing(DStr, Spine, Full, ons, Ej, Wfrom, Wn, X))
+    {
+      continue;
+    }
+    Faces.Append(Bk);
+    Crossings.Append(X);
+    if (ChFi3d_KPartCutChainFrom(DStr, Spine, Full, ons, N, Fo, Bn, X.W, Wn, EFMap, depth - 1, Faces, Crossings))
+    {
+      return true;
+    }
+    Faces.Remove(Faces.Length());
+    Crossings.Remove(Crossings.Length());
+  }
+  return false;
+}
+
+static bool ChFi3d_KPartCutChain(const TopOpeBRepDS_DataStructure&           DStr,
+                                 const occ::handle<ChFiDS_Spine>&            Spine,
+                                 const occ::handle<ChFiDS_SurfData>&         Full,
+                                 const int                                   ons,
+                                 const TopoDS_Face&                          N,
+                                 const TopoDS_Face&                          B0,
+                                 const TopoDS_Face&                          Bn,
+                                 const double                                W0,
+                                 const double                                Wn,
+                                 const ChFiDS_Map&                           EFMap,
+                                 NCollection_Sequence<TopoDS_Face>&          Faces,
+                                 NCollection_Sequence<ChFi3d_KPartCrossing>& Crossings)
+{
+  Faces.Clear();
+  Crossings.Clear();
+  Faces.Append(B0);
+  const int    opp = 3 - ons;
+  TopoDS_Shape Fo;
+  if (Full->Index(opp) > 0)
+  {
+    Fo = DStr.Shape(Full->Index(opp));
+  }
+  return ChFi3d_KPartCutChainFrom(DStr, Spine, Full, ons, N, Fo, Bn, W0, Wn, EFMap, 3, Faces, Crossings);
+}
+
+//=======================================================================
+// function : ChFi3d_KPartChainPieces
+// purpose  : The pieces of an analytic blend Full cut by a chain of faces
+//            (ChFi3d_KPartCutChain) between Prev, whose contact on N leaves
+//            N at its end, and Next, whose contact comes back at its start:
+//            one piece per face of the chain, from the crossing before it
+//            (or Prev's end) to the crossing after it (or Next's start). A
+//            face that cuts the blend along a section (both its ends on one
+//            section, e.g. a plane square to a straight spine) gives no
+//            piece: the pieces on either side share only a part of that
+//            section, the rest of it being that face's edge with the blend
+//            (ChFi3d_FilDS).
+//=======================================================================
+
+static bool ChFi3d_KPartChainPieces(TopOpeBRepDS_DataStructure&                         DStr,
+                                    const occ::handle<ChFiDS_Spine>&                    Spine,
+                                    const occ::handle<ChFiDS_SurfData>&                 Full,
+                                    const int                                           ons,
+                                    const TopoDS_Face&                                  N,
+                                    const NCollection_Sequence<TopoDS_Face>&            Faces,
+                                    const NCollection_Sequence<ChFi3d_KPartCrossing>&   Crossings,
+                                    const occ::handle<ChFiDS_SurfData>&                 Prev,
+                                    const occ::handle<ChFiDS_SurfData>&                 Next,
+                                    const double                                        Wa,
+                                    const double                                        Wb,
+                                    const double                                        tol3d,
+                                    NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Pieces)
+{
+  Pieces.Clear();
+  const int                        n   = Faces.Length();
+  const int                        opp = 3 - ons;
+  const occ::handle<Geom_Surface>& S   = DStr.Surface(Full->Surf()).Surface();
+  const ChFiDS_FaceInterference&   FN  = Full->Interference(ons);
+  const ChFiDS_FaceInterference&   FO  = Full->Interference(opp);
+  if (n < 2 || Crossings.Length() != n - 1 || S.IsNull() || FO.LineIndex() <= 0
+      || DStr.Curve(FO.LineIndex()).Curve().IsNull())
+  {
+    return false;
+  }
+  NCollection_List<TopoDS_Shape> aCutEdges;
+  for (int i = 1; i < n; i++)
+  {
+    aCutEdges.Append(Crossings.Value(i).E);
+  }
+  // A crossing as the end of a piece (on its face before) and as the start
+  // of the next one (on its face after): the point on the edge crossed,
+  // with the transition of an end on that arc.
+  const auto crossingEnd = [&](const int i, const TopoDS_Face& B, ChFi3d_KPartCutEnd& anEnd) {
+    const ChFi3d_KPartCrossing& X  = Crossings.Value(i);
+    TopoDS_Face                 BF = B;
+    BF.Orientation(TopAbs_FORWARD);
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(X.E, BF, f, l);
+    if (pc.IsNull())
+    {
+      return false;
+    }
+    const TopoDS_Face&       Bi   = Faces.Value(i);
+    TopoDS_Face              BiF  = Bi;
+    BiF.Orientation(TopAbs_FORWARD);
+    const TopAbs_Orientation aTraB =
+      TopAbs::Compose(FN.Transition(), TopAbs::Compose(N.Orientation(), Bi.Orientation()));
+    anEnd.P   = X.P;
+    anEnd.uvS = X.uvS;
+    anEnd.uvB = pc->Value(X.wE);
+    anEnd.tO  = X.tO;
+    anEnd.V   = TopoDS_Vertex();
+    anEnd.CPN.Reset();
+    anEnd.CPN.SetPoint(X.P);
+    anEnd.CPN.SetArc(tol3d, X.E, X.wE, TopAbs::Compose(aTraB, edgeInFace(X.E, BiF).Orientation()));
+    anEnd.CPO.Reset();
+    anEnd.CPO.SetPoint(DStr.Curve(FO.LineIndex()).Curve()->Value(X.tO));
+    return true;
+  };
+  // The ends of the chain's cuts on the blend: Prev's end, the crossings,
+  // Next's start.
+  const auto uvAt = [&](const int i) {
+    if (i == 0)
+    {
+      const ChFiDS_FaceInterference& FI = Prev->Interference(ons);
+      return FI.PCurveOnSurf()->Value(FI.LastParameter());
+    }
+    if (i == n)
+    {
+      const ChFiDS_FaceInterference& FI = Next->Interference(ons);
+      return FI.PCurveOnSurf()->Value(FI.FirstParameter());
+    }
+    return Crossings.Value(i).uvS;
+  };
+  if (Prev->Interference(ons).PCurveOnSurf().IsNull() || Next->Interference(ons).PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  for (int k = 1; k <= n; k++)
+  {
+    const TopoDS_Face& Bk = Faces.Value(k);
+    const double       W1 = k == 1 ? Wa : Crossings.Value(k - 1).W;
+    const double       W2 = k == n ? Wb : Crossings.Value(k).W;
+    if (W2 - W1 <= 10. * Precision::Confusion())
+    {
+      // A cut along a section: the section between its ends lies on Bk.
+      const gp_Pnt2d a = uvAt(k - 1), b = uvAt(k);
+      const gp_Pnt   M = S->Value(0.5 * (a.X() + b.X()), 0.5 * (a.Y() + b.Y()));
+      GeomAPI_ProjectPointOnSurf aPr(M, BRep_Tool::Surface(Bk));
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+      {
+        return false;
+      }
+      continue;
+    }
+    ChFi3d_KPartCutEnd aStart, anEnd;
+    if (k > 1 && !crossingEnd(k - 1, Bk, aStart))
+    {
+      return false;
+    }
+    if (k < n && !crossingEnd(k, Bk, anEnd))
+    {
+      return false;
+    }
+    const occ::handle<ChFiDS_SurfData> aNone;
+    const occ::handle<ChFiDS_SurfData> G = ChFi3d_KPartCutPiece(DStr,
+                                                                Spine,
+                                                                Full,
+                                                                ons,
+                                                                N,
+                                                                Bk,
+                                                                W1,
+                                                                W2,
+                                                                k == 1 ? Prev : aNone,
+                                                                k == n ? Next : aNone,
+                                                                tol3d,
+                                                                k > 1 ? &aStart : nullptr,
+                                                                k < n ? &anEnd : nullptr,
+                                                                &aCutEdges);
+    if (G.IsNull())
+    {
+      return false;
+    }
+    Pieces.Append(G);
+  }
+  return !Pieces.IsEmpty();
+}
