+// Whether two surfaces of analytic blends are one surface with one
+// parametrization (copies, as the pieces of one blend have).
+static bool ChFi3d_SameAnalyticSurface(const occ::handle<Geom_Surface>& S1, const occ::handle<Geom_Surface>& S2)
+{
+  if (S1.IsNull() || S2.IsNull() || S1->DynamicType() != S2->DynamicType())
+  {
+    return false;
+  }
+  const GeomAdaptor_Surface A1(S1), A2(S2);
+  if (A1.GetType() != A2.GetType())
+  {
+    return false;
+  }
+  const double tol     = Precision::Confusion();
+  const auto   samePos = [&](const gp_Ax3& a, const gp_Ax3& b) {
+    return a.Location().Distance(b.Location()) <= tol && a.Direction().IsEqual(b.Direction(), Precision::Angular())
+           && a.XDirection().IsEqual(b.XDirection(), Precision::Angular())
+           && a.YDirection().IsEqual(b.YDirection(), Precision::Angular());
+  };
+  switch (A1.GetType())
+  {
+    case GeomAbs_Plane:
+      return samePos(A1.Plane().Position(), A2.Plane().Position());
+    case GeomAbs_Cylinder:
+      return samePos(A1.Cylinder().Position(), A2.Cylinder().Position())
+             && std::abs(A1.Cylinder().Radius() - A2.Cylinder().Radius()) <= tol;
+    case GeomAbs_Cone:
+      return samePos(A1.Cone().Position(), A2.Cone().Position())
+             && std::abs(A1.Cone().RefRadius() - A2.Cone().RefRadius()) <= tol
+             && std::abs(A1.Cone().SemiAngle() - A2.Cone().SemiAngle()) <= Precision::Angular();
+    case GeomAbs_Sphere:
+      return samePos(A1.Sphere().Position(), A2.Sphere().Position())
+             && std::abs(A1.Sphere().Radius() - A2.Sphere().Radius()) <= tol;
+    case GeomAbs_Torus:
+      return samePos(A1.Torus().Position(), A2.Torus().Position())
+             && std::abs(A1.Torus().MajorRadius() - A2.Torus().MajorRadius()) <= tol
+             && std::abs(A1.Torus().MinorRadius() - A2.Torus().MinorRadius()) <= tol;
+    default:
+      return false;
+  }
+}
