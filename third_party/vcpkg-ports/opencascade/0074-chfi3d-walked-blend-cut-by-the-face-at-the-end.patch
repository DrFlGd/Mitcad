+//=======================================================================
+// function : WalkedCutToEnd
+// purpose  : As ChFi3d_KPartCutToEnd for a walked blend: the walk stopped
+//            short of an end of the spine where the contact on face N
+//            left N across an edge E into the face B that holds the
+//            spine's end vertex V. The blend is walked on from there with
+//            N's surface unbounded, up to where its other contact, on Fo,
+//            reaches the edge Eq between Fo and B at V; the piece walked is
+//            cut by B (ChFi3d_KPartCutPiece), and the stripe ends in a
+//            point on Eq (a free boundary with a singular extremity, as in
+//            ChFi3d_KPartCutToEnd).
+//=======================================================================
+
+bool ChFi3d_Builder::WalkedCutToEnd(const occ::handle<ChFiDS_Stripe>& Stripe, const bool isFirst)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (Spine.IsNull() || Spine->IsPeriodic() || Stripe->SetOfSurfData().IsNull()
+      || Stripe->SetOfSurfData()->IsEmpty() || Spine->ChangeElSpines().IsEmpty())
+  {
+    return false;
+  }
+  if ((isFirst ? Spine->FirstStatus() : Spine->LastStatus()) > ChFiDS_BreakPoint)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  const TopoDS_Vertex         V    = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (V.IsNull() || !myVFMap.Contains(V))
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> P  = isFirst ? Stripe->SetOfSurfData()->Sequence().First()
+                                                  : Stripe->SetOfSurfData()->Sequence().Last();
+  const double                       WP = isFirst ? P->FirstSpineParam() : P->LastSpineParam();
+  const double WEnd = isFirst ? Spine->FirstParameter(1) : Spine->LastParameter(Spine->NbEdges());
+  if ((isFirst ? WP - WEnd : WEnd - WP) <= 10. * tolesp)
+  {
+    return false;
+  }
+  // The side whose contact leaves its face N across an edge E into B.
+  int         ons = 0;
+  TopoDS_Face B;
+  for (int s = 1; s <= 2 && ons == 0; s++)
+  {
+    const ChFiDS_CommonPoint& CPs = P->Vertex(isFirst, s);
+    const ChFiDS_CommonPoint& CPo = P->Vertex(isFirst, 3 - s);
+    if (!CPs.IsOnArc() || CPs.IsVertex() || CPo.IsOnArc() || P->Index(s) <= 0 || !myEFMap.Contains(CPs.Arc()))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator it(myEFMap(CPs.Arc())); it.More() && ons == 0; it.Next())
+    {
+      if (it.Value().IsSame(DStr.Shape(P->Index(s))))
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator itv(myVFMap(V)); itv.More() && ons == 0; itv.Next())
+      {
+        if (itv.Value().IsSame(it.Value()))
+        {
+          ons = s;
+          B   = TopoDS::Face(it.Value());
+        }
+      }
+    }
+  }
+  if (ons == 0 || P->Index(3 - ons) <= 0)
+  {
+    return false;
+  }
+  const int                 opp = 3 - ons;
+  const ChFiDS_CommonPoint& CPn = P->Vertex(isFirst, ons);
+  const TopoDS_Edge         E   = TopoDS::Edge(CPn.Arc());
+  const TopoDS_Face         N   = TopoDS::Face(DStr.Shape(P->Index(ons)));
+  const TopoDS_Face         Fo  = TopoDS::Face(DStr.Shape(P->Index(opp)));
+  if (ChFi3d::IsTangentFaces(E, N, B) || Fo.IsSame(B) || N.IsSame(B))
+  {
+    return false;
+  }
+  // The edge Eq between Fo and B at V.
+  TopoDS_Edge Eq;
+  for (TopExp_Explorer ex(B, TopAbs_EDGE); ex.More() && Eq.IsNull(); ex.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(Ec) || !myEFMap.Contains(Ec))
+    {
+      continue;
+    }
+    bool atV = false;
+    for (TopExp_Explorer exv(Ec, TopAbs_VERTEX); exv.More() && !atV; exv.Next())
+    {
+      atV = exv.Current().IsSame(V);
+    }
+    bool onFo = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(myEFMap(Ec)); it.More() && atV; it.Next())
+    {
+      onFo = onFo || it.Value().IsSame(Fo);
+    }
+    if (atV && onFo)
+    {
+      Eq = Ec;
+    }
+  }
+  if (Eq.IsNull())
+  {
+    return false;
+  }
+  // The guide at that end.
+  occ::handle<ChFiDS_ElSpine> HGuide =
+    isFirst ? Spine->ChangeElSpines().First() : Spine->ChangeElSpines().Last();
+  if (HGuide.IsNull() || WP < HGuide->FirstParameter() || WP > HGuide->LastParameter())
+  {
+    return false;
+  }
+  // The walk on from P's end section, N's surface unbounded.
+  const ChFiDS_FaceInterference& FIn = P->Interference(ons);
+  const ChFiDS_FaceInterference& FIo = P->Interference(opp);
+  if (FIn.PCurveOnFace().IsNull() || FIo.PCurveOnFace().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface> SN = BRep_Tool::Surface(N);
+  if (SN.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face NF = BRepLib_MakeFace(SN, Precision::Confusion());
+  if (NF.IsNull())
+  {
+    return false;
+  }
+  NF.Orientation(N.Orientation());
+  occ::handle<BRepAdaptor_Surface> HSN = new BRepAdaptor_Surface(NF);
+  occ::handle<BRepAdaptor_Surface> HSO = new BRepAdaptor_Surface(Fo);
+  occ::handle<BRepAdaptor_Surface> HS1 = ons == 1 ? HSN : HSO;
+  occ::handle<BRepAdaptor_Surface> HS2 = ons == 1 ? HSO : HSN;
+  occ::handle<BRepTopAdaptor_TopolTool> It1 = new BRepTopAdaptor_TopolTool(HS1);
+  occ::handle<BRepTopAdaptor_TopolTool> It2 = new BRepTopAdaptor_TopolTool(HS2);
+  TopAbs_Orientation Or1   = HS1->Face().Orientation();
+  TopAbs_Orientation Or2   = HS2->Face().Orientation();
+  const int          Choix = ChFi3d::NextSide(Or1,
+                                     Or2,
+                                     Stripe->OrientationOnFace1(),
+                                     Stripe->OrientationOnFace2(),
+                                     Stripe->Choix());
+  math_Vector    Soldep(1, 4);
+  const gp_Pnt2d uv1 = P->Interference(1).PCurveOnFace()->Value(P->Interference(1).Parameter(isFirst));
+  const gp_Pnt2d uv2 = P->Interference(2).PCurveOnFace()->Value(P->Interference(2).Parameter(isFirst));
+  Soldep(1) = uv1.X();
+  Soldep(2) = uv1.Y();
+  Soldep(3) = uv2.X();
+  Soldep(4) = uv2.Y();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>> SeqSD;
+  SeqSD.Append(new ChFiDS_SurfData());
+  double     First = WP, Last = isFirst ? HGuide->FirstParameter() : HGuide->LastParameter();
+  int        intf = 0, intl = 0;
+  const int  nbed = Spine->NbEdges();
+  const double MaxStep = 0.05 * (Spine->LastParameter(nbed) - Spine->FirstParameter(1)) / nbed;
+  const double Fleche  = (HGuide->LastParameter() - HGuide->FirstParameter()) * fleche;
+  bool         walked  = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    walked = PerformSurf(SeqSD, HGuide, Spine, Choix, HS1, It1, HS2, It2, MaxStep, Fleche, tolesp, First,
+                         Last, false, false, !isFirst, false, false, Soldep, intf, intl);
+  }
+  catch (Standard_Failure const&)
+  {
+    walked = false;
+  }
+  if (!walked || SeqSD.Length() != 1)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> X = SeqSD.First();
+  X->ChangeIndexOfS1(DStr.AddShape(ons == 1 ? N : Fo));
+  X->ChangeIndexOfS2(DStr.AddShape(ons == 1 ? Fo : N));
+  // The walk ends where the other contact reaches Eq.
+  const ChFiDS_CommonPoint& CPq = X->Vertex(isFirst, opp);
+  if (!CPq.IsOnArc() || !CPq.Arc().IsSame(Eq) || X->Vertex(isFirst, ons).IsOnArc())
+  {
+    return false;
+  }
+  const double WQ = isFirst ? X->FirstSpineParam() : X->LastSpineParam();
+  const double WX = isFirst ? X->LastSpineParam() : X->FirstSpineParam();
+  if (std::abs(WX - WP) > 10. * tolesp || (isFirst ? WP - WQ : WQ - WP) <= 10. * tolesp)
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& XO = X->Interference(opp);
+  const ChFiDS_FaceInterference& XN = X->Interference(ons);
+  if (XO.PCurveOnSurf().IsNull() || XN.PCurveOnSurf().IsNull() || XO.LineIndex() <= 0 || XN.LineIndex() <= 0)
+  {
+    return false;
+  }
+  TopoDS_Face BF = B, FoF = Fo;
+  BF.Orientation(TopAbs_FORWARD);
+  FoF.Orientation(TopAbs_FORWARD);
+  double                          f = 0., l = 0.;
+  const occ::handle<Geom2d_Curve> pcB  = BRep_Tool::CurveOnSurface(Eq, BF, f, l);
+  const occ::handle<Geom2d_Curve> pcBE = BRep_Tool::CurveOnSurface(E, BF, f, l);
+  if (pcB.IsNull() || pcBE.IsNull())
+  {
+    return false;
+  }
+  // The end in a point Q on Eq, on both sides.
+  const double       tQ = XO.Parameter(isFirst);
+  const gp_Pnt       Q  = CPq.Point();
+  const double       wQ = CPq.ParameterOnArc();
+  ChFi3d_KPartCutEnd anEnd;
+  anEnd.P   = Q;
+  anEnd.uvS = XO.PCurveOnSurf()->Value(tQ);
+  anEnd.uvB = pcB->Value(wQ);
+  anEnd.tO  = tQ;
+  anEnd.V   = V;
+  {
+    const TopAbs_Orientation OinB  = edgeInFace(Eq, BF).Orientation();
+    const TopAbs_Orientation OinFo = edgeInFace(Eq, FoF).Orientation();
+    const TopAbs_Orientation aTraB =
+      TopAbs::Compose(XN.Transition(), TopAbs::Compose(N.Orientation(), B.Orientation()));
+    const TopAbs_Orientation aTrN = isFirst ? TopAbs::Reverse(TopAbs::Compose(aTraB, OinB))
+                                            : TopAbs::Compose(aTraB, OinB);
+    const TopAbs_Orientation aTrO = isFirst ? TopAbs::Reverse(TopAbs::Compose(XO.Transition(), OinFo))
+                                            : TopAbs::Compose(XO.Transition(), OinFo);
+    anEnd.CPN.Reset();
+    anEnd.CPN.SetPoint(Q);
+    anEnd.CPN.SetArc(tolapp3d, Eq, wQ, aTrN);
+    anEnd.CPO.Reset();
+    anEnd.CPO.SetPoint(Q);
+    anEnd.CPO.SetArc(tolapp3d, Eq, wQ, aTrO);
+  }
+  // The other end: P's end section, where the contact on N leaves N.
+  ChFi3d_KPartCutEnd aJunction;
+  aJunction.P   = CPn.Point();
+  aJunction.uvS = XN.PCurveOnSurf()->Value(XN.Parameter(!isFirst));
+  aJunction.uvB = pcBE->Value(CPn.ParameterOnArc());
+  aJunction.tO  = XO.Parameter(!isFirst);
+  aJunction.CPN = CPn;
+  aJunction.CPO = P->Vertex(isFirst, opp);
+  const occ::handle<ChFiDS_SurfData> aNone;
+  occ::handle<ChFiDS_SurfData>       G;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    G = ChFi3d_KPartCutPiece(DStr,
+                             Spine,
+                             X,
+                             ons,
+                             N,
+                             B,
+                             isFirst ? WQ : WP,
+                             isFirst ? WP : WQ,
+                             aNone,
+                             aNone,
+                             tolapp3d,
+                             isFirst ? &anEnd : &aJunction,
+                             isFirst ? &aJunction : &anEnd);
+  }
+  catch (Standard_Failure const&)
+  {
+    G.Nullify();
+  }
+  if (G.IsNull())
+  {
+    return false;
+  }
+  if (isFirst)
+  {
+    Stripe->ChangeSetOfSurfData()->Prepend(G);
+    Spine->SetFirstStatus(ChFiDS_FreeBoundary);
+  }
+  else
+  {
+    Stripe->ChangeSetOfSurfData()->Append(G);
+    Spine->SetLastStatus(ChFiDS_FreeBoundary);
+  }
+  return true;
+}
+
 // Whether two surfaces of analytic blends are one surface with one
 // parametrization (copies, as the pieces of one blend have).
 static bool ChFi3d_SameAnalyticSurface(const occ::handle<Geom_Surface>& S1, const occ::handle<Geom_Surface>& S2)
@@ -7085,6 +7374,9 @@ void ChFi3d_Builder::PerformSetOfSurf(occ::handle<ChFiDS_Stripe>& Stripe, const
 
   if (!Simul)
   {
+    // Walked blends cut by the face at an end before that end.
+    WalkedCutToEnd(Stripe, true);
+    WalkedCutToEnd(Stripe, false);
     ChFi3d_MakeExtremities(Stripe, DStr, myEFMap, tolapp3d, tol2d);
   }
 }
