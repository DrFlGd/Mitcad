 #define Eps 1.e-15
 
+// The blend is the envelope of a ball of the radius rolling on both surfaces: its centre lies
+// at the radius along the unit normal of each surface at the contact points, and its section
+// for the guide's parameter is the arc of the ball in the plane through the centre that holds
+// both contact normals (the normal plane of the curve the centre runs along). The guide only
+// says which ball: the mid-point of the contact points lies in the guide's normal plane. Where
+// the normals are square to the guide this is the guide's normal plane itself.
+namespace
+{
+//! Second derivative n_ab of the unit normal n = N/|N| from the derivatives of N
+//! (na, nb: first derivatives of n; invnorm = 1/|N|).
+gp_Vec UnitNormalD2(const gp_Vec& n,
+                    const gp_Vec& na,
+                    const gp_Vec& nb,
+                    const gp_Vec& Na,
+                    const gp_Vec& Nb,
+                    const gp_Vec& Nab,
+                    const double  invnorm)
+{
+  const double sa  = n.Dot(Na);
+  const double sb  = n.Dot(Nb);
+  const double sab = nb.Dot(Na) + n.Dot(Nab);
+  gp_Vec       res;
+  res.SetLinearForm(-sa, nb, -sb, na, -sab, n, Nab);
+  return res * invnorm;
+}
+
+//! Normal of the ball's section plane through the directions ns1 and ns2 from the centre
+//! to the contact points, on the side of np (the guide's plane normal, as oriented for the
+//! arc), with its first and second derivatives from those of ns1 and ns2 (Order 0 to 2).
+//! Where ns1 and ns2 are parallel, the guide's plane turned to hold ns1.
+void BallPlane(const gp_Vec& ns1,
+               const gp_Vec& ns2,
+               const gp_Vec& dns1,
+               const gp_Vec& dns2,
+               const gp_Vec& d2ns1,
+               const gp_Vec& d2ns2,
+               const gp_Vec& np,
+               const int     Order,
+               gp_Vec&       bp,
+               gp_Vec&       dbp,
+               gp_Vec&       d2bp)
+{
+  gp_Vec       w    = ns1.Crossed(ns2);
+  const double norm = w.Magnitude();
+  dbp.SetCoord(0., 0., 0.);
+  d2bp.SetCoord(0., 0., 0.);
+  if (norm < 1.e-12)
+  {
+    bp.SetLinearForm(-np.Dot(ns1), ns1, np);
+    const double nbp = bp.Magnitude();
+    bp               = nbp > Eps ? bp / nbp : np;
+    return;
+  }
+  const double sign = np.Dot(w) < 0. ? -1. : 1.;
+  w *= sign;
+  bp = w / norm;
+  if (Order < 1)
+  {
+    return;
+  }
+  gp_Vec dw = (dns1.Crossed(ns2) + ns1.Crossed(dns2)) * sign;
+  // u = w/s, s' = u.w', u' = (w' - u s')/s, u'' = (w'' - 2 u' s' - u s'')/s, s'' = u'.w' + u.w''
+  const double ds = bp.Dot(dw);
+  dbp.SetLinearForm(-ds, bp, dw);
+  dbp /= norm;
+  if (Order < 2)
+  {
+    return;
+  }
+  gp_Vec d2w;
+  d2w.SetLinearForm(1., d2ns1.Crossed(ns2), 2., dns1.Crossed(dns2), ns1.Crossed(d2ns2));
+  d2w *= sign;
+  const double d2s = dbp.Dot(dw) + bp.Dot(d2w);
+  d2bp.SetLinearForm(-2. * ds, dbp, -d2s, bp, d2w);
+  d2bp /= norm;
+}
+
+void BallPlane(const gp_Vec& ns1, const gp_Vec& ns2, const gp_Vec& np, gp_Vec& bp)
+{
+  gp_Vec zero(0., 0., 0.), dbp, d2bp;
+  BallPlane(ns1, ns2, zero, zero, zero, zero, np, 0, bp, dbp, d2bp);
+}
+
+//! Direction from a contact point to the centre for a positive radius: minus the unit normal.
+gp_Vec CentreDirection(const gp_Vec& nsurf)
+{
+  const double norm = nsurf.Magnitude();
+  return norm > Eps ? -nsurf / norm : -nsurf;
+}
+} // namespace
