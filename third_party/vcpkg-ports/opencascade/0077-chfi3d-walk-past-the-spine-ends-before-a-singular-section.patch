+//=======================================================================
+// function : ChFi3d_CutSingularExtension
+// purpose  : Past an end of its spine a rolling ball's walk follows the
+//            guide's straight extension, while the curve of the ball's
+//            centre turns away from it; where the guide's normal plane
+//            comes tangent to that curve the sections meet a singular
+//            point (tangency points, steps getting tiny), and no surface
+//            approximates the line through it. That part only extends the
+//            blend to be cut by the faces at the end: past the spine, the
+//            line is ended before the point where the contacts run twice
+//            as fast along the guide as at the spine's end (or reach a
+//            tangency point).
+//=======================================================================
+
+static void ChFi3d_CutSingularExtension(occ::handle<BRepBlend_Line>&     Lin,
+                                        const occ::handle<ChFiDS_Spine>& Spine)
+{
+  if (Lin.IsNull() || Spine.IsNull() || Spine->IsPeriodic() || Lin->NbPoints() < 4)
+  {
+    return;
+  }
+  const double SpF = Spine->FirstParameter(1);
+  const double SpL = Spine->LastParameter(Spine->NbEdges());
+  // The speed of the contact points along the guide.
+  auto Speed = [](const Blend_Point& P) {
+    return P.IsTangencyPoint() ? RealLast()
+                               : std::max(P.TangentOnS1().Magnitude(), P.TangentOnS2().Magnitude());
+  };
+  // The end of the line: past the spine's end, from where the contacts run
+  // twice as fast as at the end of the spine (the guide's plane has turned
+  // 60 degrees from the ball's).
+  int nb = Lin->NbPoints();
+  int i0 = 0;
+  for (int i = 1; i <= nb && Lin->Point(i).Parameter() <= SpL; i++)
+  {
+    i0 = i;
+  }
+  if (i0 >= 2 && i0 < nb && !Lin->Point(i0).IsTangencyPoint())
+  {
+    const double v0 = Speed(Lin->Point(i0));
+    for (int i = i0 + 1; i <= nb; i++)
+    {
+      if (Speed(Lin->Point(i)) > 2. * v0)
+      {
+        if (i - 1 >= i0)
+        {
+          Lin->Remove(i, nb);
+          UpdateLine(Lin, false);
+        }
+        break;
+      }
+    }
+  }
+  // The start of the line.
+  nb = Lin->NbPoints();
+  i0 = 0;
+  for (int i = nb; i >= 1 && Lin->Point(i).Parameter() >= SpF; i--)
+  {
+    i0 = i;
+  }
+  if (i0 > 1 && i0 <= nb - 1 && !Lin->Point(i0).IsTangencyPoint())
+  {
+    const double v0 = Speed(Lin->Point(i0));
+    for (int i = i0 - 1; i >= 1; i--)
+    {
+      if (Speed(Lin->Point(i)) > 2. * v0)
+      {
+        if (i + 1 <= i0)
+        {
+          Lin->Remove(1, i);
+          UpdateLine(Lin, true);
+        }
+        break;
+      }
+    }
+  }
+}
+
