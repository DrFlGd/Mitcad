+++ b/src/ModelingAlgorithms/TKBool/TopOpeBRepBuild/TopOpeBRepBuild_BuildEdges.cxx
@@ -165,7 +165,7 @@ void TopOpeBRepBuild_Builder::BuildEdges(const occ::handle<TopOpeBRepDS_HDataStr
       {
         int               is = I->Support();
         TopOpeBRepDS_Kind ks = I->SupportType();
-        if (ks == TopOpeBRepDS_POINT)
+        if (ks == TopOpeBRepDS_POINT && is >= 1 && is <= np)
         {
           tp.ChangeValue(is) = tp.Value(is) + 1;
         }
@@ -193,7 +193,7 @@ void TopOpeBRepBuild_Builder::BuildEdges(const occ::handle<TopOpeBRepDS_HDataStr
       {
         int               ig = I->Geometry();
         TopOpeBRepDS_Kind kg = I->GeometryType();
-        if (kg == TopOpeBRepDS_POINT)
+        if (kg == TopOpeBRepDS_POINT && ig >= 1 && ig <= np)
         {
           tp.ChangeValue(ig) = tp.Value(ig) + 1;
         }
@@ -201,7 +201,7 @@ void TopOpeBRepBuild_Builder::BuildEdges(const occ::handle<TopOpeBRepDS_HDataStr
       {
         int               is1 = I->Support();
         TopOpeBRepDS_Kind ks  = I->SupportType();
-        if (ks == TopOpeBRepDS_POINT)
