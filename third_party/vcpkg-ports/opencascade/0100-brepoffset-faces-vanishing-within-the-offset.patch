+void BRepOffset_Inter3d::ConnexIntByArcAcrossVanished(const NCollection_List<TopoDS_Shape>& theAcross,
+                                                      const BRepAlgo_Image& InitOffsetFace)
+{
+  NCollection_List<TopoDS_Shape>::Iterator it(theAcross);
+  for (; it.More(); it.Next())
+  {
+    const TopoDS_Face& InitF1 = TopoDS::Face(it.Value());
+    it.Next();
+    const TopoDS_Edge& E1 = TopoDS::Edge(it.Value());
+    it.Next();
+    const TopoDS_Face& InitF2 = TopoDS::Face(it.Value());
+    it.Next();
+    if (!InitOffsetFace.HasImage(InitF1) || !InitOffsetFace.HasImage(InitF2))
+    {
+      continue;
+    }
+    const TopoDS_Face F1 = TopoDS::Face(InitOffsetFace.Image(InitF1).First());
+    const TopoDS_Face F2 = TopoDS::Face(InitOffsetFace.Image(InitF2).First());
+    if (!IsDone(F1, F2))
+    {
+      NCollection_List<TopoDS_Shape> LInt1, LInt2;
+      BRepOffset_Tool::Inter3D(F1, F2, LInt1, LInt2, mySide, E1, InitF1, InitF2);
+      Store(F1, F2, LInt1, LInt2);
+    }
+  }
+}
