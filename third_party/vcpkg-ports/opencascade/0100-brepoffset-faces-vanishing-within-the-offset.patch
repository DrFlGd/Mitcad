+//! Offset value of the face.
+static double FaceOffsetValue(
+  const TopoDS_Shape&                                                       theF,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset)
+{
+  const double* pOffset = theFaceOffset.Seek(theF);
+  return pOffset ? *pOffset : theOffset;
+}
+
+//! Point, outward normal and surface parameters of the face at the
+//! parameter of its edge.
+static bool PointOnEdgeOfFace(const TopoDS_Edge& theE,
+                              const TopoDS_Face& theF,
+                              const double       theT,
+                              gp_Pnt&            theP,
+                              gp_Vec&            theN,
+                              gp_Pnt2d&          theUV)
+{
+  double                          aF, aL;
+  const occ::handle<Geom2d_Curve> aC2d = BRep_Tool::CurveOnSurface(theE, theF, aF, aL);
+  if (aC2d.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d aUV = aC2d->Value(theT);
+  theUV              = aUV;
+  BRepAdaptor_Surface aS(theF, false);
+  gp_Vec              aDU, aDV;
+  aS.D1(aUV.X(), aUV.Y(), theP, aDU, aDV);
+  theN = aDU.Crossed(aDV);
+  if (theN.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  theN.Normalize();
+  if (theF.Orientation() == TopAbs_REVERSED)
+  {
+    theN.Reverse();
+  }
+  // The 3d point of the edge itself (the surface point of the p-curve may
+  // differ by the edge's tolerance).
+  double                         aF3, aL3;
+  const occ::handle<Geom_Curve>& aC3d = BRep_Tool::Curve(theE, aF3, aL3);
+  if (!aC3d.IsNull())
+  {
+    theP = aC3d->Value(theT);
+  }
+  return true;
+}
+
+//! The other face of the edge in the analysis, or a null face.
+static TopoDS_Face OtherFace(const BRepOffset_Analyse& theAnalyse,
+                             const TopoDS_Edge&        theE,
+                             const TopoDS_Shape&       theF)
+{
+  if (!theAnalyse.HasAncestor(theE))
+  {
+    return TopoDS_Face();
+  }
+  const NCollection_List<TopoDS_Shape>& aLA = theAnalyse.Ancestors(theE);
+  if (aLA.Extent() != 2)
+  {
+    return TopoDS_Face();
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(aLA); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(theF))
+    {
+      return TopoDS::Face(it.Value());
+    }
+  }
+  return TopoDS_Face();
+}
+
+//! Solves the 3x3 system of the planes n_i . X = d_i; false if they are
+//! nearly parallel.
+static bool IntersectPlanes(const gp_Vec theN[3], const double theD[3], gp_Pnt& theX)
+{
+  const gp_Vec aC12 = theN[1].Crossed(theN[2]);
+  const double aDet = theN[0].Dot(aC12);
+  if (std::abs(aDet) < 1.e-9)
+  {
+    return false;
+  }
+  const gp_Vec aX = (aC12 * theD[0] + theN[2].Crossed(theN[0]) * theD[1]
+                     + theN[0].Crossed(theN[1]) * theD[2])
+                    / aDet;
+  theX            = gp_Pnt(aX.XYZ());
+  return true;
+}
+
+//! The surface of the face moved by theOffset along its outward normal, or
+//! null if it cannot be made (cached).
+static occ::handle<Geom_Surface> OffsetSurface(
+  const TopoDS_Face&                                                                       theF,
+  const double                                                                             theOffset,
+  NCollection_DataMap<TopoDS_Shape, occ::handle<Geom_Surface>, TopTools_ShapeMapHasher>& theCache)
+{
+  if (const occ::handle<Geom_Surface>* pS = theCache.Seek(theF))
+  {
+    return *pS;
+  }
+  occ::handle<Geom_Surface> aS = BRep_Tool::Surface(theF);
+  occ::handle<Geom_Surface> aOS;
+  if (!aS.IsNull())
+  {
+    occ::handle<Geom_RectangularTrimmedSurface> aRT =
+      occ::down_cast<Geom_RectangularTrimmedSurface>(aS);
+    if (!aRT.IsNull())
+    {
+      aS = aRT->BasisSurface();
+    }
+    try
+    {
+      OCC_CATCH_SIGNALS
+      aOS = new Geom_OffsetSurface(aS,
+                                   theF.Orientation() == TopAbs_REVERSED ? -theOffset : theOffset,
+                                   true);
+    }
+    catch (Standard_Failure const&)
+    {
+      aOS.Nullify();
+    }
+  }
+  theCache.Bind(theF, aOS);
+  return aOS;
+}
+
+//! Image of the point of parameter theT of the edge theE of the face theF on
+//! the boundary of the offset of theF: moved along the normal where the edge
+//! is smooth or free, else where the offsets of theF and of the face beyond
+//! the edge meet in the plane normal to the edge. False where it cannot be
+//! computed.
+static bool ImageOnOffsetBoundary(
+  const TopoDS_Edge&                                                                   theE,
+  const TopoDS_Face&                                                                   theF,
+  const double                                                                         theT,
+  const BRepOffset_Analyse&                                                            theAnalyse,
+  const GeomAbs_JoinType                                                               theJoin,
+  NCollection_DataMap<TopoDS_Shape, occ::handle<Geom_Surface>, TopTools_ShapeMapHasher>& theOffsetSurfaces,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset,
+  gp_Pnt&                                                                   theP,
+  gp_Pnt&                                                                   theImage)
+{
+  gp_Vec   aNF;
+  gp_Pnt2d aUVF;
+  if (!PointOnEdgeOfFace(theE, theF, theT, theP, aNF, aUVF))
+  {
+    return false;
+  }
+  const double aDF = FaceOffsetValue(theF, theFaceOffset, theOffset);
+  theImage         = theP.Translated(aNF * aDF);
+  //
+  const NCollection_List<BRepOffset_Interval>& aLI = theAnalyse.Type(theE);
+  if (aLI.IsEmpty())
+  {
+    return true;
+  }
+  const ChFiDS_TypeOfConcavity aType = aLI.First().Type();
+  if (aType != ChFiDS_Convex && aType != ChFiDS_Concave)
+  {
+    return true;
+  }
+  if (theJoin == GeomAbs_Arc && aType == (theOffset < 0. ? ChFiDS_Concave : ChFiDS_Convex))
+  {
+    // a tube joins the offsets there
+    return true;
+  }
+  const TopoDS_Face aG = OtherFace(theAnalyse, theE, theF);
+  if (aG.IsNull())
+  {
+    return true;
+  }
+  gp_Pnt   aPG;
+  gp_Vec   aNG;
+  gp_Pnt2d aUVG;
+  if (!PointOnEdgeOfFace(theE, aG, theT, aPG, aNG, aUVG))
+  {
+    return false;
+  }
+  const double aDG = FaceOffsetValue(aG, theFaceOffset, theOffset);
+  // Plane normal to the edge
+  double                         aF3, aL3;
+  const occ::handle<Geom_Curve>& aC3d = BRep_Tool::Curve(theE, aF3, aL3);
+  if (aC3d.IsNull())
+  {
+    return false;
+  }
+  gp_Pnt aPE;
+  gp_Vec aTE;
+  aC3d->D1(theT, aPE, aTE);
+  if (aTE.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  aTE.Normalize();
+  gp_Vec aN[3] = {aNF, aNG, aTE};
+  double aD[3] = {aNF.Dot(gp_Vec(theP.XYZ())) + aDF,
+                  aNG.Dot(gp_Vec(theP.XYZ())) + aDG,
+                  aTE.Dot(gp_Vec(theP.XYZ()))};
+  gp_Pnt aX;
+  if (!IntersectPlanes(aN, aD, aX))
+  {
+    return true;
+  }
+  // Refine on the offset surfaces themselves where they are curved (by their
+  // tangent planes at the projections of the point).
+  const bool bPlanes = BRepAdaptor_Surface(theF, false).GetType() == GeomAbs_Plane
+                       && BRepAdaptor_Surface(aG, false).GetType() == GeomAbs_Plane;
+  const occ::handle<Geom_Surface> aSF =
+    bPlanes ? occ::handle<Geom_Surface>() : OffsetSurface(theF, aDF, theOffsetSurfaces);
+  const occ::handle<Geom_Surface> aSG =
+    bPlanes ? occ::handle<Geom_Surface>() : OffsetSurface(aG, aDG, theOffsetSurfaces);
+  if (!aSF.IsNull() && !aSG.IsNull())
+  {
+    const gp_Pnt        aX0 = aX;
+    GeomAdaptor_Surface aGA[2] = {GeomAdaptor_Surface(aSF), GeomAdaptor_Surface(aSG)};
+    // the offset surfaces share the parameters of the faces' surfaces
+    double aU[2] = {aUVF.X(), aUVG.X()};
+    double aV[2] = {aUVF.Y(), aUVG.Y()};
+    for (int anIter = 0; anIter < 4; ++anIter)
+    {
+      gp_Pnt aQ[2];
+      gp_Vec aNQ[2];
+      bool   bOk = true;
+      for (int k = 0; k < 2 && bOk; ++k)
+      {
+        Extrema_GenLocateExtPS aLoc(aGA[k]);
+        aLoc.Perform(aX, aU[k], aV[k]);
+        bOk = aLoc.IsDone();
+        if (!bOk)
+        {
+          break;
+        }
+        aLoc.Point().Parameter(aU[k], aV[k]);
+        gp_Vec aDU, aDV;
+        aGA[k].D1(aU[k], aV[k], aQ[k], aDU, aDV);
+        aNQ[k] = aDU.Crossed(aDV);
+        bOk    = aNQ[k].Magnitude() > gp::Resolution();
+        if (bOk)
+        {
+          aNQ[k].Normalize();
+        }
+      }
+      if (!bOk)
+      {
+        break;
+      }
+      gp_Vec aNI[3] = {aNQ[0], aNQ[1], aTE};
+      double aDI[3] = {aNQ[0].Dot(gp_Vec(aQ[0].XYZ())),
+                       aNQ[1].Dot(gp_Vec(aQ[1].XYZ())),
+                       aTE.Dot(gp_Vec(theP.XYZ()))};
+      gp_Pnt aXI;
+      if (!IntersectPlanes(aNI, aDI, aXI))
+      {
+        break;
+      }
+      if (aXI.Distance(aX0) > std::abs(aDF) + std::abs(aDG))
+      {
+        // off to another part of the surfaces: keep the tangent planes' point
+        aX = aX0;
+        break;
+      }
+      const bool bConverged = aXI.SquareDistance(aX) < Precision::SquareConfusion();
+      aX                    = aXI;
+      if (bConverged)
+      {
+        break;
+      }
+    }
+  }
+  theImage = aX;
+  return true;
+}
+
+//! Checks whether the offset of the face vanishes between the two edges:
+//! at each of several stations along theEA, the images of the point on theEA
+//! and of the nearest point on theEB lie in the opposite order on the offset
+//! (or coincide). Returns 1 where it vanishes at every station, 0 where it
+//! vanishes nowhere, -1 where only in parts or where it cannot be decided.
+static int VanishesBetween(
+  const TopoDS_Face&                                                                   theF,
+  const TopoDS_Edge&                                                                   theEA,
+  const TopoDS_Edge&                                                                   theEB,
+  const BRepOffset_Analyse&                                                            theAnalyse,
+  const GeomAbs_JoinType                                                               theJoin,
+  NCollection_DataMap<TopoDS_Shape, occ::handle<Geom_Surface>, TopTools_ShapeMapHasher>& theOffsetSurfaces,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset)
+{
+  double                         aFA, aLA, aFB, aLB;
+  const occ::handle<Geom_Curve>& aCA = BRep_Tool::Curve(theEA, aFA, aLA);
+  const occ::handle<Geom_Curve>& aCB = BRep_Tool::Curve(theEB, aFB, aLB);
+  if (aCA.IsNull() || aCB.IsNull())
+  {
+    return -1;
+  }
+  const double aDF = std::abs(FaceOffsetValue(theF, theFaceOffset, theOffset));
+  const int    aNbStations = 5;
+  int          aNbVanished = 0, aNbKept = 0;
+  for (int i = 0; i < aNbStations; ++i)
+  {
+    const double aTA = aFA + (aLA - aFA) * (i + 0.5) / aNbStations;
+    gp_Pnt       aPA, aImA;
+    if (!ImageOnOffsetBoundary(theEA,
+                               theF,
+                               aTA,
+                               theAnalyse,
+                               theJoin,
+                               theOffsetSurfaces,
+                               theFaceOffset,
+                               theOffset,
+                               aPA,
+                               aImA))
+    {
+      return -1;
+    }
+    // The nearest point of theEB (inside it or at an end)
+    double                      aTB   = aFB;
+    double                      aDist = aPA.Distance(aCB->Value(aFB));
+    GeomAPI_ProjectPointOnCurve aProj(aPA, aCB, aFB, aLB);
+    if (aProj.NbPoints() > 0 && aProj.LowerDistance() < aDist)
+    {
+      aTB   = aProj.LowerDistanceParameter();
+      aDist = aProj.LowerDistance();
+    }
+    if (aPA.Distance(aCB->Value(aLB)) < aDist)
+    {
+      aTB   = aLB;
+      aDist = aPA.Distance(aCB->Value(aLB));
+    }
+    // Too wide a face to vanish at this offset
+    if (aDist > 10. * aDF)
+    {
+      return 0;
+    }
+    gp_Pnt aPB, aImB;
+    if (!ImageOnOffsetBoundary(theEB,
+                               theF,
+                               aTB,
+                               theAnalyse,
+                               theJoin,
+                               theOffsetSurfaces,
+                               theFaceOffset,
+                               theOffset,
+                               aPB,
+                               aImB))
+    {
+      return -1;
+    }
+    const gp_Vec aW(aPA, aPB);
+    const gp_Vec aWI(aImA, aImB);
+    if (aWI.Magnitude() < Precision::Confusion() || aWI.Dot(aW) < 0.)
+    {
+      ++aNbVanished;
+    }
+    else
+    {
+      ++aNbKept;
+    }
+  }
+  if (aNbVanished == aNbStations)
+  {
+    return 1;
+  }
+  return aNbKept == aNbStations ? 0 : -1;
+}
+
+//! The edges of the outer wire of the face in their order, or false if the
+//! face has another wire.
+static bool OrderedEdges(const TopoDS_Face& theF, NCollection_Sequence<TopoDS_Edge>& theEdges)
+{
+  int             aNbW = 0;
+  TopoDS_Iterator aItW(theF);
+  for (; aItW.More(); aItW.Next())
+  {
+    ++aNbW;
+  }
+  if (aNbW != 1)
+  {
+    return false;
+  }
+  const TopoDS_Wire      aW = BRepTools::OuterWire(theF);
+  BRepTools_WireExplorer aWExp(aW, theF);
+  for (; aWExp.More(); aWExp.Next())
+  {
+    theEdges.Append(aWExp.Current());
+  }
+  return true;
+}
