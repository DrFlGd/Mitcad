+    }
+  }
+  //
+  for (int i = 1; i <= aDMFPairs.Extent(); ++i)
+  {
+    theVanished.Add(aDMFPairs.FindKey(i));
+  }
+  //
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aMEDone;
+  for (int i = 1; i <= aDMFPairs.Extent(); ++i)
+  {
+    const TopoDS_Shape&                      aF = aDMFPairs.FindKey(i);
+    NCollection_List<TopoDS_Shape>::Iterator aItP(aDMFPairs(i));
+    for (; aItP.More(); aItP.Next())
+    {
+      TopoDS_Edge aE[2];
+      aE[0] = TopoDS::Edge(aItP.Value());
+      aItP.Next();
+      aE[1] = TopoDS::Edge(aItP.Value());
+      TopoDS_Face aG[2];
+      for (int k = 0; k < 2; ++k)
+      {
+        TopoDS_Shape aCur = aF;
+        for (int aGuard = 0; aGuard < 100; ++aGuard)
+        {
+          aG[k] = OtherFace(theAnalyse, aE[k], aCur);
+          if (!theVanished.Contains(aG[k]))
+          {
+            break;
+          }
+          NCollection_List<TopoDS_Shape>::Iterator aItG(aDMFPairs.FindFromKey(aG[k]));
+          for (; aItG.More(); aItG.Next())
+          {
+            const TopoDS_Shape& aE1 = aItG.Value();
+            aItG.Next();
+            const TopoDS_Shape& aE2 = aItG.Value();
+            if (aE1.IsSame(aE[k]))
+            {
+              aE[k] = TopoDS::Edge(aE2);
+              break;
+            }
+            if (aE2.IsSame(aE[k]))
+            {
+              aE[k] = TopoDS::Edge(aE1);
+              break;
+            }
+          }
+          aCur = aG[k];
+        }
+      }
+      if (aG[0].IsSame(aG[1]) || (aMEDone.Contains(aE[0]) && aMEDone.Contains(aE[1])))
+      {
+        continue;
+      }
+      aMEDone.Add(aE[0]);
+      aMEDone.Add(aE[1]);
+      theAcross.Append(aG[0]);
+      theAcross.Append(aE[0]);
+      theAcross.Append(aG[1]);
+      theAcross.Append(aE[1]);
+    }
+  }
+}
