+//=======================================================================
+// function : FindVanishingFaces
+// purpose  : Finds the faces whose offset vanishes within the offset
+//           distance: strips of four edges whose offset turns inside out
+//           across two opposite edges all along them (a chamfer or a
+//           rounding narrower than the offset of the faces beside it),
+//           and for each such pair of edges the faces beyond them, whose
+//           offsets are to meet each other instead (theAcross: face A,
+//           its edge to the vanishing faces, face B, its edge).
+//=======================================================================
+static void FindVanishingFaces(
+  const TopoDS_Shape&                                                                  theShape,
+  const BRepOffset_Analyse&                                                            theAnalyse,
+  const GeomAbs_JoinType                                                               theJoin,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset,
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>&                   theVanished,
+  NCollection_List<TopoDS_Shape>&                                           theAcross)
+{
+  // Face -> the pairs of its opposite edges across which it vanishes
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>
+                                                                                      aDMFPairs;
+  NCollection_DataMap<TopoDS_Shape, occ::handle<Geom_Surface>, TopTools_ShapeMapHasher> theOffsetSurfaces;
+  for (TopExp_Explorer aExpF(theShape, TopAbs_FACE); aExpF.More(); aExpF.Next())
+  {
+    const TopoDS_Face&                aF = TopoDS::Face(aExpF.Current());
+    NCollection_Sequence<TopoDS_Edge> aLE;
+    if (!OrderedEdges(aF, aLE) || aLE.Length() != 4)
+    {
+      continue;
+    }
+    if (theJoin == GeomAbs_Arc)
+    {
+      // a face with a tube along an edge stays (the tube would lose a side)
+      bool bTube = false;
+      for (int i = 1; i <= aLE.Length(); ++i)
+      {
+        const NCollection_List<BRepOffset_Interval>& aLI = theAnalyse.Type(aLE(i));
+        bTube = bTube
+                || (!aLI.IsEmpty()
+                    && aLI.First().Type() == (theOffset < 0. ? ChFiDS_Concave : ChFiDS_Convex));
+      }
+      if (bTube)
+      {
+        continue;
+      }
+    }
+    // The face vanishes where its offset turns inside out between two
+    // opposite edges all along them, whatever happens in the other direction.
+    NCollection_List<TopoDS_Shape> aPairs;
+    for (int i = 1; i <= 2; ++i)
+    {
+      const TopoDS_Edge& aEA = aLE(i);
+      const TopoDS_Edge& aEB = aLE(i + 2);
+      if (aEA.IsSame(aEB) || BRep_Tool::Degenerated(aEA) || BRep_Tool::Degenerated(aEB))
+      {
+        continue;
+      }
+      const int aRes = VanishesBetween(aF,
+                                       aEA,
+                                       aEB,
+                                       theAnalyse,
+                                       theJoin,
+                                       theOffsetSurfaces,
+                                       theFaceOffset,
+                                       theOffset);
+      if (aRes == 1)
+      {
+        aPairs.Append(aEA);
+        aPairs.Append(aEB);
+      }
+    }
+    if (!aPairs.IsEmpty())
+    {
+      aDMFPairs.Add(aF, aPairs);
+    }
+  }
+  //
+  // Faces beyond the vanishing ones: across each pair, past vanishing faces
+  // in a row, to the first face kept on each side. A face that cannot be
+  // closed this way (a free or open edge beyond it) stays.
+  for (int aRemove = 1; aRemove > 0;)
+  {
+    aRemove = 0;
+    for (int i = 1; i <= aDMFPairs.Extent() && !aRemove; ++i)
+    {
+      const TopoDS_Shape&                      aF = aDMFPairs.FindKey(i);
+      NCollection_List<TopoDS_Shape>::Iterator aItP(aDMFPairs(i));
+      for (; aItP.More() && !aRemove; aItP.Next())
+      {
+        TopoDS_Edge aE[2];
+        aE[0] = TopoDS::Edge(aItP.Value());
+        aItP.Next();
+        aE[1] = TopoDS::Edge(aItP.Value());
+        for (int k = 0; k < 2 && !aRemove; ++k)
+        {
+          TopoDS_Shape aCur = aF;
+          TopoDS_Edge  aEC  = aE[k];
+          for (int aGuard = 0; aGuard < 100; ++aGuard)
+          {
+            const TopoDS_Face aG = OtherFace(theAnalyse, aEC, aCur);
+            if (aG.IsNull())
+            {
+              // a free or open edge: aF cannot be closed
+              aRemove = i;
+              break;
+            }
+            const NCollection_List<TopoDS_Shape>* pGPairs = aDMFPairs.Seek(aG);
+            if (!pGPairs)
+            {
+              break;
+            }
+            // continue across aG by its pair holding aEC
+            TopoDS_Edge                              aENext;
+            NCollection_List<TopoDS_Shape>::Iterator aItG(*pGPairs);
+            for (; aItG.More(); aItG.Next())
+            {
+              const TopoDS_Shape& aE1 = aItG.Value();
+              aItG.Next();
+              const TopoDS_Shape& aE2 = aItG.Value();
+              if (aE1.IsSame(aEC))
+              {
