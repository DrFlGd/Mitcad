+void BRepOffset_Inter3d::ConnexIntAcrossVanished(
+  const NCollection_List<TopoDS_Shape>&                                                theAcross,
+  const NCollection_DataMap<TopoDS_Shape, BRepOffset_Offset, TopTools_ShapeMapHasher>& MapSF,
+  const BRepOffset_Analyse&                                                            Analyse,
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>&            MES,
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>&            Build,
+  NCollection_List<TopoDS_Shape>&                                                      Failed,
+  const TopAbs_State                                                                   theSide)
+{
+  BRep_Builder                             B;
+  NCollection_List<TopoDS_Shape>::Iterator it(theAcross);
+  for (; it.More(); it.Next())
+  {
+    TopoDS_Face F[2], NF[2];
+    TopoDS_Edge E[2];
+    for (int k = 0; k < 2; ++k)
+    {
+      if (k == 1)
+      {
+        it.Next();
+      }
+      F[k] = TopoDS::Face(it.Value());
+      it.Next();
+      E[k] = TopoDS::Edge(it.Value());
+      //
+      const TopoDS_Face OF = TopoDS::Face(MapSF(F[k]).Face());
+      if (!MES.IsBound(OF))
+      {
+        bool enlargeU      = true;
+        bool enlargeVfirst = true, enlargeVlast = true;
+        BRepOffset_Tool::CheckBounds(F[k], Analyse, enlargeU, enlargeVfirst, enlargeVlast);
+        BRepOffset_Tool::EnLargeFace(OF, NF[k], true, true, enlargeU, enlargeVfirst, enlargeVlast);
+        MES.Bind(OF, NF[k]);
+      }
+      else
+      {
+        NF[k] = TopoDS::Face(MES(OF));
+      }
+    }
+    //
+    NCollection_List<TopoDS_Shape> LInt1, LInt2;
+    if (!IsDone(NF[0], NF[1]))
+    {
+      // The section nearest to the edge of the vanishing faces, oriented as
+      // at an edge between the two faces (theSide: convex where the offset
+      // goes inside, concave where it goes outside).
+      BRepOffset_Tool::Inter3D(NF[0], NF[1], LInt1, LInt2, theSide, E[0], F[0], F[1]);
+      SetDone(NF[0], NF[1]);
+      if (LInt1.IsEmpty())
+      {
+        Failed.Append(E[0]);
+        continue;
+      }
+      Store(NF[0], NF[1], LInt1, LInt2);
+    }
+    else
+    {
+      // already intersected elsewhere: the common edges of both
+      const NCollection_List<TopoDS_Shape>& aLInt1 = myAsDes->Descendant(NF[0]);
+      const NCollection_List<TopoDS_Shape>& aLInt2 = myAsDes->Descendant(NF[1]);
+      for (NCollection_List<TopoDS_Shape>::Iterator it1(aLInt1); it1.More(); it1.Next())
+      {
+        for (NCollection_List<TopoDS_Shape>::Iterator it2(aLInt2); it2.More(); it2.Next())
+        {
+          if (it1.Value().IsSame(it2.Value()))
+          {
+            LInt1.Append(it1.Value());
+          }
+        }
+      }
+      if (LInt1.IsEmpty())
+      {
+        Failed.Append(E[0]);
+        continue;
+      }
+    }
+    for (int k = 0; k < 2; ++k)
+    {
+      TopoDS_Compound C;
+      B.MakeCompound(C);
+      if (Build.IsBound(E[k]))
+      {
+        for (TopExp_Explorer aExp(Build(E[k]), TopAbs_EDGE); aExp.More(); aExp.Next())
+        {
+          B.Add(C, aExp.Current());
+        }
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator itI(LInt1); itI.More(); itI.Next())
+      {
+        B.Add(C, itI.Value());
+      }
+      Build.Bind(E[k], C);
+    }
+  }
+}
