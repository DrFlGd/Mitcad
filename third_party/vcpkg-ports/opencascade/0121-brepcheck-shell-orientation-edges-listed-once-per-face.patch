+// The orientations of the edges of a shell's faces, in the order an explorer of each face
+// (oriented as in the shell) meets them, found once for a face of many edges: searching such a
+// face for each of its edges made the orientation check quadratic in the edges of a face (a
+// face of 23 000 edges, a plate with thousands of holes, took seconds). Faces of few edges are
+// searched as before.
+class EdgeOrientationsOfFaces
+{
+public:
+  //! The orientation of the occurrence theRank (0 for the first) of theEdge in theFace, oriented
+  //! as in the shell; false when there is none or theFace has few edges (the caller then
+  //! searches the face as before).
+  bool Find(const TopoDS_Face&  theFace,
+            const TopoDS_Shape& theEdge,
+            const int           theRank,
+            TopAbs_Orientation& theOrientation)
+  {
+    const std::shared_ptr<Edges>* aKept = myFaces.Seek(theFace);
+    if (aKept == nullptr)
+    {
+      std::shared_ptr<Edges> aNew;
+      int                    aCount = 0;
+      for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        ++aCount;
+      }
+      if (aCount >= THE_MANY_EDGES)
+      {
+        aNew = std::make_shared<Edges>();
+        for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+        {
+          std::vector<TopAbs_Orientation>* aList = aNew->ChangeSeek(anExp.Current());
+          if (aList == nullptr)
+          {
+            aList = aNew->Bound(anExp.Current(), std::vector<TopAbs_Orientation>());
+          }
+          aList->push_back(anExp.Current().Orientation());
+        }
+      }
+      aKept = myFaces.Bound(theFace, aNew);
+    }
+    if (!*aKept)
+    {
+      return false;
+    }
+    const std::vector<TopAbs_Orientation>* aList = (*aKept)->Seek(theEdge);
+    if (aList == nullptr || theRank >= static_cast<int>(aList->size()))
+    {
+      return false;
+    }
+    theOrientation = (*aList)[static_cast<size_t>(theRank)];
+    return true;
+  }
+
+private:
+  static constexpr int THE_MANY_EDGES = 64;
+  using Edges =
+    NCollection_DataMap<TopoDS_Shape, std::vector<TopAbs_Orientation>, TopTools_ShapeMapHasher>;
+  NCollection_DataMap<TopoDS_Shape, std::shared_ptr<Edges>, TopTools_ShapeMapHasher> myFaces;
+};
+} // namespace
