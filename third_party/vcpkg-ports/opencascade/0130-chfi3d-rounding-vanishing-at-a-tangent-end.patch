+//=======================================================================
+// function : ChFi3d_BSplineEndingAt
+// purpose  : The non-periodic B-spline that the curve is or trims when the
+//           curve ends at the parameter P, with the index of the pole at
+//           that end; null otherwise.
+//=======================================================================
+
+template <class TheBSpline, class TheTrimmed, class TheCurve>
+static occ::handle<TheBSpline> ChFi3d_BSplineEndingAt(const occ::handle<TheCurve>& C,
+                                                      const double                 P,
+                                                      int&                         thePole)
+{
+  if (C.IsNull())
+  {
+    return nullptr;
+  }
+  occ::handle<TheCurve>         aBasis = C;
+  const occ::handle<TheTrimmed> aTrim  = occ::down_cast<TheTrimmed>(C);
+  if (!aTrim.IsNull())
+  {
+    aBasis = aTrim->BasisCurve();
+  }
+  const occ::handle<TheBSpline> aBS = occ::down_cast<TheBSpline>(aBasis);
+  if (aBS.IsNull() || aBS->IsPeriodic())
+  {
+    return nullptr;
+  }
+  const double aTol = Precision::PConfusion();
+  if (std::abs(P - aBS->FirstParameter()) < aTol && std::abs(P - C->FirstParameter()) < aTol)
+  {
+    thePole = 1;
+  }
+  else if (std::abs(P - aBS->LastParameter()) < aTol && std::abs(P - C->LastParameter()) < aTol)
+  {
+    thePole = aBS->NbPoles();
+  }
+  else
+  {
+    return nullptr;
+  }
+  return aBS;
+}
+
+//=======================================================================
+// function : ChFi3d_ShrinkVanishingEnd
+// purpose  : A blend between two faces that come tangent at the vertex
+//           where it ends vanishes there: its contacts meet at the vertex.
+//           The walk stops a little short of it, where the sections get
+//           singular, or the faces meet at the vertex at an angle of a few
+//           thousandths of a radian only (a face that misses tangency by
+//           micrometres), so that a section of micrometres is left, which
+//           no cap of the corner builds. Where both contacts end within
+//           theMaxDist of the vertex and the faces' normals there are less
+//           than 0.002 rad from parallel, the end is put at the vertex: the
+//           ends of the contact curves (in 3d and on the faces) are moved
+//           to it, the blend's surface keeps its own end within the
+//           curves' tolerance, and the blend ends in a point there
+//           (PerformSingularCorner).
+//=======================================================================
+
+static bool ChFi3d_ShrinkVanishingEnd(TopOpeBRepDS_DataStructure&         DStr,
+                                      const occ::handle<ChFiDS_SurfData>& Fd,
+                                      const bool                          isfirst,
+                                      const TopoDS_Vertex&                Vtx,
+                                      const double                        theMaxDist)
+{
+  ChFiDS_CommonPoint& CV1 = Fd->ChangeVertex(isfirst, 1);
+  ChFiDS_CommonPoint& CV2 = Fd->ChangeVertex(isfirst, 2);
+  const gp_Pnt        PV  = BRep_Tool::Pnt(Vtx);
+  if (CV1.Point().IsEqual(CV2.Point(), 0) || CV1.Point().Distance(PV) > theMaxDist
+      || CV2.Point().Distance(PV) > theMaxDist)
+  {
+    return false;
+  }
+  gp_Vec aNorm[2];
+  for (int k = 0; k < 2; k++)
+  {
+    const TopoDS_Shape& aShape = DStr.Shape(Fd->Index(k + 1));
+    if (aShape.IsNull() || aShape.ShapeType() != TopAbs_FACE)
+    {
+      return false;
+    }
+    const TopoDS_Face& aFace = TopoDS::Face(aShape);
+    bool               aHolds = false;
+    for (TopExp_Explorer ex(aFace, TopAbs_VERTEX); ex.More() && !aHolds; ex.Next())
+    {
+      aHolds = ex.Current().IsSame(Vtx);
+    }
+    if (!aHolds)
+    {
+      return false;
+    }
+    const gp_Pnt2d      aUV = BRep_Tool::Parameters(Vtx, aFace);
+    BRepAdaptor_Surface aSurf(aFace, false);
+    gp_Pnt              aP;
+    gp_Vec              aDU, aDV;
+    aSurf.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+    aNorm[k] = aDU.Crossed(aDV);
+    if (aNorm[k].Magnitude() < gp::Resolution())
+    {
+      return false;
+    }
+  }
+  const double anAng = aNorm[0].Angle(aNorm[1]);
+  if (anAng > 0.002 && M_PI - anAng > 0.002)
+  {
+    return false;
+  }
+  const double aTol = std::max(CV1.Point().Distance(PV), CV2.Point().Distance(PV));
+  // (The contact curves of a walked blend are B-splines.)
+  occ::handle<Geom_BSplineCurve>   aC3d[2];
+  int                              aPole3d[2] = {0, 0}, aPole2d[2] = {0, 0};
+  occ::handle<Geom2d_BSplineCurve> aC2d[2];
+  for (int k = 0; k < 2; k++)
+  {
+    const ChFiDS_FaceInterference& aFi = Fd->Interference(k + 1);
+    if (aFi.LineIndex() == 0)
+    {
+      return false;
+    }
+    aC3d[k] = ChFi3d_BSplineEndingAt<Geom_BSplineCurve, Geom_TrimmedCurve>(
+      DStr.Curve(aFi.LineIndex()).Curve(), aFi.Parameter(isfirst), aPole3d[k]);
+    aC2d[k] = ChFi3d_BSplineEndingAt<Geom2d_BSplineCurve, Geom2d_TrimmedCurve>(aFi.PCurveOnFace(),
+                                                                             aFi.Parameter(isfirst),
+                                                                             aPole2d[k]);
+    if (aC3d[k].IsNull() || aC2d[k].IsNull())
+    {
+      return false;
+    }
+  }
+  for (int k = 0; k < 2; k++)
+  {
+    ChFiDS_FaceInterference& aFi   = Fd->ChangeInterference(k + 1);
+    const TopoDS_Face&       aFace = TopoDS::Face(DStr.Shape(Fd->Index(k + 1)));
+    aC3d[k]->SetPole(aPole3d[k], PV);
+    aC2d[k]->SetPole(aPole2d[k], BRep_Tool::Parameters(Vtx, aFace));
+    TopOpeBRepDS_Curve& aCurve = DStr.ChangeCurve(aFi.LineIndex());
+    aCurve.Tolerance(std::max(aCurve.Tolerance(), 1.01 * aTol));
+  }
+  for (ChFiDS_CommonPoint* aCV : {&CV1, &CV2})
+  {
+    if (aCV->IsOnArc())
+    {
+      // On the arc it lies on: at the vertex where the arc holds it.
+      bool aHolds = false;
+      for (TopExp_Explorer ex(aCV->Arc(), TopAbs_VERTEX); ex.More() && !aHolds; ex.Next())
+      {
+        aHolds = ex.Current().IsSame(Vtx);
+      }
+      if (aHolds)
+      {
+        aCV->SetArc(aTol, aCV->Arc(), BRep_Tool::Parameter(Vtx, aCV->Arc()), aCV->TransitionOnArc());
+      }
+    }
+    aCV->SetPoint(PV);
+    aCV->SetVertex(Vtx);
+    aCV->SetTolerance(aTol);
+  }
+  return true;
+}
