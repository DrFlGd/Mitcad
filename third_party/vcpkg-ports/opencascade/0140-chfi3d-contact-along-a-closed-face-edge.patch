+//=======================================================================
+// function : LineOnBoundary
+// purpose  : Whether a bounded tangency line lies on the boundary of its
+//            face at several of its points.
+//=======================================================================
+
+static bool LineOnBoundary(const occ::handle<Geom2d_Curve>&        C,
+                           const occ::handle<Adaptor3d_TopolTool>& I)
+{
+  const double f = C->FirstParameter(), l = C->LastParameter();
+  if (Precision::IsInfinite(f) || Precision::IsInfinite(l))
+  {
+    return false;
+  }
+  int aNbOn = 0;
+  for (int k = 1; k < 16; k++)
+  {
+    if (I->Classify(C->Value(f + (l - f) * k / 16.), Precision::Confusion(), false) == TopAbs_ON)
+    {
+      aNbOn++;
+    }
+  }
+  return aNbOn >= 2;
+}
