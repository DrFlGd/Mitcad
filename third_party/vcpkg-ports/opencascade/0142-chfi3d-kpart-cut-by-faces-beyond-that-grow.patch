+  if (aType.GetType() != GeomAbs_Line && aType.GetType() != GeomAbs_Circle)
+  {
+    return false;
+  }
+  // The blend's width: between its contacts at the gap's ends.
+  double t1 = 0., t2 = 0., u1 = 0., u2 = 0.;
+  const int opp = 3 - ons;
+  if (!ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(W1), t1)
+      || !ChFi3d_KPartLineParam(DStr, Full, ons, Spine->Value(W1), u1)
+      || !ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(W2), t2)
+      || !ChFi3d_KPartLineParam(DStr, Full, ons, Spine->Value(W2), u2))
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& CO = DStr.Curve(Full->Interference(opp).LineIndex()).Curve();
+  const occ::handle<Geom_Curve>& CN = DStr.Curve(Full->Interference(ons).LineIndex()).Curve();
+  const double aWidth =
+    std::max(CO->Value(t1).Distance(CN->Value(u1)), CO->Value(t2).Distance(CN->Value(u2)));
+  const TopoDS_Vertex Vn = atA ? Va : Vb;
+  const double        pv = BRep_Tool::Parameter(Vn, E);
+  double              aLen = aWidth;
+  if (aType.GetType() == GeomAbs_Circle)
+  {
+    aLen = std::min(aWidth / aType.Circle().Radius(), 0.5 * M_PI);
+  }
+  const double a = atA ? pv - aLen : pv, b = atA ? pv : pv + aLen;
+  if (!ChFi3d_KPartEdgeCrossingOn(DStr, Spine, Full, ons, E, new GeomAdaptor_Curve(aBasis, a, b), W1, W2, X)
+      || std::abs(X.wE - pv) <= Precision::PConfusion())
+  {
+    return false;
+  }
+  X.Beyond = true;
+  X.Vn     = Vn;
+  return true;
+}
