 static bool ChFi3d_KPartEdgeCrossing(const TopOpeBRepDS_DataStructure&   DStr,
                                      const occ::handle<ChFiDS_Spine>&    Spine,
                                      const occ::handle<ChFiDS_SurfData>& Full,
