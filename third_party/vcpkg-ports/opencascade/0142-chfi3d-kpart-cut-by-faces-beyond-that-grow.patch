+    return false;
+  }
+  occ::handle<Geom_Curve> aBasis = aCE;
+  if (const occ::handle<Geom_TrimmedCurve> aTrim = occ::down_cast<Geom_TrimmedCurve>(aCE))
+  {
+    aBasis = aTrim->BasisCurve();
+  }
