+  {
+    return true;
+  }
+  TopoDS_Vertex Va, Vb;
+  TopExp::Vertices(E, Va, Vb);
+  if (Va.IsNull() || Vb.IsNull() || Va.IsSame(Vb))
+  {
+    return false;
+  }
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aNVertices;
+  TopExp::MapShapes(N, TopAbs_VERTEX, aNVertices);
+  const bool atA = aNVertices.Contains(Va), atB = aNVertices.Contains(Vb);
+  if (atA == atB)
+  {
+    return false;
+  }
+  double                        f = 0., l = 0.;
