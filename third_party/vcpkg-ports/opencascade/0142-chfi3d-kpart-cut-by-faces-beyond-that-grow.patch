+//=======================================================================
+// function : ChFi3d_ProlongEdgeBeyondVertex
+// purpose  : Edge E prolonged along its curve from its vertex Vn to the
+//            vertex Vx (parameter Wx on E's curve): a curve between them
+//            bounding both faces F1, F2 of E, in E's orientation in each.
+//=======================================================================
+
+static void ChFi3d_ProlongEdgeBeyondVertex(TopOpeBRepDS_DataStructure& DStr,
+                                           const TopoDS_Edge&          E,
+                                           const TopoDS_Vertex&        Vn,
+                                           const TopoDS_Vertex&        Vx,
+                                           const double                Wx,
+                                           const TopoDS_Face&          F1,
+                                           const TopoDS_Face&          F2,
+                                           const double                Tol)
+{
+  double                  f = 0., l = 0.;
+  occ::handle<Geom_Curve> aBasis = BRep_Tool::Curve(E, f, l);
+  if (aBasis.IsNull())
+  {
+    return;
+  }
+  if (const occ::handle<Geom_TrimmedCurve> aTrim = occ::down_cast<Geom_TrimmedCurve>(aBasis))
+  {
+    aBasis = aTrim->BasisCurve();
+  }
+  const double pv    = BRep_Tool::Parameter(Vn, E);
+  const double p1    = std::min(pv, Wx);
+  const double p2    = std::max(pv, Wx);
+  const bool   vnLow = pv < Wx;
+  const int    IVn   = DStr.AddShape(Vn);
+  const int    IVx   = DStr.AddShape(Vx);
+  const int    ic    = DStr.AddCurve(TopOpeBRepDS_Curve(new Geom_TrimmedCurve(aBasis, p1, p2), Tol));
+  DStr.ChangeCurveInterferences(ic).Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, vnLow ? IVn : IVx, p1, true));
+  DStr.ChangeCurveInterferences(ic).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, vnLow ? IVx : IVn, p2, true));
+  for (const TopoDS_Face& F : {F1, F2})
+  {
+    TopAbs_Orientation anOri = TopAbs_FORWARD;
+    for (TopExp_Explorer ex(F.Oriented(TopAbs_FORWARD), TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(E))
+      {
+        anOri = ex.Current().Orientation();
+      }
+    }
+    double                          u1 = 0., u2 = 0.;
+    const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(E, F, u1, u2);
+    const int                       IF  = DStr.AddShape(F);
+    DStr.ChangeShapeInterferences(IF).Append(ChFi3d_FilCurveInDS(ic, IF, aPC, anOri));
+  }
+}
