+//=======================================================================
+// function : ChFi3d_SetCornerOnFaceBeyond
+// purpose  : Set (in the calling thread) while a chamfers' corner is
+//            computed on a face beyond their common face, which does not
+//            hold the corner's vertex (ChFi3d_ChBuilder::PerformTwoCorner).
+//=======================================================================
+static thread_local bool ChFi3d_CornerOnFaceBeyond = false;
+
+void ChFi3d_SetCornerOnFaceBeyond(const bool theOn)
+{
+  ChFi3d_CornerOnFaceBeyond = theOn;
+}
+
+//=======================================================================
+// function : ChFi3d_VertexParametersOn
+// purpose  : The parameters of vertex V on face F; for a corner computed on
+//            a face beyond the common face, where F does not hold V, those
+//            of the point of F's surface nearest to V.
+//=======================================================================
+static gp_Pnt2d ChFi3d_VertexParametersOn(const TopoDS_Vertex& V, const TopoDS_Face& F)
+{
+  if (!ChFi3d_CornerOnFaceBeyond)
+  {
+    return BRep_Tool::Parameters(V, F);
+  }
+  for (TopExp_Explorer ex(F, TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(V))
+    {
+      return BRep_Tool::Parameters(V, F);
+    }
+  }
+  GeomAPI_ProjectPointOnSurf aProj(BRep_Tool::Pnt(V), BRep_Tool::Surface(F));
+  double                     u = 0., v = 0.;
+  if (aProj.NbPoints() > 0)
+  {
+    aProj.LowerDistanceParameters(u, v);
+  }
+  return gp_Pnt2d(u, v);
+}
