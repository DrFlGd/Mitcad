+// The face across the arc of CP from face F (null where none, or where it
+// continues F tangentially).
+TopoDS_Face ChFi3d_FaceAcross(const ChFiDS_CommonPoint& CP, const TopoDS_Face& F, const ChFiDS_Map& EFMap)
+{
+  if (!CP.IsOnArc() || CP.IsVertex() || !EFMap.Contains(CP.Arc()))
+  {
+    return TopoDS_Face();
+  }
+  TopoDS_Face B;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(CP.Arc())); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(F))
+    {
+      B = TopoDS::Face(it.Value());
+    }
+  }
+  if (B.IsNull() || ChFi3d::IsTangentFaces(TopoDS::Edge(CP.Arc()), F, B))
+  {
+    return TopoDS_Face();
+  }
+  return B;
+}
+
+// The piece of the analytic blend of Fd beyond its end (isFirst) at a
+// corner: its contact on face N (side ico) has left N across an arc into
+// the face beyond B at that end, its other contact (side iarc) ends on the
+// corner's pivot edge. The piece, on Fd's surface, is cut by B from that
+// arc's point to Pc, where the corner's curve will meet B, its other side
+// reduced to the point on the pivot.
+occ::handle<ChFiDS_SurfData> ChFi3d_CornerCutPiece(TopOpeBRepDS_DataStructure&         DStr,
+                                                   const occ::handle<ChFiDS_SurfData>& Fd,
+                                                   const bool                          isFirst,
+                                                   const int                           ico,
+                                                   const TopoDS_Face&                  B,
+                                                   const gp_Pnt&                       Pc,
+                                                   const gp_Pnt&                       Pnear,
+                                                   const double                        tol3d)
+{
+  const int                      iarc = 3 - ico;
+  const ChFiDS_CommonPoint&      CPco = Fd->Vertex(isFirst, ico);
+  const ChFiDS_FaceInterference& FN   = Fd->Interference(ico);
+  const ChFiDS_FaceInterference& FA   = Fd->Interference(iarc);
+  const occ::handle<Geom_Surface>& S  = DStr.Surface(Fd->Surf()).Surface();
+  const occ::handle<Geom_Surface>  SB = BRep_Tool::Surface(B);
+  if (S.IsNull() || SB.IsNull() || FN.PCurveOnSurf().IsNull() || FA.PCurveOnSurf().IsNull() || FA.LineIndex() <= 0)
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  TopoDS_Face BF = B;
+  BF.Orientation(TopAbs_FORWARD);
+  double                          f = 0., l = 0.;
+  const occ::handle<Geom2d_Curve> pcArc = BRep_Tool::CurveOnSurface(TopoDS::Edge(CPco.Arc()), BF, f, l);
+  if (pcArc.IsNull())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  const gp_Pnt2d uvS = FN.PCurveOnSurf()->Value(FN.Parameter(isFirst));
+  const gp_Pnt2d uvB = pcArc->Value(CPco.ParameterOnArc());
+  // The cut runs from the arc's point to Pc (at the end the stripe runs
+  // to): at the stripe's start, toward its first piece, from Pc.
+  occ::handle<Geom_Curve>   Cc;
+  occ::handle<Geom2d_Curve> Ps, Pb;
+  bool                      ok = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    ok = isFirst ? ChFi3d_ArcBetween(S, SB, Pc, CPco.Point(), Pnear, uvS, uvB, true, tol3d, Cc, Ps, Pb)
+                 : ChFi3d_ArcBetween(S, SB, CPco.Point(), Pc, Pnear, uvS, uvB, false, tol3d, Cc, Ps, Pb);
+  }
+  catch (Standard_Failure const&)
+  {
+    ok = false;
+  }
+  if (!ok)
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  const TopoDS_Face        N    = TopoDS::Face(DStr.Shape(Fd->Index(ico)));
+  const TopAbs_Orientation aTraB = TopAbs::Compose(FN.Transition(), TopAbs::Compose(N.Orientation(), B.Orientation()));
+
+  occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+  G->ChangeSurf(Fd->Surf());
+  G->ChangeOrientation() = Fd->Orientation();
+  G->ChangeIndexOfS1(Fd->IndexOfS1());
+  G->ChangeIndexOfS2(Fd->IndexOfS2());
+  if (ico == 1)
+  {
+    G->ChangeIndexOfS1(DStr.AddShape(B));
+  }
+  else
+  {
+    G->ChangeIndexOfS2(DStr.AddShape(B));
+  }
+  {
+    ChFiDS_FaceInterference& GI = G->ChangeInterference(ico);
+    GI.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tol3d)), aTraB, Pb, Ps);
+    GI.SetFirstParameter(Cc->FirstParameter());
+    GI.SetLastParameter(Cc->LastParameter());
+  }
+  {
+    // The other side: the point on the pivot.
+    const TopOpeBRepDS_Curve& toc = DStr.Curve(FA.LineIndex());
+    ChFiDS_FaceInterference&  GA  = G->ChangeInterference(iarc);
+    GA.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(toc.Curve()->Copy()),
+                                                         toc.Tolerance())),
+                       FA.Transition(),
+                       occ::down_cast<Geom2d_Curve>(FA.PCurveOnFace()->Copy()),
+                       occ::down_cast<Geom2d_Curve>(FA.PCurveOnSurf()->Copy()));
+    GA.SetFirstParameter(FA.Parameter(isFirst));
+    GA.SetLastParameter(FA.Parameter(isFirst));
+  }
+  // At its end toward Fd, Fd's points; at the corner, the point on the
+  // pivot and Pc.
+  G->ChangeVertex(!isFirst, ico)  = CPco;
+  G->ChangeVertex(!isFirst, iarc) = Fd->Vertex(isFirst, iarc);
+  G->ChangeVertex(isFirst, iarc)  = Fd->Vertex(isFirst, iarc);
+  ChFiDS_CommonPoint& CPc         = G->ChangeVertex(isFirst, ico);
+  CPc.Reset();
+  CPc.SetPoint(Pc);
+  const double w  = isFirst ? Fd->FirstSpineParam() : Fd->LastSpineParam();
+  const double dw = std::max(CPco.Point().Distance(Pc), Precision::Confusion());
+  G->FirstSpineParam(isFirst ? w - dw : w);
+  G->LastSpineParam(isFirst ? w : w + dw);
+  return G;
+}
