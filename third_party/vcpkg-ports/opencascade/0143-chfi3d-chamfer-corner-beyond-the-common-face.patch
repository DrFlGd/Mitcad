+// The arc of the intersection of the surfaces S and SB from P1 to P2 (of
+// the arcs between them, the one whose middle lies nearest to Pnear), its
+// p-curves on S and SB in the periods of uvS and uvB at P1 (at P2 with
+// atP2).
+bool ChFi3d_ArcBetween(const occ::handle<Geom_Surface>& S,
+                       const occ::handle<Geom_Surface>& SB,
+                       const gp_Pnt&                    P1,
+                       const gp_Pnt&                    P2,
+                       const gp_Pnt&                    Pnear,
+                       const gp_Pnt2d&                  uvS,
+                       const gp_Pnt2d&                  uvB,
+                       const bool                       atP2,
+                       const double                     Tol,
+                       occ::handle<Geom_Curve>&         Cc,
+                       occ::handle<Geom2d_Curve>&       Ps,
+                       occ::handle<Geom2d_Curve>&       Pb)
+{
+  GeomInt_IntSS anInter;
+  anInter.Perform(S, SB, 2.e-7, true, false, false);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  const double aTolP = std::max(100. * Tol, 1.e-4);
+  double       aBest = RealLast();
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    occ::handle<Geom_Curve> C = anInter.Line(i);
+    if (const occ::handle<Geom_TrimmedCurve> aTrim = occ::down_cast<Geom_TrimmedCurve>(C))
+    {
+      if (aTrim->BasisCurve()->IsPeriodic())
+      {
+        C = aTrim->BasisCurve();
+      }
+    }
+    GeomAPI_ProjectPointOnCurve aPr1(P1, C), aPr2(P2, C);
+    if (aPr1.NbPoints() == 0 || aPr2.NbPoints() == 0 || aPr1.LowerDistance() > aTolP
+        || aPr2.LowerDistance() > aTolP)
+    {
+      continue;
+    }
+    const double t1 = aPr1.LowerDistanceParameter(), t2 = aPr2.LowerDistanceParameter();
+    if (std::abs(t2 - t1) <= Precision::PConfusion())
+    {
+      continue;
+    }
+    NCollection_Sequence<std::pair<double, double>> aRanges;
+    aRanges.Append(std::make_pair(t1, t2));
+    if (C->IsPeriodic())
+    {
+      aRanges.Append(std::make_pair(t1, t2 > t1 ? t2 - C->Period() : t2 + C->Period()));
+    }
+    for (int r = 1; r <= aRanges.Length(); r++)
+    {
+      const double a = aRanges.Value(r).first, b = aRanges.Value(r).second;
+      const double d = C->Value(0.5 * (a + b)).Distance(Pnear);
+      if (d >= aBest)
+      {
+        continue;
+      }
+      occ::handle<Geom_Curve> anArc = new Geom_TrimmedCurve(C, std::min(a, b), std::max(a, b));
+      if (b < a)
+      {
+        anArc->Reverse();
+      }
+      const double              f = anArc->FirstParameter(), l = anArc->LastParameter();
+      occ::handle<Geom2d_Curve> aPs = GeomProjLib::Curve2d(anArc, f, l, S);
+      occ::handle<Geom2d_Curve> aPb = GeomProjLib::Curve2d(anArc, f, l, SB);
+      if (aPs.IsNull() || aPb.IsNull())
+      {
+        continue;
+      }
+      const auto toPeriod = [&](occ::handle<Geom2d_Curve>& aP, const occ::handle<Geom_Surface>& aS, const gp_Pnt2d& uv0) {
+        const gp_Pnt2d p0 = aP->Value(atP2 ? l : f);
+        double         du = 0., dv = 0.;
+        if (aS->IsUPeriodic())
+        {
+          du = aS->UPeriod() * std::round((uv0.X() - p0.X()) / aS->UPeriod());
+        }
+        if (aS->IsVPeriodic())
+        {
+          dv = aS->VPeriod() * std::round((uv0.Y() - p0.Y()) / aS->VPeriod());
+        }
+        if (du != 0. || dv != 0.)
+        {
+          aP->Translate(gp_Vec2d(du, dv));
+        }
+      };
+      toPeriod(aPs, S, uvS);
+      toPeriod(aPb, SB, uvB);
+      aBest = d;
+      Cc    = anArc;
+      Ps    = aPs;
+      Pb    = aPb;
+    }
+  }
+  return !Cc.IsNull();
+}
