+//=======================================================================
+// function : PerformTwoCorner
+// purpose  : By intersection of the two chamfers (PerformTwoCornerbyInter).
+//            Where their contacts on the common face leave it across arcs
+//            into one face beyond before they cross (they cross beyond the
+//            common face), the chamfers run on over that face's edge and
+//            the face beyond cuts them: each stripe gets a piece cut by it,
+//            from where its contact leaves the common face to the point
+//            where the chamfers' intersection meets the face beyond, and
+//            the corner is computed between those pieces, on the face
+//            beyond.
+//=======================================================================
 
 void ChFi3d_ChBuilder::PerformTwoCorner(const int Index)
 {
   PerformTwoCornerbyInter(Index);
+  if (done)
+  {
+    return;
+  }
+  TopOpeBRepDS_DataStructure&                            DStr = myDS->ChangeDS();
+  const TopoDS_Vertex&                                   Vtx  = myVDataMap.FindKey(Index);
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator It(myVDataMap(Index));
+  const occ::handle<ChFiDS_Stripe>                       St1 = It.Value();
+  It.Next();
+  if (!It.More())
+  {
+    return;
+  }
+  const occ::handle<ChFiDS_Stripe> St2 = It.Value();
+  if (St1 == St2)
+  {
+    return;
+  }
+  int       Sens1 = 0, Sens2 = 0;
+  const int i1 = ChFi3d_IndexOfSurfData(Vtx, St1, Sens1);
+  const int i2 = ChFi3d_IndexOfSurfData(Vtx, St2, Sens2);
+  const bool isFirst1 = Sens1 == 1, isFirst2 = Sens2 == 1;
+  const occ::handle<ChFiDS_SurfData> Fd1 = St1->SetOfSurfData()->Value(i1);
+  const occ::handle<ChFiDS_SurfData> Fd2 = St2->SetOfSurfData()->Value(i2);
+  // The common face and its sides.
+  int ico1 = 0, ico2 = 0;
+  for (int a = 1; a <= 2 && ico1 == 0; a++)
+  {
+    for (int b = 1; b <= 2 && ico1 == 0; b++)
+    {
+      if (Fd1->Index(a) > 0 && Fd1->Index(a) == Fd2->Index(b))
+      {
+        ico1 = a;
+        ico2 = b;
+      }
+    }
+  }
+  if (ico1 == 0)
+  {
+    return;
+  }
+  const TopoDS_Face          FaCo = TopoDS::Face(DStr.Shape(Fd1->Index(ico1)));
+  const ChFiDS_CommonPoint&  CPa1 = Fd1->Vertex(isFirst1, 3 - ico1);
+  const ChFiDS_CommonPoint&  CPa2 = Fd2->Vertex(isFirst2, 3 - ico2);
+  const TopoDS_Face          B1   = ChFi3d_FaceAcross(Fd1->Vertex(isFirst1, ico1), FaCo, myEFMap);
+  const TopoDS_Face          B2   = ChFi3d_FaceAcross(Fd2->Vertex(isFirst2, ico2), FaCo, myEFMap);
+  if (B1.IsNull() || !B1.IsSame(B2) || !CPa1.IsOnArc() || !CPa2.IsOnArc() || !CPa1.Arc().IsSame(CPa2.Arc())
+      || CPa1.Point().Distance(CPa2.Point()) > 10. * tolapp3d)
+  {
+    return;
+  }
+  // Where the chamfers' intersection meets the face beyond: of the points
+  // nearest to the pivot's point, beyond the common face.
+  const occ::handle<Geom_Surface>& S1 = DStr.Surface(Fd1->Surf()).Surface();
+  const occ::handle<Geom_Surface>& S2 = DStr.Surface(Fd2->Surf()).Surface();
+  const occ::handle<Geom_Surface>  SB = BRep_Tool::Surface(B1);
+  gp_Pnt                           Pc;
+  bool                             found = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    GeomInt_IntSS anInter;
+    anInter.Perform(S1, S2, 2.e-7, true, false, false);
+    double aBest = RealLast();
+    for (int i = 1; anInter.IsDone() && i <= anInter.NbLines(); i++)
+    {
+      IntCurveSurface_HInter aCS;
+      aCS.Perform(new GeomAdaptor_Curve(anInter.Line(i)), new GeomAdaptor_Surface(SB));
+      for (int k = 1; aCS.IsDone() && k <= aCS.NbPoints(); k++)
+      {
+        const gp_Pnt P = aCS.Point(k).Pnt();
+        const double d = P.Distance(CPa1.Point());
+        if (d < aBest)
+        {
+          aBest = d;
+          Pc    = P;
+          found = true;
+        }
+      }
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    found = false;
+  }
+  if (!found)
+  {
+    return;
+  }
+  const gp_Pnt Pnear = BRep_Tool::Pnt(Vtx);
+  const occ::handle<ChFiDS_SurfData> G1 = ChFi3d_CornerCutPiece(DStr, Fd1, isFirst1, ico1, B1, Pc, Pnear, tolapp3d);
+  const occ::handle<ChFiDS_SurfData> G2 =
+    G1.IsNull() ? G1 : ChFi3d_CornerCutPiece(DStr, Fd2, isFirst2, ico2, B1, Pc, Pnear, tolapp3d);
+  if (G1.IsNull() || G2.IsNull())
+  {
+    return;
+  }
+  // Where the corner's point lies on the prolongation of a seam of the face
+  // beyond (the seam's end on the common face's arc between the two
+  // contacts' points), the cuts reach it from both sides of the seam: their
+  // p-curves on that face end in different periods. The second one is
+  // taken in the first one's period for the corner, and the seam is
+  // prolonged to the corner's point.
+  TopoDS_Edge   aSeam;
+  TopoDS_Vertex aSeamVertex;
+  double        aSeamShiftU = 0., aSeamShiftV = 0.;
+  {
+    TopoDS_Face BF = B1;
+    BF.Orientation(TopAbs_FORWARD);
+    for (TopExp_Explorer ex(BF, TopAbs_EDGE); ex.More() && aSeam.IsNull(); ex.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+      if (!BRep_Tool::IsClosed(E, BF) || BRep_Tool::Degenerated(E))
+      {
+        continue;
+      }
+      double                  f = 0., l = 0.;
+      occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+      if (C.IsNull())
+      {
+        continue;
+      }
+      if (const occ::handle<Geom_TrimmedCurve> aTrim = occ::down_cast<Geom_TrimmedCurve>(C))
+      {
+        C = aTrim->BasisCurve();
+      }
+      GeomAPI_ProjectPointOnCurve aPr(Pc, C);
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tolapp3d)
+      {
+        continue;
+      }
+      for (TopExp_Explorer exv(E, TopAbs_VERTEX); exv.More(); exv.Next())
+      {
+        for (TopExp_Explorer exf(FaCo, TopAbs_VERTEX); exf.More(); exf.Next())
+        {
+          if (exf.Current().IsSame(exv.Current()))
+          {
+            aSeam       = E;
+            aSeamVertex = TopoDS::Vertex(exv.Current());
+          }
+        }
+      }
+    }
+  }
+  if (!aSeam.IsNull())
+  {
+    const ChFiDS_FaceInterference& F1 = G1->Interference(ico1);
+    const ChFiDS_FaceInterference& F2 = G2->Interference(ico2);
+    const gp_Pnt2d                 a  = F1.PCurveOnFace()->Value(F1.Parameter(isFirst1));
+    const gp_Pnt2d                 b  = F2.PCurveOnFace()->Value(F2.Parameter(isFirst2));
+    aSeamShiftU                        = a.X() - b.X();
+    aSeamShiftV                        = a.Y() - b.Y();
+    G2->ChangeInterference(ico2).ChangePCurveOnFace()->Translate(gp_Vec2d(aSeamShiftU, aSeamShiftV));
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq1 = St1->ChangeSetOfSurfData()->ChangeSequence();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq2 = St2->ChangeSetOfSurfData()->ChangeSequence();
+  if (isFirst1)
+  {
+    Seq1.Prepend(G1);
+  }
+  else
+  {
+    Seq1.Append(G1);
+  }
+  if (isFirst2)
+  {
+    Seq2.Prepend(G2);
+  }
+  else
+  {
+    Seq2.Append(G2);
+  }
+  {
+    // (The corner's vertex is not on the face beyond: its parameters there
+    // are those of the nearest point; reset whatever happens.)
+    struct OnFaceBeyond
+    {
+      OnFaceBeyond() { ChFi3d_SetCornerOnFaceBeyond(true); }
+      ~OnFaceBeyond() { ChFi3d_SetCornerOnFaceBeyond(false); }
+    } anOnFaceBeyond;
+    PerformTwoCornerbyInter(Index);
+  }
+  if (!aSeam.IsNull())
+  {
+    G2->ChangeInterference(ico2).ChangePCurveOnFace()->Translate(gp_Vec2d(-aSeamShiftU, -aSeamShiftV));
+  }
+  if (done && !aSeam.IsNull())
+  {
+    // The seam prolonged from its vertex to the corner's point, bounding the
+    // face beyond on both sides of the seam.
+    double                  f = 0., l = 0.;
+    occ::handle<Geom_Curve> C = BRep_Tool::Curve(aSeam, f, l);
+    if (const occ::handle<Geom_TrimmedCurve> aTrim = occ::down_cast<Geom_TrimmedCurve>(C))
+    {
+      C = aTrim->BasisCurve();
+    }
+    GeomAPI_ProjectPointOnCurve aPr(Pc, C);
+    const double                wc    = aPr.LowerDistanceParameter();
+    const double                wv    = BRep_Tool::Parameter(aSeamVertex, aSeam);
+    const bool                  vLow  = wv < wc;
+    const int                   IV    = DStr.AddShape(aSeamVertex);
+    const int                   IP    = St1->IndexPoint(isFirst1, ico1);
+    const int                   ic    = DStr.AddCurve(TopOpeBRepDS_Curve(
+      new Geom_TrimmedCurve(C, std::min(wv, wc), std::max(wv, wc)), tolapp3d));
+    DStr.ChangeCurveInterferences(ic).Append(
+      vLow ? ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, IV, wv, true) : ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, IP, wc, false));
+    DStr.ChangeCurveInterferences(ic).Append(
+      vLow ? ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, IP, wc, false) : ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, IV, wv, true));
+    TopoDS_Face BF = B1;
+    BF.Orientation(TopAbs_FORWARD);
+    const int IB = DStr.AddShape(B1);
+    for (TopExp_Explorer ex(BF, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (!ex.Current().IsSame(aSeam))
+      {
+        continue;
+      }
+      const TopoDS_Edge&              E  = TopoDS::Edge(ex.Current());
+      double                          u1 = 0., u2 = 0.;
+      const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(E, BF, u1, u2);
+      DStr.ChangeShapeInterferences(IB).Append(ChFi3d_FilCurveInDS(ic, IB, pc, E.Orientation()));
+    }
+  }
+  if (!done)
+  {
+    if (isFirst1)
+    {
+      Seq1.Remove(1);
+    }
+    else
+    {
+      Seq1.Remove(Seq1.Length());
+    }
+    if (isFirst2)
+    {
+      Seq2.Remove(1);
+    }
+    else
+    {
+      Seq2.Remove(Seq2.Length());
+    }
+  }
 }
