+//=======================================================================
+// function : ChFi3d_PCurvesOnSurfAfter
+// purpose  : Moves the p-curves on the blend surface S of SD (a piece put
+//            on the surface of Prev, the piece before it) by whole periods
+//            of S so that they go on from Prev's: SD's start comes to
+//            Prev's end.
+//=======================================================================
+
+static void ChFi3d_PCurvesOnSurfAfter(const occ::handle<ChFiDS_SurfData>& SD,
+                                      const occ::handle<ChFiDS_SurfData>& Prev,
+                                      const occ::handle<Geom_Surface>&    S)
+{
+  if (S.IsNull() || (!S->IsUPeriodic() && !S->IsVPeriodic()))
+  {
+    return;
+  }
+  for (int s = 1; s <= 2; s++)
+  {
+    ChFiDS_FaceInterference&       FI = SD->ChangeInterference(s);
+    const ChFiDS_FaceInterference& FP = Prev->Interference(s);
+    if (FI.PCurveOnSurf().IsNull() || FP.PCurveOnSurf().IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt2d a = FP.PCurveOnSurf()->Value(FP.LastParameter());
+    const gp_Pnt2d b = FI.PCurveOnSurf()->Value(FI.FirstParameter());
+    double         du = 0., dv = 0.;
+    if (S->IsUPeriodic())
+    {
+      du = std::round((a.X() - b.X()) / S->UPeriod()) * S->UPeriod();
+    }
+    if (S->IsVPeriodic())
+    {
+      dv = std::round((a.Y() - b.Y()) / S->VPeriod()) * S->VPeriod();
+    }
+    if (du != 0. || dv != 0.)
+    {
+      occ::handle<Geom2d_Curve> aMoved = occ::down_cast<Geom2d_Curve>(FI.PCurveOnSurf()->Copy());
+      aMoved->Translate(gp_Vec2d(du, dv));
+      FI.ChangePCurveOnSurf() = aMoved;
+    }
+  }
+}
