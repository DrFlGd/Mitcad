+//=======================================================================
+// function : ChFi3d_CutSeamAlongCurve
+// purpose  : Where the curve C on [U1, U2], from the corner's vertex V to
+//            the point Ip of the stripe's end, runs along a seam of F that
+//            has V as a vertex (the face at the end meets F along the seam:
+//            a lug in a bore ending at the bore's seam), the seam is cut at
+//            the curve's end with its part along the curve kept on neither
+//            side: the curve bounds F there on one side, the blend covers
+//            the other.
+//=======================================================================
+
+static void ChFi3d_CutSeamAlongCurve(TopOpeBRepDS_DataStructure&    DStr,
+                                     const TopoDS_Face&             F,
+                                     const TopoDS_Vertex&           V,
+                                     const occ::handle<Geom_Curve>& C,
+                                     const double                   U1,
+                                     const double                   U2,
+                                     const int                      Ip,
+                                     const double                   Tol)
+{
+  if (C.IsNull() || U2 - U1 <= Precision::PConfusion())
+  {
+    return;
+  }
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E) || !BRep_Tool::IsClosed(E, FF))
+    {
+      continue;
+    }
+    TopoDS_Vertex V1, V2;
+    TopExp::Vertices(E, V1, V2);
+    if (!V.IsSame(V1) && !V.IsSame(V2))
+    {
+      continue;
+    }
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CE = BRep_Tool::Curve(E, f, l);
+    if (CE.IsNull())
+    {
+      continue;
+    }
+    bool along = true;
+    for (int i = 1; i <= 4 && along; i++)
+    {
+      GeomAPI_ProjectPointOnCurve aPr(C->Value(U1 + (U2 - U1) * i / 4.), CE, f, l);
+      along = aPr.NbPoints() > 0 && aPr.LowerDistance() <= Tol;
+    }
+    if (!along)
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnCurve aPr(C->Value(U2), CE, f, l);
+    const double                w = aPr.LowerDistanceParameter();
+    if (w <= f + Precision::PConfusion() || w >= l - Precision::PConfusion())
+    {
+      return;
+    }
+    // (Along the edge the part from V to the cut goes: a transition into
+    // the kept part, as from V's side the edge comes to the cut.)
+    const bool               fromFirst = V.IsSame(V1) && !(V.IsSame(V2) && BRep_Tool::Parameter(V2, E) < w);
+    const TopAbs_Orientation anOr      = fromFirst ? TopAbs_FORWARD : TopAbs_REVERSED;
+    TopoDS_Edge              EF        = E;
+    EF.Orientation(TopAbs_FORWARD);
+    const int IE = DStr.AddShape(EF);
+    DStr.ChangeShapeInterferences(IE).Append(ChFi3d_FilPointInDS(anOr, IE, Ip, w));
+    return;
+  }
+}
