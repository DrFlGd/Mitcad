Fillets and chamfers: a contact's end snapped onto the vertex of a closed
edge of a periodic face (mitcad#263).

The case: a boss under a plate exactly as long as the chamfer on its free
end's edge (equal distances, or distance and angle), so that the chamfer
consumes the boss's wall and its contact runs along the closed edge where
the boss meets the plate. ChFi3d_Builder_SpKP's SnapToVertex projects the
edge's vertex onto the contact's p-curve on the face; on the boss's
periodic wall the vertex's parameters may lie a period away from this end
and project onto the other end, leaving the piece of no length ("StartSol
echec" in the walk that followed). When the projection lands on the other
end, the vertex's parameters moved by a period are tried, and the nearest
projection at no greater distance toward this end is taken.

Before, the chamfer failed.

diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_SpKP.cxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_SpKP.cxx
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_SpKP.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_SpKP.cxx
@@ -840,7 +849,40 @@ static void SnapToVertex(TopOpeBRepDS_DataStructure&   DStr,
     {
       return;
     }
-    const double             aPar = aProj.LowerDistanceParameter();
+    double aPar = aProj.LowerDistanceParameter();
+    {
+      // An end on a closed edge of a periodic face (a boss's wall consumed
+      // by the blend as far as its other end): the vertex's parameters on
+      // the face may lie a period away and project onto the line's other
+      // end, which would leave the piece of no length. The vertex is then
+      // taken a period on, toward this end.
+      const double aOther = CD->Interference(ons).Parameter(!isFirst);
+      const double aCur   = CD->Interference(ons).Parameter(isFirst);
+      const occ::handle<Geom_Surface> aSF = BRep_Tool::Surface(F);
+      if (std::abs(aPar - aOther) <= Precision::PConfusion() && std::abs(aCur - aOther) > Precision::PConfusion()
+          && (aSF->IsUPeriodic() || aSF->IsVPeriodic()))
+      {
+        const gp_Pnt2d aUV = BRep_Tool::Parameters(V, F);
+        for (int k = 0; k < 4; k++)
+        {
+          const bool   inU = k < 2;
+          const double aT  = inU ? (aSF->IsUPeriodic() ? aSF->UPeriod() : 0.)
+                                 : (aSF->IsVPeriodic() ? aSF->VPeriod() : 0.);
+          if (aT == 0.)
+          {
+            continue;
+          }
+          const double   aSign = (k % 2 == 0) ? 1. : -1.;
+          const gp_Pnt2d aP(aUV.X() + (inU ? aSign * aT : 0.), aUV.Y() + (inU ? 0. : aSign * aT));
+          Geom2dAPI_ProjectPointOnCurve aPr(aP, CD->Interference(ons).PCurveOnFace());
+          if (aPr.NbPoints() > 0 && aPr.LowerDistance() <= aProj.LowerDistance() + Precision::PConfusion()
+              && std::abs(aPr.LowerDistanceParameter() - aCur) < std::abs(aPar - aCur))
+          {
+            aPar = aPr.LowerDistanceParameter();
+          }
+        }
+      }
+    }
     const TopAbs_Orientation aTra = Pons.TransitionOnArc();
     Pons.SetVertex(V);
     Pons.SetArc(pitol, E, BRep_Tool::Parameter(V, E), aTra);
