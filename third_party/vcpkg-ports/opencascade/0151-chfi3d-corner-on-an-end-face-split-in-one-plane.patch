+  if (ZSide != 0)
+  {
+    // The face at the end is split in two faces of one plane: the part of
+    // the arc of side ZSide between its point and Vtx (cut off it as under
+    // the blend) becomes the edge between them, on Fz as on that arc and
+    // on Fv the other way.
+    const ChFiDS_CommonPoint&     CVz = ZSide == 1 ? CV1 : CV2;
+    const TopoDS_Edge&            Ez  = CVz.Arc();
+    double                        ef = 0., el = 0.;
+    const occ::handle<Geom_Curve> Cz = BRep_Tool::Curve(Ez, ef, el);
+    if (Cz.IsNull())
+    {
+      throw Standard_ConstructionError("OneCorner : edge without a curve");
+    }
+    const double wv = BRep_Tool::Parameter(Vtx, Ez), wc = CVz.ParameterOnArc();
+    if (std::abs(wv - wc) <= Precision::PConfusion())
+    {
+      throw Standard_Failure("OneCorner : the point is at the vertex");
+    }
+    const double                  w1 = std::min(wv, wc), w2 = std::max(wv, wc);
+    TopAbs_Orientation            Oz = TopAbs_FORWARD;
+    for (ex.Init(Fz.Oriented(TopAbs_FORWARD), TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(Ez))
+      {
+        Oz = ex.Current().Orientation();
+        break;
+      }
+    }
+    TopoDS_Face FzF = Fz, FvF = Fv;
+    FzF.Orientation(TopAbs_FORWARD);
+    FvF.Orientation(TopAbs_FORWARD);
+    double                          pf = 0., pl = 0.;
+    const occ::handle<Geom2d_Curve> PCz = BRep_Tool::CurveOnSurface(Ez, FzF, pf, pl);
+    const occ::handle<Geom2d_Curve> PCv = BRep_Tool::CurveOnSurface(Ez, FvF, pf, pl);
+    if (PCz.IsNull() || PCv.IsNull())
+    {
+      throw Standard_ConstructionError("Failed to get p-curve of edge");
+    }
+    const int IZ =
+      DStr.AddCurve(TopOpeBRepDS_Curve(new Geom_TrimmedCurve(Cz, w1, w2),
+                                       std::max(BRep_Tool::Tolerance(Ez), tolapp3d)));
+    const int IFz = DStr.AddShape(Fz);
+    DStr.ChangeShapeInterferences(IFz).Append(
+      ChFi3d_FilCurveInDS(IZ, IFz, new Geom2d_TrimmedCurve(PCz, w1, w2), Oz));
+    DStr.ChangeShapeInterferences(IShape).Append(
+      ChFi3d_FilCurveInDS(IZ, IShape, new Geom2d_TrimmedCurve(PCv, w1, w2), TopAbs::Reverse(Oz)));
+    const int IVz = DStr.AddShape(Vtx);
+    const int IPz = stripe->IndexPoint(isfirst, ZSide);
+    if (wv < wc)
+    {
+      DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilVertexInDS(TopAbs_FORWARD, IZ, IVz, w1));
+      DStr.ChangeCurveInterferences(IZ).Append(
+        ChFi3d_FilPointInDS(TopAbs_REVERSED, IZ, IPz, w2, CVz.IsVertex()));
+    }
+    else
+    {
+      DStr.ChangeCurveInterferences(IZ).Append(
+        ChFi3d_FilPointInDS(TopAbs_FORWARD, IZ, IPz, w1, CVz.IsVertex()));
+      DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilVertexInDS(TopAbs_REVERSED, IZ, IVz, w2));
+    }
+  }
