+//=======================================================================
+// function : ChFi3d_CoplanarSplitEndFace
+// purpose  : OnDiff end of a SurfData whose two points lie on arcs with no
+//            face in common: the face at the end is split in two faces of
+//            one plane, one holding each arc (e.g. a pad's foot face beside
+//            the main face, the blend rolling on the pad's edge). Where
+//            exactly one arc holds the corner's vertex Vtx (side ZSide),
+//            both faces are planes of one plane, hold Vtx and face the same
+//            way, the cap goes on the face of the other arc (Fv), and the
+//            part of the arc of ZSide between its point and Vtx becomes the
+//            edge between the two faces (on Fz, that arc's face).
+//=======================================================================
+
+static bool ChFi3d_CoplanarSplitEndFace(const TopOpeBRepDS_DataStructure&   DStr,
+                                        const occ::handle<ChFiDS_SurfData>& Fd,
+                                        ChFiDS_CommonPoint&                 CV1,
+                                        ChFiDS_CommonPoint&                 CV2,
+                                        const TopoDS_Vertex&                Vtx,
+                                        const ChFiDS_Map&                   VEMap,
+                                        const ChFiDS_Map&                   EFMap,
+                                        TopoDS_Face&                        Fv,
+                                        TopoDS_Face&                        Fz,
+                                        int&                                ZSide)
+{
+  ZSide = 0;
+  if (!CV1.IsOnArc() || !CV2.IsOnArc() || !EFMap.Contains(CV1.Arc()) || !EFMap.Contains(CV2.Arc()))
+  {
+    return false;
+  }
+  auto hasShape = [](const TopoDS_Shape& S, const TopoDS_Shape& Sub, const TopAbs_ShapeEnum T) {
+    for (TopExp_Explorer ex(S, T); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(Sub))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  const bool on1 = hasShape(CV1.Arc(), Vtx, TopAbs_VERTEX);
+  const bool on2 = hasShape(CV2.Arc(), Vtx, TopAbs_VERTEX);
+  if (on1 == on2)
+  {
+    return false;
+  }
+  const int                 s   = on1 ? 1 : 2;
+  const ChFiDS_CommonPoint& CVs = s == 1 ? CV1 : CV2;
+  ChFiDS_CommonPoint&       CVo = s == 1 ? CV2 : CV1;
+  const TopoDS_Shape&       F1  = DStr.Shape(Fd->Index(1));
+  const TopoDS_Shape&       F2  = DStr.Shape(Fd->Index(2));
+  // The face of an arc beside the blend's own faces, holding Vtx, planar.
+  auto endFace = [&](const TopoDS_Edge& E, TopoDS_Face& F, gp_Pln& P) {
+    for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(E)); It.More(); It.Next())
+    {
+      const TopoDS_Face& G = TopoDS::Face(It.Value());
+      if (G.IsSame(F1) || G.IsSame(F2) || !hasShape(G, Vtx, TopAbs_VERTEX))
+      {
+        continue;
+      }
+      BRepAdaptor_Surface aS(G, false);
+      if (aS.GetType() != GeomAbs_Plane)
+      {
+        continue;
+      }
+      if (!F.IsNull())
+      {
+        return false; // not unique
+      }
+      F = G;
+      P = aS.Plane();
+      if (G.Orientation() == TopAbs_REVERSED)
+      {
+        P.SetAxis(P.Axis().Reversed());
+      }
+    }
+    return !F.IsNull();
+  };
+  TopoDS_Face Fs;
+  gp_Pln      Ps;
+  if (!endFace(CVs.Arc(), Fs, Ps))
+  {
+    return false;
+  }
+  const double aTolS = BRep_Tool::Tolerance(Fs) + Precision::Confusion();
+  // The other face: of the other arc, or, the other point being a vertex,
+  // of another edge at that vertex bounding the face that point's side of
+  // the blend touches (the point is then given that edge).
+  auto coplanar = [&](const TopoDS_Edge& E, TopoDS_Face& F) {
+    gp_Pln P;
+    if (!endFace(E, F, P) || F.IsSame(Fs))
+    {
+      F.Nullify();
+      return false;
+    }
+    const double aTol = std::max(aTolS, BRep_Tool::Tolerance(F) + Precision::Confusion());
+    if (Ps.Axis().Direction().Dot(P.Axis().Direction()) < 1. - 1.e-9 || P.Distance(Ps.Location()) > aTol
+        || P.Distance(BRep_Tool::Pnt(Vtx)) > aTol)
+    {
+      F.Nullify();
+      return false;
+    }
+    return true;
+  };
+  TopoDS_Face Fo;
+  if (!coplanar(CVo.Arc(), Fo))
+  {
+    if (!CVo.IsVertex() || !VEMap.Contains(CVo.Vertex()))
+    {
+      return false;
+    }
+    const TopoDS_Face& Fn = TopoDS::Face(DStr.Shape(Fd->Index(3 - s)));
+    const TopoDS_Edge  Eold = CVo.Arc();
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(CVo.Vertex())); itE.More(); itE.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+      if (E.IsSame(Eold) || BRep_Tool::Degenerated(E) || !EFMap.Contains(E)
+          || !hasShape(Fn, E, TopAbs_EDGE) || !coplanar(E, Fo))
+      {
+        continue;
+      }
+      // The transition through the arcs is the same: only the arc's
+      // orientation on the face changes.
+      TopAbs_Orientation Tr = CVo.TransitionOnArc();
+      if (ChFi3d_OrientationInFace(Eold, Fn) != ChFi3d_OrientationInFace(E, Fn))
+      {
+        Tr = TopAbs::Reverse(Tr);
+      }
+      CVo.SetArc(CVo.Tolerance(), E, BRep_Tool::Parameter(CVo.Vertex(), E), Tr);
+      break;
+    }
+    if (Fo.IsNull())
+    {
+      return false;
+    }
+  }
+  Fv    = Fo;
+  Fz    = Fs;
+  ZSide = s;
+  return true;
+}
