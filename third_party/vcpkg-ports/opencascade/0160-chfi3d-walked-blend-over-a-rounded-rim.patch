+// Whether a rolling ball of radius R that touches face F at P (the common
+// point of the blend's section on F, the other contact at Po) cannot touch
+// face Fv at its point uv (its face beyond F across a tangent edge): Fv bends
+// towards the ball more sharply than the ball in some direction there (e.g.
+// a concave rounding of a smaller radius than the ball, or, with the ball
+// inside the solid, a convex one), so that no ball touching Fv there lies on
+// the side of it the ball rolls on.
+static bool ballCannotTouch(const TopoDS_Face& F,
+                            const gp_Pnt&      P,
+                            const gp_Pnt&      Po,
+                            const TopoDS_Face& Fv,
+                            const gp_Pnt2d&    uv,
+                            const double       R)
+{
+  if (R <= Precision::Confusion())
+  {
+    return false;
+  }
+  // The ball's centre: at R from P along F's normal, on the side where the
+  // other contact lies at R from it.
+  gp_Pnt2d uvF;
+  {
+    occ::handle<Geom_Surface>  SF = BRep_Tool::Surface(F);
+    GeomAPI_ProjectPointOnSurf aPr(P, SF);
+    if (SF.IsNull() || aPr.NbPoints() == 0)
+    {
+      return false;
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    uvF.SetCoord(u, v);
+  }
+  BRepAdaptor_Surface AF(F, false);
+  BRepLProp_SLProps   aPropF(AF, uvF.X(), uvF.Y(), 1, Precision::Confusion());
+  if (!aPropF.IsNormalDefined())
+  {
+    return false;
+  }
+  const gp_Vec nF(aPropF.Normal());
+  const gp_Pnt C1 = P.Translated(R * nF), C2 = P.Translated(-R * nF);
+  const gp_Pnt C  = std::abs(C1.Distance(Po) - R) <= std::abs(C2.Distance(Po) - R) ? C1 : C2;
+  BRepAdaptor_Surface AV(Fv, false);
+  BRepLProp_SLProps   aProp(AV, uv.X(), uv.Y(), 2, Precision::Confusion());
+  if (!aProp.IsNormalDefined() || !aProp.IsCurvatureDefined())
+  {
+    return false;
+  }
+  const gp_Vec d(aProp.Value(), C);
+  if (d.Magnitude() <= Precision::Confusion())
+  {
+    return false;
+  }
+  // (Normal curvatures are positive where the surface bends towards its
+  // normal.)
+  const double s       = gp_Vec(aProp.Normal()).Dot(d) >= 0. ? 1. : -1.;
+  const double towards = std::max(s * aProp.MaxCurvature(), s * aProp.MinCurvature());
+  return towards > (1. + 1.e-3) / R;
+}
