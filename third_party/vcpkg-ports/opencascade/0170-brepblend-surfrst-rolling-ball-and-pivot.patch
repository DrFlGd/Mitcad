+//=======================================================================
+// function : ChFi3d_RefSide
+// purpose  : For a blend rolling on an edge: the side of the edge's
+//            p-curve on its face (the face the ball leaves the edge for),
+//            1 on the left of the curve's direction, -1 on the right, 0
+//            when no point beside the middle of the edge tells.
+//=======================================================================
+
+static int ChFi3d_RefSide(const occ::handle<BRepAdaptor_Surface>& HSref,
+                          const occ::handle<BRepAdaptor_Curve2d>& PCref)
+{
+  if (HSref.IsNull() || PCref.IsNull() || HSref->Face().IsNull())
+  {
+    return 0;
+  }
+  const TopoDS_Face& F = HSref->Face();
+  const double       w = 0.5 * (PCref->FirstParameter() + PCref->LastParameter());
+  gp_Pnt2d           p;
+  gp_Vec2d           t;
+  PCref->D1(w, p, t);
+  const double nt = t.Magnitude();
+  if (nt < gp::Resolution())
+  {
+    return 0;
+  }
+  t /= nt;
+  const gp_Vec2d left(-t.Y(), t.X());
+  const double   res = std::min(HSref->UResolution(1.), HSref->VResolution(1.));
+  for (const double d3d : {1.e-2, 1.e-3, 1.e-4})
+  {
+    const double             step = d3d * res;
+    BRepClass_FaceClassifier onLeft(F, p.Translated(step * left), 0.1 * step);
+    BRepClass_FaceClassifier onRight(F, p.Translated(-step * left), 0.1 * step);
+    const bool               inLeft  = onLeft.State() == TopAbs_IN;
+    const bool               inRight = onRight.State() == TopAbs_IN;
+    if (inLeft != inRight)
+    {
+      return inLeft ? 1 : -1;
+    }
+  }
+  return 0;
+}
