+static bool ChFi3d_CoaxialRestriction(const occ::handle<BRepAdaptor_Surface>& S,
+                                      const occ::handle<BRepAdaptor_Curve2d>& PC,
+                                      gp_Ax1&                                 Axis)
+{
+  if (S.IsNull() || PC.IsNull() || PC->Edge().IsNull())
+  {
+    return false;
+  }
+  const BRepAdaptor_Curve C(PC->Edge());
+  if (C.GetType() != GeomAbs_Circle)
+  {
+    return false;
+  }
+  const gp_Ax1 ca  = C.Circle().Axis();
+  const double tol = 1.e-6 * std::max(1., C.Circle().Radius());
+  gp_Ax1       sa;
+  Axis = ca;
+  switch (S->GetType())
+  {
+    case GeomAbs_Sphere:
+      return gp_Lin(ca).Distance(S->Sphere().Location()) <= tol;
+    case GeomAbs_Cylinder:
+      sa = S->Cylinder().Axis();
+      break;
+    case GeomAbs_Cone:
+      sa = S->Cone().Axis();
+      break;
+    case GeomAbs_Torus:
+      sa = S->Torus().Axis();
+      break;
+    case GeomAbs_SurfaceOfRevolution:
+      sa = S->AxeOfRevolution();
+      break;
+    default:
+      return false;
+  }
+  return sa.IsParallel(ca, 1.e-9) && gp_Lin(sa).Distance(ca.Location()) <= tol;
