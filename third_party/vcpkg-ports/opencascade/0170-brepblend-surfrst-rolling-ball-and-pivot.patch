 #define Eps 1.e-15
 
+// The rolling ball (the default, SetRollingBall): the blend is the envelope of a ball of the
+// radius that touches the surface and rolls on the restriction (an edge). Its centre lies at
+// the radius along the surface's unit normal at the contact point, the restriction's point is
+// at the radius from it and the restriction is tangent to the ball there. Its section is the
+// arc of the ball in the plane through the centre that holds both contact directions (the
+// normal plane of the curve the centre runs along). The guide only says which ball: the
+// mid-point of the contact points lies in the guide's normal plane, as for the blend between
+// two surfaces (BlendFunc_ConstRad), so that the two meet at the same section where the ball
+// leaves the restriction for the surface beyond it.
+// Otherwise both contact points lie in the guide's normal plane (OCCT's sections), which is
+// the rolling ball only where the normals are square to the guide.
+namespace
+{
+//! Derivative n_a of the unit normal n = N/|N| from the derivative N_a of N (invnorm = 1/|N|).
+gp_Vec UnitNormalD1(const gp_Vec& n, const gp_Vec& Na, const double invnorm)
+{
+  gp_Vec res;
+  res.SetLinearForm(-n.Dot(Na), n, Na);
+  return res * invnorm;
+}
+
+//! Normal of the ball's section plane through the directions ns1 and ns2 from the centre to
+//! the contact points, on the side of np (the guide's plane normal, as oriented for the arc),
+//! with its first derivative from those of ns1 and ns2 when WithD1. Where ns1 and ns2 are
+//! parallel, the guide's plane turned to hold ns1.
+void BallPlane(const gp_Vec& ns1,
+               const gp_Vec& ns2,
+               const gp_Vec& dns1,
+               const gp_Vec& dns2,
+               const gp_Vec& np,
+               const bool    WithD1,
+               gp_Vec&       bp,
+               gp_Vec&       dbp)
+{
+  gp_Vec       w    = ns1.Crossed(ns2);
+  const double norm = w.Magnitude();
+  dbp.SetCoord(0., 0., 0.);
+  if (norm < 1.e-12)
+  {
+    bp.SetLinearForm(-np.Dot(ns1), ns1, np);
+    const double nbp = bp.Magnitude();
+    bp               = nbp > Eps ? bp / nbp : np;
+    return;
+  }
+  const double sign = np.Dot(w) < 0. ? -1. : 1.;
+  w *= sign;
+  bp = w / norm;
+  if (!WithD1)
+  {
+    return;
+  }
+  const gp_Vec dw = (dns1.Crossed(ns2) + ns1.Crossed(dns2)) * sign;
+  dbp.SetLinearForm(-bp.Dot(dw), bp, dw);
+  dbp /= norm;
+}
+
+void BallPlane(const gp_Vec& ns1, const gp_Vec& ns2, const gp_Vec& np, gp_Vec& bp)
+{
+  gp_Vec zero(0., 0., 0.), dbp;
+  BallPlane(ns1, ns2, zero, zero, np, false, bp, dbp);
+}
+
+//! Unit normal n of the surface at (U, V) and the ball's centre pts - Ray n.
+void BallCentre(const occ::handle<Adaptor3d_Surface>& S,
+                const double                          U,
+                const double                          V,
+                const double                          Ray,
+                gp_Pnt&                               P,
+                gp_Vec&                               n,
+                gp_Pnt&                               Centre)
+{
+  gp_Vec d1u, d1v;
+  S->D1(U, V, P, d1u, d1v);
+  n                 = d1u.Crossed(d1v);
+  const double norm = n.Magnitude();
+  if (norm > Eps)
+  {
+    n /= norm;
+  }
+  Centre.SetXYZ(P.XYZ() - Ray * n.XYZ());
+}
