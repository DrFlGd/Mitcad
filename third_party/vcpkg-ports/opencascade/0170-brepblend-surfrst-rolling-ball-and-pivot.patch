+bool BRepBlend_SurfPointConstRadInv::RollingValues(const math_Vector& X,
+                                                   math_Vector&       F,
+                                                   math_Matrix*       D) const
+{
+  // F(1): the mid-point of the point and the surface's contact in the guide's normal plane;
+  // F(2): (centre - point).T / |T| = 0; F(3): |centre - point|^2 - ray^2, the centre being
+  // pts - ray n (n the surface's unit normal).
+  gp_Pnt ptcur, pts;
+  gp_Vec d1cur, d2cur, d1u, d1v, d2u, d2v, duv;
+  curv->D2(X(1), ptcur, d1cur, d2cur);
+  if (D != nullptr)
+  {
+    surf->D2(X(2), X(3), pts, d1u, d1v, d2u, d2v, duv);
+  }
+  else
+  {
+    surf->D1(X(2), X(3), pts, d1u, d1v);
+  }
+  const double normd1cur = d1cur.Magnitude();
+  const gp_Vec nplan     = d1cur / normd1cur;
+  const double theD      = -nplan.XYZ().Dot(ptcur.XYZ());
+
+  const gp_XYZ mid   = 0.5 * (point.XYZ() + pts.XYZ());
+  gp_Vec       N     = d1u.Crossed(d1v);
+  const double normN = N.Magnitude();
+  const double invN  = normN > 1.e-15 ? 1. / normN : 1.;
+  const gp_Vec n     = N * invN;
+  const gp_Vec dist  = gp_Vec(pts.XYZ() - point.XYZ()) - ray * n;
+  const double normT = tangent.Magnitude();
+
+  F(1) = nplan.XYZ().Dot(mid) + theD;
+  F(2) = dist.Dot(tangent) / normT;
+  F(3) = dist.SquareMagnitude() - ray * ray;
+
+  // A point on a circle on the axis of a surface of revolution: in the plane through the axis
+  // and the surface's contact.
+  const gp_Vec ax(axis.Direction());
+  const gp_Vec m       = ax.Crossed(gp_Vec(axis.Location(), pts));
+  const double normm   = m.Magnitude();
+  const bool   inaxial = hasaxis && normm > Precision::Confusion();
+  const gp_Vec apoint(axis.Location(), point);
+  if (inaxial)
+  {
+    F(2) = apoint.Dot(m) / normm;
+  }
+
+  if (D != nullptr)
+  {
+    gp_Vec dnplan;
+    dnplan.SetLinearForm(-nplan.Dot(d2cur), nplan, d2cur);
+    dnplan /= normd1cur;
+    const double dtheD = -nplan.XYZ().Dot(d1cur.XYZ()) - dnplan.XYZ().Dot(ptcur.XYZ());
+
+    const gp_Vec Nu = d2u.Crossed(d1v).Added(d1u.Crossed(duv));
+    const gp_Vec Nv = d1u.Crossed(d2v).Added(duv.Crossed(d1v));
+    gp_Vec       nu, nv, cu, cv;
+    nu.SetLinearForm(-n.Dot(Nu), n, Nu);
+    nv.SetLinearForm(-n.Dot(Nv), n, Nv);
+    cu.SetLinearForm(-ray * invN, nu, d1u);
+    cv.SetLinearForm(-ray * invN, nv, d1v);
+
+    (*D)(1, 1) = dnplan.XYZ().Dot(mid) + dtheD;
+    (*D)(1, 2) = 0.5 * nplan.Dot(d1u);
+    (*D)(1, 3) = 0.5 * nplan.Dot(d1v);
+    (*D)(2, 1) = 0.;
+    (*D)(2, 2) = cu.Dot(tangent) / normT;
+    (*D)(2, 3) = cv.Dot(tangent) / normT;
+    if (inaxial)
+    {
+      const gp_Vec mu = ax.Crossed(d1u), mv = ax.Crossed(d1v);
+      (*D)(2, 2)      = apoint.Dot(mu) / normm - F(2) * m.Dot(mu) / (normm * normm);
+      (*D)(2, 3)      = apoint.Dot(mv) / normm - F(2) * m.Dot(mv) / (normm * normm);
+    }
+    (*D)(3, 1) = 0.;
+    (*D)(3, 2) = 2. * dist.Dot(cu);
+    (*D)(3, 3) = 2. * dist.Dot(cv);
+  }
+  return true;
+}
