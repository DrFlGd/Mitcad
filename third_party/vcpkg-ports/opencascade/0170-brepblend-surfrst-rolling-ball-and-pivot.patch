+//=================================================================================================
+
+void BRepBlend_SurfRstConstRad::RollingSection(const Blend_Point&            P,
+                                               NCollection_Array1<gp_Pnt>&   Poles,
+                                               NCollection_Array1<gp_Pnt2d>& Poles2d,
+                                               NCollection_Array1<double>&   Weights)
+{
+  gp_Vec ns, ns2, n, bp;
+  gp_Pnt Center;
+  double u1, v1;
+
+  const double prm = P.Parameter();
+  const int    low = Poles.Lower();
+  const int    upp = Poles.Upper();
+
+  tguide->D1(prm, ptgui, d1gui);
+  nplan = d1gui.Normalized();
+
+  P.ParametersOnS(u1, v1);
+  const double   w    = P.ParameterOnC();
+  const gp_Pnt2d pt2d = rst->Value(w);
+
+  BallCentre(surf, u1, v1, ray, pts, n, Center);
+  ptrst   = cons.Value(w);
+  distmin = std::min(distmin, pts.Distance(ptrst));
+
+  Poles2d(Poles2d.Lower()).SetCoord(u1, v1);
+  Poles2d(Poles2d.Upper()).SetCoord(pt2d.X(), pt2d.Y());
+
+  // Linear Case
+  if (mySShape == BlendFunc_Linear)
+  {
+    Poles(low)   = pts;
+    Poles(upp)   = ptrst;
+    Weights(low) = 1.0;
+    Weights(upp) = 1.0;
+    return;
+  }
+
+  // ns, ns2: from the centre to pts and ptrst
+  ns        = gp_Vec(Center, pts).Normalized();
+  ns2       = gp_Vec(Center, ptrst).Normalized();
+  gp_Vec np = nplan;
+  if (choix % 2 != 0)
+  {
+    np.Reverse();
+  }
+  BallPlane(ns, ns2, np, bp);
+  GeomFill::GetCircle(myTConv, ns, ns2, bp, pts, ptrst, std::abs(ray), Center, Poles, Weights);
+}
+
+//=================================================================================================
+
+bool BRepBlend_SurfRstConstRad::RollingSection(const Blend_Point&            P,
+                                               NCollection_Array1<gp_Pnt>&   Poles,
+                                               NCollection_Array1<gp_Vec>&   DPoles,
+                                               NCollection_Array1<gp_Pnt2d>& Poles2d,
+                                               NCollection_Array1<gp_Vec2d>& DPoles2d,
+                                               NCollection_Array1<double>&   Weights,
+                                               NCollection_Array1<double>&   DWeights)
+{
+  gp_Vec d1u1, d1v1, d2u1, d2v1, d2uv1, d1;
+  gp_Vec ns, ns2, dnplan, dns, dns2, n, dn;
+  gp_Vec temp, tgct;
+  gp_Vec d1urst, d1vrst;
+  gp_Pnt Center, bid;
+
+  math_Vector sol(1, 3), valsol(1, 3), secmember(1, 3);
+  math_Matrix gradsol(1, 3, 1, 3);
+
+  const double prm = P.Parameter();
+  const int    low = Poles.Lower();
+  const int    upp = Poles.Upper();
+  bool         istgt;
+
+  Set(prm);
+  dnplan.SetLinearForm(1. / normtg, d2gui, -1. / normtg * (nplan.Dot(d2gui)), nplan);
+
+  P.ParametersOnS(sol(1), sol(2));
+  sol(3) = prmrst = P.ParameterOnC();
+  pt2drst         = rst->Value(prmrst);
+
+  RollingValues(sol, valsol, &gradsol);
+
+  surf->D2(sol(1), sol(2), pts, d1u1, d1v1, d2u1, d2v1, d2uv1);
+  cons.D1(sol(3), ptrst, d1);
+
+  // Only the guide's plane depends on the guide's parameter.
+  temp.SetXYZ(0.5 * (pts.XYZ() + ptrst.XYZ()) - ptgui.XYZ());
+  secmember(1) = normtg - dnplan.Dot(temp);
+  secmember(2) = 0.;
+  secmember(3) = 0.;
+
+  n                  = d1u1.Crossed(d1v1);
+  const double normN = n.Magnitude();
+  const double invN  = normN > Eps ? 1. / normN : 1.; // Not enough, but no need to stop
+  n *= invN;
+  Center.SetXYZ(pts.XYZ() - ray * n.XYZ());
+  // ns, ns2: from the centre to pts and ptrst
+  const double sgn = ray > 0. ? 1. : -1.;
+  ns               = sgn * n;
+  ns2              = gp_Vec(Center, ptrst);
+  const double R2  = ns2.Magnitude();
+  if (R2 > Eps)
+  {
+    ns2 /= R2;
+  }
+
+  math_Gauss Resol(gradsol, 1.e-9);
+  if (Resol.IsDone())
+  {
+    istgt = false;
+    Resol.Solve(secmember);
+  }
+  else
+  {
+    math_SVD SingRS(gradsol);
+    if (SingRS.IsDone())
+    {
+      math_Vector DEDT(1, 3);
+      DEDT = secmember;
+      SingRS.Solve(DEDT, secmember, 1.e-6);
+      istgt = false;
+    }
+    else
+    {
+      istgt = true;
+    }
+  }
+
+  if (!istgt)
+  {
+    tgs.SetLinearForm(secmember(1), d1u1, secmember(2), d1v1);
+    tgrst = secmember(3) * d1;
+
+    // The unit normal, the centre and the directions to the contact points derived by the
+    // guide's parameter.
+    const gp_Vec Nu = d2u1.Crossed(d1v1).Added(d1u1.Crossed(d2uv1));
+    const gp_Vec Nv = d2uv1.Crossed(d1v1).Added(d1u1.Crossed(d2v1));
+    dn.SetLinearForm(secmember(1), UnitNormalD1(n, Nu, invN), secmember(2), UnitNormalD1(n, Nv, invN));
+    tgct.SetLinearForm(-ray, dn, tgs);
+    dns  = sgn * dn;
+    temp = tgrst - tgct;
+    dns2.SetLinearForm(-ns2.Dot(temp), ns2, temp);
+    if (R2 > Eps)
+    {
+      dns2 /= R2;
+    }
+  }
+
+  // Tops 2D
+  Poles2d(Poles2d.Lower()).SetCoord(sol(1), sol(2));
+  Poles2d(Poles2d.Upper()).SetCoord(pt2drst.X(), pt2drst.Y());
+  if (!istgt)
+  {
+    DPoles2d(Poles2d.Lower()).SetCoord(secmember(1), secmember(2));
+    surfrst->D1(pt2drst.X(), pt2drst.Y(), bid, d1urst, d1vrst);
+    double a, b;
+    t3dto2d(a, b, tgrst, d1urst, d1vrst);
+    DPoles2d(Poles2d.Upper()).SetCoord(a, b);
+  }
+
+  // Linear Case
+  if (mySShape == BlendFunc_Linear)
+  {
+    Poles(low)   = pts;
+    Poles(upp)   = ptrst;
+    Weights(low) = 1.0;
+    Weights(upp) = 1.0;
+    if (!istgt)
+    {
+      DPoles(low)   = tgs;
+      DPoles(upp)   = tgrst;
+      DWeights(low) = 0.0;
+      DWeights(upp) = 0.0;
+    }
+    return (!istgt);
+  }
+
+  // Case of the circle, in the ball's plane (turned as the guide's plane for the arc)
+  gp_Vec np = nplan, bp, dbp;
+  if (choix % 2 != 0)
+  {
+    np.Reverse();
+  }
+  if (!istgt)
+  {
+    BallPlane(ns, ns2, dns, dns2, np, true, bp, dbp);
+    return GeomFill::GetCircle(myTConv,
+                               ns,
+                               ns2,
+                               dns,
+                               dns2,
+                               bp,
+                               dbp,
+                               pts,
+                               ptrst,
+                               tgs,
+                               tgrst,
+                               std::abs(ray),
+                               0,
+                               Center,
+                               tgct,
+                               Poles,
+                               DPoles,
+                               Weights,
+                               DWeights);
+  }
+  BallPlane(ns, ns2, np, bp);
+  GeomFill::GetCircle(myTConv, ns, ns2, bp, pts, ptrst, std::abs(ray), Center, Poles, Weights);
+  return false;
+}
