+//=================================================================================================
+
+bool BRepBlend_SurfRstConstRad::RollingDecroch(const math_Vector& Sol, gp_Vec& NS, gp_Vec& TgS) const
+{
+  gp_Vec TgRst, NRst, n, d1u, d1v;
+  gp_Pnt bid, Center, ptsol;
+
+  surf->D1(Sol(1), Sol(2), bid, d1u, d1v);
+  NS = d1u.Crossed(d1v);
+  BallCentre(surf, Sol(1), Sol(2), ray, ptsol, n, Center);
+
+  // The section's tangents at its ends: the ball's plane (holding both contact directions)
+  // turned as the guide's plane is for the arc.
+  gp_Pnt2d p2dref;
+  gp_Vec2d t2dref;
+  rstref->D1(Sol(3), p2dref, t2dref);
+  surfref->D1(p2dref.X(), p2dref.Y(), bid, d1u, d1v);
+  const gp_Vec np = choix % 2 == 1 ? -nplan : nplan;
+  gp_Vec       centpts(Center, ptsol), centptrst(Center, bid), bp;
+  BallPlane(centpts.Magnitude() > Eps ? centpts.Normalized() : centpts,
+            centptrst.Magnitude() > Eps ? centptrst.Normalized() : centptrst,
+            np,
+            bp);
+  TgS = bp.Crossed(centpts);
+
+  NRst = d1u.Crossed(d1v);
+  if (refside != 0)
+  {
+    // The ball enters the face of the reference surface beside the restriction when its
+    // centre lies over the face: the disc it cuts from the tangent plane there then reaches
+    // into the face, as far as delta = (centre - ptrst).D (D: into the face, square to the
+    // restriction), and into the surface by about delta^2 / 2 radius. Leaving the restriction
+    // for that face is not detected before that depth passes the confusion tolerance (at the
+    // start of a blend on the restriction found as the end of the blend on that face, the ball
+    // touches the face there).
+    gp_Vec       T  = t2dref.X() * d1u + t2dref.Y() * d1v;
+    gp_Vec       D  = refside * (-t2dref.Y() * d1u + t2dref.X() * d1v);
+    const double nT = T.Magnitude();
+    const double nN = NRst.Magnitude();
+    if (nT > Eps && nN > Eps)
+    {
+      T /= nT;
+      D.SetLinearForm(-D.Dot(T), T, D);
+      const gp_Vec nref = NRst / nN;
+      D.SetLinearForm(-D.Dot(nref), nref, D);
+      const double nD = D.Magnitude();
+      if (nD > Eps)
+      {
+        const double delta    = gp_Vec(bid, Center).Dot(D) / nD;
+        const double deltamax = std::sqrt(2. * std::abs(ray) * Precision::Confusion());
+        return delta > deltamax;
+      }
+    }
+  }
+  // Otherwise as OCCT's: the arc's tangent beyond ptrst against the reference surface's normal.
+  if (centptrst.Dot(NRst) < 0.)
+  {
+    NRst.Reverse();
+  }
+  TgRst           = bp.Crossed(centptrst);
+  const double NT = NRst.Magnitude() * TgRst.Magnitude();
+  if (std::abs(NT) < 1.e-7)
+  {
+    return false; // Singularity or Incoherence.
+  }
+  return NRst.Dot(TgRst) / NT < 1.e-10;
+}
+
+//=================================================================================================
+
+void BRepBlend_SurfRstConstRad::RollingSection(const double Param,
+                                               const double U,
+                                               const double V,
+                                               const double W,
+                                               double&      Pdeb,
+                                               double&      Pfin,
+                                               gp_Circ&     C)
+{
+  gp_Vec ns, ns2, np, n, bp;
+  gp_Pnt Center;
+
+  tguide->D1(Param, ptgui, d1gui);
+  np = d1gui.Normalized();
+
+  BallCentre(surf, U, V, ray, pts, n, Center);
+  ptrst = cons.Value(W);
+  C.SetRadius(std::abs(ray));
+
+  // ns, ns2: from the centre to pts and ptrst
+  ns  = gp_Vec(Center, pts).Normalized();
+  ns2 = gp_Vec(Center, ptrst);
+  if (ns2.Magnitude() > Eps)
+  {
+    ns2.Normalize();
+  }
+  if (choix % 2 != 0)
+  {
+    np.Reverse();
+  }
+  BallPlane(ns, ns2, np, bp);
+  np = bp;
+
+  C.SetPosition(gp_Ax2(Center, np, ns));
+  Pdeb = 0;
+  Pfin = ElCLib::Parameter(C, ptrst);
+
+  // Test negative and almost null angles : Special case
+  if (Pfin > 1.5 * M_PI)
+  {
+    np.Reverse();
+    C.SetPosition(gp_Ax2(Center, np, ns));
+    Pfin = ElCLib::Parameter(C, ptrst);
+  }
+  if (Pfin < Precision::PConfusion())
+  {
+    Pfin += Precision::PConfusion();
+  }
+}
