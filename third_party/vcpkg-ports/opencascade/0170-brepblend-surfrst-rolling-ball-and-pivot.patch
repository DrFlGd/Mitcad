+double BRepBlend_SurfRstLineBuilder::PivotSide(Blend_SurfRstFunction& Func, const math_Vector& Sol) const
+{
+  gp_Pnt centre;
+  if (!Func.Centre(Sol, centre))
+  {
+    return 0.;
+  }
+  return gp_Vec(pivotPnt, centre).Dot(pivotInto);
+}
