+bool BRepBlend_SurfRstLineBuilder::StartPivot(Blend_SurfRstFunction& Func)
+{
+  math_Vector tolerance(1, 3), infbound(1, 3), supbound(1, 3);
+  Func.GetTolerance(tolerance, tolpoint3d);
+  const double first = rst->FirstParameter(), last = rst->LastParameter();
+  double       w     = 0.;
+  if (std::abs(sol(3) - first) <= tolerance(3))
+  {
+    w = first;
+  }
+  else if (std::abs(sol(3) - last) <= tolerance(3))
+  {
+    w = last;
+  }
+  else
+  {
+    return false;
+  }
+  const bool atLast = w == last && w != first;
+  gp_Pnt2d   p2d;
+  gp_Vec2d   t2d;
