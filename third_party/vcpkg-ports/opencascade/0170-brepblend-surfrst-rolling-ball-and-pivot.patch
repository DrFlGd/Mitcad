+//=================================================================================================
+
+bool BRepBlend_SurfCurvConstRadInv::RollingValues(const math_Vector& X,
+                                                  math_Vector&       F,
+                                                  math_Matrix*       D) const
+{
+  // F(1): the mid-point of the contact points in the guide's normal plane;
+  // F(2): (centre - ptcur).T / |T| = 0, T the curve's tangent; F(3): |centre - ptcur|^2 - ray^2,
+  // the centre being pts - ray n (n the surface's unit normal).
+  gp_Pnt ptgui, ptcur, pts;
+  gp_Vec d1gui, d2gui, d1cur, d2cur, d1u, d1v, d2u, d2v, duv;
+  guide->D2(X(1), ptgui, d1gui, d2gui);
+  curv->D2(X(2), ptcur, d1cur, d2cur);
+  gp_Pnt2d p2drst;
+  gp_Vec2d d1rst;
+  rst->D1(X(3), p2drst, d1rst);
+  if (D != nullptr)
+  {
+    surf->D2(p2drst.X(), p2drst.Y(), pts, d1u, d1v, d2u, d2v, duv);
+  }
+  else
+  {
+    surf->D1(p2drst.X(), p2drst.Y(), pts, d1u, d1v);
+  }
+  const double normd1gui = d1gui.Magnitude();
+  const gp_Vec nplan     = d1gui / normd1gui;
+  const double theD      = -nplan.XYZ().Dot(ptgui.XYZ());
+
+  const gp_XYZ mid   = 0.5 * (ptcur.XYZ() + pts.XYZ());
+  gp_Vec       N     = d1u.Crossed(d1v);
+  const double normN = N.Magnitude();
+  const double invN  = normN > 1.e-15 ? 1. / normN : 1.;
+  const gp_Vec n     = N * invN;
+  const gp_Vec dist  = gp_Vec(pts.XYZ() - ptcur.XYZ()) - ray * n;
+  double       normT = d1cur.Magnitude();
+  if (normT < 1.e-15)
+  {
+    normT = 1.;
+  }
+
+  F(1) = nplan.XYZ().Dot(mid) + theD;
+  // pinned: the curve's parameter held (scaled to a length)
+  F(2) = pinned ? (X(2) - pinW) * normT : dist.Dot(d1cur) / normT;
+  F(3) = dist.SquareMagnitude() - ray * ray;
+
+  // A circle on the axis of a surface of revolution: the curve's contact in the plane through
+  // the axis and the surface's contact.
+  const gp_Vec ax(axis.Direction());
+  const gp_Vec m       = ax.Crossed(gp_Vec(axis.Location(), pts));
+  const double normm   = m.Magnitude();
+  const bool   inaxial = hasaxis && !pinned && normm > Precision::Confusion();
+  const gp_Vec acur(axis.Location(), ptcur);
+  if (inaxial)
+  {
+    F(2) = acur.Dot(m) / normm;
+  }
+
+  if (D != nullptr)
+  {
+    gp_Vec dnplan;
+    dnplan.SetLinearForm(-nplan.Dot(d2gui), nplan, d2gui);
+    dnplan /= normd1gui;
+    const double dtheD = -nplan.XYZ().Dot(d1gui.XYZ()) - dnplan.XYZ().Dot(ptgui.XYZ());
+
+    // pts and the centre derived by the restriction's parameter
+    gp_Vec dpts, dN, dn, dc;
+    dpts.SetLinearForm(d1rst.X(), d1u, d1rst.Y(), d1v);
+    const gp_Vec Nu = d2u.Crossed(d1v).Added(d1u.Crossed(duv));
+    const gp_Vec Nv = d1u.Crossed(d2v).Added(duv.Crossed(d1v));
+    dN.SetLinearForm(d1rst.X(), Nu, d1rst.Y(), Nv);
+    dn.SetLinearForm(-n.Dot(dN), n, dN);
+    dc.SetLinearForm(-ray * invN, dn, dpts);
+
+    const double distT = dist.Dot(d1cur);
+    (*D)(1, 1)         = dnplan.XYZ().Dot(mid) + dtheD;
+    (*D)(1, 2)         = 0.5 * nplan.Dot(d1cur);
+    (*D)(1, 3)         = 0.5 * nplan.Dot(dpts);
+    (*D)(2, 1)         = 0.;
+    (*D)(2, 2)         = (dist.Dot(d2cur) - d1cur.SquareMagnitude()) / normT
+                 - distT * d1cur.Dot(d2cur) / (normT * normT * normT);
+    (*D)(2, 3) = dc.Dot(d1cur) / normT;
+    if (pinned)
+    {
+      (*D)(2, 2) = normT;
+      (*D)(2, 3) = 0.;
+    }
+    else if (inaxial)
+    {
+      const gp_Vec ms = ax.Crossed(dpts);
+      (*D)(2, 2)      = d1cur.Dot(m) / normm;
+      (*D)(2, 3)      = acur.Dot(ms) / normm - F(2) * m.Dot(ms) / (normm * normm);
+    }
+    (*D)(3, 1) = 0.;
+    (*D)(3, 2) = -2. * dist.Dot(d1cur);
+    (*D)(3, 3) = 2. * dist.Dot(dc);
+  }
+  return true;
+}
