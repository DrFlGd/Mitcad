+        gp_Vec            t;
+        c.D1(w, p, t);
+        if (t.Magnitude() < gp::Resolution())
+        {
+          continue;
+        }
+        t.Normalize();
+        if (std::abs(w - c.LastParameter()) < std::abs(w - c.FirstParameter()))
+        {
