+    rsnld.Perform(Func, root, infbound, supbound);
+    bool rolls = false;
+    if (rsnld.IsDone())
+    {
+      math_Vector further(1, 3);
+      rsnld.Root(further);
+      rolls = Func.IsSolution(further, tolpoint3d)
+              && (atLast ? w - further(3) : further(3) - w) > tolerance(3);
+    }
+    Func.Set(param);
+    if (!rolls)
+    {
+      gp_Vec into;
+      gp_Pnt centre;
+      if (Func.NextEdgeAtEnd(atLast, into) && Func.Centre(root, centre)
+          && gp_Vec(pivotPnt, centre).Dot(into) < -tolpoint3d)
+      {
+        // It leaves the restriction for the next edge.
+        pivotInto    = into;
+        pivotLeaves  = true;
+        pivotRelease = 0.;
+      }
+      turns = Func.Pin(w);
+    }
+  }
+  if (!turns)
+  {
+    Func.Unpin();
+    Func.Set(param);
+    return false;
