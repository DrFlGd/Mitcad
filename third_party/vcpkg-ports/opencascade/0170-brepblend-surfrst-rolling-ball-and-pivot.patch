+  intoRst = t2d.X() * d1u + t2d.Y() * d1v;
+  if (intoRst.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  intoRst.Normalize();
+  if (atLast)
+  {
+    intoRst.Reverse();
+  }
+  pivotW = w;
+  if (!Func.Pin(w))
+  {
+    return false;
+  }
+  // The ball through the point at this parameter of the guide.
+  Func.Set(param);
+  Func.GetBounds(infbound, supbound);
+  math_Vector          start(1, 3), root(1, 3);
+  math_FunctionSetRoot rsnld(Func, tolerance, 30);
+  start    = sol;
+  start(3) = w;
+  rsnld.Perform(Func, start, infbound, supbound);
+  if (!rsnld.IsDone())
+  {
+    Func.Unpin();
+    return false;
+  }
+  rsnld.Root(root);
+  if (!Func.IsSolution(root, tolpoint3d))
+  {
+    Func.Unpin();
+    return false;
+  }
+  pivotInto         = intoRst;
+  pivotLeaves       = false;
+  const double side = PivotSide(Func, root);
