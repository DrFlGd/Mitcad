+  pivotIsVtx = false;
+  domain2->Initialize(rst);
+  for (domain2->InitVertexIterator(); domain2->MoreVertex() && !pivotIsVtx; domain2->NextVertex())
+  {
+    const occ::handle<Adaptor3d_HVertex>& vtx = domain2->Vertex();
+    if (std::abs(BRepBlend_BlendTool::Parameter(vtx, rst) - w) <= BRepBlend_BlendTool::Tolerance(vtx, rst))
+    {
+      pivotVtx   = vtx;
+      pivotIsVtx = true;
+    }
+  }
+  sol   = root;
+  pivot = true;
+  return true;
+}
