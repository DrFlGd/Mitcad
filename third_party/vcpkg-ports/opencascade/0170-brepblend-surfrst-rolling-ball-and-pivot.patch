+//=================================================================================================
+
+bool BRepBlend_SurfRstConstRad::RollingValues(const math_Vector& X, math_Vector& F, math_Matrix* D)
+{
+  // F(1): the mid-point of the contact points in the guide's normal plane;
+  // F(2): the restriction tangent to the ball, (centre - ptrst).T / |T| = 0 (or, the contact
+  //       held, its parameter's distance from the held one, as a length);
+  // F(3): |centre - ptrst|^2 - ray^2, the centre being pts - ray n (n the unit normal).
+  gp_Vec d1u, d1v, d2u, d2v, d2uv, d1, d2;
+  if (D != nullptr)
+  {
+    surf->D2(X(1), X(2), pts, d1u, d1v, d2u, d2v, d2uv);
+  }
+  else
+  {
+    surf->D1(X(1), X(2), pts, d1u, d1v);
+  }
+  cons.D2(X(3), ptrst, d1, d2);
+
+  gp_Vec       N      = d1u.Crossed(d1v);
+  const double normN  = N.Magnitude();
+  const double invN   = normN > Eps ? 1. / normN : 1.; // Unsatisfactory, but no need to crash
+  const gp_Vec n      = N * invN;
+  const gp_Vec centre = gp_Vec(pts.XYZ()) - ray * n;
+  const gp_Vec dist   = centre - gp_Vec(ptrst.XYZ());
+  double       normT  = d1.Magnitude();
+  if (normT < Eps)
+  {
+    normT = 1.;
+  }
+
+  F(1) = nplan.XYZ().Dot(0.5 * (pts.XYZ() + ptrst.XYZ())) + theD;
+  F(2) = pinned ? (X(3) - pinW) * normT : dist.Dot(d1) / normT;
+  F(3) = dist.SquareMagnitude() - ray * ray;
+
+  // A circle on the axis of a surface of revolution: the restriction's contact in the plane
+  // through the axis and the surface's contact.
+  const gp_Vec ax(axis.Direction());
+  const gp_Vec m     = ax.Crossed(gp_Vec(axis.Location(), pts));
+  const double normm = m.Magnitude();
+  const bool   inaxial = hasaxis && !pinned && normm > Precision::Confusion();
+  const gp_Vec arst(axis.Location(), ptrst);
+  if (inaxial)
+  {
+    F(2) = arst.Dot(m) / normm;
+  }
+
+  if (D != nullptr)
+  {
+    const gp_Vec Nu = d2u.Crossed(d1v).Added(d1u.Crossed(d2uv));
+    const gp_Vec Nv = d2uv.Crossed(d1v).Added(d1u.Crossed(d2v));
+    gp_Vec       cu, cv;
+    cu.SetLinearForm(-ray, UnitNormalD1(n, Nu, invN), d1u);
+    cv.SetLinearForm(-ray, UnitNormalD1(n, Nv, invN), d1v);
+
+    (*D)(1, 1) = 0.5 * nplan.Dot(d1u);
+    (*D)(1, 2) = 0.5 * nplan.Dot(d1v);
+    (*D)(1, 3) = 0.5 * nplan.Dot(d1);
+
+    if (pinned)
+    {
+      (*D)(2, 1) = 0.;
+      (*D)(2, 2) = 0.;
+      (*D)(2, 3) = normT;
+    }
+    else if (inaxial)
+    {
+      const gp_Vec mu = ax.Crossed(d1u), mv = ax.Crossed(d1v);
+      (*D)(2, 1)      = arst.Dot(mu) / normm - F(2) * m.Dot(mu) / (normm * normm);
+      (*D)(2, 2)      = arst.Dot(mv) / normm - F(2) * m.Dot(mv) / (normm * normm);
+      (*D)(2, 3)      = d1.Dot(m) / normm;
+    }
+    else
+    {
+      const double distT = dist.Dot(d1);
+      (*D)(2, 1)         = cu.Dot(d1) / normT;
+      (*D)(2, 2)         = cv.Dot(d1) / normT;
+      (*D)(2, 3) =
+        (dist.Dot(d2) - d1.SquareMagnitude()) / normT - distT * d1.Dot(d2) / (normT * normT * normT);
+    }
+
+    (*D)(3, 1) = 2. * dist.Dot(cu);
+    (*D)(3, 2) = 2. * dist.Dot(cv);
+    (*D)(3, 3) = -2. * dist.Dot(d1);
+  }
+  return true;
+}
