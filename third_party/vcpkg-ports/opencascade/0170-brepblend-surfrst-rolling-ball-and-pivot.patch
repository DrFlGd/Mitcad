+//=======================================================================
+
+static void ChFi3d_NextEdges(const occ::handle<BRepAdaptor_Surface>& HSref,
+                             const occ::handle<BRepAdaptor_Curve2d>& PC,
+                             const ChFiDS_Map&                       EFMap,
+                             BRepBlend_SurfRstConstRad&              Func)
+{
+  bool   has[2] = {false, false};
+  gp_Vec into[2];
+  if (!HSref.IsNull() && !PC.IsNull() && !HSref->Face().IsNull() && !PC->Edge().IsNull())
+  {
+    const TopoDS_Edge& E    = PC->Edge();
+    const TopoDS_Face& Fref = HSref->Face();
+    TopoDS_Vertex      V1, V2;
+    TopExp::Vertices(E, V1, V2);
+    for (int k = 0; k < 2 && !V1.IsNull() && !V2.IsNull() && !V1.IsSame(V2); k++)
+    {
+      const TopoDS_Vertex& V      = k == 0 ? V1 : V2;
+      const double         wv     = BRep_Tool::Parameter(V, E);
+      const int            atLast = std::abs(wv - PC->LastParameter()) < std::abs(wv - PC->FirstParameter()) ? 1 : 0;
+      for (TopExp_Explorer ex(Fref, TopAbs_EDGE); ex.More() && !has[atLast]; ex.Next())
+      {
+        const TopoDS_Edge& En = TopoDS::Edge(ex.Current());
+        if (En.IsSame(E) || BRep_Tool::Degenerated(En))
+        {
+          continue;
+        }
+        bool atV = false;
+        for (TopExp_Explorer exv(En, TopAbs_VERTEX); exv.More() && !atV; exv.Next())
+        {
+          atV = exv.Current().IsSame(V);
+        }
+        if (!atV)
+        {
+          continue;
+        }
+        // Not an edge across which the face continues tangentially.
+        bool tangent = false;
+        if (EFMap.Contains(En))
+        {
+          for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(En)); itF.More(); itF.Next())
