 //                         otherwise this is an obstacle and HC is updated.
 //=======================================================================
 
+//=======================================================================
+// function : ChFi3d_BallCentreAtEnd
+// purpose  : The centre of the arc of the section at an end of a SurfData
+//            (the ball's centre of a rolling-ball blend there).
+//=======================================================================
+
+static bool ChFi3d_BallCentreAtEnd(const TopOpeBRepDS_DataStructure&   DStr,
+                                   const occ::handle<ChFiDS_SurfData>& SD,
+                                   const bool                          isFirst,
+                                   gp_Pnt&                             C)
+{
+  if (SD.IsNull() || SD->Surf() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface>& S = DStr.Surface(SD->Surf()).Surface();
+  if (S.IsNull())
+  {
+    return false;
+  }
+  double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+  S->Bounds(u1, u2, v1, v2);
+  const double v = SD->InterferenceOnS1().Parameter(isFirst);
+  gce_MakeCirc mk(S->Value(u1, v), S->Value(0.5 * (u1 + u2), v), S->Value(u2, v));
+  if (!mk.IsDone())
+  {
+    return false;
+  }
+  C = mk.Value().Location();
+  return true;
+}
