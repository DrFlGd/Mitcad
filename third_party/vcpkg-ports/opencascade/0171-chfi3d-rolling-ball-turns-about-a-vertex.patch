         if (FiLen > Precision::PConfusion())
         {
+          // A side reduced to a point (a ball turning about the end of the
+          // edge it rolls on): a degenerated edge of the blend's face, no edge
+          // of the face beyond.
+          TopOpeBRepDS_Curve&            cd = DStr.ChangeCurve(IcFil1);
+          const occ::handle<Geom_Curve>& gc = cd.Curve();
+          if (gc.IsNull())
+          {
+            continue;
+          }
+          const gp_Pnt p0    = gc->Value(Fi.FirstParameter());
+          const double tolcd = std::max(cd.Tolerance(), tol3d);
+          bool         onpoint = true;
+          for (int k = 1; k <= 8 && onpoint; k++)
+          {
+            const double w = Fi.FirstParameter() + (Fi.LastParameter() - Fi.FirstParameter()) * k / 8.;
+            onpoint        = gc->Value(w).Distance(p0) <= tolcd;
+          }
+          if (onpoint)
+          {
+            cd.ChangeCurve().Nullify();
+            // It spans the blend's surface as the other side does (where the
+            // ends of the blend were cut, by the faces at the ends).
+            const ChFiDS_FaceInterference& Fo = Fd->Interference(3 - onS);
+            ChFiDS_FaceInterference&       Fc = Fd->ChangeInterference(onS);
+            Fc.SetFirstParameter(Fo.FirstParameter());
+            Fc.SetLastParameter(Fo.LastParameter());
+          }
           continue;
         }
         TopOpeBRepDS_Curve& cc = DStr.ChangeCurve(IcFil1);
