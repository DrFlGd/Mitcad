+//=======================================================================
+// function : ChFi3d_ConcaveCrease
+// purpose  : Whether edge E of face F is a concave crease between F and a
+//            face it is tangent to (within OCCT's tolerance), Other.
+//=======================================================================
+
+static bool ChFi3d_ConcaveCrease(const TopoDS_Edge& E,
+                                 const TopoDS_Face& F,
+                                 const ChFiDS_Map&  EFMap,
+                                 TopoDS_Face&       Other)
+{
+  if (BRep_Tool::Degenerated(E) || !EFMap.Contains(E))
+  {
+    return false;
+  }
+  bool onF = false;
+  Other.Nullify();
+  for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More(); itF.Next())
+  {
+    if (itF.Value().IsSame(F))
+    {
+      onF = true;
+    }
+    else
+    {
+      Other = TopoDS::Face(itF.Value());
+    }
+  }
+  return onF && !Other.IsNull() && ChFi3d::IsTangentFaces(E, F, Other)
+         && ChFi3d::DefineConnectType(E, F, Other, 1.e-5, true) == ChFiDS_Concave;
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::EndsOnTurnCrease(const ChFiDS_CommonPoint& CP, const TopoDS_Face& F) const
+{
+  if (myTurnStops.IsEmpty() || !CP.IsOnArc() || CP.IsVertex())
+  {
+    return false;
+  }
+  TopoDS_Face other;
+  for (TopExp_Explorer ex(CP.Arc(), TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (myTurnStops.Contains(ex.Current()) && ChFi3d_ConcaveCrease(CP.Arc(), F, myEFMap, other))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_ConcaveCreaseAt
+// purpose  : Whether face F meets a face it is tangent to across a concave
+//            edge at vertex V (at a contour stopped at a turn).
+//=======================================================================
+
+static bool ChFi3d_ConcaveCreaseAt(const TopoDS_Vertex& V,
+                                   const TopoDS_Face&   F,
+                                   const ChFiDS_Map&    VEMap,
+                                   const ChFiDS_Map&    EFMap)
+{
+  TopoDS_Face other;
+  for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(V)); itE.More(); itE.Next())
+  {
+    if (ChFi3d_ConcaveCrease(TopoDS::Edge(itE.Value()), F, EFMap, other))
+    {
+      return true;
+    }
+  }
+  return false;
+}
