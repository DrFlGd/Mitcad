+//=======================================================================
+// function : ChFi3d_ConsumedSpineFaces
+// purpose  : The faces of the edges of a closed spine on which no surface
+//            data of the stripe lies (nor Extra): round a closed spine the
+//            blend's contacts left them everywhere for the faces beyond
+//            (an overflow start), so they lie wholly between the contacts.
+//=======================================================================
+
+NCollection_List<TopoDS_Shape> ChFi3d_ConsumedSpineFaces(const TopOpeBRepDS_DataStructure&   DStr,
+                                                         const occ::handle<ChFiDS_Stripe>&   CorDat,
+                                                         const occ::handle<ChFiDS_SurfData>& Extra,
+                                                         const ChFiDS_Map&                   EFMap)
+{
+  NCollection_List<TopoDS_Shape>   aConsumed;
+  const occ::handle<ChFiDS_Spine>& aSpine = CorDat->Spine();
+  if (aSpine.IsNull() || !aSpine->IsPeriodic())
+  {
+    return aConsumed;
+  }
+  NCollection_List<TopoDS_Shape> aUsed;
+  const auto                     use = [&](const occ::handle<ChFiDS_SurfData>& Fd) {
+    for (int s = 1; s <= 2; s++)
+    {
+      if (!Fd.IsNull() && Fd->Index(s) > 0)
+      {
+        aUsed.Append(DStr.Shape(Fd->Index(s)));
+      }
+    }
+  };
+  use(Extra);
+  if (!CorDat->SetOfSurfData().IsNull())
+  {
+    const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = CorDat->SetOfSurfData()->Sequence();
+    for (int j = 1; j <= aSeq.Length(); j++)
+    {
+      use(aSeq(j));
+    }
+  }
+  for (int ie = 1; ie <= aSpine->NbEdges(); ie++)
+  {
+    const TopoDS_Edge& anE = aSpine->Edges(ie);
+    if (!EFMap.Contains(anE))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(anE)); it.More(); it.Next())
+    {
+      if (!containsSame(aUsed, it.Value()) && !containsSame(aConsumed, it.Value()))
+      {
+        aConsumed.Append(it.Value());
+      }
+    }
+  }
+  return aConsumed;
+}
