+//=======================================================================
+// function : ChFi3d_JoinAcrossNotches
+// purpose  : Two ends of analytic blends (of two stripes, or the two ends
+//            of one) whose contacts on one face lie on one line and whose
+//            other contacts end on edges of two faces of one surface,
+//            separated by a notch in that surface's rim (the edge chain
+//            breaks at the notch, its edges not rounded): the blends are
+//            one surface, and over the notch the ball rolls on with the
+//            contact on that face, the notch's faces cutting the blend's
+//            other side. The blend of one end runs on over the notch, cut
+//            by those faces in turn (ChFi3d_KPartChainPieces), up to the
+//            other end's section, where the two ends meet: they share that
+//            section's points, and the blends are one face where their
+//            surfaces are one, or share the section's edge otherwise. The
+//            two ends then are free ends, with no corner at their vertices.
+//            Before, each end's contact on the common face ran on to the
+//            end of its domain on that face (over the other blend's), and
+//            the corners failed or the blends crossed.
+//=======================================================================
+
+void ChFi3d_JoinAcrossNotches(TopOpeBRepDS_DataStructure&                         DStr,
+                              const NCollection_List<occ::handle<ChFiDS_Stripe>>& Stripes,
+                              const ChFiDS_Map&                                   EFMap,
+                              const double                                        tol3d,
+                              const double                                        tol2d)
+{
+  // The faces across the arc of a common point from F, not tangent to F.
+  const auto faceBeyond = [&](const ChFiDS_CommonPoint& CP, const TopoDS_Face& F, TopoDS_Face& B) {
+    if (!CP.IsOnArc() || CP.IsVertex() || !EFMap.Contains(CP.Arc()))
+    {
+      return false;
+    }
+    const TopoDS_Edge& E = TopoDS::Edge(CP.Arc());
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(F))
+      {
+        B = TopoDS::Face(it.Value());
+      }
+    }
+    return !B.IsNull() && !ChFi3d::IsTangentFaces(E, F, B);
+  };
+  // An analytic blend's end SurfData with its contact lines.
+  const auto analytic = [&](const occ::handle<ChFiDS_SurfData>& SD) {
+    if (SD.IsNull() || SD->Index(1) <= 0 || SD->Index(2) <= 0 || SD->IsOnCurve1() || SD->IsOnCurve2())
+    {
+      return false;
+    }
+    for (int s = 1; s <= 2; s++)
+    {
+      const ChFiDS_FaceInterference& FI = SD->Interference(s);
+      if (FI.LineIndex() <= 0 || DStr.Curve(FI.LineIndex()).Curve().IsNull() || FI.PCurveOnSurf().IsNull()
+          || FI.PCurveOnFace().IsNull())
+      {
+        return false;
+      }
+    }
+    const GeomAdaptor_Surface aS(DStr.Surface(SD->Surf()).Surface());
+    return aS.GetType() == GeomAbs_Plane || aS.GetType() == GeomAbs_Cylinder || aS.GetType() == GeomAbs_Cone
+           || aS.GetType() == GeomAbs_Sphere || aS.GetType() == GeomAbs_Torus;
+  };
+  // The end SurfData's contact of side s cut back to the section through its
+  // other side's end point (the contact on a common face may run on to the
+  // end of its domain there, SplitKPart's extension for the corner).
+  const auto cutToSection = [&](const occ::handle<ChFiDS_SurfData>& SD, const bool isFirst, const int s) {
+    double t = 0.;
+    if (!ChFi3d_KPartLineParam(DStr, SD, s, SD->Vertex(isFirst, 3 - s).Point(), t))
+    {
+      return false;
+    }
+    ChFiDS_FaceInterference& FI = SD->ChangeInterference(s);
+    // (On a closed line, the parameter in the period of the contact's end.)
+    const occ::handle<Geom_Curve>& C = DStr.Curve(FI.LineIndex()).Curve();
+    if (C->IsPeriodic())
+    {
+      const double aRef = FI.Parameter(isFirst);
+      t                 = ElCLib::InPeriod(t, aRef - 0.5 * C->Period(), aRef + 0.5 * C->Period());
+    }
+    if (isFirst ? t >= FI.LastParameter() : t <= FI.FirstParameter())
+    {
+      return false;
+    }
+    FI.SetParameter(t, isFirst);
+    ChFiDS_CommonPoint& CP     = SD->ChangeVertex(isFirst, s);
+    const double        aParam = CP.Parameter();
+    CP.Reset();
+    CP.SetPoint(C->Value(t));
+    CP.SetParameter(aParam);
+    return true;
+  };
+
+  // The number of stripe ends at vertex V (a corner of one stripe alone: 1).
+  const auto nbEndsAt = [&](const TopoDS_Vertex& V) {
+    int n = 0;
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(Stripes); it.More(); it.Next())
+    {
+      const occ::handle<ChFiDS_Spine>& sp = it.Value()->Spine();
+      if (sp.IsNull() || sp->IsPeriodic())
+      {
+        continue;
+      }
+      n += sp->FirstVertex().IsSame(V) ? 1 : 0;
+      n += sp->LastVertex().IsSame(V) ? 1 : 0;
+    }
+    return n;
+  };
+  NCollection_List<occ::handle<ChFiDS_Stripe>> aJoined[2]; // ends joined: first, last
+  const auto joined = [&](const occ::handle<ChFiDS_Stripe>& S, const bool isFirst) {
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(aJoined[isFirst ? 0 : 1]); it.More(); it.Next())
+    {
+      if (it.Value() == S)
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itA(Stripes); itA.More(); itA.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& SA  = itA.Value();
+    const occ::handle<ChFiDS_Spine>&  spA = SA->Spine();
+    if (spA.IsNull() || spA->IsPeriodic() || SA->SetOfSurfData().IsNull() || SA->SetOfSurfData()->IsEmpty())
+    {
+      continue;
+    }
+    for (int ea = 0; ea < 2; ea++)
+    {
+      const bool aFirst = ea == 0;
+      if (joined(SA, aFirst) || spA->Status(aFirst) == ChFiDS_FreeBoundary || spA->Status(aFirst) == ChFiDS_Closed)
+      {
+        continue;
+      }
+      const occ::handle<ChFiDS_SurfData> FdA =
+        aFirst ? SA->SetOfSurfData()->Value(1) : SA->SetOfSurfData()->Value(SA->SetOfSurfData()->Length());
+      if (!analytic(FdA))
+      {
+        continue;
+      }
+      bool done = false;
+      for (int ons = 1; ons <= 2 && !done; ons++)
+      {
+        const int                 opp = 3 - ons;
+        const ChFiDS_CommonPoint& CPa = FdA->Vertex(aFirst, ons);
+        const TopoDS_Face         Na  = TopoDS::Face(DStr.Shape(FdA->Index(ons)));
+        TopoDS_Face               Ba;
+        if (!faceBeyond(CPa, Na, Ba))
+        {
+          continue;
+        }
+        for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB(Stripes); itB.More() && !done; itB.Next())
+        {
+          const occ::handle<ChFiDS_Stripe>& SB  = itB.Value();
+          const occ::handle<ChFiDS_Spine>&  spB = SB->Spine();
+          if (spB.IsNull() || spB->IsPeriodic() || SB->SetOfSurfData().IsNull() || SB->SetOfSurfData()->IsEmpty())
+          {
+            continue;
+          }
+          for (int eb = 0; eb < 2 && !done; eb++)
+          {
+            const bool bFirst = eb == 0;
+            if ((SB == SA && bFirst == aFirst) || joined(SB, bFirst) || spB->Status(bFirst) == ChFiDS_FreeBoundary
+                || spB->Status(bFirst) == ChFiDS_Closed)
+            {
+              continue;
+            }
+            // (Its end at another vertex: the notch lies between them.)
+            const TopoDS_Vertex Va = aFirst ? spA->FirstVertex() : spA->LastVertex();
+            const TopoDS_Vertex Vb = bFirst ? spB->FirstVertex() : spB->LastVertex();
+            if (Va.IsSame(Vb))
+            {
+              continue;
+            }
+            const occ::handle<ChFiDS_SurfData> FdB =
+              bFirst ? SB->SetOfSurfData()->Value(1) : SB->SetOfSurfData()->Value(SB->SetOfSurfData()->Length());
+            if (!analytic(FdB))
+            {
+              continue;
+            }
+            // The common face on B's side oppB, the notched one on onsB.
+            int oppB = 0;
+            for (int s = 1; s <= 2; s++)
+            {
+              if (FdB->Index(s) == FdA->Index(opp) && FdB->Index(3 - s) != FdA->Index(opp))
+              {
+                oppB = s;
+              }
+            }
+            if (oppB == 0)
+            {
+              continue;
+            }
+            const int                 onsB = 3 - oppB;
+            const ChFiDS_CommonPoint& CPb  = FdB->Vertex(bFirst, onsB);
+            const TopoDS_Face         Nb   = TopoDS::Face(DStr.Shape(FdB->Index(onsB)));
+            TopoDS_Face               Bb;
+            if (Nb.IsSame(Na) || !faceBeyond(CPb, Nb, Bb) || nbEndsAt(Va) != 1 || nbEndsAt(Vb) != 1)
+            {
+              continue;
+            }
+            {
+              // The notched faces: two faces of one surface.
+              GeomAPI_ProjectPointOnSurf aPa(CPa.Point(), BRep_Tool::Surface(Nb));
+              GeomAPI_ProjectPointOnSurf aPb(CPb.Point(), BRep_Tool::Surface(Na));
+              if (aPa.NbPoints() == 0 || aPb.NbPoints() == 0 || aPa.LowerDistance() > 10. * tol3d
+                  || aPb.LowerDistance() > 10. * tol3d)
+              {
+                continue;
+              }
+            }
+            // One surface: B's end section and middle lie on A's surface,
+            // and B's end point on the notched side on A's line there.
+            const occ::handle<Geom_Surface>& SurfA = DStr.Surface(FdA->Surf()).Surface();
+            const occ::handle<Geom_Surface>& SurfB = DStr.Surface(FdB->Surf()).Surface();
+            bool                             one   = true;
+            {
+              const ChFiDS_FaceInterference& F1 = FdB->Interference(onsB);
+              const ChFiDS_FaceInterference& F2 = FdB->Interference(oppB);
+              for (int k = 0; k < 3 && one; k++)
+              {
+                const gp_Pnt2d a1 = F1.PCurveOnSurf()->Value(F1.Parameter(bFirst));
+                const gp_Pnt2d m1 = F1.PCurveOnSurf()->Value(0.5 * (F1.FirstParameter() + F1.LastParameter()));
+                const gp_Pnt2d a2 = F2.PCurveOnSurf()->Value(F2.Parameter(bFirst));
+                const gp_Pnt2d p  = k == 0 ? a1 : (k == 1 ? gp_Pnt2d(0.5 * (a1.XY() + a2.XY())) : m1);
+                GeomAPI_ProjectPointOnSurf aPr(SurfB->Value(p.X(), p.Y()), SurfA);
+                one = aPr.NbPoints() > 0 && aPr.LowerDistance() <= 10. * tol3d;
+              }
+              double tN = 0.;
+              one       = one && ChFi3d_KPartLineParam(DStr, FdA, ons, CPb.Point(), tN)
+                    && DStr.Curve(FdA->Interference(ons).LineIndex()).Curve()->Value(tN).Distance(CPb.Point())
+                         <= 10. * tol3d;
+            }
+            if (!one)
+            {
+              continue;
+            }
+            // The contacts on the common face cut back to the ends' sections
+            // (restored where no join is made).
+            const ChFiDS_FaceInterference aSavedFA = FdA->Interference(opp);
+            const ChFiDS_FaceInterference aSavedFB = FdB->Interference(oppB);
+            const ChFiDS_CommonPoint      aSavedCA = FdA->Vertex(aFirst, opp);
+            const ChFiDS_CommonPoint      aSavedCB = FdB->Vertex(bFirst, oppB);
+            const auto                    restore  = [&]() {
+              FdA->ChangeInterference(opp)    = aSavedFA;
+              FdB->ChangeInterference(oppB)   = aSavedFB;
+              FdA->ChangeVertex(aFirst, opp)  = aSavedCA;
+              FdB->ChangeVertex(bFirst, oppB) = aSavedCB;
+            };
+            if (!cutToSection(FdA, aFirst, opp) || !cutToSection(FdB, bFirst, oppB))
+            {
+              restore();
+              continue;
+            }
+            // The gap: from A's end to the section of A through B's end
+            // point (on the common face's line).
+            double tB = 0.;
+            if (!ChFi3d_KPartLineParam(DStr, FdA, opp, FdB->Vertex(bFirst, oppB).Point(), tB))
+            {
+              restore();
+              continue;
+            }
+            // (A's end section: through its point on the notched side, which
+            // the spine parameters of its extended piece may lie beyond.)
+            double WA = 0.;
+            if (!ChFi3d_KPartSpineParamOf(DStr,
+                                          spA,
+                                          FdA,
+                                          opp,
+                                          FdA->Interference(opp).Parameter(aFirst),
+                                          FdA->FirstSpineParam(),
+                                          FdA->LastSpineParam(),
+                                          WA))
+            {
+              restore();
+              continue;
+            }
+            const double aLen = 3. * CPa.Point().Distance(CPb.Point()) + 10. * tol3d;
+            double       WB   = 0.;
+            if (!ChFi3d_KPartSpineParamOf(DStr, spA, FdA, opp, tB, WA, aFirst ? WA - aLen : WA + aLen, WB)
+                || std::abs(WB - WA) <= 10. * Precision::PConfusion())
+            {
+              restore();
+              continue;
+            }
+            {
+              // Over the gap the contact on the common face stays inside it
+              // (the notch lies between the contacts).
+              const ChFiDS_FaceInterference& FO = FdA->Interference(opp);
+              TopoDS_Face                    Fo = TopoDS::Face(DStr.Shape(FdA->Index(opp)));
+              Fo.Orientation(TopAbs_FORWARD);
+              const BRepTopAdaptor_FClass2d aClass(Fo, Precision::PConfusion());
+              const double                  tA = FO.Parameter(aFirst);
+              // (B's end lies beyond A's end on the line.)
+              bool in = aFirst ? tB < tA : tB > tA;
+              for (int k = 1; k < 8 && in; k++)
+              {
+                const TopAbs_State st = aClass.Perform(FO.PCurveOnFace()->Value(tA + (tB - tA) * k / 8.));
+                in                    = st == TopAbs_IN || st == TopAbs_ON;
+              }
+              if (!in)
+              {
+                restore();
+                continue;
+              }
+            }
+            const double W1 = aFirst ? WB : WA;
+            const double W2 = aFirst ? WA : WB;
+            // B's end as a given end of A's pieces.
+            ChFi3d_KPartCutEnd anEndB;
+            {
+              double tN = 0., tO = 0., f = 0., l = 0.;
+              TopoDS_Face BbF = Bb;
+              BbF.Orientation(TopAbs_FORWARD);
+              const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(TopoDS::Edge(CPb.Arc()), BbF, f, l);
+              if (pc.IsNull() || !ChFi3d_KPartLineParam(DStr, FdA, ons, CPb.Point(), tN)
+                  || !ChFi3d_KPartLineParam(DStr, FdA, opp, CPb.Point(), tO))
+              {
+                restore();
+                continue;
+              }
+              anEndB.P   = CPb.Point();
+              anEndB.uvS = FdA->Interference(ons).PCurveOnSurf()->Value(tN);
+              anEndB.uvB = pc->Value(CPb.ParameterOnArc());
+              anEndB.tO  = tO;
+              anEndB.CPN = CPb;
+              anEndB.CPO = FdB->Vertex(bFirst, oppB);
+            }
+            // The pieces over the notch, from the face beyond at the gap's
+            // start to the one at its end.
+            const TopoDS_Face&                                 B0 = aFirst ? Bb : Ba;
+            const TopoDS_Face&                                 Bn = aFirst ? Ba : Bb;
+            NCollection_Sequence<occ::handle<ChFiDS_SurfData>> aPieces;
+            const occ::handle<ChFiDS_SurfData>                 aNone;
+            const occ::handle<ChFiDS_SurfData>&                aPrev = aFirst ? aNone : FdA;
+            const occ::handle<ChFiDS_SurfData>&                aNext = aFirst ? FdA : aNone;
+            try
+            {
+              OCC_CATCH_SIGNALS
+              if (B0.IsSame(Bn))
+              {
+                const occ::handle<ChFiDS_SurfData> G = ChFi3d_KPartCutPiece(DStr,
+                                                                            spA,
+                                                                            FdA,
+                                                                            ons,
+                                                                            Na,
+                                                                            B0,
+                                                                            W1,
+                                                                            W2,
+                                                                            aPrev,
+                                                                            aNext,
+                                                                            tol3d,
+                                                                            aFirst ? &anEndB : nullptr,
+                                                                            aFirst ? nullptr : &anEndB);
+                if (!G.IsNull())
+                {
+                  aPieces.Append(G);
+                }
+              }
+              else
+              {
+                NCollection_Sequence<TopoDS_Face>          aFaces;
+                NCollection_Sequence<ChFi3d_KPartCrossing> aCrossings;
+                if (ChFi3d_KPartCutChain(DStr, spA, FdA, ons, Na, B0, Bn, W1, W2, EFMap, aFaces, aCrossings))
+                {
+                  if (!ChFi3d_KPartChainPieces(DStr,
+                                               spA,
+                                               FdA,
+                                               ons,
+                                               Na,
+                                               aFaces,
+                                               aCrossings,
+                                               aPrev,
+                                               aNext,
+                                               W1,
+                                               W2,
+                                               tol3d,
+                                               aPieces,
+                                               aFirst ? &anEndB : nullptr,
+                                               aFirst ? nullptr : &anEndB))
+                  {
+                    aPieces.Clear();
+                  }
+                }
+              }
+            }
+            catch (Standard_Failure const&)
+            {
+              aPieces.Clear();
+            }
+            if (aPieces.IsEmpty())
+            {
+              restore();
+              continue;
+            }
+            if (aFirst)
+            {
+              FdA->FirstSpineParam(WA);
+            }
+            else
+            {
+              FdA->LastSpineParam(WA);
+            }
+            // The pieces are on A's surface, with A's blend. Where the two
+            // surfaces are one but parametrized otherwise, A's parameters map
+            // onto B's by a plane isometry (T), A's orientation flipped where
+            // the normals are opposite (aFlip).
+            gp_Trsf2d  aT;
+            bool       aFlip = false;
+            const bool aSame = ChFi3d_SameAnalyticSurface(SurfA, SurfB);
+            bool       aMerge = aSame;
+            if (!aSame)
+            {
+              // (The meeting point's parameters on both surfaces.)
+              const ChFiDS_FaceInterference& FA = aPieces.Value(aFirst ? 1 : aPieces.Length())->Interference(opp);
+              const ChFiDS_FaceInterference& FB = FdB->Interference(oppB);
+              aMerge = ChFi3d_AnalyticParamMap(SurfA,
+                                               SurfB,
+                                               FA.PCurveOnSurf()->Value(FA.Parameter(aFirst)),
+                                               FB.PCurveOnSurf()->Value(FB.Parameter(bFirst)),
+                                               tol3d,
+                                               aT,
+                                               aFlip);
+            }
+            aMerge = aMerge
+                     && (aFlip ? TopAbs::Reverse(FdA->Orientation()) : FdA->Orientation()) == FdB->Orientation();
+            const int aSurfA = FdA->Surf();
+            if (aMerge && SA == SB)
+            {
+              // (The two ends of one stripe: one surface all round would be a
+              // face closed on itself with no seam; the section stays.)
+              bool aAllOne = true;
+              for (int i = 1; i <= SA->SetOfSurfData()->Length() && aAllOne; i++)
+              {
+                const int s = SA->SetOfSurfData()->Value(i)->Surf();
+                aAllOne     = s == aSurfA || s == FdB->Surf();
+              }
+              aMerge = !aAllOne;
+            }
+            const bool aMap = aMerge && !aSame;
+            for (int i = 1; i <= aPieces.Length(); i++)
+            {
+              aPieces.ChangeValue(i)->ChangeSurf(aSurfA);
+            }
+            NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeqA = SA->ChangeSetOfSurfData()->ChangeSequence();
+            for (int i = aPieces.Length(); i >= 1 && aFirst; i--)
+            {
+              aSeqA.Prepend(aPieces.Value(i));
+            }
+            for (int i = 1; i <= aPieces.Length() && !aFirst; i++)
+            {
+              aSeqA.Append(aPieces.Value(i));
+            }
+            // The meeting section's points, shared by both ends.
+            const int Iopp = ChFi3d_IndexPointInDS(FdB->Vertex(bFirst, oppB), DStr);
+            const int Ions = ChFi3d_IndexPointInDS(CPb, DStr);
+            SB->SetIndexPoint(Iopp, bFirst, oppB);
+            SB->SetIndexPoint(Ions, bFirst, onsB);
+            SA->SetIndexPoint(Iopp, aFirst, opp);
+            SA->SetIndexPoint(Ions, aFirst, ons);
+            if (aMerge)
+            {
+              // One surface, one face: A's run on its surface takes B's.
+              for (int i = 1; i <= aSeqA.Length(); i++)
+              {
+                const occ::handle<ChFiDS_SurfData>& D = aSeqA.ChangeValue(i);
+                if (D->Surf() != aSurfA)
+                {
+                  continue;
+                }
+                D->ChangeSurf(FdB->Surf());
+                if (!aMap)
+                {
+                  continue;
+                }
+                for (int s = 1; s <= 2; s++)
+                {
+                  occ::handle<Geom2d_Curve>& aPC = D->ChangeInterference(s).ChangePCurveOnSurf();
+                  if (!aPC.IsNull())
+                  {
+                    aPC = occ::down_cast<Geom2d_Curve>(aPC->Transformed(aT));
+                  }
+                }
+                gp_Pnt2d p[4];
+                D->Get2dPoints(p[0], p[1], p[2], p[3]);
+                for (gp_Pnt2d& q : p)
+                {
+                  q.Transform(aT);
+                }
+                D->Set2dPoints(p[0], p[1], p[2], p[3]);
+                if (aFlip)
+                {
+                  D->ChangeOrientation() = TopAbs::Reverse(D->Orientation());
+                }
+              }
+            }
+            else
+            {
+              // The section's edge, from B's point of side 1 to that of side 2.
+              const occ::handle<ChFiDS_SurfData>& GA = aFirst ? aSeqA.First() : aSeqA.Last();
+              const ChFiDS_FaceInterference&      B1 = FdB->Interference(1);
+              const ChFiDS_FaceInterference&      B2 = FdB->Interference(2);
+              occ::handle<Geom_Curve>             C3d;
+              occ::handle<Geom2d_Curve>           PcB, PcA;
+              double                              Pardeb = 0., Parfin = 0., tolreached = tol3d;
+              ChFi3d_ComputeArete(FdB->Vertex(bFirst, 1),
+                                  B1.PCurveOnSurf()->Value(B1.Parameter(bFirst)),
+                                  FdB->Vertex(bFirst, 2),
+                                  B2.PCurveOnSurf()->Value(B2.Parameter(bFirst)),
+                                  SurfB,
+                                  C3d,
+                                  PcB,
+                                  Pardeb,
+                                  Parfin,
+                                  tol3d,
+                                  tol2d,
+                                  tolreached,
+                                  0);
+              // On A: B's side 1 is A's side 1 where the common faces agree.
+              const bool                     aSameSides = (oppB == 1) == (opp == 1);
+              const ChFiDS_FaceInterference& G1         = GA->Interference(aSameSides ? 1 : 2);
+              const ChFiDS_FaceInterference& G2         = GA->Interference(aSameSides ? 2 : 1);
+              const gp_Pnt2d                 u1         = G1.PCurveOnSurf()->Value(G1.Parameter(aFirst));
+              const gp_Pnt2d                 u2         = G2.PCurveOnSurf()->Value(G2.Parameter(aFirst));
+              double                         tolA       = tol3d;
+              ChFi3d_ComputePCurv(C3d,
+                                  u1,
+                                  u2,
+                                  PcA,
+                                  DStr.Surface(GA->Surf()).Surface(),
+                                  Pardeb,
+                                  Parfin,
+                                  tol3d,
+                                  tolA);
+              const int Ic = DStr.AddCurve(TopOpeBRepDS_Curve(C3d, std::max(tolreached, tolA)));
+              SB->SetCurve(Ic, bFirst);
+              SB->SetParameters(bFirst, Pardeb, Parfin);
+              SB->ChangePCurve(bFirst) = PcB;
+              SA->SetCurve(Ic, aFirst);
+              SA->SetParameters(aFirst, Pardeb, Parfin);
+              SA->ChangePCurve(aFirst) = PcA;
+              if (!aSameSides)
+              {
+                if (aFirst)
+                {
+                  SA->FirstPCurveOrientation(TopAbs_REVERSED);
+                }
+                else
+                {
+                  SA->LastPCurveOrientation(TopAbs_REVERSED);
+                }
+              }
+            }
+            spA->SetStatus(ChFiDS_FreeBoundary, aFirst);
+            spB->SetStatus(ChFiDS_FreeBoundary, bFirst);
+            aJoined[aFirst ? 0 : 1].Append(SA);
+            aJoined[bFirst ? 0 : 1].Append(SB);
+            done = true;
+          }
+        }
+      }
+    }
+  }
+}
