+//=======================================================================
+// function : ChFi3d_KPartSpineParamOf
+// purpose  : The spine parameter W, between Wa and Wb, of the section of the
+//            analytic blend Full through the point of parameter t on its
+//            contact line of side opp (the section through a spine point
+//            meets that line where it comes nearest to the point).
+//=======================================================================
+
+static bool ChFi3d_KPartSpineParamOf(const TopOpeBRepDS_DataStructure&   DStr,
+                                     const occ::handle<ChFiDS_Spine>&    Spine,
+                                     const occ::handle<ChFiDS_SurfData>& Full,
+                                     const int                           opp,
+                                     const double                        t,
+                                     const double                        Wa,
+                                     const double                        Wb,
+                                     double&                             W)
+{
+  double ta = 0., tb = 0.;
+  if (!ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(Wa), ta)
+      || !ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(Wb), tb) || (ta - t) * (tb - t) > 0.)
+  {
+    return false;
+  }
+  double a = Wa, b = Wb;
+  for (int it = 0; it < 60; it++)
+  {
+    const double m  = 0.5 * (a + b);
+    double       tm = 0.;
+    if (!ChFi3d_KPartLineParam(DStr, Full, opp, Spine->Value(m), tm))
+    {
+      return false;
+    }
+    if ((tm - t) * (ta - t) > 0.)
+    {
+      a  = m;
+      ta = tm;
+    }
+    else
+    {
+      b = m;
+    }
+  }
+  W = 0.5 * (a + b);
+  return true;
+}
