+//=======================================================================
+// function : ChFi3d_AnalyticParamMap
+// purpose  : Where two elementary surfaces S1 and S2 are one surface with
+//            other parametrizations (axes turned or reversed), the plane
+//            isometry T of their parameters (S2(T(p)) = S1(p)) that takes
+//            uv1 to uv2 (parameters of one point), and whether their
+//            normals are opposite (Flip).
+//=======================================================================
+
+static bool ChFi3d_AnalyticParamMap(const occ::handle<Geom_Surface>& S1,
+                                    const occ::handle<Geom_Surface>& S2,
+                                    const gp_Pnt2d&                  uv1,
+                                    const gp_Pnt2d&                  uv2,
+                                    const double                     tol3d,
+                                    gp_Trsf2d&                       T,
+                                    bool&                            Flip)
+{
+  if (S1.IsNull() || S2.IsNull())
+  {
+    return false;
+  }
+  const GeomAdaptor_Surface A1(S1), A2(S2);
+  if (A1.GetType() != A2.GetType()
+      || (A1.GetType() != GeomAbs_Plane && A1.GetType() != GeomAbs_Cylinder && A1.GetType() != GeomAbs_Cone
+          && A1.GetType() != GeomAbs_Sphere && A1.GetType() != GeomAbs_Torus))
+  {
+    return false;
+  }
+  const double tol = 10. * tol3d;
+  if (S1->Value(uv1.X(), uv1.Y()).Distance(S2->Value(uv2.X(), uv2.Y())) > tol)
+  {
+    return false;
+  }
+  // The parameters on S2 of S1's point at p, in S2's periods nearest to uv2.
+  const auto onS2 = [&](const gp_Pnt2d& p, gp_Pnt2d& q) {
+    GeomAPI_ProjectPointOnSurf aPr(S1->Value(p.X(), p.Y()), S2);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tol)
+    {
+      return false;
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    if (S2->IsUPeriodic())
+    {
+      u = ElCLib::InPeriod(u, uv2.X() - 0.5 * S2->UPeriod(), uv2.X() + 0.5 * S2->UPeriod());
+    }
+    if (S2->IsVPeriodic())
+    {
+      v = ElCLib::InPeriod(v, uv2.Y() - 0.5 * S2->VPeriod(), uv2.Y() + 0.5 * S2->VPeriod());
+    }
+    q.SetCoord(u, v);
+    return true;
+  };
+  const double d = 1.e-2;
+  gp_Pnt2d     qu, qv;
+  if (!onS2(gp_Pnt2d(uv1.X() + d, uv1.Y()), qu) || !onS2(gp_Pnt2d(uv1.X(), uv1.Y() + d), qv))
+  {
+    return false;
+  }
+  const gp_XY a = (qu.XY() - uv2.XY()) / d, b = (qv.XY() - uv2.XY()) / d;
+  // (An isometry: unit columns, square to each other.)
+  if (std::abs(a.Modulus() - 1.) > 1.e-4 || std::abs(b.Modulus() - 1.) > 1.e-4 || std::abs(a * b) > 1.e-4)
+  {
+    return false;
+  }
+  // (Columns along the axes taken exactly so.)
+  const double a1 = std::round(a.X()), a2 = std::round(a.Y()), b1 = std::round(b.X()), b2 = std::round(b.Y());
+  const bool   axisAligned =
+    std::abs(a1 - a.X()) + std::abs(a2 - a.Y()) + std::abs(b1 - b.X()) + std::abs(b2 - b.Y()) <= 4.e-4;
+  const gp_XY ca = axisAligned ? gp_XY(a1, a2) : a, cb = axisAligned ? gp_XY(b1, b2) : b;
+  const gp_XY t =
+    uv2.XY() - gp_XY(ca.X() * uv1.X() + cb.X() * uv1.Y(), ca.Y() * uv1.X() + cb.Y() * uv1.Y());
+  try
+  {
+    OCC_CATCH_SIGNALS
+    T.SetValues(ca.X(), cb.X(), t.X(), ca.Y(), cb.Y(), t.Y());
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  // (A point farther off: the map holds there too.)
+  for (const gp_Pnt2d& p : {gp_Pnt2d(uv1.X() + 0.3, uv1.Y() + 0.2), gp_Pnt2d(uv1.X() - 0.2, uv1.Y() - 0.3)})
+  {
+    const gp_Pnt2d q = p.Transformed(T);
+    if (S1->Value(p.X(), p.Y()).Distance(S2->Value(q.X(), q.Y())) > tol)
+    {
+      return false;
+    }
+  }
+  gp_Pnt P;
+  gp_Vec D1u, D1v, D2u, D2v;
+  S1->D1(uv1.X(), uv1.Y(), P, D1u, D1v);
+  S2->D1(uv2.X(), uv2.Y(), P, D2u, D2v);
+  Flip = D1u.Crossed(D1v).Dot(D2u.Crossed(D2v)) < 0.;
+  return true;
+}
