--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_2.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_2.cxx
@@ -1465,6 +1465,33 @@ static bool ballCannotTouch(const TopoDS_Face& F,
   return towards > (1. + 1.e-3) / R;
 }
 
+// Whether face Fv borders an edge of the spine: the blend runs along Fv
+// there, its sections touching Fv, and the spine turns with the face (a
+// contour going on round a corner rounded more sharply than the ball).
+// Such a face is no gap of the blend's face, whatever its curvature along
+// the spine.
+static bool faceAlongSpine(const occ::handle<ChFiDS_Spine>& Spine,
+                           const TopoDS_Face&               Fv,
+                           const ChFiDS_Map&                EFMap)
+{
+  for (int i = 1; i <= Spine->NbEdges(); i++)
+  {
+    const TopoDS_Edge& E = Spine->Edges(i);
+    if (!EFMap.Contains(E))
+    {
+      continue;
+    }
+    for (const TopoDS_Shape& aFace : EFMap.FindFromKey(E))
+    {
+      if (aFace.IsSame(Fv))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
