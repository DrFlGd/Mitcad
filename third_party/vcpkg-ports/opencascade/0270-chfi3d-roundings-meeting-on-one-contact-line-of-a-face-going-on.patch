+// Makes the interferences of the data structure at point theOld be at
+// point theNew instead (two corners' points that are one).
+static void redirectPoint(TopOpeBRepDS_DataStructure& DStr, const int theOld, const int theNew)
+{
+  const auto redirect = [&](NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& theList) {
+    for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(theList); it.More();
+         it.Next())
+    {
+      if (it.Value()->GeometryType() == TopOpeBRepDS_POINT && it.Value()->Geometry() == theOld)
+      {
+        it.ChangeValue()->Geometry(theNew);
+      }
+    }
+  };
+  for (int i = 1; i <= DStr.NbShapes(); i++)
+  {
+    redirect(DStr.ChangeShapeInterferences(i));
+  }
+  for (int i = 1; i <= DStr.NbCurves(); i++)
+  {
+    redirect(DStr.ChangeCurveInterferences(i));
+  }
+  for (int i = 1; i <= DStr.NbSurfaces(); i++)
+  {
+    redirect(DStr.ChangeSurfaceInterferences(i));
+  }
+}
