+// The points of the data structure at P (within Tol) made one: the first.
+static int mergePointsAt(TopOpeBRepDS_DataStructure& DStr, const gp_Pnt& P, const double Tol)
+{
+  int aFirst = 0;
+  for (int i = 1; i <= DStr.NbPoints(); i++)
+  {
+    if (DStr.Point(i).Point().Distance(P) > Tol)
+    {
+      continue;
+    }
+    if (aFirst == 0)
+    {
+      aFirst = i;
+    }
+    else
+    {
+      redirectPoint(DStr, i, aFirst);
+    }
+  }
+  return aFirst;
+}
+
+// Two blends cut by each other meet on curve Ic of the data structure, from
+// P1 to P2 (where their contacts on a face cross), once both stripes are in
+// it: each stripe made its own points there, now one; the curve runs from
+// the one to the other; and on the surface Iagainst (where non-zero), whose
+// SurfData runs from P2 to P1, it is used the other way.
+static void meetOnCurve(TopOpeBRepDS_DataStructure& DStr,
+                        const int                   Ic,
+                        const gp_Pnt&               P1,
+                        const gp_Pnt&               P2,
+                        const int                   Iagainst,
+                        const double                Tol)
+{
+  const int aP1 = mergePointsAt(DStr, P1, Tol);
+  const int aP2 = mergePointsAt(DStr, P2, Tol);
+  const occ::handle<Geom_Curve>& C = DStr.Curve(Ic).Curve();
+  if (aP1 == 0 || aP2 == 0 || C.IsNull())
+  {
+    return;
+  }
+  NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& L = DStr.ChangeCurveInterferences(Ic);
+  L.Clear();
+  L.Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, Ic, aP1, C->FirstParameter(), false));
+  L.Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, Ic, aP2, C->LastParameter(), false));
+  if (Iagainst <= 0)
+  {
+    return;
+  }
+  for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(
+         DStr.ChangeSurfaceInterferences(Iagainst));
+       it.More();
+       it.Next())
+  {
+    if (it.Value()->GeometryType() == TopOpeBRepDS_CURVE && it.Value()->Geometry() == Ic)
+    {
+      const TopAbs_Orientation anO = it.Value()->Transition().Orientation(TopAbs_IN);
+      it.ChangeValue()->ChangeTransition() = TopOpeBRepDS_Transition(TopAbs::Reverse(anO));
+    }
+  }
+}
