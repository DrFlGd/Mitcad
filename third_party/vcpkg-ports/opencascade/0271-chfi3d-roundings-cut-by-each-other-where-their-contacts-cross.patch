+// Removes the rides (RideOnOverlap) of stripe S, or on it, from their
+// parallel lists.
+static void removeRideOf(const occ::handle<ChFiDS_Stripe>&             S,
+                         NCollection_List<occ::handle<ChFiDS_Stripe>>& Rides,
+                         NCollection_List<occ::handle<ChFiDS_Stripe>>& RideOn,
+                         NCollection_List<TopoDS_Shape>&               Faces,
+                         NCollection_List<TopoDS_Shape>&               Edges,
+                         NCollection_List<TopoDS_Shape>&               Supports)
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(Rides), itO(RideOn);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(Faces), itE(Edges), itA(Supports);
+  while (itS.More())
+  {
+    if (itS.Value() == S || itO.Value() == S)
+    {
+      Rides.Remove(itS);
+      RideOn.Remove(itO);
+      Faces.Remove(itF);
+      Edges.Remove(itE);
+      Supports.Remove(itA);
+    }
+    else
+    {
+      itS.Next();
+      itO.Next();
+      itF.Next();
+      itE.Next();
+      itA.Next();
+    }
+  }
+}
