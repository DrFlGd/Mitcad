+// Whether stripes A and B are open and have no spine end in common (so no
+// corner in common either).
+static bool shareNoSpineEnd(const occ::handle<ChFiDS_Stripe>& A, const occ::handle<ChFiDS_Stripe>& B)
+{
+  const occ::handle<ChFiDS_Spine>& SA = A->Spine();
+  const occ::handle<ChFiDS_Spine>& SB = B->Spine();
+  return !SA.IsNull() && !SB.IsNull() && !SA->IsPeriodic() && !SB->IsPeriodic()
+         && !SA->FirstVertex().IsSame(SB->FirstVertex())
+         && !SA->FirstVertex().IsSame(SB->LastVertex())
+         && !SA->LastVertex().IsSame(SB->FirstVertex())
+         && !SA->LastVertex().IsSame(SB->LastVertex());
+}
+
+// Whether the contacts of open stripes A and B with no spine end in common
+// cross each other twice on a face (contactsCrossTwice): they overlap only
+// part of the way, and their blends are to be cut by each other there.
+static bool crossPartOfTheWay(const TopOpeBRepDS_DataStructure& DStr,
+                              const occ::handle<ChFiDS_Stripe>& A,
+                              const occ::handle<ChFiDS_Stripe>& B,
+                              const double                      tol3d,
+                              const double                      tol2d)
+{
+  int    ia = 0, ka = 0, ib = 0, kb = 0;
+  double tA[2], tB[2];
+  return shareNoSpineEnd(A, B)
+         && contactsCrossTwice(DStr, A, B, tol3d, tol2d, ia, ka, ib, kb, tA, tB);
+}
+
+// Whether contacts of stripes A and B on a face they share cross each other
+// (where ChFi3d_StripeEdgeInter finds them meeting; not where they run
+// along each other, as two stripes making one blend do).
+static bool contactsCross(const occ::handle<ChFiDS_Stripe>& A,
+                         const occ::handle<ChFiDS_Stripe>& B,
+                         const double                      tol2d)
+{
+  if (A->SetOfSurfData().IsNull() || B->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  for (int ia = 1; ia <= A->SetOfSurfData()->Length(); ia++)
+  {
+    const occ::handle<ChFiDS_SurfData>& a = A->SetOfSurfData()->Value(ia);
+    for (int ib = 1; ib <= B->SetOfSurfData()->Length(); ib++)
+    {
+      const occ::handle<ChFiDS_SurfData>& b = B->SetOfSurfData()->Value(ib);
+      for (int ka = 1; ka <= 2; ka++)
+      {
+        for (int kb = 1; kb <= 2; kb++)
+        {
+          if (a->Index(ka) == 0 || a->Index(ka) != b->Index(kb))
+          {
+            continue;
+          }
+          const ChFiDS_FaceInterference& FA = a->Interference(ka);
+          const ChFiDS_FaceInterference& FB = b->Interference(kb);
+          if (IsEqual(FA.FirstParameter(), FA.LastParameter())
+              || IsEqual(FB.FirstParameter(), FB.LastParameter()) || FA.PCurveOnFace().IsNull()
+              || FB.PCurveOnFace().IsNull())
+          {
+            continue;
+          }
+          Geom2dAdaptor_Curve aCA(FA.PCurveOnFace(),
+                                  std::min(FA.FirstParameter(), FA.LastParameter()),
+                                  std::max(FA.FirstParameter(), FA.LastParameter()));
+          Geom2dAdaptor_Curve aCB(FB.PCurveOnFace(),
+                                  std::min(FB.FirstParameter(), FB.LastParameter()),
+                                  std::max(FB.FirstParameter(), FB.LastParameter()));
+          Geom2dInt_GInter    anInter(aCA, aCB, tol2d, Precision::PConfusion());
+          if (!anInter.IsDone())
+          {
+            continue;
+          }
+          for (int ip = 1; ip <= anInter.NbPoints(); ip++)
+          {
+            const IntRes2d_TypeTrans aType = anInter.Point(ip).TransitionOfFirst().TransitionType();
+            if (aType == IntRes2d_In || aType == IntRes2d_Out)
+            {
+              return true;
+            }
+          }
+          for (int is = 1; is <= anInter.NbSegments(); is++)
+          {
+            const IntRes2d_IntersectionSegment& aS = anInter.Segment(is);
+            if (aS.HasFirstPoint() && aS.HasLastPoint()
+                && aS.FirstPoint().Value().Distance(aS.LastPoint().Value()) <= 10. * tol2d)
+            {
+              return true;
+            }
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
