+//=======================================================================
+// function : ChFi3d_ProlongTangentEdge
+// purpose  : The prolongation past the corner's vertex V of an edge E along
+//            which the faces Fop and Fv are tangent (a plane turning into
+//            the torus of a rounded rim), up to the point P where the
+//            opposite contact meets Fv's surface. The faces' surfaces touch
+//            along E's curve, which an intersection of them cannot follow:
+//            the prolongation is E's own curve and p-curves continued from
+//            V to P (P within Tol of the curve, beyond V). C3d runs from V
+//            to P; PcOp and PcV are its curves on Fop (E oriented OonFop
+//            there) and on Fv.
+//=======================================================================
+
+static bool ChFi3d_ProlongTangentEdge(const TopoDS_Edge&                    E,
+                                      const TopAbs_Orientation              OonFop,
+                                      const TopoDS_Face&                    Fop,
+                                      const TopoDS_Face&                    Fv,
+                                      const occ::handle<Adaptor3d_Surface>& HSop,
+                                      const occ::handle<Adaptor3d_Surface>& HSv,
+                                      const TopoDS_Vertex&                  V,
+                                      const gp_Pnt&                         P,
+                                      const double                          Tol,
+                                      occ::handle<Geom_Curve>&              C3d,
+                                      occ::handle<Geom2d_Curve>&            PcOp,
+                                      occ::handle<Geom2d_Curve>&            PcV,
+                                      double&                               tolreached)
+{
+  if (BRep_Tool::Degenerated(E) || !ChFi3d::IsTangentFaces(E, Fop, Fv))
+  {
+    return false;
+  }
+  double                  f = 0., l = 0.;
+  occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+  if (C.IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_TrimmedCurve> aTr = occ::down_cast<Geom_TrimmedCurve>(C);
+  if (!aTr.IsNull())
+  {
+    C = aTr->BasisCurve();
+  }
+  const double tV     = BRep_Tool::Parameter(V, E);
+  const bool   atLast = std::abs(tV - l) < std::abs(tV - f);
+  // The parameter of P on the curve, beyond V.
+  GeomAPI_ProjectPointOnCurve aProj(P, C);
+  if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+  {
+    return false;
+  }
+  double tP = aProj.LowerDistanceParameter();
+  if (C->IsPeriodic())
+  {
+    const double T = C->Period();
+    tP             = atLast ? ElCLib::InPeriod(tP, l, l + T) : ElCLib::InPeriod(tP, f - T, f);
+  }
+  if ((atLast ? tP <= tV : tP >= tV)
+      || (!C->IsPeriodic() && (tP < C->FirstParameter() || tP > C->LastParameter())))
+  {
+    return false;
+  }
+  // The p-curves, defined at tP.
+  double                    u1 = 0., u2 = 0.;
+  occ::handle<Geom2d_Curve> pcOp =
+    BRep_Tool::CurveOnSurface(TopoDS::Edge(E.Oriented(OonFop)), Fop, u1, u2);
+  occ::handle<Geom2d_Curve> pcV = BRep_Tool::CurveOnSurface(E, Fv, u1, u2);
+  if (pcOp.IsNull() || pcV.IsNull())
+  {
+    return false;
+  }
+  for (occ::handle<Geom2d_Curve>* pc : {&pcOp, &pcV})
+  {
+    const occ::handle<Geom2d_TrimmedCurve> aTr2 = occ::down_cast<Geom2d_TrimmedCurve>(*pc);
+    if (!aTr2.IsNull())
+    {
+      *pc = aTr2->BasisCurve();
+    }
+    if (!(*pc)->IsPeriodic() && (tP < (*pc)->FirstParameter() || tP > (*pc)->LastParameter()))
+    {
+      return false;
+    }
+  }
+  const double t1 = atLast ? tV : tP;
+  const double t2 = atLast ? tP : tV;
+  C3d             = new Geom_TrimmedCurve(C, t1, t2);
+  PcOp            = new Geom2d_TrimmedCurve(pcOp, t1, t2);
+  PcV             = new Geom2d_TrimmedCurve(pcV, t1, t2);
+  if (!atLast)
+  {
+    // From V to P: reversed, the p-curves parametrized as the 3d curve.
+    C3d->Reverse();
+    PcOp->Reverse();
+    PcV->Reverse();
+    PcOp = Geom2dConvert::CurveToBSplineCurve(PcOp);
+    PcV  = Geom2dConvert::CurveToBSplineCurve(PcV);
+    ChFi3d_ReparamPcurv(C3d->FirstParameter(), C3d->LastParameter(), PcOp);
+    ChFi3d_ReparamPcurv(C3d->FirstParameter(), C3d->LastParameter(), PcV);
+  }
+  tolreached =
+    std::max(BRep_Tool::Tolerance(E), ChFi3d_EvalTolReached(HSop, PcOp, HSv, PcV, C3d));
+  return true;
+}
