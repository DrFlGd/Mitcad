+//=======================================================================
+// function : cherche_edge1
+// purpose  : find the common edge of faces F1 and F2 at vertex V: two faces
+//            may share several edges (the two ends of a groove, a line
+//            broken by a notch), and a walk round a vertex needs the one
+//            where it stands; any common edge where none passes V
+//=======================================================================
+
+static void cherche_edge1(const TopoDS_Face&   F1,
+                          const TopoDS_Face&   F2,
+                          const TopoDS_Vertex& V,
+                          TopoDS_Edge&         Edge)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> MapE2;
+  TopExp::MapShapes(F2, TopAbs_EDGE, MapE2);
+  for (TopExp_Explorer ex(F1, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (!MapE2.Contains(E))
+    {
+      continue;
+    }
+    TopoDS_Vertex Vf, Vl;
+    TopExp::Vertices(E, Vf, Vl);
+    if (Vf.IsSame(V) || Vl.IsSame(V))
+    {
+      Edge = E;
+      return;
+    }
+  }
+  cherche_edge1(F1, F2, Edge);
+}
