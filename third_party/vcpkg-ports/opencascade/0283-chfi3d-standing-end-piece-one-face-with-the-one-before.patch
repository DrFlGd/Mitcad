+//=======================================================================
+// function : ChFi3d_JoinStandingEnd
+// purpose  : A stripe's end piece whose contact on one face stands still
+//            (an analytic blend run on past the end of that contact, along
+//            the next edge of the spine, for the corner to cut) continues
+//            the blend of the piece before it where both lie on one surface:
+//            it takes that piece's surface, its parameters mapped onto it,
+//            and the blend is one face up to the corner, as one piece is.
+//=======================================================================
+
+static void ChFi3d_JoinStandingEnd(TopOpeBRepDS_DataStructure&       DStr,
+                                   const occ::handle<ChFiDS_Stripe>& Stripe,
+                                   const double                      tol3d)
+{
+  if (Stripe->SetOfSurfData().IsNull())
+  {
+    return;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq =
+    Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  for (int iEnd = 0; iEnd < 2 && aSeq.Length() >= 2; iEnd++)
+  {
+    const bool                          isFirst = iEnd == 0;
+    const occ::handle<ChFiDS_SurfData>& Q       = isFirst ? aSeq.First() : aSeq.Last();
+    const occ::handle<ChFiDS_SurfData>& P = isFirst ? aSeq.Value(2) : aSeq.Value(aSeq.Length() - 1);
+    if (Q->Surf() == P->Surf() || Q->IndexOfS1() != P->IndexOfS1()
+        || Q->IndexOfS2() != P->IndexOfS2() || Q->Orientation() != P->Orientation())
+    {
+      continue;
+    }
+    // (The side whose contact moves on the end piece, the other's standing.)
+    int aMoving = 0;
+    for (int s = 1; s <= 2; s++)
+    {
+      const ChFiDS_FaceInterference& Fs = Q->Interference(s);
+      const ChFiDS_FaceInterference& Fo = Q->Interference(3 - s);
+      if (std::abs(Fs.LastParameter() - Fs.FirstParameter()) <= Precision::PConfusion()
+          && std::abs(Fo.LastParameter() - Fo.FirstParameter()) > Precision::PConfusion())
+      {
+        aMoving = 3 - s;
+      }
+    }
+    if (aMoving == 0 || Q->Interference(aMoving).PCurveOnSurf().IsNull()
+        || P->Interference(aMoving).PCurveOnSurf().IsNull())
+    {
+      continue;
+    }
+    // The pieces meet in a whole section: the end piece's side toward the
+    // other is that piece's side toward it.
+    const bool qFirst = !isFirst;
+    bool       aMeet  = true;
+    for (int s = 1; s <= 2 && aMeet; s++)
+    {
+      aMeet = Q->Vertex(qFirst, s).Point().Distance(P->Vertex(!qFirst, s).Point()) <= tol3d;
+    }
+    if (!aMeet)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Surface>& SurfQ = DStr.Surface(Q->Surf()).Surface();
+    const occ::handle<Geom_Surface>& SurfP = DStr.Surface(P->Surf()).Surface();
+    const ChFiDS_FaceInterference&   FQ    = Q->Interference(aMoving);
+    const ChFiDS_FaceInterference&   FP    = P->Interference(aMoving);
+    gp_Trsf2d                        aT;
+    bool                             aFlip = false;
+    const bool                       aSame = ChFi3d_SameAnalyticSurface(SurfQ, SurfP);
+    if (!aSame
+        && (!ChFi3d_AnalyticParamMap(SurfQ,
+                                     SurfP,
+                                     FQ.PCurveOnSurf()->Value(FQ.Parameter(qFirst)),
+                                     FP.PCurveOnSurf()->Value(FP.Parameter(!qFirst)),
+                                     tol3d,
+                                     aT,
+                                     aFlip)
+            || aFlip))
+    {
+      continue;
+    }
+    Q->ChangeSurf(P->Surf());
+    if (aSame)
+    {
+      continue;
+    }
+    for (int s = 1; s <= 2; s++)
+    {
+      occ::handle<Geom2d_Curve>& aPC = Q->ChangeInterference(s).ChangePCurveOnSurf();
+      if (!aPC.IsNull())
+      {
+        aPC = occ::down_cast<Geom2d_Curve>(aPC->Transformed(aT));
+      }
+    }
+    gp_Pnt2d p[4];
+    Q->Get2dPoints(p[0], p[1], p[2], p[3]);
+    for (gp_Pnt2d& q : p)
+    {
+      q.Transform(aT);
+    }
+    Q->Set2dPoints(p[0], p[1], p[2], p[3]);
+  }
+}
