+static bool ChFi3d_AnalyticParamMap(const occ::handle<Geom_Surface>& S1,
+                                    const occ::handle<Geom_Surface>& S2,
+                                    const gp_Pnt2d&                  uv1,
+                                    const gp_Pnt2d&                  uv2,
