+//=======================================================================
+// function : ChFi3d_FacesBetweenAtVertex
+// purpose  : the faces round vertex V from face Fa to face Fb on the side
+//            away from face Fw, and the edges between them in that order
+//            (Edges has one item more than Faces): the walk round a
+//            corner's vertex steps from the face across one edge of Fw at
+//            V to the face across the next, which share an edge there
+//            where three faces meet; where more meet, faces lie between
+//            them. False where Fa and Fb share an edge at V, or no such
+//            chain of faces leads from Fa to Fb.
+//=======================================================================
+
+static bool ChFi3d_FacesBetweenAtVertex(const TopoDS_Vertex&                 V,
+                                        const TopoDS_Face&                   Fa,
+                                        const TopoDS_Face&                   Fb,
+                                        const TopoDS_Face&                   Fw,
+                                        const ChFiDS_Map&                    VEMap,
+                                        const ChFiDS_Map&                    EFMap,
+                                        NCollection_Sequence<TopoDS_Shape>& Edges,
+                                        NCollection_Sequence<TopoDS_Shape>& Faces)
+{
+  Edges.Clear();
+  Faces.Clear();
+  if (!VEMap.Contains(V))
+  {
+    return false;
+  }
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aVisited;
+  aVisited.Add(Fw);
+  aVisited.Add(Fa);
+  TopoDS_Face aCur = Fa;
+  for (int iStep = 0; iStep < 16; iStep++)
+  {
+    // The edge of the current face at V to Fb, or else the one that leads
+    // to a face not passed (one face only: the faces round V make one
+    // chain away from Fw).
+    TopoDS_Edge aNextE, anEdgeToFb;
+    TopoDS_Face aNextF;
+    bool        isAmbiguous = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(V)); itE.More(); itE.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(itE.Value());
+      if (BRep_Tool::Degenerated(anE) || !EFMap.Contains(anE))
+      {
+        continue;
+      }
+      bool        isOfCur = false;
+      TopoDS_Face anOther;
+      for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(anE)); itF.More(); itF.Next())
+      {
+        if (itF.Value().IsSame(aCur))
+        {
+          isOfCur = true;
+        }
+        else
+        {
+          anOther = TopoDS::Face(itF.Value());
+        }
+      }
+      if (!isOfCur || anOther.IsNull())
+      {
+        continue;
+      }
+      if (anOther.IsSame(Fb))
+      {
+        anEdgeToFb = anE;
+      }
+      else if (aVisited.Contains(anOther) || (!aNextF.IsNull() && anOther.IsSame(aNextF)))
+      {
+        continue;
+      }
+      else if (!aNextF.IsNull())
+      {
+        isAmbiguous = true;
+      }
+      else
+      {
+        aNextE = anE;
+        aNextF = anOther;
+      }
+    }
+    if (!anEdgeToFb.IsNull())
+    {
+      if (iStep == 0)
+      {
+        return false; // Fa and Fb share an edge at V
+      }
+      Edges.Append(anEdgeToFb);
+      return true;
+    }
+    if (aNextF.IsNull() || isAmbiguous)
+    {
+      return false;
+    }
+    Edges.Append(aNextE);
+    Faces.Append(aNextF);
+    aVisited.Add(aNextF);
+    aCur = aNextF;
+  }
+  return false;
+}
