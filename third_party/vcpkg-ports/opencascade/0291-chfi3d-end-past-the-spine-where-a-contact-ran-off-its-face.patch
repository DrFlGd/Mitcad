+//=======================================================================
+// function : ChFi3d_ExtensionOnNeighbourSurface
+// purpose  : A stripe's end piece walked past the spine's end whose contact
+//            on one side ran off its face (that side given up, ChFi3d_Purge)
+//            continues the elementary blend of the piece before it where it
+//            lies on that blend's surface (the given-up side on the plane of
+//            its face, the other side on the same face): it takes that
+//            surface, its p-curves projected onto it, so that the blend runs
+//            on exactly up to where the corner cuts it, as one face.
+//=======================================================================
+
+static void ChFi3d_ExtensionOnNeighbourSurface(TopOpeBRepDS_DataStructure&       DStr,
+                                               const occ::handle<ChFiDS_Stripe>& Stripe,
+                                               const double                      tol3d)
+{
+  if (Stripe->SetOfSurfData().IsNull())
+  {
+    return;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq =
+    Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  for (int iEnd = 0; iEnd < 2 && aSeq.Length() >= 2; iEnd++)
+  {
+    const bool                          isFirst = iEnd == 0;
+    const occ::handle<ChFiDS_SurfData>& Q       = isFirst ? aSeq.First() : aSeq.Last();
+    const occ::handle<ChFiDS_SurfData>& P = isFirst ? aSeq.Value(2) : aSeq.Value(aSeq.Length() - 1);
+    int aGivenUp = 0;
+    for (int s = 1; s <= 2; s++)
+    {
+      if (Q->Index(s) == 0 && Q->Index(3 - s) > 0 && P->Index(s) > 0 && Q->Index(3 - s) == P->Index(3 - s))
+      {
+        aGivenUp = s;
+      }
+    }
+    if (aGivenUp == 0 || Q->Surf() == P->Surf() || Q->IsOnCurve1() || Q->IsOnCurve2())
+    {
+      continue;
+    }
+    const int                        aKept = 3 - aGivenUp;
+    const occ::handle<Geom_Surface>& SurfQ = DStr.Surface(Q->Surf()).Surface();
+    const occ::handle<Geom_Surface>& SurfP = DStr.Surface(P->Surf()).Surface();
+    const GeomAdaptor_Surface        aP(SurfP);
+    if (SurfQ.IsNull() || SurfP.IsNull()
+        || (aP.GetType() != GeomAbs_Cylinder && aP.GetType() != GeomAbs_Cone
+            && aP.GetType() != GeomAbs_Sphere && aP.GetType() != GeomAbs_Torus))
+    {
+      continue;
+    }
+    const ChFiDS_FaceInterference& FK = Q->Interference(aKept);
+    const ChFiDS_FaceInterference& FG = Q->Interference(aGivenUp);
+    if (FK.LineIndex() <= 0 || FK.PCurveOnSurf().IsNull() || FG.PCurveOnSurf().IsNull())
+    {
+      continue;
+    }
+    // Q's surface on P's: its points between the kept contact and the
+    // given-up side's point, at the kept contact's ends and middle.
+    const occ::handle<Geom_Curve>& CK   = DStr.Curve(FK.LineIndex()).Curve();
+    const gp_Pnt2d                 aUVG = FG.PCurveOnSurf()->Value(FG.Parameter(isFirst));
+    bool                           isOn = true;
+    for (int i = 0; i <= 4 && isOn; i++)
+    {
+      const double   t   = FK.FirstParameter() + (FK.LastParameter() - FK.FirstParameter()) * i / 4.;
+      const gp_Pnt2d aUVK = FK.PCurveOnSurf()->Value(t);
+      for (int j = 0; j <= 4 && isOn; j++)
+      {
+        const gp_Pnt2d aUV(aUVK.X() + (aUVG.X() - aUVK.X()) * j / 4., aUVK.Y() + (aUVG.Y() - aUVK.Y()) * j / 4.);
+        GeomAPI_ProjectPointOnSurf aPr(SurfQ->Value(aUV.X(), aUV.Y()), SurfP);
+        isOn = aPr.NbPoints() > 0 && aPr.LowerDistance() <= 10. * tol3d;
+      }
+    }
+    if (!isOn)
+    {
+      continue;
+    }
+    // (The two blends' sides of the solid the same: where their surfaces'
+    // normals are opposite, their orientations are.)
+    {
+      const gp_Pnt2d aUVK = FK.PCurveOnSurf()->Value(0.5 * (FK.FirstParameter() + FK.LastParameter()));
+      gp_Pnt         aQ;
+      gp_Vec         aQu, aQv;
+      SurfQ->D1(aUVK.X(), aUVK.Y(), aQ, aQu, aQv);
+      GeomAPI_ProjectPointOnSurf aPr(aQ, SurfP);
+      if (aPr.NbPoints() == 0)
+      {
+        continue;
+      }
+      double u = 0., v = 0.;
+      aPr.LowerDistanceParameters(u, v);
+      gp_Pnt aPt;
+      gp_Vec aPu, aPv;
+      SurfP->D1(u, v, aPt, aPu, aPv);
+      const bool isOpposite = aQu.Crossed(aQv).Dot(aPu.Crossed(aPv)) < 0.;
+      if (isOpposite == (Q->Orientation() == P->Orientation()))
+      {
+        continue;
+      }
+    }
+    // The kept contact's p-curve on P's surface, and the given-up side's
+    // point there (a line of no length at its parameter).
+    occ::handle<Geom2d_Curve> aPCK;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      aPCK = GeomProjLib::Curve2d(CK, FK.FirstParameter(), FK.LastParameter(), SurfP);
+    }
+    catch (Standard_Failure const&)
+    {
+      aPCK.Nullify();
+    }
+    GeomAPI_ProjectPointOnSurf aPrG(SurfQ->Value(aUVG.X(), aUVG.Y()), SurfP);
+    if (aPCK.IsNull() || aPrG.NbPoints() == 0)
+    {
+      continue;
+    }
+    double uG = 0., vG = 0.;
+    aPrG.LowerDistanceParameters(uG, vG);
+    // (In the periods of the kept contact's p-curve at that end.)
+    const gp_Pnt2d aUVKEnd = aPCK->Value(FK.Parameter(!isFirst));
+    if (SurfP->IsUPeriodic())
+    {
+      uG = ElCLib::InPeriod(uG, aUVKEnd.X() - 0.5 * SurfP->UPeriod(), aUVKEnd.X() + 0.5 * SurfP->UPeriod());
+    }
+    if (SurfP->IsVPeriodic())
+    {
+      vG = ElCLib::InPeriod(vG, aUVKEnd.Y() - 0.5 * SurfP->VPeriod(), aUVKEnd.Y() + 0.5 * SurfP->VPeriod());
+    }
+    const double              tG   = FG.Parameter(isFirst);
+    occ::handle<Geom2d_Curve> aPCG = new Geom2d_Line(gp_Pnt2d(uG - tG, vG), gp_Dir2d(1., 0.));
+    Q->ChangeSurf(P->Surf());
+    Q->ChangeOrientation()                               = P->Orientation();
+    Q->ChangeInterference(aKept).ChangePCurveOnSurf()    = aPCK;
+    Q->ChangeInterference(aGivenUp).ChangePCurveOnSurf() = aPCG;
+    // (First on 1, last on 1, first on 2, last on 2.)
+    const ChFiDS_FaceInterference& F1 = Q->Interference(1);
+    const ChFiDS_FaceInterference& F2 = Q->Interference(2);
+    Q->Set2dPoints(F1.PCurveOnSurf()->Value(F1.FirstParameter()),
+                   F1.PCurveOnSurf()->Value(F1.LastParameter()),
+                   F2.PCurveOnSurf()->Value(F2.FirstParameter()),
+                   F2.PCurveOnSurf()->Value(F2.LastParameter()));
+  }
+}
