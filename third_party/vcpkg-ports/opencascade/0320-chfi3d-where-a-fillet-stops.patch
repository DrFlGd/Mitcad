   Standard_EXPORT ChFiDS_ErrorStatus StripeStatus(const int IC) const;
 
+  //! Where the computation stopped when it is not done: a contour's blend
+  //! (no start, a walk between two faces or rolling on an edge, a twisted
+  //! surface, another failure), blends of contours overlapping or crossing
+  //! on a face computed again, blends of two contours intersecting each
+  //! other, a corner, or a corner built in part only.
+  ChFi3d_Builder::FailureKind Failure() const { return myBuilder.Failure(); }
+
+  //! The contour (its index IC) the computation stopped at; 0 for none or
+  //! a corner.
+  int FailedContour() const { return myBuilder.FailedContour(); }
+
