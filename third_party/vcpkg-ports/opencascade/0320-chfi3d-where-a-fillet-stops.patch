+int ChFi3d_Builder::FailedContour() const
+{
+  if (myFailedStripe.IsNull())
+  {
+    return 0;
+  }
+  int k = 0;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itel(myListStripe); itel.More();
+       itel.Next())
+  {
+    k += 1;
+    if (itel.Value() == myFailedStripe)
+    {
+      return k;
+    }
+  }
+  return 0;
+}
