@@ -3442,6 +3442,12 @@ void ChFi3d_ContactsAlongFaceEdges(TopOpeBRepDS_DataStructure&       DStr,
         // A contact along a whole open edge: its ends, not on an arc, at
         // the edge's vertices are those vertices (where the spine's edges
         // meet, a contact along a line and an arc of one face's boundary).
+        // Where such an end is the start or the end of a closed stripe
+        // (the contacts of a closed contour of several edges run along the
+        // edges of a face they consume all round), the stripe's point there
+        // is that vertex too: the point the stripe had made for its start
+        // stood beside the vertex, and the topological build failed on the
+        // two (TopoDS_Builder::Add).
         for (const bool isFirst : {true, false})
         {
           ChFiDS_CommonPoint& CP = Fd->ChangeVertex(isFirst, ons);
@@ -3454,6 +3460,11 @@ void ChFi3d_ContactsAlongFaceEdges(TopOpeBRepDS_DataStructure&       DStr,
             if (CP.Point().Distance(BRep_Tool::Pnt(aV)) <= Tol3d + BRep_Tool::Tolerance(aV))
             {
               CP.SetVertex(aV);
+              if ((aSpine->IsPeriodic() || aSpine->IsClosed())
