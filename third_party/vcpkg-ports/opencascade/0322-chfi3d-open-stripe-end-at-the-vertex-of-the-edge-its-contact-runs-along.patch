+// The stripe's end on side ons (its start with isFirst), a point of the DS
+// until now, is the vertex V: the stripe's index there becomes V's, and
+// whatever the DS has already put at that point (the end's or a corner's
+// curves and edges) is put at V. ChFi3d_FilDS takes the kind of the
+// stripe's index there from its common point, now a vertex: with the
+// point's index it read a shape of the DS that is no vertex as one (a
+// solid's or a face's TShape, past its end), and with the point kept the
+// curves met at a point beside the vertex (TopoDS_Builder::Add).
+static void ChFi3d_StripeEndAtVertex(TopOpeBRepDS_DataStructure&       DStr,
+                                     const occ::handle<ChFiDS_Stripe>& CorDat,
+                                     const bool                        isFirst,
+                                     const int                         ons,
+                                     const TopoDS_Vertex&              V)
+{
+  const int aPoint  = CorDat->IndexPoint(isFirst, ons);
+  const int aVertex = DStr.AddShape(V);
+  CorDat->SetIndexPoint(aVertex, isFirst, ons);
+  if (aPoint <= 0)
+  {
+    return;
+  }
+  const auto toVertex = [aPoint, aVertex](NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& LI) {
+    for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(LI); it.More(); it.Next())
+    {
+      const occ::handle<TopOpeBRepDS_Interference>& I = it.Value();
+      if (I->GeometryType() == TopOpeBRepDS_POINT && I->Geometry() == aPoint)
+      {
+        I->GeometryType(TopOpeBRepDS_VERTEX);
+        I->Geometry(aVertex);
+      }
+    }
+  };
+  for (int ic = 1; ic <= DStr.NbCurves(); ic++)
+  {
+    toVertex(DStr.ChangeCurveInterferences(ic));
+  }
+  for (int is = 1; is <= DStr.NbShapes(); is++)
+  {
+    toVertex(DStr.ChangeShapeInterferences(is));
+  }
+}
