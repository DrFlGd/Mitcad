+//=======================================================================
+// function : ChFi3d_RolledEndOnItsFace
+// purpose  : OnSame end of a SurfData whose blend rolls, on side IRolled,
+//            on an edge Er of its face Fr that runs to the corner's vertex
+//            Vtx (a rounding wider than the face at the end, rolling on
+//            that face's edge with Fr): the ball leaves Er where it comes
+//            tangent to Fr's surface, and the SurfData ends there. Fr's
+//            surface then cuts the blend from that point to the other
+//            contact, Fr's edge at Vtx with the other side's face
+//            prolonged to it.
+//=======================================================================
+
+static bool ChFi3d_RolledEndOnItsFace(const TopOpeBRepDS_DataStructure&   DStr,
+                                      const occ::handle<ChFiDS_SurfData>& Fd,
+                                      const bool                          isfirst,
+                                      const TopoDS_Vertex&                Vtx,
+                                      int&                                IRolled,
+                                      TopoDS_Edge&                        Er,
+                                      double&                             wEr)
+{
+  IRolled = 0;
+  for (int s = 1; s <= 2 && IRolled == 0; s++)
+  {
+    if (!Fd->IsOnCurve(s) || Fd->IndexOfC(s) <= 0 || Fd->Index(s) <= 0 || Fd->Index(3 - s) <= 0)
+    {
+      continue;
+    }
+    const TopoDS_Edge& E = TopoDS::Edge(DStr.Shape(Fd->IndexOfC(s)));
+    const TopoDS_Face& F = TopoDS::Face(DStr.Shape(Fd->Index(s)));
+    bool               atV = false, onF = false;
+    for (TopExp_Explorer ex(E, TopAbs_VERTEX); ex.More() && !atV; ex.Next())
+    {
+      atV = ex.Current().IsSame(Vtx);
+    }
+    for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More() && !onF; ex.Next())
+    {
+      onF = ex.Current().IsSame(E);
+    }
+    if (!atV || !onF)
+    {
+      continue;
+    }
+    // The ball at the end comes tangent to F at its point on E: the blend's
+    // normal there is along F's normal.
+    const ChFiDS_FaceInterference& Fi = Fd->Interference(s);
+    if (Fi.PCurveOnSurf().IsNull() || Fi.PCurveOnFace().IsNull())
+    {
+      continue;
+    }
+    const double                     t  = Fi.Parameter(isfirst);
+    const occ::handle<Geom_Surface>& SB = DStr.Surface(Fd->Surf()).Surface();
+    const gp_Pnt2d                   uvB = Fi.PCurveOnSurf()->Value(t);
+    const gp_Pnt2d                   uvF = Fi.PCurveOnFace()->Value(t);
+    gp_Pnt                           pB, pF;
+    gp_Vec                           duB, dvB, duF, dvF;
+    SB->D1(uvB.X(), uvB.Y(), pB, duB, dvB);
+    BRepAdaptor_Surface aF(F, false);
+    aF.D1(uvF.X(), uvF.Y(), pF, duF, dvF);
+    gp_Vec nB = duB.Crossed(dvB), nF = duF.Crossed(dvF);
+    if (nB.Magnitude() < gp::Resolution() || nF.Magnitude() < gp::Resolution())
+    {
+      continue;
+    }
+    const double anAngle = nB.Angle(nF);
+    if (std::min(anAngle, M_PI - anAngle) > 0.05 || pB.Distance(pF) > 1.e-4)
+    {
+      continue;
+    }
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CE = BRep_Tool::Curve(E, f, l);
+    if (CE.IsNull())
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnCurve aPr(pB, CE, f, l);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 1.e-4)
+    {
+      continue;
+    }
+    IRolled = s;
+    Er      = E;
+    wEr     = aPr.LowerDistanceParameter();
+  }
+  return IRolled != 0;
+}
+
