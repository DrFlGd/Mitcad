+// Whether the ball of SD, rolling on side S on an edge of face F, is tangent
+// to F at SD's end (its first end if isFirst): the blend's normal at its
+// contact there along F's normal.
+static bool ChFi3d_RolledBallTangentAtEnd(const TopOpeBRepDS_DataStructure&   DStr,
+                                          const occ::handle<ChFiDS_SurfData>& SD,
+                                          const int                           S,
+                                          const TopoDS_Face&                  F,
+                                          const bool                          isFirst,
+                                          const double                        theAngTol)
+{
+  const ChFiDS_FaceInterference& Fi = SD->Interference(S);
+  if (Fi.PCurveOnSurf().IsNull() || Fi.PCurveOnFace().IsNull() || SD->Surf() <= 0)
+  {
+    return false;
+  }
+  const double                     t   = Fi.Parameter(isFirst);
+  const occ::handle<Geom_Surface>& SB  = DStr.Surface(SD->Surf()).Surface();
+  const gp_Pnt2d                   uvB = Fi.PCurveOnSurf()->Value(t);
+  const gp_Pnt2d                   uvF = Fi.PCurveOnFace()->Value(t);
+  gp_Pnt                           pB, pF;
+  gp_Vec                           duB, dvB, duF, dvF;
+  SB->D1(uvB.X(), uvB.Y(), pB, duB, dvB);
+  BRepAdaptor_Surface aF(F, false);
+  aF.D1(uvF.X(), uvF.Y(), pF, duF, dvF);
+  const gp_Vec nB = duB.Crossed(dvB), nF = duF.Crossed(dvF);
+  if (nB.Magnitude() < gp::Resolution() || nF.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const double a = nB.Angle(nF);
+  return std::min(a, M_PI - a) <= theAngTol && pB.Distance(pF) <= 1.e-4;
+}
