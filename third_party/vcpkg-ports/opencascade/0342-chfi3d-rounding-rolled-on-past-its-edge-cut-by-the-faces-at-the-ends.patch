+//=======================================================================
+// function : ChFi3d_RolledPastEdgeVertex
+// purpose  : End of a SurfData whose blend rolls, on side IRolled, on an
+//            edge Er of its face B prolonged past Er's vertex A
+//            (RolledOnProlongedEdge), where A lies on a face W that holds
+//            the corner's vertex Vtx: W cuts the blend from A. Gives A, W,
+//            the edge Ebw of B and W at A, the face Fref across Er from B
+//            (the top the blend consumes) and the parameter tA of the
+//            contact on side IRolled at A.
+//=======================================================================
+
+static bool ChFi3d_RolledPastEdgeVertex(const TopOpeBRepDS_DataStructure&   DStr,
+                                        const occ::handle<ChFiDS_SurfData>& Fd,
+                                        const bool                          isfirst,
+                                        const TopoDS_Vertex&                Vtx,
+                                        const ChFiDS_Map&                   VEMap,
+                                        const ChFiDS_Map&                   EFMap,
+                                        int&                                IRolled,
+                                        TopoDS_Vertex&                      A,
+                                        TopoDS_Face&                        W,
+                                        TopoDS_Edge&                        Ebw,
+                                        TopoDS_Face&                        Fref,
+                                        double&                             tA)
+{
+  IRolled = 0;
+  for (int s = 1; s <= 2 && IRolled == 0; s++)
+  {
+    if (!Fd->IsOnCurve(s) || Fd->IndexOfC(s) <= 0 || Fd->Index(s) <= 0 || Fd->Index(3 - s) <= 0
+        || Fd->Vertex(isfirst, s).IsOnArc())
+    {
+      continue;
+    }
+    const TopoDS_Edge& Er = TopoDS::Edge(DStr.Shape(Fd->IndexOfC(s)));
+    const TopoDS_Face& B  = TopoDS::Face(DStr.Shape(Fd->Index(s)));
+    const TopoDS_Face& N  = TopoDS::Face(DStr.Shape(Fd->Index(3 - s)));
+    if (!EFMap.Contains(Er))
+    {
+      continue;
+    }
+    bool atVtx = false;
+    for (TopExp_Explorer ex(Er, TopAbs_VERTEX); ex.More() && !atVtx; ex.Next())
+    {
+      atVtx = ex.Current().IsSame(Vtx);
+    }
+    if (atVtx)
+    {
+      continue;
+    }
+    Fref.Nullify();
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Er)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(B))
+      {
+        Fref = TopoDS::Face(it.Value());
+      }
+    }
+    // (The contact passes Er's vertex nearer its end.)
+    const ChFiDS_FaceInterference& Fi = Fd->Interference(s);
+    if (Fref.IsNull() || Fi.LineIndex() <= 0)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Curve>& C = DStr.Curve(Fi.LineIndex()).Curve();
+    if (C.IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt  pEnd = Fd->Vertex(isfirst, s).Point();
+    TopoDS_Vertex V1 = TopExp::FirstVertex(Er), V2 = TopExp::LastVertex(Er);
+    A = BRep_Tool::Pnt(V1).Distance(pEnd) < BRep_Tool::Pnt(V2).Distance(pEnd) ? V1 : V2;
+    const double f = std::min(Fi.FirstParameter(), Fi.LastParameter());
+    const double l = std::max(Fi.FirstParameter(), Fi.LastParameter());
+    GeomAPI_ProjectPointOnCurve aPr(BRep_Tool::Pnt(A), C, f, l);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > std::max(1.e-4, BRep_Tool::Tolerance(A)))
+    {
+      continue;
+    }
+    tA = aPr.LowerDistanceParameter();
+    // W: a face at A and at Vtx other than B, Fref and N; Ebw: B's edge with W at A.
+    W.Nullify();
+    Ebw.Nullify();
+    if (!VEMap.Contains(A))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(A)); itE.More() && Ebw.IsNull(); itE.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+      if (E.IsSame(Er) || BRep_Tool::Degenerated(E) || !EFMap.Contains(E))
+      {
+        continue;
+      }
+      bool onB = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More(); itF.Next())
+      {
+        onB = onB || itF.Value().IsSame(B);
+      }
+      if (!onB)
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More() && Ebw.IsNull(); itF.Next())
+      {
+        const TopoDS_Face& F = TopoDS::Face(itF.Value());
+        if (F.IsSame(B) || F.IsSame(Fref) || F.IsSame(N))
+        {
+          continue;
+        }
+        bool hasVtx = false;
+        for (TopExp_Explorer ex(F, TopAbs_VERTEX); ex.More() && !hasVtx; ex.Next())
+        {
+          hasVtx = ex.Current().IsSame(Vtx);
+        }
+        if (hasVtx)
+        {
+          W   = F;
+          Ebw = E;
+        }
+      }
+    }
+    if (!Ebw.IsNull())
+    {
+      IRolled = s;
+    }
+  }
+  return IRolled != 0;
+}
