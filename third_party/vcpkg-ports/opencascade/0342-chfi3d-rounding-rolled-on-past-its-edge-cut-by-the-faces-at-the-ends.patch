+//=======================================================================
+// function : PerformRolledPastEnd
+// purpose  : The end of a lone stripe at a vertex of more than three edges
+//            where its blend rolls on an edge prolonged past the edge's
+//            vertex, which lies on a face at the end holding the vertex
+//            (ChFi3d_RolledPastEdgeVertex): the corner is that of an OnSame
+//            end (PerformOneCorner). Returns false for other ends.
+//=======================================================================
+
+bool ChFi3d_Builder::PerformRolledPastEnd(const int Index)
+{
+  if (myVDataMap(Index).Extent() != 1)
+  {
+    return false;
+  }
+  const TopoDS_Vertex&              Vtx    = myVDataMap.FindKey(Index);
+  const occ::handle<ChFiDS_Stripe>& stripe = myVDataMap(Index).First();
+  if (stripe.IsNull() || stripe->SetOfSurfData().IsNull() || stripe->SetOfSurfData()->IsEmpty())
+  {
+    return false;
+  }
+  int        sens    = 0;
+  const int  num     = ChFi3d_IndexOfSurfData(Vtx, stripe, sens);
+  const bool isfirst = (sens == 1);
+  if (num < 1 || num > stripe->SetOfSurfData()->Length()
+      || (isfirst ? stripe->Spine()->FirstStatus() : stripe->Spine()->LastStatus()) != ChFiDS_BreakPoint)
+  {
+    return false;
+  }
+  int           IRolled = 0;
+  TopoDS_Vertex A;
+  TopoDS_Face   W, Fref;
+  TopoDS_Edge   Ebw;
+  double        tA = 0.;
+  if (!ChFi3d_RolledPastEdgeVertex(myDS->DS(),
+                                   stripe->SetOfSurfData()->Value(num),
+                                   isfirst,
+                                   Vtx,
+                                   myVEMap,
+                                   myEFMap,
+                                   IRolled,
+                                   A,
+                                   W,
+                                   Ebw,
+                                   Fref,
+                                   tA))
+  {
+    return false;
+  }
+  PerformOneCorner(Index);
+  return true;
+}
