+//=======================================================================
+// function : ChFi3d_CurveFromVertexToContact
+// purpose  : OnSame end rolled past the vertex A of the edge the blend
+//            rolls on (ChFi3d_RolledPastEdgeVertex), where the face at the
+//            end Fv and the opposite face Fop meet at the corner's vertex
+//            Vtx only (another face between them there): Fv grows up to
+//            the cap and meets Fop from Vtx to the end of the opposite
+//            contact (point icc), in their intersection. Fv keeps the side
+//            of the curve towards A (its part grown up to the cap), Fop the
+//            side away from the contact (its part beside it lies under the
+//            blend).
+//=======================================================================
+
+static void ChFi3d_CurveFromVertexToContact(TopOpeBRepDS_DataStructure&             DStr,
+                                            const occ::handle<ChFiDS_SurfData>&     Fd,
+                                            const bool                              isfirst,
+                                            const int                               IFopArc,
+                                            const TopoDS_Vertex&                    Vtx,
+                                            const TopoDS_Vertex&                    A,
+                                            const TopoDS_Face&                      Fv,
+                                            const TopoDS_Face&                      Fop,
+                                            const occ::handle<BRepAdaptor_Surface>& HBs,
+                                            const occ::handle<BRepAdaptor_Surface>& HBop,
+                                            const gp_Pnt2d&                         p2dbout,
+                                            const int                               icc,
+                                            const int                               IShape,
+                                            const double                            tol3d,
+                                            const double                            tol2d,
+                                            Bnd_Box&                                box)
+{
+  const ChFiDS_FaceInterference& Fiop = Fd->Interference(IFopArc);
+  if (Fiop.PCurveOnFace().IsNull())
+  {
+    throw Standard_ConstructionError("OneCorner : contact without a curve on the opposite face");
+  }
+  // A point's parameters on a face's surface, in the periods about a point near.
+  const auto onSurface = [](const gp_Pnt& P, const TopoDS_Face& F, const gp_Pnt2d& Near) {
+    const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+    GeomAPI_ProjectPointOnSurf      aPr(P, S);
+    if (aPr.NbPoints() == 0)
+    {
+      throw Standard_Failure("OneCorner : point not on the face at the end");
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    if (S->IsUPeriodic())
+    {
+      u = ElCLib::InPeriod(u, Near.X() - 0.5 * S->UPeriod(), Near.X() + 0.5 * S->UPeriod());
+    }
+    if (S->IsVPeriodic())
+    {
+      v = ElCLib::InPeriod(v, Near.Y() - 0.5 * S->VPeriod(), Near.Y() + 0.5 * S->VPeriod());
+    }
+    return gp_Pnt2d(u, v);
+  };
+  const gp_Pnt   PV   = BRep_Tool::Pnt(Vtx);
+  const gp_Pnt2d pop2 = Fiop.PCurveOnFace()->Value(Fiop.Parameter(isfirst));
+  const gp_Pnt2d pv2  = p2dbout;
+  const gp_Pnt2d pop1 = onSurface(PV, Fop, pop2);
+  const gp_Pnt2d pv1  = onSurface(PV, Fv, pv2);
+  NCollection_Array1<double> Pardeb(1, 4), Parfin(1, 4);
+  Pardeb(1) = pop1.X();
+  Pardeb(2) = pop1.Y();
+  Pardeb(3) = pv1.X();
+  Pardeb(4) = pv1.Y();
+  Parfin(1) = pop2.X();
+  Parfin(2) = pop2.Y();
+  Parfin(3) = pv2.X();
+  Parfin(4) = pv2.Y();
+  double uu1, uu2, vv1, vv2;
+  ChFi3d_Boite(pv1, pv2, uu1, uu2, vv1, vv2);
+  ChFi3d_BoundFac(*HBs, uu1, uu2, vv1, vv2);
+  ChFi3d_Boite(pop1, pop2, uu1, uu2, vv1, vv2);
+  ChFi3d_BoundFac(*HBop, uu1, uu2, vv1, vv2);
+  occ::handle<Geom_Curve>   zob3d;
+  occ::handle<Geom2d_Curve> zob2dop, zob2dv;
+  double                    tolreached = tol3d;
+  if (!ChFi3d_ComputeCurves(HBop, HBs, Pardeb, Parfin, zob3d, zob2dop, zob2dv, tol3d, tol2d, tolreached))
+  {
+    throw Standard_Failure("OneCorner : echec calcul intersection");
+  }
+  const double Udeb = zob3d->FirstParameter(), Ufin = zob3d->LastParameter();
+  const int    IZob = DStr.AddCurve(TopOpeBRepDS_Curve(zob3d, tolreached));
+  // The side towards a point from the curve's middle: the material of a
+  // face lies on the left of its edges in its parameters.
+  const auto sideOf = [&](const occ::handle<Geom2d_Curve>& C, const gp_Pnt2d& Towards) {
+    gp_Pnt2d p;
+    gp_Vec2d t;
+    C->D1(0.5 * (Udeb + Ufin), p, t);
+    return t.Crossed(gp_Vec2d(p, Towards)) > 0. ? TopAbs_FORWARD : TopAbs_REVERSED;
+  };
+  const gp_Pnt2d aOnFv = onSurface(BRep_Tool::Pnt(A), Fv, pv2);
+  const double   tm    = 0.5 * (Fiop.FirstParameter() + Fiop.LastParameter());
+  const gp_Pnt2d aOnFop = Fiop.PCurveOnFace()->Value(tm);
+  const TopAbs_Orientation Etv  = sideOf(zob2dv, aOnFv);
+  const TopAbs_Orientation Etop = TopAbs::Reverse(sideOf(zob2dop, aOnFop));
+  DStr.ChangeShapeInterferences(IShape).Append(ChFi3d_FilCurveInDS(IZob, IShape, zob2dv, Etv));
+  const int Iop = DStr.AddShape(Fop);
+  DStr.ChangeShapeInterferences(Iop).Append(ChFi3d_FilCurveInDS(IZob, Iop, zob2dop, Etop));
+  DStr.ChangeCurveInterferences(IZob).Append(ChFi3d_FilVertexInDS(TopAbs_FORWARD, IZob, DStr.AddShape(Vtx), Udeb));
+  DStr.ChangeCurveInterferences(IZob).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, IZob, icc, Ufin));
+  box.Add(zob3d->Value(Ufin));
+}
