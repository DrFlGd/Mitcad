+// The face holding vertices V and A other than the faces given, or null.
+static TopoDS_Face ChFi3d_FaceAtBoth(const ChFiDS_Map&    VFMap,
+                                     const TopoDS_Vertex& V,
+                                     const TopoDS_Vertex& A,
+                                     const TopoDS_Face&   F1,
+                                     const TopoDS_Face&   F2,
+                                     const TopoDS_Face&   F3)
+{
+  if (!VFMap.Contains(V) || !VFMap.Contains(A))
+  {
+    return TopoDS_Face();
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(VFMap(V)); it.More(); it.Next())
+  {
+    const TopoDS_Shape& F = it.Value();
+    if (F.IsSame(F1) || F.IsSame(F2) || F.IsSame(F3))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itA(VFMap(A)); itA.More(); itA.Next())
+    {
+      if (itA.Value().IsSame(F))
+      {
+        return TopoDS::Face(F);
+      }
+    }
+  }
+  return TopoDS_Face();
+}
+
+//=======================================================================
+// function : RolledOnProlongedEdge
+// purpose  : A blend P rolling on side opp on a straight edge Er of its
+//            face B (a top narrower than the radius, consumed, the ball
+//            rolling on its edge with B) from one end of Er to the other,
+//            Er's ends lying on the faces at the ends of the spine (each
+//            vertex A on a face W that holds the spine's end vertex there),
+//            the stripe going on past Er's ends (turning about them). The
+//            files' bodies roll the ball on along Er's line up to the
+//            spine's ends, where W cuts the blend (the cap runs from A).
+//            The blend is walked again from the middle of P, rolling on
+//            Er's line as the edge of a strip of B's surface on B's side
+//            of it, the other side's face N's surface grown, up to the
+//            guide's ends, and replaces the stripe's SurfData.
+//=======================================================================
+
+bool ChFi3d_Builder::RolledOnProlongedEdge(const occ::handle<ChFiDS_Stripe>& Stripe)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (Spine.IsNull() || Spine->IsPeriodic() || Stripe->SetOfSurfData().IsNull()
+      || Stripe->SetOfSurfData()->IsEmpty() || Spine->ChangeElSpines().Extent() != 1)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (fsp.IsNull() || !fsp->IsConstant())
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&                               DStr   = myDS->ChangeDS();
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil = Stripe->SetOfSurfData()->Sequence();
+  // P: rolling on Er from one of its vertices to the other.
+  occ::handle<ChFiDS_SurfData> P;
+  int                          opp = 0;
+  TopoDS_Edge                  Er;
+  for (int j = 1; j <= SeqFil.Length() && P.IsNull(); j++)
+  {
+    const occ::handle<ChFiDS_SurfData>& S = SeqFil(j);
+    for (int s = 1; s <= 2 && P.IsNull(); s++)
+    {
+      if (!S->IsOnCurve(s) || S->IsOnCurve(3 - s) || S->IndexOfC(s) <= 0 || S->Index(1) <= 0 || S->Index(2) <= 0)
+      {
+        continue;
+      }
+      const TopoDS_Edge   E  = TopoDS::Edge(DStr.Shape(S->IndexOfC(s)));
+      const TopoDS_Vertex E1 = TopExp::FirstVertex(E), E2 = TopExp::LastVertex(E);
+      if (E1.IsNull() || E2.IsNull() || E1.IsSame(E2))
+      {
+        continue;
+      }
+      const double tol = 10. * tolesp;
+      const gp_Pnt a = S->Vertex(true, s).Point(), b = S->Vertex(false, s).Point();
+      const gp_Pnt p1 = BRep_Tool::Pnt(E1), p2 = BRep_Tool::Pnt(E2);
+      if ((a.Distance(p1) <= tol && b.Distance(p2) <= tol) || (a.Distance(p2) <= tol && b.Distance(p1) <= tol))
+      {
+        P   = S;
+        opp = s;
+        Er  = E;
+      }
+    }
+  }
+  // (The stripe goes on past Er's ends: pieces turning about them.)
+  if (P.IsNull() || !myEFMap.Contains(Er) || SeqFil.Length() < 2)
+  {
+    return false;
+  }
+  const int         ons = 3 - opp;
+  const TopoDS_Face B   = TopoDS::Face(DStr.Shape(P->Index(opp)));
+  const TopoDS_Face N   = TopoDS::Face(DStr.Shape(P->Index(ons)));
+  TopoDS_Face       Fref;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(myEFMap(Er)); it.More() && Fref.IsNull(); it.Next())
+  {
+    if (!it.Value().IsSame(B))
+    {
+      Fref = TopoDS::Face(it.Value());
+    }
+  }
+  if (Fref.IsNull() || N.IsSame(B))
+  {
+    return false;
+  }
+  // Er's vertex at each end of the spine on a face holding the end vertex.
+  {
+    const TopoDS_Vertex Afirst =
+      P->Vertex(true, opp).Point().Distance(BRep_Tool::Pnt(TopExp::FirstVertex(Er))) <= 10. * tolesp
+        ? TopExp::FirstVertex(Er)
+        : TopExp::LastVertex(Er);
+    const TopoDS_Vertex Alast = Afirst.IsSame(TopExp::FirstVertex(Er)) ? TopExp::LastVertex(Er) : TopExp::FirstVertex(Er);
+    if (Spine->FirstVertex().IsNull() || Spine->LastVertex().IsNull()
+        || ChFi3d_FaceAtBoth(myVFMap, Spine->FirstVertex(), Afirst, B, Fref, N).IsNull()
+        || ChFi3d_FaceAtBoth(myVFMap, Spine->LastVertex(), Alast, B, Fref, N).IsNull())
+    {
+      return false;
+    }
+  }
+  // Er's line prolonged.
+  double                  ef = 0., el = 0.;
+  occ::handle<Geom_Curve> CEr = BRep_Tool::Curve(Er, ef, el);
+  if (CEr.IsNull())
+  {
+    return false;
+  }
+  while (CEr->IsKind(STANDARD_TYPE(Geom_TrimmedCurve)))
+  {
+    CEr = occ::down_cast<Geom_TrimmedCurve>(CEr)->BasisCurve();
+  }
+  occ::handle<ChFiDS_ElSpine> HGuide = Spine->ChangeElSpines().First();
+  if (HGuide.IsNull() || !CEr->IsKind(STANDARD_TYPE(Geom_Line)))
+  {
+    return false;
+  }
+  const double R     = fsp->Radius();
+  const double aGrow = (HGuide->LastParameter() - HGuide->FirstParameter()) + 4. * R;
+  const double pf    = ef - aGrow, pl = el + aGrow;
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(B);
+  const occ::handle<Geom_Surface> SN = BRep_Tool::Surface(N);
+  if (SB.IsNull() || SN.IsNull())
+  {
+    return false;
+  }
+  const double W0 = 0.5 * (P->FirstSpineParam() + P->LastSpineParam());
+  if (W0 < HGuide->FirstParameter() || W0 > HGuide->LastParameter())
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& FN = P->Interference(ons);
+  const ChFiDS_FaceInterference& FR = P->Interference(opp);
+  if (FN.PCurveOnFace().IsNull() || FR.LineIndex() <= 0 || FN.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const gp_Pnt2d uvN = FN.PCurveOnFace()->Value(W0);
+  // N grown by the guide's length and more on all sides, a periodic one's
+  // seam half a period from the start.
+  const auto unbounded = [aGrow](const occ::handle<Geom_Surface>& S, const gp_Pnt2d& uv, const TopoDS_Face& F) {
+    double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+    S->Bounds(u1, u2, v1, v2);
+    double fu1 = 0., fu2 = 0., fv1 = 0., fv2 = 0.;
+    BRepTools::UVBounds(F, fu1, fu2, fv1, fv2);
+    u1 = std::max(u1, fu1 - aGrow);
+    u2 = std::min(u2, fu2 + aGrow);
+    v1 = std::max(v1, fv1 - aGrow);
+    v2 = std::min(v2, fv2 + aGrow);
+    if (S->IsUPeriodic())
+    {
+      u1 = uv.X() - 0.5 * S->UPeriod();
+      u2 = u1 + S->UPeriod();
+    }
+    TopoDS_Face U = BRepLib_MakeFace(S, u1, u2, v1, v2, Precision::Confusion());
+    if (!U.IsNull())
+    {
+      U.Orientation(F.Orientation());
+    }
+    return U;
+  };
+  const gp_Pnt                  pR  = DStr.Curve(FR.LineIndex()).Curve()->Value(W0);
+  GeomAPI_ProjectPointOnCurve   aPrE(pR, CEr, pf, pl);
+  if (aPrE.NbPoints() == 0 || aPrE.LowerDistance() > 1.e-4)
+  {
+    return false;
+  }
+  TopoDS_Face NF = unbounded(SN, uvN, N);
+  if (NF.IsNull())
+  {
+    return false;
+  }
+  // B prolonged past Er's ends: on B's surface the strip beside Er's line
+  // on B's side of it (B's interior there), Er's line its edge, so that the
+  // ball still leaves the edge for B where it reaches into it.
+  TopoDS_Face BF;
+  TopoDS_Edge Eprol;
+  {
+    TopoDS_Face BB = B;
+    BB.Orientation(TopAbs_FORWARD);
+    const TopoDS_Edge ErB = edgeInFace(Er, BB);
+    double            cf = 0., cl = 0.;
+    const occ::handle<Geom2d_Curve> PCr = ErB.IsNull() ? occ::handle<Geom2d_Curve>()
+                                                       : BRep_Tool::CurveOnSurface(ErB, BB, cf, cl);
+    if (PCr.IsNull())
+    {
+      return false;
+    }
+    // (B's side of Er: a point beside the middle of Er's curve in B.)
+    gp_Pnt2d pm;
+    gp_Vec2d tm;
+    PCr->D1(0.5 * (cf + cl), pm, tm);
+    if (tm.Magnitude() < gp::Resolution())
+    {
+      return false;
+    }
+    gp_Vec2d     d(-tm.Y(), tm.X());
+    BRepAdaptor_Surface aBS(BB);
+    const double step = 1.e-3 * std::min(aBS.UResolution(1.), aBS.VResolution(1.));
+    d.Normalize();
+    BRepClass_FaceClassifier onLeft(BB, pm.Translated(step * d), 0.1 * step);
+    BRepClass_FaceClassifier onRight(BB, pm.Translated(-step * d), 0.1 * step);
+    if ((onLeft.State() == TopAbs_IN) == (onRight.State() == TopAbs_IN))
+    {
+      return false;
+    }
+    if (onLeft.State() != TopAbs_IN)
+    {
+      d.Reverse();
+    }
+    // The strip's corners in B's parameters, its side d as far as aGrow in 3d.
+    occ::handle<Geom2d_Curve> L2 = GeomProjLib::Curve2d(new Geom_TrimmedCurve(CEr, pf, pl), pf, pl, SB);
+    while (!L2.IsNull() && L2->IsKind(STANDARD_TYPE(Geom2d_TrimmedCurve)))
+    {
+      L2 = occ::down_cast<Geom2d_TrimmedCurve>(L2)->BasisCurve();
+    }
+    const occ::handle<Geom2d_Line> L = occ::down_cast<Geom2d_Line>(L2);
+    if (L.IsNull())
+    {
+      return false;
+    }
+    const double wide = aGrow * std::min(aBS.UResolution(1.), aBS.VResolution(1.));
+    const gp_Pnt2d a = L->Value(pf), b = L->Value(pl);
+    const gp_Pnt2d c = b.Translated(wide * d), e = a.Translated(wide * d);
+    // (Counterclockwise in the parameters, the line first.)
+    const bool ccw = gp_Vec2d(a, b).Crossed(gp_Vec2d(a, e)) > 0.;
+    BRepLib_MakeEdge mk0(L, SB, pf, pl);
+    BRepLib_MakeEdge mk1(GCE2d_MakeSegment(b, c).Value(), SB);
+    BRepLib_MakeEdge mk2(GCE2d_MakeSegment(c, e).Value(), SB);
+    BRepLib_MakeEdge mk3(GCE2d_MakeSegment(e, a).Value(), SB);
+    if (!mk0.IsDone() || !mk1.IsDone() || !mk2.IsDone() || !mk3.IsDone())
+    {
+      return false;
+    }
+    BRepLib_MakeWire mkw;
+    mkw.Add(mk0.Edge());
+    mkw.Add(mk1.Edge());
+    mkw.Add(mk2.Edge());
+    mkw.Add(mk3.Edge());
+    if (!mkw.IsDone())
+    {
+      return false;
+    }
+    TopoDS_Wire W = mkw.Wire();
+    if (!ccw)
+    {
+      W.Reverse();
+    }
+    BRepLib_MakeFace mkf(SB, W, true);
+    if (!mkf.IsDone())
+    {
+      return false;
+    }
+    BF = mkf.Face();
+    BRepLib::BuildCurves3d(BF);
+    BF.Orientation(TopAbs_FORWARD);
+    Eprol = edgeInFace(mk0.Edge(), BF);
+    if (Eprol.IsNull())
+    {
+      return false;
+    }
+  }
+  occ::handle<BRepAdaptor_Surface>      HSN = new BRepAdaptor_Surface(NF);
+  occ::handle<BRepAdaptor_Surface>      HSB = new BRepAdaptor_Surface(BF);
+  occ::handle<BRepAdaptor_Curve2d>      PCB = new BRepAdaptor_Curve2d(Eprol, BF);
+  occ::handle<BRepTopAdaptor_TopolTool> ItN = new BRepTopAdaptor_TopolTool(HSN);
+  occ::handle<BRepTopAdaptor_TopolTool> ItB = new BRepTopAdaptor_TopolTool(HSB);
+  // (As for the blends on an edge of PerformSetOfSurfOnElSpine.)
+  TopAbs_Orientation OrN = NF.Orientation();
+  TopAbs_Orientation OrR = Fref.Orientation();
+  int                Choix;
+  if (ons == 1)
+  {
+    Choix = ChFi3d::NextSide(OrN, OrR, Stripe->OrientationOnFace1(), Stripe->OrientationOnFace2(), Stripe->Choix());
+  }
+  else
+  {
+    Choix = ChFi3d::NextSide(OrR, OrN, Stripe->OrientationOnFace1(), Stripe->OrientationOnFace2(), -Stripe->Choix());
+    Choix = Choix % 2 == 1 ? Choix + 1 : Choix - 1;
+  }
+  math_Vector Soldep(1, 3);
+  {
+    double a = 0., b = 0., c = 0., d = 0.;
+    BRepTools::UVBounds(NF, a, b, c, d);
+    Soldep(1) = SN->IsUPeriodic() ? ElCLib::InPeriod(uvN.X(), a, a + SN->UPeriod()) : uvN.X();
+  }
+  Soldep(2) = uvN.Y();
+  Soldep(3) = aPrE.LowerDistanceParameter();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>> SeqSD;
+  SeqSD.Append(new ChFiDS_SurfData());
+  double                   First = W0, Last = HGuide->FirstParameter();
+  const double             MaxStep  = 0.05 * (Spine->LastParameter(Spine->NbEdges()) - Spine->FirstParameter(1));
+  const double             Fleche   = (HGuide->LastParameter() - HGuide->FirstParameter()) * fleche;
+  bool                     decroch  = false;
+  bool                     walked   = true;
+  const bool               doneSave = done;
+  const ChFiDS_ErrorStatus stSave   = Spine->ErrorStatus();
+  try
+  {
+    OCC_CATCH_SIGNALS
+    if (ons == 1)
+    {
+      PerformSurf(SeqSD, HGuide, Spine, Choix, HSN, ItN, OrN, HSB, ItB, PCB, HSB, PCB, decroch, MaxStep, Fleche,
+                  tolesp, First, Last, true, true, true, false, false, false, Soldep);
+    }
+    else
+    {
+      PerformSurf(SeqSD, HGuide, Spine, Choix, HSB, ItB, PCB, HSB, PCB, decroch, HSN, ItN, OrN, MaxStep, Fleche,
+                  tolesp, First, Last, true, true, true, false, false, false, Soldep);
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    walked = false;
+  }
+  done = doneSave;
+  Spine->SetErrorStatus(stSave);
+  if (!walked || SeqSD.Length() != 1)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> X = SeqSD.First();
+  // It must run past Er's ends up to the spine's ends.
+  if (X->FirstSpineParam() > std::min(P->FirstSpineParam(), Spine->FirstParameter(1)) + 10. * tolesp
+      || X->LastSpineParam() < std::max(P->LastSpineParam(), Spine->LastParameter(Spine->NbEdges())) - 10. * tolesp)
+  {
+    return false;
+  }
+  X->ChangeIndexOfS1(DStr.AddShape(ons == 1 ? N : B));
+  X->ChangeIndexOfS2(DStr.AddShape(ons == 1 ? B : N));
+  if (opp == 1)
+  {
+    X->SetIndexOfC1(DStr.AddShape(Er));
+  }
+  else
+  {
+    X->SetIndexOfC2(DStr.AddShape(Er));
+  }
+  // X's curves on N and B in the periods of P's at W0.
+  for (int s = 1; s <= 2; s++)
+  {
+    const occ::handle<Geom_Surface>& S   = s == ons ? SN : SB;
+    ChFiDS_FaceInterference&         FX  = X->ChangeInterference(s);
+    const occ::handle<Geom2d_Curve>  PCX = FX.PCurveOnFace();
+    const occ::handle<Geom2d_Curve>& PCP = P->Interference(s).PCurveOnFace();
+    if (PCX.IsNull() || PCP.IsNull())
+    {
+      return false;
+    }
+    if (!S->IsUPeriodic())
+    {
+      continue;
+    }
+    const double T   = S->UPeriod();
+    const double aU  = PCX->Value(W0).X();
+    const double aP  = PCP->Value(W0).X();
+    const double aDU = ElCLib::InPeriod(aU, aP - 0.5 * T, aP + 0.5 * T) - aU;
+    if (std::abs(aDU) > Precision::PConfusion())
+    {
+      FX.ChangePCurveOnFace() = occ::down_cast<Geom2d_Curve>(PCX->Translated(gp_Vec2d(aDU, 0.)));
+    }
+  }
+  // Its ends lie past Er's ends and on no edge of the faces (the walk's
+  // points on the prolonged edge and the grown faces' boundaries).
+  for (int e = 0; e < 2; e++)
+  {
+    for (int s = 1; s <= 2; s++)
+    {
+      ChFiDS_CommonPoint& CP   = X->ChangeVertex(e == 0, s);
+      const double        t    = CP.Tolerance();
+      const bool          hasV = CP.HasVector();
+      const gp_Vec        v    = hasV ? CP.Vector() : gp_Vec();
+      CP.Reset();
+      CP.SetTolerance(t);
+      if (hasV)
+      {
+        CP.SetVector(v);
+      }
+    }
+  }
+  Stripe->ChangeSetOfSurfData()->Clear();
+  Stripe->ChangeSetOfSurfData()->Append(X);
+  return true;
+}
