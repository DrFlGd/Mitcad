@@ -3222,6 +3223,15 @@ void ChFi3d_FilBuilder::SetRegul()
       {
         TopoDS_Face   F1   = TopoDS::Face(its1.Value());
         TopoDS_Face   F2   = TopoDS::Face(its2.Value());
+        // A contact along the far edge of a face the blend consumes (a
+        // boss's foot rounded as high as its wall) leaves the contact's
+        // edge between the blend and the face beyond that edge, which the
