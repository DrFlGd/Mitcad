+        if (!ChFi3d::IsTangentFaces(E, F1, F2))
+        {
+          continue;
+        }
         GeomAbs_Shape cont = ChFi3d_evalconti(E, F1, F2);
         B.Continuity(E, F1, F2, cont);
       }
