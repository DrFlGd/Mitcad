--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
@@ -3603,6 +3603,26 @@ void ChFi3d_ContactsAlongFaceEdges(TopOpeBRepDS_DataStructure&       DStr,
       }
     }
   }
+  // A closed stripe whose first and last contacts on a side now end at a
+  // vertex (the contacts of a closed chain of several edges along the edges
+  // of a face they consume all round): the stripe's point there is that
+  // vertex. It had made its point at the start beside the vertex, and the
+  // topological build took that point's index for a vertex's
+  // (TopoDS_Builder::Add in TopOpeBRepBuild_Builder::MakeEdges).
+  if ((aSpine->IsPeriodic() || aSpine->IsClosed()) && !SeqFil.IsEmpty())
+  {
+    for (int ons = 1; ons <= 2; ons++)
+    {
+      for (const bool isFirst : {true, false})
+      {
+        const ChFiDS_CommonPoint& CP = (isFirst ? SeqFil.First() : SeqFil.Last())->Vertex(isFirst, ons);
+        if (CP.IsVertex())
+        {
+          CorDat->SetIndexPoint(DStr.AddShape(CP.Vertex()), isFirst, ons);
+        }
+      }
+    }
+  }
 }
 
