+
+//=================================================================================================
+// Edges that leave a vertex tangentially to each other (the section of a
+// thread's crest beside the circle of the hole it lies in) have angles that
+// differ by less than their curvature turns them within the steps Angle2D
+// measured them at, and those steps differ from edge to edge (each from its
+// own curve's resolution and parametrisation): their order then follows the
+// steps, not the curves, and the loops cross each other. Such edges are
+// measured again, each by the chord to its point at one distance from the
+// vertex, the same for all of them: half the shortest distance from the
+// vertex to the middle of one of them, where each first reaches it. Edges
+// that do not cross each other keep their order there, at any distance:
+// their pieces up to there are arcs from the vertex to the circle of that
+// radius that do not cross.
+static void RefineTangentAngles(
+  const TopoDS_Face&                                   myFace,
+  NCollection_IndexedDataMap<TopoDS_Shape,
+                             NCollection_List<BOPAlgo_EdgeInfo>,
+                             TopTools_ShapeMapHasher>& mySmartMap,
+  const BRepAdaptor_Surface&                           aGAS,
+  const occ::handle<IntTools_Context>&                 theContext)
+{
+  // Directions closer than this are measured again (the steps differ by up
+  // to a few hundredths of a millimetre, which turns an edge of a radius of
+  // a tenth of a millimetre by a few tenths of this).
+  const double aWindow = 0.1;
+  const double aTwoPI  = M_PI + M_PI;
+  const int    aNb     = mySmartMap.Extent();
+  for (int i = 1; i <= aNb; ++i)
+  {
+    NCollection_List<BOPAlgo_EdgeInfo>& aLEI = mySmartMap(i);
+    if (aLEI.Extent() < 3)
+    {
+      continue;
+    }
+    TopoDS_Vertex aV = *((TopoDS_Vertex*)&mySmartMap.FindKey(i));
+    aV.Orientation(TopAbs_FORWARD);
+    // The direction of each edge from the vertex.
+    NCollection_Sequence<BOPAlgo_EdgeInfo*> aInfos;
+    NCollection_Sequence<double>            aDirs;
+    for (NCollection_List<BOPAlgo_EdgeInfo>::Iterator aIt(aLEI); aIt.More(); aIt.Next())
+    {
+      BOPAlgo_EdgeInfo& aEI  = aIt.ChangeValue();
+      double            aDir = aEI.IsIn() ? aEI.Angle() + M_PI : aEI.Angle();
+      while (aDir >= aTwoPI)
+      {
+        aDir -= aTwoPI;
+      }
+      aInfos.Append(&aEI);
+      aDirs.Append(aDir);
+    }
+    const int aNbI = aInfos.Length();
+    // The edges whose directions lie within the window of another edge's.
+    NCollection_Sequence<bool> aClose;
+    bool                       bAny = false;
+    for (int j = 1; j <= aNbI; ++j)
+    {
+      bool bClose = false;
+      for (int k = 1; k <= aNbI && !bClose; ++k)
+      {
+        if (k == j || aInfos(k)->Edge().IsSame(aInfos(j)->Edge()))
+        {
+          continue;
+        }
+        double aD = std::abs(aDirs(j) - aDirs(k));
+        aD        = std::min(aD, aTwoPI - aD);
+        bClose    = aD < aWindow;
+      }
+      aClose.Append(bClose);
+      bAny = bAny || bClose;
+    }
+    if (!bAny)
+    {
+      continue;
+    }
+    // The curves of those edges, the parameter at the vertex and in the
+    // middle, and the common distance.
+    const double                           aTol2D = 2. * Tolerance2D(aV, aGAS);
+    NCollection_Sequence<occ::handle<Geom2d_Curve>> aCurves;
+    NCollection_Sequence<double>           aTVs, aTMs;
+    gp_Pnt2d                               aPV;
+    double                                 aDist = Precision::Infinite();
+    bool                                   bOk   = true;
+    for (int j = 1; j <= aNbI && bOk; ++j)
+    {
+      double                    aT1 = 0., aT2 = 0., aTol = 0.;
+      occ::handle<Geom2d_Curve> aC2D;
+      if (aClose(j))
+      {
+        BOPTools_AlgoTools2D::CurveOnSurface(aInfos(j)->Edge(), myFace, aC2D, aT1, aT2, aTol, theContext);
+      }
+      if (aC2D.IsNull())
+      {
+        aCurves.Append(aC2D);
+        aTVs.Append(0.);
+        aTMs.Append(0.);
+        continue;
+      }
+      // The vertex as the edge has it at this end (a closed edge has it at
+      // both).
+      TopoDS_Vertex aVV = aV;
+      aVV.Orientation(aInfos(j)->IsIn() ? TopAbs_REVERSED : TopAbs_FORWARD);
+      const double aTV = BRep_Tool::Parameter(aVV, aInfos(j)->Edge(), myFace);
+      const double aTM = 0.5 * (aT1 + aT2);
+      const gp_Pnt2d aP = aC2D->Value(aTV);
+      if (aDist == Precision::Infinite())
+      {
+        aPV = aP;
+      }
+      else if (aP.Distance(aPV) > aTol2D)
+      {
+        bOk = false; // the edges do not start at one point
+      }
+      aDist = std::min(aDist, 0.5 * aC2D->Value(aTM).Distance(aPV));
+      aCurves.Append(aC2D);
+      aTVs.Append(aTV);
+      aTMs.Append(aTM);
+    }
+    // Too short to tell apart within the tolerance: left as they were.
+    if (!bOk || aDist == Precision::Infinite() || aDist < 10. * aTol2D)
+    {
+      continue;
+    }
+    for (int j = 1; j <= aNbI; ++j)
+    {
+      if (!aClose(j))
+      {
+        continue;
+      }
+      const occ::handle<Geom2d_Curve>& aC2D = aCurves(j);
+      // The parameter where the edge first reaches the distance from the
+      // vertex (it is past it at the middle): the first of 32 steps towards
+      // the middle past it, then halving the step before it.
+      double aTa = aTVs(j), aTb = aTMs(j);
+      for (int k = 1; k <= 32; ++k)
+      {
+        const double aT = aTVs(j) + (aTMs(j) - aTVs(j)) * k / 32.;
+        if (aC2D->Value(aT).Distance(aPV) >= aDist)
+        {
+          aTb = aT;
+          break;
+        }
+        aTa = aT;
+      }
+      for (int k = 0; k < 60; ++k)
+      {
+        const double aT = 0.5 * (aTa + aTb);
+        if (aC2D->Value(aT).Distance(aPV) < aDist)
+        {
+          aTa = aT;
+        }
+        else
+        {
+          aTb = aT;
+        }
+      }
+      const gp_Vec2d aVec(aPV, aC2D->Value(0.5 * (aTa + aTb)));
+      if (aVec.Magnitude() < gp::Resolution())
+      {
+        continue;
+      }
+      double aA = Angle(gp_Dir2d(aVec));
+      if (aInfos(j)->IsIn())
+      {
+        aA += M_PI;
+        if (aA >= aTwoPI)
+        {
+          aA -= aTwoPI;
+        }
+      }
+      aInfos(j)->SetAngle(aA);
+    }
+  }
+}
