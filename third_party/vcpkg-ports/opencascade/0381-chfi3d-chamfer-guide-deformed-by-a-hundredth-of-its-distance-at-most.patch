+//=======================================================================
+// function : ChFi3d_ChamferGuideDeformation
+// purpose  : How far the smoothing of a guide may move it: for a chamfer,
+//            whose contacts lie at its distances from the guide, a
+//            hundredth of its smallest distance; for others no limit.
+//=======================================================================
+
+static double ChFi3d_ChamferGuideDeformation(const occ::handle<ChFiDS_Spine>& Spine)
+{
+  const occ::handle<ChFiDS_ChamfSpine> aChSp = occ::down_cast<ChFiDS_ChamfSpine>(Spine);
+  if (aChSp.IsNull())
+  {
+    return RealLast();
+  }
+  double aDist1 = 0., aDist2 = 0.;
+  switch (aChSp->IsChamfer())
+  {
+    case ChFiDS_Sym:
+      aChSp->GetDist(aDist1);
+      aDist2 = aDist1;
+      break;
+    case ChFiDS_TwoDist:
+      aChSp->Dists(aDist1, aDist2);
+      break;
+    default: {
+      double anAngle = 0.;
+      aChSp->GetDistAngle(aDist1, anAngle);
+      aDist2 = aDist1 * std::tan(anAngle);
+      break;
+    }
+  }
+  const double aDist = std::min(std::abs(aDist1), std::abs(aDist2));
+  return aDist > 0. ? 0.01 * aDist : RealLast();
+}
