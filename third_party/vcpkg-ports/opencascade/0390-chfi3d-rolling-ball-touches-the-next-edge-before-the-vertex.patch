+//=======================================================================
+// function : ChFi3d_ConcaveTurnWedge
+// purpose  : The rounding between SurfData A and the next one B of a stripe
+//            whose side ons rolls on an edge E1 up to where the ball touches
+//            the next edge E2 of the reference face (a concave turn,
+//            ChFi3d_ConcaveTurnEdge): A's last section and B's first are
+//            arcs of that ball from its contact on the other side's face to
+//            its contacts on E1 and on E2. Between them the rounding is a
+//            piece of the ball's sphere: its side on the other face is the
+//            point both arcs start at, its side ons runs where the sphere
+//            cuts the faces beyond E1 and E2, across their common edge. The
+//            pieces, one per face, in the stripe's order; false where they
+//            cannot be made.
+//=======================================================================
+
+static bool ChFi3d_ConcaveTurnWedge(TopOpeBRepDS_DataStructure&                         DStr,
+                                    const occ::handle<ChFiDS_SurfData>&                 A,
+                                    const occ::handle<ChFiDS_SurfData>&                 B,
+                                    const int                                           ons,
+                                    const double                                        R,
+                                    const double                                        tol3d,
+                                    NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Pieces)
+{
+  const int opp = 3 - ons;
+  if (A.IsNull() || B.IsNull() || A->Index(ons) <= 0 || B->Index(ons) <= 0 || A->Index(opp) <= 0
+      || A->Surf() <= 0 || R <= Precision::Confusion())
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint&      Aq = A->Vertex(false, opp);
+  const ChFiDS_CommonPoint&      Ap = A->Vertex(false, ons);
+  const ChFiDS_CommonPoint&      Bp = B->Vertex(true, ons);
+  const gp_Pnt                   q = Aq.Point(), p1 = Ap.Point(), p2 = Bp.Point();
+  const double                   tolBall = std::max(1.e3 * tol3d, 1.e-4 * R);
+  const ChFiDS_FaceInterference& FAo     = A->Interference(opp);
+  const ChFiDS_FaceInterference& FAn     = A->Interference(ons);
+  if (q.Distance(B->Vertex(true, opp).Point()) > tolBall || FAo.PCurveOnFace().IsNull()
+      || FAo.PCurveOnSurf().IsNull() || FAn.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  // The ball's centre: at R from q along the other face's normal, at R from
+  // its contacts on E1 and E2.
+  const TopoDS_Face   Fo = TopoDS::Face(DStr.Shape(A->Index(opp)));
+  BRepAdaptor_Surface aSo(Fo, false);
+  const gp_Pnt2d      uvq = FAo.PCurveOnFace()->Value(FAo.LastParameter());
+  gp_Pnt              aPq;
+  gp_Vec              aDu, aDv;
+  aSo.D1(uvq.X(), uvq.Y(), aPq, aDu, aDv);
+  gp_Vec aN = aDu.Crossed(aDv);
+  if (aN.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  aN.Normalize();
+  const gp_Pnt C1 = q.Translated(R * aN), C2 = q.Translated(-R * aN);
+  const gp_Pnt C  = std::abs(C1.Distance(p1) - R) <= std::abs(C2.Distance(p1) - R) ? C1 : C2;
+  if (std::abs(C.Distance(p1) - R) > tolBall || std::abs(C.Distance(p2) - R) > tolBall
+      || !A->IsOnCurve(ons) || !B->IsOnCurve(ons))
+  {
+    return false;
+  }
+  // E1 and E2 end there on both sides: up to their contacts the blends' own
+  // contacts take their place, beyond them the ball's piece removes them.
+  for (int k = 0; k < 2; k++)
+  {
+    const occ::handle<ChFiDS_SurfData>& D     = k == 0 ? A : B;
+    ChFiDS_CommonPoint&                 CP    = D->ChangeVertex(k != 0, ons);
+    const TopoDS_Edge                   anArc = TopoDS::Edge(DStr.Shape(D->IndexOfC(ons)));
+    const gp_Pnt                        aP    = CP.Point();
+    double                              aW    = 0.;
+    if (CP.IsOnArc() && CP.Arc().IsSame(anArc))
+    {
+      aW = CP.ParameterOnArc();
+    }
+    else
+    {
+      double                        f = 0., l = 0.;
+      const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(anArc, f, l);
+      if (aC.IsNull())
+      {
+        return false;
+      }
+      GeomAPI_ProjectPointOnCurve aPr(aP, aC, f, l);
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tolBall)
+      {
+        return false;
+      }
+      aW = aPr.LowerDistanceParameter();
+    }
+    const double aTol = std::max(CP.Tolerance(), tol3d);
+    CP.Reset();
+    CP.SetPoint(aP);
+    CP.SetArc(aTol, anArc, aW, TopAbs_EXTERNAL);
+  }
+  // The sphere, its pole at q; longitudes increase from p1's to p2's, p1's at
+  // 0.5 (clear of the seam).
+  const gp_Dir Z(gp_Vec(C, q));
+  gp_Vec       X1(C, p1);
+  X1.SetLinearForm(-X1.Dot(gp_Vec(Z)), gp_Vec(Z), X1);
+  if (X1.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  gp_Ax3 aFrame(C, Z, gp_Dir(X1));
+  if (gp_Vec(C, p2).Dot(gp_Vec(aFrame.YDirection())) < 0.)
+  {
+    aFrame.YReverse();
+  }
+  double u1 = 0., v1 = 0., u2 = 0., v2 = 0.;
+  for (const double anAngle : {-0.5, 1.})
+  {
+    aFrame.Rotate(gp_Ax1(C, aFrame.Direction()), anAngle);
+    ElSLib::SphereParameters(aFrame, R, p1, u1, v1);
+    if (std::abs(u1 - 0.5) <= 1.e-6)
