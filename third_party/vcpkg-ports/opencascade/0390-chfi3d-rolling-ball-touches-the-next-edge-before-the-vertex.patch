+//=======================================================================
+// function : ChFi3d_ConcaveTurnEdge
+// purpose  : For a blend rolling on edge EHC (an edge of the reference face
+//            Fref) that ends inside it at its end isFirst: the edge of Fref
+//            next to EHC at one of its vertices that the ball there touches
+//            inside it (it turns towards the ball, which touched it before
+//            the vertex; BRepBlend_SurfRstLineBuilder stops there), not
+//            one across which Fref continues tangentially, and the
+//            parameter W of the ball's contact on it.
+//=======================================================================
+
+static bool ChFi3d_ConcaveTurnEdge(const TopOpeBRepDS_DataStructure&   DStr,
+                                   const occ::handle<ChFiDS_SurfData>& SD,
+                                   const bool                          isFirst,
+                                   const ChFiDS_CommonPoint&           CP,
+                                   const TopoDS_Edge&                  EHC,
+                                   const TopoDS_Face&                  Fref,
+                                   const ChFiDS_Map&                   EFMap,
+                                   const double                        Tol,
+                                   TopoDS_Edge&                        Next,
+                                   double&                             W)
+{
+  gp_Pnt C;
+  if (EHC.IsNull() || Fref.IsNull() || !ChFi3d_BallCentreAtEnd(DStr, SD, isFirst, C))
+  {
+    return false;
+  }
+  const double  R = C.Distance(CP.Point());
+  TopoDS_Vertex V1, V2;
+  TopExp::Vertices(EHC, V1, V2);
+  double best = Tol;
+  for (TopExp_Explorer ex(Fref, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& En = TopoDS::Edge(ex.Current());
+    if (En.IsSame(EHC) || BRep_Tool::Degenerated(En))
+    {
+      continue;
+    }
+    bool atV = false;
+    for (TopExp_Explorer exv(En, TopAbs_VERTEX); exv.More() && !atV; exv.Next())
+    {
+      atV = exv.Current().IsSame(V1) || exv.Current().IsSame(V2);
+    }
+    if (!atV)
+    {
+      continue;
+    }
+    TopoDS_Face Fv;
+    if (IsG1(EFMap, En, Fref, Fv))
+    {
+      continue;
+    }
+    BRepAdaptor_Curve aCurve(En);
+    const double      w1 = aCurve.FirstParameter(), w2 = aCurve.LastParameter();
+    const double      tolw = aCurve.Resolution(Tol);
+    Extrema_ExtPC     anExt(C, aCurve, w1, w2, Precision::PConfusion());
+    if (!anExt.IsDone())
+    {
+      continue;
+    }
+    for (int i = 1; i <= anExt.NbExt(); i++)
+    {
+      const double w = anExt.Point(i).Parameter();
+      const double d = std::abs(std::sqrt(anExt.SquareDistance(i)) - R);
+      if (anExt.IsMin(i) && w > w1 + tolw && w < w2 - tolw && d < best)
+      {
+        best = d;
+        Next = En;
+        W    = w;
+      }
+    }
+  }
+  return !Next.IsNull();
+}
