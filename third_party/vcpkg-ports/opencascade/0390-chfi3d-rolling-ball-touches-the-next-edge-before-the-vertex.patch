+bool BRepBlend_SurfRstLineBuilder::NextEdgeGap(Blend_SurfRstFunction& Func,
+                                               const math_Vector&     Sol,
+                                               double&                Gap) const
+{
+  gp_Pnt centre;
+  if (!Func.Centre(Sol, centre))
+  {
+    return false;
+  }
+  const double radius = centre.Distance(surf1->Value(Sol(1), Sol(2)));
+  bool         found  = false;
+  Gap                 = RealLast();
+  for (int k = 0; k < 2; k++)
+  {
+    occ::handle<Adaptor3d_Curve> next;
+    if (!Func.NextCurveAtEnd(k == 1, next) || next.IsNull())
+    {
+      continue;
+    }
+    const double  w1 = next->FirstParameter(), w2 = next->LastParameter();
+    const double  tolw = next->Resolution(tolpoint3d);
+    Extrema_ExtPC anExt(centre, *next, w1, w2, Precision::PConfusion());
+    if (!anExt.IsDone())
+    {
+      continue;
+    }
+    for (int i = 1; i <= anExt.NbExt(); i++)
+    {
+      // (The edge's ends: the vertex the ball turns about where the edge runs
+      // away from it, and its far end.)
+      const double w = anExt.Point(i).Parameter();
+      if (!anExt.IsMin(i) || w <= w1 + tolw || w >= w2 - tolw)
+      {
+        continue;
+      }
+      Gap   = std::min(Gap, std::sqrt(anExt.SquareDistance(i)) - radius);
+      found = true;
+    }
+  }
+  return found;
+}
