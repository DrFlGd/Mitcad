+        anInter.Parameters(i, su, sv, wu);
+        if (wu < f - Precision::PConfusion() || wu > l + Precision::PConfusion() || su <= u1 || su >= u2)
+        {
+          continue;
+        }
+        Ec = E;
+        wK = wu;
+        uK = su;
+        K  = anInter.Point(i);
+      }
+    }
+    if (Ec.IsNull())
+    {
+      return false;
+    }
