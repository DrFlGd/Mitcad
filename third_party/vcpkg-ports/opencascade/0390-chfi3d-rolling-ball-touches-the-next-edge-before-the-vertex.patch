+//=================================================================================================
+
+bool BRepBlend_SurfRstLineBuilder::FindConcaveTurn(Blend_SurfRstFunction& Func,
+                                                   const double           P0,
+                                                   const math_Vector&     S0)
+{
+  math_Vector tolerance(1, 3), infb(1, 3), supb(1, 3);
+  Func.GetTolerance(tolerance, tolpoint3d);
+  Func.GetBounds(infb, supb);
+  math_FunctionSetRoot rsnld(Func, tolerance, 30);
+  double      pa = P0, pb = param, ga = 0., gb = 0.;
+  math_Vector sa(S0), sb(sol), sm(1, 3);
+  if (!NextEdgeGap(Func, sa, ga) || !NextEdgeGap(Func, sb, gb) || ga < -tolpoint3d
+      || gb >= -tolpoint3d)
+  {
+    return false;
+  }
+  for (int it = 0; it < 100; it++)
+  {
+    // Regula falsi, bisecting every other step.
+    double pm = it % 2 == 0 ? pa + (pb - pa) * ga / (ga - gb) : 0.5 * (pa + pb);
+    Func.Set(pm);
+    rsnld.Perform(Func, sa, infb, supb);
+    double gm = 0.;
+    if (!rsnld.IsDone())
+    {
+      break;
+    }
+    rsnld.Root(sm);
+    if (!Func.IsSolution(sm, tolpoint3d) || !NextEdgeGap(Func, sm, gm))
+    {
+      break;
+    }
+    if (std::abs(gm) <= 0.1 * tolpoint3d || std::abs(pb - pa) <= 1.e-3 * tolgui)
+    {
+      param = pm;
+      sol   = sm;
+      return true;
+    }
+    if (gm > 0.)
+    {
+      pa = pm;
+      sa = sm;
+      ga = gm;
+    }
+    else
+    {
+      pb = pm;
+      sb = sm;
+      gb = gm;
+    }
+  }
+  // The last section clear of the edge.
+  if (std::abs(ga) > 10. * tolpoint3d)
+  {
+    return false;
+  }
+  param = pa;
+  sol   = sa;
+  Func.Set(param);
+  return Func.IsSolution(sol, tolpoint3d);
+}
