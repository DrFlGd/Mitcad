+    occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+    G->ChangeSurf(DStr.AddSurface(TopOpeBRepDS_Surface(aSphere, tol3d)));
+    G->ChangeOrientation() = anOr;
+    G->ChangeIndexOfS1(opp == 1 ? A->IndexOfS1() : DStr.AddShape(aPart.F));
+    G->ChangeIndexOfS2(opp == 2 ? A->IndexOfS2() : DStr.AddShape(aPart.F));
+    {
+      ChFiDS_FaceInterference& GO = G->ChangeInterference(opp);
+      GO.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cq, tol3d)), FAo.Transition(), PFq, PSq);
+      GO.SetFirstParameter(c1);
+      GO.SetLastParameter(c2);
+    }
+    const TopAbs_Orientation aTra =
+      TopAbs::Compose(FAn.Transition(), TopAbs::Compose(F1.Orientation(), aPart.F.Orientation()));
+    {
+      ChFiDS_FaceInterference& GI = G->ChangeInterference(ons);
+      GI.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tol3d)), aTra, Pc, Ps);
+      GI.SetFirstParameter(c1);
+      GI.SetLastParameter(c2);
+    }
+    // The ends: q on the other side; on side ons, E1's and E2's points and the
+    // common edge's crossing, its transitions those of a contact leaving the
+    // first face across it and entering the second.
+    G->ChangeVertex(true, opp)  = Aq;
+    G->ChangeVertex(false, opp) = Aq;
+    G->ChangeVertex(true, ons)  = aPart.CPa;
+    G->ChangeVertex(false, ons) = aPart.CPb;
+    for (int k = 0; k < 2; k++)
+    {
+      ChFiDS_CommonPoint& CP = G->ChangeVertex(k == 0, ons);
+      if (CP.IsOnArc() && (k == 0 ? ip > 1 : ip < aParts.Length()))
+      {
+        TopoDS_Face aFF = aPart.F;
+        aFF.Orientation(TopAbs_FORWARD);
+        const TopoDS_Edge aEInF = edgeInFace(CP.Arc(), aFF);
+        if (aEInF.IsNull())
+        {
+          return false;
+        }
+        const TopAbs_Orientation aTr = k == 0 ? TopAbs::Reverse(TopAbs::Compose(aTra, aEInF.Orientation()))
+                                              : TopAbs::Compose(aTra, aEInF.Orientation());
+        const TopoDS_Edge  anArc = CP.Arc();
+        const double       aW    = CP.ParameterOnArc();
+        const gp_Pnt       aP    = CP.Point();
+        CP.Reset();
+        CP.SetPoint(aP);
+        CP.SetArc(tol3d, anArc, aW, aTr);
+      }
+      const double ta = t1 + (t2 - t1) * (aPart.ua - u1) / (u2 - u1);
+      const double tb = t1 + (t2 - t1) * (aPart.ub - u1) / (u2 - u1);
+      CP.SetParameter(k == 0 ? ta : tb);
+      G->ChangeVertex(k == 0, opp).SetParameter(k == 0 ? ta : tb);
+    }
+    G->FirstSpineParam(t1 + (t2 - t1) * (aPart.ua - u1) / (u2 - u1));
+    G->LastSpineParam(t1 + (t2 - t1) * (aPart.ub - u1) / (u2 - u1));
+    Pieces.Append(G);
+  }
+  return true;
+}
