+//=================================================================================================
+
+bool BRepBlend_RstRstConstRad::BallOnTwoCurves(const gp_Pnt& P1,
+                                               const gp_Vec& T1,
+                                               const gp_Pnt& P2,
+                                               const gp_Vec& T2,
+                                               const double  R,
+                                               const gp_Vec& Side,
+                                               gp_Pnt&       C,
+                                               double&       F)
+{
+  // C = M + v (M the chord's mid-point, v square to the chord u = P2 - P1);
+  // the tangencies (C - P1).T1 = 0 and (C - P2).T2 = 0 are v.t1 = a1 and
+  // v.t2 = a2 for the tangents' unit parts t1, t2 square to the chord. Their
+  // sum (along s = t1 + t2) gives v's part along s, |v| = sqrt(R^2 - |u|^2/4)
+  // the part across; their difference is the residual F, which also holds
+  // where the curves are parallel (t1 = t2: both points in one normal plane).
+  const gp_Vec u(P1, P2);
+  const double nu = u.Magnitude();
+  if (nu < Eps)
+  {
+    return false;
+  }
+  const gp_Vec e1 = u / nu;
+  gp_Vec       t1 = T1 - T1.Dot(e1) * e1;
+  gp_Vec       t2 = T2 - T2.Dot(e1) * e1;
+  const double n1 = t1.Magnitude(), n2 = t2.Magnitude();
+  if (n1 < 1.e-9 * T1.Magnitude() || n2 < 1.e-9 * T2.Magnitude() || n1 < Eps || n2 < Eps)
+  {
+    return false;
+  }
+  double a1 = -0.5 * u.Dot(T1) / n1;
+  double a2 = 0.5 * u.Dot(T2) / n2;
+  t1 /= n1;
+  t2 /= n2;
+  if (t1.Dot(t2) < 0.)
+  {
+    t2.Reverse();
+    a2 = -a2;
+  }
+  gp_Vec       s  = t1 + t2;
+  const double ns = s.Magnitude();
+  s /= ns;
+  const gp_Vec n    = e1.Crossed(s);
+  const double p    = (a1 + a2) / ns;
+  const double rho2 = R * R - 0.25 * nu * nu;
+  double       q = 0., excess = 0.;
+  if (rho2 > p * p)
+  {
+    q = std::sqrt(rho2 - p * p);
+  }
+  else
+  {
+    excess = std::abs(p) - std::sqrt(std::max(rho2, 0.));
+  }
+  if (n.Dot(Side) < 0.)
+  {
+    q = -q;
+  }
+  const gp_Vec v = p * s + q * n;
+  C.SetXYZ(P1.XYZ() + 0.5 * u.XYZ() + v.XYZ());
+  F = v.Dot(t1 - t2) - (a1 - a2) + excess;
+  return true;
+}
