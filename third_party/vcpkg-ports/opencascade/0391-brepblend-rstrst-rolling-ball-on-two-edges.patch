+bool CurvPointRollingValue(const occ::handle<Adaptor3d_Curve>& Guide,
+                           const occ::handle<Adaptor3d_Curve>& Curve2,
+                           const gp_Pnt&                       Point,
+                           const gp_Vec&                       Tangent,
+                           const bool                          PointOnSecond,
+                           const double                        Radius,
+                           const int                           Choix,
+                           const math_Vector&                  X,
+                           math_Vector&                        F)
+{
+  gp_Pnt ptgui, ptcur2;
+  gp_Vec d1gui, d1cur2;
+  Guide->D1(X(1), ptgui, d1gui);
+  Curve2->D1(X(2), ptcur2, d1cur2);
+  if (d1gui.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  // (The ball's side as BRepBlend_RstRstConstRad's: from the first
+  // restriction's point to the second's.)
+  const gp_Pnt& P1    = PointOnSecond ? ptcur2 : Point;
+  const gp_Pnt& P2    = PointOnSecond ? Point : ptcur2;
+  const gp_Vec& T1    = PointOnSecond ? d1cur2 : Tangent;
+  const gp_Vec& T2    = PointOnSecond ? Tangent : d1cur2;
+  const gp_Vec  nplan = d1gui.Normalized();
+  gp_Vec        side  = gp_Vec(P1, P2).Crossed(nplan);
+  if (Choix > 2)
+  {
+    side.Reverse();
+  }
+  gp_Pnt C;
+  double res = 0.;
+  if (!BRepBlend_RstRstConstRad::BallOnTwoCurves(P1, T1, P2, T2, Radius, side, C, res))
+  {
+    return false;
+  }
+  F(1) = nplan.XYZ().Dot(0.5 * (Point.XYZ() + ptcur2.XYZ()) - ptgui.XYZ());
+  F(2) = res;
+  return true;
+}
