+//=================================================================================================
+
+bool BRepBlend_RstRstConstRad::RollingValue(const math_Vector& X, math_Vector& F, gp_Pnt& C)
+{
+  gp_Vec d11, d21;
+  cons1.D1(X(1), ptrst1, d11);
+  cons2.D1(X(2), ptrst2, d21);
+  gp_Vec side = gp_Vec(ptrst1, ptrst2).Crossed(nplan);
+  if (choix > 2)
+  {
+    side.Reverse();
+  }
+  double res = 0.;
+  if (!BallOnTwoCurves(ptrst1, d11, ptrst2, d21, ray, side, C, res))
+  {
+    return false;
+  }
+  F(1) = nplan.XYZ().Dot(0.5 * (ptrst1.XYZ() + ptrst2.XYZ())) + theD;
+  F(2) = res;
+  return true;
+}
+
+//=================================================================================================
+
+bool BRepBlend_RstRstConstRad::RollingDerivatives(const math_Vector& X, math_Matrix& D)
+{
+  math_Vector Xp(X), Xm(X), Fp(1, 2), Fm(1, 2);
+  gp_Pnt      C;
+  for (int j = 1; j <= 2; j++)
+  {
+    const double h = std::max(1.e-7, (j == 1 ? cons1 : cons2).Resolution(1.e-6));
+    Xp      = X;
+    Xm      = X;
+    Xp(j)  += h;
+    Xm(j)  -= h;
+    if (!RollingValue(Xp, Fp, C) || !RollingValue(Xm, Fm, C))
+    {
+      return false;
+    }
+    D(1, j) = (Fp(1) - Fm(1)) / (2. * h);
+    D(2, j) = (Fp(2) - Fm(2)) / (2. * h);
+  }
+  // (The points of X itself.)
+  math_Vector F0(1, 2);
+  return RollingValue(X, F0, center);
+}
+
+//=================================================================================================
+
+gp_Vec BRepBlend_RstRstConstRad::BallPlane(const gp_Pnt& C,
+                                           const gp_Pnt& P1,
+                                           const gp_Pnt& P2,
+                                           const gp_Vec& np) const
+{
+  gp_Vec       bp   = gp_Vec(C, P1).Crossed(gp_Vec(C, P2));
+  const double norm = bp.Magnitude();
+  if (norm < Eps)
+  {
+    return np;
+  }
+  bp /= norm;
+  return bp.Dot(np) < 0. ? -bp : bp;
+}
