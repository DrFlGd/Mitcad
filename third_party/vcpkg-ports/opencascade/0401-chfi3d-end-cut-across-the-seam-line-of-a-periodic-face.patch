+//=======================================================================
+// function : ChFi3d_CutCrossesSeamLine
+// purpose  : Where the curve Pc on the periodic face Fv (from Udeb to Ufin)
+//            crosses the line of the face's seam Seam (an iso-line of the
+//            periodic parameter, up to a period): its parameter T and point
+//            UV there.
+//=======================================================================
+
+static bool ChFi3d_CutCrossesSeamLine(const BRepAdaptor_Surface&       Bs,
+                                      const TopoDS_Face&               Fv,
+                                      const TopoDS_Edge&               Seam,
+                                      const occ::handle<Geom2d_Curve>& Pc,
+                                      const double                     Udeb,
+                                      const double                     Ufin,
+                                      double&                          T,
+                                      gp_Pnt2d&                        UV)
+{
+  if (Pc.IsNull() || Seam.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face F = Fv;
+  F.Orientation(TopAbs_FORWARD);
+  double                          f = 0., l = 0.;
+  const occ::handle<Geom2d_Curve> aSeam2d = BRep_Tool::CurveOnSurface(Seam, F, f, l);
+  if (aSeam2d.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d a = aSeam2d->Value(f), b = aSeam2d->Value(l);
+  for (int dir = 0; dir < 2; dir++)
+  {
+    const bool isU = dir == 0;
+    if (isU ? !Bs.IsUPeriodic() : !Bs.IsVPeriodic())
+    {
+      continue;
+    }
+    const double c0 = isU ? a.X() : a.Y(), c1 = isU ? b.X() : b.Y();
+    if (std::abs(c0 - c1) > Precision::PConfusion())
+    {
+      continue; // (the seam is no iso-line of this parameter)
+    }
+    const auto   coord = [&](const double t) { return isU ? Pc->Value(t).X() : Pc->Value(t).Y(); };
+    const double x0 = coord(Udeb), x1 = coord(Ufin);
+    const double lo = std::min(x0, x1), hi = std::max(x0, x1);
+    const double per = isU ? Bs.UPeriod() : Bs.VPeriod();
+    const double s   = ElCLib::InPeriod(c0, lo, lo + per);
+    if (!(s > lo && s < hi))
+    {
+      continue;
+    }
+    double ta = Udeb, tb = Ufin, ga = x0 - s;
+    for (int it = 0; it < 200 && tb - ta > Precision::PConfusion() * (Ufin - Udeb); it++)
+    {
+      const double tm = 0.5 * (ta + tb), gm = coord(tm) - s;
+      if ((gm < 0.) == (ga < 0.))
+      {
+        ta = tm;
+        ga = gm;
+      }
+      else
+      {
+        tb = tm;
+      }
+    }
+    T  = 0.5 * (ta + tb);
+    UV = Pc->Value(T);
+    return true;
+  }
+  return false;
+}
