+//=======================================================================
+// function : ChFi3d_ContactAtSpineEnd
+// purpose  : Whether a contact of the SurfData's end (its first end with
+//            isfirst) lies at the vertex V (the spine's end vertex).
+//=======================================================================
+
+static bool ChFi3d_ContactAtSpineEnd(const occ::handle<ChFiDS_SurfData>& SD,
+                                     const bool                          isfirst,
+                                     const TopoDS_Vertex&                V)
+{
+  for (int k = 1; k <= 2 && !V.IsNull(); k++)
+  {
+    const ChFiDS_CommonPoint& CP = SD->Vertex(isfirst, k);
+    if (CP.IsVertex() && CP.Vertex().IsSame(V))
+    {
+      return true;
+    }
+  }
+  return false;
+}
