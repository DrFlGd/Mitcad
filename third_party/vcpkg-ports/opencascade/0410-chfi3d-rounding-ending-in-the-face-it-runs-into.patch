+//=======================================================================
+// function : ChFi3d_EndSectionOnFace
+// purpose  : The end section of a stripe that lies in a face at the
+//            corner's vertex other than the blend's two faces: the blend
+//            comes tangent to that face there and runs on into it (e.g. a
+//            vault's end edge rounded with the radius of the rounded
+//            vertical corner under it, the blend overflowing that corner
+//            onto the end wall: at the vault's springing the blend's
+//            section is the corner's own arc). The face at the end is that
+//            face, and the cap is the section itself, not an intersection
+//            of two surfaces tangent along it. An end point that lies on
+//            no arc is given the edge of that face it lies on, an edge of
+//            the blend's face on its side too; an end point at a vertex of
+//            that face is that vertex only, no arc cut there (the faces
+//            beyond keep their edges up to it). ArcSide is the side whose
+//            point lies on an edge of the face at the end (1 or 2).
+//=======================================================================
+
+static bool ChFi3d_EndSectionOnFace(const TopOpeBRepDS_DataStructure&   DStr,
+                                    const occ::handle<ChFiDS_SurfData>& Fd,
+                                    const bool                          isfirst,
+                                    const TopoDS_Vertex&                Vtx,
+                                    ChFiDS_CommonPoint&                 CV1,
+                                    ChFiDS_CommonPoint&                 CV2,
+                                    const ChFiDS_Map&                   VFMap,
+                                    const double                        tol,
+                                    TopoDS_Face&                        Fv,
+                                    int&                                ArcSide)
+{
+  if (!VFMap.Contains(Vtx) || Fd->IndexOfS1() <= 0 || Fd->IndexOfS2() <= 0 || Fd->Surf() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface>& S   = DStr.Surface(Fd->Surf()).Surface();
+  const ChFiDS_FaceInterference&   Fi1 = Fd->InterferenceOnS1();
+  const ChFiDS_FaceInterference&   Fi2 = Fd->InterferenceOnS2();
+  if (S.IsNull() || Fi1.PCurveOnSurf().IsNull() || Fi2.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d     p1 = Fi1.PCurveOnSurf()->Value(Fi1.Parameter(isfirst));
+  const gp_Pnt2d     p2 = Fi2.PCurveOnSurf()->Value(Fi2.Parameter(isfirst));
+  const TopoDS_Shape F1 = DStr.Shape(Fd->IndexOfS1());
+  const TopoDS_Shape F2 = DStr.Shape(Fd->IndexOfS2());
+  for (NCollection_List<TopoDS_Shape>::Iterator itF(VFMap(Vtx)); itF.More(); itF.Next())
+  {
+    TopoDS_Face F = TopoDS::Face(itF.Value());
+    if (F.IsSame(F1) || F.IsSame(F2))
+    {
+      continue;
+    }
+    F.Orientation(TopAbs_FORWARD);
+    // The whole section lies in F.
+    const occ::handle<Geom_Surface> SF = BRep_Tool::Surface(F);
+    bool                            on = !SF.IsNull();
+    for (int k = 0; k <= 4 && on; k++)
+    {
+      const gp_Pnt2d             uv = p1.XY() + (p2.XY() - p1.XY()) * (0.25 * k);
+      const gp_Pnt               P  = S->Value(uv.X(), uv.Y());
+      GeomAPI_ProjectPointOnSurf aPr(P, SF);
+      on = aPr.NbPoints() > 0 && aPr.LowerDistance() <= tol;
+      if (on && k == 2)
+      {
+        double u = 0., v = 0.;
+        aPr.LowerDistanceParameters(u, v);
+        BRepClass_FaceClassifier aCl(F, gp_Pnt2d(u, v), tol);
+        on = aCl.State() == TopAbs_IN || aCl.State() == TopAbs_ON;
+      }
+    }
+    if (!on)
+    {
+      continue;
+    }
+    // Each end point: at a vertex of F, on an edge of F, or put on the edge
+    // of F it lies on (an edge of the blend's face on that side too).
+    TopoDS_Edge        anArc[2];
+    double             aW[2]  = {0., 0.};
+    TopAbs_Orientation aTr[2] = {TopAbs_FORWARD, TopAbs_FORWARD};
+    int                aSide  = 0;
+    bool               ok     = true;
+    for (int j = 1; j <= 2 && ok; j++)
+    {
+      const ChFiDS_CommonPoint& CV = j == 1 ? CV1 : CV2;
+      if (CV.IsVertex())
+      {
+        bool inF = false;
+        for (TopExp_Explorer ex(F, TopAbs_VERTEX); ex.More() && !inF; ex.Next())
+        {
+          inF = ex.Current().IsSame(CV.Vertex());
+        }
+        ok = inF;
+        continue;
+      }
+      if (CV.IsOnArc())
+      {
+        bool inF = false;
+        for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More() && !inF; ex.Next())
+        {
+          inF = ex.Current().IsSame(CV.Arc());
+        }
+        ok = inF;
+        if (inF && aSide == 0)
+        {
+          aSide = j;
+        }
+        continue;
+      }
+      TopoDS_Face Fj = TopoDS::Face(j == 1 ? F1 : F2);
+      Fj.Orientation(TopAbs_FORWARD);
+      ok = false;
+      for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More() && !ok; ex.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+        if (BRep_Tool::Degenerated(E))
+        {
+          continue;
+        }
+        TopoDS_Edge EinFj;
+        for (TopExp_Explorer exj(Fj, TopAbs_EDGE); exj.More() && EinFj.IsNull(); exj.Next())
+        {
+          if (exj.Current().IsSame(E))
+          {
+            EinFj = TopoDS::Edge(exj.Current());
+          }
+        }
+        if (EinFj.IsNull())
+        {
+          continue;
+        }
+        double                         f = 0., l = 0.;
+        const occ::handle<Geom_Curve>& C = BRep_Tool::Curve(E, f, l);
+        if (C.IsNull())
+        {
+          continue;
+        }
+        GeomAPI_ProjectPointOnCurve aPr(CV.Point(), C, f, l);
+        if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tol)
+        {
+          continue;
+        }
+        // The contact enters Fj across E at the first end, leaves it at the
+        // last.
+        const ChFiDS_FaceInterference& Fij = j == 1 ? Fi1 : Fi2;
+        const TopAbs_Orientation       Tr  = TopAbs::Compose(Fij.Transition(), EinFj.Orientation());
+        anArc[j - 1] = E;
+        aW[j - 1]    = aPr.LowerDistanceParameter();
+        aTr[j - 1]   = isfirst ? TopAbs::Reverse(Tr) : Tr;
+        ok           = true;
+        if (aSide == 0)
+        {
+          aSide = j;
+        }
+      }
+    }
+    if (!ok || aSide == 0)
+    {
+      continue;
+    }
+    for (int j = 1; j <= 2; j++)
+    {
+      ChFiDS_CommonPoint& CV = j == 1 ? CV1 : CV2;
+      if (!anArc[j - 1].IsNull())
+      {
+        CV.SetArc(tol, anArc[j - 1], aW[j - 1], aTr[j - 1]);
+      }
+      else if (CV.IsVertex())
+      {
+        // A point at the vertex: no arc of it is cut there (the faces beyond
+        // keep their edges at the vertex).
+        const TopoDS_Vertex aV  = CV.Vertex();
+        const gp_Pnt        aP  = CV.Point();
+        const double        aTl = CV.Tolerance();
+        const double        aPr = CV.Parameter();
+        const bool          aHV = CV.HasVector();
+        const gp_Vec        aVc = aHV ? CV.Vector() : gp_Vec();
+        CV.Reset();
+        CV.SetVertex(aV);
+        CV.SetPoint(aP);
+        CV.SetTolerance(aTl);
+        CV.SetParameter(aPr);
+        if (aHV)
+        {
+          CV.SetVector(aVc);
+        }
+      }
+    }
+    Fv      = F;
+    ArcSide = aSide;
+    return true;
+  }
+  return false;
+}
