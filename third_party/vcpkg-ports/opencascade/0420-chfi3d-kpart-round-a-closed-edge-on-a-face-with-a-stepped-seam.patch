+//=======================================================================
+// function : DomainsIntoPeriod
+// purpose  : A blend round a spine closed by its one edge has the edge's
+//            parameters, one period round it. Its tangency line on a face
+//            periodic along it (a line on a cylinder) is hatched where the
+//            face's parametric domain lies, which is a period before or
+//            after the blend's own parameters where the face's seam is not
+//            one straight line (two faces of one cylinder whose seams lay
+//            at different angles, merged: a seam of steps). Then the
+//            spine's parameters of the pieces came out wrong and the stripe
+//            failed. The line is moved by those whole periods of the face's
+//            surface (the same points), and its domains with it, so that
+//            they lie in the blend's period.
+//=======================================================================
+
+static void DomainsIntoPeriod(Geom2dHatch_Hatcher&                  H,
+                              const int                             iH,
+                              const int                             Nb,
+                              ChFiDS_FaceInterference&              FI,
+                              occ::handle<Geom2d_Curve>&            C,
+                              const occ::handle<Adaptor3d_Surface>& S,
+                              const double                          First,
+                              const double                          Period,
+                              const double                          Tol)
+{
+  if (Period <= Tol || Nb < 1 || !H.IsDone(iH) || H.NbDomains(iH) < Nb
+      || occ::down_cast<Geom2d_Line>(C).IsNull())
+  {
+    return;
+  }
+  double aMin = RealLast(), aMax = RealFirst();
+  for (int i = 1; i <= Nb; i++)
+  {
+    const HatchGen_Domain& aDom = H.Domain(iH, i);
+    if (!aDom.HasFirstPoint() || !aDom.HasSecondPoint())
+    {
+      return;
+    }
+    aMin = std::min(aMin, aDom.FirstPoint().Parameter());
+    aMax = std::max(aMax, aDom.SecondPoint().Parameter());
+  }
+  // (Domains across the start of the period, as where the seam is
+  // straight but the spine's vertex is not on it, stay as they are.)
+  const double aShift = std::floor((0.5 * (aMin + aMax) - First) / Period) * Period;
+  if (aShift == 0.)
+  {
+    return;
+  }
+  // The line moved by the shift lies on the same points of the surface
+  // when the move is whole periods of it.
+  const gp_Vec2d aV(C->Value(First), C->Value(First + aShift));
+  const double   aUP    = S->IsUPeriodic() ? S->UPeriod() : 0.;
+  const double   aVP    = S->IsVPeriodic() ? S->VPeriod() : 0.;
+  const auto     aWhole = [Tol](const double x, const double p) {
+    return p > 0. ? std::abs(x - p * std::round(x / p)) <= Tol : std::abs(x) <= Tol;
+  };
+  if (!aWhole(aV.X(), aUP) || !aWhole(aV.Y(), aVP))
+  {
+    return;
+  }
+  for (int i = 1; i <= Nb; i++)
+  {
+    HatchGen_Domain*         aD = (HatchGen_Domain*)(void*)&H.Domain(iH, i);
+    HatchGen_PointOnHatching aP1(aD->FirstPoint());
+    HatchGen_PointOnHatching aP2(aD->SecondPoint());
+    aP1.SetParameter(aP1.Parameter() - aShift);
+    aP2.SetParameter(aP2.Parameter() - aShift);
+    aD->SetPoints(aP1, aP2);
+  }
+  C                       = occ::down_cast<Geom2d_Curve>(C->Translated(aV));
+  FI.ChangePCurveOnFace() = C;
+}
