+NCollection_List<occ::handle<ChFiDS_Stripe>> ChFi3d_Builder::RollsInsteadOfOverflow()
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>> again;
+  const TopOpeBRepDS_DataStructure&            DStr = myDS->DS();
+  const double                                 tol  = 10. * tolapp3d;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itA(myListStripe); itA.More();
+       itA.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& A = itA.Value();
+    if (A->SetOfSurfData().IsNull() || occ::down_cast<ChFiDS_FilSpine>(A->Spine()).IsNull())
+    {
+      continue;
+    }
+    for (int i = 1; i <= A->SetOfSurfData()->Length(); i++)
+    {
+      const occ::handle<ChFiDS_SurfData>& a = A->SetOfSurfData()->Value(i);
+      for (int ka = 1; ka <= 2; ka++)
+      {
+        if (a->Index(ka) <= 0 || a->IsOnCurve(ka))
+        {
+          continue;
+        }
+        // (Only a face A reached across a narrow face of its edge.)
+        const TopoDS_Face F = TopoDS::Face(DStr.Shape(a->Index(ka)));
+        if (!spineEdgeOf(A->Spine(), F).IsNull() || RollsBefore(A, F))
+        {
+          continue;
+        }
+        bool across = false;
+        for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB(myListStripe);
+             itB.More() && !across;
+             itB.Next())
+        {
+          const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+          if (B == A || B->SetOfSurfData().IsNull())
+          {
+            continue;
+          }
+          for (int j = 1; j <= B->SetOfSurfData()->Length() && !across; j++)
+          {
+            const occ::handle<ChFiDS_SurfData>& b = B->SetOfSurfData()->Value(j);
+            for (int kb = 1; kb <= 2 && !across; kb++)
+            {
+              if (b->Index(kb) != a->Index(ka) || b->IsOnCurve(kb))
+              {
+                continue;
+              }
+              // B's edge: the one of its spine on F, else the one nearest to
+              // B's contact there.
+              TopoDS_Edge EB = spineEdgeOf(B->Spine(), F);
+              if (EB.IsNull())
+              {
+                const gp_Pnt Pb = b->Vertex(true, kb).Point().Translated(
+                  0.5 * gp_Vec(b->Vertex(true, kb).Point(), b->Vertex(false, kb).Point()));
+                EB = nearestSpineEdge(B->Spine(), Pb);
+              }
+              across = !EB.IsNull() && contactBeyond(DStr, a, ka, b, kb, EB, tol);
+            }
+          }
+        }
+        if (across)
+        {
+          myRollStripes.Append(A);
+          myRollFaces.Append(F);
+          if (!again.Contains(A))
+          {
+            again.Append(A);
+          }
+        }
+      }
+    }
+  }
+  return again;
+}
+
+bool ChFi3d_Builder::RollsBefore(const occ::handle<ChFiDS_Stripe>& S, const TopoDS_Shape& F) const
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myRollStripes);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myRollFaces);
+  for (; itS.More(); itS.Next(), itF.Next())
+  {
+    if (itS.Value() == S && itF.Value().IsSame(F))
+    {
+      return true;
+    }
+  }
+  return false;
+}
