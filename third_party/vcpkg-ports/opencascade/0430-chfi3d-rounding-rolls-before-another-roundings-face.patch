+// Whether the faces F1 and F2 of edge E meet at an angle at its parameter W
+// (their normals apart by more than convexAt's tangency, and not folded
+// back): a ball can roll on the edge there.
+static bool sharpAt(const TopoDS_Edge& E, const TopoDS_Face& F1, const TopoDS_Face& F2, const double W)
+{
+  double                          f, l;
+  const occ::handle<Geom2d_Curve> C1 = BRep_Tool::CurveOnSurface(E, F1, f, l);
+  const occ::handle<Geom2d_Curve> C2 = BRep_Tool::CurveOnSurface(E, F2, f, l);
+  if (C1.IsNull() || C2.IsNull() || F1.IsSame(F2))
+  {
+    return false;
+  }
+  gp_Vec N[2];
+  for (int k = 0; k < 2; k++)
+  {
+    const TopoDS_Face&              F  = k == 0 ? F1 : F2;
+    const gp_Pnt2d                  uv = (k == 0 ? C1 : C2)->Value(W);
+    const occ::handle<Geom_Surface> S  = BRep_Tool::Surface(F);
+    gp_Pnt                          P;
+    gp_Vec                          DU, DV;
+    S->D1(uv.X(), uv.Y(), P, DU, DV);
+    N[k] = DU.Crossed(DV);
+    if (N[k].SquareMagnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    N[k].Normalize();
+    if (F.Orientation() == TopAbs_REVERSED)
+    {
+      N[k].Reverse();
+    }
+  }
+  return N[0].Crossed(N[1]).Magnitude() >= 1.e-4;
+}
