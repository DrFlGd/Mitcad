+// The edge of spine Sp nearest to point P (within its bounds), or a null
+// edge.
+static TopoDS_Edge nearestSpineEdge(const occ::handle<ChFiDS_Spine>& Sp, const gp_Pnt& P)
+{
+  TopoDS_Edge aBest;
+  double      aBestD = RealLast();
+  for (int i = 1; i <= Sp->NbEdges(); i++)
+  {
+    const double d = distanceToEdge(P, Sp->Edges(i));
+    if (d < aBestD)
+    {
+      aBestD = d;
+      aBest  = Sp->Edges(i);
+    }
+  }
+  return aBest;
+}
