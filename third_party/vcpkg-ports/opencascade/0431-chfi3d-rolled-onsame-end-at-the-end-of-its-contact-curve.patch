SPDX-License-Identifier: LGPL-2.1-only WITH OCCT-exception-1.0

Fillets: the OnSame end of a blend rolling on an edge (0170) that ends
where that edge does, on the face at the end (mitcad#339): the blend's
contact curve on its other face is bounded there, and its intersection
with the face at the end, at the curve's end, came out 6e-15 past the
curve's last parameter; it was not taken, and the corner failed ("bouchon
non ecrit"). IntersUpdateOnSame's Update now takes an intersection within
the curve's parametric resolution of its bounds (at least
Precision::PConfusion), at the bound.
diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_C1.cxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_C1.cxx
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_C1.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_C1.cxx
@@ -221,6 +221,10 @@ static bool Update(const occ::handle<Adaptor3d_Surface>& fb,
     int    nbp = Intersection.NbPoints(), i, isol = 0, isolbis = 0;
     double dist    = Precision::Infinite();
     double distbis = Precision::Infinite();
+    // (A point at an end of the curve within its parametric resolution: a
+    // blend rolling on an edge ends where the edge does, on the face at the
+    // end, its contact curves bounded there.)
+    const double tolw = std::max(Precision::PConfusion(), ct->Resolution(Precision::Confusion()));
     for (i = 1; i <= nbp; i++)
     {
       w = Intersection.Point(i).W();
@@ -228,7 +232,7 @@ static bool Update(const occ::handle<Adaptor3d_Surface>& fb,
       {
         w = recadre(w, wop, isfirst, uf, ul);
       }
-      if (uf <= w && ul >= w && std::abs(w - wop) < dist)
+      if (uf - tolw <= w && ul + tolw >= w && std::abs(w - wop) < dist)
       {
         isol = i;
         dist = std::abs(w - wop);
@@ -288,6 +292,10 @@ static bool Update(const occ::handle<Adaptor3d_Surface>& fb,
       {
         w = ElCLib::InPeriod(w, uf, ul);
       }
+      else
+      {
+        w = std::min(std::max(w, uf), ul);
+      }
     }
     else
     {
