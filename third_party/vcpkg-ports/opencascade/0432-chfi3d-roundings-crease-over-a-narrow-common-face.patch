Fillets: roundings of edges meeting at an angle over a common face narrower
than the radius (mitcad#339): e.g. a box's rim with an inner lip whose
bottom edge, lines and corner arcs meeting at 53 degrees, is rounded with 4
over a ring 1 wide under the lip and a chamfer beyond it. Each rounding ran
over the ring onto the chamfer (0011's edge overflow), the lines' onto its
planes and the arcs' onto its cones, and at each corner the two had no face
in common; OCCT's corner of two roundings failed ("Trying to check
orientation of NULL face", "Failed to find edge"). The stored designs' blends
roll on the ring's far edges and meet in a crease from the lip's vertical
edge down to the ring's corner.

- ChFi3d_Builder::RollsInsteadOfOverflow (0430) also takes, at a vertex of
  two stripes whose edges bound a common face, the faces beyond it that
  both overflowed onto, where those are different faces (the common face
  consumed by both): each such side rolls on the edge before them.
- ChFi3d_IsInFront compares the sides' faces only where a side has one: two
  sides on no face (given up past the spine's end, index 0) were taken for a
  common face and threw.
- ChFi3d_FilBuilder::PerformTwoRolledCorner, tried first in PerformTwoCorner:
  two stripes each rolling on an edge on one side, the two edges meeting at
  a vertex V2 of their own, their other sides on the faces of an edge
  through the corner's vertex (the pivot) at one point of it. The crease is
  the intersection of the two blends' surfaces from that point to V2, which
  both pass through; each stripe ends on it as in PerformTwoCornerbyInter's
  bevel, the rolled sides in the common face's place, their point the vertex
  V2 on the rolled edge (the obstacle's end, CutEdge), the pivot's side's
  parameter at the pivot's point on its contact.
- A walked blend that does not reach V2 (a ball touching a cylinder or a
  plane and rolling on a circle about its axis: the arcs' blends) is made
  the torus it is (ChFi3d_ExactRollOnCircle): where the walked contacts lie
  on the exact circles within 1e-3 (the middle and most of them; past the
  spine's end the walk runs off its face), the surface becomes a patch of
  the torus round the blend as a B-spline surface in the walked surface's
  layout (along the blend where the guide's parameter is, across it from the
  same side to the other: the same normal, sides and transitions), its
  contacts that surface's iso curves with p-curves projected onto the faces
  in their walked periods, the parameters along it; only for a stripe of one
  surface data with no corner at its other end yet.
diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx
@@ -717,6 +717,128 @@ NCollection_List<occ::handle<ChFiDS_Stripe>> ChFi3d_Builder::RollsInsteadOfOverf
       }
     }
   }
+  // Two stripes meeting at a vertex whose edges there bound a common face
+  // that both overflowed onto different faces beyond it (the face narrower
+  // than both roundings, consumed by both): no face is left for their
+  // corner. Both roll on the far edges of that face instead, and meet at its
+  // far vertex (PerformTwoRolledCorner).
+  for (int iv = 1; iv <= myVDataMap.Extent(); iv++)
+  {
+    const NCollection_List<occ::handle<ChFiDS_Stripe>>& aL = myVDataMap(iv);
+    if (aL.Extent() != 2 || aL.First() == aL.Last())
+    {
+      continue;
+    }
+    const TopoDS_Vertex&       V = myVDataMap.FindKey(iv);
+    occ::handle<ChFiDS_Stripe> S[2] = {aL.First(), aL.Last()};
+    TopoDS_Edge                E[2];
+    bool                       ok = true;
+    for (int k = 0; k < 2 && ok; k++)
+    {
+      const occ::handle<ChFiDS_Spine>& Sp = S[k]->Spine();
+      ok = !S[k]->SetOfSurfData().IsNull() && !occ::down_cast<ChFiDS_FilSpine>(Sp).IsNull()
+           && !Sp->IsPeriodic();
+      if (ok)
+      {
+        E[k] = Sp->FirstVertex().IsSame(V) ? Sp->Edges(1)
+               : Sp->LastVertex().IsSame(V) ? Sp->Edges(Sp->NbEdges())
+                                            : TopoDS_Edge();
+        ok   = !E[k].IsNull() && myEFMap.Contains(E[k]);
+      }
+    }
+    if (!ok)
+    {
+      continue;
+    }
+    // The common face of the two edges.
+    TopoDS_Face F;
+    for (NCollection_List<TopoDS_Shape>::Iterator it0(myEFMap(E[0])); it0.More() && F.IsNull(); it0.Next())
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator it1(myEFMap(E[1])); it1.More(); it1.Next())
+      {
+        if (it0.Value().IsSame(it1.Value()))
+        {
+          F = TopoDS::Face(it0.Value());
+          break;
+        }
+      }
+    }
+    if (F.IsNull())
+    {
+      continue;
+    }
+    const int iF = DStr.HasShape(F) ? DStr.Shape(F) : 0;
+    // Each stripe's faces beyond F: the faces its sides lie on that are not
+    // faces of its spine's edges and share an edge with F.
+    NCollection_List<TopoDS_Shape> beyond[2];
+    for (int k = 0; k < 2 && ok; k++)
+    {
+      for (int i = 1; i <= S[k]->SetOfSurfData()->Length() && ok; i++)
+      {
+        const occ::handle<ChFiDS_SurfData>& sd = S[k]->SetOfSurfData()->Value(i);
+        for (int ks = 1; ks <= 2 && ok; ks++)
+        {
+          if (sd->Index(ks) <= 0 || sd->IsOnCurve(ks))
+          {
+            continue;
+          }
+          if (sd->Index(ks) == iF)
+          {
+            ok = false; // (F is not consumed.)
+            break;
+          }
+          const TopoDS_Face G = TopoDS::Face(DStr.Shape(sd->Index(ks)));
+          if (!spineEdgeOf(S[k]->Spine(), G).IsNull() || beyond[k].Contains(G))
+          {
+            continue;
+          }
+          bool adjacent = false;
+          for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More() && !adjacent; ex.Next())
+          {
+            if (!myEFMap.Contains(ex.Current()))
+            {
+              continue;
+            }
+            for (NCollection_List<TopoDS_Shape>::Iterator itG(myEFMap(ex.Current())); itG.More(); itG.Next())
+            {
+              adjacent = adjacent || itG.Value().IsSame(G);
+            }
+          }
+          if (adjacent)
+          {
+            beyond[k].Append(G);
+          }
+        }
+      }
+    }
+    if (!ok || beyond[0].IsEmpty() || beyond[1].IsEmpty())
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itG(beyond[0]); itG.More() && ok; itG.Next())
+    {
+      ok = !beyond[1].Contains(itG.Value());
+    }
+    if (!ok)
+    {
+      continue;
+    }
+    for (int k = 0; k < 2; k++)
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator itG(beyond[k]); itG.More(); itG.Next())
+      {
+        if (!RollsBefore(S[k], itG.Value()))
+        {
+          myRollStripes.Append(S[k]);
+          myRollFaces.Append(itG.Value());
+        }
+      }
+      if (!again.Contains(S[k]))
+      {
+        again.Append(S[k]);
+      }
+    }
+  }
   return again;
 }
 
