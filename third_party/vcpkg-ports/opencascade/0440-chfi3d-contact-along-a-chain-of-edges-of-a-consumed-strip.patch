+// The inner vertex of face F nearest to the start of the contact curve C on
+// [T1, T2] where C runs along a chain of edges of F end to end (not edges
+// of the spine): a vertex V of F strictly inside the contact, on C within
+// Tol, whose two edges in F both lie along C. Its parameter on C in tV.
+static TopoDS_Vertex chainVertexOnContact(const occ::handle<Geom_Curve>&   C,
+                                          const double                     T1,
+                                          const double                     T2,
+                                          const TopoDS_Face&               F,
+                                          const occ::handle<ChFiDS_Spine>& Spine,
+                                          const double                     Tol,
+                                          double&                          tV)
+{
+  const double tmin = std::min(T1, T2), tmax = std::max(T1, T2);
+  // Whether edge E lies on C (on its whole curve: the first and the last
+  // edge of the chain may go on past the contact's ends).
+  const auto along = [&](const TopoDS_Edge& E) {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(E, f, l);
+    if (aCE.IsNull())
+    {
+      return false;
+    }
+    for (int i = 0; i <= 8; i++)
+    {
+      GeomAPI_ProjectPointOnCurve aProj(aCE->Value(f + (l - f) * i / 8.), C);
+      if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+      {
+        return false;
+      }
+    }
+    return true;
+  };
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher> aVE;
+  TopExp::MapShapesAndAncestors(F, TopAbs_VERTEX, TopAbs_EDGE, aVE);
+  TopoDS_Vertex aBest;
+  double        aBestDist = RealLast();
+  for (int iv = 1; iv <= aVE.Extent(); iv++)
+  {
+    const TopoDS_Vertex&        V = TopoDS::Vertex(aVE.FindKey(iv));
+    GeomAPI_ProjectPointOnCurve aProj(BRep_Tool::Pnt(V), C, tmin, tmax);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      continue;
+    }
+    const double t = aProj.LowerDistanceParameter();
+    if (t <= tmin + Precision::PConfusion() || t >= tmax - Precision::PConfusion())
+    {
+      continue;
+    }
+    NCollection_List<TopoDS_Shape> anEdges;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(aVE(iv)); it.More(); it.Next())
+    {
+      bool onSpine = BRep_Tool::Degenerated(TopoDS::Edge(it.Value()));
+      for (int ie = 1; ie <= Spine->NbEdges() && !onSpine; ie++)
+      {
+        onSpine = Spine->Edges(ie).IsSame(it.Value());
+      }
+      if (onSpine)
+      {
+        anEdges.Clear();
+        break;
+      }
+      if (!containsSame(anEdges, it.Value()))
+      {
+        anEdges.Append(it.Value());
+      }
+    }
+    if (anEdges.Extent() != 2 || !along(TopoDS::Edge(anEdges.First())) || !along(TopoDS::Edge(anEdges.Last())))
+    {
+      continue;
+    }
+    const double aDist = std::abs(t - T1);
+    if (aDist < aBestDist)
+    {
+      aBestDist = aDist;
+      aBest     = V;
+      tV        = t;
+    }
+  }
+  return aBest;
+}
