+//=======================================================================
+// function : TangentIntoEndFace
+// purpose  : At an end of the walk both contacts reached an edge of their
+//            face: this side's edge goes on tangentially into face Fvoi,
+//            the other side's edge is sharp (no face goes on beyond it) and
+//            bounds the same face Fvoi. Fvoi is then the face at the end on
+//            both sides (a rounding along an edge of a face that turns
+//            tangentially into the face at the end): the walk ends there,
+//            not on that face.
+//=======================================================================
+
+static bool TangentIntoEndFace(const TopoDS_Face&        Fvoi,
+                               const ChFiDS_CommonPoint& Other,
+                               const bool                otherEnds,
+                               const TopoDS_Vertex&      Vend,
+                               const ChFiDS_Map&         EFMap,
+                               const ChFiDS_Map&         VFMap)
+{
+  if (Fvoi.IsNull() || !otherEnds || !Other.IsOnArc() || Other.IsVertex() || Vend.IsNull()
+      || !EFMap.Contains(Other.Arc()) || !VFMap.Contains(Vend))
+  {
+    return false;
+  }
+  // (Fvoi is a face at the spine's end: it holds the end vertex.)
+  bool atEnd = false;
+  for (const TopoDS_Shape& aFace : VFMap.FindFromKey(Vend))
+  {
+    atEnd = atEnd || aFace.IsSame(Fvoi);
+  }
+  if (!atEnd)
+  {
+    return false;
+  }
+  for (const TopoDS_Shape& aFace : EFMap.FindFromKey(Other.Arc()))
+  {
+    if (aFace.IsSame(Fvoi))
+    {
+      return true;
+    }
+  }
+  return false;
+}
