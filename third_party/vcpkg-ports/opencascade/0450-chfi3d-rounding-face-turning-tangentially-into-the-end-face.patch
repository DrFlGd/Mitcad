+//=======================================================================
+// function : ChFi3d_ContactSpeed
+// purpose  : How fast the contact points of a walked section run along
+//            the guide (infinitely at a tangency point).
+//=======================================================================
+
+static double ChFi3d_ContactSpeed(const Blend_Point& P)
+{
+  return P.IsTangencyPoint() ? RealLast()
+                             : std::max(P.TangentOnS1().Magnitude(), P.TangentOnS2().Magnitude());
+}
+
+//=======================================================================
+// function : ChFi3d_RegularUpToArc
+// purpose  : The walked line ends (atEnd) or starts with a contact on an
+//            edge of its face, and where it runs past the spine's end
+//            into the guide's straight extension its contacts run less
+//            than four times as fast along the guide as at the spine's
+//            end: the sections up to that edge are regular, and the blend
+//            ends there, where the face at the end cuts it.
+//=======================================================================
+
+static bool ChFi3d_RegularUpToArc(const occ::handle<BRepBlend_Line>& Lin,
+                                  const occ::handle<ChFiDS_Spine>&   Spine,
+                                  const bool                         atEnd)
+{
+  if (Lin.IsNull() || Spine.IsNull() || Spine->IsPeriodic() || Lin->NbPoints() < 2)
+  {
+    return false;
+  }
+  const int nb = Lin->NbPoints();
+  const auto OnArcAt = [](const BRepBlend_Extremity& theEnd, const double theW) {
+    return theEnd.NbPointOnRst() > 0
+           && std::abs(theEnd.ParameterOnGuide() - theW) <= Precision::PConfusion();
+  };
+  const double w = Lin->Point(atEnd ? nb : 1).Parameter();
+  if (atEnd ? !(OnArcAt(Lin->EndPointOnFirst(), w) || OnArcAt(Lin->EndPointOnSecond(), w))
+            : !(OnArcAt(Lin->StartPointOnFirst(), w) || OnArcAt(Lin->StartPointOnSecond(), w)))
+  {
+    return false;
+  }
+  // The last point within the spine, and the points past it.
+  const double SpF = Spine->FirstParameter(1);
+  const double SpL = Spine->LastParameter(Spine->NbEdges());
+  int          i0  = 0;
+  if (atEnd)
+  {
+    for (int i = 1; i <= nb && Lin->Point(i).Parameter() <= SpL; i++)
+    {
+      i0 = i;
+    }
+  }
+  else
+  {
+    for (int i = nb; i >= 1 && Lin->Point(i).Parameter() >= SpF; i--)
+    {
+      i0 = i;
+    }
+  }
+  if (i0 == 0)
+  {
+    return false;
+  }
+  const double v0 = ChFi3d_ContactSpeed(Lin->Point(i0));
+  if (v0 >= RealLast())
+  {
+    return false;
+  }
+  const int step = atEnd ? 1 : -1;
+  for (int i = i0 + step; i >= 1 && i <= nb; i += step)
+  {
+    if (ChFi3d_ContactSpeed(Lin->Point(i)) >= 4. * v0)
+    {
+      return false;
+    }
+  }
+  return true;
+}
