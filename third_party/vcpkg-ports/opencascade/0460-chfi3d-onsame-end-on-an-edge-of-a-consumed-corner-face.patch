+//=======================================================================
+// function : ChFi3d_EndSectionAlongEdge
+// purpose  : OnSame end of a stripe whose end section is the edge Arcprol
+//            of the face at the end Fv: the blend ends where the face
+//            beyond Arcprol (Fend) is a rounding of the blend's radius
+//            along the edge before it (e.g. a foot rounding running on
+//            into the rounded foot of the side of the same radius, where
+//            the ball fits that rounding), so its section there is that
+//            rounding's end edge, from the corner's vertex to the other
+//            vertex of Arcprol, where the opposite contact ends. Fv, the
+//            corner face between them (its other edges on the spine or
+//            shared with the opposite face Fop), lies wholly between the
+//            contacts: the blend consumes it. The blend is tangent to Fv
+//            and to Fend all along that edge, so their intersection is
+//            singular; the cap is Arcprol itself, on Fend.
+//=======================================================================
+
+static bool ChFi3d_EndSectionAlongEdge(const TopOpeBRepDS_DataStructure&   DStr,
+                                       const occ::handle<ChFiDS_SurfData>& Fd,
+                                       const bool                          isfirst,
+                                       const int                           IFadArc,
+                                       const TopoDS_Vertex&                Vtx,
+                                       const TopoDS_Face&                  Fv,
+                                       const TopoDS_Face&                  Fop,
+                                       const TopoDS_Edge&                  Arcprol,
+                                       const occ::handle<ChFiDS_Spine>&    Spine,
+                                       const ChFiDS_Map&                   EFMap,
+                                       const double                        tol,
+                                       TopoDS_Face&                        Fend,
+                                       TopoDS_Vertex&                      V2)
+{
+  if (Arcprol.IsNull() || Fv.IsNull() || Fd->Surf() <= 0 || !EFMap.Contains(Arcprol))
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint& CPad = Fd->Vertex(isfirst, IFadArc);
+  const ChFiDS_CommonPoint& CPop = Fd->Vertex(isfirst, 3 - IFadArc);
+  if (!CPad.IsVertex() || !CPad.Vertex().IsSame(Vtx))
+  {
+    return false;
+  }
+  // The blend's faces are not Fv: it lies between the contacts.
+  for (int k = 1; k <= 2; k++)
+  {
+    if (Fd->Index(k) <= 0 || DStr.Shape(Fd->Index(k)).IsSame(Fv))
+    {
+      return false;
+    }
+  }
+  // The other vertex of Arcprol, where the opposite contact ends.
+  TopoDS_Vertex aV1, aV2;
+  TopExp::Vertices(Arcprol, aV1, aV2);
+  const TopoDS_Vertex aOther = aV1.IsSame(Vtx) ? aV2 : aV1;
+  if (aOther.IsNull() || aOther.IsSame(Vtx))
+  {
+    return false;
+  }
+  const double aTolV = std::max(tol, BRep_Tool::Tolerance(aOther));
+  if (CPop.Point().Distance(BRep_Tool::Pnt(aOther)) > aTolV)
+  {
+    return false;
+  }
+  // The face beyond Arcprol.
+  TopoDS_Face aFend;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Arcprol)); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(Fv))
+    {
+      aFend = TopoDS::Face(it.Value());
+    }
+  }
+  if (aFend.IsNull() || aFend.IsSame(Fop))
+  {
+    return false;
+  }
+  // Fv's edges: Arcprol, edges of the spine and edges shared with Fop.
+  for (TopExp_Explorer ex(Fv, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (E.IsSame(Arcprol) || BRep_Tool::Degenerated(E))
+    {
+      continue;
+    }
+    bool ok = false;
+    for (int ie = 1; ie <= Spine->NbEdges() && !ok; ie++)
+    {
+      ok = Spine->Edges(ie).IsSame(E);
+    }
+    if (!ok && EFMap.Contains(E))
+    {
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More() && !ok; it.Next())
+      {
+        ok = it.Value().IsSame(Fop);
+      }
+    }
+    if (!ok)
+    {
+      return false;
+    }
+  }
+  // The end section lies on Arcprol.
+  const occ::handle<Geom_Surface>& S   = DStr.Surface(Fd->Surf()).Surface();
+  const ChFiDS_FaceInterference&   Fi1 = Fd->InterferenceOnS1();
+  const ChFiDS_FaceInterference&   Fi2 = Fd->InterferenceOnS2();
+  if (S.IsNull() || Fi1.PCurveOnSurf().IsNull() || Fi2.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  double                         f = 0., l = 0.;
+  const occ::handle<Geom_Curve>& C = BRep_Tool::Curve(Arcprol, f, l);
+  if (C.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d p1 = Fi1.PCurveOnSurf()->Value(Fi1.Parameter(isfirst));
+  const gp_Pnt2d p2 = Fi2.PCurveOnSurf()->Value(Fi2.Parameter(isfirst));
+  for (int k = 1; k <= 3; k++)
+  {
+    const gp_Pnt2d              uv = p1.XY() + (p2.XY() - p1.XY()) * (0.25 * k);
+    GeomAPI_ProjectPointOnCurve aPr(S->Value(uv.X(), uv.Y()), C, f, l);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tol)
+    {
+      return false;
+    }
+  }
+  Fend = aFend;
+  V2   = aOther;
+  return true;
+}
