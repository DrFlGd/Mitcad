+//=======================================================================
+// function : ChFi3d_SplitPieceAtSection
+// purpose  : Splits piece Fd of an analytic blend at the section through
+//            the spine's point at Ws: Fd keeps the part before, the piece
+//            returned the part after. Both are on the same blend surface
+//            (one face, no section between them, ChFi3d_FilDS); each line
+//            is cut where it crosses the plane square to the spine at Ws.
+//            Null where a line does not cross it inside the piece, or,
+//            with OnSeamOnly, where no line crosses it on a seam of its
+//            face.
+//=======================================================================
+
+static occ::handle<ChFiDS_SurfData> ChFi3d_SplitPieceAtSection(TopOpeBRepDS_DataStructure&         DStr,
+                                                               const occ::handle<ChFiDS_Spine>&    Spine,
+                                                               const occ::handle<ChFiDS_SurfData>& Fd,
+                                                               const double                        Ws,
+                                                               const bool                          OnSeamOnly)
+{
+  const double W1 = Fd->FirstSpineParam(), W2 = Fd->LastSpineParam();
+  if (Ws <= W1 + Precision::PConfusion() || Ws >= W2 - Precision::PConfusion())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  gp_Pnt P;
+  gp_Vec T;
+  Spine->D1(Ws, P, T);
+  if (T.Magnitude() <= gp::Resolution())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  const occ::handle<Geom_Plane> aSection = new Geom_Plane(P, gp_Dir(T));
+  double                        t[3]     = {0., 0., 0.};
+  for (int s = 1; s <= 2; s++)
+  {
+    const ChFiDS_FaceInterference& FI = Fd->Interference(s);
+    if (FI.LineIndex() <= 0 || DStr.Curve(FI.LineIndex()).Curve().IsNull() || FI.PCurveOnSurf().IsNull())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    const occ::handle<Geom_Curve>& C  = DStr.Curve(FI.LineIndex()).Curve();
+    const double                   lo = std::min(FI.FirstParameter(), FI.LastParameter());
+    const double                   hi = std::max(FI.FirstParameter(), FI.LastParameter());
+    GeomAPI_IntCS                  anInter(C, aSection);
+    bool                           found = false;
+    double                         best  = RealLast();
+    for (int i = 1; anInter.IsDone() && i <= anInter.NbPoints(); i++)
+    {
+      double u = 0., v = 0., w = 0.;
+      anInter.Parameters(i, u, v, w);
+      if (C->IsPeriodic())
+      {
+        w = ElCLib::InPeriod(w, lo, lo + C->Period());
+      }
+      const double d = anInter.Point(i).Distance(P);
+      if (w > lo + Precision::PConfusion() && w < hi - Precision::PConfusion() && d < best)
+      {
+        best  = d;
+        t[s]  = w;
+        found = true;
+      }
+    }
+    if (!found)
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+  }
+  if (OnSeamOnly)
+  {
+    // (Only where a line crosses there the seam of its face.)
+    bool onSeam = false;
+    for (int s = 1; s <= 2 && !onSeam; s++)
+    {
+      if (Fd->Index(s) <= 0 || Fd->IsOnCurve(s))
+      {
+        continue;
+      }
+      const gp_Pnt PO  = DStr.Curve(Fd->Interference(s).LineIndex()).Curve()->Value(t[s]);
+      TopoDS_Face  FoF = TopoDS::Face(DStr.Shape(Fd->Index(s)));
+      FoF.Orientation(TopAbs_FORWARD);
+      for (TopExp_Explorer ex(FoF, TopAbs_EDGE); ex.More() && !onSeam; ex.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+        double             f = 0., l = 0.;
+        if (BRep_Tool::Degenerated(E) || !BRep_Tool::IsClosed(E, FoF))
+        {
+          continue;
+        }
+        const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(E, f, l);
+        if (aC.IsNull())
+        {
+          continue;
+        }
+        GeomAPI_ProjectPointOnCurve aPr(PO, aC, f, l);
+        onSeam = aPr.NbPoints() > 0 && aPr.LowerDistance() <= 10. * Precision::Confusion();
+      }
+    }
+    if (!onSeam)
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+  }
+  occ::handle<ChFiDS_SurfData> aNext = new ChFiDS_SurfData();
+  aNext->Copy(Fd);
+  aNext->SetIndexOfC1(Fd->IsOnCurve1() ? Fd->IndexOfC1() : 0);
+  aNext->SetIndexOfC2(Fd->IsOnCurve2() ? Fd->IndexOfC2() : 0);
+  for (int s = 1; s <= 2; s++)
+  {
+    ChFiDS_FaceInterference&      FI   = Fd->ChangeInterference(s);
+    ChFiDS_FaceInterference&      FI2  = aNext->ChangeInterference(s);
+    const occ::handle<Geom_Curve> aCrv = DStr.Curve(FI.LineIndex()).Curve();
+    const double                  aTol = DStr.Curve(FI.LineIndex()).Tolerance();
+    FI2.SetLineIndex(DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(aCrv->Copy()), aTol)));
+    if (!FI.PCurveOnFace().IsNull())
+    {
+      FI2.ChangePCurveOnFace() = occ::down_cast<Geom2d_Curve>(FI.PCurveOnFace()->Copy());
+    }
+    FI2.ChangePCurveOnSurf() = occ::down_cast<Geom2d_Curve>(FI.PCurveOnSurf()->Copy());
+    const bool forward = FI.FirstParameter() <= FI.LastParameter();
+    FI.SetParameter(t[s], !forward);
+    FI2.SetParameter(t[s], forward);
+    ChFiDS_CommonPoint& CPl = Fd->ChangeVertex(false, s);
+    ChFiDS_CommonPoint& CPf = aNext->ChangeVertex(true, s);
+    CPl.Reset();
+    CPl.SetPoint(aCrv->Value(t[s]));
+    CPf = CPl;
+  }
+  Fd->LastSpineParam(Ws);
+  aNext->FirstSpineParam(Ws);
+  // Where a line is cut on an edge of its face (the seam of a face closed
+  // round the spine), both parts end on that edge, on a seam on its side
+  // the part runs into the face from (as KPartCutPiece's ends).
+  for (int s = 1; s <= 2; s++)
+  {
+    if (Fd->Index(s) <= 0 || Fd->IsOnCurve(s))
+    {
+      continue;
+    }
+    const ChFiDS_FaceInterference& FI  = Fd->Interference(s);
+    const occ::handle<Geom_Curve>& CL  = DStr.Curve(FI.LineIndex()).Curve();
+    const gp_Pnt                   PO  = CL->Value(t[s]);
+    TopoDS_Face                    FoF = TopoDS::Face(DStr.Shape(Fd->Index(s)));
+    FoF.Orientation(TopAbs_FORWARD);
+    for (int k = 0; k < 2; k++)
+    {
+      // (k 0: the start of aNext; k 1: the end of Fd.)
+      const occ::handle<ChFiDS_SurfData>& X  = k == 0 ? aNext : Fd;
+      const ChFiDS_FaceInterference&      FX = X->Interference(s);
+      const gp_Pnt PM = DStr.Curve(FX.LineIndex()).Curve()->Value(0.5 * (FX.FirstParameter() + FX.LastParameter()));
+      for (TopExp_Explorer ex(FoF, TopAbs_EDGE); ex.More(); ex.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+        double             f = 0., l = 0.;
+        const occ::handle<Geom_Curve> aC = BRep_Tool::Degenerated(E) ? occ::handle<Geom_Curve>() : BRep_Tool::Curve(E, f, l);
+        if (aC.IsNull())
+        {
+          continue;
+        }
+        GeomAPI_ProjectPointOnCurve aPr(PO, aC, f, l);
+        if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * Precision::Confusion())
+        {
+          continue;
+        }
+        const double w = aPr.LowerDistanceParameter();
+        if (w <= f + Precision::PConfusion() || w >= l - Precision::PConfusion())
+        {
+          continue;
+        }
+        if (BRep_Tool::IsClosed(E, FoF))
+        {
+          gp_Pnt aP;
+          gp_Vec aT;
+          aC->D1(w, aP, aT);
+          if (E.Orientation() == TopAbs_REVERSED)
+          {
+            aT.Reverse();
+          }
+          GeomAPI_ProjectPointOnSurf aPrS(PO, BRep_Tool::Surface(FoF));
+          if (aPrS.NbPoints() == 0)
+          {
+            continue;
+          }
+          double us = 0., vs = 0.;
+          aPrS.LowerDistanceParameters(us, vs);
+          gp_Pnt aPs;
+          gp_Vec aDu, aDv;
+          BRep_Tool::Surface(FoF)->D1(us, vs, aPs, aDu, aDv);
+          if (aDu.Crossed(aDv).Crossed(aT).Dot(gp_Vec(PO, PM)) <= 0.)
+          {
+            continue;
+          }
+        }
+        const TopAbs_Orientation aTr = k == 0 ? TopAbs::Reverse(TopAbs::Compose(FI.Transition(), E.Orientation()))
+                                              : TopAbs::Compose(FI.Transition(), E.Orientation());
+        X->ChangeVertex(k == 0, s).SetArc(10. * Precision::Confusion(), E, w, aTr);
+        break;
+      }
+    }
+  }
+  return aNext;
+}
