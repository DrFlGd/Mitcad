+    for (int j = 1; j <= LSD.Length(); j++)
+    {
+      const occ::handle<ChFiDS_SurfData> G  = LSD.Value(j);
+      const double                       W1 = G->FirstSpineParam(), W2 = G->LastSpineParam();
+      const double                       ws = w0 + aPer * std::ceil((W1 - w0) / aPer);
+      if (ws <= W1 + Precision::PConfusion() || ws >= W2 - Precision::PConfusion())
+      {
+        continue;
+      }
+      const occ::handle<ChFiDS_SurfData> aAfter = ChFi3d_SplitPieceAtSection(DStr, Spine, G, ws, true);
+      if (aAfter.IsNull())
+      {
+        continue;
+      }
+      const double dG = ws - (w0 + aPer), dA = ws - w0;
+      G->FirstSpineParam(G->FirstSpineParam() - dG);
+      G->LastSpineParam(G->LastSpineParam() - dG);
+      aAfter->FirstSpineParam(aAfter->FirstSpineParam() - dA);
+      aAfter->LastSpineParam(aAfter->LastSpineParam() - dA);
+      LSD.Remove(j);
+      LSD.Append(G);
+      LSD.Prepend(aAfter);
+      aNormalise();
+      break;
     }
   }
