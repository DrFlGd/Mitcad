+//=======================================================================
+// function : ChFi3d_UntrimmedEndSurface
+// purpose  : The face at an OnSame end on a trimmed elementary surface (a
+//           cone bounded at the face's rim, as stored bodies have them),
+//           extended as its basis surface is: unbounded where that is not
+//           periodic, one period from the trimmed start where it is, so
+//           that the parameters of the face's own curves stay as they are.
+//           Null for any other surface.
+//=======================================================================
+
+static occ::handle<Geom_Surface> ChFi3d_UntrimmedEndSurface(const occ::handle<Geom_Surface>& theS)
+{
+  occ::handle<Geom_RectangularTrimmedSurface> aTr = occ::down_cast<Geom_RectangularTrimmedSurface>(theS);
+  if (aTr.IsNull())
+  {
+    return occ::handle<Geom_Surface>();
+  }
+  occ::handle<Geom_Surface> aBasis = aTr->BasisSurface();
+  if (!aBasis->IsKind(STANDARD_TYPE(Geom_ElementarySurface)))
+  {
+    return occ::handle<Geom_Surface>();
+  }
+  double aU1, aU2, aV1, aV2;
+  aTr->Bounds(aU1, aU2, aV1, aV2);
+  const bool isU = aBasis->IsUPeriodic(), isV = aBasis->IsVPeriodic();
+  if (isU && isV)
+  {
+    return new Geom_RectangularTrimmedSurface(aBasis,
+                                              aU1,
+                                              aU1 + aBasis->UPeriod(),
+                                              aV1,
+                                              aV1 + aBasis->VPeriod());
+  }
+  if (isU)
+  {
+    return new Geom_RectangularTrimmedSurface(aBasis, aU1, aU1 + aBasis->UPeriod(), true);
+  }
+  if (isV)
+  {
+    return new Geom_RectangularTrimmedSurface(aBasis, aV1, aV1 + aBasis->VPeriod(), false);
+  }
+  return aBasis;
+}
