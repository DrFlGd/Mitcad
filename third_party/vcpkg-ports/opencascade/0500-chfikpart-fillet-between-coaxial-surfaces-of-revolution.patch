+namespace
+{
+// The axis of a cylinder or a cone.
+bool revolutionAxis(const Adaptor3d_Surface& S, gp_Ax1& Axis)
+{
+  switch (S.GetType())
+  {
+    case GeomAbs_Cylinder:
+      Axis = S.Cylinder().Axis();
+      return true;
+    case GeomAbs_Cone:
+      Axis = S.Cone().Axis();
+      return true;
+    default:
+      return false;
+  }
+}
+
+// The parameters of P on a cylinder or a cone, its natural derivatives
+// there.
+void revolutionD1(const Adaptor3d_Surface& S,
+                  const gp_Pnt&            P,
+                  double&                  U,
+                  double&                  V,
+                  gp_Vec&                  DU,
+                  gp_Vec&                  DV)
+{
+  gp_Pnt PP;
+  if (S.GetType() == GeomAbs_Cylinder)
+  {
+    const gp_Cylinder aCyl = S.Cylinder();
+    ElSLib::Parameters(aCyl, P, U, V);
+    ElSLib::D1(U, V, aCyl, PP, DU, DV);
+  }
+  else
+  {
+    const gp_Cone aCone = S.Cone();
+    ElSLib::Parameters(aCone, P, U, V);
+    ElSLib::D1(U, V, aCone, PP, DU, DV);
+  }
+}
+
+// A U parameter in the range of a face's surface, as the plane/cylinder
+// fillet takes it (ChFiKPart_ComputeData_FilPlnCyl).
+double uInRange(const double U, const double fu, const double lu, const bool Reversed)
+{
+  const double tol           = Precision::PConfusion();
+  const bool   careaboutsens = std::abs(lu - fu - 2 * M_PI) < tol;
+  double       u             = U;
+  if (u >= fu - tol && u < fu)
+  {
+    u = fu;
+  }
+  if (u <= lu + tol && u > lu)
+  {
+    u = lu;
+  }
+  if (u < fu || u > lu)
+  {
+    u = ChFiKPart_InPeriod(u, fu, fu + 2 * M_PI, tol);
+  }
+  if (Reversed)
+  {
+    if (careaboutsens && std::abs(fu - u) < tol)
+    {
+      u = lu;
+    }
+  }
+  else if (careaboutsens && std::abs(lu - u) < tol)
+  {
+    u = fu;
+  }
+  return u;
+}
+} // namespace
+
+//=================================================================================================
+
+bool ChFiKPart_IsCoaxialPair(const Adaptor3d_Surface& S1,
+                             const Adaptor3d_Surface& S2,
+                             const gp_Circ&           Spine)
+{
+  if (S1.GetType() == GeomAbs_Cylinder && S2.GetType() == GeomAbs_Cylinder)
+  {
+    return false;
+  }
+  gp_Ax1 A1, A2;
+  if (!revolutionAxis(S1, A1) || !revolutionAxis(S2, A2))
+  {
+    return false;
+  }
+  const double aTolA = Precision::Angular();
+  const double aTol  = Precision::Confusion();
+  const gp_Lin aLin(A1);
+  return A1.IsParallel(A2, aTolA) && aLin.Distance(A2.Location()) <= aTol
+         && A1.IsParallel(Spine.Axis(), aTolA) && aLin.Distance(Spine.Location()) <= aTol;
+}
+
+//=======================================================================
+// function : ChFiKPart_MakeFilletCoaxial
+// purpose  : The ball rolls round the common axis: its centre lies in the
+//            meridian half-plane of the spine's point, at the radius from
+//            both profiles along their normals oriented by Or1 and Or2
+//            (towards the ball), and the fillet is the torus that its
+//            centre's circle sweeps.
+//=======================================================================
+
+bool ChFiKPart_MakeFilletCoaxial(TopOpeBRepDS_DataStructure&         DStr,
+                                 const occ::handle<ChFiDS_SurfData>& Data,
+                                 const Adaptor3d_Surface&            S1,
+                                 const Adaptor3d_Surface&            S2,
+                                 const TopAbs_Orientation            Or1,
+                                 const TopAbs_Orientation            Or2,
+                                 const double                        Radius,
+                                 const gp_Circ&                      Spine,
+                                 const double                        First,
+                                 const TopAbs_Orientation            OrFace1)
+{
+  gp_Ax1 anAxis;
+  if (!ChFiKPart_IsCoaxialPair(S1, S2, Spine) || !revolutionAxis(S1, anAxis))
+  {
+    return false;
+  }
+  const gp_Pnt O = anAxis.Location();
+  const gp_Dir D = anAxis.Direction();
+
+  gp_Pnt PtSp;
+  gp_Vec DSp;
+  ElCLib::D1(First, Spine, PtSp, DSp);
+  const gp_Dir Dy(DSp);
+  const gp_Vec OE(O, PtSp);
+  const double zE = OE.Dot(gp_Vec(D));
+  const gp_Vec aRad = OE - gp_Vec(D) * zE;
+  const double rhoE = aRad.Magnitude();
+  if (rhoE <= Precision::Confusion())
+  {
+    return false;
+  }
+  const gp_Dir Dx(aRad);
+
+  // The profiles' normals towards the ball in the meridian (Dx, D).
+  const Adaptor3d_Surface* S[2]  = {&S1, &S2};
+  const TopAbs_Orientation Or[2] = {Or1, Or2};
+  double                   ax[2], ay[2];
+  for (int i = 0; i < 2; i++)
+  {
+    double u = 0., v = 0.;
+    gp_Vec du, dv;
+    revolutionD1(*S[i], PtSp, u, v, du, dv);
+    gp_Vec N = du.Crossed(dv);
+    if (N.Magnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    N.Normalize();
+    if (Or[i] == TopAbs_REVERSED)
+    {
+      N.Reverse();
+    }
+    ax[i] = N.Dot(gp_Vec(Dx));
+    ay[i] = N.Dot(gp_Vec(D));
+  }
+  const double det = ax[0] * ay[1] - ay[0] * ax[1];
+  if (std::abs(det) <= 1.e-9)
+  {
+    return false;
+  }
+  // The ball's centre, relative to the spine's point.
+  const double cx    = Radius * (ay[1] - ay[0]) / det;
+  const double cy    = Radius * (ax[0] - ax[1]) / det;
+  const double rhoC  = rhoE + cx;
+  const double zC    = zE + cy;
+  if (rhoC <= Precision::Confusion())
+  {
+    return false;
+  }
+  const gp_Pnt C = O.Translated(gp_Vec(D) * zC + gp_Vec(Dx) * rhoC);
+  gp_Pnt       P[2];
+  for (int i = 0; i < 2; i++)
+  {
+    P[i] = C.Translated(-(gp_Vec(Dx) * ax[i] + gp_Vec(D) * ay[i]) * Radius);
+  }
+
+  const gp_Vec CE(C, PtSp);
+  if (CE.Magnitude() <= Precision::Confusion())
+  {
+    return false;
+  }
+  const gp_Pnt Pe = C.Translated(CE.Normalized() * Radius);
+
+  // The torus about the axis, its parameter u along the spine; its axis
+  // the way that makes the section, the arc of the ball facing the edge,
+  // run from the contact on S1 to the contact on S2 with v rising (as the
+  // other analytic fillets have it).
+  gp_Ax3 FilAx3;
+  double v[2] = {0., 0.};
+  bool   found = false;
+  for (const double aSense : {1., -1.})
+  {
+    gp_Dir Dz = D;
+    if (aSense < 0.)
+    {
+      Dz.Reverse();
+    }
+    FilAx3 = gp_Ax3(O.Translated(gp_Vec(D) * zC), Dz, Dx);
+    if (FilAx3.YDirection().Dot(Dy) <= 0.)
+    {
+      FilAx3.YReverse();
+    }
+    double u = 0., ve = 0.;
+    for (int i = 0; i < 2; i++)
+    {
+      ElSLib::TorusParameters(FilAx3, rhoC, Radius, P[i], u, v[i]);
+    }
+    ElSLib::TorusParameters(FilAx3, rhoC, Radius, Pe, u, ve);
+    v[0] = ElCLib::InPeriod(v[0], 0., 2 * M_PI);
+    v[1] = ElCLib::InPeriod(v[1], v[0], v[0] + 2 * M_PI);
+    ve   = ElCLib::InPeriod(ve, v[0], v[0] + 2 * M_PI);
+    if (ve < v[1])
+    {
+      found = true;
+      break;
+    }
+  }
+  if (!found)
+  {
+    return false;
+  }
+  occ::handle<Geom_ToroidalSurface> gtor = new Geom_ToroidalSurface(FilAx3, rhoC, Radius);
+  Data->ChangeSurf(ChFiKPart_IndexSurfaceInDS(gtor, DStr));
+
+  gp_Ax2 circAx2 = FilAx3.Ax2();
+  for (int i = 0; i < 2; i++)
+  {
+    gp_Pnt PP;
+    gp_Vec deru, derv;
+    ElSLib::TorusD1(0., v[i], FilAx3, rhoC, Radius, PP, deru, derv);
+    const gp_Vec norFil = deru.Crossed(derv);
+
+    double us = 0., vs = 0.;
+    gp_Vec dus, dvs;
+    revolutionD1(*S[i], P[i], us, vs, dus, dvs);
+    const gp_Vec norS     = dus.Crossed(dvs);
+    const bool   reversed = dus.Dot(gp_Vec(Dy)) < 0.;
+    us                    = uInRange(us, S[i]->FirstUParameter(), S[i]->LastUParameter(), reversed);
+    gp_Dir2d d2dS = gp::DX2d();
+    if (reversed)
+    {
+      d2dS.Reverse();
+    }
+    occ::handle<Geom2d_Line> GLin2dS   = new Geom2d_Line(gp_Lin2d(gp_Pnt2d(us, vs), d2dS));
+    occ::handle<Geom2d_Line> GLin2dFil = new Geom2d_Line(gp_Lin2d(gp_Pnt2d(0., v[i]), gp::DX2d()));
+
+    const gp_Vec OP(O, P[i]);
+    const double zP = OP.Dot(gp_Vec(D));
+    circAx2.SetLocation(O.Translated(gp_Vec(D) * zP));
+    const double rhoP = (OP - gp_Vec(D) * zP).Magnitude();
+    occ::handle<Geom_Circle> GCirc = new Geom_Circle(gp_Circ(circAx2, rhoP));
+
+    if (i == 0)
+    {
+      // The fillet's orientation: its normal along the face's outward
+      // normal at the contact.
+      gp_Vec Df = norS;
+      if (OrFace1 == TopAbs_REVERSED)
+      {
+        Df.Reverse();
+      }
+      Data->ChangeOrientation() = norFil.Dot(Df) <= 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+      const TopAbs_Orientation trans = norFil.Dot(norS) <= 0. ? TopAbs_FORWARD : TopAbs_REVERSED;
+      Data->ChangeInterferenceOnS1().SetInterference(ChFiKPart_IndexCurveInDS(GCirc, DStr),
+                                                     trans,
+                                                     GLin2dS,
+                                                     GLin2dFil);
+    }
+    else
+    {
+      const TopAbs_Orientation trans = norFil.Dot(norS) <= 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+      Data->ChangeInterferenceOnS2().SetInterference(ChFiKPart_IndexCurveInDS(GCirc, DStr),
+                                                     trans,
+                                                     GLin2dS,
+                                                     GLin2dFil);
+    }
+  }
+  return true;
+}
