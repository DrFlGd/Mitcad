+class TopOpeBRepDS_DataStructure;
+
+//! Whether two surfaces, each a cylinder or a cone and not both
+//! cylinders, share their axis, and the circle lies about that axis: the
+//! constant-radius fillet of their edge is then a torus about the axis.
+bool ChFiKPart_IsCoaxialPair(const Adaptor3d_Surface& S1,
+                             const Adaptor3d_Surface& S2,
+                             const gp_Circ&           Spine);
+
+//! The torus of a constant-radius fillet between two coaxial surfaces of
+//! revolution (a cylinder and a cone, or two cones) along a circle about
+//! their axis.
+bool ChFiKPart_MakeFilletCoaxial(TopOpeBRepDS_DataStructure&         DStr,
+                                 const occ::handle<ChFiDS_SurfData>& Data,
+                                 const Adaptor3d_Surface&            S1,
