+          }
+          const occ::handle<ChFiDS_SurfData> G = ChFi3d_KPartCutPiece(DStr,
+                                                                      Spine,
+                                                                      Full,
+                                                                      ons,
+                                                                      N,
+                                                                      Bf,
+                                                                      w1 - shift,
+                                                                      w2 - shift,
+                                                                      aPrev,
+                                                                      aNext,
+                                                                      tol3d,
+                                                                      aGivenStart,
+                                                                      aGivenEnd,
