+          break;
+        }
+        anEdges.Append(m);
+        if (aState(m) != 2 || aFull(m).IsNull() || aFull(m)->Index(ons) != A->Index(ons))
+        {
+          break;
+        }
+        if (!aLSD(m).IsEmpty())
+        {
+          found = true;
+          break;
+        }
+      }
+      const occ::handle<ChFiDS_SurfData> C = found ? aLSD(m).First() : occ::handle<ChFiDS_SurfData>();
+      if (!found || C->Vertex(true, opp).IsOnArc() || C->Index(ons) != A->Index(ons) || C->Vertex(true, ons).IsVertex())
