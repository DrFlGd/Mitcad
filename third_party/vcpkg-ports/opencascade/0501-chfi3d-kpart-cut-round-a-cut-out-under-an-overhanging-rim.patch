+//=======================================================================
+// function : ChFi3d_FillKPartRoundGapsAcrossEdges
+// purpose  : As ChFi3d_FillKPartGapsAcrossEdges where the contact passes
+//            beyond the outline of the face beyond B (the cut-out under an
+//            overhanging rim, B its side): the faces round from B back to B
+//            cut the blend in turn (ChFi3d_KPartCutChain, Round), the pieces
+//            kept within the gap and split where the spine's edges meet,
+//            each on the blend of its edge. The piece after the gap may
+//            start at its edge's start where the contact comes back across
+//            an edge of N with B (its point then given that arc).
+//=======================================================================
+
+// A contact's point at its edge's end that SplitKPart gives no arc, lying
+// on an edge of its face N with another face (where the contact leaves N
+// or comes back into it there): CP given that edge as its arc, the
+// transition of an end (IsFirst: the piece's start) of a contact whose
+// interference is FI. The face across that edge, or null; Wanted, when
+// given, the only face taken.
+static TopoDS_Face ChFi3d_GiveContactArc(ChFiDS_CommonPoint&            CP,
+                                         const TopoDS_Face&             N,
+                                         const ChFiDS_FaceInterference& FI,
+                                         const bool                     IsFirst,
+                                         const ChFiDS_Map&              EFMap,
+                                         const double                   tol3d,
+                                         const TopoDS_Face&             Wanted)
+{
+  TopoDS_Face NF = N;
+  NF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(NF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(Ec) || !EFMap.Contains(Ec))
+    {
+      continue;
+    }
+    TopoDS_Face Bc;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Ec)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(N))
+      {
+        Bc = TopoDS::Face(it.Value());
+      }
+    }
+    double                        fc = 0., lc = 0.;
+    const occ::handle<Geom_Curve> Cc = BRep_Tool::Curve(Ec, fc, lc);
+    if (Bc.IsNull() || (!Wanted.IsNull() && !Bc.IsSame(Wanted)) || Cc.IsNull() || ChFi3d::IsTangentFaces(Ec, N, Bc))
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnCurve aPr(CP.Point(), Cc, fc, lc);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+    {
+      continue;
+    }
+    const TopAbs_Orientation aTr = IsFirst ? TopAbs::Reverse(TopAbs::Compose(FI.Transition(), Ec.Orientation()))
+                                           : TopAbs::Compose(FI.Transition(), Ec.Orientation());
+    CP.SetArc(10. * tol3d, Ec, aPr.LowerDistanceParameter(), aTr);
+    return Bc;
+  }
+  return TopoDS_Face();
+}
