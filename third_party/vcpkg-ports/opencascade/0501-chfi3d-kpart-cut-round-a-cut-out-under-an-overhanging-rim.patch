+        {
+          u = ElCLib::InPeriod(u, uvO.X() - 0.5 * S->UPeriod(), uvO.X() + 0.5 * S->UPeriod());
+        }
+        if (S->IsVPeriodic())
+        {
+          v = ElCLib::InPeriod(v, uvO.Y() - 0.5 * S->VPeriod(), uvO.Y() + 0.5 * S->VPeriod());
+        }
+        uv.SetCoord(u, v);
+        return true;
+      };
+      const auto crossingEnd =
+        [&](const int i, const TopoDS_Face& Bf, const occ::handle<ChFiDS_SurfData>& Full, ChFi3d_KPartCutEnd& anEnd) {
