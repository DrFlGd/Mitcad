+// function : ChFi3d_JoinKPartRunsAcrossEdges
+// purpose  : The runs of pieces that are one face (PerformSetOfKPart: from
+//            a piece through pieces whose contact on one side lies on
+//            other faces, cut there by the faces beyond, to a piece whose
+//            contacts lie on the faces of the first again, all on one
+//            surface) where they go on from one edge of the spine to the
+//            next (round a closed spine's start too): the pieces of the
+//            next edge take the surface of the run's pieces before them.
+//            Seq holds the stripe's pieces in order, EdgeOf their edges.
+//=======================================================================
+
+static bool ChFi3d_JoinKPartRunsAcrossEdges(TopOpeBRepDS_DataStructure&                               DStr,
+                                            const occ::handle<ChFiDS_Spine>&                          Spine,
+                                            const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq,
+                                            const NCollection_Sequence<int>&                          EdgeOf)
+{
+  const int nbsd = Seq.Length();
+  if (nbsd < 2 || EdgeOf.Length() != nbsd)
+  {
+    return false;
+  }
+  const bool aRound = Spine->IsPeriodic();
+  const auto at     = [nbsd](const int i) { return ((i - 1) % nbsd + nbsd) % nbsd + 1; };
+  NCollection_Array1<int> aJoinPrev(1, nbsd);
+  aJoinPrev.Init(0);
+  bool anAcross = false;
+  for (int a = 1; a <= nbsd && (aRound || a < nbsd); a++)
+  {
+    const occ::handle<ChFiDS_SurfData>& A = Seq.Value(a);
+    for (int s = 1; s <= 2; s++)
+    {
+      const int bmax = aRound ? a + nbsd : nbsd;
+      int       b    = a + 1;
+      while (b <= bmax && Seq.Value(at(b))->Index(3 - s) == A->Index(3 - s) && Seq.Value(at(b))->Index(s) != A->Index(s))
+      {
+        b++;
+      }
+      if (b == a + 1 || b > bmax || Seq.Value(at(b))->Index(1) != A->Index(1)
+          || Seq.Value(at(b))->Index(2) != A->Index(2))
+      {
+        continue;
+      }
+      bool aSame = true, aCrosses = false;
+      for (int i = a + 1; i <= b && aSame; i++)
+      {
+        const occ::handle<ChFiDS_SurfData>& P = Seq.Value(at(i - 1));
+        const occ::handle<ChFiDS_SurfData>& Q = Seq.Value(at(i));
+        double aGap = P->LastSpineParam() - Q->FirstSpineParam();
+        if (Spine->IsPeriodic())
+        {
+          aGap -= std::round(aGap / Spine->Period()) * Spine->Period();
+        }
+        aSame    = P->Orientation() == Q->Orientation() && std::abs(aGap) <= Precision::PConfusion()
+                && ChFi3d_SameAnalyticSurface(DStr.Surface(P->Surf()).Surface(), DStr.Surface(Q->Surf()).Surface());
+        aCrosses = aCrosses || EdgeOf.Value(at(i - 1)) != EdgeOf.Value(at(i));
+      }
+      if (!aSame || !aCrosses)
+      {
+        continue;
+      }
+      for (int i = a + 1; i <= b; i++)
+      {
+        if (at(i) == a || aJoinPrev(at(i)) != 0)
+        {
+          continue;
+        }
+        int k = at(i - 1);
+        for (int n = 0; k != 0 && k != at(i) && n < nbsd; n++)
+        {
+          k = aJoinPrev(k);
+        }
+        if (k != at(i))
+        {
+          aJoinPrev(at(i)) = at(i - 1);
+          anAcross         = true;
+        }
+      }
+    }
+  }
+  if (!anAcross)
+  {
+    return false;
+  }
+  NCollection_Array1<bool> aDone(1, nbsd);
+  for (int i = 1; i <= nbsd; i++)
+  {
+    aDone(i) = aJoinPrev(i) == 0;
+  }
+  for (bool aMore = true; aMore;)
+  {
+    aMore = false;
+    for (int i = 1; i <= nbsd; i++)
+    {
+      if (aDone(i) || !aDone(aJoinPrev(i)))
+      {
+        continue;
+      }
+      const occ::handle<ChFiDS_SurfData>& P = Seq.Value(aJoinPrev(i));
+      Seq.Value(i)->ChangeSurf(P->Surf());
+      ChFi3d_PCurvesOnSurfAfter(Seq.Value(i), P, DStr.Surface(P->Surf()).Surface());
+      aDone(i) = true;
+      aMore    = true;
+    }
+  }
+  return true;
+}
