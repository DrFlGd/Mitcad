+//=======================================================================
+// function : CommonPointAtEnd
+// purpose  : The common point at the end <theSens> of surface data
+//           <theIndex> of a stripe that lies at <thePnt>, none if neither.
+//=======================================================================
+
+static const ChFiDS_CommonPoint* CommonPointAtEnd(const occ::handle<ChFiDS_Stripe>& theStripe,
+                                                  const int                         theIndex,
+                                                  const int                         theSens,
+                                                  const gp_Pnt&                     thePnt)
+{
+  const occ::handle<ChFiDS_SurfData>& aSD = theStripe->SetOfSurfData()->Value(theIndex);
+  for (int j = 1; j <= 2; j++)
+  {
+    const ChFiDS_CommonPoint& aCP = aSD->Vertex(theSens == 1, j);
+    if (aCP.Point().Distance(thePnt) <= Precision::Confusion())
+    {
+      return &aCP;
+    }
+  }
+  return nullptr;
+}
+
+//=======================================================================
+// function : SameEndPoint
+// purpose  : Whether two stripes' ends meet at one point: within
+//           Precision::Confusion(), or, where both ends are common points
+//           on one arc, within that arc's tolerance. Two analytic blends
+//           (a torus between coaxial faces of revolution and the cylinder
+//           of the next edge) end on the edge between their faces at the
+//           same point, each computed on its own face's curve of the edge,
+//           which differ within the edge's tolerance.
+//=======================================================================
+
+static bool SameEndPoint(const gp_Pnt&                     theP1,
+                         const occ::handle<ChFiDS_Stripe>& theStripe1,
+                         const int                         theIndex1,
+                         const int                         theSens1,
+                         const gp_Pnt&                     theP2,
+                         const occ::handle<ChFiDS_Stripe>& theStripe2,
+                         const int                         theIndex2,
+                         const int                         theSens2)
+{
+  const double aDist = theP1.Distance(theP2);
+  if (aDist <= Precision::Confusion())
+  {
+    return true;
+  }
+  const ChFiDS_CommonPoint* aCP1 = CommonPointAtEnd(theStripe1, theIndex1, theSens1, theP1);
+  const ChFiDS_CommonPoint* aCP2 = CommonPointAtEnd(theStripe2, theIndex2, theSens2, theP2);
+  return aCP1 != nullptr && aCP2 != nullptr && aCP1->IsOnArc() && aCP2->IsOnArc()
+         && aCP1->Arc().IsSame(aCP2->Arc()) && aDist <= BRep_Tool::Tolerance(aCP1->Arc());
+}
+
