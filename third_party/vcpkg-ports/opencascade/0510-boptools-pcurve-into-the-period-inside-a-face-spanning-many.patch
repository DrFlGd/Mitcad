-            dv += (v > (VMin + aDelta + aVPeriod)) ? -aVPeriod : aVPeriod;
+            double aShift = 0.;
+            if (ShiftIntoFace(aF, u, v, false, VMin, VMax, aVPeriod, aDelta, aShift))
