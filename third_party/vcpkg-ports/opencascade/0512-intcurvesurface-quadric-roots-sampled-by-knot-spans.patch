+//! Mitcad (mitcad#349): the fewest samples of a B-spline curve's distance
+//! to the quadric over [theU1, theU2] that the roots are looked for between:
+//! its degree for each of its knot spans there. The curve tool's sample
+//! count is capped at 50 for the whole range, so that on a helix of 32
+//! turns a sample came every two thirds of a turn and two roots within one
+//! step (where the helix dips below the quadric and rises again) were not
+//! found.
+inline int MinRootSamples(const occ::handle<Adaptor3d_Curve>& theCurve,
+                          const double                        theU1,
+                          const double                        theU2)
+{
+  if (theCurve.IsNull() || theCurve->GetType() != GeomAbs_BSplineCurve)
+  {
+    return 0;
+  }
+  const occ::handle<Geom_BSplineCurve> aBC = theCurve->BSpline();
+  if (aBC.IsNull())
+  {
+    return 0;
+  }
+  int aNbSpans = 0;
+  for (int i = aBC->FirstUKnotIndex(); i < aBC->LastUKnotIndex(); ++i)
+  {
+    if (aBC->Knot(i + 1) > theU1 && aBC->Knot(i) < theU2)
+    {
+      ++aNbSpans;
+    }
+  }
+  return std::min(aNbSpans * aBC->Degree() + 1, 100000);
+}
+
+//! Other curve types (a line) keep the curve tool's sample count.
+template <typename CurveType>
+int MinRootSamples(const CurveType&, const double, const double)
+{
+  return 0;
+}
