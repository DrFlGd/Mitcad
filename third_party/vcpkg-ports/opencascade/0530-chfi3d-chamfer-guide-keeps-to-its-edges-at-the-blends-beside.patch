+//=======================================================================
+// function : ChFi3d_AdjustGuideEndsLocally
+// purpose  : Gives guide BS the point and tangent of the blends before
+//            and after it at its ends (WF, WL), changing it within Length
+//            of each end only: knots are inserted there and the two poles
+//            at the end are moved (the tangent's length kept).
+//=======================================================================
+
+static void ChFi3d_AdjustGuideEndsLocally(occ::handle<Geom_BSplineCurve>& BS,
+                                          const double                    WF,
+                                          const double                    WL,
+                                          const bool                      AtDeb,
+                                          const gp_Pnt&                   PDeb,
+                                          const gp_Vec&                   VDeb,
+                                          const bool                      AtFin,
+                                          const gp_Pnt&                   PFin,
+                                          const gp_Vec&                   VFin,
+                                          const double                    Length)
+{
+  const int    aDeg  = BS->Degree();
+  const double aSpan = std::min(Length, 0.25 * (WL - WF));
+  if (aSpan <= Precision::PConfusion())
+  {
+    return;
+  }
+  for (const bool atStart : {true, false})
+  {
+    const double W0    = atStart ? WF : WL;
+    const double Wend  = atStart ? BS->FirstParameter() : BS->LastParameter();
+    const gp_Pnt& Pref = atStart ? PDeb : PFin;
+    const gp_Vec& Vref = atStart ? VDeb : VFin;
+    if (!(atStart ? AtDeb : AtFin) || std::abs(W0 - Wend) > 1.e-12 || Vref.Magnitude() <= gp::Resolution())
+    {
+      continue; // (an end extended past the spine's end keeps its own tangent)
+    }
+    gp_Pnt P;
+    gp_Vec V;
+    BS->D1(W0, P, V);
+    if (V.Magnitude() <= gp::Resolution()
+        || (P.Distance(Pref) < Precision::Confusion() && V.Normalized().Dot(Vref.Normalized()) > 0.9999999))
+    {
+      continue;
+    }
+    for (int i = 1; i <= aDeg; i++)
+    {
+      const double u = atStart ? WF + aSpan * i / aDeg : WL - aSpan * i / aDeg;
+      BS->InsertKnot(u, 1, Precision::PConfusion(), false);
+    }
+    const int    n   = BS->NbPoles();
+    const int    i1  = atStart ? 1 : n;
+    const int    i2  = atStart ? 2 : n - 1;
+    const double len = BS->Pole(i1).Distance(BS->Pole(i2));
+    const gp_Vec d   = gp_Vec(gp_Dir(Vref)) * (atStart ? len : -len);
+    BS->SetPole(i1, Pref);
+    BS->SetPole(i2, Pref.Translated(d));
+  }
+}
