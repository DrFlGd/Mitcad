+//=======================================================================
+// function : ChamferEndPastTurnStop
+// purpose  : A chamfer's contour stopped at the vertex V at an end of the
+//            spine where its edge and the next one turn
+//            (StopChainsAtTurns), its faces going on tangentially past V:
+//            where the analytic blend of the end edge has its contact on
+//            one face N ending on N's edge E into the face F0 beyond the
+//            crease, which holds V, that blend runs on past V, cut by F0,
+//            up to where its other contact reaches F0, on the edge Eq of
+//            its face with F0 at V; the stripe ends in a point there (the
+//            walk past V and its corner are not made).
+//=======================================================================
+
+bool ChFi3d_Builder::ChamferEndPastTurnStop(const occ::handle<ChFiDS_Stripe>& Stripe, const bool isFirst)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (!myStopAtTurns || occ::down_cast<ChFiDS_ChamfSpine>(Spine).IsNull() || Spine->IsPeriodic()
+      || Stripe->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  const TopoDS_Vertex V = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (!myTurnStops.Contains(V) || Spine->Status(isFirst) == ChFiDS_FreeBoundary)
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&                         DStr = myDS->ChangeDS();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq  = Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  const double W0 = isFirst ? Spine->FirstParameter(1) : Spine->LastParameter(Spine->NbEdges());
+  // The end edge's piece: the first (last) one that is not all past V.
+  int iEnd = 0;
+  for (int i = 1; i <= Seq.Length(); i++)
+  {
+    const int                           k  = isFirst ? i : Seq.Length() + 1 - i;
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(k);
+    if (isFirst ? SD->LastSpineParam() > W0 + tolesp : SD->FirstSpineParam() < W0 - tolesp)
+    {
+      iEnd = k;
+      break;
+    }
+  }
+  if (iEnd == 0)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> SD = Seq.Value(iEnd);
+  if (std::abs((isFirst ? SD->FirstSpineParam() : SD->LastSpineParam()) - W0) > 10. * tolesp)
+  {
+    return false;
+  }
+  {
+    // (An analytic blend: its surface runs on past V as it is.)
+    GeomAdaptor_Surface aGS(DStr.Surface(SD->Surf()).Surface());
+    if (aGS.GetType() == GeomAbs_BSplineSurface || aGS.GetType() == GeomAbs_BezierSurface
+        || aGS.GetType() == GeomAbs_OtherSurface)
+    {
+      return false;
+    }
+  }
+  const auto atV = [&](const TopoDS_Shape& S) {
+    for (TopExp_Explorer ex(S, TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(V))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  int         cut = 0;
+  TopoDS_Face F0;
+  for (int s = 1; s <= 2 && cut == 0; s++)
+  {
+    const ChFiDS_CommonPoint& CP = SD->Vertex(isFirst, s);
+    if (!CP.IsOnArc() || SD->Index(s) <= 0 || !myEFMap.Contains(CP.Arc()))
+    {
+      continue;
+    }
+    const TopoDS_Face N  = TopoDS::Face(DStr.Shape(SD->Index(s)));
+    const TopoDS_Face Fb = otherFace(myEFMap, TopoDS::Edge(CP.Arc()), N);
+    if (!Fb.IsNull() && atV(Fb) && atV(CP.Arc()))
+    {
+      cut = s;
+      F0  = Fb;
+    }
+  }
+  if (cut == 0)
+  {
+    return false;
+  }
+  const int         other = 3 - cut;
+  const TopoDS_Face Fw    = TopoDS::Face(DStr.Shape(SD->Index(other)));
+  // Eq: the other face's edge with F0 at V.
+  TopoDS_Edge Eq;
+  for (TopExp_Explorer ex(Fw, TopAbs_EDGE); ex.More() && Eq.IsNull(); ex.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+    if (atV(Ec) && otherFace(myEFMap, Ec, Fw).IsSame(F0))
+    {
+      Eq = Ec;
+    }
+  }
+  if (Eq.IsNull())
+  {
+    return false;
+  }
+  // Q: where the other contact's line, on past V, meets Eq.
+  const ChFiDS_FaceInterference& FO = SD->Interference(other);
+  occ::handle<Geom_Curve>        CO = DStr.Curve(FO.LineIndex()).Curve();
+  if (const occ::handle<Geom_TrimmedCurve> aT = occ::down_cast<Geom_TrimmedCurve>(CO))
+  {
+    CO = aT->BasisCurve();
+  }
+  double                        fq = 0., lq = 0.;
+  const occ::handle<Geom_Curve> CQ = BRep_Tool::Curve(Eq, fq, lq);
+  if (CO.IsNull() || CQ.IsNull())
+  {
+    return false;
+  }
+  const double tEnd = isFirst ? FO.FirstParameter() : FO.LastParameter();
+  const double span = std::abs(FO.LastParameter() - FO.FirstParameter());
+  const double ta0  = isFirst ? tEnd - span : tEnd, tb0 = isFirst ? tEnd : tEnd + span;
+  // (Sampled along the line past V for its nearest approach to Eq, then
+  // refined.)
+  double tQ = 0., wQ = 0., best = RealLast();
+  {
+    const auto distTo = [&](const double t, double& w) {
+      GeomAPI_ProjectPointOnCurve aPr(CO->Value(t), CQ, fq, lq);
+      if (aPr.NbPoints() == 0)
+      {
+        return RealLast();
+      }
+      w = aPr.LowerDistanceParameter();
+      return aPr.LowerDistance();
+    };
+    const int nbs = 200;
+    double    tb  = tEnd, db = RealLast(), wb = 0.;
+    for (int k = 1; k <= nbs; k++)
+    {
+      const double t = isFirst ? tEnd - span * k / nbs : tEnd + span * k / nbs;
+      double       w = 0.;
+      const double d = distTo(t, w);
+      if (d < db)
+      {
+        db = d;
+        tb = t;
+        wb = w;
+      }
+    }
+    // (Golden section about the best sample.)
+    double a = tb - span / nbs, b = tb + span / nbs;
+    for (int it = 0; it < 80; it++)
+    {
+      const double m1 = a + 0.382 * (b - a), m2 = a + 0.618 * (b - a);
+      double       w1 = 0., w2 = 0.;
+      (distTo(m1, w1) < distTo(m2, w2) ? b : a) = (distTo(m1, w1) < distTo(m2, w2) ? m2 : m1);
+    }
+    tQ   = 0.5 * (a + b);
+    best = distTo(tQ, wQ);
+    (void)ta0;
+    (void)tb0;
+    (void)wb;
+  }
+  if (best > std::max(100. * tolapp3d, 1.e-4))
+  {
+    return false;
+  }
+  const gp_Pnt Q = CQ->Value(wQ);
+  // (Eq is kept away from V.)
+  gp_Pnt PQ;
+  gp_Vec TQ;
+  CQ->D1(wQ, PQ, TQ);
+  const TopAbs_Orientation TrQ = gp_Vec(PQ, BRep_Tool::Pnt(V)).Dot(TQ) > 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+  const double             ta = isFirst ? tQ : tEnd, tb = isFirst ? tEnd : tQ;
+  const occ::handle<ChFiDS_SurfData> G =
+    ChFi3d_NarrowCutPiece(DStr, SD, cut, F0, ta, tb, isFirst, Q, Eq, wQ, TrQ, TopoDS_Vertex(),
+                          SD->Vertex(isFirst, cut).Point(), SD->Surf(), tolapp3d, &SD->Vertex(isFirst, cut),
+                          &SD->Vertex(isFirst, other));
+  if (G.IsNull())
+  {
+    return false;
+  }
+  // (The analytic blend's parameters run on past its spine's end.)
+  G->FirstSpineParam(isFirst ? W0 - 1.e-3 : W0);
+  G->LastSpineParam(isFirst ? W0 : W0 + 1.e-3);
+  if (isFirst)
+  {
+    for (int i = iEnd - 1; i >= 1; i--)
+    {
+      Seq.Remove(i);
+    }
+    Seq.Prepend(G);
+  }
+  else
+  {
+    for (int i = Seq.Length(); i > iEnd; i--)
+    {
+      Seq.Remove(i);
+    }
+    Seq.Append(G);
+  }
+  if (isFirst)
+  {
+    Spine->SetFirstStatus(ChFiDS_FreeBoundary);
+  }
+  else
+  {
+    Spine->SetLastStatus(ChFiDS_FreeBoundary);
+  }
+  return true;
+}
