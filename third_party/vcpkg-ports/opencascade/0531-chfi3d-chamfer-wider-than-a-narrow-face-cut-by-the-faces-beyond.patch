+// The faces a chamfer is computed over with their surfaces unbounded, each
+// with its unbounded face (ChamferOverNarrowFace), set in the calling
+// thread while that chamfer is computed.
+static thread_local const NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>*
+  ChFi3d_NarrowFaces = nullptr;
+
+// Face F's unbounded face while ChFi3d_NarrowFaces holds it, in F's
+// orientation; else null.
+static TopoDS_Face ChFi3d_UnboundedFaceOf(const TopoDS_Face& F)
+{
+  if (ChFi3d_NarrowFaces == nullptr || F.IsNull() || !ChFi3d_NarrowFaces->IsBound(F))
+  {
+    return TopoDS_Face();
+  }
+  TopoDS_Face aWide = TopoDS::Face(ChFi3d_NarrowFaces->Find(F));
+  aWide.Orientation(F.Orientation());
+  return aWide;
+}
