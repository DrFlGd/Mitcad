+//=======================================================================
+// function : ChamferOverNarrowFace
+// purpose  : The chamfer's computation failed; where a piece's contact on
+//            a face B ends on an edge of B that is no edge of the spine,
+//            into a face beyond at an angle, the chamfer is computed again
+//            with B's surface unbounded (ConexFaces gives it for B), and
+//            then cut by the faces beyond B.
+//=======================================================================
+
+bool ChFi3d_Builder::ChamferOverNarrowFace(const occ::handle<ChFiDS_Stripe>& Stripe)
+{
+  const occ::handle<ChFiDS_Spine> Spine = Stripe->Spine();
+  if (occ::down_cast<ChFiDS_ChamfSpine>(Spine).IsNull() || Spine->IsPeriodic() || ChFi3d_NarrowFaces != nullptr
+      || Stripe->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  const auto onSpine = [&](const TopoDS_Shape& E) {
+    for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+    {
+      if (Spine->Edges(ie).IsSame(E))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  int         ons = 0;
+  TopoDS_Face B;
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq = Stripe->SetOfSurfData()->Sequence();
+  for (int i = 1; i <= Seq.Length() && ons == 0; i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(i);
+    for (int s = 1; s <= 2 && ons == 0; s++)
+    {
+      for (const bool aFirst : {true, false})
+      {
+        const ChFiDS_CommonPoint& CP = SD->Vertex(aFirst, s);
+        // (Not at the spine's ends, where the contacts reach the faces at the
+        // ends.)
+        const double aTI   = SD->Interference(s).Parameter(aFirst);
+        const bool   aWalk = aTI >= SD->FirstSpineParam() - Precision::PConfusion()
+                           && aTI <= SD->LastSpineParam() + Precision::PConfusion();
+        const double aW    = aWalk ? aTI : (aFirst ? SD->FirstSpineParam() : SD->LastSpineParam());
+        const double aEps  = std::max(10. * tolesp, 1.e-3);
+        const bool   aEnds = aW <= Spine->FirstParameter(1) + aEps
+                           || aW >= Spine->LastParameter(Spine->NbEdges()) - aEps;
+        if (aEnds || !CP.IsOnArc() || CP.IsVertex() || SD->Index(s) <= 0 || !myEFMap.Contains(CP.Arc()) || onSpine(CP.Arc()))
+        {
+          continue;
+        }
+        const TopoDS_Edge E = TopoDS::Edge(CP.Arc());
+        const TopoDS_Face N = TopoDS::Face(DStr.Shape(SD->Index(s)));
+        const TopoDS_Face C = otherFace(myEFMap, E, N);
+        if (!C.IsNull() && !C.IsSame(N) && !ChFi3d::IsTangentFaces(E, N, C))
+        {
+          ons = s;
+          B   = N;
+          break;
+        }
+      }
+    }
+  }
+  if (ons == 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(B);
+  if (SB.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face BF = B;
+  BF.Orientation(TopAbs_FORWARD);
+  const TopoDS_Face NF = BRepLib_MakeFace(SB, Precision::Confusion());
+  if (NF.IsNull())
+  {
+    return false;
+  }
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher> aMap;
+  aMap.Bind(BF, NF);
+  Stripe->Reset();
+  Spine->SetErrorStatus(ChFiDS_Ok);
+  bool aComputed = true;
+  ChFi3d_NarrowFaces = &aMap;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<ChFiDS_Stripe> aStripe = Stripe;
+    PerformSetOfKPart(aStripe, false);
+    PerformSetOfKGen(aStripe, false);
+  }
+  catch (Standard_Failure const& anEx)
+  {
+    aComputed = false;
+  }
+  ChFi3d_NarrowFaces = nullptr;
+  if (!aComputed || Spine->ErrorStatus() != ChFiDS_Ok)
+  {
+    return false;
+  }
+  // The pieces hold B again.
+  const int IB  = DStr.AddShape(B);
+  const int INF = DStr.AddShape(NF);
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq2 = Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  for (int i = 1; i <= Seq2.Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = Seq2.Value(i);
+    if (SD->IndexOfS1() == INF)
+    {
+      SD->ChangeIndexOfS1(IB);
+    }
+    if (SD->IndexOfS2() == INF)
+    {
+      SD->ChangeIndexOfS2(IB);
+    }
+  }
+  if (!ChamferCutByFacesBeyond(Stripe, ons, B))
+  {
+    return false;
+  }
+  done = true;
+  return true;
+}
+
+//=======================================================================
+// function : ChamferCutByFacesBeyond
+// purpose  : See the header.
+//=======================================================================
+
+namespace
+{
+// Where the contact of a chamfer on its narrow face B leaves B or comes
+// back into it (ChamferCutByFacesBeyond), and where the cut of the
+// chamfer by the face beyond meets its other contact.
+struct ChFi3d_NarrowCrossing
+{
+  int         SD    = 0;     // the piece (its index in the stripe)
+  double      t     = 0.;    // the parameter on its lines (a walked piece's)
+  bool        Leave = true;  // leaves B, in the order of the spine
+  gp_Pnt      P;             // the point
+  TopoDS_Edge E;             // B's edge crossed there
+  double      wE = 0.;       // the point's parameter on E
+  TopoDS_Face C;             // the face beyond B across E
+  double      tK = 0.;       // where the cut by C meets the other contact
+  gp_Pnt      K;
+};
+} // namespace
+
+// Face F's surface, a B-spline extended on both sides across its directions
+// of degree 1 (a walked chamfer's sections) by the width of its first and
+// last spans: the same surface and parameters where it is defined, and its
+// straight continuation beyond (a face beyond growing past its bounds).
+static occ::handle<Geom_Surface> ChFi3d_WideSurface(const TopoDS_Face& F)
+{
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface>        S  = BRep_Tool::Surface(FF);
+  const occ::handle<Geom_BSplineSurface> BS = occ::down_cast<Geom_BSplineSurface>(S);
+  if (BS.IsNull())
+  {
+    return S;
+  }
+  occ::handle<Geom_BSplineSurface> W = occ::down_cast<Geom_BSplineSurface>(BS->Copy());
+  for (const bool inU : {true, false})
+  {
+    if ((inU ? W->UDegree() : W->VDegree()) != 1 || (inU ? W->IsUPeriodic() : W->IsVPeriodic()) || W->IsURational()
+        || W->IsVRational())
+    {
+      continue;
+    }
+    const int nk = inU ? W->NbUKnots() : W->NbVKnots();
+    const int np = inU ? W->NbUPoles() : W->NbVPoles();
+    const int no = inU ? W->NbVPoles() : W->NbUPoles();
+    for (const bool atFirst : {true, false})
+    {
+      const int    k0 = atFirst ? 1 : nk, k1 = atFirst ? 2 : nk - 1;
+      const double u0 = inU ? W->UKnot(k0) : W->VKnot(k0), u1 = inU ? W->UKnot(k1) : W->VKnot(k1);
+      const double d  = u1 - u0; // (the span, signed)
+      const int    i0 = atFirst ? 1 : np, i1 = atFirst ? 2 : np - 1;
+      // (The end row moved along the span's lines to the knot a span on.)
+      for (int j = 1; j <= no; j++)
+      {
+        const gp_Pnt P0 = inU ? W->Pole(i0, j) : W->Pole(j, i0);
+        const gp_Pnt P1 = inU ? W->Pole(i1, j) : W->Pole(j, i1);
+        const gp_Pnt Pn = P0.Translated(gp_Vec(P1, P0));
+        if (inU)
+        {
+          W->SetPole(i0, j, Pn);
+        }
+        else
+        {
+          W->SetPole(j, i0, Pn);
+        }
+      }
+      if (inU)
+      {
+        W->SetUKnot(k0, u0 - d);
+      }
+      else
+      {
+        W->SetVKnot(k0, u0 - d);
+      }
+    }
+  }
+  return W;
+}
+
+// The signed distance of P from face F's surface (unbounded), positive on
+// the side away from the material (F's outer side in the solid).
+static bool ChFi3d_SignedDistance(const TopoDS_Face& F, const gp_Pnt& P, double& D)
+{
+  const occ::handle<Geom_Surface> S = ChFi3d_WideSurface(F);
+  if (S.IsNull())
+  {
+    return false;
+  }
+  GeomAPI_ProjectPointOnSurf aPr(P, S);
+  if (aPr.NbPoints() == 0)
+  {
+    return false;
+  }
+  double u = 0., v = 0.;
+  aPr.LowerDistanceParameters(u, v);
+  gp_Pnt Q;
+  gp_Vec Du, Dv;
+  S->D1(u, v, Q, Du, Dv);
+  gp_Vec N = Du.Crossed(Dv);
+  if (N.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  if (F.Orientation() == TopAbs_REVERSED)
+  {
+    N.Reverse();
+  }
+  D = gp_Vec(Q, P).Dot(N.Normalized());
+  return true;
+}
