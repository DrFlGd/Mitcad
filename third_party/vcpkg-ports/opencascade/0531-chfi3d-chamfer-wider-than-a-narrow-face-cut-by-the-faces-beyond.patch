+// A curve two faces grow up to (ChamferCutByFacesBeyond), from vertex V1
+// to V2, with its p-curves on both faces and the sides they keep.
+struct ChFi3d_GrowthCurve
+{
+  occ::handle<Geom_Curve>   C;
+  double                    First = 0., Last = 0.;
+  TopoDS_Face               F1, F2;
+  occ::handle<Geom2d_Curve> PC1, PC2;
+  TopAbs_Orientation        Or1 = TopAbs_FORWARD, Or2 = TopAbs_FORWARD;
+  TopoDS_Vertex             V1, V2;
+  bool                      Concave = true; // (the faces meet across a concave crease)
+  TopoDS_Edge               Along; // (an edge it prolongs: on that edge's sides of its faces)
+};
+} // namespace
