+static bool onSpineEdge(const occ::handle<ChFiDS_Spine>& Spine, const TopoDS_Shape& E)
+{
+  for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+  {
+    if (Spine->Edges(ie).IsSame(E))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The intersection curve of faces F1 and F2 (their surfaces unbounded)
+// from vertex V1 to V2, with its p-curves.
+static bool ChFi3d_FacesCurve(const TopoDS_Face&   F1,
+                              const TopoDS_Face&   F2,
+                              const TopoDS_Vertex& V1,
+                              const TopoDS_Vertex& V2,
+                              const double         Tol,
+                              ChFi3d_GrowthCurve&  G)
+{
+  TopoDS_Face A = F1, B = F2;
+  A.Orientation(TopAbs_FORWARD);
+  B.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> SA = ChFi3d_WideSurface(A), SB = ChFi3d_WideSurface(B);
+  const gp_Pnt                    P1 = BRep_Tool::Pnt(V1), P2 = BRep_Tool::Pnt(V2);
+  GeomInt_IntSS                   anInter;
+  anInter.Perform(SA, SB, 1.e-7, true, false, false);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  const double aTolP = 10. * Tol;
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    const occ::handle<Geom_Curve> L = anInter.Line(i);
+    GeomAPI_ProjectPointOnCurve   aPr1(P1, L), aPr2(P2, L);
+    if (aPr1.NbPoints() == 0 || aPr2.NbPoints() == 0 || aPr1.LowerDistance() > aTolP
+        || aPr2.LowerDistance() > aTolP)
+    {
+      continue;
+    }
+    const double t1 = aPr1.LowerDistanceParameter(), t2 = aPr2.LowerDistanceParameter();
+    if (std::abs(t2 - t1) <= Precision::PConfusion())
+    {
+      continue;
+    }
+    occ::handle<Geom_Curve> aC = new Geom_TrimmedCurve(L, std::min(t1, t2), std::max(t1, t2));
+    if (t2 < t1)
+    {
+      aC->Reverse();
+    }
+    G.C     = aC;
+    G.First = aC->FirstParameter();
+    G.Last  = aC->LastParameter();
+    G.PC1   = GeomProjLib::Curve2d(aC, G.First, G.Last, SA);
+    G.PC2   = GeomProjLib::Curve2d(aC, G.First, G.Last, SB);
+    if (G.PC1.IsNull() || G.PC2.IsNull())
+    {
+      return false;
+    }
+    G.F1 = F1;
+    G.F2 = F2;
+    G.V1 = V1;
+    G.V2 = V2;
+    return true;
+  }
+  return false;
+}
+
+// The straight segment from vertex V1 to V2 as a curve of faces F1 and F2
+// (an edge's tangent prolongation, ChFi3d_ProlongedEdgePoint), with its
+// p-curves on their surfaces (unbounded).
+static bool ChFi3d_SegmentOnFaces(const TopoDS_Face&   F1,
+                                  const TopoDS_Face&   F2,
+                                  const TopoDS_Vertex& V1,
+                                  const TopoDS_Vertex& V2,
+                                  ChFi3d_GrowthCurve&  G)
+{
+  const gp_Pnt P1 = BRep_Tool::Pnt(V1), P2 = BRep_Tool::Pnt(V2);
+  const double L  = P1.Distance(P2);
+  if (L <= Precision::Confusion())
+  {
+    return false;
+  }
+  G.C     = new Geom_TrimmedCurve(new Geom_Line(P1, gp_Dir(gp_Vec(P1, P2))), 0., L);
+  G.First = 0.;
+  G.Last  = L;
+  G.PC1   = GeomProjLib::Curve2d(G.C, 0., L, ChFi3d_WideSurface(F1));
+  G.PC2   = GeomProjLib::Curve2d(G.C, 0., L, ChFi3d_WideSurface(F2));
+  G.F1    = F1;
+  G.F2    = F2;
+  G.V1    = V1;
+  G.V2    = V2;
+  return !G.PC1.IsNull() && !G.PC2.IsNull();
+}
+
+// The point P where the prolongation of edge Ej of faces C1 and C2 beyond
+// its vertex J (its tangent line there) meets face A's surface, within Tol
+// of both faces' surfaces (unbounded).
+static bool ChFi3d_ProlongedEdgePoint(const TopoDS_Face&   A,
+                                      const TopoDS_Face&   C1,
+                                      const TopoDS_Face&   C2,
+                                      const TopoDS_Edge&   Ej,
+                                      const TopoDS_Vertex& J,
+                                      const double         Tol,
+                                      gp_Pnt&              P)
+{
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(Ej, f, l);
+  if (aC.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt PJ = BRep_Tool::Pnt(J);
+  const bool   atF = aC->Value(f).Distance(PJ) <= aC->Value(l).Distance(PJ);
+  gp_Pnt       Q;
+  gp_Vec       T;
+  aC->D1(atF ? f : l, Q, T);
+  if (T.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  // (Away from the edge.)
+  const gp_Dir                    D(atF ? -T : T);
+  const occ::handle<Geom_Line>    aLine = new Geom_Line(PJ, D);
+  GeomAPI_IntCS                   anCS(aLine, ChFi3d_WideSurface(A));
+  double                          best = RealLast();
+  for (int k = 1; anCS.IsDone() && k <= anCS.NbPoints(); k++)
+  {
+    double u = 0., v = 0., w = 0.;
+    anCS.Parameters(k, u, v, w);
+    if (w > 0. && w < best)
+    {
+      best = w;
+      P    = anCS.Point(k);
+    }
+  }
+  if (best == RealLast())
+  {
+    return false;
+  }
+  for (const TopoDS_Face& F : {C1, C2})
+  {
+    double D2 = 0.;
+    if (!ChFi3d_SignedDistance(F, P, D2) || std::abs(D2) > Tol)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+// A copy of walked piece SD between its lines' parameters ta and tb, on
+// surface Surf; its common points at new ends are on no arc.
+static occ::handle<ChFiDS_SurfData> ChFi3d_TrimWalkedPiece(TopOpeBRepDS_DataStructure&         DStr,
+                                                           const occ::handle<ChFiDS_SurfData>& SD,
+                                                           const double                        ta,
+                                                           const double                        tb,
+                                                           const int                           Surf)
+{
+  if (tb - ta <= Precision::PConfusion())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+  G->ChangeSurf(Surf);
+  G->ChangeIndexOfS1(SD->IndexOfS1());
+  G->ChangeIndexOfS2(SD->IndexOfS2());
+  G->ChangeOrientation() = SD->Orientation();
+  for (int s = 1; s <= 2; s++)
+  {
+    const ChFiDS_FaceInterference& FI  = SD->Interference(s);
+    ChFiDS_FaceInterference        aFI = FI;
+    const TopOpeBRepDS_Curve&      toc = DStr.Curve(FI.LineIndex());
+    aFI.SetLineIndex(
+      DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(toc.Curve()->Copy()), toc.Tolerance())));
+    aFI.ChangePCurveOnFace() = occ::down_cast<Geom2d_Curve>(FI.PCurveOnFace()->Copy());
+    aFI.ChangePCurveOnSurf() = occ::down_cast<Geom2d_Curve>(FI.PCurveOnSurf()->Copy());
+    aFI.SetFirstParameter(ta);
+    aFI.SetLastParameter(tb);
+    G->ChangeInterference(s) = aFI;
+    for (const bool aFirst : {true, false})
+    {
+      const double t    = aFirst ? ta : tb;
+      const bool   orig = std::abs(t - FI.Parameter(aFirst)) <= Precision::PConfusion();
+      if (orig)
+      {
+        G->ChangeVertex(aFirst, s) = SD->Vertex(aFirst, s);
+        continue;
+      }
+      ChFiDS_CommonPoint& CP = G->ChangeVertex(aFirst, s);
+      CP.Reset();
+      gp_Pnt P;
+      gp_Vec V;
+      toc.Curve()->D1(t, P, V);
+      CP.SetPoint(P);
+      CP.SetVector(V);
+      CP.SetTolerance(toc.Tolerance());
+    }
+  }
+  G->FirstSpineParam(ta);
+  G->LastSpineParam(tb);
+  return G;
+}
+
+// The piece of walked piece Full between ta and tb whose side `cut` is the
+// cut of Full by face C, the face beyond its narrow face: at one end
+// (DegFirst: at ta) the cut meets the other contact at point Pdeg on edge E
+// of the narrow face (parameter wE, the arc's kept side TrE) and the piece
+// ends in that point; at the other the cut starts on side cut's line, at
+// vertex VK (point Pk). On surface Surf.
+static occ::handle<ChFiDS_SurfData> ChFi3d_NarrowCutPiece(TopOpeBRepDS_DataStructure&         DStr,
+                                                          const occ::handle<ChFiDS_SurfData>& Full,
+                                                          const int                           cut,
+                                                          const TopoDS_Face&                  C,
+                                                          const double                        ta,
+                                                          const double                        tb,
+                                                          const bool                          DegFirst,
+                                                          const gp_Pnt&                       Pdeg,
+                                                          const TopoDS_Edge&                  E,
+                                                          const double                        wE,
+                                                          const TopAbs_Orientation            TrE,
+                                                          const TopoDS_Vertex&                VK,
+                                                          const gp_Pnt&                       Pk,
+                                                          const int                           Surf,
+                                                          const double                        tol3d,
+                                                          const ChFiDS_CommonPoint*           KCut   = nullptr,
+                                                          const ChFiDS_CommonPoint*           KOther = nullptr)
+{
+  const int                        other = 3 - cut;
+  const occ::handle<Geom_Surface>& S     = DStr.Surface(Full->Surf()).Surface();
+  const ChFiDS_FaceInterference&   FO    = Full->Interference(other);
+  const ChFiDS_FaceInterference&   FN    = Full->Interference(cut);
+  if (S.IsNull() || FO.PCurveOnSurf().IsNull() || FN.PCurveOnSurf().IsNull() || tb - ta <= Precision::PConfusion())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  // (The band of the chamfer between its contacts, across the spine.)
+  const gp_Pnt2d a = FO.PCurveOnSurf()->Value(ta), b = FO.PCurveOnSurf()->Value(tb);
+  const int      aCoord = std::abs(b.X() - a.X()) >= std::abs(b.Y() - a.Y()) ? 1 : 2;
+  const gp_Pnt2d n      = FN.PCurveOnSurf()->Value(0.5 * (ta + tb));
+  const double   cO = aCoord == 1 ? a.Y() : a.X(), cN = aCoord == 1 ? n.Y() : n.X();
+  const gp_Pnt   P1 = DegFirst ? Pdeg : Pk, P2 = DegFirst ? Pk : Pdeg;
+  // (The face beyond's surface past its bounds.)
+  const TopoDS_Face CF = BRepLib_MakeFace(ChFi3d_WideSurface(C), Precision::Confusion());
+  gp_Pnt2d uvS1, uvB1;
+  {
+    GeomAPI_ProjectPointOnSurf aPrS(P1, S), aPrB(P1, BRep_Tool::Surface(CF));
+    if (aPrS.NbPoints() == 0 || aPrB.NbPoints() == 0)
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    double u = 0., v = 0.;
+    aPrS.LowerDistanceParameters(u, v);
+    // (On the blend in the period of its lines: the start on one of them.)
+    uvS1 = DegFirst ? FO.PCurveOnSurf()->Value(ta) : FN.PCurveOnSurf()->Value(ta);
+    (void)aPrS;
+    aPrB.LowerDistanceParameters(u, v);
+    uvB1.SetCoord(u, v);
+  }
+  occ::handle<Geom_Curve>   Cc;
+  occ::handle<Geom2d_Curve> Ps, Pc;
+  double                    tolreached = tol3d;
+  bool                      computed   = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    computed = ChFi3d_KPartCutCurve(S, CF, P1, uvS1, uvB1, P2, aCoord, std::min(cO, cN) - 1.e-6,
+                                    std::max(cO, cN) + 1.e-6, tol3d, Cc, Ps, Pc, tolreached);
+  }
+  catch (Standard_Failure const&)
+  {
+    computed = false;
+  }
+  if (!computed)
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  const TopoDS_Face        N    = TopoDS::Face(DStr.Shape(Full->Index(cut)));
+  const TopAbs_Orientation aTrC = TopAbs::Compose(FN.Transition(), TopAbs::Compose(N.Orientation(), C.Orientation()));
+
+  occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+  G->ChangeSurf(Surf);
+  G->ChangeOrientation() = Full->Orientation();
+  G->ChangeIndexOfS1(Full->IndexOfS1());
+  G->ChangeIndexOfS2(Full->IndexOfS2());
+  if (cut == 1)
+  {
+    G->ChangeIndexOfS1(DStr.AddShape(C));
+  }
+  else
+  {
+    G->ChangeIndexOfS2(DStr.AddShape(C));
+  }
+  const TopOpeBRepDS_Curve& toc = DStr.Curve(FO.LineIndex());
+  {
+    ChFiDS_FaceInterference& GO = G->ChangeInterference(other);
+    GO.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(toc.Curve()->Copy()),
+                                                         toc.Tolerance())),
+                       FO.Transition(),
+                       occ::down_cast<Geom2d_Curve>(FO.PCurveOnFace()->Copy()),
+                       occ::down_cast<Geom2d_Curve>(FO.PCurveOnSurf()->Copy()));
+    GO.SetFirstParameter(ta);
+    GO.SetLastParameter(tb);
+  }
+  {
+    ChFiDS_FaceInterference& GI = G->ChangeInterference(cut);
+    GI.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tolreached)), aTrC, Pc, Ps);
+    GI.SetFirstParameter(Cc->FirstParameter());
+    GI.SetLastParameter(Cc->LastParameter());
+  }
+  for (const bool aFirst : {true, false})
+  {
+    ChFiDS_CommonPoint& CPN = G->ChangeVertex(aFirst, cut);
+    ChFiDS_CommonPoint& CPO = G->ChangeVertex(aFirst, other);
+    CPN.Reset();
+    CPO.Reset();
+    gp_Pnt PO;
+    gp_Vec VO, VN;
+    toc.Curve()->D1(aFirst ? ta : tb, PO, VO);
+    gp_Pnt PN;
+    Cc->D1(aFirst ? Cc->FirstParameter() : Cc->LastParameter(), PN, VN);
+    if (aFirst == DegFirst)
+    {
+      for (ChFiDS_CommonPoint* CP : {&CPN, &CPO})
+      {
+        CP->SetPoint(Pdeg);
+        CP->SetArc(tol3d, E, wE, TrE);
+      }
+      CPN.SetVector(VN);
+      CPO.SetVector(VO);
+    }
+    else
+    {
+      if (KCut != nullptr && KOther != nullptr)
+      {
+        // (The end given: the section of the piece it continues.)
+        CPN = *KCut;
+        CPO = *KOther;
+        continue;
+      }
+      CPN.SetPoint(Pk);
+      CPN.SetVector(VN);
+      CPN.SetVertex(VK);
+      CPN.SetTolerance(tolreached);
+      CPO.SetPoint(PO);
+      CPO.SetVector(VO);
+      CPO.SetTolerance(toc.Tolerance());
+    }
+  }
+  G->FirstSpineParam(ta);
+  G->LastSpineParam(tb);
+  return G;
+}
+
+bool ChFi3d_Builder::ChamferCutByFacesBeyond(const occ::handle<ChFiDS_Stripe>& Stripe,
+                                             const int                         ons,
+                                             const TopoDS_Face&                B)
+{
+  const int                        opp   = 3 - ons;
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  TopOpeBRepDS_DataStructure&      DStr  = myDS->ChangeDS();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq = Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  const double WEnd = Spine->LastParameter(Spine->NbEdges());
+  TopoDS_Face  BF   = B;
+  BF.Orientation(TopAbs_FORWARD);
+  BRepTopAdaptor_FClass2d aClass(BF, Precision::PConfusion());
+  const double            aTol = std::max(100. * tolapp3d, 1.e-4);
+  // (A walked piece: its lines' parameters are those of the spine.)
+  const auto walked = [&](const occ::handle<ChFiDS_SurfData>& SD) {
+    const ChFiDS_FaceInterference& FI = SD->Interference(ons);
+    // (Within the piece's spine parameters, up to the guide's own tolerance.)
+    const double aTolW = std::max(1.e-3 * (SD->LastSpineParam() - SD->FirstSpineParam()), Precision::PConfusion());
+    return std::abs(FI.FirstParameter() - SD->FirstSpineParam()) <= aTolW
+           && std::abs(FI.LastParameter() - SD->LastSpineParam()) <= aTolW;
+  };
+  const auto stateAt = [&](const occ::handle<ChFiDS_SurfData>& SD, const double t) {
+    return aClass.Perform(SD->Interference(ons).PCurveOnFace()->Value(t));
+  };
+  // 1. Where the contact on B leaves B and comes back, along the spine.
+  NCollection_Sequence<ChFi3d_NarrowCrossing> X;
+  NCollection_Sequence<ChFi3d_NarrowCrossing> XEnd; // (past the faces at the spine's ends)
+  bool                                        in = true, aStarted = false;
+  for (int i = 1; i <= Seq.Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(i);
+    const ChFiDS_FaceInterference&      FI = SD->Interference(ons);
+    if (SD->Index(ons) != DStr.AddShape(B) || FI.PCurveOnFace().IsNull() || FI.LineIndex() <= 0)
+    {
+      return false;
+    }
+    const double W0 = SD->FirstSpineParam(), W1 = SD->LastSpineParam();
+    if (W1 <= Precision::PConfusion() || W0 >= WEnd - Precision::PConfusion())
+    {
+      continue; // (past the spine's ends: the corners' business)
+    }
+    const bool isWalked = walked(SD);
+    const int  nbs      = 200;
+    double     tPrev    = FI.FirstParameter();
+    for (int k = 0; k <= nbs; k++)
+    {
+      const double t = FI.FirstParameter() + (FI.LastParameter() - FI.FirstParameter()) * k / nbs;
+      // (Not just at the spine's ends: there the contact may lie on B's edge with
+      // the face at the end.)
+      const double aEps = std::max(10. * tolesp, 1.e-3);
+      if (isWalked && (std::abs(t) < aEps || std::abs(t - WEnd) < aEps))
+      {
+        tPrev = t;
+        continue;
+      }
+      const TopAbs_State s   = stateAt(SD, t);
+      const bool         sIn = s != TopAbs_OUT;
+      if (!aStarted)
+      {
+        // (The state at the spine's start: outside B where the chamfer is
+        // cut off from there.)
+        aStarted = true;
+        in       = sIn;
+        tPrev    = t;
+        continue;
+      }
+      if (sIn != in)
+      {
+        if (!isWalked || k == 0)
+        {
+          return false;
+        }
+        double a = tPrev, b = t;
+        for (int it = 0; it < 60; it++)
+        {
+          const double m = 0.5 * (a + b);
+          ((stateAt(SD, m) != TopAbs_OUT) == in ? a : b) = m;
+        }
+        ChFi3d_NarrowCrossing x;
+        x.SD    = i;
+        x.t     = 0.5 * (a + b);
+        x.Leave = in;
+        x.P     = DStr.Curve(FI.LineIndex()).Curve()->Value(x.t);
+        double best = RealLast();
+        for (TopExp_Explorer ex(BF, TopAbs_EDGE); ex.More(); ex.Next())
+        {
+          const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+          double             f = 0., l = 0.;
+          if (BRep_Tool::Degenerated(Ec))
+          {
+            continue;
+          }
+          const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(Ec, f, l);
+          if (aC.IsNull())
+          {
+            continue;
+          }
+          GeomAPI_ProjectPointOnCurve aPr(x.P, aC, f, l);
+          if (aPr.NbPoints() > 0 && aPr.LowerDistance() < best)
+          {
+            best = aPr.LowerDistance();
+            x.E  = Ec;
+            x.wE = aPr.LowerDistanceParameter();
+          }
+        }
+        if (x.E.IsNull() || best > aTol)
+        {
+          return false;
+        }
+        x.C = otherFace(myEFMap, x.E, B);
+        if (x.C.IsNull() || x.C.IsSame(B) || ChFi3d::IsTangentFaces(x.E, B, x.C))
+        {
+          return false;
+        }
+        // (Not where the contact runs past the face at an end of the spine:
+        // an edge of B at the spine's end vertex.)
+        bool aAtEnd = false;
+        for (TopExp_Explorer exV(x.E, TopAbs_VERTEX); exV.More(); exV.Next())
+        {
+          aAtEnd = aAtEnd || exV.Current().IsSame(Spine->FirstVertex()) || exV.Current().IsSame(Spine->LastVertex());
+        }
+        if (!aAtEnd)
+        {
+          X.Append(x);
+        }
+        else
+        {
+          XEnd.Append(x);
+        }
+        in = sIn;
+      }
+      tPrev = t;
+    }
+  }
+  if (X.IsEmpty())
+  {
+    return false;
+  }
+  // (Where the contact on B reaches an end of the spine on an edge of B
+  // there, its point is on that edge, as the walk on B gives it: the corner
+  // at that end is made from there; the edge is kept away from the spine's
+  // end vertex.)
+  for (const bool aFirst : {true, false})
+  {
+    if (Seq.IsEmpty())
+    {
+      break;
+    }
+    const occ::handle<ChFiDS_SurfData>& SD = aFirst ? Seq.First() : Seq.Last();
+    ChFiDS_CommonPoint&                 CP = SD->ChangeVertex(aFirst, ons);
+    const TopoDS_Vertex                 aVEnd = aFirst ? Spine->FirstVertex() : Spine->LastVertex();
+    if (CP.IsOnArc() || std::abs((aFirst ? SD->FirstSpineParam() : SD->LastSpineParam())
+                                 - (aFirst ? Spine->FirstParameter(1) : Spine->LastParameter(Spine->NbEdges())))
+                          > 10. * tolesp)
+    {
+      continue;
+    }
+    for (TopExp_Explorer ex(BF, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+      bool               atV = false;
+      for (TopExp_Explorer exV(Ec, TopAbs_VERTEX); exV.More(); exV.Next())
+      {
+        atV = atV || exV.Current().IsSame(aVEnd);
+      }
+      double                        f = 0., l = 0.;
+      const occ::handle<Geom_Curve> aC = atV && !BRep_Tool::Degenerated(Ec) ? BRep_Tool::Curve(Ec, f, l)
+                                                                            : occ::handle<Geom_Curve>();
+      if (aC.IsNull() || onSpineEdge(Spine, Ec))
+      {
+        continue;
+      }
+      GeomAPI_ProjectPointOnCurve aPr(CP.Point(), aC, f, l);
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > aTol)
+      {
+        continue;
+      }
+      const double w = aPr.LowerDistanceParameter();
+      gp_Pnt       P;
+      gp_Vec       T;
+      aC->D1(w, P, T);
+      const TopAbs_Orientation aTr =
+        gp_Vec(P, BRep_Tool::Pnt(aVEnd)).Dot(T) > 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+      const gp_Pnt aPt  = CP.Point();
+      const gp_Vec aVec = CP.HasVector() ? CP.Vector() : gp_Vec();
+      const bool   aHas = CP.HasVector();
+      CP.Reset();
+      CP.SetPoint(aPt);
+      if (aHas)
+      {
+        CP.SetVector(aVec);
+      }
+      CP.SetArc(aTol, Ec, w, aTr);
+      break;
+    }
+  }
+  // (Where the contact runs past the face at an end of the spine, the
+  // piece's line on B starts or ends on B's edge there, as the walk on B
+  // gives it: the corner at that end is made from there. The edge is kept
+  // away from the spine's end vertex.)
+  for (int j = 1; j <= XEnd.Length(); j++)
+  {
+    const ChFi3d_NarrowCrossing&        x  = XEnd.Value(j);
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(x.SD);
+    ChFiDS_FaceInterference&            FI = SD->ChangeInterference(ons);
+    const bool                          aFirst = !x.Leave;
+    if (aFirst ? x.t - FI.FirstParameter() > 0.5 * (FI.LastParameter() - FI.FirstParameter())
+               : FI.LastParameter() - x.t > 0.5 * (FI.LastParameter() - FI.FirstParameter()))
+    {
+      return false;
+    }
+    TopoDS_Vertex Va, Vb;
+    TopExp::Vertices(x.E, Va, Vb);
+    const TopoDS_Vertex aVEnd =
+      Va.IsSame(Spine->FirstVertex()) || Va.IsSame(Spine->LastVertex()) ? Va : Vb;
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(x.E, f, l);
+    gp_Pnt                        P;
+    gp_Vec                        T;
+    aC->D1(x.wE, P, T);
+    const TopAbs_Orientation aTr = gp_Vec(P, BRep_Tool::Pnt(aVEnd)).Dot(T) > 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+    if (aFirst)
+    {
+      FI.SetFirstParameter(x.t);
+    }
+    else
+    {
+      FI.SetLastParameter(x.t);
+    }
+    ChFiDS_CommonPoint& CP = SD->ChangeVertex(aFirst, ons);
+    CP.Reset();
+    gp_Pnt Q;
+    gp_Vec V;
+    DStr.Curve(FI.LineIndex()).Curve()->D1(x.t, Q, V);
+    CP.SetPoint(x.P);
+    CP.SetVector(V);
+    CP.SetArc(aTol, x.E, x.wE, aTr);
+  }
+  // 2. The cut of the chamfer by the face beyond through each crossing: the
+  // material the chamfer adds is kept under that face, so where the other
+  // contact lies above it the cut runs back from the crossing across the
+  // chamfer to the other contact (before a leaving, after a coming back).
+  for (int j = 1; j <= X.Length(); j++)
+  {
+    ChFi3d_NarrowCrossing&              x  = X.ChangeValue(j);
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(x.SD);
+    const ChFiDS_FaceInterference&      FO = SD->Interference(opp);
+    const occ::handle<Geom_Curve>&      CO = DStr.Curve(FO.LineIndex()).Curve();
+    // (Outside the material: the side of the face beyond the contact on B
+    // runs to past the crossing, into the gap.)
+    TopoDS_Face Cs = x.C;
+    Cs.Orientation(TopAbs_FORWARD);
+    double sgn = 0.;
+    {
+      const ChFiDS_FaceInterference& FN = SD->Interference(ons);
+      const double dt = 1.e-3 * (FN.LastParameter() - FN.FirstParameter());
+      double       Dg = 0.;
+      if (!ChFi3d_SignedDistance(Cs, DStr.Curve(FN.LineIndex()).Curve()->Value(x.t + (x.Leave ? dt : -dt)), Dg)
+          || Dg == 0.)
+      {
+        return false;
+      }
+      sgn = Dg > 0. ? 1. : -1.;
+    }
+    double D = 0.;
+    if (!ChFi3d_SignedDistance(Cs, CO->Value(x.t), D) || D * sgn <= 0.)
+    {
+      return false;
+    }
+    const double tEnd = x.Leave ? FO.FirstParameter() : FO.LastParameter();
+    const int    nbs  = 200;
+    double       tOut = x.t, tIn = x.t;
+    bool         found = false;
+    for (int k = 1; k <= nbs && !found; k++)
+    {
+      const double t = x.t + (tEnd - x.t) * k / nbs;
+      if (!ChFi3d_SignedDistance(Cs, CO->Value(t), D))
+      {
+        return false;
+      }
+      if (D * sgn <= 0.)
+      {
+        found = true;
+        tIn   = t;
+      }
+      else
+      {
+        tOut = t;
+      }
+    }
+    if (!found)
+    {
+      return false;
+    }
+    for (int it = 0; it < 60; it++)
+    {
+      const double m = 0.5 * (tOut + tIn);
+      if (!ChFi3d_SignedDistance(Cs, CO->Value(m), D))
+      {
+        return false;
+      }
+      (D * sgn > 0. ? tOut : tIn) = m;
+    }
+    x.tK = 0.5 * (tOut + tIn);
+    x.K  = CO->Value(x.tK);
+  }
+  // 3. The crossings alternate (from the spine's start a coming back first
+  // where the chamfer is cut off from there); the cut's ends in order.
+  const bool fromStart = !X.First().Leave;
+  for (int j = 1; j <= X.Length(); j++)
+  {
+    const ChFi3d_NarrowCrossing& x = X.Value(j);
+    if (x.Leave != ((j % 2 == 1) != fromStart) || (x.Leave ? x.tK >= x.t : x.tK <= x.t))
+    {
+      return false;
+    }
+    if (j > 1 && X.Value(j - 1).SD == x.SD && X.Value(j - 1).tK >= x.tK)
+    {
+      return false;
+    }
+  }
+  const bool toEnd = X.Last().Leave; // (the last leaving comes not back)
+  // (The material's outer side of a face: +1 where its surface's normal
+  // points out of the solid.)
+  const auto outwardSign = [&](const TopoDS_Face& F, double& sgnOut) {
+    TopoDS_Face FF = F;
+    FF.Orientation(TopAbs_FORWARD);
+    const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+    BRepTopAdaptor_FClass2d         cl(FF, Precision::PConfusion());
+    double                          u0, u1, v0, v1;
+    BRepTools::UVBounds(FF, u0, u1, v0, v1);
+    for (int a = 1; a < 8; a++)
+    {
+      for (int b = 1; b < 8; b++)
+      {
+        const gp_Pnt2d uv(u0 + (u1 - u0) * a / 8., v0 + (v1 - v0) * b / 8.);
+        if (cl.Perform(uv) != TopAbs_IN)
+        {
+          continue;
+        }
+        gp_Pnt P;
+        gp_Vec Du, Dv;
+        S->D1(uv.X(), uv.Y(), P, Du, Dv);
+        gp_Vec N = Du.Crossed(Dv);
+        if (N.Magnitude() <= gp::Resolution())
+        {
+          continue;
+        }
+        N.Normalize();
+        BRepClass3d_SolidClassifier aSC(myShape, P.Translated(N * 1.e-3), 1.e-5);
+        BRepClass3d_SolidClassifier aSC2(myShape, P.Translated(N * -1.e-3), 1.e-5);
+        if (aSC.State() == TopAbs_OUT && aSC2.State() == TopAbs_IN)
+        {
+          sgnOut = 1.;
+          return true;
+        }
+        if (aSC.State() == TopAbs_IN && aSC2.State() == TopAbs_OUT)
+        {
+          sgnOut = -1.;
+          return true;
+        }
+      }
+    }
+    return false;
+  };
+  // 4. The vertices where each cut meets the other contact.
+  NCollection_Sequence<TopoDS_Vertex> VK;
+  {
+    BRep_Builder BB;
+    for (int j = 1; j <= X.Length(); j++)
+    {
+      TopoDS_Vertex V;
+      BB.MakeVertex(V, X.Value(j).K, aTol);
+      VK.Append(V);
+    }
+  }
+  // (The kept side of edge E at the crossing x: the side of the piece the
+  // chamfer is kept on.)
+  const auto arcTransition = [&](const ChFi3d_NarrowCrossing& x) {
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom_Curve>   aC = BRep_Tool::Curve(x.E, f, l);
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(x.SD);
+    const ChFiDS_FaceInterference&  FN = SD->Interference(ons);
+    const occ::handle<Geom_Curve>&  CN = DStr.Curve(FN.LineIndex()).Curve();
+    // (The direction along E toward the kept side: toward the contact's
+    // point before the crossing for a leaving, after it for a coming back.)
+    const double dt  = 1.e-2 * (FN.LastParameter() - FN.FirstParameter());
+    const gp_Pnt Q   = CN->Value(x.Leave ? x.t - dt : x.t + dt);
+    gp_Pnt       P;
+    gp_Vec       T;
+    aC->D1(x.wE, P, T);
+    return gp_Vec(P, Q).Dot(T) > 0. ? TopAbs_FORWARD : TopAbs_REVERSED;
+  };
+  // 5. The pieces of each part of the chamfer that is kept, in the order of
+  // the spine: up to a leaving the piece is cut at its cut's end and from
+  // there to the crossing by the face beyond; after a coming back likewise.
+  NCollection_Sequence<NCollection_Sequence<occ::handle<ChFiDS_SurfData>>> aParts;
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>                       aCur;
+  bool                                                                      aKept = !fromStart;
+  int                                                                       jx    = 1;
+  for (int i = 1; i <= Seq.Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(i);
+    // (A walked piece in a later part keeps a surface of its own.)
+    int    aSurf  = SD->Surf();
+    bool   aOwn   = false;
+    double tStart = SD->Interference(ons).FirstParameter();
+    bool   aWhole = true;
+    while (jx <= X.Length() && X.Value(jx).SD == i)
+    {
+      const ChFi3d_NarrowCrossing& x = X.Value(jx);
+      if (aParts.Length() > 0 && !aOwn)
+      {
+        aSurf = DStr.AddSurface(TopOpeBRepDS_Surface(
+          occ::down_cast<Geom_Surface>(DStr.Surface(SD->Surf()).Surface()->Copy()), DStr.Surface(SD->Surf()).Tolerance()));
+        aOwn = true;
+      }
+      if (x.Leave)
+      {
+        if (!aKept)
+        {
+          return false;
+        }
+        occ::handle<ChFiDS_SurfData> aN = ChFi3d_TrimWalkedPiece(DStr, SD, tStart, x.tK, aSurf);
+        occ::handle<ChFiDS_SurfData> aT =
+          ChFi3d_NarrowCutPiece(DStr, SD, opp, x.C, x.tK, x.t, false, x.P, x.E, x.wE, arcTransition(x),
+                                VK.Value(jx), x.K, aSurf, tolapp3d);
+        if (aN.IsNull() || aT.IsNull())
+        {
+          return false;
+        }
+        ChFiDS_CommonPoint& CPk = aN->ChangeVertex(false, opp);
+        CPk.SetVertex(VK.Value(jx));
+        aCur.Append(aN);
+        aCur.Append(aT);
+        aParts.Append(aCur);
+        aCur.Clear();
+        aKept = false;
+      }
+      else
+      {
+        if (aKept)
+        {
+          return false;
+        }
+        occ::handle<ChFiDS_SurfData> aT =
+          ChFi3d_NarrowCutPiece(DStr, SD, opp, x.C, x.t, x.tK, true, x.P, x.E, x.wE, arcTransition(x),
+                                VK.Value(jx), x.K, aSurf, tolapp3d);
+        if (aT.IsNull())
+        {
+          return false;
+        }
+        aCur.Append(aT);
+        tStart = x.tK;
+        aKept  = true;
+      }
+      aWhole = false;
+      jx++;
+    }
+    if (!aKept)
+    {
+      continue; // (consumed)
+    }
+    if (aWhole)
+    {
+      if (aParts.Length() > 0)
+      {
+        // (A piece of a later part: a surface of its own.)
+        occ::handle<ChFiDS_SurfData> aC = ChFi3d_CopyKPartData(DStr, SD);
+        if (aC.IsNull())
+        {
+          return false;
+        }
+        aCur.Append(aC);
+      }
+      else
+      {
+        aCur.Append(SD);
+      }
+    }
+    else
+    {
+      occ::handle<ChFiDS_SurfData> aN =
+        ChFi3d_TrimWalkedPiece(DStr, SD, tStart, SD->Interference(ons).LastParameter(), aSurf);
+      if (aN.IsNull())
+      {
+        return false;
+      }
+      aN->ChangeVertex(true, opp).SetVertex(VK.Value(jx - 1));
+      aCur.Append(aN);
+    }
+  }
+  if (aKept)
+  {
+    aParts.Append(aCur);
+  }
+  if (aParts.IsEmpty() || (toEnd == aKept))
+  {
+    return false;
+  }
+  // 6. The faces beyond grow down to the chamfer's other face where none of
+  // the chamfer is left: their intersection curves with that face, from
+  // one cut's end to the next (or, over the end of the spine, through the
+  // faces beyond along B's edges up to the spine's end vertex).
+  // (The chamfered edge's crease: the faces beyond meet the chamfer's other
+  // face across a crease of the same kind.)
+  bool aConcave = false;
+  {
+    TopoDS_Face aF1, aF2;
+    ChFi3d_conexfaces(Spine->Edges(1), aF1, aF2, myEFMap);
+    aConcave = ChFi3d::DefineConnectType(Spine->Edges(1), aF1, aF2, 1.e-4, false) == ChFiDS_Concave;
+  }
+  NCollection_Sequence<ChFi3d_GrowthCurve> aGrowth;
+  NCollection_List<TopoDS_Shape>            aDropped;
+  for (int j = 1; j <= X.Length(); j++)
+  {
+    const ChFi3d_NarrowCrossing& xl        = X.Value(j);
+    const bool                   aStartRun = !xl.Leave && j == 1;
+    if (!xl.Leave && !aStartRun)
+    {
+      continue; // (the end of the gap of the leaving before)
+    }
+    const TopoDS_Face A = TopoDS::Face(DStr.Shape(Seq.Value(xl.SD)->Index(opp)));
+    if (xl.Leave && j + 1 <= X.Length())
+    {
+      const ChFi3d_NarrowCrossing& xr = X.Value(j + 1);
+      if (!xr.C.IsSame(xl.C) || DStr.Shape(Seq.Value(xr.SD)->Index(opp)).IsSame(A) == false)
+      {
+        return false;
+      }
+      ChFi3d_GrowthCurve g;
+      if (!ChFi3d_FacesCurve(A, xl.C, VK.Value(j), VK.Value(j + 1), aTol, g))
+      {
+        return false;
+      }
+      g.Concave = aConcave;
+      aGrowth.Append(g);
+      continue;
+    }
+    // Over the end of the spine: B's edges from the crossing's edge up to
+    // the spine's last vertex, away from the part kept.
+    const TopoDS_Vertex VEnd = aStartRun ? Spine->FirstVertex() : Spine->LastVertex();
+    TopoDS_Edge         Ecur = xl.E;
+    TopoDS_Vertex       Vnext;
+    {
+      double                        f = 0., l = 0.;
+      const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(Ecur, f, l);
+      gp_Pnt                        P;
+      gp_Vec                        T;
+      aC->D1(xl.wE, P, T);
+      const bool aKeptAfter = arcTransition(xl) == TopAbs_FORWARD;
+      TopoDS_Vertex Vf, Vl;
+      TopExp::Vertices(Ecur, Vf, Vl, false);
+      Vnext = aKeptAfter ? Vf : Vl;
+    }
+    NCollection_Sequence<TopoDS_Face>   aBeyond;
+    NCollection_Sequence<TopoDS_Vertex> aJunctions;
+    aBeyond.Append(xl.C);
+    for (int n = 0; n < 4 && !Vnext.IsSame(VEnd); n++)
+    {
+      TopoDS_Edge Enext;
+      for (TopExp_Explorer ex(BF, TopAbs_EDGE); ex.More() && Enext.IsNull(); ex.Next())
+      {
+        const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+        if (Ec.IsSame(Ecur) || BRep_Tool::Degenerated(Ec))
+        {
+          continue;
+        }
+        for (TopExp_Explorer exV(Ec, TopAbs_VERTEX); exV.More(); exV.Next())
+        {
+          if (exV.Current().IsSame(Vnext))
+          {
+            Enext = Ec;
+          }
+        }
+      }
+      if (Enext.IsNull() || onSpineEdge(Spine, Enext))
+      {
+        return false;
+      }
+      aJunctions.Append(Vnext);
+      aBeyond.Append(otherFace(myEFMap, Enext, B));
+      aDropped.Append(Enext);
+      TopoDS_Vertex V1, V2;
+      TopExp::Vertices(Enext, V1, V2);
+      Vnext = V1.IsSame(Vnext) ? V2 : V1;
+      Ecur  = Enext;
+    }
+    // (The spine's edges from the crossing's piece to the end are under the
+    // chamfer and the faces grown: no face keeps them.)
+    for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+    {
+      if (aStartRun ? Spine->LastParameter(ie) <= Seq.Value(xl.SD)->LastSpineParam() + Precision::PConfusion()
+                    : Spine->FirstParameter(ie) >= Seq.Value(xl.SD)->FirstSpineParam() - Precision::PConfusion())
+      {
+        aDropped.Append(Spine->Edges(ie));
+      }
+    }
+    if (!Vnext.IsSame(VEnd) || aBeyond.Length() > 2)
+    {
+      return false;
+    }
+    if (aBeyond.Length() == 1)
+    {
+      ChFi3d_GrowthCurve g;
+      if (!ChFi3d_FacesCurve(A, xl.C, VK.Value(j), VEnd, aTol, g))
+      {
+        return false;
+      }
+      g.Concave = aConcave;
+      aGrowth.Append(g);
+    }
+    else
+    {
+      // Two faces beyond: their junction edge at the vertex between them
+      // prolonged to the chamfer's other face, at a new vertex.
+      const TopoDS_Face&   C1 = aBeyond.Value(1);
+      const TopoDS_Face&   C2 = aBeyond.Value(2);
+      const TopoDS_Vertex& J  = aJunctions.Value(1);
+      TopoDS_Edge          Ej;
+      for (TopExp_Explorer ex(C1, TopAbs_EDGE); ex.More() && Ej.IsNull(); ex.Next())
+      {
+        const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+        bool               atJ = false;
+        for (TopExp_Explorer exV(Ec, TopAbs_VERTEX); exV.More(); exV.Next())
+        {
+          atJ = atJ || exV.Current().IsSame(J);
+        }
+        if (atJ && otherFace(myEFMap, Ec, C1).IsSame(C2))
+        {
+          Ej = Ec;
+        }
+      }
+      if (Ej.IsNull())
+      {
+        return false;
+      }
+      gp_Pnt PJ;
+      if (!ChFi3d_ProlongedEdgePoint(A, C1, C2, Ej, J, aTol, PJ))
+      {
+        return false;
+      }
+      TopoDS_Vertex VP;
+      BRep_Builder().MakeVertex(VP, PJ, aTol);
+      ChFi3d_GrowthCurve g1, g2, g3;
+      if (!ChFi3d_FacesCurve(A, C1, VK.Value(j), VP, aTol, g1) || !ChFi3d_SegmentOnFaces(C1, C2, J, VP, g2)
+          || !ChFi3d_FacesCurve(A, C2, VP, VEnd, aTol, g3))
+      {
+        return false;
+      }
+      g1.Concave = aConcave;
+      g3.Concave = aConcave;
+      g2.Concave = ChFi3d::DefineConnectType(Ej, C1, C2, 1.e-4, false) == ChFiDS_Concave;
+      aGrowth.Append(g1);
+      g2.Along = Ej;
+      aGrowth.Append(g2);
+      aGrowth.Append(g3);
+    }
+  }
+  // 7. Each curve bounds both its faces on the sides they keep: where the
+  // faces meet across a concave crease each keeps the part outside the
+  // other's material, across a convex one the part inside it.
+  NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher> aSign;
+  const auto signOf = [&](const TopoDS_Face& F, double& s) {
+    if (aSign.IsBound(F))
+    {
+      s = aSign.Find(F);
+      return true;
+    }
+    if (!outwardSign(F, s))
+    {
+      return false;
+    }
+    aSign.Bind(F, s);
+    return true;
+  };
+  for (int k = 1; k <= aGrowth.Length(); k++)
+  {
+    ChFi3d_GrowthCurve& g = aGrowth.ChangeValue(k);
+    if (!g.Along.IsNull())
+    {
+      // (A prolongation of an edge: each face on that edge's side, the
+      // curve's direction against the edge's where it runs back.)
+      double                        f = 0., l = 0.;
+      const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(g.Along, f, l);
+      const gp_Pnt                  PJ  = BRep_Tool::Pnt(g.V1);
+      GeomAPI_ProjectPointOnCurve   aPr(PJ, aCE, f, l);
+      if (aPr.NbPoints() == 0)
+      {
+        return false;
+      }
+      gp_Pnt PE, PG;
+      gp_Vec TE, TG;
+      aCE->D1(aPr.LowerDistanceParameter(), PE, TE);
+      g.C->D1(g.First, PG, TG);
+      const bool aSameDir = TE.Dot(TG) > 0.;
+      for (int side = 1; side <= 2; side++)
+      {
+        TopoDS_Face FF = side == 1 ? g.F1 : g.F2;
+        FF.Orientation(TopAbs_FORWARD);
+        TopAbs_Orientation anOr = TopAbs_FORWARD;
+        for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+        {
+          if (ex.Current().IsSame(g.Along))
+          {
+            anOr = ex.Current().Orientation();
+          }
+        }
+        (side == 1 ? g.Or1 : g.Or2) = aSameDir ? anOr : TopAbs::Reverse(anOr);
+      }
+      continue;
+    }
+    double              s1 = 0., s2 = 0.;
+    if (!signOf(g.F1, s1) || !signOf(g.F2, s2))
+    {
+      return false;
+    }
+    const double tm = 0.5 * (g.First + g.Last);
+    for (int side = 1; side <= 2; side++)
+    {
+      const TopoDS_Face&               F  = side == 1 ? g.F1 : g.F2;
+      const TopoDS_Face&               Fo = side == 1 ? g.F2 : g.F1;
+      const double                     sO = side == 1 ? s2 : s1;
+      const occ::handle<Geom2d_Curve>& PC = side == 1 ? g.PC1 : g.PC2;
+      TopoDS_Face                      FF = F;
+      FF.Orientation(TopAbs_FORWARD);
+      const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+      // (A point of F a little to the left of the p-curve in F's
+      // parameters: where a FORWARD face lies of a FORWARD edge.)
+      gp_Pnt2d uv;
+      gp_Vec2d duv;
+      PC->D1(tm, uv, duv);
+      if (duv.Magnitude() <= gp::Resolution())
+      {
+        return false;
+      }
+      gp_Vec2d aLeft(-duv.Y(), duv.X());
+      aLeft.Normalize();
+      double aStep = 1.e-3;
+      {
+        gp_Pnt Q;
+        gp_Vec Du, Dv;
+        S->D1(uv.X(), uv.Y(), Q, Du, Dv);
+        const double aSpeed = (Du * aLeft.X() + Dv * aLeft.Y()).Magnitude();
+        if (aSpeed > gp::Resolution())
+        {
+          aStep = 10. * aTol / aSpeed;
+        }
+      }
+      const gp_Pnt2d uvL  = uv.Translated(aLeft * aStep);
+      const gp_Pnt   Pl   = S->Value(uvL.X(), uvL.Y());
+      // (Its side of the other face: by that face's tangent plane at the curve.)
+      bool out = false;
+      {
+        TopoDS_Face FoF = Fo;
+        FoF.Orientation(TopAbs_FORWARD);
+        const occ::handle<Geom2d_Curve>& PCo = side == 1 ? g.PC2 : g.PC1;
+        const gp_Pnt2d                   uvo = PCo->Value(tm);
+        gp_Pnt                           Qo;
+        gp_Vec                           Duo, Dvo;
+        BRep_Tool::Surface(FoF)->D1(uvo.X(), uvo.Y(), Qo, Duo, Dvo);
+        out = gp_Vec(Qo, Pl).Dot(Duo.Crossed(Dvo)) * sO > 0.;
+      }
+      const bool     keep = g.Concave ? out : !out;
+      // (Relative to the face as the data structure holds it.)
+      // (As an edge of the face taken FORWARD, as the faces' edges are.)
+      TopAbs_Orientation anOr = keep ? TopAbs_FORWARD : TopAbs_REVERSED;
+      (side == 1 ? g.Or1 : g.Or2) = anOr;
+    }
+  }
+  // 8. The stripe keeps the part at an end of the spine that is not cut off
+  // (its corner there is the stripe's); the other parts are stripes of
+  // their own, ending in points, or at the spine's other end, whose corner
+  // is then theirs.
+  const int nParts   = aParts.Length();
+  const int origPart = fromStart && !toEnd ? nParts : 1;
+  Seq                = aParts.Value(origPart);
+  if (fromStart)
+  {
+    Spine->SetFirstStatus(ChFiDS_FreeBoundary);
+  }
+  if (toEnd)
+  {
+    Spine->SetLastStatus(ChFiDS_FreeBoundary);
+  }
+  for (int p = 1; p <= nParts; p++)
+  {
+    if (p == origPart)
+    {
+      continue;
+    }
+    occ::handle<ChFiDS_Stripe> st = new ChFiDS_Stripe();
+    st->ChangeSpine()             = Spine;
+    st->OrientationOnFace1(Stripe->OrientationOnFace1());
+    st->OrientationOnFace2(Stripe->OrientationOnFace2());
+    st->Choix(Stripe->Choix());
+    st->SetSolidIndex(Stripe->SolidIndex());
+    st->ChangeSetOfSurfData() = new NCollection_HSequence<occ::handle<ChFiDS_SurfData>>();
+    st->ChangeSetOfSurfData()->ChangeSequence() = aParts.Value(p);
+    ChFi3d_SingularExtremity(st, DStr, TopoDS_Vertex(), tolapp3d, tol2d, 1);
+    if (p == nParts && !toEnd)
+    {
+      // (The spine's last end: its corner is this stripe's.)
+      const TopoDS_Vertex VL = Spine->LastVertex();
+      for (int iv = 1; iv <= myVDataMap.Extent(); iv++)
+      {
+        if (!myVDataMap.FindKey(iv).IsSame(VL))
+        {
+          continue;
+        }
+        // (The map holds the list itself; it gives it as const only.)
+        NCollection_List<occ::handle<ChFiDS_Stripe>>& aL =
+          const_cast<NCollection_List<occ::handle<ChFiDS_Stripe>>&>(myVDataMap.FindFromIndex(iv));
+        for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(aL); it.More(); it.Next())
+        {
+          if (it.Value() == Stripe)
+          {
+            it.ChangeValue() = st;
+          }
+        }
+      }
+    }
+    else
+    {
+      ChFi3d_SingularExtremity(st, DStr, TopoDS_Vertex(), tolapp3d, tol2d, 2);
+    }
+    myNarrowParts.Append(st);
+  }
+  if (origPart == 1 && nParts > 1 && !toEnd)
+  {
+    // (The stripe's own last end is a point where its part ends.)
+    occ::handle<ChFiDS_Stripe> aSt = Stripe;
+    ChFi3d_SingularExtremity(aSt, DStr, TopoDS_Vertex(), tolapp3d, tol2d, 2);
+  }
