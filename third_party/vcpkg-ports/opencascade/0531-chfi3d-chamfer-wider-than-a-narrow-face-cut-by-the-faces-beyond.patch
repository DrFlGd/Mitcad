+    const int                 ic = DStr.AddCurve(TopOpeBRepDS_Curve(new Geom_TrimmedCurve(g.C, g.First, g.Last), aTol));
+    DStr.ChangeCurveInterferences(ic).Append(
+      ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, DStr.AddShape(g.V1), g.First, true));
+    DStr.ChangeCurveInterferences(ic).Append(
+      ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, DStr.AddShape(g.V2), g.Last, true));
+    DStr.ChangeShapeInterferences(DStr.AddShape(g.F1)).Append(ChFi3d_FilCurveInDS(ic, DStr.AddShape(g.F1), g.PC1, g.Or1));
+    DStr.ChangeShapeInterferences(DStr.AddShape(g.F2)).Append(ChFi3d_FilCurveInDS(ic, DStr.AddShape(g.F2), g.PC2, g.Or2));
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(aDropped); it.More(); it.Next())
+  {
+    TopoDS_Edge E = TopoDS::Edge(it.Value());
+    E.Orientation(TopAbs_FORWARD);
+    const int IE = DStr.AddShape(E);
+    for (TopExp_Explorer exV(E, TopAbs_VERTEX); exV.More(); exV.Next())
+    {
+      const TopoDS_Vertex& V = TopoDS::Vertex(exV.Current());
+      DStr.ChangeShapeInterferences(IE).Append(
+        ChFi3d_FilVertexInDS(TopAbs_EXTERNAL, IE, DStr.AddShape(V), BRep_Tool::Parameter(V, E)));
+    }
+  }
+  return true;
+}
