+//=======================================================================
+// function : ChFi3d_ContactTouchesEndFace
+// purpose  : OnSame end whose opposite contact C (on the blend HGs, with
+//            the interference FI) touches the surface of the face at the
+//            end HBs without crossing it, the blend tangent to that surface
+//            there (a rounding running on into an earlier rounding of its
+//            radius, whose tube is tangent to the opposite face along the
+//            prolonged edge): the point where they touch within Tol, the
+//            one nearest the parameter W. Updates FI, CP, the point's
+//            parameters UV on the face and W as IntersUpdateOnSame does.
+//=======================================================================
+
+static bool ChFi3d_ContactTouchesEndFace(const occ::handle<Geom_Curve>&          C,
+                                         const occ::handle<GeomAdaptor_Surface>& HGs,
+                                         const occ::handle<BRepAdaptor_Surface>& HBs,
+                                         const bool                              isFirst,
+                                         const double                            Tol,
+                                         ChFiDS_FaceInterference&                FI,
+                                         ChFiDS_CommonPoint&                     CP,
+                                         gp_Pnt2d&                               UV,
+                                         double&                                 W)
+{
+  if (C.IsNull() || HGs.IsNull() || HBs.IsNull() || FI.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const double      uf = std::min(FI.FirstParameter(), FI.LastParameter());
+  const double      ul = std::max(FI.FirstParameter(), FI.LastParameter());
+  GeomAdaptor_Curve aC(C, uf, ul);
+  Extrema_ExtCS     anExt(aC, *HBs, Precision::PConfusion(), Precision::PConfusion());
+  if (!anExt.IsDone() || anExt.IsParallel())
+  {
+    return false;
+  }
+  int    iBest = 0;
+  double dBest = RealLast();
+  for (int i = 1; i <= anExt.NbExt(); i++)
+  {
+    if (anExt.SquareDistance(i) > Tol * Tol)
+    {
+      continue;
+    }
+    Extrema_POnCurv aPC;
+    Extrema_POnSurf aPS;
+    anExt.Points(i, aPC, aPS);
+    const double d = std::abs(aPC.Parameter() - W);
+    if (d < dBest)
+    {
+      dBest = d;
+      iBest = i;
+    }
+  }
+  if (iBest == 0)
+  {
+    return false;
+  }
+  Extrema_POnCurv aPC;
+  Extrema_POnSurf aPS;
+  anExt.Points(iBest, aPC, aPS);
+  const double w = aPC.Parameter();
+  double       u = 0., v = 0.;
+  aPS.Parameter(u, v);
+  // The blend tangent to the face there.
+  const gp_Pnt2d uvB = FI.PCurveOnSurf()->Value(w);
+  gp_Pnt         p1, p2;
+  gp_Vec         du1, dv1, du2, dv2;
+  HGs->D1(uvB.X(), uvB.Y(), p1, du1, dv1);
+  HBs->D1(u, v, p2, du2, dv2);
+  const gp_Vec n1 = du1.Crossed(dv1), n2 = du2.Crossed(dv2);
+  if (n1.Magnitude() < gp::Resolution() || n2.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  const double a = n1.Angle(n2);
+  if (std::min(a, M_PI - a) > 0.01)
+  {
+    return false;
+  }
+  FI.SetParameter(w, isFirst);
+  CP.Reset();
+  CP.SetPoint(C->Value(w));
+  UV.SetCoord(u, v);
+  W = w;
+  return true;
+}
