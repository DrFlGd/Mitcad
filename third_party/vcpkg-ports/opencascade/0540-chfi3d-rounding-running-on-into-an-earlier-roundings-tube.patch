+//=======================================================================
+// function : ChFi3d_ProlongTangentEdgeAlongIso
+// purpose  : As ChFi3d_ProlongTangentEdge where E's curve ends at V but
+//            E runs along an iso of Fv's surface SV that goes on past V
+//            to the point P (Fv an earlier rounding tangent to Fop along
+//            E, trimmed at V by the blend's face; its surface continues
+//            past its edge there): the prolongation is that iso from V to
+//            P, on Fop within Tol.
+//=======================================================================
+
+static bool ChFi3d_ProlongTangentEdgeAlongIso(const TopoDS_Edge&                    E,
+                                              const TopoDS_Face&                    Fop,
+                                              const TopoDS_Face&                    Fv,
+                                              const occ::handle<Geom_Surface>&      SV,
+                                              const occ::handle<Adaptor3d_Surface>& HSop,
+                                              const occ::handle<Adaptor3d_Surface>& HSv,
+                                              const TopoDS_Vertex&                  V,
+                                              const gp_Pnt&                         P,
+                                              const double                          Tol,
+                                              occ::handle<Geom_Curve>&              C3d,
+                                              occ::handle<Geom2d_Curve>&            PcOp,
+                                              occ::handle<Geom2d_Curve>&            PcV,
+                                              double&                               tolreached)
+{
+  if (SV.IsNull() || BRep_Tool::Degenerated(E) || !ChFi3d::IsTangentFaces(E, Fop, Fv))
+  {
+    return false;
+  }
+  double                          f = 0., l = 0.;
+  const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(E, Fv, f, l);
+  if (pc.IsNull())
+  {
+    return false;
+  }
+  const double   tV = BRep_Tool::Parameter(V, E);
+  const gp_Pnt2d a  = pc->Value(f), b = pc->Value(l), m = pc->Value(0.5 * (f + l));
+  const gp_Pnt2d uvV = pc->Value(tV);
+  // E along an iso: one of the parameters the same along it.
+  const double tolU = std::max(1.e-9, HSv->UResolution(Tol)), tolV = std::max(1.e-9, HSv->VResolution(Tol));
+  const bool   alongV = std::abs(a.X() - b.X()) <= tolU && std::abs(a.X() - m.X()) <= tolU;
+  const bool   alongU = std::abs(a.Y() - b.Y()) <= tolV && std::abs(a.Y() - m.Y()) <= tolV;
+  if (alongU == alongV)
+  {
+    return false;
+  }
+  GeomAPI_ProjectPointOnSurf aPr(P, SV);
+  if (aPr.NbPoints() == 0 || aPr.LowerDistance() > Tol)
+  {
+    return false;
+  }
+  double uP = 0., vP = 0.;
+  aPr.LowerDistanceParameters(uP, vP);
+  // P on the iso, past V away from the edge's other end (its parameters
+  // in the periods of the iso and of V on a periodic surface).
+  const double iso  = alongV ? uvV.X() : uvV.Y();
+  const double wV   = alongV ? uvV.Y() : uvV.X();
+  double       onP  = alongV ? uP : vP;
+  double       wP   = alongV ? vP : uP;
+  const double wFar = alongV ? (std::abs(a.Y() - wV) > std::abs(b.Y() - wV) ? a.Y() : b.Y())
+                             : (std::abs(a.X() - wV) > std::abs(b.X() - wV) ? a.X() : b.X());
+  if (alongV ? SV->IsUPeriodic() : SV->IsVPeriodic())
+  {
+    const double T = alongV ? SV->UPeriod() : SV->VPeriod();
+    onP            = ElCLib::InPeriod(onP, iso - 0.5 * T, iso + 0.5 * T);
+  }
+  if (alongV ? SV->IsVPeriodic() : SV->IsUPeriodic())
+  {
+    const double T = alongV ? SV->VPeriod() : SV->UPeriod();
+    wP             = ElCLib::InPeriod(wP, wV - 0.5 * T, wV + 0.5 * T);
+  }
+  if (std::abs(onP - iso) > (alongV ? tolU : tolV) * 10. || (wP - wV) * (wFar - wV) >= 0.
+      || std::abs(wP - wV) <= Precision::PConfusion())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve> anIso = alongV ? SV->UIso(iso) : SV->VIso(iso);
+  if (anIso.IsNull())
+  {
+    return false;
+  }
+  occ::handle<Geom_Curve> aC = new Geom_TrimmedCurve(anIso, std::min(wV, wP), std::max(wV, wP));
+  if (wP < wV)
+  {
+    aC->Reverse();
+  }
+  // On Fop too, within Tol.
+  const occ::handle<Geom_Surface> SOp = BRep_Tool::Surface(Fop);
+  if (SOp.IsNull())
+  {
+    return false;
+  }
+  for (int k = 0; k <= 4; k++)
+  {
+    const gp_Pnt Q = aC->Value(aC->FirstParameter() + 0.25 * k * (aC->LastParameter() - aC->FirstParameter()));
+    GeomAPI_ProjectPointOnSurf aPq(Q, SOp);
+    if (aPq.NbPoints() == 0 || aPq.LowerDistance() > Tol)
+    {
+      return false;
+    }
+  }
+  const occ::handle<Geom2d_Curve> aPcOp =
+    GeomProjLib::Curve2d(aC, aC->FirstParameter(), aC->LastParameter(), SOp);
+  if (aPcOp.IsNull())
+  {
+    return false;
+  }
+  // The curve on SV: the iso's line, parametrized as the 3d curve.
+  const gp_Pnt2d p1 = alongV ? gp_Pnt2d(iso, wV) : gp_Pnt2d(wV, iso);
+  const gp_Pnt2d p2 = alongV ? gp_Pnt2d(iso, wP) : gp_Pnt2d(wP, iso);
+  occ::handle<Geom2d_Curve> aPcV =
+    new Geom2d_Line(p1, gp_Dir2d(gp_Vec2d(p1, p2)));
+  aPcV = new Geom2d_TrimmedCurve(aPcV, 0., p1.Distance(p2));
+  aPcV = Geom2dConvert::CurveToBSplineCurve(aPcV);
+  ChFi3d_ReparamPcurv(aC->FirstParameter(), aC->LastParameter(), aPcV);
+  C3d        = aC;
+  PcOp       = aPcOp;
+  PcV        = aPcV;
+  tolreached = std::max(BRep_Tool::Tolerance(E), ChFi3d_EvalTolReached(HSop, PcOp, HSv, PcV, C3d));
+  return true;
+}
