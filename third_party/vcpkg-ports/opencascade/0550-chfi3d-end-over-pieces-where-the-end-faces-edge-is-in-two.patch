+//=======================================================================
+// function : ChFi3d_ArcGoesOnAs
+// purpose  : Whether edge E is the arc Arc of the vertex V or goes on from
+//            it between the same two faces through vertices where no other
+//            edge meets: an edge of the face at the end left in pieces at a
+//            vertex an earlier operation kept (a profile's vertex whose
+//            other edges a chamfer or rounding took away).
+//=======================================================================
+
+static bool ChFi3d_ArcGoesOnAs(const TopoDS_Edge&   E,
+                               const TopoDS_Edge&   Arc,
+                               const TopoDS_Vertex& V,
+                               const ChFiDS_Map&    VEMap,
+                               const ChFiDS_Map&    EFMap)
+{
+  if (E.IsNull() || Arc.IsNull())
+  {
+    return false;
+  }
+  if (E.IsSame(Arc))
+  {
+    return true;
+  }
+  if (!EFMap.Contains(Arc) || !EFMap.Contains(E))
+  {
+    return false;
+  }
+  NCollection_List<TopoDS_Shape> aFaces;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(EFMap(Arc)); anIt.More(); anIt.Next())
+  {
+    bool isNew = true;
+    for (NCollection_List<TopoDS_Shape>::Iterator anItF(aFaces); anItF.More() && isNew; anItF.Next())
+    {
+      isNew = !anItF.Value().IsSame(anIt.Value());
+    }
+    if (isNew)
+    {
+      aFaces.Append(anIt.Value());
+    }
+  }
+  if (aFaces.Extent() != 2)
+  {
+    return false;
+  }
+  TopoDS_Edge   aCur  = Arc;
+  TopoDS_Vertex aFrom = V;
+  for (int aStep = 0; aStep < 8; aStep++)
+  {
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aCur, aV1, aV2);
+    TopoDS_Vertex aNext;
+    if (aV1.IsSame(aFrom))
+    {
+      aNext = aV2;
+    }
+    else if (aV2.IsSame(aFrom))
+    {
+      aNext = aV1;
+    }
+    if (aNext.IsNull() || aNext.IsSame(aFrom) || !VEMap.Contains(aNext))
+    {
+      return false;
+    }
+    // The one other edge at the next vertex.
+    TopoDS_Edge anOther;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(VEMap(aNext)); anIt.More(); anIt.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anIt.Value());
+      if (BRep_Tool::Degenerated(anE) || anE.IsSame(aCur) || (!anOther.IsNull() && anE.IsSame(anOther)))
+      {
+        continue;
+      }
+      if (!anOther.IsNull())
+      {
+        return false;
+      }
+      anOther = anE;
+    }
+    if (anOther.IsNull() || !EFMap.Contains(anOther))
+    {
+      return false;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anItF(aFaces); anItF.More(); anItF.Next())
+    {
+      bool isOn = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator anIt(EFMap(anOther)); anIt.More() && !isOn; anIt.Next())
+      {
+        isOn = anIt.Value().IsSame(anItF.Value());
+      }
+      if (!isOn)
+      {
+        return false;
+      }
+    }
+    if (anOther.IsSame(E))
+    {
+      return true;
+    }
+    aFrom = aNext;
+    aCur  = anOther;
+  }
+  return false;
+}
