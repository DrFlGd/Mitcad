+//=======================================================================
+// function : HatchOffConcaveEdges
+// purpose  : A tangency line (a straight one) running in part along a
+//            concave edge of its face F (a block whose side is flush with
+//            the contact, the face beyond rising into the blend): the
+//            hatcher takes that part as inside F or outside it as the line
+//            lies a rounding error to one side of the edge or the other.
+//            No ball of the blend touches F there (the face beyond cuts
+//            it), so the domains are those of the line moved off F across
+//            those edges by Shift (their ends near a vertex then are at the
+//            vertex, SnapToVertex). Replaces the hatching iH of H by that
+//            one and returns the number of domains; 0 where the line runs
+//            along no such edge.
+//=======================================================================
+
+static int HatchOffConcaveEdges(Geom2dHatch_Hatcher&                    H,
+                                int&                                    iH,
+                                const occ::handle<Geom2d_Curve>&        C,
+                                const occ::handle<Adaptor3d_TopolTool>& I,
+                                const occ::handle<Adaptor3d_Surface>&   S,
+                                const ChFiDS_Map&                       EFMap,
+                                const double                            Shift)
+{
+  occ::handle<Geom2d_Curve> aBasis = C;
+  if (const occ::handle<Geom2d_TrimmedCurve> aTrim = occ::down_cast<Geom2d_TrimmedCurve>(C))
+  {
+    aBasis = aTrim->BasisCurve();
+  }
+  const occ::handle<Geom2d_Line>         aLine = occ::down_cast<Geom2d_Line>(aBasis);
+  const occ::handle<BRepAdaptor_Surface> aBS   = occ::down_cast<BRepAdaptor_Surface>(S);
+  if (aLine.IsNull() || aBS.IsNull())
+  {
+    return 0;
+  }
+  const gp_Lin2d aL = aLine->Lin2d();
+  const gp_Vec2d aN(-aL.Direction().Y(), aL.Direction().X());
+  const TopoDS_Face& F    = aBS->Face();
+  double             aDir = 0.;
+  for (I->Init(); I->More(); I->Next())
+  {
+    const occ::handle<BRepAdaptor_Curve2d> Bc = occ::down_cast<BRepAdaptor_Curve2d>(I->Value());
+    if (Bc.IsNull() || Bc->GetType() != GeomAbs_Line || !EFMap.Contains(Bc->Edge()))
+    {
+      continue;
+    }
+    const TopoDS_Edge& E   = Bc->Edge();
+    const double       Tol = std::max(BRep_Tool::Tolerance(E), Precision::Confusion());
+    const double       a = Bc->FirstParameter(), b = Bc->LastParameter();
+    bool               along = b - a > 10. * Shift;
+    for (int k = 0; k <= 2 && along; k++)
+    {
+      const gp_Pnt2d p = Bc->Value(a + (b - a) * k / 2.);
+      const gp_Pnt2d q = ElCLib::Value(ElCLib::Parameter(aL, p), aL);
+      along            = S->Value(p.X(), p.Y()).Distance(S->Value(q.X(), q.Y())) <= Tol;
+    }
+    if (!along)
+    {
+      continue;
+    }
+    TopoDS_Face Fb;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(F))
+      {
+        Fb = TopoDS::Face(it.Value());
+      }
+    }
+    if (Fb.IsNull() || ChFi3d::DefineConnectType(E, F, Fb, Precision::Angular(), false) != ChFiDS_Concave)
+    {
+      continue;
+    }
+    // (Off F: the side of the line where F is not, beside the edge's middle.)
+    const gp_Pnt2d m = Bc->Value(0.5 * (a + b));
+    double         d = 0.;
+    for (const double aSide : {1., -1.})
+    {
+      if (I->Classify(m.Translated(aN * (aSide * Shift)), Precision::PConfusion(), false) == TopAbs_OUT)
+      {
+        d = aSide;
+      }
+    }
+    if (d == 0. || d * aDir < 0.)
+    {
+      return 0;
+    }
+    aDir = d;
+  }
+  if (aDir == 0.)
+  {
+    return 0;
+  }
+  const occ::handle<Geom2d_Curve> aCs = occ::down_cast<Geom2d_Curve>(C->Translated(aN * (aDir * Shift)));
+  if (aCs.IsNull())
+  {
+    return 0;
+  }
+  Geom2dAdaptor_Curve aLs(aCs);
+  const int           iHs = H.Trim(aLs);
+  H.ComputeDomains(iHs);
+  const int aNb = H.IsDone(iHs) ? H.NbDomains(iHs) : 0;
+  if (aNb == 0)
+  {
+    H.RemHatching(iHs);
+    return 0;
+  }
+  H.RemHatching(iH);
+  iH = iHs;
+  return aNb;
+}
