@@ -1584,11 +1584,62 @@
 
 //=================================================================================================
 
+namespace
+{
+// Whether a surface is planar within the linear tolerance, and its plane.
+struct SurfacePlanarity
+{
+  occ::handle<Geom_Surface> Surface; // keeps the key alive
+  bool                      IsPlanar = false;
+  gp_Pln                    Plane;
+};
+
+typedef NCollection_DataMap<const Geom_Surface*, SurfacePlanarity> DataMapOfSurfacePlanarity;
+} // namespace
+
+// The planarity of a face's surface (theSurface, without its location
+// theLocation) tested once per surface and kept in theCache: the faces of
+// one surface (the pieces of a B-spline face running many turns) each met
+// their neighbours with a test of the whole surface, tens of thousands of
+// points each time (mitcad#235). A located surface is tested as before.
+static bool IsPlanarSurface(const occ::handle<Geom_Surface>& theSurface,
+                            const TopLoc_Location&           theLocation,
+                            const occ::handle<Geom_Surface>& theLocated,
+                            const double                     theLinTol,
+                            DataMapOfSurfacePlanarity&       theCache,
+                            gp_Pln&                          thePlane)
+{
+  const bool aCached = theLocation.IsIdentity() && theSurface == theLocated;
+  if (aCached)
+  {
+    if (const SurfacePlanarity* aFound = theCache.Seek(theSurface.get()))
+    {
+      thePlane = aFound->Plane;
+      return aFound->IsPlanar;
+    }
+  }
+  GeomLib_IsPlanarSurface aPlanarityChecker(theLocated, theLinTol);
+  SurfacePlanarity        aResult;
+  aResult.Surface  = theSurface;
+  aResult.IsPlanar = aPlanarityChecker.IsPlanar();
+  if (aResult.IsPlanar)
+  {
+    aResult.Plane = aPlanarityChecker.Plan();
+  }
+  if (aCached)
+  {
+    theCache.Bind(theSurface.get(), aResult);
+  }
+  thePlane = aResult.Plane;
+  return aResult.IsPlanar;
+}
