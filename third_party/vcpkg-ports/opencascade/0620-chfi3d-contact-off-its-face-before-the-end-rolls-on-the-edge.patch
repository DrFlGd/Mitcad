+// Whether edge E is a sharp convex edge of the solid between faces F1 and
+// F2 at its parameter W: the faces' outward normals there turn about the
+// edge's direction in F1 the way of a convex edge, and are not tangent.
+static bool ChFi3d_ConvexEdgeAt(const TopoDS_Edge& E, const TopoDS_Face& F1, const TopoDS_Face& F2, const double W)
+{
+  double                          f, l;
+  const occ::handle<Geom2d_Curve> C1 = BRep_Tool::CurveOnSurface(E, F1, f, l);
+  const occ::handle<Geom2d_Curve> C2 = BRep_Tool::CurveOnSurface(E, F2, f, l);
+  if (C1.IsNull() || C2.IsNull() || F1.IsSame(F2))
+  {
+    return false;
+  }
+  BRepAdaptor_Curve C(E);
+  gp_Pnt            P;
+  gp_Vec            T;
+  C.D1(W, P, T);
+  if (T.SquareMagnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  T.Normalize();
+  if (BRepTools::OriEdgeInFace(E, F1) == TopAbs_REVERSED)
+  {
+    T.Reverse();
+  }
+  if (F1.Orientation() == TopAbs_REVERSED)
+  {
+    T.Reverse();
+  }
+  gp_Vec N[2];
+  for (int k = 0; k < 2; k++)
+  {
+    const TopoDS_Face&              Fk = k == 0 ? F1 : F2;
+    const gp_Pnt2d                  uv = (k == 0 ? C1 : C2)->Value(W);
+    const occ::handle<Geom_Surface> S  = BRep_Tool::Surface(Fk);
+    gp_Vec                          DU, DV;
+    S->D1(uv.X(), uv.Y(), P, DU, DV);
+    N[k] = DU.Crossed(DV);
+    if (N[k].SquareMagnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    N[k].Normalize();
+    if (Fk.Orientation() == TopAbs_REVERSED)
+    {
+      N[k].Reverse();
+    }
+  }
+  const gp_Vec Pro = N[0].Crossed(N[1]);
+  return Pro.Magnitude() >= 1.e-4 && T.Dot(Pro) > 0.;
+}
+
+//=======================================================================
+// function : ChFi3d_ObstacleBeforeEnd
+// purpose  : A contact that left its face F across a convex edge E more
+//            than Tol before the spine's end, where the face beyond E
+//            does not hold the end vertex Vend: no face at the end lies
+//            there, the ball rolls on E (an obstacle, as in the middle of
+//            the rounding); the walk is not to go on past E over F's
+//            surface towards the end.
+//=======================================================================
+
+bool ChFi3d_ObstacleBeforeEnd(const ChFiDS_CommonPoint& CP,
+                              const TopoDS_Face&        F,
+                              const TopoDS_Vertex&      Vend,
+                              const double              W,
+                              const double              WEnd,
+                              const bool                AtFirst,
+                              const double              Tol,
+                              const ChFiDS_Map&         EFMap,
+                              const ChFiDS_Map&         VFMap)
+{
+  if (!CP.IsOnArc() || CP.IsVertex() || F.IsNull() || Vend.IsNull() || !EFMap.Contains(CP.Arc())
+      || !VFMap.Contains(Vend))
+  {
+    return false;
+  }
+  if ((AtFirst ? W - WEnd : WEnd - W) <= Tol)
+  {
+    return false;
+  }
+  const TopoDS_Edge& E = CP.Arc();
+  if (TopExp::FirstVertex(E).IsSame(Vend) || TopExp::LastVertex(E).IsSame(Vend))
+  {
+    return false;
+  }
+  TopoDS_Face Fin, Fbeyond;
+  for (const TopoDS_Shape& aFace : EFMap.FindFromKey(E))
+  {
+    if (aFace.IsSame(F))
+    {
+      Fin = TopoDS::Face(aFace);
+      continue;
+    }
+    if (!Fbeyond.IsNull() && !Fbeyond.IsSame(aFace))
+    {
+      return false;
+    }
+    Fbeyond = TopoDS::Face(aFace);
+  }
+  if (Fin.IsNull() || Fbeyond.IsNull())
+  {
+    return false;
+  }
+  for (const TopoDS_Shape& aFaceAtEnd : VFMap.FindFromKey(Vend))
+  {
+    if (aFaceAtEnd.IsSame(Fbeyond))
+    {
+      return false;
+    }
+  }
+  return ChFi3d_ConvexEdgeAt(E, Fin, Fbeyond, CP.ParameterOnArc());
+}
