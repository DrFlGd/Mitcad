+// The edge of face F at its vertex V other than E, in F's orientation;
+// null unless exactly one such edge (not degenerated) meets V.
+static TopoDS_Edge ChFi3d_OtherEdgeOfFaceAtVertex(const TopoDS_Face&   F,
+                                                  const TopoDS_Vertex& V,
+                                                  const TopoDS_Edge&   E)
+{
+  TopoDS_Edge aFound;
+  for (TopExp_Explorer ex(F.Oriented(TopAbs_FORWARD), TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+    if (Ec.IsSame(E) || BRep_Tool::Degenerated(Ec))
+    {
+      continue;
+    }
+    bool atV = false;
+    for (TopExp_Explorer exV(Ec, TopAbs_VERTEX); exV.More() && !atV; exV.Next())
+    {
+      atV = exV.Current().IsSame(V);
+    }
+    if (!atV)
+    {
+      continue;
+    }
+    if (!aFound.IsNull() && !aFound.IsSame(Ec))
+    {
+      return TopoDS_Edge();
+    }
+    aFound = Ec;
+  }
+  return aFound;
+}
