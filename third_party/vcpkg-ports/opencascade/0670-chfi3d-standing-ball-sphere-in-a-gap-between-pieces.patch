+//=======================================================================
+// function : ChFi3d_StandingBall
+// purpose  : Where the piece D of a rounding of radius R ends (its first
+//            end with isFirst) with its contact on side ons on an edge of
+//            its face, across which lies a face Fc on a cylinder of radius
+//            R whose axis runs through the ball's centre (a corner of a
+//            wall rounded with the ball's own radius), the ball stands
+//            there while its contact sweeps round Fc: its centre C stays on
+//            the axis, its other contact at the point q. The sweep is the
+//            circle of radius R about C square to the axis, from D's
+//            contact P0 into Fc up to where it reaches another edge Efar of
+//            Fc (at Pfar, wFar on Efar's curve), the angle Sweep about Axis.
+//            False where D's end is no such ball.
+//=======================================================================
+
+namespace
+{
+struct ChFi3d_StandingBallData
+{
+  int         ons = 0;
+  TopoDS_Face Fc;
+  gp_Pnt      C, q, P0, Pfar;
+  gp_Ax2      Axis; // at C, its X direction towards P0
+  double      Sweep = 0.;
+  TopoDS_Edge Efar;
+  double      wFar = 0.;
+};
+} // namespace
+
+static bool ChFi3d_StandingBall(const TopOpeBRepDS_DataStructure&   DStr,
+                                const occ::handle<ChFiDS_SurfData>& D,
+                                const bool                          isFirst,
+                                const double                        R,
+                                const double                        tol3d,
+                                const ChFiDS_Map&                   EFMap,
+                                ChFi3d_StandingBallData&            Ball)
+{
+  if (D.IsNull() || D->Index(1) <= 0 || D->Index(2) <= 0 || R <= Precision::Confusion())
+  {
+    return false;
+  }
+  const double tolBall = 10. * tol3d;
+  for (int s = 1; s <= 2; s++)
+  {
+    const ChFiDS_CommonPoint&      CP = D->Vertex(isFirst, s);
+    const ChFiDS_CommonPoint&      CQ = D->Vertex(isFirst, 3 - s);
+    const ChFiDS_FaceInterference& FQ = D->Interference(3 - s);
+    if (!CP.IsOnArc() || CQ.IsOnArc() || FQ.PCurveOnFace().IsNull() || !EFMap.Contains(CP.Arc()))
+    {
+      continue;
+    }
+    const TopoDS_Face N  = TopoDS::Face(DStr.Shape(D->Index(s)));
+    const TopoDS_Face Fc = otherFace(EFMap, TopoDS::Edge(CP.Arc()), N);
+    if (Fc.IsNull() || Fc.IsSame(N))
+    {
+      continue;
+    }
+    BRepAdaptor_Surface aSc(Fc, false);
+    if (aSc.GetType() != GeomAbs_Cylinder || std::abs(aSc.Cylinder().Radius() - R) > tol3d)
+    {
+      continue;
+    }
+    // The centre: on the axis, at R from both contacts, along the normal of
+    // the other contact's face.
+    const gp_Ax1 anAxis = aSc.Cylinder().Axis();
+    const gp_Pnt P0     = CP.Point();
+    const gp_Pnt C      = ElCLib::Value(ElCLib::Parameter(gp_Lin(anAxis), P0), gp_Lin(anAxis));
+    const gp_Pnt q      = CQ.Point();
+    if (std::abs(C.Distance(P0) - R) > tolBall || std::abs(C.Distance(q) - R) > tolBall)
+    {
+      continue;
+    }
+    {
+      const TopoDS_Face   Fq = TopoDS::Face(DStr.Shape(D->Index(3 - s)));
+      BRepAdaptor_Surface aSq(Fq, false);
+      const gp_Pnt2d      uvq = FQ.PCurveOnFace()->Value(FQ.Parameter(isFirst));
+      gp_Pnt              aP;
+      gp_Vec              aDu, aDv;
+      aSq.D1(uvq.X(), uvq.Y(), aP, aDu, aDv);
+      const gp_Vec aN = aDu.Crossed(aDv);
+      if (aN.Magnitude() <= gp::Resolution() || aP.Distance(q) > tolBall
+          || gp_Vec(q, C).Crossed(aN).Magnitude() > 1.e-3 * R * aN.Magnitude())
+      {
+        continue;
+      }
+    }
+    // The sweep: the first other edge of Fc the circle reaches inside Fc, in
+    // either direction about the axis.
+    gp_Vec X0(C, P0);
+    X0.SetLinearForm(-X0.Dot(gp_Vec(anAxis.Direction())), gp_Vec(anAxis.Direction()), X0);
+    if (X0.Magnitude() <= gp::Resolution())
+    {
+      continue;
+    }
+    TopoDS_Face FcF = Fc;
+    FcF.Orientation(TopAbs_FORWARD);
+    const occ::handle<Geom_Surface> SFc = BRep_Tool::Surface(FcF);
+    double                          umin = 0., umax = 0., vmin = 0., vmax = 0.;
+    BRepTools::UVBounds(FcF, umin, umax, vmin, vmax);
+    BRepTopAdaptor_FClass2d aClass(FcF, Precision::PConfusion());
+    const auto inside = [&](const gp_Pnt& P) {
+      GeomAPI_ProjectPointOnSurf aPr(P, SFc);
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tolBall)
+      {
+        return false;
+      }
+      double u = 0., v = 0.;
+      aPr.LowerDistanceParameters(u, v);
+      if (SFc->IsUPeriodic())
+      {
+        u = ElCLib::InPeriod(u, umin - Precision::PConfusion(), umin - Precision::PConfusion() + SFc->UPeriod());
+      }
+      return aClass.Perform(gp_Pnt2d(u, v)) == TopAbs_IN;
+    };
+    bool found = false;
+    for (const double aSense : {1., -1.})
+    {
+      const gp_Ax2 anAx(C, aSense > 0. ? anAxis.Direction() : anAxis.Direction().Reversed(), gp_Dir(X0));
+      const occ::handle<Geom_Circle> aCirc = new Geom_Circle(anAx, R);
+      for (TopExp_Explorer ex(FcF, TopAbs_EDGE); ex.More(); ex.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+        double             f = 0., l = 0.;
+        const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(E, f, l);
+        if (aC.IsNull() || BRep_Tool::Degenerated(E) || E.IsSame(CP.Arc()))
+        {
+          continue;
+        }
+        GeomAPI_ExtremaCurveCurve anExt(aCirc, aC, 0., 2. * M_PI, f, l);
+        // (Not an edge running along the circle, e.g. a circle about the
+        // same axis: no single crossing.)
+        if (anExt.Extrema().IsParallel())
+        {
+          continue;
+        }
+        for (int i = 1; i <= anExt.NbExtrema(); i++)
+        {
+          double a = 0., w = 0.;
+          anExt.Parameters(i, a, w);
+          if (anExt.Distance(i) > tolBall || a <= 1.e-6 || a >= 2. * M_PI - 1.e-6
+              || (found && a >= Ball.Sweep) || !inside(aCirc->Value(0.5 * a)))
+          {
+            continue;
+          }
+          Ball.ons   = s;
+          Ball.Fc    = Fc;
+          Ball.C     = C;
+          Ball.q     = q;
+          Ball.P0    = P0;
+          Ball.Pfar  = aCirc->Value(a);
+          Ball.Axis  = anAx;
+          Ball.Sweep = a;
+          Ball.Efar  = E;
+          Ball.wFar  = w;
+          found      = true;
+        }
+      }
+    }
+    if (found && Ball.Sweep < M_PI)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_StandingBallPiece
+// purpose  : The piece of the standing ball's sphere (ChFi3d_StandingBall
+//            of D's end) between D's end section and the section through
+//            the sweep's far end: from spine parameter W1 to W2 (D's end at
+//            W2 where isFirst, at W1 otherwise). Its side on Fc is the
+//            sweep, its other side the point q (a degenerated edge of the
+//            blend's face, as ChFi3d_ConcaveTurnWedge's).
+//=======================================================================
+
+static occ::handle<ChFiDS_SurfData> ChFi3d_StandingBallPiece(TopOpeBRepDS_DataStructure&         DStr,
+                                                              const occ::handle<ChFiDS_SurfData>& D,
+                                                              const bool                          isFirst,
+                                                              const ChFi3d_StandingBallData&      Ball,
+                                                              const double                        R,
+                                                              const double                        W1,
+                                                              const double                        W2,
+                                                              const double                        tol3d)
+{
+  const int                      ons = Ball.ons;
+  const int                      opp = 3 - ons;
+  const ChFiDS_FaceInterference& FDo = D->Interference(opp);
+  const ChFiDS_FaceInterference& FDn = D->Interference(ons);
+  if (W2 - W1 <= Precision::PConfusion() || FDo.PCurveOnSurf().IsNull() || FDn.PCurveOnSurf().IsNull()
+      || FDo.PCurveOnFace().IsNull())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  // The sweep in the order of the spine: from Pa to Pb.
+  const gp_Pnt Pa = isFirst ? Ball.Pfar : Ball.P0;
+  const gp_Pnt Pb = isFirst ? Ball.P0 : Ball.Pfar;
+  gp_Ax2       anAx = Ball.Axis;
+  if (isFirst)
+  {
+    // (From the far end back round to P0.)
+    anAx = gp_Ax2(Ball.C, Ball.Axis.Direction().Reversed(), gp_Dir(gp_Vec(Ball.C, Pa)));
+  }
+  occ::handle<Geom_Curve> Cc = new Geom_TrimmedCurve(new Geom_Circle(anAx, R), 0., Ball.Sweep);
+  // The sphere, its pole at q; longitudes increase from Pa's to Pb's, Pa's at
+  // 0.5 (clear of the seam).
+  const gp_Dir Z(gp_Vec(Ball.C, Ball.q));
+  gp_Vec       Xa(Ball.C, Pa);
+  Xa.SetLinearForm(-Xa.Dot(gp_Vec(Z)), gp_Vec(Z), Xa);
+  if (Xa.Magnitude() <= gp::Resolution())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  gp_Ax3 aFrame(Ball.C, Z, gp_Dir(Xa));
+  if (gp_Vec(Ball.C, Cc->Value(0.5 * Ball.Sweep)).Dot(gp_Vec(aFrame.YDirection())) < 0.)
+  {
+    aFrame.YReverse();
+  }
+  aFrame.Rotate(gp_Ax1(Ball.C, aFrame.Direction()), aFrame.Direct() ? -0.5 : 0.5);
+  double ua = 0., va = 0., ub = 0., vb = 0.;
+  ElSLib::SphereParameters(aFrame, R, Pa, ua, va);
+  ElSLib::SphereParameters(aFrame, R, Pb, ub, vb);
+  if (std::abs(ua - 0.5) > 1.e-6 || ub <= ua || ub >= ua + M_PI)
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  occ::handle<Geom_SphericalSurface> aSphere = new Geom_SphericalSurface(aFrame, R);
+  TopoDS_Face                        FcF     = Ball.Fc;
+  FcF.Orientation(TopAbs_FORWARD);
+  const double c1 = Cc->FirstParameter(), c2 = Cc->LastParameter();
+  // The sweep on Fc: an iso of its cylinder (its parameter the angle).
+  occ::handle<Geom2d_Curve> Pc;
+  {
+    const gp_Cylinder aCyl = BRepAdaptor_Surface(FcF, false).Cylinder();
+    double            u0 = 0., v0 = 0., u1 = 0., v1 = 0.;
+    ElSLib::Parameters(aCyl, Pa, u0, v0);
+    ElSLib::Parameters(aCyl, Cc->Value(c1 + 1.e-2 * (c2 - c1)), u1, v1);
+    const double aSense = ElCLib::InPeriod(u1 - u0, -M_PI, M_PI) > 0. ? 1. : -1.;
+    // (In the period of Fc's parameters.)
+    double umin = 0., umax = 0., vmin = 0., vmax = 0.;
+    BRepTools::UVBounds(FcF, umin, umax, vmin, vmax);
+    const double aSlack = 0.5 * (2. * M_PI - (umax - umin));
+    const double um     = ElCLib::InPeriod(u0 + aSense * 0.5 * (c2 - c1), umin - aSlack, umin - aSlack + 2. * M_PI);
+    u0                  = um - aSense * 0.5 * (c2 - c1);
+    Pc = new Geom2d_Line(gp_Pnt2d(u0, v0), gp_Dir2d(aSense, 0.));
+  }
+  // On the sphere: through its points along the sweep, its longitudes from
+  // Pa's on.
+  occ::handle<Geom2d_Curve> Ps;
+  {
+    const int                                     n = 64;
+    occ::handle<NCollection_HArray1<gp_Pnt2d>> aPnts   = new NCollection_HArray1<gp_Pnt2d>(1, n + 1);
+    occ::handle<NCollection_HArray1<double>>   aParams = new NCollection_HArray1<double>(1, n + 1);
+    double                                        uPrev = ua;
+    for (int i = 0; i <= n; i++)
+    {
+      const double t = c1 + (c2 - c1) * i / n;
+      double       u = 0., v = 0.;
+      ElSLib::SphereParameters(aFrame, R, Cc->Value(t), u, v);
+      u     = ElCLib::InPeriod(u, uPrev - M_PI, uPrev + M_PI);
+      uPrev = u;
+      aPnts->SetValue(i + 1, gp_Pnt2d(u, v));
+      aParams->SetValue(i + 1, t);
+    }
+    Geom2dAPI_Interpolate anInterp(aPnts, aParams, false, Precision::PConfusion());
+    anInterp.Perform();
+    if (!anInterp.IsDone())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    Ps = anInterp.Curve();
+    if (Ps->Value(c1).Distance(gp_Pnt2d(ua, va)) > Precision::PConfusion()
+        || Ps->Value(c2).Distance(gp_Pnt2d(ub, vb)) > Precision::PConfusion())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+  }
+  // The blend's orientation: D's where the sphere's normal agrees with D's
+  // surface's at their common section.
+  TopAbs_Orientation anOr = D->Orientation();
+  {
+    const occ::handle<Geom_Surface>& SD  = DStr.Surface(D->Surf()).Surface();
+    const gp_Pnt2d                   uvo = FDo.PCurveOnSurf()->Value(FDo.Parameter(isFirst));
+    const gp_Pnt2d                   uvn = FDn.PCurveOnSurf()->Value(FDn.Parameter(isFirst));
+    const gp_Pnt2d                   uvM((uvo.XY() + uvn.XY()) * 0.5);
+    GeomLProp_SLProps                aPropD(SD, uvM.X(), uvM.Y(), 1, Precision::Confusion());
+    if (!aPropD.IsNormalDefined())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    double us = 0., vs = 0.;
+    ElSLib::SphereParameters(aFrame, R, aPropD.Value(), us, vs);
+    GeomLProp_SLProps aPropS(aSphere, us, vs, 1, Precision::Confusion());
+    if (!aPropS.IsNormalDefined())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    if (gp_Vec(aPropD.Normal()).Dot(gp_Vec(aPropS.Normal())) < 0.)
+    {
+      anOr = TopAbs::Reverse(anOr);
+    }
+  }
+  // The side on the other face: the point q, along the pole over the
+  // sweep's longitudes.
+  const gp_Pnt2d             uvq = FDo.PCurveOnFace()->Value(FDo.Parameter(isFirst));
+  NCollection_Array1<double> aKnots(1, 2);
+  NCollection_Array1<int>    aMults(1, 2);
+  aKnots(1) = c1;
+  aKnots(2) = c2;
+  aMults(1) = aMults(2) = 2;
+  NCollection_Array1<gp_Pnt>   aPoles3d(1, 2);
+  NCollection_Array1<gp_Pnt2d> aPolesS(1, 2), aPolesF(1, 2);
+  aPoles3d(1) = aPoles3d(2) = Ball.q;
+  aPolesS(1)                = gp_Pnt2d(ua, 0.5 * M_PI);
+  aPolesS(2)                = gp_Pnt2d(ub, 0.5 * M_PI);
+  aPolesF(1) = aPolesF(2) = uvq;
+  occ::handle<Geom_BSplineCurve>   Cq  = new Geom_BSplineCurve(aPoles3d, aKnots, aMults, 1);
+  occ::handle<Geom2d_BSplineCurve> PSq = new Geom2d_BSplineCurve(aPolesS, aKnots, aMults, 1);
+  occ::handle<Geom2d_BSplineCurve> PFq = new Geom2d_BSplineCurve(aPolesF, aKnots, aMults, 1);
+
+  const TopoDS_Face        Fn   = TopoDS::Face(DStr.Shape(D->Index(ons)));
+  const TopAbs_Orientation aTra = TopAbs::Compose(FDn.Transition(), TopAbs::Compose(Fn.Orientation(), Ball.Fc.Orientation()));
+  occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+  G->ChangeSurf(DStr.AddSurface(TopOpeBRepDS_Surface(aSphere, tol3d)));
+  G->ChangeOrientation() = anOr;
+  G->ChangeIndexOfS1(opp == 1 ? D->IndexOfS1() : DStr.AddShape(Ball.Fc));
+  G->ChangeIndexOfS2(opp == 2 ? D->IndexOfS2() : DStr.AddShape(Ball.Fc));
+  {
+    ChFiDS_FaceInterference& GO = G->ChangeInterference(opp);
+    GO.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cq, tol3d)), FDo.Transition(), PFq, PSq);
+    GO.SetFirstParameter(c1);
+    GO.SetLastParameter(c2);
+  }
+  {
+    ChFiDS_FaceInterference& GI = G->ChangeInterference(ons);
+    GI.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tol3d)), aTra, Pc, Ps);
+    GI.SetFirstParameter(c1);
+    GI.SetLastParameter(c2);
+  }
+  // The ends: q on the other side; on side ons, D's point on its edge with Fc
+  // and the sweep's far end on Efar, their transitions those of the contact
+  // entering Fc and leaving it.
+  G->ChangeVertex(true, opp)  = D->Vertex(isFirst, opp);
+  G->ChangeVertex(false, opp) = D->Vertex(isFirst, opp);
+  for (int k = 0; k < 2; k++)
+  {
+    const bool          atD = (k == 0) != isFirst; // (the start shared with D's last end, or the end with D's first)
+    ChFiDS_CommonPoint& CP  = G->ChangeVertex(k == 0, ons);
+    TopoDS_Edge         anArc;
+    double              aW = 0.;
+    gp_Pnt              aP;
+    if (atD)
+    {
+      const ChFiDS_CommonPoint& CPD = D->Vertex(isFirst, ons);
+      anArc                         = TopoDS::Edge(CPD.Arc());
+      aW                            = CPD.ParameterOnArc();
+      aP                            = CPD.Point();
+    }
+    else
+    {
+      anArc = Ball.Efar;
+      aW    = Ball.wFar;
+      aP    = Ball.Pfar;
+    }
+    const TopoDS_Edge aEInF = edgeInFace(anArc, FcF);
+    if (aEInF.IsNull())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+    const TopAbs_Orientation aTr = k == 0 ? TopAbs::Reverse(TopAbs::Compose(aTra, aEInF.Orientation()))
+                                          : TopAbs::Compose(aTra, aEInF.Orientation());
+    CP.Reset();
+    CP.SetPoint(aP);
+    CP.SetArc(tol3d, anArc, aW, aTr);
+    CP.SetParameter(k == 0 ? W1 : W2);
+    G->ChangeVertex(k == 0, opp).SetParameter(k == 0 ? W1 : W2);
+  }
+  G->FirstSpineParam(W1);
+  G->LastSpineParam(W2);
+  return G;
+}
+
+//=======================================================================
+// function : ChFi3d_StandingBallSection
+// purpose  : Where the walk (its section's rule: the mid-point of the
+//            contacts in the guide's normal plane) has the ball touching P
+//            and q: the spine's parameter in [Wa, Wb] nearest to Wb
+//            (towardB) or to Wa.
+//=======================================================================
+
+static bool ChFi3d_StandingBallSection(const occ::handle<ChFiDS_Spine>& Spine,
+                                       const gp_Pnt&                    P,
+                                       const gp_Pnt&                    q,
+                                       const double                     Wa,
+                                       const double                     Wb,
+                                       const bool                       towardB,
+                                       double&                          W)
+{
+  const gp_Pnt M((P.XYZ() + q.XYZ()) * 0.5);
+  const auto   g = [&](const double t) {
+    gp_Pnt G;
+    gp_Vec T;
+    Spine->D1(t, G, T);
+    const double n = T.Magnitude();
+    return n > gp::Resolution() ? gp_Vec(G, M).Dot(T) / n : 0.;
+  };
+  const int n     = 200;
+  bool      found = false;
+  double    ga    = g(Wa);
+  for (int i = 1; i <= n; i++)
+  {
+    const double a = Wa + (Wb - Wa) * (i - 1) / n, b = Wa + (Wb - Wa) * i / n;
+    const double gb = g(b);
+    if (ga * gb <= 0.)
+    {
+      double lo = a, hi = b, glo = ga;
+      for (int it = 0; it < 60; it++)
+      {
+        const double m  = 0.5 * (lo + hi);
+        const double gm = g(m);
+        if (glo * gm <= 0.)
+        {
+          hi = m;
+        }
+        else
+        {
+          lo  = m;
+          glo = gm;
+        }
+      }
+      W     = 0.5 * (lo + hi);
+      found = true;
+      if (!towardB)
+      {
