+// The isoline of a surface of one of E's faces along which E runs (E's
+// p-curve on that face a line along its u or v): the isoline, the face, and
+// the isoline's parameter A + B t at E's parameter t; false if none.
+static bool ChFi3d_IsolineOfEdge(const TopoDS_Edge&       E,
+                                 const ChFiDS_Map&        EFMap,
+                                 occ::handle<Geom_Curve>& Iso,
+                                 TopoDS_Face&             OnFace,
+                                 double&                  A,
+                                 double&                  B)
+{
+  if (!EFMap.Contains(E) || BRep_Tool::Degenerated(E))
+  {
+    return false;
+  }
+  {
+    // (A line or a circle runs on along itself.)
+    double                  f = 0., l = 0.;
+    occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+    if (const occ::handle<Geom_TrimmedCurve> aTrim = occ::down_cast<Geom_TrimmedCurve>(C))
+    {
+      C = aTrim->BasisCurve();
+    }
+    const GeomAdaptor_Curve aType(C);
+    if (!C.IsNull() && (aType.GetType() == GeomAbs_Line || aType.GetType() == GeomAbs_Circle))
+    {
+      Iso    = C;
+      A      = 0.;
+      B      = 1.;
+      OnFace = TopoDS::Face(EFMap.FindFromKey(E).First());
+      return true;
+    }
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap.FindFromKey(E)); it.More(); it.Next())
+  {
+    const TopoDS_Face               FF = TopoDS::Face(it.Value().Oriented(TopAbs_FORWARD));
+    double                          pf = 0., pl = 0.;
+    occ::handle<Geom2d_Curve>       pc = BRep_Tool::CurveOnSurface(E, FF, pf, pl);
+    const occ::handle<Geom_Surface> SF = BRep_Tool::Surface(FF);
+    if (const occ::handle<Geom2d_TrimmedCurve> aT2 = occ::down_cast<Geom2d_TrimmedCurve>(pc))
+    {
+      pc = aT2->BasisCurve();
+    }
+    const occ::handle<Geom2d_Line> aL = occ::down_cast<Geom2d_Line>(pc);
+    if (aL.IsNull() || SF.IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt2d O      = aL->Lin2d().Location();
+    const gp_Dir2d D      = aL->Lin2d().Direction();
+    const bool     alongV = std::abs(D.X()) <= Precision::Angular();
+    const bool     alongU = std::abs(D.Y()) <= Precision::Angular();
+    if (!alongV && !alongU)
+    {
+      continue;
+    }
+    Iso    = alongV ? SF->UIso(O.X()) : SF->VIso(O.Y());
+    A      = alongV ? O.Y() : O.X();
+    B      = alongV ? D.Y() : D.X();
+    OnFace = TopoDS::Face(it.Value());
+    return true;
+  }
+  return false;
+}
