+//=======================================================================
+// function : ChFi3d_KPartCutChainToEnd
+// purpose  : As ChFi3d_KPartCutToEnd where the contact of an analytic blend
+//            on face N leaves N, near an end V of an open spine, into a face
+//            B0 that does not reach V, and its cut runs on over a chain of
+//            faces beyond (each sharing an edge with the one before, those
+//            edges prolonged past their vertices on N along their faces'
+//            isolines, ChFi3d_KPartEdgeCrossing) up to the face Bn whose
+//            surface meets the other contact's line at Q: the blend ends in
+//            the point Q there. Q lies on an edge Eq of the other contact's
+//            face Fo: inside Eq (then Eq's part from Q to V bounds Eq's face
+//            beyond, G, and Bn, which grows up to it), or on Eq's
+//            prolongation past V along an isoline of Bn (then Eq is
+//            prolonged up to Q, bounding Fo and Bn). The spine's edge at V
+//            and Bn's edges with N at V lie under the blend and bound no face
+//            any more. The case: a thread's groove ending in a flat face, the
+//            edge where that face meets the bore chamfered wider than the
+//            groove: both contacts leave their faces before the edge's ends,
+//            the groove's flanks (grown on past the flat face) cut the
+//            chamfer across its whole width at both ends. Returns true when
+//            the pieces are added.
+//=======================================================================
+
+static bool ChFi3d_KPartCutChainToEnd(
+  TopOpeBRepDS_DataStructure&                                             DStr,
+  const occ::handle<ChFiDS_Spine>&                                        Spine,
+  NCollection_Array1<NCollection_Sequence<occ::handle<ChFiDS_SurfData>>>& aLSD,
+  const NCollection_Array1<occ::handle<ChFiDS_SurfData>>&                 aFull,
+  NCollection_Array1<int>&                                                aState,
+  NCollection_Array1<bool>&                                               aIntf,
+  NCollection_Array1<bool>&                                               aIntl,
+  const ChFiDS_Map&                                                       EFMap,
+  const ChFiDS_Map&                                                       VFMap,
+  const double                                                            tol3d,
+  const bool                                                              isFirst)
+{
+  // (Chamfers: a rounding's ends are made by the walks and corners of their
+  // own.)
+  if (Spine->IsPeriodic() || occ::down_cast<ChFiDS_ChamfSpine>(Spine).IsNull())
+  {
+    return false;
+  }
+  const int           nbed = Spine->NbEdges();
+  const TopoDS_Vertex V    = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  const int           eEnd = isFirst ? 1 : nbed;
+  if (V.IsNull() || !VFMap.Contains(V) || aState(eEnd) != 2 || aFull(eEnd).IsNull() || aLSD(eEnd).IsEmpty())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData>&                 Full = aFull(eEnd);
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& LSD  = aLSD(eEnd);
+  const occ::handle<ChFiDS_SurfData>                  P    = isFirst ? LSD.First() : LSD.Last();
+  if (Full->Index(1) <= 0 || Full->Index(2) <= 0 || P->Index(1) != Full->Index(1) || P->Index(2) != Full->Index(2))
+  {
+    return false;
+  }
+  const double wA = Spine->FirstParameter(eEnd), wB = Spine->LastParameter(eEnd);
+  double       aWidth = 0.;
+  {
+    double t1 = 0., t2 = 0.;
+    const gp_Pnt M = Spine->Value(0.5 * (wA + wB));
+    if (!ChFi3d_KPartLineParam(DStr, Full, 1, M, t1) || !ChFi3d_KPartLineParam(DStr, Full, 2, M, t2))
+    {
+      return false;
+    }
+    aWidth = DStr.Curve(Full->Interference(1).LineIndex()).Curve()->Value(t1).Distance(
+      DStr.Curve(Full->Interference(2).LineIndex()).Curve()->Value(t2));
+  }
+  // (The blend may end a little past the spine's end: within its width.)
+  const double Wlo = wA - aWidth, Whi = wB + aWidth;
+  const auto   sectionOf = [&](const int s, const gp_Pnt& X, double& W) {
