+// The point X's parameters on face BF (FORWARD) of its edge: on the edge's
+// p-curve, or, for a crossing along an isoline (beyond a B-spline edge's
+// end), projected onto BF's surface near the p-curve's end at the vertex.
+static bool ChFi3d_KPartCrossingOnFace(const ChFi3d_KPartCrossing& X, const TopoDS_Face& BF, gp_Pnt2d& uv)
+{
+  double                          f = 0., l = 0.;
+  const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(X.E, BF, f, l);
+  if (pc.IsNull())
+  {
+    return false;
+  }
+  if (X.Along.IsNull())
+  {
+    uv = pc->Value(X.wE);
+    return true;
+  }
+  GeomAPI_ProjectPointOnSurf aPr(X.P, BRep_Tool::Surface(BF));
+  if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 1.e-6)
+  {
+    return false;
+  }
+  double u = 0., v = 0.;
+  aPr.LowerDistanceParameters(u, v);
+  uv.SetCoord(u, v);
+  return true;
+}
