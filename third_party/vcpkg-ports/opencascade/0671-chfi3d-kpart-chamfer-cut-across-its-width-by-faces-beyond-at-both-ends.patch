+// The prolongation of X's edge beyond its vertex X.Vn along the isoline
+// X.Along up to the vertex Vx: a curve bounding E's faces F1 and F2, in
+// E's orientation in each (as ChFi3d_ProlongEdgeBeyondVertex).
+static bool ChFi3d_ProlongEdgeAlongIso(TopOpeBRepDS_DataStructure& DStr,
+                                       const ChFi3d_KPartCrossing& X,
+                                       const TopoDS_Vertex&        Vx,
+                                       const TopoDS_Face&          F1,
+                                       const TopoDS_Face&          F2,
+                                       const double                Tol)
+{
+  const double p1 = std::min(X.aV, X.aP), p2 = std::max(X.aV, X.aP);
+  const bool   vnLow = X.aV < X.aP;
+  // (E's curve and the isoline run the same way where E's parameter grows
+  // with the isoline's.)
+  const double                  pv = BRep_Tool::Parameter(X.Vn, X.E);
+  const bool                    sameSense = (X.aP - X.aV) * (X.wE - pv) > 0.;
+  const occ::handle<Geom_Curve> C   = new Geom_TrimmedCurve(X.Along, p1, p2);
+  const int                     IVn = DStr.AddShape(X.Vn);
+  const int                     IVx = DStr.AddShape(Vx);
+  const int                     ic  = DStr.AddCurve(TopOpeBRepDS_Curve(C, Tol));
+  DStr.ChangeCurveInterferences(ic).Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, vnLow ? IVn : IVx, p1, true));
+  DStr.ChangeCurveInterferences(ic).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, vnLow ? IVx : IVn, p2, true));
+  for (const TopoDS_Face& F : {F1, F2})
+  {
+    TopAbs_Orientation anOri = TopAbs_FORWARD;
+    for (TopExp_Explorer ex(F.Oriented(TopAbs_FORWARD), TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(X.E))
+      {
+        anOri = ex.Current().Orientation();
+      }
+    }
+    if (!sameSense)
+    {
+      anOri = TopAbs::Reverse(anOri);
+    }
+    const occ::handle<Geom2d_Curve> aPC = GeomProjLib::Curve2d(C, p1, p2, BRep_Tool::Surface(TopoDS::Face(F.Oriented(TopAbs_FORWARD))));
+    if (aPC.IsNull())
+    {
+      return false;
+    }
+    const int IF = DStr.AddShape(F);
+    DStr.ChangeShapeInterferences(IF).Append(ChFi3d_FilCurveInDS(ic, IF, aPC, anOri));
+  }
+  return true;
+}
