+// The points of a contour's pcurves (theCurves, in the contour's order and
+// orientation) as a polygon in 2d.
+NCollection_Sequence<gp_Pnt2d> ContourPolygon(
+  const NCollection_Sequence<std::pair<occ::handle<Geom2d_Curve>, bool>>& theCurves)
+{
+  NCollection_Sequence<gp_Pnt2d> aPolygon;
+  const int                      aNbSteps = 16;
+  for (int anIndex = 1; anIndex <= theCurves.Length(); ++anIndex)
+  {
+    const occ::handle<Geom2d_Curve>& aCurve    = theCurves(anIndex).first;
+    const bool                       isForward = theCurves(anIndex).second;
+    const double                     aFirst    = aCurve->FirstParameter();
+    const double                     aLast     = aCurve->LastParameter();
+    for (int aStep = 0; aStep < aNbSteps; ++aStep)
+    {
+      const double aT = isForward ? aFirst + (aLast - aFirst) * aStep / aNbSteps
+                                  : aLast + (aFirst - aLast) * aStep / aNbSteps;
+      aPolygon.Append(aCurve->Value(aT));
+    }
+  }
+  return aPolygon;
+}
+
+// Twice the signed area of a polygon in 2d.
+double PolygonArea(const NCollection_Sequence<gp_Pnt2d>& thePolygon)
+{
+  double anArea = 0.;
+  for (int anIndex = 1; anIndex <= thePolygon.Length(); ++anIndex)
+  {
+    const gp_Pnt2d& aP = thePolygon(anIndex);
+    const gp_Pnt2d& aQ = thePolygon(anIndex == thePolygon.Length() ? 1 : anIndex + 1);
+    anArea += aP.X() * aQ.Y() - aQ.X() * aP.Y();
+  }
+  return anArea;
+}
+
+// Whether a point lies inside a polygon in 2d (crossings of a ray along +X).
+bool IsInsidePolygon(const NCollection_Sequence<gp_Pnt2d>& thePolygon, const gp_Pnt2d& thePoint)
+{
+  bool isInside = false;
+  for (int anIndex = 1; anIndex <= thePolygon.Length(); ++anIndex)
+  {
+    const gp_Pnt2d& aP = thePolygon(anIndex);
+    const gp_Pnt2d& aQ = thePolygon(anIndex == thePolygon.Length() ? 1 : anIndex + 1);
+    if ((aP.Y() > thePoint.Y()) != (aQ.Y() > thePoint.Y()))
+    {
+      const double anX = aP.X() + (thePoint.Y() - aP.Y()) * (aQ.X() - aP.X()) / (aQ.Y() - aP.Y());
+      if (anX > thePoint.X())
+      {
+        isInside = !isInside;
+      }
+    }
+  }
+  return isInside;
+}
