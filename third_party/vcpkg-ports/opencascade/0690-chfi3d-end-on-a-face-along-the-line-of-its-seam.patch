 //=======================================================================
+// function : ChFi3d_ArcAlongSeamLine
+// purpose  : Whether the arc A of the face at the end F, an edge F uses
+//            once, runs from the corner's vertex V along the line of a
+//            seam of F that also has V as a vertex (the arc continues the
+//            seam: a bar meeting a bore's wall along the line of the bore's
+//            seam). Its p-curve on F, on one side of the seam, in C on
+//            [f, l].
+//=======================================================================
+
+static bool ChFi3d_ArcAlongSeamLine(const TopoDS_Edge&         A,
+                                    const TopoDS_Face&         F,
+                                    const TopoDS_Vertex&       V,
+                                    const BRepAdaptor_Surface& S,
+                                    occ::handle<Geom2d_Curve>& C,
+                                    double&                    f,
+                                    double&                    l)
+{
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  if (!S.IsUPeriodic() || BRep_Tool::Degenerated(A))
+  {
+    return false;
+  }
+  TopoDS_Vertex A1, A2;
+  TopExp::Vertices(A, A1, A2);
+  if (!V.IsSame(A1) && !V.IsSame(A2))
+  {
+    return false;
+  }
+  // (The arc as F uses it, once: an arc split off a seam may keep both
+  // p-curves; the one of its use.)
+  TopoDS_Edge AF;
+  int         uses = 0;
+  for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(A))
+    {
+      AF = TopoDS::Edge(ex.Current());
+      uses++;
+    }
+  }
+  if (uses != 1)
+  {
+    return false;
+  }
+  C = BRep_Tool::CurveOnSurface(AF, FF, f, l);
+  if (C.IsNull())
+  {
+    return false;
+  }
+  const double u = C->Value(f).X();
+  for (int k = 1; k <= 4; k++)
+  {
+    if (std::abs(C->Value(f + (l - f) * k / 4.).X() - u) > Precision::PConfusion())
+    {
+      return false;
+    }
+  }
+  const double T = S.UPeriod();
+  for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (E.IsSame(A) || BRep_Tool::Degenerated(E) || !BRep_Tool::IsClosed(E, FF))
+    {
+      continue;
+    }
+    TopoDS_Vertex E1, E2;
+    TopExp::Vertices(E, E1, E2);
+    if (!V.IsSame(E1) && !V.IsSame(E2))
+    {
+      continue;
+    }
+    double                          ef = 0., el = 0.;
+    const occ::handle<Geom2d_Curve> CE = BRep_Tool::CurveOnSurface(E, FF, ef, el);
+    if (!CE.IsNull()
+        && std::abs(std::remainder(CE->Value(0.5 * (ef + el)).X() - u, T)) <= Precision::PConfusion())
+    {
+      return true;
+    }
+  }
+  return false;
+}
