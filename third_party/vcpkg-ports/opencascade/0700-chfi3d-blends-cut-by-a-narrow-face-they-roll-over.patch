+// The face that shares edge E with face F, or a null face.
+TopoDS_Face trimOtherFace(const ChFiDS_Map& EFMap, const TopoDS_Edge& E, const TopoDS_Face& F)
+{
+  TopoDS_Face Fn;
+  if (!EFMap.Contains(E))
+  {
+    return Fn;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(F))
+    {
+      Fn = TopoDS::Face(it.Value());
+    }
+  }
+  return Fn;
+}
+
+// The occurrence of edge E in face F (taken FORWARD), or a null edge.
+TopoDS_Edge trimEdgeInFace(const TopoDS_Edge& E, const TopoDS_Face& F)
+{
+  TopoDS_Face aF = F;
+  aF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(aF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(E))
+    {
+      return TopoDS::Edge(ex.Current());
+    }
+  }
+  return TopoDS_Edge();
+}
+
+bool hasEdge(const TopoDS_Shape& F, const TopoDS_Shape& E)
+{
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(E))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The SurfData at an end of a stripe.
+occ::handle<ChFiDS_SurfData> trimEndData(const occ::handle<ChFiDS_Stripe>& S, const bool isFirst)
+{
+  return isFirst ? S->SetOfSurfData()->Value(1) : S->SetOfSurfData()->Value(S->SetOfSurfData()->Length());
+}
+
+// A copy of line Ic of the data structure, as a new line.
+int copyLine(TopOpeBRepDS_DataStructure& DStr, const int Ic)
+{
+  const TopOpeBRepDS_Curve& C = DStr.Curve(Ic);
+  return DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(C.Curve()->Copy()), C.Tolerance()));
+}
+
+// The point of a contact line at parameter t with its tangent, as a common
+// point of no arc.
+ChFiDS_CommonPoint linePoint(const TopOpeBRepDS_DataStructure& DStr, const ChFiDS_FaceInterference& FI, const double t)
+{
+  gp_Pnt P;
+  gp_Vec V;
+  DStr.Curve(FI.LineIndex()).Curve()->D1(t, P, V);
+  ChFiDS_CommonPoint CP;
+  CP.SetPoint(P);
+  CP.SetVector(V);
+  CP.SetParameter(t);
+  return CP;
+}
+
+// The parameter of the projection of P on the line of FI within its range
+// (widened by Margin), and the distance.
+bool lineParam(const TopOpeBRepDS_DataStructure& DStr,
+               const ChFiDS_FaceInterference&    FI,
+               const gp_Pnt&                     P,
+               const double                      Margin,
+               double&                           t,
+               double&                           d)
+{
+  const occ::handle<Geom_Curve>& C = DStr.Curve(FI.LineIndex()).Curve();
+  if (C.IsNull())
+  {
+    return false;
+  }
+  const double a = std::min(FI.FirstParameter(), FI.LastParameter()) - Margin;
+  const double b = std::max(FI.FirstParameter(), FI.LastParameter()) + Margin;
+  GeomAPI_ProjectPointOnCurve aPr(P, C, std::max(a, C->FirstParameter()), std::min(b, C->LastParameter()));
+  if (aPr.NbPoints() == 0)
+  {
+    return false;
+  }
+  t = aPr.LowerDistanceParameter();
+  d = aPr.LowerDistance();
+  return true;
+}
+
+// The ball of radius R whose contact on the surface Sd of line FId is that
+// line's point at t: its centre Pc (on the side of the other contact, line
+// FIo on surface So), its contacts Pd and Po, and the parameter to of Po on
+// its line. False where that is no ball's section of the two lines.
+bool ballAt(const TopOpeBRepDS_DataStructure& DStr,
+            const ChFiDS_FaceInterference&    FId,
+            const occ::handle<Geom_Surface>&  Sd,
+            const ChFiDS_FaceInterference&    FIo,
+            const occ::handle<Geom_Surface>&  So,
+            const double                      R,
+            const double                      t,
+            gp_Pnt&                           Pc,
+            gp_Pnt&                           Pd,
+            gp_Pnt&                           Po,
+            double&                           to)
+{
+  if (FId.PCurveOnFace().IsNull() || Sd.IsNull() || So.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d uv = FId.PCurveOnFace()->Value(t);
+  gp_Vec         Du, Dv;
+  Sd->D1(uv.X(), uv.Y(), Pd, Du, Dv);
+  gp_Vec Nv = Du.Crossed(Dv);
+  if (Nv.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  Nv.Normalize();
+  // (The side: the one of the other contact's line nearby.)
+  double t0 = 0., d0 = 0.;
+  if (!lineParam(DStr, FIo, Pd, Precision::Infinite(), t0, d0))
+  {
+    return false;
+  }
+  const gp_Pnt PO0 = DStr.Curve(FIo.LineIndex()).Curve()->Value(t0);
+  const gp_Pnt c1 = Pd.Translated(R * Nv), c2 = Pd.Translated(-R * Nv);
+  Pc              = std::abs(c1.Distance(PO0) - R) <= std::abs(c2.Distance(PO0) - R) ? c1 : c2;
+  GeomAPI_ProjectPointOnSurf aPr(Pc, So);
+  if (aPr.NbPoints() == 0)
+  {
+    return false;
+  }
+  Po = aPr.NearestPoint();
+  double d = 0.;
+  if (std::abs(Pc.Distance(Po) - R) > 0.01 * R || !lineParam(DStr, FIo, Po, Precision::Infinite(), to, d)
+      || d > 0.01 * R)
+  {
+    return false;
+  }
+  return true;
+}
+
+// Whether point Q lies under the blend of stripe St (radius R): inside the
+// region a piece of it fills, between its face and the faces it touches:
+// its nearest point on a piece's surface lies on that piece's section arc
+// between the contacts, with Q on the side of the surface away from the
+// ball's centre, within 4 R of it.
+bool pointUnderBlend(const TopOpeBRepDS_DataStructure& DStr,
+                     const occ::handle<ChFiDS_Stripe>& St,
+                     const gp_Pnt&                     Q,
+                     const double                      R)
+{
+  for (int j = 1; j <= St->SetOfSurfData()->Length(); j++)
+  {
+    const occ::handle<ChFiDS_SurfData>& D = St->SetOfSurfData()->Value(j);
+    if (D->Index(1) <= 0 || D->Index(2) <= 0 || D->Interference(1).LineIndex() <= 0
+        || D->Interference(2).LineIndex() <= 0)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Surface>& S = DStr.Surface(D->Surf()).Surface();
+    GeomAPI_ProjectPointOnSurf       aPr(Q, S);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 4. * R)
+    {
+      continue;
+    }
+    const gp_Pnt B = aPr.NearestPoint();
+    // The section through B: from the nearest point of the first contact.
+    const occ::handle<Geom_Surface> S1 = BRep_Tool::Surface(TopoDS::Face(DStr.Shape(D->Index(1))));
+    const occ::handle<Geom_Surface> S2 = BRep_Tool::Surface(TopoDS::Face(DStr.Shape(D->Index(2))));
+    const ChFiDS_FaceInterference&  F1 = D->Interference(1);
+    double                          t1 = 0., d1 = 0.;
+    // (Within the piece, its end sections included: a point by a junction
+    // of two pieces projects onto the end of either.)
+    if (!lineParam(DStr, F1, B, 0., t1, d1))
+    {
+      continue;
+    }
+    gp_Pnt Pc, P1, P2;
+    double t2 = 0.;
+    if (!ballAt(DStr, F1, S1, D->Interference(2), S2, R, t1, Pc, P1, P2, t2))
+    {
+      continue;
+    }
+    // (B on the arc between the contacts, in its section.)
+    const gp_Vec a(Pc, P1), b(Pc, P2), m(Pc, B);
+    if (std::abs(m.Magnitude() - R) > 0.01 * R)
+    {
+      continue;
+    }
+    const gp_Vec n = a.Crossed(b);
+    if (n.Magnitude() <= gp::Resolution() || a.Crossed(m).Dot(n) < 0. || m.Crossed(b).Dot(n) < 0.)
+    {
+      continue;
+    }
+    if (gp_Vec(B, Q).Dot(gp_Vec(B, Pc)) < 0.)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Whether edges Edges of face Fo lie under the blend of stripe SA: each of
+// their points near the contact on Fo of a piece of SA on Fo and a face
+// other than C (within 4 R), inside that piece's range (or at a junction
+// of two pieces), on the side of that contact toward the other one (the
+// side the blend covers). The pieces they lie along, in Pieces.
+bool edgesUnderBlend(const TopOpeBRepDS_DataStructure&     DStr,
+                     const occ::handle<ChFiDS_Stripe>&     SA,
+                     const TopoDS_Shape&                   Fo,
+                     const TopoDS_Shape&                   C,
+                     const NCollection_List<TopoDS_Shape>& Edges,
+                     const double                          R,
+                     NCollection_Map<int>&                 Pieces)
+{
+  if (SA->SetOfSurfData().IsNull() || R <= 0. || Edges.IsEmpty())
+  {
+    return false;
+  }
+  const int nbD = SA->SetOfSurfData()->Length();
+  // (Edges away from the blend's contacts left out at once.)
+  Bnd_Box aBlendBox;
+  for (int j = 1; j <= nbD; j++)
+  {
+    const occ::handle<ChFiDS_SurfData>& D = SA->SetOfSurfData()->Value(j);
+    for (int s = 1; s <= 2; s++)
+    {
+      const ChFiDS_FaceInterference& FI = D->Interference(s);
+      if (FI.LineIndex() <= 0 || DStr.Curve(FI.LineIndex()).Curve().IsNull())
+      {
+        continue;
+      }
+      const occ::handle<Geom_Curve>& L = DStr.Curve(FI.LineIndex()).Curve();
+      for (int i = 0; i <= 16; i++)
+      {
+        aBlendBox.Add(L->Value(FI.FirstParameter() + (FI.LastParameter() - FI.FirstParameter()) * i / 16.));
+      }
+    }
+  }
+  aBlendBox.Enlarge(4. * R);
+  for (NCollection_List<TopoDS_Shape>::Iterator itE(Edges); itE.More(); itE.Next())
+  {
+    Bnd_Box anEdgeBox;
+    BRepBndLib::Add(itE.Value(), anEdgeBox);
+    if (aBlendBox.IsOut(anEdgeBox))
+    {
+      return false;
+    }
+  }
+  // (A piece and the parameter of its contact on Fo by one of the points.)
+  occ::handle<ChFiDS_SurfData> aTouchD;
+  int                          aTouchS = 0;
+  double                       aTouchT = 0.;
+  for (NCollection_List<TopoDS_Shape>::Iterator itE(Edges); itE.More(); itE.Next())
+  {
+    const TopoDS_Edge&            E   = TopoDS::Edge(itE.Value());
+    double                        f   = 0., l = 0.;
+    const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(E, f, l);
+    if (aCE.IsNull())
+    {
+      return false;
+    }
+    for (int i = 0; i <= 8; i++)
+    {
+      const gp_Pnt Q     = aCE->Value(f + (l - f) * i / 8.);
+      bool         found = false;
+      for (int j = 1; j <= nbD && !found; j++)
+      {
+        const occ::handle<ChFiDS_SurfData>& D = SA->SetOfSurfData()->Value(j);
+        for (int s = 1; s <= 2 && !found; s++)
+        {
+          if (D->Index(s) <= 0 || D->Index(3 - s) <= 0 || !DStr.Shape(D->Index(s)).IsSame(Fo)
+              || DStr.Shape(D->Index(3 - s)).IsSame(C) || D->Interference(s).LineIndex() <= 0
+              || D->Interference(3 - s).LineIndex() <= 0)
+          {
+            continue;
+          }
+          const ChFiDS_FaceInterference& FI = D->Interference(s);
+          double                         t = 0., d = 0.;
+          if (!lineParam(DStr, FI, Q, 0., t, d) || d > 4. * R)
+          {
+            continue;
+          }
+          const double a      = std::min(FI.FirstParameter(), FI.LastParameter());
+          const double b      = std::max(FI.FirstParameter(), FI.LastParameter());
+          const bool   inside = (t > a + Precision::PConfusion() && t < b - Precision::PConfusion())
+                              || (j > 1 && std::abs(t - a) <= Precision::PConfusion())
+                              || (j < nbD && std::abs(t - b) <= Precision::PConfusion());
+          if (!inside)
+          {
+            continue;
+          }
+          const ChFiDS_FaceInterference& FN = D->Interference(3 - s);
+          const gp_Pnt                   P  = DStr.Curve(FI.LineIndex()).Curve()->Value(t);
+          double                         tn = 0., dn = 0.;
+          if (!lineParam(DStr, FN, P, Precision::Infinite(), tn, dn))
+          {
+            continue;
+          }
+          const gp_Vec toN(P, DStr.Curve(FN.LineIndex()).Curve()->Value(tn));
+          found = gp_Vec(P, Q).Dot(toN) > 0.;
+          if (found)
+          {
+            Pieces.Add(j);
+            if (aTouchD.IsNull())
+            {
+              aTouchD = D;
+              aTouchS = s;
+              aTouchT = t;
+            }
+          }
+        }
+      }
+      if (!found)
+      {
+        return false;
+      }
+    }
+  }
+  // (Not where the ball touches C: C then goes on from the blend's other
+  // face, as a wall beyond a rib it is cut by, and the edges are C's own.)
+  if (!aTouchD.IsNull())
+  {
+    const occ::handle<Geom_Surface> SC = BRep_Tool::Surface(TopoDS::Face(C));
+    const occ::handle<Geom_Surface> So = BRep_Tool::Surface(TopoDS::Face(Fo));
+    const occ::handle<Geom_Surface> Sn =
+      BRep_Tool::Surface(TopoDS::Face(DStr.Shape(aTouchD->Index(3 - aTouchS))));
+    gp_Pnt Pc, Po, Pn;
+    double tn = 0.;
+    if (ballAt(DStr, aTouchD->Interference(aTouchS), So, aTouchD->Interference(3 - aTouchS), Sn, R, aTouchT, Pc, Po,
+               Pn, tn))
+    {
+      GeomAPI_ProjectPointOnSurf aPr(Pc, SC);
+      if (aPr.NbPoints() > 0 && std::abs(aPr.LowerDistance() - R) <= 0.01 * R)
+      {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// Line i of an intersection of surfaces S1 and S2, bounded, with its
+// p-curves (made by projection where the intersection gives none, as for
+// the analytic lines of two quadrics), as B-splines over its range.
+bool interLine(const GeomInt_IntSS&             Inter,
+               const int                        i,
+               const occ::handle<Geom_Surface>& S1,
+               const occ::handle<Geom_Surface>& S2,
+               occ::handle<Geom_Curve>&         L,
+               occ::handle<Geom2d_Curve>&       L1,
+               occ::handle<Geom2d_Curve>&       L2)
+{
+  L = Inter.Line(i);
+  if (L.IsNull() || Precision::IsInfinite(L->FirstParameter()) || Precision::IsInfinite(L->LastParameter()))
+  {
+    return false;
+  }
+  const double a = L->FirstParameter(), b = L->LastParameter();
+  L1             = Inter.HasLineOnS1(i) ? Inter.LineOnS1(i) : GeomProjLib::Curve2d(L, a, b, S1);
+  L2             = Inter.HasLineOnS2(i) ? Inter.LineOnS2(i) : GeomProjLib::Curve2d(L, a, b, S2);
+  if (L1.IsNull() || L2.IsNull())
+  {
+    return false;
+  }
+  // (One parametrization: the 3d line's, as B-splines.)
+  L = GeomConvert::CurveToBSplineCurve(new Geom_TrimmedCurve(L, a, b));
+  for (occ::handle<Geom2d_Curve>* P : {&L1, &L2})
+  {
+    if (std::abs((*P)->FirstParameter() - a) > Precision::PConfusion()
+        || std::abs((*P)->LastParameter() - b) > Precision::PConfusion())
+    {
+      if ((*P)->FirstParameter() > a + Precision::PConfusion() || (*P)->LastParameter() < b - Precision::PConfusion())
+      {
+        return false;
+      }
+    }
+    *P = Geom2dConvert::CurveToBSplineCurve(new Geom2d_TrimmedCurve(*P, a, b));
+  }
+  return std::abs(L->FirstParameter() - a) <= Precision::PConfusion()
+         && std::abs(L->LastParameter() - b) <= Precision::PConfusion();
+}
+
+// The cut of blend surface S by the surface of face C from P1 to P2 (the
+// points where the blend's contact leaves its face across an edge of C and
+// comes back): their intersection's arc between them, made of the lines
+// that meet end to end, with its p-curves on S and on C. Its direction is
+// from P1 to P2.
+bool cutBetween(const occ::handle<Geom_Surface>& S,
+                const TopoDS_Face&               C,
+                const gp_Pnt&                    P1,
+                const gp_Pnt&                    P2,
+                const double                     tol3d,
+                occ::handle<Geom_Curve>&         Cc,
+                occ::handle<Geom2d_Curve>&       Ps,
+                occ::handle<Geom2d_Curve>&       Pc,
+                double&                          tolreached)
+{
+  const occ::handle<Geom_Surface> SC = BRep_Tool::Surface(C);
+  if (S.IsNull() || SC.IsNull())
+  {
+    return false;
+  }
+  GeomInt_IntSS anInter;
+  anInter.Perform(S, SC, 2.e-7, true, true, true);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  const double aTolP = std::max(100. * tol3d, 1.e-4);
+  struct Arc
+  {
+    occ::handle<Geom_Curve>   C3;
+    occ::handle<Geom2d_Curve> C1, C2;
+    bool                      used;
+  };
+  NCollection_Sequence<Arc> aArcs;
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    occ::handle<Geom_Curve>   L;
+    occ::handle<Geom2d_Curve> L1, L2;
+    if (!interLine(anInter, i, S, SC, L, L1, L2))
+    {
+      continue;
+    }
+    aArcs.Append({L, L1, L2, false});
+  }
+  // The line through P1, from P1 on; then the lines joining its end, up to
+  // the one through P2.
+  const auto paramOn = [&](const occ::handle<Geom_Curve>& L, const gp_Pnt& P, double& t) {
+    GeomAPI_ProjectPointOnCurve aPr(P, L, L->FirstParameter(), L->LastParameter());
+    double                      d = RealLast();
+    if (aPr.NbPoints() > 0)
+    {
+      d = aPr.LowerDistance();
+      t = aPr.LowerDistanceParameter();
+    }
+    for (const double te : {L->FirstParameter(), L->LastParameter()})
+    {
+      if (L->Value(te).Distance(P) < d)
+      {
+        d = L->Value(te).Distance(P);
+        t = te;
+      }
+    }
+    return d <= aTolP;
+  };
+  // Pieces of the chain: line, from, to (parameters).
+  struct Piece
+  {
+    int    i;
+    double a, b;
+  };
+  for (int i0 = 1; i0 <= aArcs.Length(); i0++)
+  {
+    double t1 = 0.;
+    if (!paramOn(aArcs(i0).C3, P1, t1))
+    {
+      continue;
+    }
+    for (int dir0 = 0; dir0 < 2; dir0++)
+    {
+      NCollection_Sequence<Piece> aChain;
+      for (int k = 1; k <= aArcs.Length(); k++)
+      {
+        aArcs(k).used = false;
+      }
+      int    i   = i0;
+      double ta  = t1;
+      bool   fwd = dir0 == 0;
+      bool   ok  = false;
+      for (int n = 0; n < 2 * aArcs.Length() + 2; n++)
+      {
+        const occ::handle<Geom_Curve>& L = aArcs(i).C3;
+        aArcs(i).used                    = true;
+        double t2                        = 0.;
+        // (P2 on this line, ahead.)
+        if (paramOn(L, P2, t2) && (fwd ? t2 > ta + Precision::PConfusion() : t2 < ta - Precision::PConfusion()))
+        {
+          aChain.Append({i, ta, t2});
+          ok = true;
+          break;
+        }
+        const double tz = fwd ? L->LastParameter() : L->FirstParameter();
+        if (std::abs(tz - ta) <= Precision::PConfusion())
+        {
+          break;
+        }
+        aChain.Append({i, ta, tz});
+        const gp_Pnt Z = L->Value(tz);
+        // The next line from Z.
+        int next = 0;
+        for (int k = 1; k <= aArcs.Length() && next == 0; k++)
+        {
+          if (aArcs(k).used)
+          {
+            continue;
+          }
+          const occ::handle<Geom_Curve>& K = aArcs(k).C3;
+          if (K->Value(K->FirstParameter()).Distance(Z) <= aTolP)
+          {
+            next = k;
+            ta   = K->FirstParameter();
+            fwd  = true;
+          }
+          else if (K->Value(K->LastParameter()).Distance(Z) <= aTolP)
+          {
+            next = k;
+            ta   = K->LastParameter();
+            fwd  = false;
+          }
+        }
+        if (next == 0)
+        {
+          break;
+        }
+        i = next;
+      }
+      if (!ok)
+      {
+        continue;
+      }
+      // The chain as one curve and its p-curves.
+      GeomConvert_CompCurveToBSplineCurve   aC3;
+      Geom2dConvert_CompCurveToBSplineCurve aC1, aC2;
+      bool                                  aDone = true;
+      for (int k = 1; k <= aChain.Length() && aDone; k++)
+      {
+        const Piece& p  = aChain(k);
+        const Arc&   ar = aArcs(p.i);
+        const bool   rv = p.b < p.a;
+        const double lo = std::min(p.a, p.b), hi = std::max(p.a, p.b);
+        if (hi - lo <= Precision::PConfusion())
+        {
+          continue;
+        }
+        occ::handle<Geom_TrimmedCurve>   c3 = new Geom_TrimmedCurve(ar.C3, lo, hi);
+        occ::handle<Geom2d_TrimmedCurve> c1 = new Geom2d_TrimmedCurve(ar.C1, lo, hi);
+        occ::handle<Geom2d_TrimmedCurve> c2 = new Geom2d_TrimmedCurve(ar.C2, lo, hi);
+        if (rv)
+        {
+          c3->Reverse();
+          c1->Reverse();
+          c2->Reverse();
+        }
+        aDone = aC3.Add(c3, aTolP, true) && aC1.Add(c1, 1.e-6, true) && aC2.Add(c2, 1.e-6, true);
+      }
+      if (!aDone || aC3.BSplineCurve().IsNull() || aC1.BSplineCurve().IsNull() || aC2.BSplineCurve().IsNull())
+      {
+        continue;
+      }
+      // (The three on one parametrization: the 3d curve's pieces as their
+      // lines'; the concatenation keeps them where the pieces' ranges add up.)
+      Cc         = aC3.BSplineCurve();
+      Ps         = aC1.BSplineCurve();
+      Pc         = aC2.BSplineCurve();
+      tolreached = std::max(anInter.TolReached3d(), tol3d);
+      if (Cc->Value(Cc->FirstParameter()).Distance(P1) > aTolP
+          || Cc->Value(Cc->LastParameter()).Distance(P2) > aTolP
+          || std::abs(Ps->FirstParameter() - Cc->FirstParameter()) > Precision::PConfusion()
+          || std::abs(Ps->LastParameter() - Cc->LastParameter()) > Precision::PConfusion()
+          || std::abs(Pc->FirstParameter() - Cc->FirstParameter()) > Precision::PConfusion()
+          || std::abs(Pc->LastParameter() - Cc->LastParameter()) > Precision::PConfusion())
+      {
+        continue;
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+// A closed curve of the intersection of blend surface S with the surface of
+// face C, with its p-curves on S and on C.
+struct ClosedCut
+{
+  occ::handle<Geom_Curve>   C3;
+  occ::handle<Geom2d_Curve> PS, PC;
+  double                    Tol;
+};
+
+// The closed curves of the intersection of S with the surface of C (its
+// lines that meet end to end round a loop).
+void closedCuts(const occ::handle<Geom_Surface>& S,
+                const TopoDS_Face&               C,
+                const double                     tol3d,
+                NCollection_Sequence<ClosedCut>& Loops)
+{
+  const occ::handle<Geom_Surface> SC = BRep_Tool::Surface(C);
+  if (S.IsNull() || SC.IsNull())
+  {
+    return;
+  }
+  GeomInt_IntSS anInter;
+  anInter.Perform(S, SC, 2.e-7, true, true, true);
+  if (!anInter.IsDone())
+  {
+    return;
+  }
+  const double aTolP = std::max(100. * tol3d, 1.e-4);
+  struct Arc
+  {
+    occ::handle<Geom_Curve>   C3;
+    occ::handle<Geom2d_Curve> C1, C2;
+    bool                      used;
+  };
+  NCollection_Sequence<Arc> aArcs;
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    occ::handle<Geom_Curve>   L;
+    occ::handle<Geom2d_Curve> L1, L2;
+    if (!interLine(anInter, i, S, SC, L, L1, L2))
+    {
+      continue;
+    }
+    aArcs.Append({L, L1, L2, false});
+  }
+  for (int i0 = 1; i0 <= aArcs.Length(); i0++)
+  {
+    if (aArcs(i0).used)
+    {
+      continue;
+    }
+    // The loop from line i0's start.
+    NCollection_Sequence<int>  aIdx;
+    NCollection_Sequence<bool> aFwd;
+    const gp_Pnt               P0 = aArcs(i0).C3->Value(aArcs(i0).C3->FirstParameter());
+    int                        i  = i0;
+    bool                       fwd = true;
+    bool                       closed = false;
+    for (int n = 0; n <= aArcs.Length(); n++)
+    {
+      aIdx.Append(i);
+      aFwd.Append(fwd);
+      aArcs(i).used                  = true;
+      const occ::handle<Geom_Curve>& L = aArcs(i).C3;
+      const gp_Pnt Z = L->Value(fwd ? L->LastParameter() : L->FirstParameter());
+      if (Z.Distance(P0) <= aTolP)
+      {
+        closed = true;
+        break;
+      }
+      int next = 0;
+      for (int k = 1; k <= aArcs.Length() && next == 0; k++)
+      {
+        if (aArcs(k).used)
+        {
+          continue;
+        }
+        const occ::handle<Geom_Curve>& K = aArcs(k).C3;
+        if (K->Value(K->FirstParameter()).Distance(Z) <= aTolP)
+        {
+          next = k;
+          fwd  = true;
+        }
+        else if (K->Value(K->LastParameter()).Distance(Z) <= aTolP)
+        {
+          next = k;
+          fwd  = false;
+        }
+      }
+      if (next == 0)
+      {
+        break;
+      }
+      i = next;
+    }
+    if (!closed)
+    {
+      continue;
+    }
+    GeomConvert_CompCurveToBSplineCurve   aC3;
+    Geom2dConvert_CompCurveToBSplineCurve aC1, aC2;
+    bool                                  aDone = true;
+    for (int k = 1; k <= aIdx.Length() && aDone; k++)
+    {
+      const Arc&                       ar = aArcs(aIdx(k));
+      const double                     lo = ar.C3->FirstParameter(), hi = ar.C3->LastParameter();
+      occ::handle<Geom_TrimmedCurve>   c3 = new Geom_TrimmedCurve(ar.C3, lo, hi);
+      occ::handle<Geom2d_TrimmedCurve> c1 = new Geom2d_TrimmedCurve(ar.C1, lo, hi);
+      occ::handle<Geom2d_TrimmedCurve> c2 = new Geom2d_TrimmedCurve(ar.C2, lo, hi);
+      if (!aFwd(k))
+      {
+        c3->Reverse();
+        c1->Reverse();
+        c2->Reverse();
+      }
+      aDone = aC3.Add(c3, aTolP, true) && aC1.Add(c1, 1.e-6, true) && aC2.Add(c2, 1.e-6, true);
+    }
+    if (!aDone || aC3.BSplineCurve().IsNull() || aC1.BSplineCurve().IsNull() || aC2.BSplineCurve().IsNull())
+    {
+      continue;
+    }
+    ClosedCut aLoop;
+    aLoop.C3  = aC3.BSplineCurve();
+    aLoop.PS  = aC1.BSplineCurve();
+    aLoop.PC  = aC2.BSplineCurve();
+    aLoop.Tol = std::max(anInter.TolReached3d(), tol3d);
+    if (std::abs(aLoop.PS->FirstParameter() - aLoop.C3->FirstParameter()) > Precision::PConfusion()
+        || std::abs(aLoop.PS->LastParameter() - aLoop.C3->LastParameter()) > Precision::PConfusion()
+        || std::abs(aLoop.PC->FirstParameter() - aLoop.C3->FirstParameter()) > Precision::PConfusion()
+        || std::abs(aLoop.PC->LastParameter() - aLoop.C3->LastParameter()) > Precision::PConfusion())
+    {
+      continue;
+    }
+    Loops.Append(aLoop);
+  }
+}
+
+// The signed area enclosed by closed 2d curve C (positive counterclockwise).
+double signedArea(const occ::handle<Geom2d_Curve>& C)
+{
+  const int    nb = 400;
+  const double a = C->FirstParameter(), b = C->LastParameter();
+  double       s = 0.;
+  gp_Pnt2d     p = C->Value(a);
+  for (int i = 1; i <= nb; i++)
+  {
+    const gp_Pnt2d q = C->Value(a + (b - a) * i / nb);
+    s += p.X() * q.Y() - q.X() * p.Y();
+    p = q;
+  }
+  return 0.5 * s;
+}
