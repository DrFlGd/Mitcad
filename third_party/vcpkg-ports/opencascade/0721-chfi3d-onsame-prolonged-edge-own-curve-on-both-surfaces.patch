+//=======================================================================
+// function : ChFi3d_InFaceDomain
+// purpose  : The curve C on face F's periodic surface moved by whole
+//            periods so that its middle lies in F's parametric domain.
+//=======================================================================
+
+static occ::handle<Geom2d_Curve> ChFi3d_InFaceDomain(const occ::handle<Geom2d_Curve>& C, const TopoDS_Face& F)
+{
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+  if (C.IsNull() || S.IsNull() || (!S->IsUPeriodic() && !S->IsVPeriodic()))
+  {
+    return C;
+  }
+  double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+  BRepTools::UVBounds(F, u1, u2, v1, v2);
+  const gp_Pnt2d m  = C->Value(0.5 * (C->FirstParameter() + C->LastParameter()));
+  double         du = 0., dv = 0.;
+  if (S->IsUPeriodic() && (m.X() < u1 || m.X() > u2))
+  {
+    du = ElCLib::InPeriod(m.X(), u1, u1 + S->UPeriod()) - m.X();
+  }
+  if (S->IsVPeriodic() && (m.Y() < v1 || m.Y() > v2))
+  {
+    dv = ElCLib::InPeriod(m.Y(), v1, v1 + S->VPeriod()) - m.Y();
+  }
+  if (du == 0. && dv == 0.)
+  {
+    return C;
+  }
+  occ::handle<Geom2d_Curve> aMoved = occ::down_cast<Geom2d_Curve>(C->Copy());
+  aMoved->Translate(gp_Vec2d(du, dv));
+  return aMoved;
+}
