 //=======================================================================
+// function : ChFi3d_ArcOnSameSurface
+// purpose  : The curve on face F of an edge E of another face of the same
+//            surface (a face at a corner split into several faces of one
+//            surface, e.g. by booleans, whose pieces each keep their own
+//            surface): E's curve projected on F's surface, parametrized as
+//            E's curve, in the period of F at the vertex V (when V is of F)
+//            or of F's middle. Null where E does not lie on F's surface
+//            within its tolerance.
+//=======================================================================
+
+static occ::handle<Geom2d_Curve> ChFi3d_ArcOnSameSurface(const TopoDS_Edge&   E,
+                                                         const TopoDS_Face&   F,
+                                                         const TopoDS_Vertex& V)
+{
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+  if (C.IsNull() || BRep_Tool::Degenerated(E))
+  {
+    return nullptr;
+  }
+  const occ::handle<Geom_Surface> S   = BRep_Tool::Surface(F);
+  const double                    tol = std::max(BRep_Tool::Tolerance(E), BRep_Tool::Tolerance(F));
+  double                          tolReached = Precision::Confusion();
+  occ::handle<Geom2d_Curve>       C2d        = GeomProjLib::Curve2d(C, f, l, S, tolReached);
+  if (C2d.IsNull())
+  {
+    return nullptr;
+  }
+  // Into the face's period: at the vertex where the face has it, else at
+  // the middle of the face's bounds.
+  bool isVOfF = false;
+  for (TopExp_Explorer ex(F, TopAbs_VERTEX); ex.More() && !isVOfF && !V.IsNull(); ex.Next())
+  {
+    isVOfF = ex.Current().IsSame(V);
+  }
+  bool isVOfE = false;
+  for (TopExp_Explorer ex(E, TopAbs_VERTEX); ex.More() && !isVOfE && !V.IsNull(); ex.Next())
+  {
+    isVOfE = ex.Current().IsSame(V);
+  }
+  gp_Pnt2d aRef, aCur;
+  if (isVOfF && isVOfE)
+  {
+    aRef = BRep_Tool::Parameters(V, F);
+    aCur = C2d->Value(BRep_Tool::Parameter(V, E));
+  }
+  else
+  {
+    double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+    BRepTools::UVBounds(F, u1, u2, v1, v2);
+    aRef.SetCoord(0.5 * (u1 + u2), 0.5 * (v1 + v2));
+    aCur = C2d->Value(0.5 * (f + l));
+  }
+  gp_Vec2d aShift(0., 0.);
+  if (S->IsUPeriodic())
+  {
+    const double T = S->UPeriod();
+    aShift.SetX(T * std::round((aRef.X() - aCur.X()) / T));
+  }
+  if (S->IsVPeriodic())
+  {
+    const double T = S->VPeriod();
+    aShift.SetY(T * std::round((aRef.Y() - aCur.Y()) / T));
+  }
+  if (aShift.SquareMagnitude() > 0.)
+  {
+    C2d = occ::down_cast<Geom2d_Curve>(C2d->Translated(aShift));
+  }
+  // It must lie on the face's surface where E's curve does.
+  for (int i = 0; i <= 4; i++)
+  {
+    const double   t  = f + (l - f) * i / 4.;
+    const gp_Pnt2d uv = C2d->Value(t);
+    if (S->Value(uv.X(), uv.Y()).Distance(C->Value(t)) > 10. * tol)
+    {
+      return nullptr;
+    }
+  }
+  return C2d;
+}
