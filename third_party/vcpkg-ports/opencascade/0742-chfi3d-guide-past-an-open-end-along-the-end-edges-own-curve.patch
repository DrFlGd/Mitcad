+//=======================================================================
+// function : ChFi3d_IsoCurveOfEdge
+// purpose  : The iso-line of a B-spline surface of edge E along which E
+//            runs (its curve on that face a line along a parameter), as a
+//            3d curve oriented with direction T at the spine's end P on E,
+//            and P's parameter on it (W): the curve E is a piece of where
+//            E's own curve stops at the end (a thread's root on its
+//            flank's iso-line, cut at a face at the end). False where E has
+//            no such curve on a surface.
+//=======================================================================
+
+static bool ChFi3d_IsoCurveOfEdge(const TopoDS_Edge&       E,
+                                  const gp_Pnt&            P,
+                                  const gp_Vec&            T,
+                                  const double             Tol,
+                                  occ::handle<Geom_Curve>& C,
+                                  double&                  W)
+{
+  for (int i = 1;; i++)
+  {
+    occ::handle<Geom2d_Curve> aC2d;
+    occ::handle<Geom_Surface> aS;
+    TopLoc_Location           aL;
+    double                    f = 0., l = 0.;
+    BRep_Tool::CurveOnSurface(E, aC2d, aS, aL, f, l, i);
+    if (aC2d.IsNull() || aS.IsNull())
+    {
+      return false;
+    }
+    occ::handle<Geom2d_Curve> aBasis = aC2d;
+    while (const occ::handle<Geom2d_TrimmedCurve> aTr = occ::down_cast<Geom2d_TrimmedCurve>(aBasis))
+    {
+      aBasis = aTr->BasisCurve();
+    }
+    const occ::handle<Geom2d_Line>        aLin = occ::down_cast<Geom2d_Line>(aBasis);
+    const occ::handle<Geom_BSplineSurface> aBS = occ::down_cast<Geom_BSplineSurface>(aS);
+    if (aLin.IsNull() || aBS.IsNull())
+    {
+      continue;
+    }
+    const gp_Dir2d aD   = aLin->Direction();
+    const bool     isU  = std::abs(aD.X()) <= 1.e-12; // u constant: a U-iso, along v
+    const bool     isV  = std::abs(aD.Y()) <= 1.e-12; // v constant: a V-iso, along u
+    if (!isU && !isV)
+    {
+      continue;
+    }
+    const gp_Pnt2d aP0 = aLin->Location();
+    occ::handle<Geom_Curve> anIso = isU ? aBS->UIso(aP0.X()) : aBS->VIso(aP0.Y());
+    if (anIso.IsNull())
+    {
+      continue;
+    }
+    if (!aL.IsIdentity())
+    {
+      anIso = occ::down_cast<Geom_Curve>(anIso->Transformed(aL.Transformation()));
+    }
+    GeomAPI_ProjectPointOnCurve aProj(P, anIso);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      continue;
+    }
+    double aW = aProj.LowerDistanceParameter();
+    gp_Pnt aPt;
+    gp_Vec aTg;
+    anIso->D1(aW, aPt, aTg);
+    if (aTg.Magnitude() <= gp::Resolution() || T.Magnitude() <= gp::Resolution())
+    {
+      continue;
+    }
+    const double aCos = aTg.Normalized().Dot(T.Normalized());
+    if (std::abs(aCos) < 1. - 1.e-6)
+    {
+      continue;
+    }
+    if (aCos < 0.)
+    {
+      aW    = anIso->ReversedParameter(aW);
+      anIso = anIso->Reversed();
+    }
+    C = anIso;
+    W = aW;
+    return true;
+  }
+}
