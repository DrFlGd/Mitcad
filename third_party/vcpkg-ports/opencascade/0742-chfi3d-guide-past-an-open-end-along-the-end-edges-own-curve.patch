 //=======================================================================
+// function : ChFi3d_OwnCurveExtension
+// purpose  : The guide BS (the spine's edges from Wref at its start, or up
+//            to Wref at its end) extended past that open end of the spine
+//            along the end edge's own curve Cv (oriented as the spine
+//            runs, the edge ending at We on it), where that is a B-spline
+//            going on past the edge (a thread's root cut by a face at the
+//            end, the edge a piece of its whole run), by up to Need of it
+//            (Length): the walk past the spine's end follows the curve the
+//            edge is a piece of, not a smooth turn into its tangent. The
+//            extension is parametrized with the guide's speed at its end,
+//            so that the guide's own parameters stay as they are. Null
+//            where the curve does not go on or the pieces do not join.
+//=======================================================================
+
+static occ::handle<Geom_BSplineCurve> ChFi3d_OwnCurveExtension(const occ::handle<Geom_Curve>&        Cv,
+                                                               const double                          We,
+                                                               const bool                            AtStart,
+                                                               const double                          Need,
+                                                               const occ::handle<Geom_BSplineCurve>& BS,
+                                                               const double                          Wref,
+                                                               const double                          Tol,
+                                                               double&                               Length)
+{
+  Length = 0.;
+  const occ::handle<Geom_BSplineCurve> aBC = occ::down_cast<Geom_BSplineCurve>(Cv);
+  if (aBC.IsNull() || aBC->IsPeriodic() || BS.IsNull() || BS->IsRational() || BS->IsPeriodic()
+      || Need <= Tol)
+  {
+    return nullptr;
+  }
+  const double aFrom = AtStart ? aBC->FirstParameter() : We;
+  const double aTo   = AtStart ? We : aBC->LastParameter();
+  if (aTo - aFrom <= Precision::PConfusion())
+  {
+    return nullptr;
+  }
+  GeomAdaptor_Curve aGC(aBC);
+  Length = std::min(Need, GCPnts_AbscissaPoint::Length(aGC, aFrom, aTo));
+  if (Length <= 10. * Tol)
+  {
+    return nullptr;
+  }
+  GCPnts_AbscissaPoint aGCP(aGC, AtStart ? -Length : Length, We);
+  if (!aGCP.IsDone())
+  {
+    return nullptr;
+  }
+  const double aW = std::min(std::max(aGCP.Parameter(), aBC->FirstParameter()), aBC->LastParameter());
+  occ::handle<Geom_BSplineCurve> anExt =
+    GeomConvert::CurveToBSplineCurve(new Geom_TrimmedCurve(aBC, AtStart ? aW : We, AtStart ? We : aW));
+  if (anExt.IsNull() || anExt->IsRational())
+  {
+    return nullptr;
+  }
+  // The speeds at the junction made equal.
+  gp_Pnt aP0, aPe;
+  gp_Vec aV0, aVe;
+  BS->D1(Wref, aP0, aV0);
+  aBC->D1(We, aPe, aVe);
+  if (aV0.Magnitude() <= gp::Resolution() || aVe.Magnitude() <= gp::Resolution()
+      || aP0.Distance(aPe) > 10. * Tol || aV0.Normalized().Dot(aVe.Normalized()) < 1. - 1.e-6)
+  {
+    return nullptr;
+  }
+  const double               aSpan = std::abs(We - aW) * aVe.Magnitude() / aV0.Magnitude();
+  NCollection_Array1<double> aKnots(anExt->Knots());
+  BSplCLib::Reparametrize(AtStart ? Wref - aSpan : Wref, AtStart ? Wref : Wref + aSpan, aKnots);
+  anExt->SetKnots(aKnots);
+  GeomConvert_CompCurveToBSplineCurve aConcat(AtStart ? anExt : BS, Convert_QuasiAngular);
+  if (!aConcat.Add(AtStart ? BS : anExt, 10. * Tol, true))
+  {
+    return nullptr;
+  }
+  occ::handle<Geom_BSplineCurve> aRes = aConcat.BSplineCurve();
+  // The guide's own part kept where it was.
+  for (int i = 0; i <= 4; i++)
+  {
+    const double t = BS->FirstParameter() + (BS->LastParameter() - BS->FirstParameter()) * i / 4.;
+    if (t < aRes->FirstParameter() - Precision::PConfusion() || t > aRes->LastParameter() + Precision::PConfusion()
+        || aRes->Value(t).Distance(BS->Value(t)) > 10. * Tol)
+    {
+      return nullptr;
+    }
+  }
+  return aRes;
+}
