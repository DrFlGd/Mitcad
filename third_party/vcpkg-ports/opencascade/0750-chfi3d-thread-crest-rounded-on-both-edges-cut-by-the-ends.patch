+//=======================================================================
+// function : KinkIntoEndFace
+// purpose  : A contact that left face F across the arc of CP onto face
+//            Fnext, which SearchFace takes for F continued (their normals
+//            within its tangency check's tenth of a radian): Fnext holds
+//            the vertex Vend at that end of the spine, and their normals
+//            along the arc are nowhere within the angular tolerance Ang (a
+//            kink of a degree, a thread's flank running into the chamfer
+//            cone at its end). Fnext is then the face at the end, which cuts
+//            the blend, not a face the ball rolls on.
+//=======================================================================
+
+static bool KinkIntoEndFace(const ChFiDS_CommonPoint& CP,
+                            const TopoDS_Face&        F,
+                            const TopoDS_Face&        Fnext,
+                            const TopoDS_Vertex&      Vend,
+                            const ChFiDS_Map&         VFMap,
+                            const double              Ang)
+{
+  if (!CP.IsOnArc() || CP.IsVertex() || F.IsNull() || Fnext.IsNull() || Fnext.IsSame(F) || Vend.IsNull()
+      || !VFMap.Contains(Vend))
+  {
+    return false;
+  }
+  bool atEnd = false;
+  for (const TopoDS_Shape& aFace : VFMap.FindFromKey(Vend))
+  {
+    atEnd = atEnd || aFace.IsSame(Fnext);
+  }
+  if (!atEnd)
+  {
+    return false;
+  }
+  const TopoDS_Edge&        E      = CP.Arc();
+  double                    aFirst = 0., aLast = 0.;
+  occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(E, F, aFirst, aLast);
+  occ::handle<Geom2d_Curve> aC2 = BRep_Tool::CurveOnSurface(E, Fnext, aFirst, aLast);
+  if (aC1.IsNull() || aC2.IsNull())
+  {
+    return false;
+  }
+  BRepAdaptor_Surface aS1(F, false), aS2(Fnext, false);
+  for (int i = 0; i < 5; i++)
+  {
+    const double   aT  = aFirst + (aLast - aFirst) * (i + 0.5) / 5.;
+    const gp_Pnt2d aP1 = aC1->Value(aT), aP2 = aC2->Value(aT);
+    gp_Pnt         aP;
+    gp_Vec         aDU, aDV;
+    aS1.D1(aP1.X(), aP1.Y(), aP, aDU, aDV);
+    gp_Vec aN1 = aDU.Crossed(aDV);
+    aS2.D1(aP2.X(), aP2.Y(), aP, aDU, aDV);
+    gp_Vec aN2 = aDU.Crossed(aDV);
+    if (aN1.SquareMagnitude() < 1.e-24 || aN2.SquareMagnitude() < 1.e-24)
+    {
+      return false;
+    }
+    if (F.Orientation() == TopAbs_REVERSED)
+    {
+      aN1.Reverse();
+    }
+    if (Fnext.Orientation() == TopAbs_REVERSED)
+    {
+      aN2.Reverse();
+    }
+    if (aN1.Angle(aN2) <= Ang)
+    {
+      return false;
+    }
+  }
+  return true;
+}
