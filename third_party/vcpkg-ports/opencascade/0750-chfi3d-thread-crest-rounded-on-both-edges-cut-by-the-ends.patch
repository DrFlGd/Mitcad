+// The screw motion of parameter s about Axis: rotation by s * Ang, then
+// translation by s * D along Axis.
+gp_Trsf ChFi3d_ScrewMotion(const gp_Ax1& theAxis, const double theAng, const double theD, const double theS)
+{
+  gp_Trsf aRot, aMove;
+  aRot.SetRotation(theAxis, theS * theAng);
+  aMove.SetTranslation(gp_Vec(theAxis.Direction()) * (theS * theD));
+  return aMove * aRot;
+}
+
+// The screw motion (about Axis by Ang, along it by D) that moves points A
+// onto points B (three points not on a line); false where that motion is
+// no rotation (a translation).
+bool ChFi3d_ScrewOf(const gp_Pnt A[3], const gp_Pnt B[3], gp_Ax1& theAxis, double& theAng, double& theD)
+{
+  const auto frame = [](const gp_Pnt P[3], gp_Ax3& theF) {
+    const gp_Vec e1(P[0], P[1]), e2(P[0], P[2]);
+    const gp_Vec n = e1.Crossed(e2);
+    if (e1.Magnitude() <= Precision::Confusion() || n.Magnitude() <= 1.e-6 * e1.Magnitude() * e2.Magnitude())
+    {
+      return false;
+    }
+    theF = gp_Ax3(P[0], gp_Dir(n), gp_Dir(e1));
+    return true;
+  };
+  gp_Ax3 aFA, aFB;
+  if (!frame(A, aFA) || !frame(B, aFB))
+  {
+    return false;
+  }
+  gp_Trsf aM;
+  aM.SetDisplacement(aFA, aFB);
+  gp_XYZ anAxis;
+  if (!aM.GetRotation(anAxis, theAng) || std::abs(theAng) < 1.e-6 || anAxis.Modulus() < gp::Resolution())
+  {
+    return false;
+  }
+  // M as a screw about an axis along anAxis: its point C is fixed by the
+  // rotation followed by the translation across the axis.
+  const gp_Dir aDir(anAxis);
+  const gp_XYZ aT  = aM.TranslationPart();
+  theD             = aT.Dot(aDir.XYZ());
+  const gp_XYZ aTp = aT - aDir.XYZ() * theD;
+  const gp_XYZ aC  = 0.5 * (aTp + aDir.XYZ().Crossed(aTp) / std::tan(0.5 * theAng));
+  theAxis          = gp_Ax1(gp_Pnt(aC), aDir);
+  return true;
+}
