+// ChFi3d_ScrewContinued along v.
+occ::handle<Geom_BSplineSurface> ChFi3d_ScrewContinuedInV(const occ::handle<Geom_BSplineSurface>& theS,
+                                                          const double                            theTol)
+{
+  if (theS->IsVPeriodic() || theS->IsURational() || theS->IsVRational())
+  {
+    return nullptr;
+  }
+  double u0 = 0., u1 = 0., v0 = 0., v1 = 0.;
+  theS->Bounds(u0, u1, v0, v1);
+  const double aRange = v1 - v0, du = u1 - u0;
+  if (aRange <= Precision::PConfusion() || du <= Precision::PConfusion())
+  {
+    return nullptr;
+  }
+  // The motion M from three points of S to their images dv further.
+  const double dv    = aRange / 8.;
+  const double va    = v0 + 0.25 * aRange;
+  const gp_Pnt A[3]  = {theS->Value(u0 + 0.2 * du, va),
+                        theS->Value(u0 + 0.8 * du, va),
+                        theS->Value(u0 + 0.2 * du, va + 0.5 * dv)};
+  const gp_Pnt B[3]  = {theS->Value(u0 + 0.2 * du, va + dv),
+                        theS->Value(u0 + 0.8 * du, va + dv),
+                        theS->Value(u0 + 0.2 * du, va + 1.5 * dv)};
+  gp_Ax1 aScrew;
+  double anAng = 0., aD = 0.;
+  if (!ChFi3d_ScrewOf(A, B, aScrew, anAng, aD))
+  {
+    return nullptr;
+  }
+  // S is swept by it: checked at dv and at 4 dv over S.
+  for (int i = 0; i <= 4; i++)
+  {
+    const double u = u0 + du * i / 4.;
+    for (int j = 0; j <= 8; j++)
+    {
+      const double v = v0 + 0.5 * aRange * j / 8.;
+      const gp_Pnt P = theS->Value(u, v);
+      if (P.Transformed(ChFi3d_ScrewMotion(aScrew, anAng, aD, 1.)).Distance(theS->Value(u, v + dv)) > theTol
+          || P.Transformed(ChFi3d_ScrewMotion(aScrew, anAng, aD, 4.)).Distance(theS->Value(u, v + 4. * dv))
+               > theTol)
+      {
+        return nullptr;
+      }
+    }
+  }
+  // Copies of S's ends, a turn long at most, moved past its ends.
+  const double                     aTurn = dv * 2. * M_PI / std::abs(anAng);
+  const double                     E     = std::min(aRange, aTurn);
+  occ::handle<Geom_BSplineSurface> aL    = new Geom_BSplineSurface(*theS);
+  occ::handle<Geom_BSplineSurface> aU    = new Geom_BSplineSurface(*theS);
+  aL->Segment(u0, u1, v0, v0 + E);
+  aU->Segment(u0, u1, v1 - E, v1);
+  aL->Transform(ChFi3d_ScrewMotion(aScrew, anAng, aD, -E / dv));
+  aU->Transform(ChFi3d_ScrewMotion(aScrew, anAng, aD, E / dv));
+  const int nU = theS->NbUPoles(), p = theS->VDegree();
+  if (aL->NbUPoles() != nU || aU->NbUPoles() != nU || aL->VDegree() != p || aU->VDegree() != p
+      || aL->NbUKnots() != theS->NbUKnots() || aU->NbUKnots() != theS->NbUKnots())
+  {
+    return nullptr;
+  }
+  const NCollection_Array2<gp_Pnt>& PL = aL->Poles();
+  const NCollection_Array2<gp_Pnt>& PO = theS->Poles();
+  const NCollection_Array2<gp_Pnt>& PU = aU->Poles();
+  const int NL = aL->NbVPoles(), NO = theS->NbVPoles(), NU = aU->NbVPoles();
+  // (Arrays from 1, as Geom_BSplineSurface keeps them.)
+  if (PL.LowerRow() != 1 || PL.LowerCol() != 1 || PO.LowerRow() != 1 || PO.LowerCol() != 1 || PU.LowerRow() != 1
+      || PU.LowerCol() != 1)
+  {
+    return nullptr;
+  }
+  for (int i = 1; i <= nU; i++)
+  {
+    if (PL(i, NL).Distance(PO(i, 1)) > theTol || PU(i, 1).Distance(PO(i, NO)) > theTol)
+    {
+      return nullptr;
+    }
+  }
+  const NCollection_Array1<double>& kL = aL->VKnots();
+  const NCollection_Array1<double>& kO = theS->VKnots();
+  const NCollection_Array1<double>& kU = aU->VKnots();
+  const NCollection_Array1<int>&    mL = aL->VMultiplicities();
+  const NCollection_Array1<int>&    mO = theS->VMultiplicities();
+  const NCollection_Array1<int>&    mU = aU->VMultiplicities();
+  if (kL.Lower() != 1 || kO.Lower() != 1 || kU.Lower() != 1)
+  {
+    return nullptr;
+  }
+  if (mL(1) != p + 1 || mL(mL.Upper()) != p + 1 || mO(1) != p + 1 || mO(mO.Upper()) != p + 1 || mU(1) != p + 1
+      || mU(mU.Upper()) != p + 1)
+  {
+    return nullptr;
+  }
+  // The knots: L's moved below v0, S's, U's moved above v1; S's ends of
+  // multiplicity p, so that S's spans are its own.
+  const int                  nK = kL.Length() + kO.Length() + kU.Length() - 2;
+  NCollection_Array1<double> K(1, nK);
+  NCollection_Array1<int>    M(1, nK);
+  int                        k = 1;
+  for (int i = 1; i < kL.Length(); i++, k++)
+  {
+    K(k) = kL(i) - E;
+    M(k) = mL(i);
+  }
+  K(k)   = kO(1);
+  M(k++) = p;
+  for (int i = 2; i < kO.Length(); i++, k++)
+  {
+    K(k) = kO(i);
+    M(k) = mO(i);
+  }
+  K(k)   = kO(kO.Upper());
+  M(k++) = p;
+  for (int i = 2; i <= kU.Length(); i++, k++)
+  {
+    K(k) = kU(i) + E;
+    M(k) = mU(i);
+  }
+  for (int i = 2; i <= nK; i++)
+  {
+    if (K(i) <= K(i - 1))
+    {
+      return nullptr;
+    }
+  }
+  NCollection_Array2<gp_Pnt> P(1, nU, 1, NL + NO + NU - 2);
+  for (int i = 1; i <= nU; i++)
+  {
+    int c = 1;
+    for (int j = 1; j < NL; j++)
+    {
+      P(i, c++) = PL(i, j);
+    }
+    for (int j = 1; j <= NO; j++)
+    {
+      P(i, c++) = PO(i, j);
+    }
+    for (int j = 2; j <= NU; j++)
+    {
+      P(i, c++) = PU(i, j);
+    }
+  }
+  return new Geom_BSplineSurface(P,
+                                 theS->UKnots(),
+                                 K,
+                                 theS->UMultiplicities(),
+                                 M,
+                                 theS->UDegree(),
+                                 p,
+                                 theS->IsUPeriodic(),
+                                 false);
+}
+// B-spline curve C (a guide along a helix) continued past its start
+// (AtStart) or its end by the screw motion that maps it onto itself, over
+// length L at most (and its own length, a turn): C's poles and knots over
+// its range, a moved copy of its end beyond, joined with a knot of
+// multiplicity the degree. Null when C is no such curve (within Tol).
+occ::handle<Geom_BSplineCurve> ChFi3d_ScrewContinuedCurve(const occ::handle<Geom_BSplineCurve>& C,
+                                                          const bool                            AtStart,
+                                                          const double                          L,
+                                                          const double                          Tol)
+{
+  if (C.IsNull() || C->IsPeriodic() || C->IsRational())
+  {
+    return nullptr;
+  }
+  const double t0 = C->FirstParameter(), t1 = C->LastParameter(), R = t1 - t0;
+  if (R <= Precision::PConfusion())
+  {
+    return nullptr;
+  }
+  // (The motion from the curve's middle, checked over its middle half: a
+  // curve continued at one end already is continued at the other.)
+  const double dt   = R / 8., a = t0 + 0.5 * R - dt;
+  const gp_Pnt A[3] = {C->Value(a), C->Value(a + dt / 3.), C->Value(a + 2. * dt / 3.)};
+  const gp_Pnt B[3] = {C->Value(a + dt), C->Value(a + dt + dt / 3.), C->Value(a + dt + 2. * dt / 3.)};
+  gp_Ax1       aScrew;
+  double       anAng = 0., aD = 0.;
+  if (!ChFi3d_ScrewOf(A, B, aScrew, anAng, aD))
+  {
+    return nullptr;
+  }
+  for (int j = 0; j <= 16; j++)
+  {
+    const double t = t0 + 0.125 * R + 0.375 * R * j / 16.;
+    const gp_Pnt P = C->Value(t);
+    if (P.Transformed(ChFi3d_ScrewMotion(aScrew, anAng, aD, 1.)).Distance(C->Value(t + dt)) > Tol
+        || P.Transformed(ChFi3d_ScrewMotion(aScrew, anAng, aD, 4.)).Distance(C->Value(t + 4. * dt)) > Tol)
+    {
+      return nullptr;
+    }
+  }
+  const double E = std::min({R, dt * 2. * M_PI / std::abs(anAng), L});
+  if (E <= Precision::PConfusion())
+  {
+    return nullptr;
+  }
+  occ::handle<Geom_BSplineCurve> aP = new Geom_BSplineCurve(*C);
+  aP->Segment(AtStart ? t0 : t1 - E, AtStart ? t0 + E : t1);
+  aP->Transform(ChFi3d_ScrewMotion(aScrew, anAng, aD, AtStart ? -E / dt : E / dt));
+  const int                         p   = C->Degree();
+  const NCollection_Array1<gp_Pnt>& PC  = C->Poles();
+  const NCollection_Array1<gp_Pnt>& PP  = aP->Poles();
+  const NCollection_Array1<double>& KC  = C->Knots();
+  const NCollection_Array1<double>& KP  = aP->Knots();
+  const NCollection_Array1<int>&    MC  = C->Multiplicities();
+  const NCollection_Array1<int>&    MP  = aP->Multiplicities();
+  const int                         nPC = PC.Length(), nPP = PP.Length();
+  if (aP->Degree() != p || PC.Lower() != 1 || PP.Lower() != 1 || KC.Lower() != 1 || KP.Lower() != 1
+      || MC(1) != p + 1 || MC(MC.Upper()) != p + 1 || MP(1) != p + 1 || MP(MP.Upper()) != p + 1
+      || (AtStart ? PP(nPP).Distance(PC(1)) : PP(1).Distance(PC(nPC))) > Tol)
+  {
+    return nullptr;
+  }
+  const int                  nK = KC.Length() + KP.Length() - 1;
+  NCollection_Array1<double> K(1, nK);
+  NCollection_Array1<int>    M(1, nK);
+  NCollection_Array1<gp_Pnt> P(1, nPC + nPP - 1);
+  int                        k = 1, c = 1;
+  if (AtStart)
+  {
+    for (int i = 1; i < KP.Length(); i++, k++)
+    {
+      K(k) = KP(i) - E;
+      M(k) = MP(i);
+    }
+    K(k)   = KC(1);
+    M(k++) = p;
+    for (int i = 2; i <= KC.Length(); i++, k++)
+    {
+      K(k) = KC(i);
+      M(k) = MC(i);
+    }
+    for (int i = 1; i < nPP; i++)
+    {
+      P(c++) = PP(i);
+    }
+    for (int i = 1; i <= nPC; i++)
+    {
+      P(c++) = PC(i);
+    }
+  }
+  else
+  {
+    for (int i = 1; i < KC.Length(); i++, k++)
+    {
+      K(k) = KC(i);
+      M(k) = MC(i);
+    }
+    K(k)   = KC(KC.Upper());
+    M(k++) = p;
+    for (int i = 2; i <= KP.Length(); i++, k++)
+    {
+      K(k) = KP(i) + E;
+      M(k) = MP(i);
+    }
+    for (int i = 1; i <= nPC; i++)
+    {
+      P(c++) = PC(i);
+    }
+    for (int i = 2; i <= nPP; i++)
+    {
+      P(c++) = PP(i);
+    }
+  }
+  for (int i = 2; i <= nK; i++)
+  {
+    if (K(i) <= K(i - 1))
+    {
+      return nullptr;
+    }
+  }
+  return new Geom_BSplineCurve(P, K, M, p);
+}
+} // namespace
+
+//=================================================================================================
+
+occ::handle<Geom_Surface> ChFi3d_ScrewContinued(const occ::handle<Geom_Surface>& S, const double Tol)
+{
+  const occ::handle<Geom_BSplineSurface> aBS = occ::down_cast<Geom_BSplineSurface>(S);
+  if (aBS.IsNull())
+  {
+    return nullptr;
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<Geom_BSplineSurface> aRes = ChFi3d_ScrewContinuedInV(aBS, Tol);
+    if (aRes.IsNull())
+    {
+      occ::handle<Geom_BSplineSurface> aSwapped = new Geom_BSplineSurface(*aBS);
+      aSwapped->ExchangeUV();
+      aRes = ChFi3d_ScrewContinuedInV(aSwapped, Tol);
+      if (!aRes.IsNull())
+      {
+        aRes->ExchangeUV();
+      }
+    }
+    return aRes;
+  }
+  catch (Standard_Failure const&)
+  {
+    return nullptr;
+  }
+}
+
+//=================================================================================================
+
+void ChFi3d_LoadScrewContinued(BRepAdaptor_Surface& HS, const double Tol)
+{
+  if (HS.GetType() != GeomAbs_BSplineSurface)
+  {
+    return;
+  }
+  const occ::handle<Geom_Surface> S = HS.GeomSurfaceOriginal();
+  // (The last surfaces seen in this thread and their continuations.)
+  static thread_local occ::handle<Geom_Surface> aSeen[8], aCont[8];
+  static thread_local int                       aNext = 0;
+  occ::handle<Geom_Surface>                     aExt;
+  bool                                          aFound = false;
+  for (int i = 0; i < 8 && !aFound; i++)
+  {
+    if (aSeen[i] == S)
+    {
+      aFound = true;
+      aExt   = aCont[i];
+    }
+  }
+  if (!aFound)
+  {
+    aExt         = ChFi3d_ScrewContinued(S, Tol);
+    aSeen[aNext] = S;
+    aCont[aNext] = aExt;
+    aNext        = (aNext + 1) % 8;
+  }
+  if (aExt.IsNull())
+  {
+    return;
+  }
+  double su0 = 0., su1 = 0., sv0 = 0., sv1 = 0., eu0 = 0., eu1 = 0., ev0 = 0., ev1 = 0.;
+  S->Bounds(su0, su1, sv0, sv1);
+  aExt->Bounds(eu0, eu1, ev0, ev1);
+  double u0 = HS.FirstUParameter(), u1 = HS.LastUParameter(), v0 = HS.FirstVParameter(),
+         v1 = HS.LastVParameter();
+  // (Bounds of the whole surface become the continuation's.)
+  const double eps = Precision::PConfusion();
+  if (std::abs(u0 - su0) < eps && std::abs(u1 - su1) < eps)
+  {
+    u0 = eu0;
+    u1 = eu1;
+  }
+  if (std::abs(v0 - sv0) < eps && std::abs(v1 - sv1) < eps)
+  {
+    v0 = ev0;
+    v1 = ev1;
+  }
+  HS.Load(aExt, u0, u1, v0, v1, HS.Trsf());
+}
