+//=======================================================================
+// function : DropOverlapsRunOutByOther
+// purpose  : See the header. The pairs of myOverlapStripes; the faces of
+//            the single piece must be the ones the pair's edges do not
+//            share (the faces beyond the narrow face between the edges).
+//=======================================================================
+
+bool ChFi3d_Builder::DropOverlapsRunOutByOther()
+{
+  const TopOpeBRepDS_DataStructure& DStr = myDS->DS();
+  bool                              any  = false;
+  // (S a single piece on two faces other than the common face of its edge
+  // and the other stripe's, both its ends on edges.)
+  const auto runsOut = [&](const occ::handle<ChFiDS_Stripe>& S, const TopoDS_Shape& Common) {
+    if (S->SetOfSurfData().IsNull() || S->SetOfSurfData()->Length() != 1 || S->Spine()->IsPeriodic())
+    {
+      return false;
+    }
+    const occ::handle<ChFiDS_SurfData>& Fd = S->SetOfSurfData()->Value(1);
+    if (Fd->Index(1) <= 0 || Fd->Index(2) <= 0 || Fd->IsOnCurve1() || Fd->IsOnCurve2()
+        || DStr.Shape(Fd->Index(1)).IsSame(Common) || DStr.Shape(Fd->Index(2)).IsSame(Common))
+    {
+      return false;
+    }
+    for (const bool isFirst : {true, false})
+    {
+      if (!Fd->Vertex(isFirst, 1).IsOnArc() || !Fd->Vertex(isFirst, 2).IsOnArc())
+      {
+        return false;
+      }
+    }
+    return true;
+  };
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myOverlapStripes);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myOverlapFaces);
+  while (itS.More())
+  {
+    const occ::handle<ChFiDS_Stripe> A  = itS.Value();
+    const TopoDS_Shape               FA = itF.Value();
+    itS.Next();
+    itF.Next();
+    if (!itS.More())
+    {
+      break;
+    }
+    const occ::handle<ChFiDS_Stripe> B = itS.Value();
+    itS.Next();
+    itF.Next();
+    if (myDroppedStripes.Contains(A) || myDroppedStripes.Contains(B))
+    {
+      continue;
+    }
+    if (runsOut(A, FA))
+    {
+      myDroppedStripes.Append(B);
+      any = true;
+    }
+    else if (runsOut(B, FA))
+    {
+      myDroppedStripes.Append(A);
+      any = true;
+    }
+  }
+  if (any)
+  {
+    myVDataMap.Clear();
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(myListStripe); it.More(); it.Next())
+    {
+      if (myDroppedStripes.Contains(it.Value()))
+      {
+        continue;
+      }
+      if (it.Value()->Spine()->FirstStatus() <= ChFiDS_BreakPoint)
+      {
+        myVDataMap.Add(it.Value()->Spine()->FirstVertex(), it.Value());
+      }
+      if (it.Value()->Spine()->LastStatus() <= ChFiDS_BreakPoint)
+      {
+        myVDataMap.Add(it.Value()->Spine()->LastVertex(), it.Value());
+      }
+    }
+  }
+  return any;
+}
