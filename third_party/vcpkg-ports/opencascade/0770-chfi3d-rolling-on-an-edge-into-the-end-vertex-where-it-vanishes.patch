+//=======================================================================
+// function : ChFi3d_ArcTangentToFaceAt
+// purpose  : Whether the edge E, which ends at the vertex V, runs into V
+//            tangent to the face F that holds V (its direction there in
+//            F's tangent plane, within 0.01 rad).
+//=======================================================================
+
+static bool ChFi3d_ArcTangentToFaceAt(const TopoDS_Edge& E, const TopoDS_Face& F, const TopoDS_Vertex& V)
+{
+  if (E.IsNull() || F.IsNull() || V.IsNull() || BRep_Tool::Degenerated(E))
+  {
+    return false;
+  }
+  bool aHolds = false;
+  for (TopExp_Explorer ex(F, TopAbs_VERTEX); ex.More() && !aHolds; ex.Next())
+  {
+    aHolds = ex.Current().IsSame(V);
+  }
+  if (!aHolds)
+  {
+    return false;
+  }
+  BRepAdaptor_Curve aC(E);
+  gp_Pnt            P;
+  gp_Vec            T;
+  aC.D1(BRep_Tool::Parameter(V, E), P, T);
+  const gp_Pnt2d      aUV = BRep_Tool::Parameters(V, F);
+  BRepAdaptor_Surface aS(F, false);
+  gp_Pnt              Q;
+  gp_Vec              Du, Dv;
+  aS.D1(aUV.X(), aUV.Y(), Q, Du, Dv);
+  const gp_Vec N = Du.Crossed(Dv);
+  if (T.Magnitude() <= gp::Resolution() || N.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  return std::abs(T.Normalized().Dot(N.Normalized())) < 0.01;
+}
