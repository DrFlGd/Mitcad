+//=======================================================================
+// function : ChFi3d_EndBeforeVanishing
+// purpose  : A rounding of constant radius vanishing at an end of its
+//            spine, where its faces come tangent (a tangency extremity),
+//            walked up to that vertex. The walk's last step there may
+//            start from beyond a hundredth of the radius (to the singular
+//            section given to it), or it may crawl into the vertex with
+//            sections of no width. The approximation of the line then
+//            solves sections down to the vertex, where those on a face
+//            degenerate at it (a corner of a surface whose whole iso there
+//            is the vertex) take any parameters of that iso, away from
+//            those the contact came along (the p-curve's tolerance tens of
+//            millimetres), or it fails on sections narrower than about a
+//            ten-thousandth of the radius. The line's end is solved again
+//            from its last section at least aStopWidth wide: sections on
+//            towards the vertex, each from the one before, until narrower
+//            than aStopWidth within a hundredth of the radius of the
+//            vertex, where the line ends; the corner moves that end to the
+//            vertex (ChFi3d_ShrinkVanishingEnd), the blend ending in a
+//            point. Returns the ends so replaced (1 the first, 2 the last).
+//=======================================================================
+
+static int ChFi3d_EndBeforeVanishing(occ::handle<BRepBlend_Line>&     Lin,
+                                     const occ::handle<ChFiDS_Spine>& Spine,
+                                     occ::handle<ChFiDS_SurfData>&    Data,
+                                     Blend_Function&                  Func,
+                                     const double                     Tol)
+{
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (Lin.IsNull() || fsp.IsNull() || !fsp->IsConstant() || Spine->IsPeriodic() || Lin->NbPoints() < 4)
+  {
+    return 0;
+  }
+  const double aReach = 0.01 * fsp->Radius();
+  int          aChanged = 0; // (the ends replaced: 1 the first, 2 the last)
+  for (int aSide = 0; aSide < 2; aSide++)
+  {
+    const bool isFirst = aSide == 0;
+    if (!Spine->IsTangencyExtremity(isFirst))
+    {
+      continue;
+    }
+    const gp_Pnt PV = BRep_Tool::Pnt(isFirst ? Spine->FirstVertex() : Spine->LastVertex());
+    const int    nb = Lin->NbPoints();
+    const int    step = isFirst ? 1 : -1;
+    {
+      const Blend_Point& PE = Lin->Point(isFirst ? 1 : nb);
+      if (PE.PointOnS1().Distance(PV) > aReach || PE.PointOnS2().Distance(PV) > aReach)
+      {
+        continue; // (The walk does not end there.)
+      }
+    }
+    {
+      const double aStopWidth = 5.e-4 * fsp->Radius();
+      const int    iE0        = isFirst ? 1 : nb;
+      int          iK         = 0;
+      for (int i = isFirst ? nb : 1; i != iE0 - step; i -= step)
+      {
+        const Blend_Point& Pi = Lin->Point(i);
+        if (Pi.PointOnS1().Distance(Pi.PointOnS2()) < aStopWidth)
+        {
+          break;
+        }
+        iK = i;
+      }
+      const int iQ0 = iK + step; // (The section before, inside.)
+      if (iK != 0 && iK != iE0 && iQ0 >= 1 && iQ0 <= nb)
+      {
+        const Blend_Point& PK = Lin->Point(iK);
+        const Blend_Point& PQ = Lin->Point(iQ0);
+        math_Vector        X(1, 4), Xinf(1, 4), Xsup(1, 4), Xtol(1, 4);
+        PK.ParametersOnS1(X(1), X(2));
+        PK.ParametersOnS2(X(3), X(4));
+        // (Each step on the faces no longer than the walk's step before: no
+        // jump along a degenerate iso.)
+        double aStepUV = 0.;
+        {
+          double a1, b1, a2, b2;
+          PQ.ParametersOnS1(a1, b1);
+          PQ.ParametersOnS2(a2, b2);
+          aStepUV = std::hypot(X(1) - a1, X(2) - b1) + std::hypot(X(3) - a2, X(4) - b2);
+        }
+        const double                      w0 = PK.Parameter(), w1 = Lin->Point(iE0).Parameter();
+        NCollection_Sequence<Blend_Point> aNew;
+        Func.GetTolerance(Xtol, Tol);
+        Func.GetBounds(Xinf, Xsup);
+        for (int k = 1; k <= 40; k++)
+        {
+          const double w = w0 + (w1 - w0) * (1. - std::pow(0.5, k));
+          Func.Set(w);
+          math_FunctionSetRoot aRoot(Func, Xtol, 30);
+          aRoot.Perform(Func, X, Xinf, Xsup);
+          if (!aRoot.IsDone())
+          {
+            break;
+          }
+          math_Vector Y(1, 4);
+          aRoot.Root(Y);
+          if (!Func.IsSolution(Y, Tol)
+              || std::hypot(Y(1) - X(1), Y(2) - X(2)) + std::hypot(Y(3) - X(3), Y(4) - X(4)) > aStepUV)
+          {
+            break;
+          }
+          X               = Y;
+          const gp_Pnt P1 = Func.PointOnS1(), P2 = Func.PointOnS2();
+          aNew.Append(Func.IsTangencyPoint() ? Blend_Point(P1, P2, w, X(1), X(2), X(3), X(4))
+                                              : Blend_Point(P1,
+                                                            P2,
+                                                            w,
+                                                            X(1),
+                                                            X(2),
+                                                            X(3),
+                                                            X(4),
+                                                            Func.TangentOnS1(),
+                                                            Func.TangentOnS2(),
+                                                            Func.Tangent2dOnS1(),
+                                                            Func.Tangent2dOnS2()));
+          if (P1.Distance(P2) < aStopWidth)
+          {
+            break;
+          }
+        }
+        if (!aNew.IsEmpty() && aNew.Last().PointOnS1().Distance(aNew.Last().PointOnS2()) < aStopWidth
+            && aNew.Last().PointOnS1().Distance(PV) <= aReach && aNew.Last().PointOnS2().Distance(PV) <= aReach)
+        {
+          if (isFirst)
+          {
+            Lin->Remove(1, iK - 1);
+          }
+          else
+          {
+            Lin->Remove(iK + 1, nb);
+          }
+          for (int k = 1; k <= aNew.Length(); k++)
+          {
+            if (isFirst)
+            {
+              Lin->Prepend(aNew(k));
+            }
+            else
+            {
+              Lin->Append(aNew(k));
+            }
+          }
+          const Blend_Point& PL = aNew.Last();
+          double             u1, v1, u2, v2;
+          PL.ParametersOnS1(u1, v1);
+          PL.ParametersOnS2(u2, v2);
+          BRepBlend_Extremity E1, E2;
+          E1.SetValue(PL.PointOnS1(), u1, v1, PL.Parameter(), Tol);
+          E2.SetValue(PL.PointOnS2(), u2, v2, PL.Parameter(), Tol);
+          if (isFirst)
+          {
+            Lin->SetStartPoints(E1, E2);
+          }
+          else
+          {
+            Lin->SetEndPoints(E1, E2);
+          }
+          if (!Data.IsNull())
+          {
+            Data->ChangeVertex(isFirst, 1).Reset();
+            Data->ChangeVertex(isFirst, 2).Reset();
+          }
+          aChanged |= isFirst ? 1 : 2;
+        }
+      }
+    }
+  }
+  return aChanged;
+}
