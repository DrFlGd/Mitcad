+// The parameter of the projection of P on the line of FI within its range
+// (widened by Margin), and the distance.
+bool gapLineParam(const TopOpeBRepDS_DataStructure& DStr,
+                  const ChFiDS_FaceInterference&    FI,
+                  const gp_Pnt&                     P,
+                  const double                      Margin,
+                  double&                           t,
+                  double&                           d)
+{
+  const occ::handle<Geom_Curve>& C = DStr.Curve(FI.LineIndex()).Curve();
+  if (C.IsNull())
+  {
+    return false;
+  }
+  const double a = std::min(FI.FirstParameter(), FI.LastParameter()) - Margin;
+  const double b = std::max(FI.FirstParameter(), FI.LastParameter()) + Margin;
+  GeomAPI_ProjectPointOnCurve aPr(P, C, std::max(a, C->FirstParameter()), std::min(b, C->LastParameter()));
+  if (aPr.NbPoints() == 0)
+  {
+    return false;
+  }
+  t = aPr.LowerDistanceParameter();
+  d = aPr.LowerDistance();
+  return true;
+}
+
+// The ball of radius R through the point at t of line FId (on surface Sd)
+// touching surface So near line FIo: its centre and its contacts.
+bool gapBallAt(const TopOpeBRepDS_DataStructure& DStr,
+               const ChFiDS_FaceInterference&    FId,
+               const occ::handle<Geom_Surface>&  Sd,
+               const ChFiDS_FaceInterference&    FIo,
+               const occ::handle<Geom_Surface>&  So,
+               const double                      R,
+               const double                      t,
+               gp_Pnt&                           Pc,
+               gp_Pnt&                           Pd,
+               gp_Pnt&                           Po)
+{
+  if (FId.PCurveOnFace().IsNull() || Sd.IsNull() || So.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d uv = FId.PCurveOnFace()->Value(t);
+  gp_Vec         Du, Dv;
+  Sd->D1(uv.X(), uv.Y(), Pd, Du, Dv);
+  gp_Vec Nv = Du.Crossed(Dv);
+  if (Nv.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  Nv.Normalize();
+  double t0 = 0., d0 = 0.;
+  if (!gapLineParam(DStr, FIo, Pd, Precision::Infinite(), t0, d0))
+  {
+    return false;
+  }
+  const gp_Pnt PO0 = DStr.Curve(FIo.LineIndex()).Curve()->Value(t0);
+  const gp_Pnt c1 = Pd.Translated(R * Nv), c2 = Pd.Translated(-R * Nv);
+  Pc              = std::abs(c1.Distance(PO0) - R) <= std::abs(c2.Distance(PO0) - R) ? c1 : c2;
+  GeomAPI_ProjectPointOnSurf aPr(Pc, So);
+  if (aPr.NbPoints() == 0)
+  {
+    return false;
+  }
+  Po = aPr.NearestPoint();
+  return std::abs(Pc.Distance(Po) - R) <= 0.01 * R;
+}
