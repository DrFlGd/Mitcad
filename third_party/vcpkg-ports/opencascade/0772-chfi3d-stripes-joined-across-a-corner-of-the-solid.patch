+// Whether two faces lie on one plane, their material on the same side.
+bool samePlane(const TopoDS_Face& A, const TopoDS_Face& B)
+{
+  const occ::handle<Geom_Plane> PA = occ::down_cast<Geom_Plane>(BRep_Tool::Surface(A));
+  const occ::handle<Geom_Plane> PB = occ::down_cast<Geom_Plane>(BRep_Tool::Surface(B));
+  if (PA.IsNull() || PB.IsNull())
+  {
+    return false;
+  }
+  gp_Dir nA = PA->Pln().Axis().Direction(), nB = PB->Pln().Axis().Direction();
+  if (A.Orientation() == TopAbs_REVERSED)
+  {
+    nA.Reverse();
+  }
+  if (B.Orientation() == TopAbs_REVERSED)
+  {
+    nB.Reverse();
+  }
+  return nA.Angle(nB) < 1.e-7 && PA->Pln().Distance(PB->Pln().Location()) < Precision::Confusion();
+}
+
+bool holds(const TopoDS_Shape& S, const TopoDS_Shape& V)
+{
+  for (TopExp_Explorer ex(S, TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(V))
+    {
+      return true;
+    }
+  }
+  return false;
+}
