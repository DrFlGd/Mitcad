+// Line i of an intersection of surfaces S1 and S2, bounded, with its
+// p-curves (made by projection where the intersection gives none, as for
+// the analytic lines of two quadrics), as B-splines over its range.
+bool gapInterLine(const GeomInt_IntSS&             Inter,
+                  const int                        i,
+                  const occ::handle<Geom_Surface>& S1,
+                  const occ::handle<Geom_Surface>& S2,
+                  occ::handle<Geom_Curve>&         L,
+                  occ::handle<Geom2d_Curve>&       L1,
+                  occ::handle<Geom2d_Curve>&       L2)
+{
+  L = Inter.Line(i);
+  if (L.IsNull() || Precision::IsInfinite(L->FirstParameter()) || Precision::IsInfinite(L->LastParameter()))
+  {
+    return false;
+  }
+  const double a = L->FirstParameter(), b = L->LastParameter();
+  L1             = Inter.HasLineOnS1(i) ? Inter.LineOnS1(i) : GeomProjLib::Curve2d(L, a, b, S1);
+  L2             = Inter.HasLineOnS2(i) ? Inter.LineOnS2(i) : GeomProjLib::Curve2d(L, a, b, S2);
+  if (L1.IsNull() || L2.IsNull())
+  {
+    return false;
+  }
+  // (One parametrization: the 3d line's, as B-splines.)
+  L = GeomConvert::CurveToBSplineCurve(new Geom_TrimmedCurve(L, a, b));
+  for (occ::handle<Geom2d_Curve>* P : {&L1, &L2})
+  {
+    if (std::abs((*P)->FirstParameter() - a) > Precision::PConfusion()
+        || std::abs((*P)->LastParameter() - b) > Precision::PConfusion())
+    {
+      if ((*P)->FirstParameter() > a + Precision::PConfusion() || (*P)->LastParameter() < b - Precision::PConfusion())
+      {
+        return false;
+      }
+    }
+    *P = Geom2dConvert::CurveToBSplineCurve(new Geom2d_TrimmedCurve(*P, a, b));
+  }
+  return std::abs(L->FirstParameter() - a) <= Precision::PConfusion()
+         && std::abs(L->LastParameter() - b) <= Precision::PConfusion();
+}
+
+// The cut of blend surface S by the surface of face C from P1 to P2 (the
+// points where the blend's contact leaves its face across an edge of C and
+// comes back): their intersection's arc between them, made of the lines
+// that meet end to end, with its p-curves on S and on C. Its direction is
+// from P1 to P2.
+bool gapCutBetween(const occ::handle<Geom_Surface>& S,
+                   const TopoDS_Face&               C,
+                   const gp_Pnt&                    P1,
+                   const gp_Pnt&                    P2,
+                   const double                     tol3d,
+                   occ::handle<Geom_Curve>&         Cc,
+                   occ::handle<Geom2d_Curve>&       Ps,
+                   occ::handle<Geom2d_Curve>&       Pc,
+                   double&                          tolreached)
+{
+  const occ::handle<Geom_Surface> SC = BRep_Tool::Surface(C);
+  if (S.IsNull() || SC.IsNull())
+  {
+    return false;
+  }
+  GeomInt_IntSS anInter;
+  anInter.Perform(S, SC, 2.e-7, true, true, true);
+  if (!anInter.IsDone())
+  {
+    return false;
+  }
+  const double aTolP = std::max(100. * tol3d, 1.e-4);
+  struct Arc
+  {
+    occ::handle<Geom_Curve>   C3;
+    occ::handle<Geom2d_Curve> C1, C2;
+    bool                      used;
+  };
+  NCollection_Sequence<Arc> aArcs;
+  for (int i = 1; i <= anInter.NbLines(); i++)
+  {
+    occ::handle<Geom_Curve>   L;
+    occ::handle<Geom2d_Curve> L1, L2;
+    if (!gapInterLine(anInter, i, S, SC, L, L1, L2))
+    {
+      continue;
+    }
+    aArcs.Append({L, L1, L2, false});
+  }
+  // The line through P1, from P1 on; then the lines joining its end, up to
+  // the one through P2.
+  const auto paramOn = [&](const occ::handle<Geom_Curve>& L, const gp_Pnt& P, double& t) {
+    GeomAPI_ProjectPointOnCurve aPr(P, L, L->FirstParameter(), L->LastParameter());
+    double                      d = RealLast();
+    if (aPr.NbPoints() > 0)
+    {
+      d = aPr.LowerDistance();
+      t = aPr.LowerDistanceParameter();
+    }
+    for (const double te : {L->FirstParameter(), L->LastParameter()})
+    {
+      if (L->Value(te).Distance(P) < d)
+      {
+        d = L->Value(te).Distance(P);
+        t = te;
+      }
+    }
+    return d <= aTolP;
+  };
+  // Pieces of the chain: line, from, to (parameters).
+  struct Piece
+  {
+    int    i;
+    double a, b;
+  };
+  for (int i0 = 1; i0 <= aArcs.Length(); i0++)
+  {
+    double t1 = 0.;
+    if (!paramOn(aArcs(i0).C3, P1, t1))
+    {
+      continue;
+    }
+    for (int dir0 = 0; dir0 < 2; dir0++)
+    {
+      NCollection_Sequence<Piece> aChain;
+      for (int k = 1; k <= aArcs.Length(); k++)
+      {
+        aArcs(k).used = false;
+      }
+      int    i   = i0;
+      double ta  = t1;
+      bool   fwd = dir0 == 0;
+      bool   ok  = false;
+      for (int n = 0; n < 2 * aArcs.Length() + 2; n++)
+      {
+        const occ::handle<Geom_Curve>& L = aArcs(i).C3;
+        aArcs(i).used                    = true;
+        double t2                        = 0.;
+        // (P2 on this line, ahead.)
+        if (paramOn(L, P2, t2) && (fwd ? t2 > ta + Precision::PConfusion() : t2 < ta - Precision::PConfusion()))
+        {
+          aChain.Append({i, ta, t2});
+          ok = true;
+          break;
+        }
+        const double tz = fwd ? L->LastParameter() : L->FirstParameter();
+        if (std::abs(tz - ta) <= Precision::PConfusion())
+        {
+          break;
+        }
+        aChain.Append({i, ta, tz});
+        const gp_Pnt Z = L->Value(tz);
+        // The next line from Z.
+        int next = 0;
+        for (int k = 1; k <= aArcs.Length() && next == 0; k++)
+        {
+          if (aArcs(k).used)
+          {
+            continue;
+          }
+          const occ::handle<Geom_Curve>& K = aArcs(k).C3;
+          if (K->Value(K->FirstParameter()).Distance(Z) <= aTolP)
+          {
+            next = k;
+            ta   = K->FirstParameter();
+            fwd  = true;
+          }
+          else if (K->Value(K->LastParameter()).Distance(Z) <= aTolP)
+          {
+            next = k;
+            ta   = K->LastParameter();
+            fwd  = false;
+          }
+        }
+        if (next == 0)
+        {
+          break;
+        }
+        i = next;
+      }
+      if (!ok)
+      {
+        continue;
+      }
+      // The chain as one curve through points along its pieces (the lines
+      // meet at an angle where two intersection branches join), its
+      // p-curves the projections on both surfaces.
+      NCollection_Sequence<gp_Pnt> aPts;
+      for (int k = 1; k <= aChain.Length(); k++)
+      {
+        const Piece&                   p  = aChain(k);
+        const occ::handle<Geom_Curve>& L3 = aArcs(p.i).C3;
+        const int                      nb = 24;
+        for (int j = (k == 1 ? 0 : 1); j <= nb; j++)
+        {
+          const gp_Pnt Q = L3->Value(p.a + (p.b - p.a) * j / nb);
+          if (aPts.IsEmpty() || aPts.Last().Distance(Q) > Precision::Confusion())
+          {
+            aPts.Append(Q);
+          }
+        }
+      }
+      if (aPts.Length() < 3)
+      {
+        continue;
+      }
+      // (Each point's parameters on both surfaces, the nearest points; the
+      // three curves interpolated over the same chord-length parameters.)
+      const int                                n    = aPts.Length();
+      occ::handle<NCollection_HArray1<gp_Pnt>> aArr = new NCollection_HArray1<gp_Pnt>(1, n);
+      occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVs = new NCollection_HArray1<gp_Pnt2d>(1, n);
+      occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVc = new NCollection_HArray1<gp_Pnt2d>(1, n);
+      occ::handle<NCollection_HArray1<double>>   aPar = new NCollection_HArray1<double>(1, n);
+      double                                     aLen  = 0.;
+      bool                                       aProj = true;
+      for (int k = 1; k <= n && aProj; k++)
+      {
+        aLen += k > 1 ? aPts(k).Distance(aPts(k - 1)) : 0.;
+        aArr->SetValue(k, aPts(k));
+        aPar->SetValue(k, aLen);
+        for (int s = 0; s < 2 && aProj; s++)
+        {
+          GeomAPI_ProjectPointOnSurf aPr(aPts(k), s == 0 ? S : SC);
+          aProj = aPr.NbPoints() > 0 && aPr.LowerDistance() <= aTolP;
+          if (aProj)
+          {
+            double u = 0., v = 0.;
+            aPr.LowerDistanceParameters(u, v);
+            // (On a periodic surface, in the period of the point before, the
+            // first in the face's.)
+            const occ::handle<Geom_Surface>& Sk = s == 0 ? S : SC;
+            for (int d = 0; d < 2; d++)
+            {
+              const bool per = d == 0 ? Sk->IsUPeriodic() : Sk->IsVPeriodic();
+              if (!per)
+              {
+                continue;
+              }
+              const double T   = d == 0 ? Sk->UPeriod() : Sk->VPeriod();
+              double       ref = 0.;
+              if (k > 1)
+              {
+                ref = d == 0 ? (s == 0 ? aUVs : aUVc)->Value(k - 1).X() : (s == 0 ? aUVs : aUVc)->Value(k - 1).Y();
+              }
+              else if (s == 1)
+              {
+                double u0, u1, v0, v1;
+                BRepTools::UVBounds(C, u0, u1, v0, v1);
+                ref = d == 0 ? 0.5 * (u0 + u1) : 0.5 * (v0 + v1);
+              }
+              else
+              {
+                continue;
+              }
+              double& c = d == 0 ? u : v;
+              c         = ElCLib::InPeriod(c, ref - 0.5 * T, ref + 0.5 * T);
+            }
+            (s == 0 ? aUVs : aUVc)->SetValue(k, gp_Pnt2d(u, v));
+          }
+        }
+      }
+      if (!aProj)
+      {
+        continue;
+      }
+      GeomAPI_Interpolate   anI3(aArr, aPar, false, Precision::Confusion());
+      Geom2dAPI_Interpolate anIs(aUVs, aPar, false, Precision::PConfusion());
+      Geom2dAPI_Interpolate anIc(aUVc, aPar, false, Precision::PConfusion());
+      anI3.Perform();
+      anIs.Perform();
+      anIc.Perform();
+      if (!anI3.IsDone() || !anIs.IsDone() || !anIc.IsDone())
+      {
+        continue;
+      }
+      Cc = anI3.Curve();
+      Ps = anIs.Curve();
+      Pc = anIc.Curve();
+      tolreached = std::max(anInter.TolReached3d(), tol3d);
+      return true;
+    }
+  }
+  return false;
+}
