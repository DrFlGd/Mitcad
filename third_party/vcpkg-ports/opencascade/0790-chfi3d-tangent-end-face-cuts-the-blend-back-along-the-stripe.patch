+//=======================================================================
+// function : ChFi3d_SideOfSurface
+// purpose  : The signed distance of P from surface S (its normal sign
+//            reversed when theReversed), from P's projection on S; false
+//            where P does not project. theUV, when theSeeded, is where the
+//            projection starts (the last sample's, along a curve), and is
+//            the projection's parameters on return.
+//=======================================================================
+
+static bool ChFi3d_SideOfSurface(const occ::handle<Geom_Surface>& S,
+                                 const GeomAdaptor_Surface&       GS,
+                                 const bool                       theReversed,
+                                 const gp_Pnt&                    P,
+                                 double&                          theDist,
+                                 gp_Pnt2d&                        theUV,
+                                 bool&                            theSeeded)
+{
+  double u = 0., v = 0.;
+  if (GS.GetType() == GeomAbs_Plane)
+  {
+    ElSLib::Parameters(GS.Plane(), P, u, v);
+  }
+  else
+  {
+    bool located = false;
+    if (theSeeded)
+    {
+      Extrema_GenLocateExtPS aLoc(GS, Precision::PConfusion(), Precision::PConfusion());
+      aLoc.Perform(P, theUV.X(), theUV.Y());
+      if (aLoc.IsDone())
+      {
+        aLoc.Point().Parameter(u, v);
+        located = true;
+      }
+    }
+    if (!located)
+    {
+      GeomAPI_ProjectPointOnSurf aPr(P, S);
+      if (aPr.NbPoints() == 0)
+      {
+        return false;
+      }
+      aPr.LowerDistanceParameters(u, v);
+    }
+    theUV.SetCoord(u, v);
+    theSeeded = true;
+  }
+  gp_Pnt p;
+  gp_Vec du, dv;
+  GS.D1(u, v, p, du, dv);
+  gp_Vec n = du.Crossed(dv);
+  if (n.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  n.Normalize();
+  theDist = gp_Vec(p, P).Dot(n) * (theReversed ? -1. : 1.);
+  return true;
+}
+
+//=======================================================================
+// function : ChFi3d_ParametersNearOn
+// purpose  : The parameters of P on S, in the periods nearest to Near.
+//=======================================================================
+
+static bool ChFi3d_ParametersNearOn(const occ::handle<Geom_Surface>& S,
+                                    const gp_Pnt&                    P,
+                                    const gp_Pnt2d&                  Near,
+                                    gp_Pnt2d&                        UV)
+{
+  GeomAPI_ProjectPointOnSurf aPr(P, S);
+  if (aPr.NbPoints() == 0)
+  {
+    return false;
+  }
+  double u = 0., v = 0.;
+  aPr.LowerDistanceParameters(u, v);
+  if (S->IsUPeriodic())
+  {
+    u = ElCLib::InPeriod(u, Near.X() - 0.5 * S->UPeriod(), Near.X() + 0.5 * S->UPeriod());
+  }
+  if (S->IsVPeriodic())
+  {
+    v = ElCLib::InPeriod(v, Near.Y() - 0.5 * S->VPeriod(), Near.Y() + 0.5 * S->VPeriod());
+  }
+  UV.SetCoord(u, v);
+  return true;
+}
