   if (surf->IsUPeriodic())
   {
     double u1 = p1.X(), u2 = p2.X();
     double uper = surf->UPeriod();
     if (fabs(u2 - u1) > 0.5 * uper)
     {
-      if (u2 < u1 && refon1)
