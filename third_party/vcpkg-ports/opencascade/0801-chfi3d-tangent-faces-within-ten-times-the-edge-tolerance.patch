     return true;
   }
 
-  double TolC0 = std::max(0.001, 1.5 * BRep_Tool::Tolerance(theEdge));
+  // The edge's curves on its two faces each lie within its tolerance of
+  // its own curve, so up to twice that apart; on the edges of stored bodies
+  // approximated by B-splines (a thread's helices of several turns,
+  // tolerances of a few micrometres) they lie up to three times as far
+  // apart. Tangent faces were taken for faces meeting at an angle there:
+  // the positions are compared within ten times the edge's tolerance (the
+  // normals within a tenth of a radian as before).
+  double TolC0 = std::max(0.001, 10. * BRep_Tool::Tolerance(theEdge));
 
   double aFirst;
   double aLast;
