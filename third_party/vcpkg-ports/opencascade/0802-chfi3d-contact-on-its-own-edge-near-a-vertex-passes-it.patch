+//=======================================================================
+// function : ChFi3d_OwnEdgeNearVertex
+// purpose  : A contact on face F that ends on the spine's own edge E (an
+//            edge of the spine between F and the blend's other face Fo)
+//            within ten times its tolerance or its vertex's of the vertex V
+//            ahead (Dir, the contact's way) where the spine goes on into
+//            another of its edges: the ball cannot touch F across its own
+//            edge, and it ends there only where the blend is thinner than
+//            the edges' deviation (a thread's flank running nearly tangent
+//            into a chamfer cone, the stored edges a few micrometres off
+//            their faces). The contact passes into the face at V that goes
+//            on tangentially from F and holds the spine's next edge: CP is
+//            taken at V, with its way, as SearchFaceOnV needs it.
+//=======================================================================
+
+static bool ChFi3d_OwnEdgeNearVertex(ChFiDS_CommonPoint&              CP,
+                                     const TopoDS_Face&               F,
+                                     const TopoDS_Face&               Fo,
+                                     const gp_Vec&                    Dir,
+                                     const occ::handle<ChFiDS_Spine>& Spine,
+                                     const ChFiDS_Map&                VEMap,
+                                     const ChFiDS_Map&                EFMap)
+{
+  if (Spine.IsNull() || !CP.IsOnArc() || CP.IsVertex() || F.IsNull() || Fo.IsNull() || F.IsSame(Fo)
+      || Dir.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  const TopoDS_Edge E = CP.Arc();
+  if (!EFMap.Contains(E))
+  {
+    return false;
+  }
+  bool onF = false, onFo = false;
+  for (const TopoDS_Shape& aFace : EFMap.FindFromKey(E))
+  {
+    onF  = onF || aFace.IsSame(F);
+    onFo = onFo || aFace.IsSame(Fo);
+  }
+  bool isSpine = false;
+  for (int i = 1; i <= Spine->NbEdges() && !isSpine; i++)
+  {
+    isSpine = Spine->Edges(i).IsSame(E);
+  }
+  if (!onF || !onFo || !isSpine)
+  {
+    return false;
+  }
+  for (TopExp_Explorer ex(E, TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    const TopoDS_Vertex V     = TopoDS::Vertex(ex.Current());
+    const gp_Pnt        PV    = BRep_Tool::Pnt(V);
+    const double        reach = 10. * std::max(BRep_Tool::Tolerance(E), BRep_Tool::Tolerance(V));
+    if (PV.Distance(CP.Point()) > reach || gp_Vec(CP.Point(), PV).Dot(Dir) < -reach * Dir.Magnitude()
+        || !VEMap.Contains(V))
+    {
+      continue;
+    }
+    // The spine goes on past V, and a face at V other than F and Fo, across
+    // an edge of F there tangent to F, holds the spine's next edge.
+    TopoDS_Edge Enext;
+    for (int i = 1; i <= Spine->NbEdges() && Enext.IsNull(); i++)
+    {
+      const TopoDS_Edge& Ei = Spine->Edges(i);
+      if (Ei.IsSame(E))
+      {
+        continue;
+      }
+      for (TopExp_Explorer ev(Ei, TopAbs_VERTEX); ev.More(); ev.Next())
+      {
+        if (ev.Current().IsSame(V))
+        {
+          Enext = Ei;
+        }
+      }
+    }
+    if (Enext.IsNull() || !EFMap.Contains(Enext))
+    {
+      continue;
+    }
+    bool found = false;
+    for (const TopoDS_Shape& anEdge : VEMap.FindFromKey(V))
+    {
+      const TopoDS_Edge& Ev = TopoDS::Edge(anEdge);
+      if (found || Ev.IsSame(E) || Ev.IsSame(Enext) || !EFMap.Contains(Ev))
+      {
+        continue;
+      }
+      TopoDS_Face Fn;
+      bool        hasF = false;
+      for (const TopoDS_Shape& aFace : EFMap.FindFromKey(Ev))
+      {
+        if (aFace.IsSame(F))
+        {
+          hasF = true;
+        }
+        else
+        {
+          Fn = TopoDS::Face(aFace);
+        }
+      }
+      if (!hasF || Fn.IsNull() || Fn.IsSame(Fo) || !ChFi3d::IsTangentFaces(Ev, F, Fn))
+      {
+        continue;
+      }
+      for (const TopoDS_Shape& aFace : EFMap.FindFromKey(Enext))
+      {
+        found = found || aFace.IsSame(Fn);
+      }
+    }
+    if (!found)
+    {
+      continue;
+    }
+    CP.SetArc(std::max(CP.Tolerance(), PV.Distance(CP.Point())), E, BRep_Tool::Parameter(V, E),
+              CP.TransitionOnArc());
+    CP.SetVertex(V);
+    CP.SetVector(Dir);
+    return true;
+  }
+  return false;
+}
