+//=======================================================================
+// function : ChFi3d_TangentCapCrossings
+// purpose  : At an OnSame end, the cap Pc (on the face at the end S) and
+//            the prolongation Pz (from Uz1 to Uz2) meet at the opposite
+//            contact's end P. Where they meet tangentially there (within
+//            a hundredth of a radian), they cross again near P wherever
+//            the cap's approximation passes over to the prolongation's
+//            side, although the two stay within micrometres of each
+//            other: their crossings within a hundredth of the cap's length
+//            from P are added to Box, the box P's tolerance is made from.
+//=======================================================================
+
+static void ChFi3d_TangentCapCrossings(const occ::handle<Geom2d_Curve>& Pc,
+                                       const occ::handle<Geom2d_Curve>& Pz,
+                                       const double                     Uz1,
+                                       const double                     Uz2,
+                                       const occ::handle<Geom_Surface>& S,
+                                       const gp_Pnt&                    P,
+                                       Bnd_Box&                         Box)
+{
+  if (Pc.IsNull() || Pz.IsNull() || S.IsNull() || Uz2 - Uz1 <= Precision::PConfusion())
+  {
+    return;
+  }
+  const double uc1 = Pc->FirstParameter(), uc2 = Pc->LastParameter();
+  if (uc2 - uc1 <= Precision::PConfusion() || Precision::IsInfinite(uc1) || Precision::IsInfinite(uc2))
+  {
+    return;
+  }
+  // The ends of the cap and of the prolongation at P, and their tangents.
+  const gp_Pnt c1 = S->Value(Pc->Value(uc1).X(), Pc->Value(uc1).Y());
+  const gp_Pnt c2 = S->Value(Pc->Value(uc2).X(), Pc->Value(uc2).Y());
+  const gp_Pnt z1 = S->Value(Pz->Value(Uz1).X(), Pz->Value(Uz1).Y());
+  const gp_Pnt z2 = S->Value(Pz->Value(Uz2).X(), Pz->Value(Uz2).Y());
+  const double uc = c1.Distance(P) <= c2.Distance(P) ? uc1 : uc2;
+  const double uz = z1.Distance(P) <= z2.Distance(P) ? Uz1 : Uz2;
+  gp_Pnt2d     p2;
+  gp_Vec2d     tc, tz;
+  Pc->D1(uc, p2, tc);
+  Pz->D1(uz, p2, tz);
+  if (tc.Magnitude() <= gp::Resolution() || tz.Magnitude() <= gp::Resolution())
+  {
+    return;
+  }
+  const double anAngle = std::abs(tc.Angle(tz));
+  if (std::min(anAngle, M_PI - anAngle) > 0.01)
+  {
+    return;
+  }
+  const double aLength = c1.Distance(c2);
+  Geom2dAPI_InterCurveCurve anInter(new Geom2d_TrimmedCurve(Pc, uc1, uc2),
+                                    new Geom2d_TrimmedCurve(Pz, Uz1, Uz2),
+                                    Precision::PConfusion());
+  for (int i = 1; i <= anInter.NbPoints(); i++)
+  {
+    const gp_Pnt2d q = anInter.Point(i);
+    const gp_Pnt   Q = S->Value(q.X(), q.Y());
+    const double   d = Q.Distance(P);
+    if (d <= 0.01 * aLength)
+    {
+      Box.Add(Q);
+    }
+  }
+}
