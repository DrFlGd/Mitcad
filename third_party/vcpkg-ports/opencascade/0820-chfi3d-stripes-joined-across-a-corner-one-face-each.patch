+// Curve C over [a, b] as a B-spline whose parameter s runs linearly from sa
+// at C(a) to sb at C(b) (reversed where sb < sa).
+occ::handle<Geom_Curve> gapReparam(const occ::handle<Geom_Curve>& C,
+                                   const double                   a,
+                                   const double                   b,
+                                   double                         sa,
+                                   double                         sb)
+{
+  if (C.IsNull() || std::abs(sb - sa) <= Precision::PConfusion())
+  {
+    return occ::handle<Geom_Curve>();
+  }
+  occ::handle<Geom_BSplineCurve> B = GeomConvert::CurveToBSplineCurve(new Geom_TrimmedCurve(C, a, b));
+  if (sa > sb)
+  {
+    B->Reverse();
+    std::swap(sa, sb);
+  }
+  NCollection_Array1<double> K(B->Knots());
+  BSplCLib::Reparametrize(sa, sb, K);
+  B->SetKnots(K);
+  return B;
+}
+
+// The same for a curve in a surface's parameters.
+occ::handle<Geom2d_Curve> gapReparam2d(const occ::handle<Geom2d_Curve>& C,
+                                       const double                     a,
+                                       const double                     b,
+                                       double                           sa,
+                                       double                           sb)
+{
+  if (C.IsNull() || std::abs(sb - sa) <= Precision::PConfusion())
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+  occ::handle<Geom2d_BSplineCurve> B = Geom2dConvert::CurveToBSplineCurve(new Geom2d_TrimmedCurve(C, a, b));
+  if (sa > sb)
+  {
+    B->Reverse();
+    std::swap(sa, sb);
+  }
+  NCollection_Array1<double> K(B->Knots());
+  BSplCLib::Reparametrize(sa, sb, K);
+  B->SetKnots(K);
+  return B;
+}
