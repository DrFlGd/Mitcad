+// The face of edge E other than F (null where there is none).
+TopoDS_Face lensOtherFace(const ChFiDS_Map& EFMap, const TopoDS_Edge& E, const TopoDS_Face& F)
+{
+  if (!EFMap.Contains(E))
+  {
+    return TopoDS_Face();
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(F))
+    {
+      return TopoDS::Face(it.Value());
+    }
+  }
+  return TopoDS_Face();
+}
+
+// A guide along spine Sp from a to b through its points, parametrized by
+// the spine's parameter.
+occ::handle<ChFiDS_ElSpine> lensGuide(const occ::handle<ChFiDS_Spine>& Sp, const double a, const double b)
+{
+  // (Past the spine's ends, along the curve its edge lies on where that
+  // goes on, its parameter taken in proportion; else along the tangent.)
+  const TopoDS_Edge&            E  = Sp->Edges(1);
+  const double                  w0 = Sp->FirstParameter(1), w1 = Sp->LastParameter(1);
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+  const bool same = !C.IsNull() && C->Value(f).Distance(Sp->Value(w0)) <= C->Value(l).Distance(Sp->Value(w0));
+  const auto at   = [&](const double w) {
+    if (w >= w0 && w <= w1)
+    {
+      return Sp->Value(w);
+    }
+    const double s = (w - w0) / (w1 - w0);
+    const double u = same ? f + s * (l - f) : l - s * (l - f);
+    if (!C.IsNull() && (C->IsPeriodic() || (u >= C->FirstParameter() && u <= C->LastParameter())))
+    {
+      return C->Value(u);
+    }
+    gp_Pnt P;
+    gp_Vec V;
+    Sp->D1(w < w0 ? w0 : w1, P, V);
+    return P.Translated(V.Normalized() * (w < w0 ? w - w0 : w - w1));
+  };
+  const int                                n  = 32;
+  occ::handle<NCollection_HArray1<gp_Pnt>> aP = new NCollection_HArray1<gp_Pnt>(1, n + 1);
+  occ::handle<NCollection_HArray1<double>> aT = new NCollection_HArray1<double>(1, n + 1);
+  for (int i = 0; i <= n; i++)
+  {
+    const double w = a + (b - a) * i / n;
+    aP->SetValue(i + 1, at(w));
+    aT->SetValue(i + 1, w);
+  }
+  GeomAPI_Interpolate anInterp(aP, aT, false, Precision::Confusion());
+  anInterp.Perform();
+  if (!anInterp.IsDone())
+  {
+    return occ::handle<ChFiDS_ElSpine>();
+  }
+  occ::handle<ChFiDS_ElSpine> HG = new ChFiDS_ElSpine();
+  HG->SetCurve(anInterp.Curve());
+  HG->FirstParameter(a);
+  HG->LastParameter(b);
+  return HG;
+}
+
+// Curve C over [a, b], lying on surface S, in S's parameters over C's
+// parameter: through its points' parameters, each found near the one
+// before (a periodic parameter kept continuous). Null where a point lies
+// off S beyond tol.
+occ::handle<Geom2d_Curve> lensCurveOnSurf(const occ::handle<Geom_Curve>&   C,
+                                          const double                     a,
+                                          const double                     b,
+                                          const occ::handle<Geom_Surface>& S,
+                                          const double                     tol)
+{
+  const int                                  n   = 48;
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aUV = new NCollection_HArray1<gp_Pnt2d>(1, n + 1);
+  occ::handle<NCollection_HArray1<double>>   aT  = new NCollection_HArray1<double>(1, n + 1);
+  ShapeAnalysis_Surface                      aSAS(S);
+  gp_Pnt2d                                   prev;
+  for (int i = 0; i <= n; i++)
+  {
+    const double t  = a + (b - a) * i / n;
+    const gp_Pnt P  = C->Value(t);
+    gp_Pnt2d     uv = i == 0 ? aSAS.ValueOfUV(P, tol) : aSAS.NextValueOfUV(prev, P, tol);
+    if (aSAS.Gap() > tol)
+    {
+      return occ::handle<Geom2d_Curve>();
+    }
+    if (i > 0)
+    {
+      double u = uv.X(), v = uv.Y();
+      if (S->IsUPeriodic())
+      {
+        u = ElCLib::InPeriod(u, prev.X() - 0.5 * S->UPeriod(), prev.X() + 0.5 * S->UPeriod());
+      }
+      if (S->IsVPeriodic())
+      {
+        v = ElCLib::InPeriod(v, prev.Y() - 0.5 * S->VPeriod(), prev.Y() + 0.5 * S->VPeriod());
+      }
+      uv.SetCoord(u, v);
+    }
+    aUV->SetValue(i + 1, uv);
+    aT->SetValue(i + 1, t);
+    prev = uv;
+  }
+  Geom2dAPI_Interpolate anInterp(aUV, aT, false, Precision::PConfusion());
+  anInterp.Perform();
+  return anInterp.IsDone() ? occ::handle<Geom2d_Curve>(anInterp.Curve()) : occ::handle<Geom2d_Curve>();
+}
+
+// The outward normal of face F at its parameters uv.
+gp_Vec lensNormal(const TopoDS_Face& F, const gp_Pnt2d& uv)
+{
+  BRepAdaptor_Surface S(F, false);
+  gp_Pnt              P;
+  gp_Vec              du, dv;
+  S.D1(uv.X(), uv.Y(), P, du, dv);
+  gp_Vec n = du.Crossed(dv);
+  if (n.Magnitude() > gp::Resolution())
+  {
+    n.Normalize();
+  }
+  return F.Orientation() == TopAbs_REVERSED ? n.Reversed() : n;
+}
