+TopoDS_Face ChFi3d_WidenedFace(const TopoDS_Face& F, const double R)
+{
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+  double                          u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+  BRepTools::UVBounds(F, u1, u2, v1, v2);
+  double U1 = 0., U2 = 0., V1 = 0., V2 = 0.;
+  S->Bounds(U1, U2, V1, V2);
+  const auto widened = [R](const bool per, const double T, const double f1, const double f2, const double S1,
+                           const double S2, double& w1, double& w2) {
+    if (per)
+    {
+      // (Within the surface's own period, the face's range shifted into it.)
+      const double g1 = ElCLib::InPeriod(f1, S1, S1 + T), g2 = g1 + (f2 - f1);
+      const double du = 0.45 * std::max(0., T - (f2 - f1));
+      w1              = g2 <= S1 + T ? std::max(S1, g1 - du) : g1;
+      w2              = g2 <= S1 + T ? std::min(S1 + T, g2 + du) : g2;
+      return;
+    }
+    const double d = (f2 - f1) + 10. * R;
+    w1             = Precision::IsInfinite(S1) ? f1 - d : S1;
+    w2             = Precision::IsInfinite(S2) ? f2 + d : S2;
+  };
+  double a1 = 0., a2 = 0., b1 = 0., b2 = 0.;
+  widened(S->IsUPeriodic(), S->IsUPeriodic() ? S->UPeriod() : 0., u1, u2, U1, U2, a1, a2);
+  widened(S->IsVPeriodic(), S->IsVPeriodic() ? S->VPeriod() : 0., v1, v2, V1, V2, b1, b2);
+  TopoDS_Face W = BRepLib_MakeFace(S, a1, a2, b1, b2, Precision::Confusion());
+  if (!W.IsNull())
+  {
+    W.Orientation(F.Orientation());
+  }
+  return W;
+}
