+//=======================================================================
+// function : ChFi3d_EndRstRstBeforeVanishing
+// purpose  : A ball of constant radius rolling on two edges that run into
+//            the spine's end vertex, where they meet: the section there
+//            has no width, the blend vanishes in a point. The walk crawls
+//            into the vertex with sections narrower than the approximation
+//            takes (about a ten-thousandth of the radius). The line's
+//            sections at such an end narrower than 5e-4 of the radius are
+//            dropped where the one left lies within a hundredth of the
+//            radius of the vertex; the corner moves that end to the vertex
+//            (ChFi3d_ShrinkVanishingEnd), as at the end of a rounding
+//            vanishing where its faces come tangent (ChFi3d_EndBeforeVanishing).
+//=======================================================================
+
+static void ChFi3d_EndRstRstBeforeVanishing(const occ::handle<BRepBlend_Line>& Lin,
+                                            const occ::handle<ChFiDS_Spine>&   Spine,
+                                            const double                       Tol)
+{
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (Lin.IsNull() || fsp.IsNull() || !fsp->IsConstant() || Spine->IsPeriodic())
+  {
+    return;
+  }
+  const double aReach     = 0.01 * fsp->Radius();
+  const double aStopWidth = 5.e-4 * fsp->Radius();
+  for (int aSide = 0; aSide < 2; aSide++)
+  {
+    const bool          isFirst = aSide == 0;
+    const TopoDS_Vertex V       = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+    const int           nb      = Lin->NbPoints();
+    if (V.IsNull() || nb < 5)
+    {
+      continue;
+    }
+    const gp_Pnt PV   = BRep_Tool::Pnt(V);
+    const auto   near = [&](const Blend_Point& P) {
+      return P.PointOnC1().Distance(PV) <= aReach && P.PointOnC2().Distance(PV) <= aReach;
+    };
+    const auto width = [](const Blend_Point& P) { return P.PointOnC1().Distance(P.PointOnC2()); };
+    const int  iE    = isFirst ? 1 : nb;
+    if (!near(Lin->Point(iE)) || width(Lin->Point(iE)) >= aStopWidth)
+    {
+      continue;
+    }
+    // (The section kept at that end: the first from it at least aStopWidth
+    // wide, at least four sections left.)
+    int iK = iE;
+    while (iK >= 1 && iK <= nb && width(Lin->Point(iK)) < aStopWidth)
+    {
+      iK += isFirst ? 1 : -1;
+    }
+    if (iK < 1 || iK > nb || !near(Lin->Point(iK)) || (isFirst ? nb - iK + 1 : iK) < 4)
+    {
+      continue;
+    }
+    const Blend_Point PK = Lin->Point(iK);
+    if (isFirst)
+    {
+      Lin->Remove(1, iK - 1);
+    }
+    else
+    {
+      Lin->Remove(iK + 1, nb);
+    }
+    BRepBlend_Extremity E1, E2;
+    E1.SetValue(PK.PointOnC1(), PK.ParameterOnC1(), PK.Parameter(), Tol);
+    E2.SetValue(PK.PointOnC2(), PK.ParameterOnC2(), PK.Parameter(), Tol);
+    if (isFirst)
+    {
+      Lin->SetStartPoints(E1, E2);
+    }
+    else
+    {
+      Lin->SetEndPoints(E1, E2);
+    }
+  }
+}
