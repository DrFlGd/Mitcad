+//=======================================================================
+// function : ChFi3d_OwnEdgeAtVertex
+// purpose  : CP, a contact on face F ending at a vertex V on another edge
+//            Ev of F than the edge E between F and the blend's other face
+//            Fo, where a face Fn across Ev goes on tangentially from F and
+//            meets Fo along an edge from V: E as it lies in F, and the
+//            transition of the contact on it (it leaves or enters F across
+//            E at V as it does across Ev). Null where CP is no such point.
+//=======================================================================
+
+static TopoDS_Edge ChFi3d_OwnEdgeAtVertex(const ChFiDS_CommonPoint& CP,
+                                          const TopoDS_Face&        F,
+                                          const TopoDS_Face&        Fo,
+                                          const ChFiDS_Map&         VEMap,
+                                          const ChFiDS_Map&         EFMap,
+                                          TopAbs_Orientation&       Tr)
+{
+  if (!CP.IsVertex() || !CP.IsOnArc() || F.IsSame(Fo))
+  {
+    return TopoDS_Edge();
+  }
+  const TopoDS_Vertex V  = CP.Vertex();
+  const TopoDS_Edge   Ev = CP.Arc();
+  if (!VEMap.Contains(V) || !EFMap.Contains(Ev))
+  {
+    return TopoDS_Edge();
+  }
+  // Whether the faces of an edge are A and B.
+  const auto between = [&](const TopoDS_Shape& theEdge, const TopoDS_Shape& A, const TopoDS_Shape& B) {
+    if (!EFMap.Contains(theEdge))
+    {
+      return false;
+    }
+    bool onA = false, onB = false;
+    for (const TopoDS_Shape& aFace : EFMap.FindFromKey(theEdge))
+    {
+      onA = onA || aFace.IsSame(A);
+      onB = onB || aFace.IsSame(B);
+    }
+    return onA && onB;
+  };
+  TopoDS_Face Fn;
+  bool        hasF = false;
+  for (const TopoDS_Shape& aFace : EFMap.FindFromKey(Ev))
+  {
+    if (aFace.IsSame(F))
+    {
+      hasF = true;
+    }
+    else
+    {
+      Fn = TopoDS::Face(aFace);
+    }
+  }
+  if (!hasF || Fn.IsNull() || Fn.IsSame(Fo) || !ChFi3d::IsTangentFaces(Ev, F, Fn))
+  {
+    return TopoDS_Edge();
+  }
+  TopoDS_Shape E;
+  bool         aNext = false;
+  for (const TopoDS_Shape& anEdge : VEMap.FindFromKey(V))
+  {
+    if (E.IsNull() && between(anEdge, F, Fo))
+    {
+      E = anEdge;
+    }
+    aNext = aNext || between(anEdge, Fn, Fo);
+  }
+  if (E.IsNull() || !aNext)
+  {
+    return TopoDS_Edge();
+  }
+  // The transition on E is that on Ev, reversed where the two lie in F the
+  // other way round.
+  TopoDS_Edge anOwn, anArc;
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (anOwn.IsNull() && ex.Current().IsSame(E))
+    {
+      anOwn = TopoDS::Edge(ex.Current());
+    }
+    if (anArc.IsNull() && ex.Current().IsSame(Ev))
+    {
+      anArc = TopoDS::Edge(ex.Current());
+    }
+  }
+  if (anOwn.IsNull() || anArc.IsNull())
+  {
+    return TopoDS_Edge();
+  }
+  Tr = anOwn.Orientation() == anArc.Orientation() ? CP.TransitionOnArc() : TopAbs::Reverse(CP.TransitionOnArc());
+  return anOwn;
+}
+
+void ChFi3d_OwnEdgesAtVertices(const occ::handle<ChFiDS_Stripe>& CorDat,
+                               TopOpeBRepDS_DataStructure&       DStr,
+                               const ChFiDS_Map&                 VEMap,
+                               const ChFiDS_Map&                 EFMap)
+{
+  if (CorDat.IsNull() || CorDat->SetOfSurfData().IsNull())
+  {
+    return;
+  }
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil = CorDat->SetOfSurfData()->Sequence();
+  for (int j = 1; j <= SeqFil.Length(); j++)
+  {
+    const occ::handle<ChFiDS_SurfData>& Fd = SeqFil(j);
+    if (Fd->IndexOfS1() <= 0 || Fd->IndexOfS2() <= 0 || Fd->IsOnCurve1() || Fd->IsOnCurve2())
+    {
+      continue;
+    }
+    const TopoDS_Shape& aS1 = DStr.Shape(Fd->IndexOfS1());
+    const TopoDS_Shape& aS2 = DStr.Shape(Fd->IndexOfS2());
+    if (aS1.ShapeType() != TopAbs_FACE || aS2.ShapeType() != TopAbs_FACE)
+    {
+      continue;
+    }
+    for (int aSide = 1; aSide <= 2; aSide++)
+    {
+      const TopoDS_Face& aF  = TopoDS::Face(aSide == 1 ? aS1 : aS2);
+      const TopoDS_Face& aFo = TopoDS::Face(aSide == 1 ? aS2 : aS1);
+      for (const bool aFirst : {true, false})
+      {
+        const ChFiDS_CommonPoint& aCP = Fd->Vertex(aFirst, aSide);
+        TopAbs_Orientation        aTr = TopAbs_FORWARD;
+        const TopoDS_Edge         E   = ChFi3d_OwnEdgeAtVertex(aCP, aF, aFo, VEMap, EFMap, aTr);
+        if (E.IsNull())
+        {
+          continue;
+        }
+        const int IE = DStr.AddShape(E);
+        const int IV = DStr.AddShape(aCP.Vertex());
+        QueryAddVertexInEdge(DStr.ChangeShapeInterferences(IE),
+                             IE,
+                             IV,
+                             BRep_Tool::Parameter(aCP.Vertex(), E),
+                             aTr);
+      }
+    }
+  }
+}
