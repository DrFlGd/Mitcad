+//=======================================================================
+// function : ChFi3d_SectionCut
+// purpose  : The cut of a walked blend (surface S, its contacts FiN on the
+//            side of N and FiO on the other) by the surface of face C,
+//            between the spine parameters a and b where the contact on N
+//            crosses N's tangent edge with C and comes back, the contact off
+//            N beyond C in between: on each section the point where it runs
+//            into C's surface, from the contact on N towards the other one;
+//            at a and b the contact itself (the blend touches C there). The
+//            curve and its p-curves on S and on C, parametrized by their
+//            chord length. (C's surface meets the blend tangentially at a
+//            and b, where an intersection of the two surfaces leaves gaps.)
+//            False where the contact lies off C's surface by more than
+//            maxOff (a deeper overflow than the stored designs show).
+//=======================================================================
+
+static bool ChFi3d_SectionCut(const occ::handle<Geom_Surface>& S,
+                              const ChFiDS_FaceInterference&   FiN,
+                              const ChFiDS_FaceInterference&   FiO,
+                              const TopoDS_Face&               C,
+                              const double                     a,
+                              const double                     b,
+                              const double                     tol3d,
+                              const double                     maxOff,
+                              occ::handle<Geom_Curve>&         Cc,
+                              occ::handle<Geom2d_Curve>&       Ps,
+                              occ::handle<Geom2d_Curve>&       Pc,
+                              double&                          tolreached)
+{
+  const occ::handle<Geom_Surface> SC = BRep_Tool::Surface(C);
+  if (S.IsNull() || SC.IsNull() || FiN.PCurveOnSurf().IsNull() || FiO.PCurveOnSurf().IsNull() || b <= a)
+  {
+    return false;
+  }
+  // (The signed distance of P from C's surface along its normal, and the
+  // parameters of the nearest point.)
+  // (Seeded with the point found before: the projections follow each
+  // other along the sections and the cut, and a global one on a B-spline
+  // surface is slow.)
+  ShapeAnalysis_Surface aSAS(SC);
+  bool                  aSeeded = false;
+  gp_Pnt2d              aSeed;
+  const auto signedDistance = [&](const gp_Pnt& P, double& u, double& v, double& d) {
+    const gp_Pnt2d uv = aSeeded ? aSAS.NextValueOfUV(aSeed, P, Precision::Confusion())
+                                : aSAS.ValueOfUV(P, Precision::Confusion());
+    aSeeded           = true;
+    aSeed             = uv;
+    u                 = uv.X();
+    v                 = uv.Y();
+    gp_Pnt Q;
+    gp_Vec Du, Dv;
+    SC->D1(u, v, Q, Du, Dv);
+    const gp_Vec Nv = Du.Crossed(Dv);
+    if (Nv.Magnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    d = gp_Vec(Q, P).Dot(Nv.Normalized());
+    return true;
+  };
+  // The sections, more densely near the ends, where the cut leaves the
+  // contact; the contact's side of C's surface where it lies farthest off.
+  const int            n = 96;
+  NCollection_Array1<double> aW(0, n), aD(0, n);
+  double               aFar = 0.;
+  for (int k = 0; k <= n; k++)
+  {
+    aW(k)             = a + (b - a) * 0.5 * (1. - std::cos(M_PI * k / n));
+    const gp_Pnt2d uN = FiN.PCurveOnSurf()->Value(aW(k));
+    double         cu = 0., cv = 0.;
+    if (!signedDistance(S->Value(uN.X(), uN.Y()), cu, cv, aD(k)))
+    {
+      return false;
+    }
+    if (std::abs(aD(k)) > std::abs(aFar))
+    {
+      aFar = aD(k);
+    }
+  }
+  if (std::abs(aFar) <= 10. * tol3d || std::abs(aFar) > maxOff)
+  {
+    return false;
+  }
+  occ::handle<NCollection_HArray1<gp_Pnt>>   aArr = new NCollection_HArray1<gp_Pnt>(1, n + 1);
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVs = new NCollection_HArray1<gp_Pnt2d>(1, n + 1);
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aUVc = new NCollection_HArray1<gp_Pnt2d>(1, n + 1);
+  occ::handle<NCollection_HArray1<double>>   aPar = new NCollection_HArray1<double>(1, n + 1);
+  double                                     u0 = 0., u1 = 0., v0 = 0., v1 = 0.;
+  BRepTools::UVBounds(C, u0, u1, v0, v1);
+  gp_Pnt2d aRef(0.5 * (u0 + u1), 0.5 * (v0 + v1));
+  for (int k = 0; k <= n; k++)
+  {
+    const gp_Pnt2d uN = FiN.PCurveOnSurf()->Value(aW(k)), uO = FiO.PCurveOnSurf()->Value(aW(k));
+    const auto     at = [&](const double l) { return gp_Pnt2d(uO.XY() + l * (uN.XY() - uO.XY())); };
+    // (Off C's side: from the contact on N towards the other one, the first
+    // point on C's surface; a contact on it within the tolerance is the
+    // cut's point, as at the ends.)
+    const auto outside = [&](const double l, bool& ok) {
+      double cu = 0., cv = 0., d = 0.;
+      const gp_Pnt2d uv = at(l);
+      ok                = signedDistance(S->Value(uv.X(), uv.Y()), cu, cv, d);
+      return (d > 0.) == (aFar > 0.);
+    };
+    double lam = 1.;
+    if (k > 0 && k < n && (aD(k) > 0.) == (aFar > 0.))
+    {
+      // (Steps growing from the contact: near the ends the cut leaves the
+      // contact like a square root.)
+      double hi = 1., lo = -1.;
+      bool   ok = true;
+      for (int i = 1; i <= 128 && lo < 0. && ok; i++)
+      {
+        const double l = 1. - (i / 128.) * (i / 128.);
+        (outside(l, ok) ? hi : lo) = l;
+      }
+      for (int it = 0; it < 60 && ok && lo >= 0.; it++)
+      {
+        const double m = 0.5 * (lo + hi);
+        (outside(m, ok) ? hi : lo) = m;
+      }
+      if (!ok || (lo < 0. && std::abs(aD(k)) > 10. * tol3d))
+      {
+        return false;
+      }
+      lam = lo < 0. ? 1. : 0.5 * (lo + hi);
+    }
+    const gp_Pnt2d uv = at(lam);
+    const gp_Pnt   P  = S->Value(uv.X(), uv.Y());
+    double         cu = 0., cv = 0., d = 0.;
+    if (!signedDistance(P, cu, cv, d))
+    {
+      return false;
+    }
+    // (In the periods of the point before, the first in the face's.)
+    if (SC->IsUPeriodic())
+    {
+      cu = ElCLib::InPeriod(cu, aRef.X() - 0.5 * SC->UPeriod(), aRef.X() + 0.5 * SC->UPeriod());
+    }
+    if (SC->IsVPeriodic())
+    {
+      cv = ElCLib::InPeriod(cv, aRef.Y() - 0.5 * SC->VPeriod(), aRef.Y() + 0.5 * SC->VPeriod());
+    }
+    aRef.SetCoord(cu, cv);
+    aArr->SetValue(k + 1, P);
+    aUVs->SetValue(k + 1, uv);
+    aUVc->SetValue(k + 1, gp_Pnt2d(cu, cv));
+    // (Chord length: the cut leaves the contact like a square root of the
+    // spine parameter.)
+    aPar->SetValue(k + 1, k == 0 ? 0. : aPar->Value(k) + P.Distance(aArr->Value(k)));
+    if (k > 0 && aPar->Value(k + 1) <= aPar->Value(k) + Precision::Confusion())
+    {
+      return false;
+    }
+  }
+  GeomAPI_Interpolate   anI3(aArr, aPar, false, Precision::Confusion());
+  Geom2dAPI_Interpolate anIs(aUVs, aPar, false, Precision::PConfusion());
+  Geom2dAPI_Interpolate anIc(aUVc, aPar, false, Precision::PConfusion());
+  anI3.Perform();
+  anIs.Perform();
+  anIc.Perform();
+  if (!anI3.IsDone() || !anIs.IsDone() || !anIc.IsDone())
+  {
+    return false;
+  }
+  Cc = anI3.Curve();
+  Ps = anIs.Curve();
+  Pc = anIc.Curve();
+  // (How far the curves keep apart between the points.)
+  tolreached = tol3d;
+  for (int k = 0; k < 4 * n; k++)
+  {
+    const double   t  = Cc->FirstParameter() + (Cc->LastParameter() - Cc->FirstParameter()) * (k + 0.5) / (4 * n);
+    const gp_Pnt   P  = Cc->Value(t);
+    const gp_Pnt2d us = Ps->Value(t), uc = Pc->Value(t);
+    tolreached        = std::max(tolreached, std::max(P.Distance(S->Value(us.X(), us.Y())),
+                                                      P.Distance(SC->Value(uc.X(), uc.Y()))));
+  }
+  return tolreached <= std::max(1.e-3, 100. * tol3d);
+}
