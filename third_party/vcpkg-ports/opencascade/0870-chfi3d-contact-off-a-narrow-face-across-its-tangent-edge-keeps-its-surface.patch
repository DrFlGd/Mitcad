+//=======================================================================
+// function : KeepFacesAcrossTangentEdges
+// purpose  : See the header. A run of pieces of St on side s: P_i on N and
+//            Fo, P_i+1 .. P_j-1 on C (the walk took C for N where its
+//            contact crossed their tangent edge), P_j on N and Fo again.
+//            The run is walked again from P_i's start to P_j's end on N's
+//            surface unbounded, and the three pieces on its surface replace
+//            it: up to where the contact leaves N, the cut by C (its side on
+//            C), and from where the contact comes back on.
+//=======================================================================
+
+void ChFi3d_Builder::KeepFacesAcrossTangentEdges(const occ::handle<ChFiDS_Stripe>& St)
+{
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(St->Spine());
+  if (fsp.IsNull() || !fsp->IsConstant() || St->SetOfSurfData().IsNull())
+  {
+    return;
+  }
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  const auto faceOf = [&](const occ::handle<ChFiDS_SurfData>& SD, const int s) {
+    if (SD->Index(s) <= 0 || SD->IsOnCurve(s) || DStr.Shape(SD->Index(s)).ShapeType() != TopAbs_FACE)
+    {
+      return TopoDS_Face();
+    }
+    return TopoDS::Face(DStr.Shape(SD->Index(s)));
+  };
+  // (Whether point CP of side s lies on an edge of N with C across which
+  // they are tangent.)
+  const auto tangentArc = [&](const ChFiDS_CommonPoint& CP, const TopoDS_Face& N, const TopoDS_Face& C) {
+    if (!CP.IsOnArc() || !myEFMap.Contains(CP.Arc()))
+    {
+      return false;
+    }
+    const TopoDS_Edge& E = TopoDS::Edge(CP.Arc());
+    if (!trimOtherFace(myEFMap, E, N).IsSame(C) || !hasEdge(N, E))
+    {
+      return false;
+    }
+    return BRep_Tool::Continuity(E, N, C) >= GeomAbs_G1 || ChFi3d::IsTangentFaces(E, N, C);
+  };
+  // (Whether piece D's blend touches face C tangentially along its side s,
+  // the ball rolling on C, rather than meeting it at a crease, cut by C:
+  // the two surfaces' normals at a quarter, the middle and three quarters
+  // of the side's line.)
+  const auto rollsOn = [&](const occ::handle<ChFiDS_SurfData>& D, const int s, const TopoDS_Face& C) {
+    const ChFiDS_FaceInterference&  FI = D->Interference(s);
+    const occ::handle<Geom_Surface> SC = BRep_Tool::Surface(C);
+    const occ::handle<Geom_Surface> SD = DStr.Surface(D->Surf()).Surface();
+    if (FI.PCurveOnSurf().IsNull() || FI.PCurveOnFace().IsNull() || SC.IsNull() || SD.IsNull())
+    {
+      return false;
+    }
+    for (int k = 1; k <= 3; k++)
+    {
+      const double   t  = FI.FirstParameter() + 0.25 * k * (FI.LastParameter() - FI.FirstParameter());
+      const gp_Pnt2d us = FI.PCurveOnSurf()->Value(t), uc = FI.PCurveOnFace()->Value(t);
+      gp_Pnt         P;
+      gp_Vec         Du, Dv, Cu, Cv;
+      SD->D1(us.X(), us.Y(), P, Du, Dv);
+      SC->D1(uc.X(), uc.Y(), P, Cu, Cv);
+      const gp_Vec nD = Du.Crossed(Dv), nC = Cu.Crossed(Cv);
+      if (nD.Magnitude() <= gp::Resolution() || nC.Magnitude() <= gp::Resolution())
+      {
+        return false;
+      }
+      const double anAngle = nD.Angle(nC);
+      if (std::min(anAngle, M_PI - anAngle) > 0.01)
+      {
+        return false;
+      }
+    }
+    return true;
+  };
+  for (int s = 1; s <= 2; s++)
+  {
+    for (int i = 1; i < St->SetOfSurfData()->Length(); i++)
+    {
+      const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = St->SetOfSurfData()->Sequence();
+      const occ::handle<ChFiDS_SurfData>&                       Di   = aSeq.Value(i);
+      const TopoDS_Face N = faceOf(Di, s), Fo = faceOf(Di, 3 - s);
+      const TopoDS_Face C = N.IsNull() ? TopoDS_Face() : faceOf(aSeq.Value(i + 1), s);
+      if (N.IsNull() || Fo.IsNull() || C.IsNull() || C.IsSame(N) || !tangentArc(Di->Vertex(false, s), N, C))
+      {
+        continue;
+      }
+      int j = i + 1;
+      while (j <= aSeq.Length() && faceOf(aSeq.Value(j), s).IsSame(C))
+      {
+        j++;
+      }
+      if (j > aSeq.Length() || !faceOf(aSeq.Value(j), s).IsSame(N) || !faceOf(aSeq.Value(j), 3 - s).IsSame(Fo)
+          || !tangentArc(aSeq.Value(j)->Vertex(true, s), N, C))
+      {
+        continue;
+      }
+      // (Only where the ball rolled on C between: pieces already cut by C,
+      // meeting it at a crease, are the blend this would build.)
+      bool aRolls = true;
+      for (int k = i + 1; k < j && aRolls; k++)
+      {
+        aRolls = rollsOn(aSeq.Value(k), s, C);
+      }
+      if (!aRolls)
+      {
+        continue;
+      }
+      bool aKept = false;
+      try
+      {
+        OCC_CATCH_SIGNALS
+        aKept = KeepFaceAcrossTangentEdge(St, i, j, s, N, Fo, C);
+      }
+      catch (Standard_Failure const&)
+      {
+        aKept = false;
+      }
+      if (aKept)
+      {
+        i += 2;
+      }
+    }
+  }
+}
