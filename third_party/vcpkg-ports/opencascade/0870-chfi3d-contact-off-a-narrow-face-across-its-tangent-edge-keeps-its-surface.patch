+//=======================================================================
+// function : KeepFaceAcrossTangentEdge
+// purpose  : One run of KeepFacesAcrossTangentEdges, pieces i to j of St.
+//=======================================================================
+
+bool ChFi3d_Builder::KeepFaceAcrossTangentEdge(const occ::handle<ChFiDS_Stripe>& St,
+                                               const int                         i,
+                                               const int                         j,
+                                               const int                         ons,
+                                               const TopoDS_Face&                N,
+                                               const TopoDS_Face&                Fo,
+                                               const TopoDS_Face&                C)
+{
+  TopOpeBRepDS_DataStructure&         DStr = myDS->ChangeDS();
+  const int                           opp  = 3 - ons;
+  const occ::handle<ChFiDS_Spine>     sp   = St->Spine();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = St->ChangeSetOfSurfData()->ChangeSequence();
+  const occ::handle<ChFiDS_SurfData> Di = aSeq.Value(i);
+  const occ::handle<ChFiDS_SurfData> Dj = aSeq.Value(j);
+  const double                       R  = occ::down_cast<ChFiDS_FilSpine>(sp)->Radius();
+  const double                       W0 = Di->FirstSpineParam(), W1 = Dj->LastSpineParam();
+  const double aTolMeet = std::max(std::max(100. * tolapp3d, 1.e-4), 1.e-3 * R);
+  if (W1 <= W0 + tolesp)
+  {
+    return false;
+  }
+  // The guide: a copy of the stripe's elementary spine holding the run (the
+  // walk sets the guide's parameters); where none holds it all (analytic
+  // pieces at its ends have none), the spine itself from W0 to W1,
+  // parametrized as the spine.
+  occ::handle<ChFiDS_ElSpine>       HG;
+  const occ::handle<ChFiDS_ElSpine> HG0 = sp->ElSpine(0.5 * (W0 + W1));
+  if (!HG0.IsNull() && HG0->FirstParameter() <= W0 + tolesp && HG0->LastParameter() >= W1 - tolesp)
+  {
+    HG = occ::down_cast<ChFiDS_ElSpine>(HG0->ShallowCopy());
+  }
+  else
+  {
+    const int nb = std::max(16, std::min(400, int((W1 - W0) / (0.25 * R)) + 1));
+    occ::handle<NCollection_HArray1<gp_Pnt>> aP = new NCollection_HArray1<gp_Pnt>(1, nb + 1);
+    occ::handle<NCollection_HArray1<double>> aT = new NCollection_HArray1<double>(1, nb + 1);
+    for (int k = 0; k <= nb; k++)
+    {
+      const double w = W0 + (W1 - W0) * k / nb;
+      aP->SetValue(k + 1, sp->Value(w));
+      aT->SetValue(k + 1, w);
+    }
+    GeomAPI_Interpolate anInterp(aP, aT, false, Precision::Confusion());
+    anInterp.Perform();
+    if (!anInterp.IsDone())
+    {
+      return false;
+    }
+    HG = new ChFiDS_ElSpine();
+    HG->SetCurve(anInterp.Curve());
+    HG->FirstParameter(W0);
+    HG->LastParameter(W1);
+  }
+  if (HG.IsNull())
+  {
+    return false;
+  }
+
+  // The walk, N's surface unbounded.
+  const occ::handle<Geom_Surface> SN = BRep_Tool::Surface(N);
+  if (SN.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face NF = BRepLib_MakeFace(SN, Precision::Confusion());
+  if (NF.IsNull())
+  {
+    return false;
+  }
+  NF.Orientation(N.Orientation());
+  occ::handle<BRepAdaptor_Surface>      HSN = new BRepAdaptor_Surface(NF);
+  occ::handle<BRepAdaptor_Surface>      HSO = new BRepAdaptor_Surface(Fo);
+  occ::handle<BRepAdaptor_Surface>      HS1 = ons == 1 ? HSN : HSO;
+  occ::handle<BRepAdaptor_Surface>      HS2 = ons == 1 ? HSO : HSN;
+  occ::handle<BRepTopAdaptor_TopolTool> It1 = new BRepTopAdaptor_TopolTool(HS1);
+  occ::handle<BRepTopAdaptor_TopolTool> It2 = new BRepTopAdaptor_TopolTool(HS2);
+  TopAbs_Orientation                    Or1 = HS1->Face().Orientation();
+  TopAbs_Orientation                    Or2 = HS2->Face().Orientation();
+  const int Choix = ChFi3d::NextSide(Or1, Or2, St->OrientationOnFace1(), St->OrientationOnFace2(), St->Choix());
+  math_Vector Soldep(1, 4);
+  {
+    const ChFiDS_FaceInterference& F1  = Di->Interference(1);
+    const ChFiDS_FaceInterference& F2  = Di->Interference(2);
+    const gp_Pnt2d                 uv1 = F1.PCurveOnFace()->Value(F1.FirstParameter());
+    const gp_Pnt2d                 uv2 = F2.PCurveOnFace()->Value(F2.FirstParameter());
+    Soldep(1)                          = uv1.X();
+    Soldep(2)                          = uv1.Y();
+    Soldep(3)                          = uv2.X();
+    Soldep(4)                          = uv2.Y();
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>> SeqSD;
+  SeqSD.Append(new ChFiDS_SurfData());
+  double       First = W0, Last = W1;
+  int          intf = 0, intl = 0;
+  const int    nbed    = sp->NbEdges();
+  const double MaxStep = 0.05 * (sp->LastParameter(nbed) - sp->FirstParameter(1)) / nbed;
+  const double Fleche  = (sp->LastParameter(nbed) - sp->FirstParameter(1)) * fleche;
+  bool         walked  = false;
+  // (The walk's failure is not the builder's.)
+  const bool               aDone        = done;
+  const ChFiDS_ErrorStatus anErrorState = sp->ErrorStatus();
+  try
+  {
+    OCC_CATCH_SIGNALS
+    walked = PerformSurf(SeqSD, HG, sp, Choix, HS1, It1, HS2, It2, MaxStep, Fleche, tolesp, First, Last, false,
+                         false, true, false, false, Soldep, intf, intl);
+  }
+  catch (Standard_Failure const&)
+  {
+    walked = false;
+  }
+  done = aDone;
+  sp->SetErrorStatus(anErrorState);
+  if (!walked || SeqSD.Length() != 1)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> X = SeqSD.First();
+  X->ChangeIndexOfS1(DStr.AddShape(ons == 1 ? N : Fo));
+  X->ChangeIndexOfS2(DStr.AddShape(ons == 1 ? Fo : N));
+  const ChFiDS_FaceInterference& FiN = X->Interference(ons);
+  const ChFiDS_FaceInterference& FiO = X->Interference(opp);
+  if (FiN.PCurveOnFace().IsNull() || FiN.PCurveOnSurf().IsNull() || FiO.PCurveOnSurf().IsNull()
+      || FiN.LineIndex() <= 0 || FiO.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const double Xlo = X->FirstSpineParam(), Xhi = X->LastSpineParam();
+  if (std::abs(Xlo - W0) > 10. * tolesp || std::abs(Xhi - W1) > 10. * tolesp)
+  {
+    return false;
+  }
+  // Its ends: the sections of Di's start and Dj's end.
+  for (int s = 1; s <= 2; s++)
+  {
+    const ChFiDS_FaceInterference& FI = X->Interference(s);
+    const occ::handle<Geom_Curve>& L  = DStr.Curve(FI.LineIndex()).Curve();
+    if (L->Value(Xlo).Distance(Di->Vertex(true, s).Point()) > aTolMeet
+        || L->Value(Xhi).Distance(Dj->Vertex(false, s).Point()) > aTolMeet)
+    {
+      return false;
+    }
+  }
+  const occ::handle<Geom_Curve>& CN = DStr.Curve(FiN.LineIndex()).Curve();
+  // Where the contact on N leaves N and comes back: once, inside the run.
+  BRepTopAdaptor_FClass2d aClass(N, Precision::PConfusion());
+  const auto stateAt = [&](const double t) { return aClass.Perform(FiN.PCurveOnFace()->Value(t)); };
+  const int  nbs     = 2000;
+  double     tIn0 = Xlo, tOut0 = Xlo, tOut1 = Xlo, tIn1 = Xlo;
+  int        nbOut = 0;
+  bool       out   = false;
+  for (int k = 1; k < nbs; k++)
+  {
+    const double       t  = Xlo + (Xhi - Xlo) * k / nbs;
+    const TopAbs_State st = stateAt(t);
+    if (st == TopAbs_OUT)
+    {
+      if (!out)
+      {
+        tOut0 = t;
+        nbOut++;
+      }
+      out   = true;
+      tOut1 = t;
+    }
+    else if (st == TopAbs_IN)
+    {
+      if (out)
+      {
+        tIn1 = t;
+      }
+      else if (nbOut == 0)
+      {
+        tIn0 = t;
+      }
+      out = false;
+    }
+  }
+  if (nbOut != 1 || out || tIn1 <= tOut1)
+  {
+    return false;
+  }
+  for (int it = 0; it < 60; it++)
+  {
+    const double m = 0.5 * (tIn0 + tOut0);
+    (stateAt(m) == TopAbs_OUT ? tOut0 : tIn0) = m;
+    const double m2 = 0.5 * (tOut1 + tIn1);
+    (stateAt(m2) == TopAbs_OUT ? tOut1 : tIn1) = m2;
+  }
+  const double a = 0.5 * (tIn0 + tOut0);
+  const double b = 0.5 * (tOut1 + tIn1);
+  // The edges of N with C crossed there.
+  const double aTolBack = std::max(100. * tolapp3d, 1.e-4);
+  TopoDS_Face  CF       = C;
+  CF.Orientation(TopAbs_FORWARD);
+  const auto crossing = [&](const double t, TopoDS_Edge& Ec, double& wc, gp_Pnt& Pc) {
+    const gp_Pnt P    = CN->Value(t);
+    double       best = RealLast();
+    for (TopExp_Explorer ex(CF, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+      if (BRep_Tool::Degenerated(E) || !trimOtherFace(myEFMap, E, C).IsSame(N))
+      {
+        continue;
+      }
+      double                        f = 0., l = 0.;
+      const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(E, f, l);
+      if (aC.IsNull())
+      {
+        continue;
+      }
+      GeomAPI_ProjectPointOnCurve aPr(P, aC, f, l);
+      if (aPr.NbPoints() > 0 && aPr.LowerDistance() < best)
+      {
+        best = aPr.LowerDistance();
+        wc   = aPr.LowerDistanceParameter();
+        Ec   = E;
+        Pc   = aC->Value(wc);
+      }
+    }
+    return !Ec.IsNull() && best <= aTolBack;
+  };
+  TopoDS_Edge Ea, Eb;
+  double      wa = 0., wb = 0.;
+  gp_Pnt      Pa, Pb;
+  if (!crossing(a, Ea, wa, Pa) || !crossing(b, Eb, wb, Pb))
+  {
+    return false;
+  }
+  // The cut of the blend by C, from where the contact leaves N to where it
+  // comes back.
+  const occ::handle<Geom_Surface>& SX = DStr.Surface(X->Surf()).Surface();
+  occ::handle<Geom_Curve>          Cc;
+  occ::handle<Geom2d_Curve>        Ps, Pc;
+  double                           tolCut = tolapp3d;
+  bool                             aCut   = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    aCut = ChFi3d_SectionCut(SX, FiN, FiO, C, a, b, tolapp3d, 0.1 * R, Cc, Ps, Pc, tolCut);
+  }
+  catch (Standard_Failure const&)
+  {
+    aCut = false;
+  }
+  if (!aCut)
+  {
+    return false;
+  }
+  const TopAbs_Orientation aTraOnC0 = TopAbs::Compose(N.Orientation(), C.Orientation());
+  const auto               arcPoint = [&](const double t, const TopoDS_Edge& E, const double w, const gp_Pnt& P,
+                                const bool atStart) {
+    // (atStart: the cut piece starts there, the contact leaving N.)
+    const TopAbs_Orientation aTr =
+      TopAbs::Compose(TopAbs::Compose(FiN.Transition(), aTraOnC0), trimEdgeInFace(E, CF).Orientation());
+    ChFiDS_CommonPoint CP;
+    gp_Pnt             Pl;
+    gp_Vec             V;
+    CN->D1(t, Pl, V);
+    CP.SetPoint(P);
+    CP.SetArc(tolapp3d, E, w, atStart ? TopAbs::Reverse(aTr) : aTr);
+    CP.SetVector(V);
+    CP.SetParameter(t);
+    return CP;
+  };
+  const ChFiDS_CommonPoint aCPa = arcPoint(a, Ea, wa, Pa, true);
+  const ChFiDS_CommonPoint aCPb = arcPoint(b, Eb, wb, Pb, false);
+
+  // The three pieces on X's surface.
+  const auto piece = [&](const double w1p, const double w2p, const bool copyLines) {
+    occ::handle<ChFiDS_SurfData> G = new ChFiDS_SurfData();
+    G->Copy(X);
+    for (int s = 1; s <= 2; s++)
+    {
+      ChFiDS_FaceInterference& FI = G->ChangeInterference(s);
+      if (copyLines)
+      {
+        FI.SetLineIndex(copyLine(DStr, FI.LineIndex()));
+      }
+      FI.SetFirstParameter(w1p);
+      FI.SetLastParameter(w2p);
+    }
+    G->FirstSpineParam(w1p);
+    G->LastSpineParam(w2p);
+    return G;
+  };
+  occ::handle<ChFiDS_SurfData> Q1 = piece(Xlo, a, false);
+  occ::handle<ChFiDS_SurfData> Q2 = piece(a, b, true);
+  occ::handle<ChFiDS_SurfData> Q3 = piece(b, Xhi, true);
+  // The ends: Di's and Dj's points, shared with the pieces beside the run.
+  for (int s = 1; s <= 2; s++)
+  {
+    // (At the parameters of the walked lines.)
+    Q1->ChangeVertex(true, s) = Di->Vertex(true, s);
+    Q1->ChangeVertex(true, s).SetParameter(Xlo);
+    Q3->ChangeVertex(false, s) = Dj->Vertex(false, s);
+    Q3->ChangeVertex(false, s).SetParameter(Xhi);
+  }
+  Q1->ChangeVertex(false, ons) = aCPa;
+  Q1->ChangeVertex(false, opp) = linePoint(DStr, Q1->Interference(opp), a);
+  Q2->ChangeVertex(true, ons)  = aCPa;
+  Q2->ChangeVertex(true, opp)  = Q1->Vertex(false, opp);
+  Q2->ChangeVertex(false, ons) = aCPb;
+  Q2->ChangeVertex(false, opp) = linePoint(DStr, Q2->Interference(opp), b);
+  Q3->ChangeVertex(true, ons)  = aCPb;
+  Q3->ChangeVertex(true, opp)  = Q2->Vertex(false, opp);
+  // The cut piece's side on C.
+  {
+    const TopAbs_Orientation aTraC = TopAbs::Compose(FiN.Transition(), aTraOnC0);
+    ChFiDS_FaceInterference& GI    = Q2->ChangeInterference(ons);
+    GI.SetInterference(DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tolCut)), aTraC, Pc, Ps);
+    GI.SetFirstParameter(Cc->FirstParameter());
+    GI.SetLastParameter(Cc->LastParameter());
+    if (ons == 1)
+    {
+      Q2->ChangeIndexOfS1(DStr.AddShape(C));
+    }
+    else
+    {
+      Q2->ChangeIndexOfS2(DStr.AddShape(C));
+    }
+  }
+  // The faces the spine's edges generate: the walked surface for the
+  // pieces' own.
+  NCollection_Map<int> aGone;
+  for (int k = i; k <= j; k++)
+  {
+    aGone.Add(aSeq.Value(k)->Surf());
+  }
+  for (NCollection_DataMap<TopoDS_Shape, NCollection_List<int>, TopTools_ShapeMapHasher>::Iterator itM(myEVIMap);
+       itM.More(); itM.Next())
+  {
+    NCollection_List<int>& aList = itM.ChangeValue();
+    bool                   aHad  = false, aHas = false;
+    for (NCollection_List<int>::Iterator itL(aList); itL.More();)
+    {
+      aHas = aHas || itL.Value() == X->Surf();
+      if (aGone.Contains(itL.Value()))
+      {
+        aHad = true;
+        aList.Remove(itL);
+      }
+      else
+      {
+        itL.Next();
+      }
+    }
+    if (aHad && !aHas)
+    {
+      aList.Append(X->Surf());
+    }
+  }
+  for (int k = j; k >= i; k--)
+  {
+    aSeq.Remove(k);
+  }
+  if (i > aSeq.Length())
+  {
+    aSeq.Append(Q1);
+    aSeq.Append(Q2);
+    aSeq.Append(Q3);
+  }
+  else
+  {
+    aSeq.InsertBefore(i, Q3);
+    aSeq.InsertBefore(i, Q2);
+    aSeq.InsertBefore(i, Q1);
+  }
+  return true;
+}
