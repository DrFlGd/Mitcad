+// Whether no ball of radius R inside the solid touches face F at uv: the
+// face is convex there and bends towards the solid more sharply than the
+// ball (a strip left of an earlier rounding of a smaller radius), so that
+// near uv the face lies inside any such ball.
+static bool ballTouchesNoPointOf(const TopoDS_Face& F, const gp_Pnt2d& uv, const double R)
+{
+  if (R <= Precision::Confusion())
+  {
+    return false;
+  }
+  BRepAdaptor_Surface AF(F, false);
+  BRepLProp_SLProps   aProp(AF, uv.X(), uv.Y(), 2, Precision::Confusion());
+  if (!aProp.IsNormalDefined() || !aProp.IsCurvatureDefined())
+  {
+    return false;
+  }
+  // (Normal curvatures are positive where the surface bends towards its
+  // normal; the face's outward normal is the surface's unless the face is
+  // reversed.)
+  const double s       = F.Orientation() == TopAbs_REVERSED ? 1. : -1.;
+  const double towards = std::max(s * aProp.MaxCurvature(), s * aProp.MinCurvature());
+  return towards > (1. + 1.e-3) / R;
+}
