+//=======================================================================
+// function : ChFi3d_SliverFaceAtEnd
+// purpose  : A rounding's end at a vertex Vtx of three faces: the blend's
+//            two faces and a sliver Fs smaller than Size (a step's end
+//            face, a triangle 0.16 by 0.02 under a rounding of 0.5). The
+//            contact on one face (side IFadArc) left it across an edge
+//            Arcpiv not at Vtx, whose face beyond, Fv, closes the sliver:
+//            Fs's edges are its edge with each blend face at Vtx and edges
+//            with Fv, its edge with the blend face of side IFadArc running
+//            to a vertex of Arcpiv and its edge with the opposite face to a
+//            vertex Vprol of an edge Arcprol of Fv and the opposite face.
+//            Fs lies in the corner the blend fills or removes: the end is
+//            Fv's OnSame end across it, Arcprol prolonged from Vprol and
+//            Fs consumed (an earlier rounding round the wall's end whose
+//            contacts with the wall and the floor the sliver joins).
+//=======================================================================
+
+static bool ChFi3d_SliverFaceAtEnd(const TopOpeBRepDS_DataStructure&   DStr,
+                                   const occ::handle<ChFiDS_SurfData>& Fd,
+                                   const bool                          isfirst,
+                                   const TopoDS_Vertex&                Vtx,
+                                   const ChFiDS_Map&                   VFMap,
+                                   const ChFiDS_Map&                   EFMap,
+                                   const double                        Size,
+                                   int&                                IFadArc,
+                                   TopoDS_Edge&                        Arcpiv,
+                                   TopoDS_Face&                        Fv,
+                                   TopoDS_Face&                        Fs,
+                                   TopoDS_Edge&                        Arcprol,
+                                   TopoDS_Vertex&                      Vprol)
+{
+  const auto holds = [](const TopoDS_Shape& S, const TopoDS_Shape& V) {
+    for (TopExp_Explorer exV(S, TopAbs_VERTEX); exV.More(); exV.Next())
+    {
+      if (exV.Current().IsSame(V))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  const auto hasEdge = [](const TopoDS_Shape& F, const TopoDS_Shape& E) {
+    for (TopExp_Explorer exE(F, TopAbs_EDGE); exE.More(); exE.Next())
+    {
+      if (exE.Current().IsSame(E))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  const auto otherFace = [&](const TopoDS_Edge& E, const TopoDS_Shape& F) {
+    TopoDS_Face aF;
+    if (!EFMap.Contains(E))
+    {
+      return aF;
+    }
+    for (const TopoDS_Shape& aS : EFMap.FindFromKey(E))
+    {
+      if (!aS.IsSame(F))
+      {
+        aF = TopoDS::Face(aS);
+        break;
+      }
+    }
+    return aF;
+  };
+  if (!VFMap.Contains(Vtx) || Fd->IndexOfS1() == 0 || Fd->IndexOfS2() == 0)
+  {
+    return false;
+  }
+  for (int j = 1; j <= 2; j++)
+  {
+    const ChFiDS_CommonPoint& CVj = Fd->Vertex(isfirst, j);
+    if (!CVj.IsOnArc())
+    {
+      continue;
+    }
+    const TopoDS_Face aFad = TopoDS::Face(DStr.Shape(Fd->Index(j)));
+    const TopoDS_Face aFop = TopoDS::Face(DStr.Shape(Fd->Index(3 - j)));
+    // (At a vertex, any edge of Fad there may be the one left across.)
+    NCollection_List<TopoDS_Shape> aArcs;
+    if (CVj.IsVertex())
+    {
+      for (TopExp_Explorer exE(aFad, TopAbs_EDGE); exE.More(); exE.Next())
+      {
+        if (!BRep_Tool::Degenerated(TopoDS::Edge(exE.Current())) && holds(exE.Current(), CVj.Vertex()))
+        {
+          aArcs.Append(exE.Current());
+        }
+      }
+    }
+    else
+    {
+      aArcs.Append(CVj.Arc());
+    }
+    for (const TopoDS_Shape& anArc : aArcs)
+    {
+      const TopoDS_Edge aPiv = TopoDS::Edge(anArc);
+      if (holds(aPiv, Vtx))
+      {
+        continue;
+      }
+      const TopoDS_Face aFv = otherFace(aPiv, aFad);
+      if (aFv.IsNull() || aFv.IsSame(aFop))
+      {
+        continue;
+      }
+      // The faces at the vertex: the blend's two and one other.
+      TopoDS_Face aFs;
+      int         nbOther = 0;
+      for (const TopoDS_Shape& aS : VFMap.FindFromKey(Vtx))
+      {
+        if (aS.IsSame(aFad) || aS.IsSame(aFop) || aS.IsSame(aFs))
+        {
+          continue;
+        }
+        aFs = TopoDS::Face(aS);
+        nbOther++;
+      }
+      if (nbOther != 1 || aFs.IsSame(aFv))
+      {
+        continue;
+      }
+      // Smaller than Size: its vertices within Size of each other.
+      NCollection_Sequence<gp_Pnt> aPts;
+      for (TopExp_Explorer exV(aFs, TopAbs_VERTEX); exV.More(); exV.Next())
+      {
+        aPts.Append(BRep_Tool::Pnt(TopoDS::Vertex(exV.Current())));
+      }
+      bool isSmall = aPts.Length() >= 3;
+      for (int a = 1; a <= aPts.Length() && isSmall; a++)
+      {
+        for (int b = a + 1; b <= aPts.Length() && isSmall; b++)
+        {
+          isSmall = aPts(a).Distance(aPts(b)) < Size;
+        }
+      }
+      if (!isSmall)
+      {
+        continue;
+      }
+      // Its edges: one with each blend face at Vtx, the others with Fv.
+      TopoDS_Edge aEad, aEop;
+      bool        isClosedByFv = true;
+      for (TopExp_Explorer exE(aFs, TopAbs_EDGE); exE.More() && isClosedByFv; exE.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(exE.Current());
+        if (BRep_Tool::Degenerated(E))
+        {
+          continue;
+        }
+        const TopoDS_Face aF = otherFace(E, aFs);
+        if (holds(E, Vtx))
+        {
+          if (aF.IsSame(aFad) && aEad.IsNull())
+          {
+            aEad = E;
+          }
+          else if (aF.IsSame(aFop) && aEop.IsNull())
+          {
+            aEop = E;
+          }
+          else
+          {
+            isClosedByFv = false;
+          }
+        }
+        else
+        {
+          isClosedByFv = aF.IsSame(aFv);
+        }
+      }
+      if (!isClosedByFv || aEad.IsNull() || aEop.IsNull())
+      {
+        continue;
+      }
+      // Its edge with Fad runs to a vertex of Arcpiv, its edge with Fop to a
+      // vertex of an edge of Fv and Fop.
+      TopoDS_Vertex aVad, aVop;
+      for (TopExp_Explorer exV(aEad, TopAbs_VERTEX); exV.More(); exV.Next())
+      {
+        if (!exV.Current().IsSame(Vtx))
+        {
+          aVad = TopoDS::Vertex(exV.Current());
+        }
+      }
+      for (TopExp_Explorer exV(aEop, TopAbs_VERTEX); exV.More(); exV.Next())
+      {
+        if (!exV.Current().IsSame(Vtx))
+        {
+          aVop = TopoDS::Vertex(exV.Current());
+        }
+      }
+      if (aVad.IsNull() || aVop.IsNull() || !holds(aPiv, aVad))
+      {
+        continue;
+      }
+      TopoDS_Edge aProl;
+      for (TopExp_Explorer exE(aFop, TopAbs_EDGE); exE.More() && aProl.IsNull(); exE.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(exE.Current());
+        if (!E.IsSame(aEop) && holds(E, aVop) && hasEdge(aFv, E))
+        {
+          aProl = E;
+        }
+      }
+      if (aProl.IsNull())
+      {
+        continue;
+      }
+      IFadArc = j;
+      Arcpiv  = aPiv;
+      Fv      = aFv;
+      Fs      = aFs;
+      Arcprol = aProl;
+      Vprol   = aVop;
+      return true;
+    }
+  }
+  return false;
+}
