+//=================================================================================================
+
+bool ChFi3d_ContactOntoTangentFaceAtEnd(const occ::handle<ChFiDS_SurfData>& SD,
+                                        const bool                          isFirst,
+                                        const TopoDS_Vertex&                V,
+                                        const TopOpeBRepDS_DataStructure&   DStr,
+                                        const ChFiDS_Map&                   EFMap,
+                                        const double                        Reach,
+                                        const double                        Width)
+{
+  if (SD.IsNull() || V.IsNull() || SD->Index(1) <= 0 || SD->Index(2) <= 0)
+  {
+    return false;
+  }
+  const gp_Pnt P  = BRep_Tool::Pnt(V);
+  const gp_Pnt P1 = SD->Vertex(isFirst, 1).Point();
+  const gp_Pnt P2 = SD->Vertex(isFirst, 2).Point();
+  if (P1.Distance(P) > Reach || P2.Distance(P) > Reach || P1.Distance(P2) > Width)
+  {
+    return false;
+  }
+  const auto hasV = [&V](const TopoDS_Shape& S) {
+    for (TopExp_Explorer ex(S, TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(V))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  for (int k = 1; k <= 2; k++)
+  {
+    const ChFiDS_CommonPoint& CP = SD->Vertex(isFirst, k);
+    if (!CP.IsOnArc() || !EFMap.Contains(CP.Arc()) || !hasV(CP.Arc()))
+    {
+      continue;
+    }
+    const TopoDS_Shape& aSF  = DStr.Shape(SD->Index(k));
+    const TopoDS_Shape& aSFo = DStr.Shape(SD->Index(3 - k));
+    if (aSF.ShapeType() != TopAbs_FACE || aSFo.ShapeType() != TopAbs_FACE)
+    {
+      continue;
+    }
+    const TopoDS_Face& F  = TopoDS::Face(aSF);
+    const TopoDS_Face& Fo = TopoDS::Face(aSFo);
+    const TopoDS_Edge& E  = CP.Arc();
+    for (NCollection_List<TopoDS_Shape>::Iterator itn(EFMap(E)); itn.More(); itn.Next())
+    {
+      const TopoDS_Face& Fn = TopoDS::Face(itn.Value());
+      if (Fn.IsSame(F) || Fn.IsSame(Fo) || !ChFi3d::IsTangentFaces(E, F, Fn))
+      {
+        continue;
+      }
+      // Fn tangent to Fo along an edge from V.
+      for (TopExp_Explorer ex(Fn, TopAbs_EDGE); ex.More(); ex.Next())
+      {
+        const TopoDS_Edge& Et = TopoDS::Edge(ex.Current());
+        if (Et.IsSame(E) || BRep_Tool::Degenerated(Et) || !EFMap.Contains(Et) || !hasV(Et))
+        {
+          continue;
+        }
+        for (NCollection_List<TopoDS_Shape>::Iterator ito(EFMap(Et)); ito.More(); ito.Next())
+        {
+          if (ito.Value().IsSame(Fo) && ChFi3d::IsTangentFaces(Et, Fn, Fo))
+          {
+            return true;
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
