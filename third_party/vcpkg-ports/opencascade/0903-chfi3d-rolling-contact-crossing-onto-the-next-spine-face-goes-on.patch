+// Whether the contact of SD's end (its start with isFirst) on side ons left
+// its face across an arc that does not run to the spine's end vertex Bout,
+// onto faces that all border edges of the spine: the faces the blend goes
+// on along (a contact crossing onto the face of the spine's next edge), not
+// a face at the end, though they hold Bout.
+static bool ChFi3d_ArcOntoSpineFaces(const occ::handle<ChFiDS_SurfData>& SD,
+                                     const bool                          isFirst,
+                                     const int                           ons,
+                                     const TopoDS_Vertex&                Bout,
+                                     const occ::handle<ChFiDS_Spine>&    Spine,
+                                     const TopOpeBRepDS_DataStructure&   DStr,
+                                     const ChFiDS_Map&                   EFMap)
+{
+  if (SD.IsNull() || Bout.IsNull() || SD->Index(ons) <= 0)
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint& CP = SD->Vertex(isFirst, ons);
+  if (!CP.IsOnArc() || CP.IsVertex() || !EFMap.Contains(CP.Arc()))
+  {
+    return false;
+  }
+  for (TopExp_Explorer ex(CP.Arc(), TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(Bout))
+    {
+      return false;
+    }
+  }
+  const TopoDS_Shape& F      = DStr.Shape(SD->Index(ons));
+  bool                anyFace = false;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(CP.Arc())); it.More(); it.Next())
+  {
+    if (it.Value().IsSame(F))
+    {
+      continue;
+    }
+    if (!faceAlongSpine(Spine, TopoDS::Face(it.Value()), EFMap))
+    {
+      return false;
+    }
+    anyFace = true;
+  }
+  return anyFace;
+}
