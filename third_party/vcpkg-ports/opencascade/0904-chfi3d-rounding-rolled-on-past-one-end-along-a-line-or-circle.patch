+// Whether the blend of SD, rolling on side s on an edge Er of its face B,
+// ends (at its start with isFirst) with that contact at a vertex A of Er
+// other than the spine's end vertex Bout, where a face W, neither B, the
+// face across Er from B nor the face of the other side, holds both A and
+// Bout: the face at the end, which cuts the blend rolled on along Er's line
+// past A (RolledOnProlongedEdge). The walk past A, rolling on W's edge with
+// B, fails there.
+static bool ChFi3d_RolledToFaceAtEnd(const TopOpeBRepDS_DataStructure&   DStr,
+                                     const ChFiDS_Map&                   VFMap,
+                                     const ChFiDS_Map&                   EFMap,
+                                     const occ::handle<ChFiDS_SurfData>& SD,
+                                     const bool                          isFirst,
+                                     const TopoDS_Vertex&                Bout,
+                                     const double                        Tol)
+{
+  if (SD.IsNull() || Bout.IsNull() || !VFMap.Contains(Bout))
+  {
+    return false;
+  }
+  for (int s = 1; s <= 2; s++)
+  {
+    if (!SD->IsOnCurve(s) || SD->IndexOfC(s) <= 0 || SD->Index(1) <= 0 || SD->Index(2) <= 0)
+    {
+      continue;
+    }
+    const TopoDS_Edge Er = TopoDS::Edge(DStr.Shape(SD->IndexOfC(s)));
+    if (!EFMap.Contains(Er))
+    {
+      continue;
+    }
+    const gp_Pnt  P = SD->Vertex(isFirst, s).Point();
+    TopoDS_Vertex A;
+    for (TopExp_Explorer ex(Er, TopAbs_VERTEX); ex.More() && A.IsNull(); ex.Next())
+    {
+      if (BRep_Tool::Pnt(TopoDS::Vertex(ex.Current())).Distance(P) <= Tol)
+      {
+        A = TopoDS::Vertex(ex.Current());
+      }
+    }
+    if (A.IsNull() || A.IsSame(Bout) || !VFMap.Contains(A))
+    {
+      continue;
+    }
+    const TopoDS_Shape& B = DStr.Shape(SD->Index(s));
+    const TopoDS_Shape& N = DStr.Shape(SD->Index(3 - s));
+    const auto          excluded = [&](const TopoDS_Shape& F) {
+      if (F.IsSame(B) || F.IsSame(N))
+      {
+        return true;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Er)); it.More(); it.Next())
+      {
+        if (it.Value().IsSame(F))
+        {
+          return true;
+        }
+      }
+      return false;
+    };
+    for (NCollection_List<TopoDS_Shape>::Iterator itV(VFMap(Bout)); itV.More(); itV.Next())
+    {
+      if (excluded(itV.Value()))
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator itA(VFMap(A)); itA.More(); itA.Next())
+      {
+        if (itA.Value().IsSame(itV.Value()))
+        {
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
