+//=======================================================================
+// function : RolledOnProlongedEdgeAtEnd
+// purpose  : RolledOnProlongedEdge at one end of the stripe: its piece P
+//            at that end (isFirst) rolls on side opp on a straight edge Er
+//            of its face B up to Er's vertex A, which lies on a face W that
+//            holds the spine's end vertex V (the walk past A failed,
+//            ChFi3d_RolledToFaceAtEnd). P is walked again from its other
+//            end, rolling on Er's line past A as the edge of a strip of B's
+//            surface, the other side's face N's surface grown, up to the
+//            guide's end; the corner at V cuts it by W from A
+//            (ChFi3d_RolledPastEdgeVertex).
+//=======================================================================
+
+bool ChFi3d_Builder::RolledOnProlongedEdgeAtEnd(const occ::handle<ChFiDS_Stripe>& Stripe, const bool isFirst)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (Spine.IsNull() || Spine->IsPeriodic() || Stripe->SetOfSurfData().IsNull()
+      || Stripe->SetOfSurfData()->IsEmpty() || Spine->ChangeElSpines().IsEmpty())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (fsp.IsNull() || !fsp->IsConstant())
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure&                         DStr = myDS->ChangeDS();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  const int                                           iP   = isFirst ? 1 : aSeq.Length();
+  const occ::handle<ChFiDS_SurfData>                  P    = aSeq.Value(iP);
+  const TopoDS_Vertex                                 V    = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (P->Index(1) <= 0 || P->Index(2) <= 0 || V.IsNull()
+      || !ChFi3d_RolledToFaceAtEnd(DStr, myVFMap, myEFMap, P, isFirst, V, 10. * tolesp))
+  {
+    return false;
+  }
+  // (P ending at the spine's end, its section there in W, needs no rolling
+  // on: the corner at V takes that end as it is.)
+  {
+    const double aWEnd = isFirst ? Spine->FirstParameter(1) : Spine->LastParameter(Spine->NbEdges());
+    const double aWP   = isFirst ? P->FirstSpineParam() : P->LastSpineParam();
+    if (std::abs(aWP - aWEnd) <= 10. * tolesp)
+    {
+      return false;
+    }
+  }
+  int opp = 0;
+  for (int s = 1; s <= 2 && opp == 0; s++)
+  {
+    if (P->IsOnCurve(s) && !P->IsOnCurve(3 - s) && P->IndexOfC(s) > 0)
+    {
+      opp = s;
+    }
+  }
+  if (opp == 0)
+  {
+    return false;
+  }
+  const int         ons = 3 - opp;
+  const TopoDS_Edge Er  = TopoDS::Edge(DStr.Shape(P->IndexOfC(opp)));
+  const TopoDS_Face B   = TopoDS::Face(DStr.Shape(P->Index(opp)));
+  const TopoDS_Face N   = TopoDS::Face(DStr.Shape(P->Index(ons)));
+  if (N.IsSame(B) || !myEFMap.Contains(Er))
+  {
+    return false;
+  }
+  // Er's line.
+  double                  ef = 0., el = 0.;
+  occ::handle<Geom_Curve> CEr = BRep_Tool::Curve(Er, ef, el);
+  if (CEr.IsNull())
+  {
+    return false;
+  }
+  while (CEr->IsKind(STANDARD_TYPE(Geom_TrimmedCurve)))
+  {
+    CEr = occ::down_cast<Geom_TrimmedCurve>(CEr)->BasisCurve();
+  }
+  // The guide of P's end.
+  NCollection_List<occ::handle<ChFiDS_ElSpine>>::Iterator anItGuide(Spine->ChangeElSpines());
+  if (!isFirst)
+  {
+    for (int k = 1; k < Spine->ChangeElSpines().Extent(); k++)
+    {
+      anItGuide.Next();
+    }
+  }
+  const occ::handle<ChFiDS_ElSpine>& HGuide = anItGuide.Value();
+  // The start: P's section at its other end.
+  const double WS = isFirst ? P->LastSpineParam() : P->FirstSpineParam();
+  if (HGuide.IsNull() || WS < HGuide->FirstParameter() || WS > HGuide->LastParameter())
+  {
+    return false;
+  }
+  const double R     = fsp->Radius();
+  const double aGrow = (HGuide->LastParameter() - HGuide->FirstParameter()) + 4. * R;
+  double       pf = 0., pl = 0.;
+  if (!ChFi3d_RolledEdgeProlonged(CEr, ef, el, aGrow, pf, pl))
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(B);
+  const occ::handle<Geom_Surface> SN = BRep_Tool::Surface(N);
+  if (SB.IsNull() || SN.IsNull())
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& FN = P->Interference(ons);
+  const ChFiDS_FaceInterference& FR = P->Interference(opp);
+  if (FN.PCurveOnFace().IsNull() || FR.LineIndex() <= 0 || FN.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const gp_Pnt2d              uvN = FN.PCurveOnFace()->Value(WS);
+  const gp_Pnt                pR  = DStr.Curve(FR.LineIndex()).Curve()->Value(WS);
+  GeomAPI_ProjectPointOnCurve aPrE(pR, CEr, pf, pl);
+  if (aPrE.NbPoints() == 0 || aPrE.LowerDistance() > 1.e-4)
+  {
+    return false;
+  }
+  // N grown by the guide's length and more on all sides, a periodic one's
+  // seam half a period from the start.
+  TopoDS_Face NF;
+  {
+    double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+    SN->Bounds(u1, u2, v1, v2);
+    double fu1 = 0., fu2 = 0., fv1 = 0., fv2 = 0.;
+    BRepTools::UVBounds(N, fu1, fu2, fv1, fv2);
+    u1 = std::max(u1, fu1 - aGrow);
+    u2 = std::min(u2, fu2 + aGrow);
+    v1 = std::max(v1, fv1 - aGrow);
+    v2 = std::min(v2, fv2 + aGrow);
+    if (SN->IsUPeriodic())
+    {
+      u1 = uvN.X() - 0.5 * SN->UPeriod();
+      u2 = u1 + SN->UPeriod();
+    }
+    NF = BRepLib_MakeFace(SN, u1, u2, v1, v2, Precision::Confusion());
+    if (NF.IsNull())
+    {
+      return false;
+    }
+    NF.Orientation(N.Orientation());
+  }
+  // B prolonged past Er's ends: on B's surface the strip beside Er's curve
+  // on B's side of it (B's interior there), Er's curve its edge, so that the
+  // ball still leaves the edge for B where it reaches into it.
+  TopoDS_Face BF;
+  TopoDS_Edge Eprol;
+  if (!ChFi3d_StripBesideRolledEdge(B, Er, CEr, pf, pl, aGrow, BF, Eprol))
+  {
+    return false;
+  }
+  TopoDS_Face Fref;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(myEFMap(Er)); it.More() && Fref.IsNull(); it.Next())
+  {
+    if (!it.Value().IsSame(B))
+    {
+      Fref = TopoDS::Face(it.Value());
+    }
+  }
+  if (Fref.IsNull())
+  {
+    return false;
+  }
+  occ::handle<BRepAdaptor_Surface>      HSN = new BRepAdaptor_Surface(NF);
+  occ::handle<BRepAdaptor_Surface>      HSB = new BRepAdaptor_Surface(BF);
+  occ::handle<BRepAdaptor_Curve2d>      PCB = new BRepAdaptor_Curve2d(Eprol, BF);
+  occ::handle<BRepTopAdaptor_TopolTool> ItN = new BRepTopAdaptor_TopolTool(HSN);
+  occ::handle<BRepTopAdaptor_TopolTool> ItB = new BRepTopAdaptor_TopolTool(HSB);
+  TopAbs_Orientation                    OrN = NF.Orientation();
+  TopAbs_Orientation                    OrR = Fref.Orientation();
+  int                                   Choix;
+  if (ons == 1)
+  {
+    Choix = ChFi3d::NextSide(OrN, OrR, Stripe->OrientationOnFace1(), Stripe->OrientationOnFace2(), Stripe->Choix());
+  }
+  else
+  {
+    Choix = ChFi3d::NextSide(OrR, OrN, Stripe->OrientationOnFace1(), Stripe->OrientationOnFace2(), -Stripe->Choix());
+    Choix = Choix % 2 == 1 ? Choix + 1 : Choix - 1;
+  }
+  math_Vector Soldep(1, 3);
+  {
+    double a = 0., b = 0., c = 0., d = 0.;
+    BRepTools::UVBounds(NF, a, b, c, d);
+    Soldep(1) = SN->IsUPeriodic() ? ElCLib::InPeriod(uvN.X(), a, a + SN->UPeriod()) : uvN.X();
+  }
+  Soldep(2) = uvN.Y();
+  Soldep(3) = aPrE.LowerDistanceParameter();
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>> SeqSD;
+  SeqSD.Append(new ChFiDS_SurfData());
+  double                   First = WS, Last = isFirst ? HGuide->FirstParameter() : HGuide->LastParameter();
+  const double             MaxStep  = 0.05 * (Spine->LastParameter(Spine->NbEdges()) - Spine->FirstParameter(1));
+  const double             Fleche   = (HGuide->LastParameter() - HGuide->FirstParameter()) * fleche;
+  bool                     decroch  = false;
+  bool                     walked   = true;
+  const bool               doneSave = done;
+  const ChFiDS_ErrorStatus stSave   = Spine->ErrorStatus();
+  try
+  {
+    OCC_CATCH_SIGNALS
+    if (ons == 1)
+    {
+      PerformSurf(SeqSD, HGuide, Spine, Choix, HSN, ItN, OrN, HSB, ItB, PCB, HSB, PCB, decroch, MaxStep, Fleche,
+                  tolesp, First, Last, false, true, !isFirst, false, false, false, Soldep);
+    }
+    else
+    {
+      PerformSurf(SeqSD, HGuide, Spine, Choix, HSB, ItB, PCB, HSB, PCB, decroch, HSN, ItN, OrN, MaxStep, Fleche,
+                  tolesp, First, Last, false, true, !isFirst, false, false, false, Soldep);
+    }
+  }
+  catch (Standard_Failure const&)
+  {
+    walked = false;
+  }
+  done = doneSave;
+  Spine->SetErrorStatus(stSave);
+  if (!walked || SeqSD.Length() != 1)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> X = SeqSD.First();
+  // From P's other end on past the spine's end.
+  const double WX  = isFirst ? X->LastSpineParam() : X->FirstSpineParam();
+  const double WXe = isFirst ? X->FirstSpineParam() : X->LastSpineParam();
+  const double WV  = isFirst ? Spine->FirstParameter(1) : Spine->LastParameter(Spine->NbEdges());
+  if (std::abs(WX - WS) > 10. * tolesp || (isFirst ? WXe > WV - 10. * tolesp : WXe < WV + 10. * tolesp))
+  {
+    return false;
+  }
+  X->ChangeIndexOfS1(DStr.AddShape(ons == 1 ? N : B));
+  X->ChangeIndexOfS2(DStr.AddShape(ons == 1 ? B : N));
+  if (opp == 1)
+  {
+    X->SetIndexOfC1(DStr.AddShape(Er));
+  }
+  else
+  {
+    X->SetIndexOfC2(DStr.AddShape(Er));
+  }
+  // X's curves on N and B in the periods of P's at WS.
+  for (int s = 1; s <= 2; s++)
+  {
+    const occ::handle<Geom_Surface>& S   = s == ons ? SN : SB;
+    ChFiDS_FaceInterference&         FX  = X->ChangeInterference(s);
+    const occ::handle<Geom2d_Curve>  PCX = FX.PCurveOnFace();
+    const occ::handle<Geom2d_Curve>& PCP = P->Interference(s).PCurveOnFace();
+    if (PCX.IsNull() || PCP.IsNull())
+    {
+      return false;
+    }
+    if (!S->IsUPeriodic())
+    {
+      continue;
+    }
+    const double T   = S->UPeriod();
+    const double aU  = PCX->Value(WS).X();
+    const double aP  = PCP->Value(WS).X();
+    const double aDU = ElCLib::InPeriod(aU, aP - 0.5 * T, aP + 0.5 * T) - aU;
+    if (std::abs(aDU) > Precision::PConfusion())
+    {
+      FX.ChangePCurveOnFace() = occ::down_cast<Geom2d_Curve>(PCX->Translated(gp_Vec2d(aDU, 0.)));
+    }
+  }
+  // Its start is P's section there; its end lies past A, on no edge.
+  X->ChangeVertex(!isFirst, 1) = P->Vertex(!isFirst, 1);
+  X->ChangeVertex(!isFirst, 2) = P->Vertex(!isFirst, 2);
+  for (int s = 1; s <= 2; s++)
+  {
+    ChFiDS_CommonPoint& CP   = X->ChangeVertex(isFirst, s);
+    const double        t    = CP.Tolerance();
+    const bool          hasV = CP.HasVector();
+    const gp_Vec        v    = hasV ? CP.Vector() : gp_Vec();
+    CP.Reset();
+    CP.SetTolerance(t);
+    if (hasV)
+    {
+      CP.SetVector(v);
+    }
+  }
+  // X's face is generated by the spine's edges P's was.
+  for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+  {
+    if (NCollection_List<int>* aList = myEVIMap.ChangeSeek(Spine->Edges(ie)))
+    {
+      for (NCollection_List<int>::Iterator it(*aList); it.More(); it.Next())
+      {
+        if (it.Value() == P->Surf())
+        {
+          it.ChangeValue() = X->Surf();
+        }
+      }
+    }
+  }
+  aSeq.ChangeValue(iP) = X;
+  return true;
+}
