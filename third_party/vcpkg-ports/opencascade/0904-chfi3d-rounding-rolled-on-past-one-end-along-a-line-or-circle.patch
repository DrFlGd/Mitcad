+// Face B prolonged past the ends of its edge Er (curve CEr, a line or a
+// circle, prolonged to [pf, pl]): on B's surface the strip beside Er's
+// curve on B's side of it (B's interior there), Er's curve its edge Eprol,
+// as wide as Grow (half the radius at most beside a circle).
+static bool ChFi3d_StripBesideRolledEdge(const TopoDS_Face&             B,
+                                         const TopoDS_Edge&             Er,
+                                         const occ::handle<Geom_Curve>& CEr,
+                                         const double                   pf,
+                                         const double                   pl,
+                                         const double                   Grow,
+                                         TopoDS_Face&                   BF,
+                                         TopoDS_Edge&                   Eprol)
+{
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(B);
+  if (SB.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face BB = B;
+  BB.Orientation(TopAbs_FORWARD);
+  const TopoDS_Edge ErB = edgeInFace(Er, BB);
+  double            cf = 0., cl = 0.;
+  const occ::handle<Geom2d_Curve> PCr =
+    ErB.IsNull() ? occ::handle<Geom2d_Curve>() : BRep_Tool::CurveOnSurface(ErB, BB, cf, cl);
+  if (PCr.IsNull())
+  {
+    return false;
+  }
+  // (B's side of Er: a point beside the middle of Er's curve in B.)
+  gp_Pnt2d pm;
+  gp_Vec2d tm;
+  PCr->D1(0.5 * (cf + cl), pm, tm);
+  if (tm.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  gp_Vec2d            d(-tm.Y(), tm.X());
+  BRepAdaptor_Surface aBS(BB);
+  const double        step = 1.e-3 * std::min(aBS.UResolution(1.), aBS.VResolution(1.));
+  d.Normalize();
+  BRepClass_FaceClassifier onLeft(BB, pm.Translated(step * d), 0.1 * step);
+  BRepClass_FaceClassifier onRight(BB, pm.Translated(-step * d), 0.1 * step);
+  if ((onLeft.State() == TopAbs_IN) == (onRight.State() == TopAbs_IN))
+  {
+    return false;
+  }
+  if (onLeft.State() != TopAbs_IN)
