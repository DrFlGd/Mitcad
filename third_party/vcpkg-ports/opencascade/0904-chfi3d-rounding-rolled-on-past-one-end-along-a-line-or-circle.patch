+//=======================================================================
+// function : ChFi3d_RolledIntoEndVertex
+// purpose  : Whether the blend of Fd rolls, at its end (its start with
+//           isfirst), on an edge that has the corner's vertex Vtx, with
+//           that contact at Vtx (within ten times Tol and Vtx's
+//           tolerance): the edge runs into the vertex beside the spine's
+//           edge, so that the blend vanishes there.
+//=======================================================================
+
+static bool ChFi3d_RolledIntoEndVertex(const TopOpeBRepDS_DataStructure&   DStr,
+                                       const occ::handle<ChFiDS_SurfData>& Fd,
+                                       const bool                          isfirst,
+                                       const TopoDS_Vertex&                Vtx,
+                                       const double                        Tol)
+{
+  const gp_Pnt PV = BRep_Tool::Pnt(Vtx);
+  for (int s = 1; s <= 2; s++)
+  {
+    if (!Fd->IsOnCurve(s) || Fd->IndexOfC(s) <= 0
+        || Fd->Vertex(isfirst, s).Point().Distance(PV) > 10. * Tol + BRep_Tool::Tolerance(Vtx))
+    {
+      continue;
+    }
+    for (TopExp_Explorer ex(DStr.Shape(Fd->IndexOfC(s)), TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(Vtx))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
