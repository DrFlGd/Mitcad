+  // The strip's far side: Er's curve moved by wide along d (a line), or
+  // offset towards d (a circle; Geom2d_OffsetCurve offsets to the curve's
+  // right).
+  occ::handle<Geom2d_Curve> aFar;
+  if (!LC.IsNull())
