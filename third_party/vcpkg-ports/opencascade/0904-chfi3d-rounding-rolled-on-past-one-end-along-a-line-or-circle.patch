+    wide = std::min(wide, 0.5 * LC->Radius());
+    gp_Pnt2d pmid;
+    gp_Vec2d tmid;
+    L2->D1(0.5 * (pf + pl), pmid, tmid);
+    const double offset = gp_Vec2d(tmid.Y(), -tmid.X()).Dot(d) > 0. ? wide : -wide;
+    aFar                = new Geom2d_OffsetCurve(new Geom2d_TrimmedCurve(L2, pf, pl), offset);
+    c                   = aFar->Value(pl);
+    e                   = aFar->Value(pf);
+  }
+  else
+  {
+    c = b.Translated(wide * d);
+    e = a.Translated(wide * d);
+  }
+  // (Counterclockwise in the parameters, the curve first.)
+  const bool       ccw = gp_Vec2d(a, b).Crossed(gp_Vec2d(a, e)) > 0.;
+  BRepLib_MakeEdge mk0(L2, SB, pf, pl);
+  BRepLib_MakeEdge mk1(GCE2d_MakeSegment(b, c).Value(), SB);
+  BRepLib_MakeEdge mk2 =
+    aFar.IsNull() ? BRepLib_MakeEdge(GCE2d_MakeSegment(c, e).Value(), SB) : BRepLib_MakeEdge(aFar, SB, pf, pl);
+  BRepLib_MakeEdge mk3(GCE2d_MakeSegment(e, a).Value(), SB);
+  if (!mk0.IsDone() || !mk1.IsDone() || !mk2.IsDone() || !mk3.IsDone())
