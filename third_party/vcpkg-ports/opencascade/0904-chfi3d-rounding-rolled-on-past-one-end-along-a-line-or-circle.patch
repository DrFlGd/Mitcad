+// The parameters of curve C of an edge [ef, el] prolonged by length Grow at
+// both ends: a line's, or a circle's (an edge along a ring) by the angle of
+// that length, up to a little less than the rest of the turn. False for
+// other curves.
+static bool ChFi3d_RolledEdgeProlonged(const occ::handle<Geom_Curve>& C,
+                                       const double                   ef,
+                                       const double                   el,
+                                       const double                   Grow,
+                                       double&                        pf,
+                                       double&                        pl)
+{
+  double aGrow = Grow;
+  if (const occ::handle<Geom_Circle> aCirc = occ::down_cast<Geom_Circle>(C))
+  {
+    aGrow = std::min(Grow / aCirc->Radius(), 0.45 * (2. * M_PI - (el - ef)));
+  }
+  else if (C.IsNull() || !C->IsKind(STANDARD_TYPE(Geom_Line)))
+  {
+    return false;
+  }
+  pf = ef - aGrow;
+  pl = el + aGrow;
+  return true;
+}
