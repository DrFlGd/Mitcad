+  while (!L2.IsNull() && L2->IsKind(STANDARD_TYPE(Geom2d_TrimmedCurve)))
+  {
+    L2 = occ::down_cast<Geom2d_TrimmedCurve>(L2)->BasisCurve();
+  }
+  const occ::handle<Geom2d_Line>   L  = occ::down_cast<Geom2d_Line>(L2);
+  const occ::handle<Geom2d_Circle> LC = occ::down_cast<Geom2d_Circle>(L2);
+  if (L.IsNull() && LC.IsNull())
