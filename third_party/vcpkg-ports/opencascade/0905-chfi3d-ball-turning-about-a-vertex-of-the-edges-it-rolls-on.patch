index 40572c24..aa0c4bd0 100644
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder_0.cxx
@@ -4082,6 +4082,26 @@ void ChFi3d_FilDS(const int                         SolidIndex,
             ChFiDS_FaceInterference&       Fc = Fd->ChangeInterference(onS);
             Fc.SetFirstParameter(Fo.FirstParameter());
             Fc.SetLastParameter(Fo.LastParameter());
+            // Its transition, which the walk took from a contact that does
+            // not move, is that of a neighbour on the same face and edge
+            // (the piece rolling up to the point), so that the blend's face
+            // is oriented as its neighbours'.
+            for (const int jn : {j - 1, j + 1})
+            {
+              if (jn < 1 || jn > SeqFil.Length())
+              {
+                continue;
+              }
+              const occ::handle<ChFiDS_SurfData>& Fn = SeqFil(jn);
+              if (Fn->Index(onS) == Fd->Index(onS) && Fn->Index(3 - onS) == Fd->Index(3 - onS)
+                  && Fn->IsOnCurve(onS) && Fd->IsOnCurve(onS)
+                  && Fn->IndexOfC(onS) == Fd->IndexOfC(onS) && Fn->Orientation() == Fd->Orientation()
+                  && Fn->Interference(3 - onS).Transition() == Fo.Transition())
+              {
+                Fc.SetTransition(Fn->Interference(onS).Transition());
+                break;
+              }
+            }
           }
           continue;
         }
