+//=======================================================================
+// function : ChFi3d_RollsIntoVertex
+// purpose  : Whether a side of SD rolls on an edge that has the vertex V
+//            (the spine's end vertex): the face between that edge and the
+//            spine's narrows to V, and the blend vanishes there.
+//=======================================================================
+
+static bool ChFi3d_RollsIntoVertex(const occ::handle<ChFiDS_SurfData>& SD,
+                                   const TopoDS_Vertex&                V,
+                                   const TopOpeBRepDS_DataStructure&   DStr)
+{
+  if (SD.IsNull() || V.IsNull())
+  {
+    return false;
+  }
+  for (int s = 1; s <= 2; s++)
+  {
+    if (!SD->IsOnCurve(s) || SD->IndexOfC(s) <= 0)
+    {
+      continue;
+    }
+    for (TopExp_Explorer ex(DStr.Shape(SD->IndexOfC(s)), TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(V))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
