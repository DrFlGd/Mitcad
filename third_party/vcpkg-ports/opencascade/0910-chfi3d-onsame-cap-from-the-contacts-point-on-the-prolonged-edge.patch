+//=======================================================================
+// function : ChFi3d_CapFromPoint
+// purpose  : The cap Cc (on the blend Ps, on the face at the end Pc) made
+//            to start (theAtFirst) or end at the corner's point P (uvS on
+//            the blend, uvF on the face): the intersection of the blend's
+//            approximated surface with the face's surface ends off that
+//            point by up to the approximation's tolerance. Where the cap
+//            leaves the prolonged edge tangentially (the blend tangent to
+//            Fop along its contact, P on Fop's edge with the face), a cap
+//            starting on the wrong side of that edge crosses it on the
+//            face. The curves' end poles are moved onto the point; no
+//            more than Tol.
+//=======================================================================
+
+static void ChFi3d_CapFromPoint(occ::handle<Geom_Curve>&   Cc,
+                                occ::handle<Geom2d_Curve>& Ps,
+                                occ::handle<Geom2d_Curve>& Pc,
+                                const bool                 theAtFirst,
+                                const gp_Pnt&              P,
+                                const gp_Pnt2d&            uvS,
+                                const gp_Pnt2d&            uvF,
+                                const double               Tol,
+                                double&                    tolreached)
+{
+  if (Cc.IsNull() || Ps.IsNull() || Pc.IsNull())
+  {
+    return;
+  }
+  const double t = theAtFirst ? Cc->FirstParameter() : Cc->LastParameter();
+  const double d = Cc->Value(t).Distance(P);
+  if (d <= Precision::Confusion() || d > Tol)
+  {
+    return;
+  }
+  occ::handle<Geom_BSplineCurve>   c3  = GeomConvert::CurveToBSplineCurve(Cc);
+  occ::handle<Geom2d_BSplineCurve> cs  = Geom2dConvert::CurveToBSplineCurve(Ps);
+  occ::handle<Geom2d_BSplineCurve> cf  = Geom2dConvert::CurveToBSplineCurve(Pc);
+  const double                     tol = Precision::PConfusion();
+  if (c3.IsNull() || cs.IsNull() || cf.IsNull()
+      || std::abs(c3->FirstParameter() - Cc->FirstParameter()) > tol
+      || std::abs(c3->LastParameter() - Cc->LastParameter()) > tol
+      || std::abs(cs->FirstParameter() - Cc->FirstParameter()) > tol
+      || std::abs(cf->FirstParameter() - Cc->FirstParameter()) > tol
+      || std::abs(cs->LastParameter() - Cc->LastParameter()) > tol
+      || std::abs(cf->LastParameter() - Cc->LastParameter()) > tol)
+  {
+    return;
+  }
+  c3->SetPole(theAtFirst ? 1 : c3->NbPoles(), P);
+  cs->SetPole(theAtFirst ? 1 : cs->NbPoles(), uvS);
+  cf->SetPole(theAtFirst ? 1 : cf->NbPoles(), uvF);
+  Cc         = c3;
+  Ps         = cs;
+  Pc         = cf;
+  tolreached = std::max(tolreached, d);
+}
