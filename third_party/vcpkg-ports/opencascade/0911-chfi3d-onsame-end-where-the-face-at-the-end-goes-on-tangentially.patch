     i = ChFi3d::ConcaveSide(F3, F4, E[1], o11, o12);
     j = ChFi3d::ConcaveSide(F5, F6, E[2], o21, o22);
 
-    if (o01 == o11 && o02 == o21 && o12 == o22)
+    // One of the other two edges between faces tangent to each other (the
+    // face at the end going on tangentially from a face of the spine's
+    // edge, the other edge sharp), leaving the vertex behind the spine's
+    // edge (that face's corner there reflex, so that the blend's contact on
+    // it does not run onto the face at the end): the face at the end cuts
+    // the blend and grows up to it along that edge prolonged, an OnSame
+    // end. Sampled inside such an edge, the faces' sides above give either
+    // state.
+    const bool aTangent1 = !F3.IsSame(F4) && ChFi3d::IsTangentFaces(E[1], F3, F4);
