+//=======================================================================
+// function : ChFi3d_TangentEdgeBehindSpine
+// purpose  : Whether the edge Et, between faces tangent to each other,
+//            leaves the vertex it shares with the spine's edge Es on the
+//            side of Es away from the interior of their common face Fs
+//            (Fs's corner at the vertex reflex): the blend's contact on
+//            Fs, inside Fs along Es, does not meet Et before the vertex,
+//            and Et is to be prolonged up to it there.
+//=======================================================================
+
+static bool ChFi3d_TangentEdgeBehindSpine(const TopoDS_Edge& Es, const TopoDS_Edge& Et, const ChFiDS_Map& EFMap)
+{
+  TopoDS_Vertex V;
+  if (!TopExp::CommonVertex(Es, Et, V) || V.IsNull() || !EFMap.Contains(Es) || !EFMap.Contains(Et))
+  {
+    return false;
+  }
+  TopoDS_Face Fs;
+  for (NCollection_List<TopoDS_Shape>::Iterator itT(EFMap(Et)); itT.More() && Fs.IsNull(); itT.Next())
+  {
+    for (NCollection_List<TopoDS_Shape>::Iterator itS(EFMap(Es)); itS.More(); itS.Next())
+    {
+      if (itS.Value().IsSame(itT.Value()))
+      {
+        Fs = TopoDS::Face(itT.Value());
+        break;
+      }
+    }
+  }
+  if (Fs.IsNull())
+  {
+    return false;
+  }
+  // Es as its wire in Fs runs (Fs on its left, seen from Fs's outside).
+  TopoDS_Edge EsF;
+  for (TopExp_Explorer ex(Fs, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(Es))
+    {
+      EsF = TopoDS::Edge(ex.Current());
+      break;
+    }
+  }
+  if (EsF.IsNull() || BRep_Tool::IsClosed(EsF, Fs))
+  {
+    return false;
+  }
+  double                          f = 0., l = 0.;
+  const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(EsF, Fs, f, l);
+  if (pc.IsNull())
+  {
+    return false;
+  }
+  const double      ws = BRep_Tool::Parameter(V, Es);
+  BRepAdaptor_Curve cs(Es);
+  gp_Pnt            P;
+  gp_Vec            ts;
+  cs.D1(ws, P, ts);
+  if (EsF.Orientation() == TopAbs_REVERSED)
+  {
+    ts.Reverse();
+  }
+  const gp_Pnt2d      uv = pc->Value(ws);
+  BRepAdaptor_Surface su(Fs, false);
+  gp_Vec              du, dv;
+  su.D1(uv.X(), uv.Y(), P, du, dv);
+  gp_Vec N = du.Crossed(dv);
+  if (Fs.Orientation() == TopAbs_REVERSED)
+  {
+    N.Reverse();
+  }
+  const gp_Vec inward = N.Crossed(ts);
+  BRepAdaptor_Curve ct(Et);
+  const double      wt = BRep_Tool::Parameter(V, Et);
+  gp_Vec            te;
+  ct.D1(wt, P, te);
+  if (std::abs(wt - ct.LastParameter()) < std::abs(wt - ct.FirstParameter()))
+  {
+    te.Reverse();
+  }
+  const double scale = inward.Magnitude() * te.Magnitude();
+  return scale > gp::Resolution() && te.Dot(inward) < -1.e-6 * scale;
+}
