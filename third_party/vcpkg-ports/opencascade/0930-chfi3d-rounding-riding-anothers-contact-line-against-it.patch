+// Whether the blend of SurfData SB, whose side OnB rolls on the contact line
+// C (from T1 to T2) of another blend, runs along C against it: its own line
+// there (before it is replaced by C) runs the other way.
+static bool rideRunsAgainst(const TopOpeBRepDS_DataStructure&   DStr,
+                            const occ::handle<ChFiDS_SurfData>& SB,
+                            const int                           OnB,
+                            const occ::handle<Geom_Curve>&      C,
+                            const double                        T1,
+                            const double                        T2)
+{
+  const ChFiDS_FaceInterference& FIB = SB->Interference(OnB);
+  if (FIB.LineIndex() <= 0 || DStr.Curve(FIB.LineIndex()).Curve().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& CB = DStr.Curve(FIB.LineIndex()).Curve();
+  const double                   b1 = FIB.FirstParameter(), b2 = FIB.LastParameter();
+  if (std::abs(b2 - b1) <= Precision::PConfusion())
+  {
+    return false;
+  }
+  // (Away from the ends, which are one point on a closed line.)
+  double aDot = 0.;
+  for (const double aFrac : {0.3, 0.7})
+  {
+    gp_Pnt aPB;
+    gp_Vec aDB;
+    CB->D1(b1 + aFrac * (b2 - b1), aPB, aDB);
+    if (b2 < b1)
+    {
+      aDB.Reverse();
+    }
+    GeomAPI_ProjectPointOnCurve aProj(aPB, C, T1, T2);
+    if (aProj.NbPoints() == 0)
+    {
+      return false;
+    }
+    gp_Pnt aPC;
+    gp_Vec aDC;
+    C->D1(aProj.LowerDistanceParameter(), aPC, aDC);
+    if (aDB.Magnitude() <= gp::Resolution() || aDC.Magnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    const double aCos = aDB.Dot(aDC) / (aDB.Magnitude() * aDC.Magnitude());
+    if (aDot != 0. && (aCos < 0.) != (aDot < 0.))
+    {
+      return false;
+    }
+    aDot = aCos;
+  }
+  return aDot < -0.5;
+}
+
+// The blends of stripes that roll on another's contact line against it
+// (ApplyRides: their side on the line runs from its end to its start) use
+// the line the other way on their surfaces: its transition there is turned,
+// once the stripes are in the data structure.
+static void turnRidesAgainst(TopOpeBRepDS_DataStructure&                         DStr,
+                             const NCollection_List<occ::handle<ChFiDS_Stripe>>& Rides)
+{
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB(Rides); itB.More(); itB.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+    if (B->SetOfSurfData().IsNull())
+    {
+      continue;
+    }
+    for (int i = 1; i <= B->SetOfSurfData()->Length(); i++)
+    {
+      const occ::handle<ChFiDS_SurfData>& SD = B->SetOfSurfData()->Value(i);
+      for (int k = 1; k <= 2; k++)
+      {
+        const ChFiDS_FaceInterference& FI = SD->Interference(k);
+        if (SD->Index(k) != 0 || FI.LineIndex() <= 0 || FI.FirstParameter() <= FI.LastParameter())
+        {
+          continue;
+        }
+        for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(
+               DStr.ChangeSurfaceInterferences(SD->Surf()));
+             it.More();
+             it.Next())
+        {
+          if (it.Value()->GeometryType() == TopOpeBRepDS_CURVE
+              && it.Value()->Geometry() == FI.LineIndex())
+          {
+            const TopAbs_Orientation anO = it.Value()->Transition().Orientation(TopAbs_IN);
+            it.ChangeValue()->ChangeTransition() = TopOpeBRepDS_Transition(TopAbs::Reverse(anO));
+          }
+        }
+      }
+    }
+  }
+}
