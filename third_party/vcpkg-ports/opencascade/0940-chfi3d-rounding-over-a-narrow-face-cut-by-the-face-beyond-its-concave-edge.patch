+// Curve PC (between f and l) on face F's surface, moved by whole periods of
+// that surface into F's parameters: its middle as near as can be to F's
+// bounds (a curve a face grows up to, found on its unbounded surface, lies
+// in the period of F's own curves).
+static void ChFi3d_IntoPeriodOfFace(const TopoDS_Face& F, occ::handle<Geom2d_Curve>& PC, const double f, const double l)
+{
+  if (PC.IsNull())
+  {
+    return;
+  }
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+  if (S.IsNull() || (!S->IsUPeriodic() && !S->IsVPeriodic()))
+  {
+    return;
+  }
+  double u0 = 0., u1 = 0., v0 = 0., v1 = 0.;
+  BRepTools::UVBounds(FF, u0, u1, v0, v1);
+  const gp_Pnt2d m = PC->Value(0.5 * (f + l));
+  gp_Vec2d       aShift(0., 0.);
+  for (int d = 0; d < 2; d++)
+  {
+    const bool per = d == 0 ? S->IsUPeriodic() : S->IsVPeriodic();
+    if (!per)
+    {
+      continue;
+    }
+    const double T = d == 0 ? S->UPeriod() : S->VPeriod();
+    const double c = d == 0 ? m.X() : m.Y(), lo = d == 0 ? u0 : v0, hi = d == 0 ? u1 : v1;
+    double       best = c < lo ? lo - c : (c > hi ? c - hi : 0.), sh = 0.;
+    for (int k = -3; k <= 3; k++)
+    {
+      const double ck = c + k * T;
+      const double dist = ck < lo ? lo - ck : (ck > hi ? ck - hi : 0.);
+      if (dist < best - Precision::PConfusion())
+      {
+        best = dist;
+        sh   = k * T;
+      }
+    }
+    (d == 0 ? aShift.SetX(sh) : aShift.SetY(sh));
+  }
+  if (aShift.Magnitude() > 0.)
+  {
+    PC = occ::down_cast<Geom2d_Curve>(PC->Translated(aShift));
+  }
+}
