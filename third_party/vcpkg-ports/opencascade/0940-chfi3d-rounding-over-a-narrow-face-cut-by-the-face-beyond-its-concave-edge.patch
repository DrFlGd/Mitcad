+// Piece G's common point on side `side` at its first or last end: the
+// point of its line there, on no arc (a section of the blend, not its end).
+static void ChFi3d_SetOtherContactAt(const TopOpeBRepDS_DataStructure&   DStr,
+                                     const occ::handle<ChFiDS_SurfData>& G,
+                                     const int                           side,
+                                     const bool                          atFirst)
+{
+  const ChFiDS_FaceInterference& FI  = G->Interference(side);
+  const TopOpeBRepDS_Curve&      toc = DStr.Curve(FI.LineIndex());
+  gp_Pnt                         P;
+  gp_Vec                         V;
+  toc.Curve()->D1(FI.Parameter(atFirst), P, V);
+  ChFiDS_CommonPoint& CP = G->ChangeVertex(atFirst, side);
+  CP.Reset();
+  CP.SetPoint(P);
+  CP.SetVector(V);
+  CP.SetTolerance(toc.Tolerance());
+}
+
+// Piece G's common point on its cut side `cut` at its first or last end:
+// at vertex V (point P), where two cuts meet.
+static void ChFi3d_SetCutStartAtVertex(const occ::handle<ChFiDS_SurfData>& G,
+                                       const int                           cut,
+                                       const bool                          atFirst,
+                                       const gp_Pnt&                       P,
+                                       const TopoDS_Vertex&                V,
+                                       const double                        Tol)
+{
+  ChFiDS_CommonPoint& CP  = G->ChangeVertex(atFirst, cut);
+  const gp_Vec        aV  = CP.HasVector() ? CP.Vector() : gp_Vec();
+  const bool          aHas = CP.HasVector();
+  CP.Reset();
+  CP.SetPoint(P);
+  if (aHas)
+  {
+    CP.SetVector(aV);
+  }
+  CP.SetVertex(V);
+  CP.SetTolerance(Tol);
+}
