+// The intersection curve of faces F1 and F2 (their surfaces unbounded)
+// from vertex V1 to V2 found by points: those of the chord from V1 to V2
+// taken onto both surfaces in turn, where the intersection lines miss one
+// of the vertices (a vertex where the surfaces touch tangentially), with
+// the curve through those points and its p-curves.
+static bool ChFi3d_FacesCurveByPoints(const TopoDS_Face&   F1,
+                                      const TopoDS_Face&   F2,
+                                      const TopoDS_Vertex& V1,
+                                      const TopoDS_Vertex& V2,
+                                      const double         Tol,
+                                      ChFi3d_GrowthCurve&  G)
+{
+  TopoDS_Face A = F1, B = F2;
+  A.Orientation(TopAbs_FORWARD);
+  B.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> SA = ChFi3d_WideSurface(A), SB = ChFi3d_WideSurface(B);
+  const gp_Pnt                    P1 = BRep_Tool::Pnt(V1), P2 = BRep_Tool::Pnt(V2);
+  if (SA.IsNull() || SB.IsNull() || P1.Distance(P2) <= Precision::Confusion())
+  {
+    return false;
+  }
+  const int                  nb = 24;
+  NCollection_Array1<gp_Pnt> aPnts(1, nb + 1);
+  for (int k = 0; k <= nb; k++)
+  {
+    gp_Pnt P = P1.Translated(gp_Vec(P1, P2) * (double(k) / nb));
+    if (k > 0 && k < nb)
+    {
+      for (int it = 0; it < 200; it++)
+      {
+        GeomAPI_ProjectPointOnSurf aPrA(P, SA);
+        if (aPrA.NbPoints() == 0)
+        {
+          return false;
+        }
+        GeomAPI_ProjectPointOnSurf aPrB(aPrA.NearestPoint(), SB);
+        if (aPrB.NbPoints() == 0)
+        {
+          return false;
+        }
+        const gp_Pnt Pn = aPrB.NearestPoint();
+        const double d  = Pn.Distance(P);
+        P               = Pn;
+        if (d <= 1.e-9)
+        {
+          break;
+        }
+      }
+      GeomAPI_ProjectPointOnSurf aPrA(P, SA);
+      if (aPrA.NbPoints() == 0 || aPrA.LowerDistance() > Tol)
+      {
+        return false;
+      }
+    }
+    aPnts.SetValue(k + 1, P);
+  }
+  GeomAPI_PointsToBSpline anApp(aPnts, 3, 8, GeomAbs_C2, 1.e-7);
+  if (!anApp.IsDone())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve> aC(anApp.Curve());
+  G.C     = aC;
+  G.First = aC->FirstParameter();
+  G.Last  = aC->LastParameter();
+  G.PC1   = GeomProjLib::Curve2d(aC, G.First, G.Last, SA);
+  G.PC2   = GeomProjLib::Curve2d(aC, G.First, G.Last, SB);
+  G.F1    = F1;
+  G.F2    = F2;
+  G.V1    = V1;
+  G.V2    = V2;
+  return !G.PC1.IsNull() && !G.PC2.IsNull();
+}
+
+// The curve along which edge Ej of faces C1 and C2 runs on past its
+// vertex J: its own curve where that is a circle, a line or an ellipse
+// lying on both surfaces past J (within Tol at points up to a quarter turn
+// or the edge's length on), else none.
+static occ::handle<Geom_Curve> ChFi3d_EdgeRunOn(const TopoDS_Face&   C1,
+                                               const TopoDS_Face&   C2,
+                                               const TopoDS_Edge&   Ej,
+                                               const TopoDS_Vertex& J,
+                                               const double         Tol,
+                                               double&              wJ,
+                                               double&              aDir)
+{
+  double                  f = 0., l = 0.;
+  occ::handle<Geom_Curve> aC = BRep_Tool::Curve(Ej, f, l);
+  if (aC.IsNull())
+  {
+    return aC;
+  }
+  while (aC->IsKind(STANDARD_TYPE(Geom_TrimmedCurve)))
+  {
+    aC = occ::down_cast<Geom_TrimmedCurve>(aC)->BasisCurve();
+  }
+  const GeomAdaptor_Curve anAd(aC);
+  if (anAd.GetType() != GeomAbs_Circle && anAd.GetType() != GeomAbs_Line && anAd.GetType() != GeomAbs_Ellipse)
+  {
+    return occ::handle<Geom_Curve>();
+  }
+  const gp_Pnt PJ  = BRep_Tool::Pnt(J);
+  const bool   atF = aC->Value(f).Distance(PJ) <= aC->Value(l).Distance(PJ);
+  wJ               = atF ? f : l;
+  aDir             = atF ? -1. : 1.;
+  const double aRange = anAd.GetType() == GeomAbs_Line ? (l - f) : std::min(l - f, M_PI / 2.);
+  for (const TopoDS_Face& F : {C1, C2})
+  {
+    TopoDS_Face FF = F;
+    FF.Orientation(TopAbs_FORWARD);
+    const occ::handle<Geom_Surface> S = ChFi3d_WideSurface(FF);
+    for (int k = 1; k <= 4; k++)
+    {
+      GeomAPI_ProjectPointOnSurf aPr(aC->Value(wJ + aDir * aRange * k / 4.), S);
+      if (aPr.NbPoints() == 0 || aPr.LowerDistance() > Tol)
+      {
+        return occ::handle<Geom_Curve>();
+      }
+    }
+  }
+  return aC;
+}
+
+// Edge Ej of faces C1 and C2 run on along its own curve past vertex J
+// (ChFi3d_EdgeRunOn) up to where it meets face A's surface first, within a
+// quarter turn: that point's vertex VP and the run-on as a curve of C1 and
+// C2 from J to VP.
+static bool ChFi3d_RunOnToFace(const TopoDS_Face&   C1,
+                               const TopoDS_Face&   C2,
+                               const TopoDS_Edge&   Ej,
+                               const TopoDS_Vertex& J,
+                               const TopoDS_Face&   A,
+                               const double         Tol,
+                               TopoDS_Vertex&       VP,
+                               ChFi3d_GrowthCurve&  G)
+{
+  double                        wJ = 0., aDir = 0.;
+  const occ::handle<Geom_Curve> L = ChFi3d_EdgeRunOn(C1, C2, Ej, J, Tol, wJ, aDir);
+  if (L.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face AF = A;
+  AF.Orientation(TopAbs_FORWARD);
+  GeomAPI_IntCS anCS(L, ChFi3d_WideSurface(AF));
+  double        aBest = RealLast();
+  for (int k = 1; anCS.IsDone() && k <= anCS.NbPoints(); k++)
+  {
+    double u = 0., v = 0., w = 0.;
+    anCS.Parameters(k, u, v, w);
+    double dw = (w - wJ) * aDir;
+    if (L->IsPeriodic())
+    {
+      dw = std::fmod(dw, L->Period());
+      dw = dw < 0. ? dw + L->Period() : dw;
+    }
+    if (dw > Precision::PConfusion() && dw <= M_PI / 2. && dw < aBest)
+    {
+      aBest = dw;
+    }
+  }
+  if (aBest == RealLast())
+  {
+    return false;
+  }
+  const double            wP = wJ + aDir * aBest;
+  occ::handle<Geom_Curve> aC = new Geom_TrimmedCurve(L, std::min(wJ, wP), std::max(wJ, wP));
+  if (wP < wJ)
+  {
+    aC->Reverse();
+  }
+  BRep_Builder().MakeVertex(VP, aC->Value(aC->LastParameter()), Tol);
+  TopoDS_Face aC1 = C1, aC2 = C2;
+  aC1.Orientation(TopAbs_FORWARD);
+  aC2.Orientation(TopAbs_FORWARD);
+  G.C     = aC;
+  G.First = aC->FirstParameter();
+  G.Last  = aC->LastParameter();
+  G.PC1   = GeomProjLib::Curve2d(aC, G.First, G.Last, ChFi3d_WideSurface(aC1));
+  G.PC2   = GeomProjLib::Curve2d(aC, G.First, G.Last, ChFi3d_WideSurface(aC2));
+  G.F1    = C1;
+  G.F2    = C2;
+  G.V1    = J;
+  G.V2    = VP;
+  return !G.PC1.IsNull() && !G.PC2.IsNull();
+}
