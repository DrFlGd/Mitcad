+      anEnd.tO = ElCLib::InPeriod(X.tO, aFrom, aFrom + aCO->Period());
+    }
     anEnd.V   = TopoDS_Vertex();
     anEnd.CPN.Reset();
     anEnd.CPN.SetPoint(X.P);
