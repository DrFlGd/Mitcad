+// Whether the contact of SurfData A on its side onA lies along the contact
+// of SurfData B on its side onB, within Tol at points all along A's.
+static bool contactAlong(const TopOpeBRepDS_DataStructure&   DStr,
+                         const occ::handle<ChFiDS_SurfData>& A,
+                         const int                           onA,
+                         const occ::handle<ChFiDS_SurfData>& B,
+                         const int                           onB,
+                         const double                        Tol)
+{
+  const ChFiDS_FaceInterference& IA = A->Interference(onA);
+  const ChFiDS_FaceInterference& IB = B->Interference(onB);
+  if (IA.LineIndex() <= 0 || IB.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& CA = DStr.Curve(IA.LineIndex()).Curve();
+  const occ::handle<Geom_Curve>& CB = DStr.Curve(IB.LineIndex()).Curve();
+  if (CA.IsNull() || CB.IsNull())
+  {
+    return false;
+  }
+  const double ub1 = std::min(IB.FirstParameter(), IB.LastParameter());
+  const double ub2 = std::max(IB.FirstParameter(), IB.LastParameter());
+  for (int i = 0; i <= 4; i++)
+  {
+    const gp_Pnt Pa = CA->Value(IA.FirstParameter() + (IA.LastParameter() - IA.FirstParameter()) * i / 4.);
+    GeomAPI_ProjectPointOnCurve aProj(Pa, CB, ub1, ub2);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Two stripes of one piece each whose contacts on a face lie along each other
+// all the way (two roundings that consume the face between them, a strip as
+// wide as both): each stripe's corner made its own point where the contacts
+// end on an edge of that face, each cutting the edge for its own side, and
+// each its own contact edge: the face came out as a sliver of no area
+// between them, or with that edge's pieces left. The points are made one,
+// the edge leaves the face on both sides of them, and where both ends meet
+// the contacts are one edge, A's, bounding both blends and leaving the face
+// on both sides: the face is gone.
+static void joinEndsAlongContacts(TopOpeBRepDS_DataStructure&                         DStr,
+                                  const NCollection_List<occ::handle<ChFiDS_Stripe>>& theStripes,
+                                  const double                                        Tol)
+{
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itA(theStripes); itA.More(); itA.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& A = itA.Value();
+    if (A->SetOfSurfData().IsNull() || A->SetOfSurfData()->Length() != 1)
+    {
+      continue;
+    }
+    NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB = itA;
+    for (itB.Next(); itB.More(); itB.Next())
+    {
+      const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+      if (B->SetOfSurfData().IsNull() || B->SetOfSurfData()->Length() != 1)
+      {
+        continue;
+      }
+      const occ::handle<ChFiDS_SurfData>& a = A->SetOfSurfData()->Value(1);
+      const occ::handle<ChFiDS_SurfData>& b = B->SetOfSurfData()->Value(1);
+      for (int ka = 1; ka <= 2; ka++)
+      {
+        for (int kb = 1; kb <= 2; kb++)
+        {
+          if (a->Index(ka) <= 0 || a->Index(ka) != b->Index(kb) || a->IsOnCurve(ka) || b->IsOnCurve(kb)
+              || !contactAlong(DStr, a, ka, b, kb, Tol) || !contactAlong(DStr, b, kb, a, ka, Tol))
+          {
+            continue;
+          }
+          int aJoined = 0;
+          for (const bool fa : {true, false})
+          {
+            for (const bool fb : {true, false})
+            {
+              const ChFiDS_CommonPoint& Pa = a->Vertex(fa, ka);
+              const ChFiDS_CommonPoint& Pb = b->Vertex(fb, kb);
+              const int                 ia = A->IndexPoint(fa, ka);
+              const int                 ib = B->IndexPoint(fb, kb);
+              if (Pa.IsVertex() || Pb.IsVertex() || !Pa.IsOnArc() || !Pb.IsOnArc() || !Pa.Arc().IsSame(Pb.Arc())
+                  || ia <= 0 || ib <= 0 || ia > DStr.NbPoints() || ib > DStr.NbPoints()
+                  || DStr.Point(ia).Point().Distance(DStr.Point(ib).Point()) > Tol)
+              {
+                continue;
+              }
+              if (ia != ib)
+              {
+                redirectPoint(DStr, ib, ia);
+                B->SetIndexPoint(ia, fb, kb);
+              }
+              aJoined++;
+              // (The edge leaves the face on both sides of the point.)
+              if (!DStr.HasShape(Pa.Arc()))
+              {
+                continue;
+              }
+              for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(
+                     DStr.ChangeShapeInterferences(Pa.Arc()));
+                   it.More();
+                   it.Next())
+              {
+                if (it.Value()->GeometryType() == TopOpeBRepDS_POINT && it.Value()->Geometry() == ia)
+                {
+                  it.ChangeValue()->ChangeTransition() = TopOpeBRepDS_Transition(TopAbs_EXTERNAL);
+                }
+              }
+            }
+          }
+          if (aJoined < 2)
+          {
+            continue;
+          }
+          // Both ends one: the two contacts are one edge, A's, which bounds
+          // both blends and leaves the face on both sides (the face is gone).
+          const int ca = a->Interference(ka).LineIndex(), cb = b->Interference(kb).LineIndex();
+          const occ::handle<Geom_Curve>& Ca = DStr.Curve(ca).Curve();
+          const occ::handle<Geom_Curve>& Cb = DStr.Curve(cb).Curve();
+          const occ::handle<Geom_Surface>& Sb = DStr.Surface(b->Surf()).Surface();
+          if (ca == cb || Ca.IsNull() || Cb.IsNull() || Sb.IsNull())
+          {
+            continue;
+          }
+          const double fA = a->Interference(ka).FirstParameter(), lA = a->Interference(ka).LastParameter();
+          const double fB = b->Interference(kb).FirstParameter(), lB = b->Interference(kb).LastParameter();
+          // (Whether they run the same way.)
+          gp_Pnt pA, pB;
+          gp_Vec tA, tB;
+          Ca->D1(0.5 * (fA + lA), pA, tA);
+          GeomAPI_ProjectPointOnCurve onB(pA, Cb, std::min(fB, lB), std::max(fB, lB));
+          if (onB.NbPoints() == 0)
+          {
+            continue;
+          }
+          Cb->D1(onB.LowerDistanceParameter(), pB, tB);
+          const bool aSame = tA.Dot(tB) > 0.;
+          occ::handle<Geom2d_Curve> aPC;
+          try
+          {
+            OCC_CATCH_SIGNALS
+            aPC = GeomProjLib::Curve2d(Ca, fA, lA, Sb);
+          }
+          catch (Standard_Failure const&)
+          {
+            aPC.Nullify();
+          }
+          if (aPC.IsNull())
+          {
+            continue;
+          }
+          for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(
+                 DStr.ChangeSurfaceInterferences(b->Surf()));
+               it.More();
+               it.Next())
+          {
+            if (it.Value()->GeometryType() != TopOpeBRepDS_CURVE || it.Value()->Geometry() != cb)
+            {
+              continue;
+            }
+            it.ChangeValue()->Geometry(ca);
+            occ::handle<TopOpeBRepDS_SurfaceCurveInterference> aSCI =
+              occ::down_cast<TopOpeBRepDS_SurfaceCurveInterference>(it.Value());
+            if (!aSCI.IsNull())
+            {
+              aSCI->PCurve(aPC);
+            }
+            if (!aSame)
+            {
+              const TopAbs_Orientation anO = it.Value()->Transition().Orientation(TopAbs_IN);
+              it.ChangeValue()->ChangeTransition() = TopOpeBRepDS_Transition(TopAbs::Reverse(anO));
+            }
+          }
+          // (The face: A's curve on both sides, B's gone.)
+          NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& aOnFace =
+            DStr.ChangeShapeInterferences(a->Index(ka));
+          for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(aOnFace); it.More();)
+          {
+            if (it.Value()->GeometryType() == TopOpeBRepDS_CURVE && it.Value()->Geometry() == cb)
+            {
+              aOnFace.Remove(it);
+              continue;
+            }
+            if (it.Value()->GeometryType() == TopOpeBRepDS_CURVE && it.Value()->Geometry() == ca)
+            {
+              it.ChangeValue()->ChangeTransition() = TopOpeBRepDS_Transition(TopAbs_EXTERNAL);
+            }
+            it.Next();
+          }
+          DStr.ChangeCurveInterferences(cb).Clear();
+        }
+      }
+    }
+  }
+}
