+//=======================================================================
+// function : ChFi3d_PlaneOf
+// purpose  : Face F's plane and its outward normal N; false where F is not
+//            planar.
+//=======================================================================
+
+static bool ChFi3d_PlaneOf(const TopoDS_Face& F, gp_Pln& Pl, gp_Dir& N)
+{
+  const BRepAdaptor_Surface S(F, false);
+  if (S.GetType() != GeomAbs_Plane)
+  {
+    return false;
+  }
+  Pl = S.Plane();
+  N  = Pl.Axis().Direction();
+  if (!Pl.Position().Direct())
+  {
+    N.Reverse();
+  }
+  if (F.Orientation() == TopAbs_REVERSED)
+  {
+    N.Reverse();
+  }
+  return true;
+}
+
+//=======================================================================
+// function : ChFi3d_PCurveNear
+// purpose  : The curve on surface S of C (from F to L), its start moved by
+//            whole periods of S next to UV0; null where the projection
+//            fails.
+//=======================================================================
+
+static occ::handle<Geom2d_Curve> ChFi3d_PCurveNear(const occ::handle<Geom_Curve>&   C,
+                                                   const double                     F,
+                                                   const double                     L,
+                                                   const occ::handle<Geom_Surface>& S,
+                                                   const gp_Pnt2d&                  UV0)
+{
+  occ::handle<Geom2d_Curve> aPC;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    aPC = GeomProjLib::Curve2d(C, F, L, S);
+  }
+  catch (Standard_Failure const&)
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+  if (aPC.IsNull())
+  {
+    return aPC;
+  }
+  const gp_Pnt2d p0 = aPC->Value(F);
+  gp_Vec2d       aShift(0., 0.);
+  if (S->IsUPeriodic())
+  {
+    const double T = S->UPeriod();
+    aShift.SetX(T * std::round((UV0.X() - p0.X()) / T));
+  }
+  if (S->IsVPeriodic())
+  {
+    const double T = S->VPeriod();
+    aShift.SetY(T * std::round((UV0.Y() - p0.Y()) / T));
+  }
+  if (aShift.Magnitude() > 0.)
+  {
+    aPC->Translate(aShift);
+  }
+  return aPC;
+}
