+//=======================================================================
+// function : ChFi3d_ContactOnOwnEdgeAtEnd
+// purpose  : Whether the walk of Fd stopped, at its end (its start with
+//           isfirst) short of the spine's end vertex Vtx, where a contact
+//           reached the spine's own edge E there (an edge of the spine
+//           between Fd's two faces, holding Vtx), its section no wider
+//           than theWidth and both contacts within theReach of Vtx. In an
+//           exact geometry a contact never reaches the edge between its
+//           two faces; it does where the faces come tangent, their gap
+//           within E's tolerance moving the line where they meet sideways
+//           by that gap over their angle: the blend between the stop and
+//           Vtx, narrower than its last section, vanishes at Vtx.
+//=======================================================================
+
+static bool ChFi3d_ContactOnOwnEdgeAtEnd(const TopOpeBRepDS_DataStructure&   DStr,
+                                         const occ::handle<ChFiDS_SurfData>& Fd,
+                                         const bool                          isfirst,
+                                         const TopoDS_Vertex&                Vtx,
+                                         const occ::handle<ChFiDS_Spine>&    Spine,
+                                         const ChFiDS_Map&                   EFMap,
+                                         const double                        theRadius,
+                                         const double                        theReach)
+{
+  if (Spine.IsNull() || Fd->Index(1) <= 0 || Fd->Index(2) <= 0)
+  {
+    return false;
+  }
+  const TopoDS_Shape& aS1 = DStr.Shape(Fd->Index(1));
+  const TopoDS_Shape& aS2 = DStr.Shape(Fd->Index(2));
+  if (aS1.IsNull() || aS2.IsNull() || aS1.ShapeType() != TopAbs_FACE || aS2.ShapeType() != TopAbs_FACE)
+  {
+    return false;
+  }
+  const gp_Pnt PV = BRep_Tool::Pnt(Vtx);
+  const gp_Pnt P1 = Fd->Vertex(isfirst, 1).Point();
+  const gp_Pnt P2 = Fd->Vertex(isfirst, 2).Point();
+  if (P1.Distance(PV) > theReach || P2.Distance(PV) > theReach)
+  {
+    return false;
+  }
+  for (int k = 1; k <= 2; k++)
+  {
+    const ChFiDS_CommonPoint& CP = Fd->Vertex(isfirst, k);
+    if (!CP.IsOnArc() || CP.IsVertex() || !EFMap.Contains(CP.Arc()))
+    {
+      continue;
+    }
+    const TopoDS_Edge& E = CP.Arc();
+    bool               isSpine = false;
+    for (int i = 1; i <= Spine->NbEdges() && !isSpine; i++)
+    {
+      isSpine = Spine->Edges(i).IsSame(E);
+    }
+    bool hasV = false;
+    for (TopExp_Explorer ex(E, TopAbs_VERTEX); ex.More() && !hasV; ex.Next())
+    {
+      hasV = ex.Current().IsSame(Vtx);
+    }
+    bool on1 = false, on2 = false;
+    for (const TopoDS_Shape& aFace : EFMap.FindFromKey(E))
+    {
+      on1 = on1 || aFace.IsSame(aS1);
+      on2 = on2 || aFace.IsSame(aS2);
+    }
+    // (The section's width where a gap of E's tolerance between faces at
+    // an angle a moves their meeting line by tol / a, which the contacts,
+    // R a / 2 from it, reach: a^2 = 2 tol / R, the width R a.)
+    const double aWidth = std::sqrt(2. * theRadius * BRep_Tool::Tolerance(E));
+    if (isSpine && hasV && on1 && on2 && P1.Distance(P2) <= aWidth)
+    {
+      return true;
+    }
+  }
+  return false;
+}
