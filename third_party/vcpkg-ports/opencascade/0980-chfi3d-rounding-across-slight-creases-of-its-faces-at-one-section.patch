+  {
+    return false;
+  }
+  NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& LI = DStr.ChangeShapeInterferences(Iarc);
+  for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(LI); it.More();)
+  {
+    const occ::handle<TopOpeBRepDS_CurvePointInterference> aCPI =
+      occ::down_cast<TopOpeBRepDS_CurvePointInterference>(it.Value());
+    if (!aCPI.IsNull() && aCPI->Geometry() == Ipoin
+        && std::abs(aCPI->Parameter() - CPstart.ParameterOnArc()) < Precision::PConfusion())
+    {
+      LI.Remove(it);
+    }
+    else
+    {
+      it.Next();
+    }
+  }
+  LI.Append(ChFi3d_FilPointInDS(CPstart.TransitionOnArc(), Iarc, Ipoin, CPstart.ParameterOnArc(), IsVertex));
+  return true;
+}
