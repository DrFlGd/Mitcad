+
+static bool ChFi3d_LeavesOwnEdgeOnItsFace(TopOpeBRepDS_DataStructure&         DStr,
+                                          const occ::handle<ChFiDS_SurfData>& Prev,
+                                          const occ::handle<ChFiDS_SurfData>& Fd,
+                                          const int                           ons,
