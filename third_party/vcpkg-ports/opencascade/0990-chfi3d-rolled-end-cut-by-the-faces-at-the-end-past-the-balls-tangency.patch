+  // side 2, and on Fa, Be and B, which grow up to them.
+  const int          Isurf      = X1->Surf();
+  const TopAbs_Orientation orsurfdata = X1->Orientation();
+  TopAbs_Orientation trafil1    = TopAbs_FORWARD;
+  if (X1->IndexOfS1() > 0)
+  {
+    trafil1 = DStr.Shape(X1->IndexOfS1()).Orientation();
+  }
+  trafil1                           = TopAbs::Compose(trafil1, X1->Orientation());
+  trafil1                           = TopAbs::Compose(TopAbs::Reverse(X1->InterferenceOnS1().Transition()), trafil1);
+  const TopAbs_Orientation orcourbe = isFirst ? TopAbs::Reverse(trafil1) : trafil1;
+  const int                iA       = ChFi3d_IndexPointInDS(CPa, DStr);
+  const int                iT       = ChFi3d_IndexPointInDS(CPt, DStr);
+  Stripe->SetIndexPoint(iA, isFirst, ons);
+  Stripe->SetIndexPoint(iT, isFirst, opp);
+  const int iVA = DStr.AddShape(VAc);
+  const int iQ  = DStr.AddShape(VQ);
+  struct EndPt
+  {
+    int  I;
+    bool IsVertex;
+  };
+  const EndPt aPts[4] = {{iA, false}, {iVA, true}, {iQ, true}, {iT, false}};
+  for (int k = 0; k < 3; k++)
+  {
+    Cut&                     c   = aCuts[k];
+    // (The cuts run from side ons to side opp: from side 1 to side 2 where
+    // ons is 1.)
+    const TopAbs_Orientation oc  = ons == 1 ? orcourbe : TopAbs::Reverse(orcourbe);
+    const int                ic  = DStr.AddCurve(TopOpeBRepDS_Curve(c.C, std::max(c.Tol, tol3d)));
+    DStr.ChangeCurveInterferences(ic).Append(
+      ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, aPts[k].I, c.C->FirstParameter(), aPts[k].IsVertex));
+    DStr.ChangeCurveInterferences(ic).Append(
+      ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, aPts[k + 1].I, c.C->LastParameter(), aPts[k + 1].IsVertex));
+    DStr.ChangeSurfaceInterferences(Isurf).Append(ChFi3d_FilCurveInDS(ic, Isurf, c.PS, oc));
+    const TopAbs_Orientation orien = c.F.Orientation() == orsurfdata ? TopAbs::Reverse(oc) : oc;
+    ChFi3d_IntoPeriodOfFace(c.F, c.PF, c.C->FirstParameter(), c.C->LastParameter());
+    const int iF = DStr.AddShape(c.F);
+    DStr.ChangeShapeInterferences(iF).Append(ChFi3d_FilCurveInDS(ic, iF, c.PF, orien));
+  }
+  for (int k = 1; k <= aGrowth.Length(); k++)
+  {
+    ChFi3d_GrowthCurve g = aGrowth.Value(k);
+    ChFi3d_IntoPeriodOfFace(g.F1, g.PC1, g.First, g.Last);
+    ChFi3d_IntoPeriodOfFace(g.F2, g.PC2, g.First, g.Last);
+    const int ic = DStr.AddCurve(TopOpeBRepDS_Curve(new Geom_TrimmedCurve(g.C, g.First, g.Last), aTolV));
+    DStr.ChangeCurveInterferences(ic).Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, ic, DStr.AddShape(g.V1), g.First, true));
+    DStr.ChangeCurveInterferences(ic).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, ic, DStr.AddShape(g.V2), g.Last, true));
+    DStr.ChangeShapeInterferences(DStr.AddShape(g.F1)).Append(ChFi3d_FilCurveInDS(ic, DStr.AddShape(g.F1), g.PC1, g.Or1));
+    DStr.ChangeShapeInterferences(DStr.AddShape(g.F2)).Append(ChFi3d_FilCurveInDS(ic, DStr.AddShape(g.F2), g.PC2, g.Or2));
+  }
+  // Er is cut at E3, its part beyond E3 (away from T) kept; Enb bounds no face.
+  {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CEr = BRep_Tool::Curve(Er, f, l);
+    gp_Pnt                        Pe;
+    gp_Vec                        Te;
+    CEr->D1(wE3, Pe, Te);
+    const TopAbs_Orientation aTr = gp_Vec(Pe, PT).Dot(Te) > 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+    TopoDS_Edge              E   = Er;
+    E.Orientation(TopAbs_FORWARD);
+    const int IE = DStr.AddShape(E);
+    DStr.ChangeShapeInterferences(IE).Append(ChFi3d_FilPointInDS(aTr, IE, DStr.AddShape(VE3), wE3, true));
+  }
+  {
+    TopoDS_Edge E = Enb;
+    E.Orientation(TopAbs_FORWARD);
+    const int IE = DStr.AddShape(E);
+    for (TopExp_Explorer exV(E, TopAbs_VERTEX); exV.More(); exV.Next())
+    {
+      const TopoDS_Vertex& Vx = TopoDS::Vertex(exV.Current());
+      DStr.ChangeShapeInterferences(IE).Append(
+        ChFi3d_FilVertexInDS(TopAbs_EXTERNAL, IE, DStr.AddShape(Vx), BRep_Tool::Parameter(Vx, E)));
+    }
+  }
+  // The spine's edge at V lies under the blend up to V: cut at V with no
+  // side kept there.
+  {
+    TopoDS_Edge E = Es;
+    E.Orientation(TopAbs_FORWARD);
+    const int IE = DStr.AddShape(E);
+    DStr.ChangeShapeInterferences(IE).Append(
+      ChFi3d_FilVertexInDS(TopAbs_EXTERNAL, IE, DStr.AddShape(V), BRep_Tool::Parameter(V, E)));
+  }
+  // The end is made: no corner at V.
+  Stripe->InDS(isFirst);
+  return true;
+}
