+// The curve of surfaces S1 and S2 from P1 to P2: the branch of their
+// intersection lines that passes within Tol of both, from P1 to P2, with its
+// p-curves on both, and the largest gap found between the curve, its
+// p-curves' points and its ends' points (TolReached).
+static bool ChFi3d_CutBetween(const occ::handle<Geom_Surface>& S1,
+                              const occ::handle<Geom_Surface>& S2,
+                              const gp_Pnt&                    P1,
+                              const gp_Pnt&                    P2,
+                              const double                     Tol,
+                              occ::handle<Geom_Curve>&         C,
+                              occ::handle<Geom2d_Curve>&       PC1,
+                              occ::handle<Geom2d_Curve>&       PC2,
+                              double&                          TolReached)
+{
+  GeomAPI_IntSS anSS(S1, S2, Precision::Confusion());
+  if (!anSS.IsDone())
+  {
+    return false;
+  }
+  for (int k = 1; k <= anSS.NbLines(); k++)
+  {
+    const occ::handle<Geom_Curve>& L = anSS.Line(k);
+    GeomAPI_ProjectPointOnCurve    a(P1, L), b(P2, L);
+    if (a.NbPoints() == 0 || b.NbPoints() == 0 || a.LowerDistance() > Tol || b.LowerDistance() > Tol)
+    {
+      continue;
+    }
+    double w1 = a.LowerDistanceParameter(), w2 = b.LowerDistanceParameter();
+    if (L->IsPeriodic() && w2 < w1)
+    {
+      // (Along the line from P1 on, the shorter way round.)
+      const double T = L->Period();
+      if (w1 - w2 > 0.5 * T)
+      {
+        w2 += T;
+      }
+    }
+    if (std::abs(w2 - w1) <= Precision::PConfusion())
+    {
+      continue;
+    }
+    occ::handle<Geom_TrimmedCurve> aT = new Geom_TrimmedCurve(L, std::min(w1, w2), std::max(w1, w2));
+    if (w1 > w2)
+    {
+      aT->Reverse();
+    }
+    C                = aT;
+    const double f   = C->FirstParameter(), l = C->LastParameter();
+    PC1              = GeomProjLib::Curve2d(C, f, l, S1);
+    PC2              = GeomProjLib::Curve2d(C, f, l, S2);
+    if (PC1.IsNull() || PC2.IsNull())
+    {
+      continue;
+    }
+    TolReached = std::max(C->Value(f).Distance(P1), C->Value(l).Distance(P2));
+    for (int i = 0; i <= 20; i++)
+    {
+      const double   t  = f + (l - f) * i / 20.;
+      const gp_Pnt   P  = C->Value(t);
+      const gp_Pnt2d q1 = PC1->Value(t), q2 = PC2->Value(t);
+      TolReached        = std::max(TolReached, P.Distance(S1->Value(q1.X(), q1.Y())));
+      TolReached        = std::max(TolReached, P.Distance(S2->Value(q2.X(), q2.Y())));
+    }
+    return true;
+  }
+  return false;
+}
+
+// The branch of the intersection lines of surfaces S1 and S2 through P1 (within
+// Tol), from P1 to the end of the line toward Pnear (within Far of it): its
+// end PEnd.
+static bool ChFi3d_CutToLineEnd(const occ::handle<Geom_Surface>& S1,
+                                const occ::handle<Geom_Surface>& S2,
+                                const gp_Pnt&                    P1,
+                                const gp_Pnt&                    Pnear,
+                                const double                     Tol,
+                                const double                     Far,
+                                gp_Pnt&                          PEnd)
+{
+  GeomAPI_IntSS anSS(S1, S2, Precision::Confusion());
+  if (!anSS.IsDone())
+  {
+    return false;
+  }
+  double aBest = Far;
+  bool   found = false;
+  for (int k = 1; k <= anSS.NbLines(); k++)
+  {
+    const occ::handle<Geom_Curve>& L = anSS.Line(k);
+    if (L->IsPeriodic())
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnCurve a(P1, L);
+    if (a.NbPoints() == 0 || a.LowerDistance() > Tol)
+    {
+      continue;
+    }
+    for (const double w : {L->FirstParameter(), L->LastParameter()})
+    {
+      const gp_Pnt E = L->Value(w);
+      if (E.Distance(Pnear) < aBest && E.Distance(P1) > Tol)
+      {
+        aBest = E.Distance(Pnear);
+        PEnd  = E;
+        found = true;
+      }
+    }
+  }
+  return found;
+}
