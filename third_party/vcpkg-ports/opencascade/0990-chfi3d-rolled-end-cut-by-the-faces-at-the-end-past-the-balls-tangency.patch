+  if (isFirst)
+  {
+    while (aSeq.First() != P)
+    {
+      aGone.Append(aSeq.First()->Surf());
+      aSeq.Remove(1);
+    }
+    aSeq.Prepend(X1);
+  }
+  else
+  {
+    while (aSeq.Last() != P)
+    {
+      aGone.Append(aSeq.Last()->Surf());
+      aSeq.Remove(aSeq.Length());
+    }
+    aSeq.Append(X1);
+  }
+  // (X1's face is generated by the spine's edges P's is; the pieces left
+  // out generate none.)
+  for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+  {
+    if (NCollection_List<int>* aList = myEVIMap.ChangeSeek(Spine->Edges(ie)))
+    {
+      bool hasP = false;
+      for (NCollection_List<int>::Iterator it(*aList); it.More();)
+      {
+        bool gone = false;
+        for (NCollection_List<int>::Iterator itG(aGone); itG.More() && !gone; itG.Next())
+        {
+          gone = itG.Value() == it.Value();
+        }
+        hasP = hasP || it.Value() == P->Surf();
+        if (gone)
+        {
+          aList->Remove(it);
+        }
+        else
+        {
+          it.Next();
+        }
+      }
+      if (hasP)
+      {
+        aList->Append(X1->Surf());
+      }
+    }
+  }
