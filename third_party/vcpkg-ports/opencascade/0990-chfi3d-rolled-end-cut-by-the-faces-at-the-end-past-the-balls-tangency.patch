+// Parameters (u, v) on F's surface moved by periods into F's parameter box
+// where a direction is periodic.
+static void ChFi3d_IntoFaceRange(const TopoDS_Face& F, double& u, double& v)
+{
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+  if (S.IsNull())
+  {
+    return;
+  }
+  double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+  BRepTools::UVBounds(FF, u1, u2, v1, v2);
+  if (S->IsUPeriodic())
+  {
+    u = ElCLib::InPeriod(u, 0.5 * (u1 + u2) - 0.5 * S->UPeriod(), 0.5 * (u1 + u2) + 0.5 * S->UPeriod());
+  }
+  if (S->IsVPeriodic())
+  {
+    v = ElCLib::InPeriod(v, 0.5 * (v1 + v2) - 0.5 * S->VPeriod(), 0.5 * (v1 + v2) + 0.5 * S->VPeriod());
+  }
+}
+
+// A face on F's surface over F's parameter box widened by about Grow (in
+// 3d) on every side, less than a period across a periodic direction: F's
+// surface past F's bounds, for a walk that runs on beyond them.
+static TopoDS_Face ChFi3d_FaceWidened(const TopoDS_Face& F, const double Grow)
+{
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+  if (S.IsNull())
+  {
+    return TopoDS_Face();
+  }
+  double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+  BRepTools::UVBounds(FF, u1, u2, v1, v2);
+  const GeomAdaptor_Surface aGS(S);
+  const double              du = Grow * aGS.UResolution(1.), dv = Grow * aGS.VResolution(1.);
+  double                    a1 = u1 - du, a2 = u2 + du, b1 = v1 - dv, b2 = v2 + dv;
+  if (S->IsUPeriodic() && a2 - a1 >= S->UPeriod())
+  {
+    const double c = 0.5 * (u1 + u2), h = 0.5 * S->UPeriod() - 1.e-6;
+    a1             = c - h;
+    a2             = c + h;
+  }
+  if (S->IsVPeriodic() && b2 - b1 >= S->VPeriod())
+  {
+    const double c = 0.5 * (v1 + v2), h = 0.5 * S->VPeriod() - 1.e-6;
+    b1             = c - h;
+    b2             = c + h;
+  }
+  BRepLib_MakeFace aMk(S, a1, a2, b1, b2, Precision::Confusion());
+  if (!aMk.IsDone())
+  {
+    return TopoDS_Face();
+  }
+  TopoDS_Face aW = aMk.Face();
+  aW.Orientation(F.Orientation());
+  return aW;
+}
