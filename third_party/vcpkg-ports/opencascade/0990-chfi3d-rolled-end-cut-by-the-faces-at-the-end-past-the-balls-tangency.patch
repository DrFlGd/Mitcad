+//=======================================================================
+// function : RolledEndCutByEndFace
+// purpose  : An end (isFirst) of a stripe whose end piece P rolls on side
+//            opp on an edge Er of a face B while its contact on side ons,
+//            on face N, runs off across an edge A of N into the face Fa
+//            beyond near the end (any pieces past P walked on over Fa),
+//            the spine's end vertex V a vertex of three faces: N, the face
+//            Fref across Er from B (which the spine's edge bounds with N)
+//            and the face at the end, Be. Past V the faces at the end cut
+//            the blend: Fa from where the contact on N crosses A, Be, and
+//            B's surface where the blend's surface runs on past the point
+//            T where the ball comes tangent to B. The blend is walked
+//            again from P's middle with N's surface unbounded, rolling on
+//            Er up to T, its surface run on along its tangents, and cut by
+//            Fa, Be and B; Be grows up to the cut along its edges with
+//            Fref and Fa prolonged and its curve with B, which grows up to
+//            it as well. The stripe ends there with no corner at V.
+//            Returns false, changing nothing, where the end is not such.
+//=======================================================================
+
+bool ChFi3d_Builder::RolledEndCutByEndFace(const occ::handle<ChFiDS_Stripe>& Stripe, const bool isFirst)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (Spine.IsNull() || Spine->IsPeriodic() || Stripe->SetOfSurfData().IsNull()
+      || Stripe->SetOfSurfData()->IsEmpty() || Spine->ChangeElSpines().IsEmpty())
+  {
+    return false;
+  }
+  const ChFiDS_State aState = isFirst ? Spine->FirstStatus() : Spine->LastStatus();
+  if (aState != ChFiDS_OnSame && aState != ChFiDS_OnDiff && aState != ChFiDS_AllSame)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (fsp.IsNull() || !fsp->IsConstant())
+  {
+    return false;
+  }
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  const TopoDS_Vertex         V    = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (V.IsNull() || !myVFMap.Contains(V) || !myVEMap.Contains(V))
+  {
+    return false;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  const int                                           n    = aSeq.Length();
+  // P: from the end inwards, the first piece rolling on an edge on one side
+  // (opp) whose contact on the other side (ons) ends at its outer end on an
+  // edge A of its face N.
+  int iP = 0, ons = 0;
+  for (int step = 0; step < std::min(n, 3) && iP == 0; step++)
+  {
+    const int                           k  = isFirst ? 1 + step : n - step;
+    const occ::handle<ChFiDS_SurfData>& sd = aSeq.Value(k);
+    if (sd->IsOnCurve1() == sd->IsOnCurve2())
+    {
+      continue;
+    }
+    const int                 s  = sd->IsOnCurve1() ? 2 : 1;
+    const ChFiDS_CommonPoint& CP = sd->Vertex(isFirst, s);
+    if (!CP.IsOnArc() || CP.IsVertex() || sd->Index(s) <= 0 || sd->Index(3 - s) <= 0
+        || !myEFMap.Contains(CP.Arc()))
+    {
+      continue;
+    }
+    iP  = k;
+    ons = s;
+  }
+  if (iP == 0)
+  {
+    return false;
+  }
+  const int                          opp = 3 - ons;
+  const occ::handle<ChFiDS_SurfData> P   = aSeq.Value(iP);
+  const TopoDS_Edge                  A   = TopoDS::Edge(P->Vertex(isFirst, ons).Arc());
+  const TopoDS_Face                  N   = TopoDS::Face(DStr.Shape(P->Index(ons)));
+  const TopoDS_Face                  Fa  = otherFace(myEFMap, A, N);
+  const TopoDS_Face                  B   = TopoDS::Face(DStr.Shape(P->Index(opp)));
+  const TopoDS_Edge                  Er  = TopoDS::Edge(DStr.Shape(P->IndexOfC(opp)));
+  if (Fa.IsNull() || Er.IsNull() || !myEFMap.Contains(Er))
+  {
+    return false;
+  }
+  const TopoDS_Face Fref = otherFace(myEFMap, Er, B);
+  // The pieces past P were walked on over Fa (the contact on N went on
+  // across A).
+  for (int k = isFirst ? 1 : n; k != iP; k += isFirst ? 1 : -1)
+  {
+    const occ::handle<ChFiDS_SurfData>& sd = aSeq.Value(k);
+    if (sd->Index(ons) <= 0 || !DStr.Shape(sd->Index(ons)).IsSame(Fa))
+    {
+      return false;
+    }
+  }
+  // V: the spine's edge between N and Fref, and one more face Be, the face
+  // at the end.
+  const TopoDS_Edge Es = isFirst ? Spine->Edges(1) : Spine->Edges(Spine->NbEdges());
+  if (Fref.IsNull() || !otherFace(myEFMap, Es, N).IsSame(Fref))
+  {
+    return false;
+  }
+  TopoDS_Face Be;
+  int         nbF = 0;
+  {
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aFaces;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(myVFMap(V)); it.More(); it.Next())
+    {
+      if (!aFaces.Add(it.Value()))
+      {
+        continue;
+      }
+      nbF++;
+      if (!it.Value().IsSame(N) && !it.Value().IsSame(Fref))
+      {
+        Be = TopoDS::Face(it.Value());
+      }
+    }
+  }
+  if (nbF != 3 || Be.IsNull())
+  {
+    return false;
+  }
+  NCollection_List<occ::handle<ChFiDS_ElSpine>>::Iterator anItGuide(Spine->ChangeElSpines());
+  if (!isFirst)
+  {
+    for (int k = 1; k < Spine->ChangeElSpines().Extent(); k++)
+    {
+      anItGuide.Next();
+    }
+  }
+  occ::handle<ChFiDS_ElSpine>& HGuide = anItGuide.ChangeValue();
+  // (The walk starts from the middle of P: its section there is one of the
+  // blend rolling on Er, away from P's ends.)
+  const double WS = 0.5 * (P->FirstSpineParam() + P->LastSpineParam());
+  if (HGuide.IsNull() || WS < HGuide->FirstParameter() || WS > HGuide->LastParameter())
+  {
+    return false;
+  }
+  // 1. The blend walked again from the middle of P, N's surface unbounded,
+  // the ball rolling on Er up to where it comes tangent to B.
+  const occ::handle<Geom_Surface> SN = BRep_Tool::Surface(N);
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(B);
+  if (SN.IsNull() || SB.IsNull())
+  {
+    return false;
+  }
+  TopoDS_Face NF = ChFi3d_FaceWidened(N, 4. * fsp->Radius());
+  TopoDS_Face BU = ChFi3d_FaceWidened(B, 4. * fsp->Radius());
+  if (NF.IsNull() || BU.IsNull())
+  {
+    return false;
+  }
+  NF.Orientation(N.Orientation());
+  BU.Orientation(B.Orientation());
+  TopoDS_Face BF = B;
+  BF.Orientation(TopAbs_FORWARD);
+  const TopoDS_Edge ErB = edgeInFace(Er, BF);
+  if (ErB.IsNull())
+  {
+    return false;
+  }
+  occ::handle<BRepAdaptor_Surface>      HSN = new BRepAdaptor_Surface(NF);
+  occ::handle<BRepAdaptor_Surface>      HSB = new BRepAdaptor_Surface(B);
+  occ::handle<BRepAdaptor_Curve2d>      PCB = new BRepAdaptor_Curve2d(ErB, B);
+  occ::handle<BRepTopAdaptor_TopolTool> ItN = new BRepTopAdaptor_TopolTool(HSN);
+  occ::handle<BRepTopAdaptor_TopolTool> ItB = new BRepTopAdaptor_TopolTool(HSB);
+  TopAbs_Orientation                    OrN = NF.Orientation();
+  TopAbs_Orientation                    OrR = Fref.Orientation();
+  int                                   Choix;
+  if (ons == 1)
+  {
+    Choix = ChFi3d::NextSide(OrN, OrR, Stripe->OrientationOnFace1(), Stripe->OrientationOnFace2(), Stripe->Choix());
+  }
+  else
+  {
+    Choix = ChFi3d::NextSide(OrR, OrN, Stripe->OrientationOnFace1(), Stripe->OrientationOnFace2(), -Stripe->Choix());
+    Choix = Choix % 2 == 1 ? Choix + 1 : Choix - 1;
+  }
+  math_Vector Soldep(1, 3);
+  {
+    const ChFiDS_FaceInterference& FIn0 = P->Interference(ons);
+    const ChFiDS_FaceInterference& FIo0 = P->Interference(opp);
+    if (FIn0.LineIndex() <= 0 || FIo0.LineIndex() <= 0)
+    {
+      return false;
+    }
+    const double aT0  = WS;
+    const gp_Pnt aPn0 = DStr.Curve(FIn0.LineIndex()).Curve()->Value(aT0);
+    const gp_Pnt aPo0 = DStr.Curve(FIo0.LineIndex()).Curve()->Value(aT0);
+    GeomAPI_ProjectPointOnSurf aPr(aPn0, SN);
+    if (aPr.NbPoints() == 0)
+    {
+      return false;
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    ChFi3d_IntoFaceRange(NF, u, v);
+    Soldep(1) = u;
+    Soldep(2) = v;
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CEr = BRep_Tool::Curve(Er, f, l);
+    if (CEr.IsNull())
+    {
+      return false;
+    }
+    GeomAPI_ProjectPointOnCurve aPc(aPo0, CEr, f, l);
+    if (aPc.NbPoints() == 0)
+    {
+      return false;
+    }
+    Soldep(3) = aPc.LowerDistanceParameter();
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>> SeqSD;
+  const int                                           nbed    = Spine->NbEdges();
+  const double MaxStep = 0.05 * (Spine->LastParameter(nbed) - Spine->FirstParameter(1)) / nbed;
+  const double Fleche  = (HGuide->LastParameter() - HGuide->FirstParameter()) * fleche;
+  bool                     decroch    = false;
+  bool                     walked     = true;
+  const bool               doneSave   = done;
+  const ChFiDS_ErrorStatus stSave     = Spine->ErrorStatus();
+  const double             aGuideLast = HGuide->LastParameter();
+  double                   First = WS, Last = isFirst ? HGuide->FirstParameter() : HGuide->LastParameter();
+  // (The walk stops where the ball comes tangent to B; its section there is
+  // singular for the approximation, which then fails: the walk is made
+  // again up to a little before it.)
+  for (int aTry = 0; aTry < 2; aTry++)
+  {
+    SeqSD.Clear();
+    SeqSD.Append(new ChFiDS_SurfData());
+    decroch           = false;
+    walked            = true;
+    const double aEnd = isFirst ? First : Last;
+    First             = WS;
+    if (aTry == 0)
+    {
+      Last = isFirst ? HGuide->FirstParameter() : HGuide->LastParameter();
+    }
+    else
+    {
+      Last = aEnd + (isFirst ? 1. : -1.) * 1.e-3 * fsp->Radius();
+    }
+    if (isFirst)
+    {
+      HGuide->LastParameter(WS);
+    }
+    try
+    {
+      OCC_CATCH_SIGNALS
+      if (ons == 1)
+      {
+        PerformSurf(SeqSD, HGuide, Spine, Choix, HSN, ItN, OrN, HSB, ItB, PCB, HSB, PCB, decroch, MaxStep, Fleche,
+                    tolesp, First, Last, false, false, !isFirst, false, false, false, Soldep);
+      }
+      else
+      {
+        PerformSurf(SeqSD, HGuide, Spine, Choix, HSB, ItB, PCB, HSB, PCB, decroch, HSN, ItN, OrN, MaxStep, Fleche,
+                    tolesp, First, Last, false, false, !isFirst, false, false, false, Soldep);
+      }
+    }
+    catch (Standard_Failure const&)
+    {
+      walked = false;
+    }
+    done = doneSave;
+    Spine->SetErrorStatus(stSave);
+    HGuide->LastParameter(aGuideLast);
+    if (walked || std::abs((isFirst ? First : Last) - WS) <= 10. * tolesp)
+    {
+      break;
+    }
+  }
+  if (!walked || SeqSD.Length() != 1)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> X1 = SeqSD.First();
+  X1->ChangeIndexOfS1(DStr.AddShape(ons == 1 ? N : B));
+  X1->ChangeIndexOfS2(DStr.AddShape(ons == 1 ? B : N));
+  if (opp == 1)
+  {
+    X1->SetIndexOfC1(DStr.AddShape(Er));
+  }
+  else
+  {
+    X1->SetIndexOfC2(DStr.AddShape(Er));
+  }
+  // (X1's curves on N and B in the periods of P's, which it goes on from: the
+  // walk over N's surface unbounded may have taken another period.)
+  for (int s = 1; s <= 2; s++)
+  {
+    ChFiDS_FaceInterference&       FX = X1->ChangeInterference(s);
+    const ChFiDS_FaceInterference& FP = P->Interference(s);
+    if (FX.PCurveOnFace().IsNull() || FP.PCurveOnFace().IsNull() || P->Index(s) <= 0)
+    {
+      return false;
+    }
+    TopoDS_Face FF = TopoDS::Face(DStr.Shape(P->Index(s)));
+    FF.Orientation(TopAbs_FORWARD);
+    const occ::handle<Geom_Surface> S  = BRep_Tool::Surface(FF);
+    const gp_Pnt2d                  a  = FP.PCurveOnFace()->Value(WS);
+    const gp_Pnt2d                  b  = FX.PCurveOnFace()->Value(FX.Parameter(!isFirst));
+    double                          du = 0., dv = 0.;
+    if (S->IsUPeriodic())
+    {
+      du = S->UPeriod() * std::round((a.X() - b.X()) / S->UPeriod());
+    }
+    if (S->IsVPeriodic())
+    {
+      dv = S->VPeriod() * std::round((a.Y() - b.Y()) / S->VPeriod());
+    }
+    if (du != 0. || dv != 0.)
+    {
+      occ::handle<Geom2d_Curve> aPC = occ::down_cast<Geom2d_Curve>(FX.PCurveOnFace()->Copy());
+      aPC->Translate(gp_Vec2d(du, dv));
+      FX.ChangePCurveOnFace() = aPC;
+    }
+  }
+  const double WX0 = isFirst ? X1->LastSpineParam() : X1->FirstSpineParam();
+  const double WX1 = isFirst ? X1->FirstSpineParam() : X1->LastSpineParam();
+  if (std::abs(WX0 - WS) > 10. * tolesp || (isFirst ? WS - WX1 : WX1 - WS) <= 10. * tolesp)
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& XCn = X1->Interference(ons);
+  const ChFiDS_FaceInterference& XCo = X1->Interference(opp);
+  if (XCn.LineIndex() <= 0 || XCo.LineIndex() <= 0 || XCn.PCurveOnSurf().IsNull() || XCo.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const double tol3d = tolapp3d;
+  // 3. X1's surface run on past its outer end along its tangents (the
+  // blend's surface the faces at the end cut).
+  occ::handle<Geom_BSplineSurface> aS;
+  {
+    const occ::handle<Geom_BSplineSurface> aBS =
+      occ::down_cast<Geom_BSplineSurface>(DStr.Surface(X1->Surf()).Surface());
+    if (aBS.IsNull())
+    {
+      return false;
+    }
+    double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+    aBS->Bounds(u1, u2, v1, v2);
+    const gp_Pnt2d uvO   = XCo.PCurveOnSurf()->Value(XCo.Parameter(isFirst));
+    const bool     after = std::abs(uvO.Y() - v2) < std::abs(uvO.Y() - v1);
+    occ::handle<Geom_BoundedSurface> aExt = occ::down_cast<Geom_BSplineSurface>(aBS->Copy());
+    GeomLib::ExtendSurfByLength(aExt, fsp->Radius(), 1, false, after);
+    aS = occ::down_cast<Geom_BSplineSurface>(aExt);
+    if (aS.IsNull())
+    {
+      return false;
+    }
+    // (The part walked keeps its parameters.)
+    const gp_Pnt2d uvN = XCn.PCurveOnSurf()->Value(XCn.Parameter(!isFirst));
+    if (aS->Value(uvO.X(), uvO.Y()).Distance(aBS->Value(uvO.X(), uvO.Y())) > tol3d
+        || aS->Value(uvN.X(), uvN.Y()).Distance(aBS->Value(uvN.X(), uvN.Y())) > tol3d)
+    {
+      return false;
+    }
+  }
+  const occ::handle<GeomAdaptor_Surface> HS = new GeomAdaptor_Surface(aS);
+  // 4. The points of the cut: A1 where the contact on N crosses A into Fa,
+  // VA where the cut by Fa meets Be (on the line of their edge Efb at A's
+  // vertex on Be), Q where the cut by Be meets B (on their surfaces'
+  // intersection), T where the contact on Er ends (the ball comes tangent
+  // to B), and E3 where Er crosses Be's surface.
+  TopoDS_Vertex VA;
+  for (TopExp_Explorer exV(A, TopAbs_VERTEX); exV.More() && VA.IsNull(); exV.Next())
+  {
+    for (TopExp_Explorer exB(Be, TopAbs_VERTEX); exB.More(); exB.Next())
+    {
+      if (exB.Current().IsSame(exV.Current()))
+      {
+        VA = TopoDS::Vertex(exV.Current());
+        break;
+      }
+    }
+  }
+  if (VA.IsNull() || !myVEMap.Contains(VA))
+  {
+    return false;
+  }
+  TopoDS_Edge Efb, Enb;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(myVEMap(VA)); it.More(); it.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(it.Value());
+    if (!myEFMap.Contains(Ec))
+    {
+      continue;
+    }
+    bool onFa = false, onBe = false, onN = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator itf(myEFMap(Ec)); itf.More(); itf.Next())
+    {
+      onFa = onFa || itf.Value().IsSame(Fa);
+      onBe = onBe || itf.Value().IsSame(Be);
+      onN  = onN || itf.Value().IsSame(N);
+    }
+    if (onFa && onBe)
+    {
+      Efb = Ec;
+    }
+    if (onN && onBe)
+    {
+      Enb = Ec;
+    }
+  }
+  // (Enb, the edge of N and Be, runs from VA to V: the blend takes it.)
+  if (Efb.IsNull() || Enb.IsNull() || TopExp::FirstVertex(Enb).IsSame(TopExp::LastVertex(Enb)))
+  {
+    return false;
+  }
+  {
+    bool atV = false;
+    for (TopExp_Explorer exV(Enb, TopAbs_VERTEX); exV.More(); exV.Next())
+    {
+      atV = atV || exV.Current().IsSame(V);
+    }
+    if (!atV)
+    {
+      return false;
+    }
+  }
+  // Ewall: the edge of Fref and Be at V.
+  TopoDS_Edge Ewall;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(myVEMap(V)); it.More(); it.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(it.Value());
+    if (!myEFMap.Contains(Ec))
+    {
+      continue;
+    }
+    bool onR = false, onBe = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator itf(myEFMap(Ec)); itf.More(); itf.Next())
+    {
+      onR  = onR || itf.Value().IsSame(Fref);
+      onBe = onBe || itf.Value().IsSame(Be);
+    }
+    if (onR && onBe)
+    {
+      Ewall = Ec;
+    }
+  }
+  if (Ewall.IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface> SFa = BRep_Tool::Surface(Fa);
+  const occ::handle<Geom_Surface> SBe = BRep_Tool::Surface(Be);
+  // A1.
+  double tA = 0.;
+  gp_Pnt PA1;
+  {
+    const occ::handle<Geom_Curve>& CN = DStr.Curve(XCn.LineIndex()).Curve();
+    GeomAPI_IntCS                  anCS(CN, SFa);
+    double                         aBest = RealLast();
+    for (int k = 1; anCS.IsDone() && k <= anCS.NbPoints(); k++)
+    {
+      double u = 0., v = 0., w = 0.;
+      anCS.Parameters(k, u, v, w);
+      if (w < std::min(XCn.FirstParameter(), XCn.LastParameter()) - Precision::PConfusion()
+          || w > std::max(XCn.FirstParameter(), XCn.LastParameter()) + Precision::PConfusion())
+      {
+        continue;
+      }
+      // (The crossing nearest the outer end.)
+      const double d = std::abs(w - XCn.Parameter(isFirst));
+      if (d < aBest)
+      {
+        aBest = d;
+        tA    = w;
+        PA1   = anCS.Point(k);
+      }
+    }
+    if (aBest == RealLast())
+    {
+      return false;
+    }
+  }
+  double wA = 0., dA = 0.;
+  {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CA = BRep_Tool::Curve(A, f, l);
+    GeomAPI_ProjectPointOnCurve   aPr(PA1, CA, f, l);
+    if (CA.IsNull() || aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+    {
+      return false;
+    }
+    wA = aPr.LowerDistanceParameter();
+    dA = aPr.LowerDistance();
+  }
+  // The point of the extended surface on a curve, nearest Near.
+  const auto onSurface = [&](const occ::handle<Geom_Curve>& C, const gp_Pnt& Near, gp_Pnt& P) {
+    GeomAPI_IntCS anCS(C, aS);
+    double        aBest = RealLast();
+    for (int k = 1; anCS.IsDone() && k <= anCS.NbPoints(); k++)
+    {
+      const double d = anCS.Point(k).Distance(Near);
+      if (d < aBest)
+      {
+        aBest = d;
+        P     = anCS.Point(k);
+      }
+    }
+    return aBest < fsp->Radius();
+  };
+  gp_Pnt PVA;
+  {
+    double                        f = 0., l = 0.;
+    occ::handle<Geom_Curve>       Cfb = BRep_Tool::Curve(Efb, f, l);
+    while (!Cfb.IsNull() && Cfb->IsKind(STANDARD_TYPE(Geom_TrimmedCurve)))
+    {
+      Cfb = occ::down_cast<Geom_TrimmedCurve>(Cfb)->BasisCurve();
+    }
+    if (Cfb.IsNull() || !onSurface(Cfb, BRep_Tool::Pnt(VA), PVA))
+    {
+      return false;
+    }
+  }
+  gp_Pnt PE3;
+  double wE3 = 0.;
+  {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CEr = BRep_Tool::Curve(Er, f, l);
+    GeomAPI_IntCS                 anCS(CEr, SBe);
+    bool                          found = false;
+    for (int k = 1; anCS.IsDone() && k <= anCS.NbPoints() && !found; k++)
+    {
+      double u = 0., v = 0., w = 0.;
+      anCS.Parameters(k, u, v, w);
+      if (w > f + Precision::PConfusion() && w < l - Precision::PConfusion())
+      {
+        found = true;
+        wE3   = w;
+        PE3   = anCS.Point(k);
+      }
+    }
+    if (!found)
+    {
+      return false;
+    }
+  }
+  gp_Pnt PQ;
+  {
+    GeomAPI_IntSS anSS(BRep_Tool::Surface(B), SBe, Precision::Confusion());
+    double        aBest = RealLast();
+    for (int k = 1; anSS.IsDone() && k <= anSS.NbLines(); k++)
+    {
+      gp_Pnt P;
+      if (onSurface(anSS.Line(k), PE3, P) && P.Distance(PE3) < aBest)
+      {
+        aBest = P.Distance(PE3);
+        PQ    = P;
+      }
+    }
+    if (aBest == RealLast())
+    {
+      return false;
+    }
+  }
+  // T: where the cut by B (their intersection through Q) ends on the
+  // contact on Er, the ball tangent to B there (about where the walk ended).
+  gp_Pnt PT = X1->Vertex(isFirst, opp).Point();
+  {
+    gp_Pnt PEnd;
+    if (ChFi3d_CutToLineEnd(aS, BRep_Tool::Surface(B), PQ, PT, 100. * tol3d, 0.1 * fsp->Radius(), PEnd))
+    {
+      PT = PEnd;
+    }
+  }
+  double tT = XCo.Parameter(isFirst);
+  {
+    const occ::handle<Geom_Curve>& CO = DStr.Curve(XCo.LineIndex()).Curve();
+    GeomAPI_ProjectPointOnCurve    aPr(PT, CO, std::min(XCo.FirstParameter(), XCo.LastParameter()), std::max(XCo.FirstParameter(), XCo.LastParameter()));
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 100. * tol3d)
+    {
+      return false;
+    }
+    tT = aPr.LowerDistanceParameter();
+  }
+  double                    wT  = 0.;
+  {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CEr = BRep_Tool::Curve(Er, f, l);
+    GeomAPI_ProjectPointOnCurve   aPr(PT, CEr, f, l);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+    {
+      return false;
+    }
+    wT = aPr.LowerDistanceParameter();
+  }
+  // T lies between E3 and the stripe on Er, and Q off Er towards the cut.
+  if (PQ.Distance(PE3) > fsp->Radius() || PT.Distance(PE3) <= tol3d || PVA.Distance(PQ) <= tol3d)
+  {
+    return false;
+  }
+  // 5. The cut's curves on the blend and on Fa, Be and B, from side 1 to
+  // side 2 (as the stripe's ends run).
+  BRep_Builder  BB;
+  const double  aTolV     = 10. * tol3d;
+  const bool    aVAisOwn  = PVA.Distance(BRep_Tool::Pnt(VA)) <= std::max(aTolV, BRep_Tool::Tolerance(VA));
+  TopoDS_Vertex VAc       = VA;
+  if (!aVAisOwn)
+  {
+    BB.MakeVertex(VAc, PVA, aTolV);
+  }
+  TopoDS_Vertex VQ, VE3;
+  BB.MakeVertex(VQ, PQ, aTolV);
+  BB.MakeVertex(VE3, PE3, aTolV);
+  const TopoDS_Face FaW = ChFi3d_FaceWidened(Fa, fsp->Radius());
+  const TopoDS_Face BeW = ChFi3d_FaceWidened(Be, fsp->Radius());
+  const TopoDS_Face BW  = ChFi3d_FaceWidened(B, fsp->Radius());
+  if (FaW.IsNull() || BeW.IsNull() || BW.IsNull())
+  {
+    return false;
+  }
+  struct Cut
+  {
+    TopoDS_Face               F;  // the face the cut lies on
+    TopoDS_Face               FW; // its surface widened
+    gp_Pnt                    P1, P2;
+    occ::handle<Geom_Curve>   C;
+    occ::handle<Geom2d_Curve> PS, PF;
+    double                    Tol = 0.;
+  };
+  Cut aCuts[3];
+  aCuts[0].F  = Fa;
+  aCuts[0].FW = FaW;
+  aCuts[0].P1 = PA1;
+  aCuts[0].P2 = aVAisOwn ? BRep_Tool::Pnt(VA) : PVA;
+  aCuts[1].F  = Be;
+  aCuts[1].FW = BeW;
+  aCuts[1].P1 = aCuts[0].P2;
+  aCuts[1].P2 = PQ;
+  aCuts[2].F  = B;
+  aCuts[2].FW = BW;
+  aCuts[2].P1 = PQ;
+  aCuts[2].P2 = PT;
+  for (Cut& c : aCuts)
+  {
+    occ::handle<BRepAdaptor_Surface> HF = new BRepAdaptor_Surface(c.FW);
+    NCollection_Array1<double>       Pardeb(1, 4), Parfin(1, 4);
+    for (int k = 0; k < 2; k++)
+    {
+      const gp_Pnt&              P = k == 0 ? c.P1 : c.P2;
+      GeomAPI_ProjectPointOnSurf aPrS(P, aS);
+      GeomAPI_ProjectPointOnSurf aPrF(P, BRep_Tool::Surface(c.FW));
+      if (aPrS.NbPoints() == 0 || aPrF.NbPoints() == 0)
+      {
+        return false;
+      }
+      double us = 0., vs = 0., uf = 0., vf = 0.;
+      aPrS.LowerDistanceParameters(us, vs);
+      aPrF.LowerDistanceParameters(uf, vf);
+      ChFi3d_IntoFaceRange(c.FW, uf, vf);
+      NCollection_Array1<double>& Par = k == 0 ? Pardeb : Parfin;
+      Par(1)                          = us;
+      Par(2)                          = vs;
+      Par(3)                          = uf;
+      Par(4)                          = vf;
+    }
+    bool computed = false;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      computed = ChFi3d_CutBetween(aS, BRep_Tool::Surface(c.FW), c.P1, c.P2, 10. * aTolV, c.C, c.PS, c.PF, c.Tol);
+      if (!computed)
+      {
+        computed = ChFi3d_ComputeCurves(HS, HF, Pardeb, Parfin, c.C, c.PS, c.PF, tol3d, tol2d, c.Tol, true);
+      }
+    }
+    catch (Standard_Failure const&)
+    {
+      computed = false;
+    }
+    if (!computed || c.C.IsNull() || c.PS.IsNull() || c.PF.IsNull())
+    {
+      return false;
+    }
+  }
+  // 6. The growth of the faces at the end: Be up to the cut along the
+  // prolongations of its edges with Fref (Ewall, from V to E3) and with Fa
+  // (Efb, from VA to the cut's point on its line, where that is not VA),
+  // and its curve with B from E3 to Q, which B grows up to as well (B and
+  // Be meet across a concave crease there: the blend took the material in
+  // front of both).
+  NCollection_Sequence<ChFi3d_GrowthCurve> aGrowth;
+  const auto aLineGrowth = [&](const TopoDS_Edge&   E,
+                               const TopoDS_Face&   F1,
+                               const TopoDS_Face&   F2,
+                               const TopoDS_Vertex& V1,
+                               const TopoDS_Vertex& V2) {
+    ChFi3d_GrowthCurve g;
+    if (!ChFi3d_SegmentOnFaces(F1, F2, V1, V2, g))
+    {
+      return false;
+    }
+    g.Along = E;
+    aGrowth.Append(g);
+    return true;
+  };
+  if (!aLineGrowth(Ewall, Fref, Be, V, VE3))
+  {
+    return false;
+  }
+  if (!aVAisOwn && !aLineGrowth(Efb, Fa, Be, VA, VAc))
+  {
+    return false;
+  }
+  {
+    ChFi3d_GrowthCurve g;
+    if (!ChFi3d_FacesCurve(B, Be, VE3, VQ, aTolV, g) && !ChFi3d_FacesCurveByPoints(B, Be, VE3, VQ, aTolV, g))
+    {
+      return false;
+    }
+    g.Concave = true;
+    aGrowth.Append(g);
+  }
+  // 7. Each growth curve bounds both its faces on the sides they keep (as
+  // in ChamferCutByFacesBeyond).
+  const auto outwardSign = [&](const TopoDS_Face& F, double& sgnOut) {
+    TopoDS_Face FF = F;
+    FF.Orientation(TopAbs_FORWARD);
+    const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+    BRepTopAdaptor_FClass2d         cl(FF, Precision::PConfusion());
+    double                          u0, u1, v0, v1;
+    BRepTools::UVBounds(FF, u0, u1, v0, v1);
+    for (int a = 1; a < 8; a++)
+    {
+      for (int b = 1; b < 8; b++)
+      {
+        const gp_Pnt2d uv(u0 + (u1 - u0) * a / 8., v0 + (v1 - v0) * b / 8.);
+        if (cl.Perform(uv) != TopAbs_IN)
+        {
+          continue;
+        }
+        gp_Pnt P;
+        gp_Vec Du, Dv;
+        S->D1(uv.X(), uv.Y(), P, Du, Dv);
+        gp_Vec Nn = Du.Crossed(Dv);
+        if (Nn.Magnitude() <= gp::Resolution())
+        {
+          continue;
+        }
+        Nn.Normalize();
+        BRepClass3d_SolidClassifier aSC(myShape, P.Translated(Nn * 1.e-3), 1.e-5);
+        BRepClass3d_SolidClassifier aSC2(myShape, P.Translated(Nn * -1.e-3), 1.e-5);
+        if (aSC.State() == TopAbs_OUT && aSC2.State() == TopAbs_IN)
+        {
+          sgnOut = 1.;
+          return true;
+        }
+        if (aSC.State() == TopAbs_IN && aSC2.State() == TopAbs_OUT)
+        {
+          sgnOut = -1.;
+          return true;
+        }
+      }
+    }
+    return false;
+  };
+  for (int k = 1; k <= aGrowth.Length(); k++)
+  {
+    ChFi3d_GrowthCurve& g = aGrowth.ChangeValue(k);
+    if (!g.Along.IsNull())
+    {
+      // (A prolongation of an edge: each face on that edge's side, the
+      // curve's direction against the edge's where it runs back.)
+      double                        f = 0., l = 0.;
+      const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(g.Along, f, l);
+      GeomAPI_ProjectPointOnCurve   aPr(BRep_Tool::Pnt(g.V1), aCE, f, l);
+      if (aCE.IsNull() || aPr.NbPoints() == 0)
+      {
+        return false;
+      }
+      gp_Pnt PE, PG;
+      gp_Vec TE, TG;
+      aCE->D1(aPr.LowerDistanceParameter(), PE, TE);
+      g.C->D1(g.First, PG, TG);
+      const bool aSameDir = TE.Dot(TG) > 0.;
+      for (int side = 1; side <= 2; side++)
+      {
+        TopoDS_Face FF = side == 1 ? g.F1 : g.F2;
+        FF.Orientation(TopAbs_FORWARD);
+        TopAbs_Orientation anOr = TopAbs_FORWARD;
+        for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+        {
+          if (ex.Current().IsSame(g.Along))
+          {
+            anOr = ex.Current().Orientation();
+          }
+        }
+        (side == 1 ? g.Or1 : g.Or2) = aSameDir ? anOr : TopAbs::Reverse(anOr);
+      }
+      continue;
+    }
+    double s1 = 0., s2 = 0.;
+    if (!outwardSign(g.F1, s1) || !outwardSign(g.F2, s2))
+    {
+      return false;
+    }
+    const double tm = 0.5 * (g.First + g.Last);
+    for (int side = 1; side <= 2; side++)
+    {
+      const TopoDS_Face&               F  = side == 1 ? g.F1 : g.F2;
+      const TopoDS_Face&               Fo = side == 1 ? g.F2 : g.F1;
+      const double                     sO = side == 1 ? s2 : s1;
+      const occ::handle<Geom2d_Curve>& PC = side == 1 ? g.PC1 : g.PC2;
+      TopoDS_Face                      FF = F;
+      FF.Orientation(TopAbs_FORWARD);
+      const occ::handle<Geom_Surface> S = BRep_Tool::Surface(FF);
+      gp_Pnt2d                        uv;
+      gp_Vec2d                        duv;
+      PC->D1(tm, uv, duv);
+      if (duv.Magnitude() <= gp::Resolution())
+      {
+        return false;
+      }
+      gp_Vec2d aLeft(-duv.Y(), duv.X());
+      aLeft.Normalize();
+      double aStep = 1.e-3;
+      {
+        gp_Pnt Qp;
+        gp_Vec Du, Dv;
+        S->D1(uv.X(), uv.Y(), Qp, Du, Dv);
+        const double aSpeed = (Du * aLeft.X() + Dv * aLeft.Y()).Magnitude();
+        if (aSpeed > gp::Resolution())
+        {
+          aStep = 10. * aTolV / aSpeed;
+        }
+      }
+      const gp_Pnt2d uvL = uv.Translated(aLeft * aStep);
+      const gp_Pnt   Pl  = S->Value(uvL.X(), uvL.Y());
+      bool           out = false;
+      {
+        TopoDS_Face FoF = Fo;
+        FoF.Orientation(TopAbs_FORWARD);
+        const occ::handle<Geom2d_Curve>& PCo = side == 1 ? g.PC2 : g.PC1;
+        const gp_Pnt2d                   uvo = PCo->Value(tm);
+        gp_Pnt                           Qo;
+        gp_Vec                           Duo, Dvo;
+        BRep_Tool::Surface(FoF)->D1(uvo.X(), uvo.Y(), Qo, Duo, Dvo);
+        out = gp_Vec(Qo, Pl).Dot(Duo.Crossed(Dvo)) * sO > 0.;
+      }
+      const bool keep             = g.Concave ? out : !out;
+      (side == 1 ? g.Or1 : g.Or2) = keep ? TopAbs_FORWARD : TopAbs_REVERSED;
+    }
+  }
+  // 8. The stripe: P up to X1's start, X1 from there, the pieces past P
+  // left out.
+  for (int s = 1; s <= 2; s++)
+  {
+    ChFiDS_FaceInterference& FI = P->ChangeInterference(s);
+    if (isFirst)
+    {
+      FI.SetFirstParameter(X1->Interference(s).Parameter(false));
+    }
+    else
+    {
+      FI.SetLastParameter(X1->Interference(s).Parameter(true));
+    }
+    P->ChangeVertex(isFirst, s) = X1->Vertex(!isFirst, s);
+  }
+  if (isFirst)
+  {
+    P->FirstSpineParam(WX0);
+  }
+  else
+  {
+    P->LastSpineParam(WX0);
+  }
+  // X1's end: its contact on N up to A1 on A (the part of A from A1 to VA
+  // goes with N), on Er up to T (Er leaves the boundaries on both sides).
+  TopAbs_Orientation TrA = TopAbs_FORWARD;
+  {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> CA = BRep_Tool::Curve(A, f, l);
+    gp_Pnt                        Pa;
+    gp_Vec                        Ta;
+    CA->D1(wA, Pa, Ta);
+    TrA = gp_Vec(Pa, BRep_Tool::Pnt(VA)).Dot(Ta) > 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+  }
+  ChFiDS_CommonPoint CPa;
+  CPa.SetPoint(PA1);
+  CPa.SetArc(std::max(tol3d, 1.5 * dA), A, wA, TrA);
+  ChFiDS_CommonPoint CPt;
+  CPt.SetPoint(PT);
+  CPt.SetArc(tol3d, Er, wT, TopAbs_EXTERNAL);
+  X1->ChangeVertex(isFirst, ons) = CPa;
+  X1->ChangeVertex(isFirst, opp) = CPt;
+  if (isFirst)
+  {
+    X1->ChangeInterference(ons).SetFirstParameter(tA);
+    X1->ChangeInterference(opp).SetFirstParameter(tT);
+  }
+  else
+  {
+    X1->ChangeInterference(ons).SetLastParameter(tA);
+    X1->ChangeInterference(opp).SetLastParameter(tT);
+  }
+  DStr.ChangeSurface(X1->Surf()) = TopOpeBRepDS_Surface(aS, DStr.Surface(X1->Surf()).Tolerance());
