+// Whether edge E bounds both faces F1 and F2 (as the map of the edges to
+// their faces holds them).
+static bool ChFi3d_EdgeOfFaces(const ChFiDS_Map&  EFMap,
+                               const TopoDS_Edge& E,
+                               const TopoDS_Face& F1,
+                               const TopoDS_Face& F2)
+{
+  if (E.IsNull() || F1.IsNull() || F2.IsNull() || !EFMap.Contains(E))
+  {
+    return false;
+  }
+  bool on1 = false, on2 = false;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+  {
+    on1 = on1 || it.Value().IsSame(F1);
+    on2 = on2 || it.Value().IsSame(F2);
+  }
+  return on1 && on2;
+}
