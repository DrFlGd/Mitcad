+//=======================================================================
+// function : ChFi3d_ContinueGrownFaces
+// purpose  : A face of the result that runs past the bounds of its B-spline
+//            surface, where the faces beyond a narrow face grew down to a
+//            chamfer along their sections continued straight
+//            (ChFi3d_WideSurface, ChamferCutByFacesBeyond): its surface
+//            continued so, its parameters kept, up to the face's bounds.
+//            Its curves and its points are where they were; the face's
+//            parameters then lie inside its surface's.
+//=======================================================================
+
+static void ChFi3d_ContinueGrownFaces(const TopoDS_Shape& S)
+{
+  BRep_Builder                                           B;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aDone;
+  for (TopExp_Explorer ex(S, TopAbs_FACE); ex.More(); ex.Next())
+  {
+    const TopoDS_Face& F = TopoDS::Face(ex.Current());
+    if (!aDone.Add(F))
+    {
+      continue;
+    }
+    TopLoc_Location                        L;
+    const occ::handle<Geom_Surface>&       SF = BRep_Tool::Surface(F, L);
+    const occ::handle<Geom_BSplineSurface> BS = occ::down_cast<Geom_BSplineSurface>(SF);
+    if (BS.IsNull() || BS->IsURational() || BS->IsVRational())
+    {
+      continue;
+    }
+    double u0 = 0., u1 = 0., v0 = 0., v1 = 0.;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      BRepTools::UVBounds(F, u0, u1, v0, v1);
+    }
+    catch (Standard_Failure const&)
+    {
+      continue;
+    }
+    occ::handle<Geom_BSplineSurface> W;
+    for (const bool inU : {true, false})
+    {
+      if ((inU ? BS->UDegree() : BS->VDegree()) != 1 || (inU ? BS->IsUPeriodic() : BS->IsVPeriodic()))
+      {
+        continue;
+      }
+      const double lo = inU ? u0 : v0, hi = inU ? u1 : v1;
+      for (const bool atFirst : {true, false})
+      {
+        const occ::handle<Geom_BSplineSurface>& C  = W.IsNull() ? BS : W;
+        const int                               nk = inU ? C->NbUKnots() : C->NbVKnots();
+        const int                               np = inU ? C->NbUPoles() : C->NbVPoles();
+        const int                               no = inU ? C->NbVPoles() : C->NbUPoles();
+        const int                               k0 = atFirst ? 1 : nk, k1 = atFirst ? 2 : nk - 1;
+        const double ku0 = inU ? C->UKnot(k0) : C->VKnot(k0), ku1 = inU ? C->UKnot(k1) : C->VKnot(k1);
+        const double aTo = atFirst ? lo : hi;
+        if (atFirst ? aTo >= ku0 - Precision::PConfusion() : aTo <= ku0 + Precision::PConfusion())
+        {
+          continue;
+        }
+        if (W.IsNull())
+        {
+          W = occ::down_cast<Geom_BSplineSurface>(BS->Copy());
+        }
+        // (The end row moved along the span's lines, linearly in the
+        // parameter, to the face's bound.)
+        const double t  = (aTo - ku0) / (ku0 - ku1);
+        const int    i0 = atFirst ? 1 : np, i1 = atFirst ? 2 : np - 1;
+        for (int j = 1; j <= no; j++)
+        {
+          const gp_Pnt P0 = inU ? W->Pole(i0, j) : W->Pole(j, i0);
+          const gp_Pnt P1 = inU ? W->Pole(i1, j) : W->Pole(j, i1);
+          const gp_Pnt Pn = P0.Translated(gp_Vec(P1, P0) * t);
+          if (inU)
+          {
+            W->SetPole(i0, j, Pn);
+          }
+          else
+          {
+            W->SetPole(j, i0, Pn);
+          }
+        }
+        if (inU)
+        {
+          W->SetUKnot(k0, aTo);
+        }
+        else
+        {
+          W->SetVKnot(k0, aTo);
+        }
+      }
+    }
+    if (W.IsNull())
+    {
+      continue;
+    }
+    // (The edges' curves on the face, kept on the surface as continued: an
+    // edge's curve on a face is stored with the face's surface.)
+    struct OnFace
+    {
+      TopoDS_Edge               E;
+      occ::handle<Geom2d_Curve> C1, C2;
+      double                    First = 0., Last = 0., Tol = 0.;
+    };
+    std::vector<OnFace> anOnFace;
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> anEdges;
+    bool aComplete = true;
+    for (TopExp_Explorer exE(F, TopAbs_EDGE); exE.More() && aComplete; exE.Next())
+    {
+      TopoDS_Edge E = TopoDS::Edge(exE.Current());
+      if (!anEdges.Add(E))
+      {
+        continue;
+      }
+      OnFace o;
+      E.Orientation(TopAbs_FORWARD);
+      o.E   = E;
+      o.Tol = BRep_Tool::Tolerance(E);
+      o.C1  = BRep_Tool::CurveOnSurface(E, F, o.First, o.Last);
+      if (BRep_Tool::IsClosed(E, F))
+      {
+        double f2 = 0., l2 = 0.;
+        o.C2 = BRep_Tool::CurveOnSurface(TopoDS::Edge(E.Reversed()), F, f2, l2);
+      }
+      aComplete = !o.C1.IsNull() && (o.C2.IsNull() == !BRep_Tool::IsClosed(E, F));
+      anOnFace.push_back(o);
+    }
+    if (!aComplete)
+    {
+      continue;
+    }
+    B.UpdateFace(F, W, L, BRep_Tool::Tolerance(F));
+    for (const OnFace& o : anOnFace)
+    {
+      if (o.C2.IsNull())
+      {
+        B.UpdateEdge(o.E, o.C1, F, o.Tol);
+      }
+      else
+      {
+        B.UpdateEdge(o.E, o.C1, o.C2, F, o.Tol);
+      }
+      B.Range(o.E, F, o.First, o.Last);
+    }
+  }
+}
