+//=======================================================================
+// function : ChFi3d_KinkIntoEndFaceOfSpine
+// purpose  : KinkIntoEndFace at the spine's first end (isFirst) or its
+//            last, Fnext no face of an edge of the spine (else the blend
+//            goes on along it, the spine's end vertex lying on it further
+//            on, past more of its edges). Used where a walk ends on the arc
+//            (ComputeData) and, SmoothOnly, where the next piece starts
+//            from it (StartSol, at the end of the piece before).
+//=======================================================================
+
+bool ChFi3d_KinkIntoEndFaceOfSpine(const ChFiDS_CommonPoint&        CP,
+                                   const TopoDS_Face&               F,
+                                   const TopoDS_Face&               Fnext,
+                                   const occ::handle<ChFiDS_Spine>& Spine,
+                                   const bool                       isFirst,
+                                   const ChFiDS_Map&                VFMap,
+                                   const ChFiDS_Map&                EFMap,
+                                   const double                     Ang,
+                                   const bool                       SmoothOnly)
+{
+  if (Spine.IsNull()
+      || !KinkIntoEndFace(CP,
+                          F,
+                          Fnext,
+                          isFirst ? Spine->FirstVertex() : Spine->LastVertex(),
+                          VFMap,
+                          Ang,
+                          SmoothOnly))
+  {
+    return false;
+  }
+  for (int i = 1; i <= Spine->NbEdges(); i++)
+  {
+    const TopoDS_Edge& E = Spine->Edges(i);
+    if (!EFMap.Contains(E))
+    {
+      continue;
+    }
+    for (const TopoDS_Shape& aFace : EFMap.FindFromKey(E))
+    {
+      if (aFace.IsSame(Fnext))
+      {
+        return false;
+      }
+    }
+  }
+  return true;
+}
