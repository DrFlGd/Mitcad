+//=======================================================================
+// function : ChFi3d_SmoothIntoFace
+// purpose  : Whether face F goes on smoothly into face G across an edge of
+//            both: their normals (as the faces' orientations take them)
+//            within the angular tolerance Ang all along it.
+//=======================================================================
+
+static bool ChFi3d_SmoothIntoFace(const TopoDS_Face& F, const TopoDS_Face& G, const double Ang)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> anEdgesOfG;
+  TopExp::MapShapes(G, TopAbs_EDGE, anEdgesOfG);
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E) || !anEdgesOfG.Contains(E))
+    {
+      continue;
+    }
+    double                          aFirst = 0., aLast = 0.;
+    const occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(E, F, aFirst, aLast);
+    const occ::handle<Geom2d_Curve> aC2 = BRep_Tool::CurveOnSurface(E, G, aFirst, aLast);
+    if (aC1.IsNull() || aC2.IsNull())
+    {
+      continue;
+    }
+    BRepAdaptor_Surface aS1(F, false), aS2(G, false);
+    bool                aSmooth = true;
+    for (int i = 0; i < 5 && aSmooth; i++)
+    {
+      const double   aT  = aFirst + (aLast - aFirst) * (i + 0.5) / 5.;
+      const gp_Pnt2d aP1 = aC1->Value(aT), aP2 = aC2->Value(aT);
+      gp_Pnt         aP;
+      gp_Vec         aDU, aDV;
+      aS1.D1(aP1.X(), aP1.Y(), aP, aDU, aDV);
+      gp_Vec aN1 = aDU.Crossed(aDV);
+      aS2.D1(aP2.X(), aP2.Y(), aP, aDU, aDV);
+      gp_Vec aN2 = aDU.Crossed(aDV);
+      if (aN1.SquareMagnitude() < 1.e-24 || aN2.SquareMagnitude() < 1.e-24)
+      {
+        aSmooth = false;
+        break;
+      }
+      if (F.Orientation() == TopAbs_REVERSED)
+      {
+        aN1.Reverse();
+      }
+      if (G.Orientation() == TopAbs_REVERSED)
+      {
+        aN2.Reverse();
+      }
+      aSmooth = aN1.Angle(aN2) <= Ang;
+    }
+    if (aSmooth)
+    {
+      return true;
+    }
+  }
+  return false;
+}
