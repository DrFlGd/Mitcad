--- a/src/ModelingAlgorithms/TKGeomAlgo/GeomFill/GeomFill_GuideTrihedronAC.cxx
+++ b/src/ModelingAlgorithms/TKGeomAlgo/GeomFill/GeomFill_GuideTrihedronAC.cxx
@@ -244,7 +244,9 @@
   gp_Vec DTDN = DTo.Crossed(DNormal);
   (void)DTDN;
 #endif
-  double TN2 = TN.SquareMagnitude();
+  // The square of the unit binormal's first derivative (|d|^2 of the
+  // unit vector's second derivative, as dn's for the normal).
+  double TN2 = DTN.SquareMagnitude();

   D2Normal.SetLinearForm(-2 * ndn, dn, 3 * ndn * ndn - (dn.SquareMagnitude() + n.Dot(d2n)), n, d2n);

