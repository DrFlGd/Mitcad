+  // The edges of the wire by their numbers. The wire keeps them in a sequence
+  // whose access by number walks from the place read last, so reading edge
+  // num1 and edge num2 for every pair walked the distance between them twice:
+  // a wire of n edges took about n^3 / 3 steps. They are read into an array in
+  // one walk, and again after a pair of edges that intersect, the only place
+  // where the fixes below change the wire.
+  std::vector<TopoDS_Edge> edges;
+  bool                     isEdgesRead = false;
+  auto                     edgeAt      = [&](const int num) -> const TopoDS_Edge& {
+    if (!isEdgesRead)
+    {
+      edges.clear();
+      edges.reserve(sewd->NbEdges());
+      for (int i = 1; i <= sewd->NbEdges(); i++)
+      {
+        edges.push_back(sewd->Edge(i));
+      }
+      isEdgesRead = true;
+    }
+    return edges[num - 1];
+  };
   for (int num1 = 1; num1 < sewd->NbEdges() && NbSplit < 30; num1++)
