+// The signs Triangulate() decides on (a face seen from a point, a face
+// turning down) computed exactly: a floating-point sign is taken when it
+// is certain, else the sign of the exact value (an expansion: a sum of
+// doubles that do not overlap, after J. R. Shewchuk, "Adaptive Precision
+// Floating-Point Arithmetic and Fast Robust Geometric Predicates", 1997).
+// Rounded signs disagree with each other on nearly cocircular points: the
+// faces a point sees no longer form one disk, the silhouette walk below
+// reads vertices and faces this step never wrote, and Triangulate() loops
+// forever or crashes.
+namespace
+{
+typedef std::vector<double> Expansion;
+
+const double THE_EPSILON = 1.1102230246251565e-16; // 2^-53
+// Shewchuk's error bounds of the floating-point orient2d and incircle,
+// doubled for the fused multiply-adds a compiler may form.
+const double THE_ORIENT_BOUND = 2.0 * (3.0 + 16.0 * THE_EPSILON) * THE_EPSILON;
+const double THE_INCIRCLE_BOUND = 2.0 * (10.0 + 96.0 * THE_EPSILON) * THE_EPSILON;
+
+// a + b = x + y exactly, x the rounded sum.
+inline void twoSum(double a, double b, double& x, double& y)
+{
+  x               = a + b;
+  const double bv = x - a;
+  const double av = x - bv;
+  y               = (a - av) + (b - bv);
+}
+
+// a * b = x + y exactly, x the rounded product.
+inline void twoProduct(double a, double b, double& x, double& y)
+{
+  x = a * b;
+  y = std::fma(a, b, -x);
+}
+
+// e + b, both exact, components in increasing magnitude, zeros dropped.
+Expansion growExpansion(const Expansion& e, double b)
+{
+  Expansion h;
+  h.reserve(e.size() + 1);
+  double q = b;
+  for (const double c : e)
+  {
+    double sum = 0.0, err = 0.0;
+    twoSum(q, c, sum, err);
+    if (err != 0.0)
+    {
+      h.push_back(err);
+    }
+    q = sum;
+  }
+  if (q != 0.0 || h.empty())
+  {
+    h.push_back(q);
+  }
+  return h;
+}
+
+Expansion sumExpansions(const Expansion& e, const Expansion& f)
+{
+  Expansion h = e;
+  for (const double c : f)
+  {
+    h = growExpansion(h, c);
+  }
+  return h;
+}
+
+// e * b exactly.
+Expansion scaleExpansion(const Expansion& e, double b)
+{
+  Expansion h;
+  h.reserve(2 * e.size());
+  double q = 0.0;
+  for (const double c : e)
+  {
+    double product = 0.0, productErr = 0.0;
+    twoProduct(c, b, product, productErr);
+    double sum = 0.0, err = 0.0;
+    twoSum(q, productErr, sum, err);
+    if (err != 0.0)
+    {
+      h.push_back(err);
+    }
+    twoSum(product, sum, q, err);
+    if (err != 0.0)
+    {
+      h.push_back(err);
+    }
+  }
+  if (q != 0.0 || h.empty())
+  {
+    h.push_back(q);
+  }
+  return h;
+}
+
+Expansion multiplyExpansions(const Expansion& e, const Expansion& f)
+{
+  Expansion h(1, 0.0);
+  for (const double c : f)
+  {
+    h = sumExpansions(h, scaleExpansion(e, c));
+  }
+  return h;
+}
+
+Expansion negateExpansion(Expansion e)
+{
+  for (double& c : e)
+  {
+    c = -c;
+  }
+  return e;
+}
+
+// a - b exactly.
+Expansion difference(double a, double b)
+{
+  double x = 0.0, y = 0.0;
+  twoSum(a, -b, x, y);
+  return growExpansion(Expansion(1, y), x);
+}
+
+// The sign of an expansion: that of its largest component, the last one.
+int expansionSign(const Expansion& e)
+{
+  for (size_t k = e.size(); k > 0; --k)
+  {
+    if (e[k - 1] != 0.0)
+    {
+      return e[k - 1] > 0.0 ? 1 : -1;
+    }
+  }
+  return 0;
+}
+
+// p x q exactly, of differences.
+Expansion crossExact(const Expansion& px, const Expansion& py, const Expansion& qx, const Expansion& qy)
+{
+  return sumExpansions(multiplyExpansions(px, qy), negateExpansion(multiplyExpansions(py, qx)));
+}
+
+// The sign of (b - a) x (c - a): positive when a, b, c turn
+// counterclockwise.
+int orientSign(double ax, double ay, double bx, double by, double cx, double cy)
+{
+  const double left  = (bx - ax) * (cy - ay);
+  const double right = (by - ay) * (cx - ax);
+  const double det   = left - right;
+  const double bound = THE_ORIENT_BOUND * (std::abs(left) + std::abs(right));
+  if (det > bound)
+  {
+    return 1;
+  }
+  if (-det > bound)
+  {
+    return -1;
+  }
+  return expansionSign(
+    crossExact(difference(bx, ax), difference(by, ay), difference(cx, ax), difference(cy, ay)));
+}
+
+// The sign of the determinant of the rows (x, y, x^2 + y^2) of a - d,
+// b - d and c - d: positive when d lies inside the circle through a, b, c
+// turning counterclockwise. It is the triple product of the points lifted
+// onto the paraboloid z = x^2 + y^2, (a - d) . ((b - d) x (c - d)).
+int incircleSign(double ax,
+                 double ay,
+                 double bx,
+                 double by,
+                 double cx,
+                 double cy,
+                 double dx,
+                 double dy)
+{
+  const double adx = ax - dx, ady = ay - dy;
+  const double bdx = bx - dx, bdy = by - dy;
+  const double cdx = cx - dx, cdy = cy - dy;
+
+  const double bdxcdy = bdx * cdy, cdxbdy = cdx * bdy;
+  const double cdxady = cdx * ady, adxcdy = adx * cdy;
+  const double adxbdy = adx * bdy, bdxady = bdx * ady;
+  const double alift = adx * adx + ady * ady;
+  const double blift = bdx * bdx + bdy * bdy;
+  const double clift = cdx * cdx + cdy * cdy;
+
+  const double det = alift * (bdxcdy - cdxbdy) + blift * (cdxady - adxcdy)
+                     + clift * (adxbdy - bdxady);
+  const double permanent = (std::abs(bdxcdy) + std::abs(cdxbdy)) * alift
+                           + (std::abs(cdxady) + std::abs(adxcdy)) * blift
+                           + (std::abs(adxbdy) + std::abs(bdxady)) * clift;
+  const double bound = THE_INCIRCLE_BOUND * permanent;
+  if (det > bound)
+  {
+    return 1;
+  }
+  if (-det > bound)
+  {
+    return -1;
+  }
+
+  const Expansion eadx = difference(ax, dx), eady = difference(ay, dy);
+  const Expansion ebdx = difference(bx, dx), ebdy = difference(by, dy);
+  const Expansion ecdx = difference(cx, dx), ecdy = difference(cy, dy);
+  const Expansion ealift =
+    sumExpansions(multiplyExpansions(eadx, eadx), multiplyExpansions(eady, eady));
+  const Expansion eblift =
+    sumExpansions(multiplyExpansions(ebdx, ebdx), multiplyExpansions(ebdy, ebdy));
+  const Expansion eclift =
+    sumExpansions(multiplyExpansions(ecdx, ecdx), multiplyExpansions(ecdy, ecdy));
+  const Expansion a = multiplyExpansions(ealift, crossExact(ebdx, ebdy, ecdx, ecdy));
+  const Expansion b = multiplyExpansions(eblift, crossExact(ecdx, ecdy, eadx, eady));
+  const Expansion c = multiplyExpansions(eclift, crossExact(eadx, eady, ebdx, ebdy));
+  return expansionSign(sumExpansions(sumExpansions(a, b), c));
+}
