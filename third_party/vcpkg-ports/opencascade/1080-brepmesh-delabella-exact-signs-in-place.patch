+// Whether a - b is exact in floating point.
+inline bool exactDifferences(double a, double b)
+{
+  double x = 0.0, y = 0.0;
+  twoSum(a, -b, x, y);
+  return y == 0.0;
+}
+
+// a * b exactly.
+Expansion<2> product(double a, double b)
+{
+  double x = 0.0, y = 0.0;
+  twoProduct(a, b, x, y);
+  Expansion<2> h;
+  h.size = 0;
+  if (y != 0.0)
+  {
+    h.c[h.size++] = y;
+  }
+  if (x != 0.0 || h.size == 0)
+  {
+    h.c[h.size++] = x;
+  }
+  return h;
+}
