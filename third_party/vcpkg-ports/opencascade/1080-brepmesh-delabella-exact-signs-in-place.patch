+// The exact signs, kept out of the floating-point filters below (not
+// inlined) so that their frames, the expansions held in place, are set up
+// only when the filter cannot decide.
+Standard_NOINLINE int orientExact(double ax, double ay, double bx, double by, double cx, double cy)
+{
+  return expansionSign(
+    crossExact(difference(bx, ax), difference(by, ay), difference(cx, ax), difference(cy, ay)));
+}
+
+// The determinant of incircleSign when the rounded differences are exact
+// (as they are between near points, nearly cocircular ones among them):
+// (adx^2 + ady^2) bc + (bdx^2 + bdy^2) ca + (cdx^2 + cdy^2) ab of them,
+// each term an exact product, far fewer components than from the
+// differences' expansions.
+Standard_NOINLINE int incircleExactDifferences(double adx,
+                                               double ady,
+                                               double bdx,
+                                               double bdy,
+                                               double cdx,
+                                               double cdy)
+{
+  const Expansion<4>  bc = sumExpansions(product(bdx, cdy), product(-cdx, bdy));
+  const Expansion<4>  ca = sumExpansions(product(cdx, ady), product(-adx, cdy));
+  const Expansion<4>  ab = sumExpansions(product(adx, bdy), product(-bdx, ady));
+  const Expansion<32> adet =
+    sumExpansions(scaleExpansion(scaleExpansion(bc, adx), adx), scaleExpansion(scaleExpansion(bc, ady), ady));
+  const Expansion<32> bdet =
+    sumExpansions(scaleExpansion(scaleExpansion(ca, bdx), bdx), scaleExpansion(scaleExpansion(ca, bdy), bdy));
+  const Expansion<32> cdet =
+    sumExpansions(scaleExpansion(scaleExpansion(ab, cdx), cdx), scaleExpansion(scaleExpansion(ab, cdy), cdy));
+  return expansionSign(sumExpansions(sumExpansions(adet, bdet), cdet));
+}
+
+// The determinant of incircleSign from any points, the differences
+// exact too.
+Standard_NOINLINE int incircleExactAny(double ax,
+                                       double ay,
+                                       double bx,
+                                       double by,
+                                       double cx,
+                                       double cy,
+                                       double dx,
+                                       double dy)
+{
+  const Expansion<2> eadx = difference(ax, dx), eady = difference(ay, dy);
+  const Expansion<2> ebdx = difference(bx, dx), ebdy = difference(by, dy);
+  const Expansion<2> ecdx = difference(cx, dx), ecdy = difference(cy, dy);
+  const auto ealift =
+    sumExpansions(multiplyExpansions(eadx, eadx), multiplyExpansions(eady, eady));
+  const auto eblift =
+    sumExpansions(multiplyExpansions(ebdx, ebdx), multiplyExpansions(ebdy, ebdy));
+  const auto eclift =
+    sumExpansions(multiplyExpansions(ecdx, ecdx), multiplyExpansions(ecdy, ecdy));
+  const auto a = multiplyExpansions(ealift, crossExact(ebdx, ebdy, ecdx, ecdy));
+  const auto b = multiplyExpansions(eblift, crossExact(ecdx, ecdy, eadx, eady));
+  const auto c = multiplyExpansions(eclift, crossExact(eadx, eady, ebdx, ebdy));
+  return expansionSign(sumExpansions(sumExpansions(a, b), c));
+}
