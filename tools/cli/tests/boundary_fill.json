[
  {"comment": "Boundary Fill (mitcad#457) on the geometry kernel. Two 20 mm cubes: A at the origin (Box1, F1, Body1) and B at (10, 10, 10) (Box2, F2, Body2); they share the cube from 10 to 20."},
  {"cmd": "add_feature", "def": {"type": "box", "plane": {"type": "origin", "plane": "xy"},
    "corner": [0, 0], "length": 20, "width": 20, "height": 20, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "box",
    "plane": {"type": "fixed", "origin": [10, 10, 10], "normal": [0, 0, 1], "x_axis": [1, 0, 0]},
    "length": 20, "width": 20, "height": 20, "operation": "new_body"}},
  {"expect": {"bodies": 2, "total_volume": 16000}},

  {"comment": "BoundaryFill1 (F3): the cell in both cubes and the cell in A alone as new bodies; the tools stay. The common cube is bounded by A's top and B's bottom, the L-shaped block by A's six faces and B's three faces inside A."},
  {"cmd": "add_feature", "def": {"type": "boundary_fill", "tools": ["F1.b0", "F2.b0"],
    "cells": [[15, 15, 15], [5, 5, 5]], "operation": "new_body"}},
  {"expect": {"feature": "BoundaryFill1", "status": "ok", "bodies": 4}},
  {"expect": {"body": "F3.b0", "volume": 1000, "faces": 6, "has_face": "F1:top",
    "bbox": {"min": [10, 10, 10], "max": [20, 20, 20]}}},
  {"expect": {"body": "F3.b0", "has_face": "F2:bottom"}},
  {"expect": {"body": "F3.b1", "volume": 7000, "faces": 9, "has_face": "F2:side3",
    "bbox": {"min": [0, 0, 0], "max": [20, 20, 20]}}},
  {"expect": {"body": "F1.b0", "volume": 8000}},

  {"comment": "Two points in one cell fill it once, with a warning."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "boundary_fill", "tools": ["F1.b0", "F2.b0"],
    "cells": [[15, 15, 15], [12, 18, 11]], "operation": "new_body"}},
  {"expect": {"feature": "BoundaryFill1", "status": "warning", "error_contains": "pick the same cell", "bodies": 3}},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "boundary_fill", "tools": ["F1.b0", "F2.b0"],
    "cells": [[15, 15, 15], [5, 5, 5]], "operation": "new_body"}},
  {"expect": {"feature": "BoundaryFill1", "status": "ok", "bodies": 4}},

  {"comment": "A plate 40 x 20 x 10 at x 40 (Box3, F4, Body5), a bar 10 x 40 x 10 across it at x 50, z 5 (Box4, F5) and a wall 30 x 4 x 20 across the bar at y 8 (Box5, F6). The bar outside the wall is one cell of two blocks (3600 mm3); BoundaryFill2 (F7) cuts it from the plate (800 mm3 of it) and removes the tools."},
  {"cmd": "add_feature", "def": {"type": "box", "plane": {"type": "origin", "plane": "xy"},
    "corner": [40, 0], "length": 40, "width": 20, "height": 10, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "box",
    "plane": {"type": "fixed", "origin": [50, -10, 5], "normal": [0, 0, 1], "x_axis": [1, 0, 0]},
    "length": 10, "width": 40, "height": 10, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "box",
    "plane": {"type": "fixed", "origin": [45, 8, 0], "normal": [0, 0, 1], "x_axis": [1, 0, 0]},
    "length": 30, "width": 4, "height": 20, "operation": "new_body"}},
  {"expect": {"bodies": 7}},
  {"cmd": "add_feature", "def": {"type": "boundary_fill", "tools": ["F5.b0", "F6.b0"],
    "cells": [[55, 0, 10]], "operation": "cut", "participants": ["F4.b0"], "remove_tools": true}},
  {"expect": {"feature": "BoundaryFill2", "status": "ok", "bodies": 5}},
  {"expect": {"body": "F4.b0", "volume": 7200, "has_face": "F6:side0",
    "bbox": {"min": [40, 0, 0], "max": [80, 20, 10]}}},

  {"comment": "A point outside every tool fails the fill."},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "boundary_fill", "tools": ["F5.b0", "F6.b0"],
    "cells": [[100, 100, 100]], "operation": "cut", "participants": ["F4.b0"], "remove_tools": true}},
  {"expect": {"feature": "BoundaryFill2", "status": "error", "error_contains": "inside no tool body"}},

  {"comment": "Joined instead: the plate and both blocks are one solid (8000 + 3600 - 800)."},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "boundary_fill", "tools": ["F5.b0", "F6.b0"],
    "cells": [[55, 0, 10]], "operation": "join", "participants": ["F4.b0"], "remove_tools": true}},
  {"expect": {"feature": "BoundaryFill2", "status": "ok", "bodies": 5}},
  {"expect": {"body": "F4.b0", "volume": 10800, "bbox": {"min": [40, -10, 0], "max": [80, 30, 15]}}}
]
