[
  {"comment": "BUILD (mitcad#375), opened on build_parts.mitcad: its source S1 is a 30 mm profile made as the profile layout says. T (O1) stands at the origin and X (O2) 500 along +X, both 1000 long along +Z."},
  {"cmd": "build_place", "part": {"source": "S1"}, "at": {"point": [0, 0, 0]}, "length": 1000},
  {"cmd": "build_place", "part": {"source": "S1"}, "at": {"point": [500, 0, 0]}, "length": 1000},
  {"expect": {"feature": "F1", "status": "ok"}},
  {"expect": {"body": "F1.b0", "volume": 900000, "has_face": "F1:end_a"}},
  {"expect": {"body": "F1.b0", "has_face": "F1:end_b"}},

  {"comment": "P (O3) on T's x+ slot, its near face 100 up (mitcad#394: an offset is to the near face), its length bound to X's x- slot: 470 mm (bound length F5 before its part F3 and joint F4)."},
  {"cmd": "build_place", "part": {"source": "S1"},
   "at": {"occurrence": "O1", "geometry": {"mount": "F1:mount(slot_x+_1)"}, "offset": 100},
   "length": {"bind": {"occurrence": "O2", "geometry": {"mount": "F2:mount(slot_x-_1)"}}}},
  {"expect": {"feature": "F5", "status": "ok"}},
  {"expect": {"feature": "F4", "status": "ok"}},
  {"expect": {"body": "F3.b0", "volume": 423000}},
  {"expect": {"occurrence": "O3", "body": "F3.b0",
              "bbox": {"min": [15, -15, 100], "max": [485, 15, 130]}, "tolerance": 1e-3}},

  {"comment": "X moves 100 further: P's length follows."},
  {"cmd": "ground_occurrence", "occurrence": "O2", "grounded": false},
  {"cmd": "set_occurrence_transform", "occurrence": "O2", "transform": {"translation": [600, 0, 0]}},
  {"expect": {"body": "F3.b0", "volume": 513000}},

  {"comment": "Q (O4) on T's end B, turned towards +Y, 400 long, a shared mitre: both ends cut by 45 degrees through their centres, so the volumes stay the section times the length and the outer corner meets at y = -15, z = 1015."},
  {"cmd": "build_place", "part": {"source": "S1"},
   "at": {"occurrence": "O1", "geometry": {"mount": "F1:mount(end_b)"}, "direction": [0, 1, 0]},
   "length": 400, "mitre": {"cut": "shared"}},
  {"expect": {"feature": "F1", "status": "ok"}},
  {"expect": {"feature": "F6", "status": "ok"}},
  {"expect": {"body": "F1.b0", "volume": 900000, "tolerance": 1e-6}},
  {"expect": {"body": "F6.b0", "volume": 360000, "tolerance": 1e-6}},
  {"expect": {"body": "F6.b0", "has_face": "F6:end_a"}},
  {"expect": {"occurrence": "O1", "body": "F1.b0",
              "bbox": {"min": [-15, -15, 0], "max": [15, 15, 1015]}, "tolerance": 1e-3}},
  {"expect": {"occurrence": "O4", "body": "F6.b0",
              "bbox": {"min": [-15, -15, 985], "max": [15, 400, 1015]}, "tolerance": 1e-3}},

  {"comment": "The cut list: four rows, all cut from one 6000 mm stock length."},
  {"expect": {"query": {"query": "build_cut_list"},
              "result": {"stock": [{"source": "S1", "stock_length": 6000, "needed": 1}]}}},
  {"comment": "The parts: T, X, P (570 after X moved) and Q, all profiles of S1."},
  {"expect": {"query": {"query": "build_parts"},
              "result": {"parts": [{"component": "C1", "role": "profile", "supplier": "Example supplier",
                                    "part_number": "P30", "length": 1000},
                                   {"component": "C2", "length": 1000},
                                   {"component": "C3", "length": 570},
                                   {"component": "C4", "length": 400}]}}}
]
