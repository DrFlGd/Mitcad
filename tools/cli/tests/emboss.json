[
  {"comment": "Emboss (mitcad#458) on OCCT. A rod: a circle of diameter 20 (Sketch1 F1) extruded 30 up the Z axis (F2): 100 pi 30. A region of area A wrapped onto the rod (radius 10) and grown radially to R changes the volume by A |R^2 - 100| / 20."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [0, 0], "diameter": 20},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 30}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 9424.77796076938}},

  {"comment": "Sketch2 (F3) on XZ (normal +Y, sketch y along -Z), through the axis: a 6 x 6 rectangle from z = 2 to 8, wrapped onto the rod's side and raised 1 (Emboss1, F4): 36 * 21 / 20 more."},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [-3, -8], "width": 6, "height": 6},
  {"cmd": "add_feature", "def": {"type": "emboss",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "face": {"body": "F2.b0", "face": "F2:side(c1)"}, "depth": 1}},
  {"expect": {"feature": "Emboss1", "status": "ok", "body": "F2.b0", "volume": 9462.57796076938,
    "has_face": "F4:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "F2.b0", "has_face": "F4:side(c1[c4,c2])", "min": [-10, -10, 0], "max": [10, 11, 30]}},
  {"comment": "Sunk 1 instead: 36 * 19 / 20 less; the floor is the end face."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "emboss",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "face": {"body": "F2.b0", "face": "F2:side(c1)"}, "depth": 1, "mode": "sink"}},
  {"expect": {"feature": "Emboss1", "status": "ok", "body": "F2.b0", "volume": 9390.57796076938,
    "has_face": "F4:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "F2.b0", "min": [-10, -10, 0], "max": [10, 10, 30]}},

  {"comment": "Sketch3 (F5) on XZ: 'Mitcad' in the bundled font, height 10, from z = 10 to 20 (the letters' regions as in p34_text_patterns: 70.95644374688502 mm^2), raised 1 on the rod (Emboss2, F6): A * 21 / 20 more."},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.add_text", "sketch": "F5", "text": "Mitcad", "at": [-15, -20], "height": 10},
  {"cmd": "add_feature", "def": {"type": "emboss", "profiles": [
    {"sketch": "F5", "region": "r{t1.g0.c0}"}, {"sketch": "F5", "region": "r{t1.g1.c0}"},
    {"sketch": "F5", "region": "r{t1.g1.c1}"}, {"sketch": "F5", "region": "r{t1.g2.c0}"},
    {"sketch": "F5", "region": "r{t1.g3.c0}"}, {"sketch": "F5", "region": "r{t1.g4.c0}"},
    {"sketch": "F5", "region": "r{t1.g5.c0}"}],
    "face": {"body": "F2.b0", "face": "F2:side(c1)"}, "depth": 1}},
  {"expect": {"feature": "Emboss2", "status": "ok", "body": "F2.b0", "volume": 9465.08222670361,
    "has_face": "F6:end(r{t1.g0.c0})"}},

  {"comment": "Sketch4 (F7) on XY: a 4 x 4 square under the rod's top face, raised 2 from that face (Emboss3, F8): 32 more; then sunk 3 into it: 48 less."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [-2, -2], "width": 4, "height": 4},
  {"cmd": "add_feature", "def": {"type": "emboss",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "face": {"body": "F2.b0", "face": "F2:end(r{c1})"}, "depth": 2}},
  {"expect": {"feature": "Emboss3", "status": "ok", "body": "F2.b0", "volume": 9497.08222670361,
    "has_face": "F8:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "emboss",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "face": {"body": "F2.b0", "face": "F2:end(r{c1})"}, "depth": 3, "mode": "sink"}},
  {"expect": {"feature": "Emboss3", "status": "ok", "body": "F2.b0", "volume": 9417.08222670361,
    "has_face": "F8:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},

  {"comment": "A sketch across the axis cannot wrap (Emboss4, F9, from Sketch4 on XY)."},
  {"cmd": "add_feature", "def": {"type": "emboss",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "face": {"body": "F2.b0", "face": "F2:side(c1)"}, "depth": 1}},
  {"expect": {"feature": "Emboss4", "status": "error",
    "error_contains": "the sketch plane must be parallel to the cylinder's axis"}}
]
