  {"expect": {"feature": "Thread1", "status": "ok"}},
  {"expect": {"body": "F2.b0", "has_face": "F5:thread_chamfer_high(F4:side(c1))"}},
  {"expect": {"query": {"query": "threads"}, "result": [{"feature": "F5", "face": "F4:side(c1)", "modeled": true,
