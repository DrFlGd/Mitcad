[
  {"comment": "A 60 x 40 x 5 plate (Sketch1 F1, Extrude1 F2), a pin of 8 mm and 10 mm high joined at (10, 10) (Sketch2 F3, Extrude2 F4) with a rounding of 1 mm at its foot (Fillet1 F5) and of 0.5 mm on its top (Fillet2 F6)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [10, 10], "diameter": 8},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "start": {"type": "offset", "offset": 5},
    "extent": {"type": "distance", "distance": 10}, "operation": "join"}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F4:side(c1)|F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})}"], "radius": 1}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F4:end(r{c1})|F4:side(c1)}"], "radius": 0.5}},

  {"comment": "The pin and its roundings patterned 3 x 2 at 15 mm with the optimized option: the faces they made are copied, no rounding is worked out on a copy."},
  {"cmd": "add_feature", "def": {"type": "rectangular_pattern",
    "objects": {"type": "features", "features": ["F4", "F5", "F6"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": 3, "distance": 15},
    "direction2": {"axis": {"type": "origin", "axis": "y"}, "quantity": 2, "distance": 15},
    "distance_type": "spacing", "compute": "optimized"}},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "bodies": 1, "body": "Body1",
    "volume": 15042.232845864828, "faces": 30, "has_face": "F7:inst5(F4:side(c1))"}},

  {"comment": "Adjust works the roundings out on each copy and gives the same body."},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "rectangular_pattern",
    "objects": {"type": "features", "features": ["F4", "F5", "F6"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": 3, "distance": 15},
    "direction2": {"axis": {"type": "origin", "axis": "y"}, "quantity": 2, "distance": 15},
    "distance_type": "spacing", "compute": "adjust"}},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "bodies": 1, "body": "Body1",
    "volume": 15042.232845864828, "faces": 30}}
]
