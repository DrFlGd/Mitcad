[
  {"comment": "Derive (mitcad#324). Part:1 (O1) at (100, 0, 10) holds a 10 x 10 x 5 block (Sketch1 F1, Extrude1 F2); Shell:1 (O2) at (0, 50, -3) is active."},
  {"cmd": "create_component", "name": "Part", "transform": {"translation": [100, 0, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "C0"},
  {"cmd": "create_component", "name": "Shell", "transform": {"translation": [0, 50, -3]}},

  {"comment": "Derive1 F3 copies Part's block into Shell through Part:1: moved by (100, -50, 13) into Shell's coordinates, the source staying in Part."},
  {"cmd": "add_feature", "def": {"type": "derive", "bodies": ["F2.b0"],
    "links": {"F2.b0": {"source": "O1"}}}},
  {"expect": {"feature": "Derive1", "status": "ok"}},
  {"expect": {"bodies": 2}},
  {"expect": {"query": {"query": "bodies"}, "result": [{"uid": "F2.b0", "component": "C1"},
    {"uid": "F3.b0", "component": "C2"}]}},
  {"expect": {"occurrence": "Shell:1", "body": "F3.b0", "volume": 500,
    "bbox": {"min": [100, 0, 10], "max": [110, 10, 15]}, "tolerance": 1e-6}},

  {"comment": "Part moves up 10: the copy follows; the block grows to 8 mm: so does the copy."},
  {"cmd": "set_occurrence_transform", "occurrence": "Part:1", "transform": {"translation": [100, 0, 20]}},
  {"expect": {"occurrence": "Shell:1", "body": "F3.b0", "bbox": {"min": [100, 0, 20], "max": [110, 10, 25]}, "tolerance": 1e-6}},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 8}, "operation": "new_body"}},
  {"expect": {"feature": "Derive1", "status": "ok"}},
  {"expect": {"occurrence": "Shell:1", "body": "F3.b0", "volume": 800}}
]
