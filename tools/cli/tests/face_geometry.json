[
  {"comment": "Faces and edges with geometry, filters and pages, a face's plane from measure, the boxes of bodies and the warning of an angle of more than one turn (mitcad#714) on the OCCT kernel. Body1 (F2.b0): a block 60 x 30 x 20 from the origin with a hole of 6 mm through (15, 15) (F4) and one of 10 mm through (45, 15) (F6)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 30},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [15, 15], "diameter": 6},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F5", "center": [45, 15], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F5", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 33863.71699555894, "faces": 8}},

  {"comment": "A page: the total and as many faces as the limit."},
  {"expect": {"query": {"query": "faces", "body": "F2.b0", "limit": 3},
    "result": {"total": 8, "offset": 0, "faces": [{}, {}, {}]}}},
  {"comment": "The small hole's wall by its surface and area, with its axis, radius and box."},
  {"expect": {"query": {"query": "faces", "body": "F2.b0", "geometry": true, "surface": "cylinder", "max_area": 500},
    "result": {"total": 1, "faces": [{"surface": "cylinder", "area": 376.99111843077515, "radius": 3,
      "axis": [0, 0, 1], "origin": [15, 15, 10], "bbox": {"min": [12, 12, 0], "max": [18, 18, 20]}}]},
    "tolerance": 1e-5}},
  {"expect": {"query": {"query": "faces", "body": "F2.b0", "geometry": true, "surface": "cylinder", "min_area": 500},
    "result": {"total": 1, "faces": [{"radius": 5, "origin": [45, 15, 10],
      "bbox": {"min": [40, 10, 0], "max": [50, 20, 20]}}]},
    "tolerance": 1e-5}},
  {"comment": "The top by its normal: its plane (the point nearest the origin) and box, its area less the holes'."},
  {"expect": {"query": {"query": "faces", "body": "F2.b0", "geometry": true, "normal": [0, 0, 1]},
    "result": {"total": 1, "faces": [{"surface": "plane", "area": 1693.185849777947,
      "normal": [0, 0, 1], "origin": [0, 0, 20], "bbox": {"min": [0, 0, 20], "max": [60, 30, 20]}}]},
    "tolerance": 1e-5}},
  {"expect": {"query": {"query": "faces", "body": "F2.b0", "geometry": true, "normal": [-1, 0, 0]},
    "result": {"total": 1, "faces": [{"normal": [-1, 0, 0], "origin": [0, 0, 0],
      "bbox": {"min": [0, 0, 0], "max": [0, 30, 20]}}]},
    "tolerance": 1e-5}},
  {"comment": "The large hole's two rims: circles longer than 30 mm."},
  {"expect": {"query": {"query": "edges", "body": "F2.b0", "geometry": true, "curve": "circle", "min_length": 30},
    "result": {"total": 2, "edges": [{"curve": "circle", "radius": 5}, {"curve": "circle", "radius": 5}]},
    "tolerance": 1e-5}},

  {"comment": "Measure of the top gives its plane."},
  {"expect": {"query": {"query": "measure",
      "a": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "result": {"a": {"kind": "face", "plane": {"normal": [0, 0, 1]}}}}},

  {"comment": "The bodies' boxes, as MCP's command results read them; after a split at x = 30 each piece's."},
  {"expect": {"query": {"query": "bodies", "bbox": true},
    "result": [{"uid": "F2.b0", "bbox": {"min": [0, 0, 0], "max": [60, 30, 20]}}],
    "tolerance": 1e-5}},
  {"cmd": "add_feature", "def": {"type": "split_body", "bodies": ["F2.b0"],
    "tool": {"type": "origin_plane", "plane": "yz", "offset": 30}}},
  {"expect": {"query": {"query": "bodies", "bbox": true, "versions": true},
    "result": [{"uid": "F2.b0", "bbox": {"min": [0, 0, 0], "max": [30, 30, 20]}},
               {"uid": "F7.b0", "bbox": {"min": [30, 0, 0], "max": [60, 30, 20]}}],
    "tolerance": 1e-5}},

  {"comment": "A rotation of 90 as a JSON number is radians: the move warns."},
  {"cmd": "add_feature", "def": {"type": "move", "bodies": ["F7.b0"],
    "transform": {"type": "rotate", "axis": "z", "angle": 90}}},
  {"expect": {"feature": "Move1", "status": "warning",
    "error_contains": "Move1 angle: 90 is read as radians (5156.6°); write \"90 deg\" for degrees"}}
]
