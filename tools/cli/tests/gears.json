[
  {"comment": "Gears (mitcad#472). Gear1 F1: a spur gear of 20 teeth, module 2, 10 wide on XY: outside diameter m (z + 2) = 44."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "plane": "xy", "module": 2, "teeth": 20,
    "face_width": 10, "operation": "new_body"}},
  {"expect": {"feature": "Gear1", "status": "ok", "body": "F1.b0", "has_face": "F1:flank_a(1)"}},
  {"expect": {"body": "F1.b0", "bbox": {"min": [-22, -22, 0], "max": [22, 22, 10]}, "tolerance": 1e-3}},
  {"expect": {"query": {"query": "gear_values", "uid": "F1"},
    "result": {"outside_diameter": 44, "pitch_diameter": 40, "root_diameter": 35, "tooth_thickness": 3.141592653589793,
               "undercut": false}}},
  {"expect": {"query": {"query": "gear_values", "uid": "F1"}, "result": {"section_area": 1237.1968462296377}, "tolerance": 1e-6}},
  {"expect": {"body": "F1.b0", "volume": 12371.968462296377, "tolerance": 1e-6}},

  {"comment": "Gear2 F2: 12 teeth are undercut by the generating rack's fillet; the solid passes the shape checker (the feature checks it)."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "plane": "xy", "center": [100, 0], "module": 2,
    "teeth": 12, "face_width": 10, "operation": "new_body"}},
  {"expect": {"feature": "Gear2", "status": "ok", "body": "F2.b0"}},
  {"expect": {"query": {"query": "gear_values", "uid": "F2"}, "result": {"undercut": true, "outside_diameter": 28}}},

  {"comment": "Gear3 F3: helical, 20 degrees right-handed; Gear4 F4: herringbone of the same teeth. Their volumes are their transverse section's area times the width, as a straight gear's (Gear1)."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "helical", "plane": "xy", "center": [0, 100], "module": 2,
    "teeth": 20, "face_width": 10, "helix_angle": "20 deg", "operation": "new_body"}},
  {"expect": {"feature": "Gear3", "status": "ok", "body": "F3.b0"}},
  {"expect": {"query": {"query": "gear_values", "uid": "F3"}, "result": {"section_area": 1404.2950729782297}, "tolerance": 1e-6}},
  {"expect": {"body": "F3.b0", "volume": 14042.950729782297, "tolerance": 1e-3}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "herringbone", "plane": "xy", "center": [100, 100],
    "module": 2, "teeth": 20, "face_width": 10, "helix_angle": "20 deg", "operation": "new_body"}},
  {"expect": {"feature": "Gear4", "status": "ok", "body": "F4.b0"}},
  {"expect": {"body": "F4.b0", "volume": 14042.950729782297, "tolerance": 1e-3}},

  {"comment": "Ring1 F5: 40 teeth inside a 5 mm rim, 0.1 backlash; Gear5 F6 of 20 teeth meshes inside it: 20 mm from its centre, no interference."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "ring", "plane": "xy", "center": [250, 0], "module": 2,
    "teeth": 40, "rim": 5, "face_width": 10, "backlash": 0.1, "operation": "new_body"}},
  {"expect": {"feature": "Gear5", "status": "ok", "body": "F5.b0"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "module": 2, "teeth": 20, "face_width": 10,
    "backlash": 0.1, "mesh_with": {"gear": "F5"}, "operation": "new_body"}},
  {"expect": {"feature": "Gear6", "status": "ok", "body": "F6.b0"}},
  {"expect": {"body": "F6.b0", "center": [270, 0, 5], "tolerance": 1e-4}},
  {"expect": {"query": {"query": "gear_values", "uid": "F6"}, "result": {"centre_distance": 20}}},
  {"expect": {"query": {"query": "interference", "bodies": ["F5.b0", "F6.b0"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "Gear7 F7: 30 teeth meshing Gear8 F8 of 20 outside, both with 0.1 backlash: 50 mm apart, no interference."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "plane": "xy", "center": [0, -150], "module": 2,
    "teeth": 20, "face_width": 10, "backlash": 0.1, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "module": 2, "teeth": 30, "face_width": 10,
    "backlash": 0.1, "mesh_with": {"gear": "F7", "angle": "30 deg"}, "operation": "new_body"}},
  {"expect": {"feature": "Gear8", "status": "ok"}},
  {"expect": {"query": {"query": "interference", "bodies": ["F7.b0", "F8.b0"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "Rack1 F9: 10 teeth of module 2, 15 high, meshing Gear7 below it: its pitch line is 10 pi m long, from x = -10 pi."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "rack", "module": 2, "teeth": 10, "height": 15,
    "face_width": 10, "backlash": 0.1, "mesh_with": {"gear": "F7", "angle": "-90 deg"}, "operation": "new_body"}},
  {"expect": {"feature": "Gear9", "status": "ok", "body": "F9.b0"}},
  {"expect": {"query": {"query": "gear_values", "uid": "F9"}, "result": {"pitch_line_length": 62.83185307179586}}},
  {"expect": {"query": {"query": "interference", "bodies": ["F7.b0", "F9.b0"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "Bevel1 F10: a straight bevel pair of 20 teeth, module 2, 8 wide at 90 degrees: two bodies."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "bevel", "plane": "xy", "center": [-200, 0], "module": 2,
    "teeth": 20, "face_width": 8, "pair": true, "operation": "new_body"}},
  {"expect": {"feature": "Gear10", "status": "ok", "body": "F10.b1"}},
  {"expect": {"query": {"query": "gear_values", "uid": "F10"}, "result": {"pitch_angle": 0.7853981633974483}}},

  {"comment": "Gear11 F11: 30 teeth with a 12 mm bore, its DIN 6885 keyway (4 x 1.8) and a 30 x 8 hub; Gear12 F12 with an M8x1.25 bore (its tap drill), a cosmetic thread."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "plane": "xy", "center": [-200, -150], "module": 2,
    "teeth": 30, "face_width": 10, "bore": {"type": "plain", "diameter": 12}, "keyway": true,
    "hub": {"diameter": 30, "length": 8}, "operation": "new_body"}},
  {"expect": {"feature": "Gear11", "status": "ok", "body": "F11.b0", "has_face": "F11:keyway_top"}},
  {"expect": {"body": "F11.b0", "has_face": "F11:hub"}},
  {"expect": {"body": "F11.b0", "has_face": "F11:bore"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "plane": "xy", "center": [-200, -300], "module": 2,
    "teeth": 30, "face_width": 10, "bore": {"type": "thread", "thread": {"designation": "M8x1.25"}},
    "operation": "new_body"}},
  {"expect": {"feature": "Gear12", "status": "ok", "body": "F12.b0"}},
  {"expect": {"query": {"query": "threads"}, "result": [{"feature": "F12", "designation": "M8x1.25", "modeled": false}]}},

  {"comment": "Helical gears in mesh, 20 degrees: Gear13 F13 right-handed, Gear14 F14 left-handed, 0.1 backlash: no interference."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "helical", "plane": "xy", "center": [200, -150], "module": 2,
    "teeth": 20, "face_width": 10, "helix_angle": "20 deg", "backlash": 0.1, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "helical", "module": 2, "teeth": 30, "face_width": 10,
    "helix_angle": "20 deg", "left_handed": true, "backlash": 0.1, "mesh_with": {"gear": "F13", "angle": "60 deg"},
    "operation": "new_body"}},
  {"expect": {"feature": "Gear14", "status": "ok"}},
  {"expect": {"query": {"query": "interference", "bodies": ["F13.b0", "F14.b0"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "A helical rack (Gear15 F15) under the right-handed gear: the same hand, no interference."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "rack", "module": 2, "teeth": 8, "height": 12, "face_width": 10,
    "helix_angle": "20 deg", "backlash": 0.1, "mesh_with": {"gear": "F13", "angle": "-90 deg"}, "operation": "new_body"}},
  {"expect": {"feature": "Gear15", "status": "ok"}},
  {"expect": {"query": {"query": "interference", "bodies": ["F13.b0", "F15.b0"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "Shifted gears (Gear16 F16 of 12 teeth, x = 0.4, and Gear17 F17 of 24, x = 0.1): the working centre distance, no interference."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "plane": "xy", "center": [400, -150], "module": 2,
    "teeth": 12, "face_width": 10, "profile_shift": 0.4, "backlash": 0.1, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "module": 2, "teeth": 24, "face_width": 10,
    "profile_shift": 0.1, "backlash": 0.1, "mesh_with": {"gear": "F16"}, "operation": "new_body"}},
  {"expect": {"feature": "Gear17", "status": "ok"}},
  {"expect": {"query": {"query": "interference", "bodies": ["F16.b0", "F17.b0"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "A herringbone gear with a 2 mm gap (Gear18 F18), and a bevel pair with backlash (Gear19 F19) whose gears clear each other."},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "herringbone", "plane": "xy", "center": [400, 0], "module": 2,
    "teeth": 20, "face_width": 12, "helix_angle": "25 deg", "gap": 2, "operation": "new_body"}},
  {"expect": {"feature": "Gear18", "status": "ok", "body": "F18.b0", "has_face": "F18:groove"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "bevel", "plane": "xy", "center": [-200, 200], "module": 2,
    "teeth": 18, "mate_teeth": 27, "face_width": 8, "backlash": 0.1, "pair": true, "operation": "new_body"}},
  {"expect": {"feature": "Gear19", "status": "ok"}},
  {"expect": {"query": {"query": "interference", "bodies": ["F19.b0", "F19.b1"]}, "result": {"bodies": 2, "pairs": []}}},

  {"comment": "Seats on shafts (mitcad#578). A shaft: a 10 mm circle at (600, 0) (Sketch1 F20) extruded 40 up z (Extrude1 F21). Gear20 F22: Gear1's gear on the shaft's side face picked near its top, 5 mm down from the top end, facing down the shaft (z = 25 to 35); its bore the shaft's 10 mm and a 0.2 mm clearance. Volume: Gear1's less pi 5.1^2 x 10 (817.128249) = 11554.840213. Gear21 F23 meshes with it in its plane, 40 mm along x."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F20", "center": [600, 0], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F20", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 40}, "operation": "new_body"}},
  {"expect": {"feature": "Extrude1", "status": "ok", "body": "F21.b0", "has_face": "F21:side(c1)"}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "module": 2, "teeth": 20, "face_width": 10,
    "seat": {"shaft": {"body": "F21.b0", "face": "F21:side(c1)"}, "offset": 5, "near": [605, 0, 39]},
    "bore_clearance": 0.2, "operation": "new_body"}},
  {"expect": {"feature": "Gear20", "status": "ok", "body": "F22.b0", "has_face": "F22:bore"}},
  {"expect": {"body": "F22.b0", "bbox": {"min": [578, -22, 25], "max": [622, 22, 35]}, "tolerance": 1e-3}},
  {"expect": {"body": "F22.b0", "volume": 11554.840213, "tolerance": 1e-5}},
  {"expect": {"query": {"query": "gear_values", "uid": "F22"},
    "result": {"bore_diameter": 10.2, "shaft_diameter": 10,
               "seat": {"origin": [600, 0, 35], "axis": [0, 0, -1], "end": [600, 0, 40]}}, "tolerance": 1e-6}},
  {"cmd": "add_feature", "def": {"type": "gear", "kind": "spur", "module": 2, "teeth": 20, "face_width": 10,
    "backlash": 0.1, "mesh_with": {"gear": "F22"}, "operation": "new_body"}},
  {"expect": {"feature": "Gear21", "status": "ok", "body": "F23.b0"}},
  {"expect": {"query": {"query": "gear_values", "uid": "F23"}, "result": {"centre_distance": 40, "mate": "F22"}}}
]
