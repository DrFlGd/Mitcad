[
  {"comment": "Measure with axes (mitcad#647) on the OCCT kernel. Body1 (F2): a cylinder of radius 5 about Z through the origin, z 0 to 20; Body2 (F4): the same about Z through (30, 40)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [0, 0], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [30, 40], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"bodies": 2}},

  {"comment": "Two parallel cylinders: their axes 50 apart (the centres' distance), their surfaces 40."},
  {"expect": {"query": {"query": "measure", "a": {"body": "F2.b0", "face": "F2:side(c1)"}, "b": {"body": "F4.b0", "face": "F4:side(c1)"}},
    "result": {"a": {"kind": "face", "axis": {"origin": [0, 0, 10]}, "circle": {"radius": 5}},
      "b": {"axis": {"origin": [30, 40, 10]}},
      "between": {"distance": 40, "angle": 0, "axis_distance": 50, "axis_points": [[0, 0, 10], [30, 40, 10]]}}}},
  {"comment": "A cylinder against its top: square to it."},
  {"expect": {"query": {"query": "measure", "a": {"body": "F2.b0", "face": "F2:side(c1)"}, "b": {"body": "F2.b0", "face": "F2:end(r{c1})"}},
    "result": {"between": {"distance": 0, "angle": 1.5707963267948966}}}},

  {"comment": "Body3 (F5): a cylinder about X through the origin, x 0 to 30. Against Body2: skew axes, the common perpendicular from (30, 40, 0) to (30, 0, 0)."},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": {"type": "origin", "plane": "yz"}, "center": [0, 0],
    "diameter": 10, "height": 30, "operation": "new_body"}},
  {"expect": {"query": {"query": "measure", "a": {"body": "F4.b0", "face": "F4:side(c1)"}, "b": {"body": "F5.b0", "face": "F5:side0"}},
    "result": {"between": {"angle": 1.5707963267948966, "axis_distance": 40, "axis_points": [[30, 40, 0], [30, 0, 0]]}}}},

  {"comment": "A 2 mm chamfer round Body1's top (F6, a cone about Z) and a block 10 x 10 x 20 at (20, -5) (F8): the cone's axis is parallel to the block's upright edge at (30, -5)."},
  {"cmd": "add_feature", "def": {"type": "chamfer", "body": "F2.b0", "edges": ["E{F2:end(r{c1})|F2:side(c1)}"],
    "size": {"type": "equal_distance", "distance": 2}}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [20, -5], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"query": {"query": "measure", "a": {"body": "F2.b0", "face": "F6:chamfer(E{F2:end(r{c1})|F2:side(c1)})"},
      "b": {"body": "F8.b0", "edge": "E{F8:side(c1[c4,c2])|F8:side(c2[c1,c3])}"}},
    "result": {"between": {"angle": 0, "axis_distance": 30.4138126514911}}}},

  {"comment": "Body2's bottom rim against a construction axis along X through (0, 20, 5) (F11, where the planes y = 20 and z = 5 meet): square, 20 apart from (30, 40, 5) to (30, 20, 5)."},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xz", "distance": 20}}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xy", "distance": 5}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "two_planes", "plane1": "F9", "plane2": "F10"}}},
  {"expect": {"query": {"query": "measure", "a": {"body": "F4.b0", "edge": "E{F4:side(c1)|F4:start(r{c1})}"}, "b": "F11"},
    "result": {"a": {"kind": "edge", "circle": {"radius": 5}, "axis": {"origin": [30, 40, 0]}},
      "between": {"angle": 1.5707963267948966, "axis_distance": 20, "axis_points": [[30, 40, 5], [30, 20, 5]]}}}},

  {"comment": "A Pin component at (0, 0, 50) turned 90 degrees about X with a cylinder about its Z (F12): in the design its axis runs along Y through (0, y, 50) and meets Body1's at (0, 0, 50)."},
  {"cmd": "create_component", "name": "Pin", "transform": {"translation": [0, 0, 50],
    "rotation": {"axis": [1, 0, 0], "angle": 1.5707963267948966}}},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": {"type": "origin", "plane": "xy"}, "center": [0, 0],
    "diameter": 6, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "C0"},
  {"expect": {"query": {"query": "measure", "a": {"body": "F2.b0", "face": "F2:side(c1)"}, "b": {"body": "F12.b0", "face": "F12:side0", "occurrence": "O1"}},
    "result": {"b": {"axis": {"origin": [0, -5, 50]}},
      "between": {"angle": 1.5707963267948966, "axis_distance": 0, "axis_points": [[0, 0, 50], [0, 0, 50]]}}}}
]
