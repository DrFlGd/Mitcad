[
  {"comment": "Mesh bodies in surface operations (mitcad#399): a body of triangles without surfaces (an STL file's) is refused by name where a feature names it, before the geometry kernel gets it, and left out where an operation takes all bodies. Body1 40 x 20 x 20 at x 0..40 (F1, F2), Body2 at x 20..60 (F3, F4), written to an STL file and read back as the mesh body cube (Base1 F5, F5.b0). Files go to the working directory."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [20, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "export", "path": "cube.stl", "bodies": ["Body2"], "ascii": true},
  {"cmd": "import_file", "path": "cube.stl"},
  {"expect": {"feature": "Base1", "status": "ok", "bodies": 3, "body": "cube", "volume": 16000,
    "tolerance": 1e-6, "faces": 1, "edges": 0}},

  {"comment": "Combine1 F6: the mesh body as a tool, then as the target: refused, the bodies as they were."},
  {"cmd": "add_feature", "def": {"type": "combine", "target": "F2.b0", "tools": ["F5.b0"], "operation": "join"}},
  {"expect": {"feature": "Combine1", "status": "error",
    "error_contains": "body F5.b0 (from Base1) is a mesh body (triangles without surfaces), which Combine cannot use; it works on solid and surface bodies",
    "bodies": 3, "body": "cube", "volume": 16000, "tolerance": 1e-6}},
  {"cmd": "edit_feature", "uid": "F6", "def": {"type": "combine", "target": "F5.b0", "tools": ["F2.b0"], "operation": "cut"}},
  {"expect": {"feature": "Combine1", "status": "error", "error_contains": "which Combine cannot use",
    "body": "Body1", "volume": 16000}},

  {"comment": "Shell1 F7, SplitBody1 F8, Mirror1 F9 (joining the copy): refused."},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F5.b0", "faces": ["F5:import(0)"], "inside": 1}},
  {"expect": {"feature": "Shell1", "status": "error", "error_contains": "body F5.b0 (from Base1) is a mesh body"}},
  {"cmd": "add_feature", "def": {"type": "split_body", "bodies": ["F5.b0"],
    "tool": {"type": "origin_plane", "plane": "yz", "offset": 30}}},
  {"expect": {"feature": "SplitBody1", "status": "error", "error_contains": "which SplitBody cannot use", "bodies": 3}},
  {"cmd": "add_feature", "def": {"type": "mirror", "objects": {"type": "bodies", "bodies": ["F5.b0"]},
    "plane": {"type": "origin", "plane": "yz"}, "combine": true}},
  {"expect": {"feature": "Mirror1", "status": "error", "error_contains": "which Mirror cannot use", "bodies": 3}},

  {"comment": "Extrude3 F11 cuts x 10..50, y 5..15 through all bodies: the solids lose 30 x 10 x 20 each, the mesh body is not cut."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F10", "corner": [10, 5], "width": 40, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F10", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "cut"}},
  {"expect": {"feature": "Extrude3", "status": "ok", "bodies": 3, "body": "Body1", "volume": 10000}},
  {"expect": {"body": "Body2", "volume": 10000}},
  {"expect": {"body": "cube", "volume": 16000, "tolerance": 1e-6}},

  {"comment": "Named as its participant, the mesh body is refused."},
  {"cmd": "edit_feature", "uid": "F11", "def": {"type": "extrude",
    "profiles": [{"sketch": "F10", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "cut", "participants": ["F5.b0"]}},
  {"expect": {"feature": "Extrude3", "status": "error", "error_contains": "which Extrude cannot use",
    "body": "Body1", "volume": 16000}}
]
