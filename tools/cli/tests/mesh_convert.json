[
  {"comment": "SPDX-License-Identifier: MIT. Convert Mesh (mitcad#462): Body1 (F1, F2) is a plate 40 x 20, 15 thick, with a 10 x 10 window at x 10..20, y 5..15 (10500 mm3), written to a binary STL file and read back as the mesh body part (Base1 F3, F3.b0). ConvertMesh1 (F4) rebuilds it as 10 planar faces named as an extrusion's: the outline c1..c4 counter-clockwise from (0, 0), the window c5..c8 clockwise from (10, 5). Files go to the working directory."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 20},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [10, 5], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 15}, "operation": "new_body"}},
  {"expect": {"body": "Body1", "volume": 10500, "faces": 10}},
  {"cmd": "export", "path": "part.stl", "bodies": ["Body1"]},
  {"cmd": "import_file", "path": "part.stl"},
  {"expect": {"feature": "Base1", "status": "ok", "bodies": 2, "body": "part", "volume": 10500,
    "tolerance": 1e-6, "faces": 1, "edges": 0}},

  {"cmd": "add_feature", "def": {"type": "mesh_convert", "body": "F3.b0", "tolerance": 0.05}},
  {"expect": {"feature": "ConvertMesh1", "status": "ok", "bodies": 2, "body": "part", "volume": 10500,
    "faces": 10, "min": [0, 0, 0], "max": [40, 20, 15], "has_face": "F4:side(c1[c4,c2])"}},
  {"expect": {"body": "part", "has_face": "F4:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "part", "has_face": "F4:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "part", "has_face": "F4:side(c5[c8,c6])"}},
  {"expect": {"body": "Body1", "volume": 10500, "faces": 10}},

  {"comment": "ConvertMesh2 (F5): a solid is no mesh body. A torus (F6), no prism in any direction, written to STL and read back as the mesh body ring (Base2 F7): ConvertMesh3 (F8) refuses it, and the mesh body stays."},
  {"cmd": "add_feature", "def": {"type": "mesh_convert", "body": "F2.b0", "tolerance": 0.05}},
  {"expect": {"feature": "ConvertMesh2", "status": "error",
    "error_contains": "body F2.b0 (from Extrude1) is not a mesh body"}},
  {"cmd": "add_feature", "def": {"type": "torus", "plane": "xy", "center": [100, 0], "diameter": 40, "section_diameter": 10,
    "operation": "new_body"}},
  {"cmd": "export", "path": "ring.stl", "bodies": ["F6.b0"]},
  {"cmd": "import_file", "path": "ring.stl"},
  {"expect": {"feature": "Base2", "status": "ok", "body": "ring", "faces": 1, "edges": 0}},
  {"cmd": "add_feature", "def": {"type": "mesh_convert", "body": "F7.b0", "tolerance": 0.05}},
  {"expect": {"feature": "ConvertMesh3", "status": "error",
    "error_contains": "is not a supported constant-section prism"}},
  {"expect": {"body": "ring", "faces": 1, "edges": 0}}
]
