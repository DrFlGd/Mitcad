[
  {"comment": "Motion studies and contact sets (mitcad#454). Plate (Plate:1, grounded): a 40 x 40 x 10 block, Sketch1 F1 and Extrude1 F2 (Body1)."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},

  {"comment": "Pin (Pin:1): a 10 x 10 x 20 block, Sketch2 F3 and Extrude2 F4 (Body2)."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Pin", "transform": {"translation": [100, 0, 0]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},

  {"comment": "Wall (Wall:1, grounded): a 5 x 40 x 10 block standing on the plate from x = 35 to 40, Sketch3 F5 and Extrude3 F6 (Body3)."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Wall", "transform": {"translation": [35, 0, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [0, 0], "width": 5, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "ground_occurrence", "occurrence": "Plate:1"},
  {"cmd": "ground_occurrence", "occurrence": "Wall:1"},

  {"comment": "Joint1 F7: the pin's bottom on the plate's top, sliding along x: at tx = 0 the pin stands on the middle of the plate, x from 15 to 25."},
  {"cmd": "add_joint", "kind": "slider", "slide_axis": "x", "flip": true, "position": {"tx": 0},
    "a": {"occurrence": "Pin:1",
          "geometry": {"body": "F4.b0", "face": "F4:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "b": {"occurrence": "Plate:1",
          "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [20, 20, 20], "tolerance": 1e-6}},

  {"comment": "A study keys the slide: 20 mm at step 10. Played to step 2 the pin is at tx = 4."},
  {"cmd": "add_motion_study", "name": "Push", "steps": 10, "keys": [
    {"joint": "Joint1", "motion": "tx", "points": [[0, 0], [10, "20 mm"]]}]},
  {"expect": {"query": {"query": "study_values", "study": "Push", "step": 5},
    "result": {"values": {"F7": {"tx": 10}}}}},
  {"cmd": "play_study", "study": "Push", "step": 2},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [24, 20, 20], "tolerance": 1e-6}},

  {"comment": "Without a contact set the pin passes through the wall; with one, Drive Joint stops it where it touches the wall (tx = 10, its centre at x = 30)."},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"tx": 20}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [40, 20, 20], "tolerance": 1e-6}},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"tx": 0}},
  {"cmd": "add_contact_set", "occurrences": ["Pin:1", "Wall:1"]},
  {"expect": {"query": {"query": "contact_sets"}, "result": [{"name": "Contact1", "suppressed": false}]}},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"tx": 20}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [30, 20, 20], "tolerance": 0.02}},
  {"expect": {"query": {"query": "contact_check"}, "result": {"overlaps": []}}},

  {"comment": "Played to the end of the study, the pin stops at the wall again."},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"tx": 0}},
  {"cmd": "play_study", "study": "Push", "step": 10},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [30, 20, 20], "tolerance": 0.02}},

  {"comment": "Suppressed, the set lets it pass."},
  {"cmd": "edit_contact_set", "name": "Contact1", "suppressed": true},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"tx": 20}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [40, 20, 20], "tolerance": 1e-6}},
  {"cmd": "edit_contact_set", "name": "Contact1", "suppressed": false},
  {"expect": {"query": {"query": "contact_check"}, "result": {"overlaps": [{"set": "Contact1"}]}}},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"tx": 0}}
]
