[
  {"comment": "Motion links (mitcad#466). Plate (Plate:1, grounded): a 40 x 40 x 10 block, Sketch1 F1 and Extrude1 F2 (Body1)."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},

  {"comment": "Pinion (Pinion:1): a disc of radius 10 and height 5 about (20, 30) on the plate, Sketch2 F3 and Extrude2 F4 (Body2)."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Pinion", "transform": {"translation": [20, 30, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [0, 0], "diameter": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},

  {"comment": "Rack (Rack:1): a 40 x 10 x 5 block below the pinion, y from 10 to 20, Sketch3 F5 and Extrude3 F6 (Body3)."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Rack", "transform": {"translation": [0, 10, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [0, 0], "width": 40, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "ground_occurrence", "occurrence": "Plate:1"},

  {"comment": "Joint1 F7: the pinion turns about its axis on the plate; Joint2 F8: the rack slides along x on it."},
  {"cmd": "add_joint", "kind": "revolute", "flip": true, "position": {"rz": 0},
    "a": {"occurrence": "Pinion:1", "geometry": {"body": "F4.b0", "face": "F4:start(r{c1})"}},
    "b": {"occurrence": "Plate:1",
          "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"},
          "frame_override": {"origin": [20, 30, 10]}}},
  {"cmd": "add_joint", "kind": "slider", "slide_axis": "x", "flip": true,
    "a": {"occurrence": "Rack:1",
          "geometry": {"body": "F6.b0", "face": "F6:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "b": {"occurrence": "Plate:1",
          "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"},
          "frame_override": {"origin": [20, 15, 10]}}},
  {"expect": {"occurrence": "Rack:1", "body": "Body3", "center": [20, 15, 12.5], "tolerance": 1e-6}},

  {"comment": "MotionLink1 F9: a rack and pinion whose radius is the pinion's round side face (10): the rack travels 10 per radian."},
  {"cmd": "add_motion_link", "a": {"joint": "Joint1", "motion": "rz"}, "b": {"joint": "Joint2", "motion": "tx"},
    "coupling": {"type": "rack_pinion",
                 "radius": {"occurrence": "Pinion:1", "geometry": {"body": "F4.b0", "face": "F4:side(c1)"}}}},
  {"expect": {"query": {"query": "joints"},
    "result": {"links": [{"name": "MotionLink1", "coupling": "rack_pinion", "ratio": 10, "solved": true}]}}},
  {"expect": {"occurrence": "Rack:1", "body": "Body3", "center": [20, 15, 12.5], "tolerance": 1e-6}},

  {"comment": "A quarter turn of the pinion moves the rack 5 pi along x."},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"rz": "90 deg"}},
  {"expect": {"occurrence": "Rack:1", "body": "Body3", "center": [35.7079632679, 15, 12.5], "tolerance": 1e-6}},

  {"comment": "Driving the rack turns the pinion back: the rack at tx = 5 (half a radian)."},
  {"cmd": "drive_joint", "joint": "Joint2", "values": {"tx": 5}},
  {"expect": {"occurrence": "Rack:1", "body": "Body3", "center": [25, 15, 12.5], "tolerance": 1e-6}},
  {"expect": {"query": {"query": "joints"}, "result": {"links": [{"values": {"a": 0.5, "b": 5}}]}}}
]
