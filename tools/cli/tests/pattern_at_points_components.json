[
  {"comment": "SPDX-License-Identifier: MIT. Pattern at Points: shared component geometry in nested rotated occurrences (mitcad#197)."},
  {"comment": "Carrier rotates about Z; each Part rotates about X. The part's local 2 x 4 x 6 box maps to world axes Y, Z, X."},
  {"cmd": "create_component", "name": "Carrier", "transform": {"translation": [100, 20, 30], "rotation": {"axis": [0, 0, 1], "angle": 1.5707963267948966}}},
  {"cmd": "create_component", "name": "Part", "transform": {"translation": [10, 0, 5], "rotation": {"axis": [1, 0, 0], "angle": 1.5707963267948966}}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0], "length": 2, "width": 4, "height": 6, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "C1"},
  {"cmd": "copy_occurrence", "occurrence": "O2", "transform": {"translation": [30, 0, 5], "rotation": {"axis": [1, 0, 0], "angle": 1.5707963267948966}}},
  {"expect": {"bodies": 1, "instances": 2, "world_volume": 96}},
  {"expect": {"occurrence": "O1/O2", "body": "F1.b0", "volume": 48, "bbox": {"min": [100, 30, 35], "max": [106, 32, 39]}}},
  {"expect": {"occurrence": "O1/O3", "body": "F1.b0", "bbox": {"min": [100, 50, 35], "max": [106, 52, 39]}}},

  {"comment": "Two referenced targets use a different, Y-rotated component. Their world points are (-30,50,10) and (-10,30,-10)."},
  {"cmd": "activate_component", "component": "C0"},
  {"cmd": "create_component", "name": "Targets", "transform": {"translation": [-50, 40, 10], "rotation": {"axis": [0, 1, 0], "angle": 1.5707963267948966}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "fixed", "point": [0, 10, 20]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "fixed", "point": [20, -10, 40]}}},
  {"cmd": "activate_component", "component": "C1"},
  {"cmd": "add_feature", "def": {"type": "pattern_at_points", "context": "O1", "objects": {"type": "components", "occurrences": ["O1/O2", "O1/O3"]}, "targets": [{"point": "F2", "occurrence": "O4"}, {"point": "F3", "occurrence": "O4"}]}},
  {"comment": "The group anchor is (20,0,5) in Carrier, not a body's centre. Both source origins stay 20 mm apart and every copy keeps its orientation."},
  {"expect": {"feature": "F4", "status": "ok", "bodies": 1, "instances": 6, "world_volume": 288}},
  {"expect": {"occurrence": "O1/O5", "body": "F1.b0", "volume": 48, "bbox": {"min": [-30, 40, 10], "max": [-24, 42, 14]}}},
  {"expect": {"occurrence": "O1/O6", "body": "F1.b0", "bbox": {"min": [-10, 20, -10], "max": [-4, 22, -6]}}},
  {"expect": {"occurrence": "O1/O7", "body": "F1.b0", "bbox": {"min": [-30, 60, 10], "max": [-24, 62, 14]}}},
  {"expect": {"occurrence": "O1/O8", "body": "F1.b0", "bbox": {"min": [-10, 40, -10], "max": [-4, 42, -6]}}},

  {"comment": "The source is still one definition: its height edit changes all six placed solids and keeps the origins fixed."},
  {"cmd": "edit_feature", "uid": "F1", "def": {"type": "box", "plane": "xy", "corner": [0, 0], "length": 2, "width": 4, "height": 8, "operation": "new_body"}},
  {"expect": {"feature": "F4", "status": "ok", "bodies": 1, "instances": 6, "world_volume": 384}},
  {"expect": {"occurrence": "O1/O2", "body": "F1.b0", "volume": 64, "bbox": {"min": [100, 30, 35], "max": [108, 32, 39]}}},
  {"expect": {"occurrence": "O1/O8", "body": "F1.b0", "volume": 64, "bbox": {"min": [-10, 40, -10], "max": [-2, 42, -6]}}},
  {"comment": "Moving a referenced point changes only its two copies; the other target and original occurrences stay put."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "construction_point", "definition": {"type": "fixed", "point": [5, 13, 27]}}},
  {"expect": {"occurrence": "O1/O5", "body": "F1.b0", "bbox": {"min": [-23, 43, 5], "max": [-15, 45, 9]}}},
  {"expect": {"occurrence": "O1/O7", "body": "F1.b0", "bbox": {"min": [-23, 63, 5], "max": [-15, 65, 9]}}},
  {"expect": {"occurrence": "O1/O6", "body": "F1.b0", "bbox": {"min": [-10, 20, -10], "max": [-2, 22, -6]}}},
  {"expect": {"occurrence": "O1/O3", "body": "F1.b0", "bbox": {"min": [100, 50, 35], "max": [108, 52, 39]}}},

  {"comment": "A root sketch observes an actual OCCT face of a generated copy. Its plane must disappear with that occurrence and recover after Undo."},
  {"cmd": "activate_component", "component": "C0"},
  {"comment": "The design policy (mitcad#220) lets the root sketch on the faces of Part."},
  {"cmd": "set_policy", "component": "C0", "policy": {"attach_to_others": true}},
  {"cmd": "set_policy", "component": "Part", "policy": {"attachments_from_others": true}},
  {"cmd": "sketch.create", "plane": {"body": "F1.b0", "face": "F1:top"}, "occurrence": "O1/O5"},
  {"expect": {"feature": "F5", "status": "ok"}},
  {"expect": {"query": {"query": "sketch", "uid": "F5"}, "result": {"frame": {"origin": [-15, 0, 0], "normal": [1, 0, 0]}}}},
  {"cmd": "suppress_feature", "uid": "F4"},
  {"expect": {"feature": "F4", "status": "suppressed", "bodies": 1, "instances": 2, "world_volume": 128}},
  {"expect": {"feature": "F5", "status": "error", "error_contains": "unavailable"}},
  {"cmd": "undo"},
  {"expect": {"feature": "F5", "status": "ok", "instances": 6, "world_volume": 384}},
  {"cmd": "set_marker", "position": 3},
  {"expect": {"feature": "F4", "status": "rolled_back", "instances": 2, "world_volume": 128}},
  {"cmd": "undo"},
  {"expect": {"feature": "F5", "status": "ok", "instances": 6}},

  {"comment": "Editing down to one source and one target uses that component's origin. It removes the observed copy; Undo must invalidate its missing-path cached error and restore the same occurrence."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "pattern_at_points", "context": "O1", "objects": {"type": "components", "occurrences": ["O1/O2"]}, "targets": [{"point": "F3", "occurrence": "O4"}]}},
  {"expect": {"feature": "F4", "status": "ok", "bodies": 1, "instances": 3, "world_volume": 192}},
  {"expect": {"occurrence": "O1/O6", "body": "F1.b0", "bbox": {"min": [-10, 30, -10], "max": [-2, 32, -6]}}},
  {"expect": {"feature": "F5", "status": "error"}},
  {"cmd": "undo"},
  {"expect": {"feature": "F5", "status": "ok", "instances": 6, "world_volume": 384}},
  {"expect": {"query": {"query": "sketch", "uid": "F5"}, "result": {"frame": {"origin": [-15, 0, 0], "normal": [1, 0, 0]}}}},
  {"comment": "A coincident target fails the whole pattern without retaining copies from its previous successful result."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "pattern_at_points", "context": "O1", "objects": {"type": "components", "occurrences": ["O1/O2", "O1/O3"]}, "targets": [{"point": {"point": [20, 0, 5]}}]}},
  {"expect": {"feature": "F4", "status": "error", "error_contains": "coincides", "bodies": 1, "instances": 2, "world_volume": 128}},
  {"cmd": "undo"},
  {"expect": {"feature": "F4", "status": "ok", "instances": 6, "world_volume": 384}},
  {"expect": {"feature": "F5", "status": "ok"}},
  {"expect": {"occurrence": "O1/O5", "body": "F1.b0", "bbox": {"min": [-23, 43, 5], "max": [-15, 45, 9]}}}
]
