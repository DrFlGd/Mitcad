[
  {"comment": "A sketch edit that splits the regions an extrusion uses (mitcad#407). A window: circles of 660 (c1) and 600 (c3); a vertical bar 40 x 620 from (-20, -310) (c5..c8, height d4) and a horizontal one 620 x 40 from (-310, -20) (c13..c16, width d5). The bars' nine regions (the centre, four arms and four tips between the circles) extruded 10 mm as a new body: 2 * 40 * 620 - 1600 = 48000 mm2."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [0, 0], "diameter": 660},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [0, 0], "diameter": 600},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [-20, -310], "width": 40, "height": 620},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [-310, -20], "width": 620, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [
      {"sketch": "F1", "region": "r{c6[c13,c15],c8[c15,c13],c13[c8,c6],c15[c6,c8]}"},
      {"sketch": "F1", "region": "r{c3[c13,c15],c6[c13,c15],c13[c6,c3],c15[c3,c6]}"},
      {"sketch": "F1", "region": "r{c3[c15,c13],c8[c15,c13],c13[c3,c8],c15[c8,c3]}"},
      {"sketch": "F1", "region": "r{c3[c6,c8],c6[c15,c3],c8[c3,c15],c15[c6,c8]}"},
      {"sketch": "F1", "region": "r{c3[c8,c6],c6[c3,c13],c8[c13,c3],c13[c8,c6]}"},
      {"sketch": "F1", "region": "r{c3[c13,c15],c13[c3,c14],c14[c13,c15],c15[c14,c3]}"},
      {"sketch": "F1", "region": "r{c3[c15,c13],c13[c16,c3],c15[c3,c16],c16[c15,c13]}"},
      {"sketch": "F1", "region": "r{c3[c6,c8],c6[c3,c7],c7[c6,c8],c8[c7,c3]}"},
      {"sketch": "F1", "region": "r{c3[c8,c6],c5[c8,c6],c6[c5,c3],c8[c3,c5]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"parameter": "d4", "value": 620}},
  {"expect": {"parameter": "d5", "value": 620}},
  {"expect": {"feature": "Extrude1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 480000, "faces": 14}},

  {"comment": "The bars 650 long now reach 340 at the top and the right, across the outer circle: the top and right tips each split into a piece between the circles and one outside. Each old tip finds both pieces, so the whole longer bars stay extruded (2 * 40 * 650 - 1600 = 50400 mm2), with a warning naming the pieces."},
  {"cmd": "set_parameter", "name": "d4", "value": 650},
  {"cmd": "set_parameter", "name": "d5", "value": 650},
  {"expect": {"feature": "Extrude1", "status": "warning",
    "error_contains": "region r{c3[c6,c8],c6[c3,c7],c7[c6,c8],c8[c7,c3]} found as r{c1[c6,c8],c3[c6,c8],c6[c3,c1],c8[c1,c3]} + r{c1[c6,c8],c6[c1,c7],c7[c6,c8],c8[c7,c1]} after a change in Sketch1"}},
  {"expect": {"feature": "Extrude1", "error_contains": "region r{c3[c13,c15],c13[c3,c14],c14[c13,c15],c15[c14,c3]} found as"}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 504000, "faces": 14,
    "has_face": "F2:end(r{c3[c6,c8],c6[c3,c7],c7[c6,c8],c8[c7,c3]})"}},
  {"expect": {"query": {"query": "profile", "sketch": "F1", "region": "r{c3[c6,c8],c6[c3,c7],c7[c6,c8],c8[c7,c3]}"},
    "result": {"exact": false, "region": "r{c1[c6,c8],c3[c6,c8],c6[c3,c1],c8[c1,c3]}",
      "regions": ["r{c1[c6,c8],c3[c6,c8],c6[c3,c1],c8[c1,c3]}", "r{c1[c6,c8],c6[c1,c7],c7[c6,c8],c8[c7,c1]}"]}}},

  {"comment": "Back to 620: the old keys are the regions' own again, no warning."},
  {"cmd": "undo"},
  {"cmd": "undo"},
  {"expect": {"feature": "Extrude1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 480000, "faces": 14}}
]
