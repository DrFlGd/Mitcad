[
  {"comment":"SPDX-License-Identifier: MIT. A double bend (mitcad#280): t=1, r=2, K=0.4. Panel A (x=-30..0, y=0..20, z=0..1) and a separate panel B (x=0..30, moved to z=5..6) are joined at their edges x=0 by two opposite 45-degree bends and a straight between them: middle radius 2.5, the straight (5 - 5 (1 - cos 45)) / sin 45 = 5 long, the second bend ending 5 sqrt 2 from A's edge, where B is cut back to. Volume 600 + 100 + (30 - 5 sqrt 2) 20 + 2 (pi/8)(9 - 4) 20 = 1300 - 100 sqrt 2 + 25 pi; developed 1300 - 100 sqrt 2 + 2 (pi/4)(2.4) 20."},
  {"cmd":"add_feature","def":{"type":"sheet_rules","thickness":1,"bend_radius":2,"allowance":{"type":"k_factor","k":0.4},"reference_side":"front","bend_relief":{"type":"rectangular","width":1,"depth":1},"corner_relief":{"type":"round","width":2,"depth":2}}},
  {"cmd":"sketch.create"},
  {"cmd":"sketch.add_rectangle","sketch":"F2","corner":[-30,0],"width":30,"height":20},
  {"cmd":"add_feature","def":{"type":"sheet_face","rules":"F1","profiles":[{"sketch":"F2","region":"r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
