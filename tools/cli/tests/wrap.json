[
  {"comment": "Extrude's wrap and Emboss on a cone (mitcad#473) on OCCT. A rod: a circle of diameter 20 (Sketch1 F1) extruded 30 up the Z axis (F2): 100 pi 30."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [0, 0], "diameter": 20},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 30}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 9424.77796076938}},

  {"comment": "Sketch2 (F3) on XZ: a 6 x 6 rectangle from z = 2 to 8, extruded 1 wrapped onto the rod's side and joined (Extrude2, F4): as an emboss, 36 * 21 / 20 more."},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [-3, -8], "width": 6, "height": 6},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 1}, "operation": "join",
    "wrap": {"body": "F2.b0", "face": "F2:side(c1)"}}},
  {"expect": {"feature": "Extrude2", "status": "ok", "body": "F2.b0", "volume": 9462.57796076938,
    "has_face": "F4:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "F2.b0", "min": [-10, -10, 0], "max": [10, 11, 30]}},
  {"comment": "Flipped and cut: engraved 1 deep, 36 * 19 / 20 less."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 1}, "flip": true, "operation": "cut",
    "wrap": {"body": "F2.b0", "face": "F2:side(c1)"}}},
  {"expect": {"feature": "Extrude2", "status": "ok", "body": "F2.b0", "volume": 9390.57796076938}},

  {"comment": "A cone: Sketch3 (F5) on XY, the triangle (0, 0), (20, 0), (0, 30) revolved about Y (Revolve1, F6): 20^2 pi 30 / 3; its apex at (0, 30, 0), its half angle atan(20 / 30)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F5", "start": [0, 0], "end": [20, 0]},
  {"cmd": "sketch.add_line", "sketch": "F5", "start": [20, 0], "end": [0, 30]},
  {"cmd": "sketch.add_line", "sketch": "F5", "start": [0, 30], "end": [0, 0]},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F5", "region": "r{c1[c7,c4],c4[c1,c7],c7[c4,c1]}"}],
    "axis": "y", "extent": {"type": "full"}, "operation": "new_body"}},
  {"expect": {"feature": "Revolve1", "status": "ok", "body": "F6.b0", "volume": 12566.370614359172,
    "tolerance": 1e-6}},

  {"comment": "Sketch4 (F7) on XY, through the cone's axis: a 6 x 4 rectangle from y = 8 to 12, developed onto the cone and raised 0.5 along its normals (Emboss1, F8). The foot of a developed region keeps its area (24), so the volume grows by about 24 * 0.5."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [-3, 8], "width": 6, "height": 4},
  {"cmd": "add_feature", "def": {"type": "emboss",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "face": {"body": "F6.b0", "face": "F6:side(c4[c1,c7])"}, "depth": 0.5}},
  {"expect": {"feature": "Emboss1", "status": "ok", "body": "F6.b0", "volume": 12578.4,
    "tolerance": 2e-4}},
  {"comment": "Sunk instead (an extrusion wrapped, flipped and cut): about 12 less."},
  {"cmd": "delete_feature", "uid": "F8"},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 0.5}, "flip": true, "operation": "cut",
    "participants": ["F6.b0"], "wrap": {"body": "F6.b0", "face": "F6:side(c4[c1,c7])"}}},
  {"expect": {"body": "F6.b0", "volume": 12554.4, "tolerance": 2e-4}},
  {"expect": {"body": "F2.b0", "volume": 9390.57796076938}}
]
