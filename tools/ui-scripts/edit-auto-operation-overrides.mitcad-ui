# SPDX-License-Identifier: MIT
wait-idle
window-resize 1400 990
command view.fit
# An edit keeps its stored operation (mitcad#868); a hand-picked Operation
# or a cleared Local bodies is what changes it.
mark
dblclick-logged '^Timeline Extrude1 at '
expect-log 'Extrude: editing keeps the stored operation'
mark
click-logged '^Panel Extrude input operation at '
key Home Return
expect-log 'Extrude: Operation = New Body'
focus-main
mark
focus-widget input_distance
key ctrl+a
type -15
expect-log 'Preview Extrude: ok'
expect-no-log 'Extrude: automatic Operation'
focus-main
key Escape
expect-log 'Command Extrude cancelled'
# The real Local bodies selector's adjacent clear button changes Objects.
mark
dblclick-logged '^Timeline Extrude1 at '
expect-log 'Extrude: editing keeps the stored operation'
mark
button '^(✕|Clear the selection)$' clear_objects
expect-log '^Extrude Local bodies: nothing$'
focus-main
mark
focus-widget input_distance
key ctrl+a
type -15
expect-log 'Preview Extrude: ok'
expect-no-log 'Extrude: automatic Operation'
focus-main
key Escape
expect-log 'Command Extrude cancelled'
expect-model-bodies 2 27000
expect-never 'The document was read while a job computes it|OCCT view event failed|Recompute failed'
