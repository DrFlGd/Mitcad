# Separate saved New Body and explicit one-of-two participant variants.
wait-idle
window-resize 1400 990
command view.fit
mark
dblclick-logged '^Timeline Extrude1 at '
expect-log 'Editing F4 with Extrude'
expect-log 'Extrude: stored operation differs from automatic choice; editing keeps it'
mark
focus-widget input_distance
key ctrl+a
type -15
expect-log 'Preview Extrude: ok'
expect-no-log 'Extrude: automatic Operation'
button '^OK$'
expect-log 'Edited F4' 30
menu 'File/Save'
expect-log 'Saved .*edit-auto\.mitcad'
mark
dblclick-logged '^Timeline Extrude1 at '
expect-log 'Editing F4 with Extrude'
expect-log 'Extrude: stored operation differs from automatic choice; editing keeps it'
expect-no-log 'Extrude: automatic Operation'
key Escape
expect-log 'Command Extrude cancelled'
expect-never 'The document was read while a job computes it|OCCT view event failed|Recompute failed'
