# SPDX-License-Identifier: MIT
# An edit keeps its stored operation (mitcad#868): the Join of both blocks
# stays Join when its distance goes down into them, and OK saves it so.
wait-idle
window-resize 1400 990
command view.front
command view.fit
expect-model-bodies 2 27000
mark
dblclick-logged '^Timeline Extrude1 at '
expect-log 'Editing F4 with Extrude'
expect-log 'Extrude: editing keeps the stored operation'
wait-idle
mark
focus-widget input_distance
key ctrl+a
type -15
expect-log 'Preview Extrude: ok'
wait-idle
expect-no-log 'Extrude: automatic Operation'
expect-no-log 'Extrude: Operation = '
screenshot '${MITCAD_TEST_WORK}/edit-keeps-join.png'
button '^OK$'
expect-log 'Edited F4' 30
expect-model-bodies 2 27000
menu 'File/Save'
expect-log 'Saved .*edit-auto\.mitcad'
expect-never 'The document was read while a job computes it|OCCT view event failed|Recompute failed'
