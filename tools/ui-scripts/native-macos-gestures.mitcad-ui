# SPDX-License-Identifier: MIT
# Trackpad pinch regression. AppKit magnify events enter the actual document
# NSWindow; read-only OCCT camera heights verify rendered zoom state.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
expect-ever 'View area'
native-resize 1280 820
sleep 800

# The shared viewer handles native Qt gestures independently of navigation
# scheme. This control proves the camera works before testing AppKit routing.
capture-view-height qt_before
qt-pinch 50 50 0.25
expect-view-zoom ${qt_before} in
capture-view-height qt_after

# Pinching the native canvas must zoom in and out through AppKit dispatch.
capture-view-height before_in
native-pinch 50 50 0.25
expect-view-zoom ${before_in} in ${qt_before} ${qt_after}
capture-view-height qt_out_before
qt-pinch 50 50 -0.25
expect-view-zoom ${qt_out_before} out
capture-view-height qt_out_after
capture-view-height before_out
native-pinch 50 50 -0.25
expect-view-zoom ${before_out} out ${qt_out_before} ${qt_out_after}

# A pinch over the floating browser must leave the canvas camera unchanged.
expect-native-visible native.sidebar true
capture-view-height before_overlay
native-pinch 5 20 0.25
expect-view-zoom ${before_overlay} unchanged

# Choose the alternate orbit key through the real Settings popup, then
# inspect the camera after pixel scrolls through the shared viewer handler.
command tools.preferences.navigation
focus-dialog '^Settings$'
native-choice navigationScheme 'Trackpad (two-finger scroll pans, pinch zooms, Shift orbits)'
expect-log 'Preferences: navigation trackpad-shift,'
key Ctrl+w
expect-native-dialog-gone '^Settings$'
focus-main
capture-view-height shift_height
capture-view-orientation shift_direction
trackpad-scroll 55 45 45 30 shift
expect-view-orientation ${shift_direction} changed
expect-view-zoom ${shift_height} unchanged
sleep 300
expect-view-buttons none
capture-view-orientation zoom_direction
capture-view-height option_height
trackpad-scroll 55 45 0 30 alt
expect-view-zoom ${option_height} in
expect-view-orientation ${zoom_direction} unchanged
capture-view-height command_height
trackpad-scroll 55 45 0 -30 ctrl
expect-view-zoom ${command_height} out
# An ordinary wheel still zooms with Shift held.
capture-view-height wheel_height
wheel 55 45 1 shift
expect-view-zoom ${wheel_height} in

# Reopening Settings retains the choice. Restoring the default scheme
# restores Option orbit and Shift zoom without leaving a synthetic drag.
command tools.preferences.navigation
focus-dialog '^Settings$'
expect-native-text navigationScheme 'Shift orbits'
native-choice navigationScheme 'Trackpad (two-finger scroll pans, pinch zooms, ⌥ orbits)'
expect-log 'Preferences: navigation trackpad,'
key Ctrl+w
expect-native-dialog-gone '^Settings$'
focus-main
capture-view-height default_height
capture-view-orientation default_direction
trackpad-scroll 55 45 45 30 alt
expect-view-orientation ${default_direction} changed
expect-view-zoom ${default_height} unchanged
sleep 300
expect-view-buttons none
capture-view-height default_zoom
trackpad-scroll 55 45 0 30 shift
expect-view-zoom ${default_zoom} in

# Pinching also works during sketching and leaves precision input intact.
mark
native-action sketch.create
expect-log 'Create Sketch: select a plane'
click-logged 'Datum xy'
expect-log 'Sketch started on xy'
capture-view-height before_sketch
native-pinch 55 45 0.25
expect-view-zoom ${before_sketch} in
native-click native.ribbon.sketch.rectangle
sketch-click 0 0
native-type sketchField_width '20 mm'
capture-view-height before_field
native-pinch 55 45 -0.25
expect-view-zoom ${before_field} out
expect-native-text sketchField_width '^20 mm$'
native-type sketchField_height '10 mm'
key Return
expect-log 'Added rectangle 20 x 10 mm at \(0, 0\)' 30
native-click native.ribbon.sketch.finish
expect-log 'Sketch finished' 30
expect-never 'OCCT view event failed|Native Mac canvas:|TestDriver: FAIL'
