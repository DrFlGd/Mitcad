# SPDX-License-Identifier: MIT
# check-all sources: app/platform app/files app/MainWindowNative.cpp
# The harness starts with a saved toolbar configuration from before Project.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
sleep 800
expect-native-toolbar-item mitcad.sidebar true
expect-native-toolbar-item mitcad.search true
expect-native-toolbar-item mitcad.project true

# A palette sample must not redirect updates away from the inserted item.
native-toolbar-item mitcad.project palette
mark
native-action file.new_project
focus-dialog '^New Project$'
native-type projectFolder '${MITCAD_TEST_WORK}/ToolbarProject'
native-type projectAuthorName 'Toolbar Tester'
native-type projectAuthorEmail 'toolbar@example.invalid'
native-type projectDisplayName 'Toolbar Workshop'
native-choice projectLiveHere 'Off'
button '^Create$'
expect-log 'New Project: created ${MITCAD_TEST_WORK:re}/ToolbarProject: version ' 30
expect-native-dialog-gone '^New Project$'
focus-main
expect-native-text mitcad.project 'ToolbarProject'

# Removing through the real saved configuration survives a real project
# status change. No GUI customization sheet or system input is needed.
native-toolbar-item mitcad.project remove
expect-native-toolbar-item mitcad.project false
mark
native-action file.new_project
focus-dialog '^New Project$'
native-type projectFolder '${MITCAD_TEST_WORK}/ToolbarOtherProject'
native-type projectAuthorName 'Toolbar Tester'
native-type projectAuthorEmail 'toolbar@example.invalid'
native-type projectDisplayName 'Toolbar Other Workshop'
native-choice projectLiveHere 'Off'
button '^Create$'
expect-log 'New Project: created ${MITCAD_TEST_WORK:re}/ToolbarOtherProject: version ' 30
expect-native-dialog-gone '^New Project$'
focus-main
expect-native-toolbar-item mitcad.project false

# Restoring explicitly uses the newest status, even while it was absent.
native-toolbar-item mitcad.project insert
expect-native-toolbar-item mitcad.project true
expect-native-text mitcad.project 'ToolbarOtherProject'
native-toolbar-item mitcad.project remove
expect-native-toolbar-item mitcad.project false
