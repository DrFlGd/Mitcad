# SPDX-License-Identifier: MIT
# Actual picked face preview, both retained half-spaces, then equivalent
# component datum edited and saved. The assertions inspect displayed OCCT
# geometry, including world bounds, independently of log text or screenshots.
wait-idle 30
native-action view.fit
expect-model-bodies 1 4000
expect-shown-body F2.b0 O1 4000 0 0 100 20 20 110
expect-shown-body F2.b0 O2 4000 30 0 100 50 20 110
mark
native-action inspect.section
click-pick 'face F2\.b0/F2:end\('
expect-log 'Section Analysis Faces/Plane: 1 face'
expect-shown-body F2.b0 O1 4000 0 0 100 20 20 110
native-type input_offset '-5'
expect-shown-body F2.b0 O1 2000 0 0 100 20 20 105
expect-shown-body F2.b0 O2 2000 30 0 100 50 20 105
expect-log 'Section caps: 2 face\(s\)'
expect-log 'Inspect Section Analysis: area 800, length 160'
screenshot-view "${MITCAD_TEST_WORK}/face-lower.png"
native-click input_flip
expect-shown-body F2.b0 O1 2000 0 0 105 20 20 110
expect-shown-body F2.b0 O2 2000 30 0 105 50 20 110
screenshot-view "${MITCAD_TEST_WORK}/face-upper.png"
native-click input_flip
expect-shown-body F2.b0 O1 2000 0 0 100 20 20 105
# Signed offsets and a valid whole-body discard must keep working.
native-type input_offset '-2'
expect-shown-body F2.b0 O1 3200 0 0 100 20 20 108
native-type input_offset '2'
expect-shown-body F2.b0 O1 4000 0 0 100 20 20 110
native-click input_flip
expect-shown-body F2.b0 O1 0
expect-shown-body F2.b0 O2 0
native-click input_flip
native-type input_offset '-5'
native-click commandOk
expect-log 'Kept Section Analysis as Section1'
expect-shown-body F2.b0 O1 2000 0 0 100 20 20 105
native-action inspect.flip_section
expect-shown-body F2.b0 O1 2000 0 0 105 20 20 110
native-action inspect.flip_section
expect-shown-body F2.b0 O1 2000 0 0 100 20 20 105
native-action inspect.remove_section
expect-shown-body F2.b0 O1 4000 0 0 100 20 20 110
expect-shown-body F2.b0 O2 4000 30 0 100 50 20 110

mark
native-expand native.modelTree
native-activate native.model.analysis:PlaneCut
expect-log 'Editing analysis PlaneCut with Section Analysis'
expect-shown-body F2.b0 O1 4000 0 0 100 20 20 110
native-type input_offset '-5'
expect-shown-body F2.b0 O1 2000 0 0 100 20 20 105
expect-shown-body F2.b0 O2 2000 30 0 100 50 20 105
expect-log 'Inspect Section Analysis: area 800, length 160'
screenshot-view "${MITCAD_TEST_WORK}/plane-lower.png"
native-click input_flip
expect-shown-body F2.b0 O1 2000 0 0 105 20 20 110
native-click input_flip
expect-shown-body F2.b0 O1 2000 0 0 100 20 20 105
native-click commandOk
expect-log 'Edited analysis PlaneCut'
expect-model-bodies 1 4000
menu 'File/Save'
expect-log 'Saved .*section-coordinates\.mitcad'
